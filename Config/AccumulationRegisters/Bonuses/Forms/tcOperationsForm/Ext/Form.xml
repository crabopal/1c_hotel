	BonusesOperation.BonusesQuantity AS BonusesQuantity,
	BonusesOperation.Date AS Date,
	BonusesOperation.Card AS Card,
	BonusesOperation.ExternalCode AS ExternalCode,
	BonusesOperation.Guest AS Guest,
	BonusesOperation.GuestGroup AS GuestGroup,
	BonusesOperation.Source AS Source,
	BonusesOperation.Hotel AS Hotel,
