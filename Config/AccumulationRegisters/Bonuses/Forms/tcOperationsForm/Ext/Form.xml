	BonusesPayment.ExternalCode &lt;&gt; "",
	BonusesPayment.DeletionMark,
	BonusesPayment.Posted,
	CASE
		WHEN BonusesPayment.Posted
			THEN 0
		WHEN BonusesPayment.DeletionMark
			THEN 1
		ELSE 2
	END
FROM
	Document.BonusesPayment AS BonusesPayment</QueryText>
