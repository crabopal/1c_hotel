	BonusesOperation.Card.Identifier AS Identifier,
	BonusesOperation.ExternalCode &lt;&gt; "" AS Unloaded,
	BonusesOperation.DeletionMark AS DeletionMark,
	BonusesOperation.Posted AS Posted,
	CASE
