			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	CatalogAccommodationTemplates.Ref AS Ref,
	CatalogAccommodationTemplates.DeletionMark AS DeletionMark,
	CatalogAccommodationTemplates.Code AS Code,
	CatalogAccommodationTemplates.Description AS Description,
	CatalogAccommodationTemplates.DescriptionTranslations AS DescriptionTranslations,
	CatalogAccommodationTemplates.Hotel AS Hotel,
	CatalogAccommodationTemplates.NumberOfAdults AS NumberOfAdults,
	CatalogAccommodationTemplates.NumberOfTeenagers AS NumberOfTeenagers,
	CatalogAccommodationTemplates.NumberOfChildren AS NumberOfChildren,
	CatalogAccommodationTemplates.NumberOfInfants AS NumberOfInfants,
	CatalogAccommodationTemplates.IsForFolioSplit AS IsForFolioSplit,
	CatalogAccommodationTemplates.Remarks AS Remarks,
	CatalogAccommodationTemplates.Predefined AS Predefined,
	CatalogAccommodationTemplates.PredefinedDataName AS PredefinedDataName
FROM
	Catalog.AccommodationTemplates AS CatalogAccommodationTemplates
		INNER JOIN (SELECT DISTINCT
			TemplatesRefs.Ref AS Ref
		FROM
			(SELECT
				AccommodationTemplates.Ref AS Ref
			FROM
				Catalog.AccommodationTemplates AS AccommodationTemplates
					LEFT JOIN Catalog.AccommodationTemplates.RoomTypes AS TemplatesByRoomTypes
					ON AccommodationTemplates.Ref = TemplatesByRoomTypes.Ref
			WHERE
				(AccommodationTemplates.Hotel = &amp;qHotel
						OR AccommodationTemplates.Hotel = VALUE(Catalog.Hotels.EmptyRef))
				AND TemplatesByRoomTypes.Ref IS NULL
			
			UNION ALL
			
			SELECT
				TemplatesByRoomTypes.Ref
			FROM
				Catalog.AccommodationTemplates.RoomTypes AS TemplatesByRoomTypes
			WHERE
				(TemplatesByRoomTypes.Hotel = &amp;qHotel
						OR TemplatesByRoomTypes.Hotel = VALUE(Catalog.Hotels.EmptyRef))
				AND (TemplatesByRoomTypes.Ref.Hotel = &amp;qHotel
						OR TemplatesByRoomTypes.Ref.Hotel = VALUE(Catalog.Hotels.EmptyRef))
				AND (TemplatesByRoomTypes.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
							AND TemplatesByRoomTypes.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef)
						OR TemplatesByRoomTypes.RoomType IN HIERARCHY (&amp;qRoomType)
							AND &amp;qRoomType &lt;&gt; VALUE(Catalog.RoomTypes.EmptyRef)
							AND TemplatesByRoomTypes.RoomType &lt;&gt; VALUE(Catalog.RoomTypes.EmptyRef)
						OR TemplatesByRoomTypes.RoomClass = &amp;qRoomClass
							AND &amp;qRoomClass &lt;&gt; VALUE(Catalog.RoomTypeClasses.EmptyRef)
							AND TemplatesByRoomTypes.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
							AND &amp;qRoomType = VALUE(Catalog.RoomTypes.EmptyRef)
						OR &amp;qRoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef)
							AND &amp;qRoomType = VALUE(Catalog.RoomTypes.EmptyRef))) AS TemplatesRefs) AS Templates
		ON CatalogAccommodationTemplates.Ref = Templates.Ref</QueryText>
