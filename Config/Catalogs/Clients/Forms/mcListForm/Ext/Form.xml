		<Attribute name="List" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>List.AccommodationCount</Field>
				<Field>List.Citizenship</Field>
				<Field>List.Code</Field>
				<Field>List.DateOfBirth</Field>
				<Field>List.DefaultPicture</Field>
				<Field>List.Description</Field>
				<Field>List.EMail</Field>
				<Field>List.Fax</Field>
				<Field>List.FirstName</Field>
				<Field>List.FullName</Field>
				<Field>List.IdentityDocumentIssueDate</Field>
				<Field>List.IdentityDocumentIssuedBy</Field>
				<Field>List.IdentityDocumentNumber</Field>
				<Field>List.IdentityDocumentSeries</Field>
				<Field>List.IdentityDocumentType</Field>
				<Field>List.IdentityDocumentValidToDate</Field>
				<Field>List.Language</Field>
				<Field>List.LastName</Field>
				<Field>List.Phone</Field>
				<Field>List.ReservationCount</Field>
				<Field>List.SecondName</Field>
				<Field>List.Sex</Field>
				<Field>List.Tag</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>SELECT
	CatalogClients.Code AS Code,
	CatalogClients.Description AS Description,
	CatalogClients.LastName AS LastName,
	CatalogClients.FirstName AS FirstName,
	CatalogClients.SecondName AS SecondName,
	CatalogClients.FullName AS FullName,
	CAST(CASE
			WHEN CatalogClients.Sex IN (&amp;qClientSex)
				THEN &amp;qSexMale
			ELSE &amp;qSexFemale
		END AS NUMBER(3, 0)) AS Sex,
	CatalogClients.Citizenship AS Citizenship,
	CatalogClients.Phone AS Phone,
	CatalogClients.Fax AS Fax,
	CatalogClients.EMail AS EMail,
	CatalogClients.DateOfBirth AS DateOfBirth,
	CatalogClients.IdentityDocumentType AS IdentityDocumentType,
	CatalogClients.IdentityDocumentSeries AS IdentityDocumentSeries,
	CatalogClients.IdentityDocumentNumber AS IdentityDocumentNumber,
	CatalogClients.IdentityDocumentIssueDate AS IdentityDocumentIssueDate,
	CatalogClients.IdentityDocumentValidToDate AS IdentityDocumentValidToDate,
	CatalogClients.IdentityDocumentIssuedBy AS IdentityDocumentIssuedBy,
	CatalogClients.Language AS Language,
	AccCount.AccommodationCount AS AccommodationCount,
	ReservCount.ReservationCount AS ReservationCount,
	ClientTags.Tag AS Tag
FROM
	Catalog.Clients AS CatalogClients
		LEFT JOIN (SELECT
			COUNT(Accommodation.Ref) AS AccommodationCount,
			Accommodation.Guest AS Guest
		FROM
			Document.Accommodation AS Accommodation
		WHERE
			NOT Accommodation.DeletionMark
			AND Accommodation.Posted
			AND Accommodation.AccommodationStatus.IsActive
		
		GROUP BY
			Accommodation.Guest) AS AccCount
		ON CatalogClients.Ref = AccCount.Guest
		LEFT JOIN (SELECT
			COUNT(Reservation.Ref) AS ReservationCount,
			Reservation.Guest AS Guest
		FROM
			Document.Reservation AS Reservation
		WHERE
			NOT Reservation.DeletionMark
			AND Reservation.Posted
			AND Reservation.ReservationStatus.ShowInClientsSearchForm
		
		GROUP BY
			Reservation.Guest) AS ReservCount
		ON CatalogClients.Ref = ReservCount.Guest
		LEFT JOIN InformationRegister.ClientTags AS ClientTags
		ON CatalogClients.Ref = ClientTags.Client
			AND (ClientTags.Tag = &amp;qTag)
WHERE
	NOT CatalogClients.IsFolder
	AND NOT CatalogClients.DeletionMark
	AND (&amp;qAuthor = VALUE(Catalog.Employees.EmptyRef)
			OR &amp;qAuthor &lt;&gt; VALUE(Catalog.Employees.EmptyRef)
				AND CatalogClients.Author = &amp;qAuthor)
	AND (&amp;qClientsListIsEmpty
			OR NOT &amp;qClientsListIsEmpty
				AND CatalogClients.Ref IN (&amp;qClientsList))
	AND (NOT &amp;qTagIsFilled
			OR &amp;qTagIsFilled
				AND ClientTags.Tag = &amp;qTag)
	AND (NOT &amp;qClientTypeIsFilled
			OR &amp;qClientTypeIsFilled
				AND CatalogClients.ClientType IN HIERARCHY (&amp;qClientType))</QueryText>
