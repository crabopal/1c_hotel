	<Attributes>
		<Attribute name="CustomersList" id="1">
			<Title>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Customers list</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>CustomersList.Customer</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT DISTINCT
	LinkedCustomers.Customer AS Customer,
	LinkedCustomers.Customer.Description AS CustomerDescription
FROM
	(SELECT
		CustomersContactPersons.Ref AS Customer
	FROM
		Catalog.Customers.ContactPersons AS CustomersContactPersons
	WHERE
		CustomersContactPersons.Client = &amp;qClient
		AND NOT CustomersContactPersons.Ref.DeletionMark
		AND NOT CustomersContactPersons.Ref.IsFolder
	
	UNION ALL
	
	SELECT
		Customers.Ref
	FROM
		Catalog.Customers AS Customers
	WHERE
		Customers.Client = &amp;qClient
		AND NOT Customers.Ref.DeletionMark
		AND NOT Customers.Ref.IsFolder) AS LinkedCustomers</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>CustomerDescription</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
