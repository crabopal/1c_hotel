	<Attributes>
		<Attribute name="List" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>List.DeletionMark</Field>
				<Field>List.IsBlocked</Field>
				<Field>List.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	CatalogDiscountCards.Ref AS Ref,
	CatalogDiscountCards.DeletionMark AS DeletionMark,
	CatalogDiscountCards.Code AS Code,
	CatalogDiscountCards.Description AS Description,
	CatalogDiscountCards.Author AS Author,
	CatalogDiscountCards.Client AS Client,
	CatalogDiscountCards.Customer AS Customer,
	CatalogDiscountCards.ClientType AS ClientType,
	CatalogDiscountCards.CreateDate AS CreateDate,
	CatalogDiscountCards.CreateHotel AS CreateHotel,
	CatalogDiscountCards.Consumer AS Consumer,
	CatalogDiscountCards.DiscountType AS DiscountType,
	CatalogDiscountCards.Identifier AS Identifier,
	CatalogDiscountCards.IsBlocked AS IsBlocked,
	CatalogDiscountCards.IsBlockedAuthor AS IsBlockedAuthor,
	CatalogDiscountCards.IsBlockedDate AS IsBlockedDate,
	CatalogDiscountCards.LoyaltyType AS LoyaltyType,
	CatalogDiscountCards.Remarks AS Remarks,
	CatalogDiscountCards.Source AS Source,
	CatalogDiscountCards.TurnOffAutomaticDiscounts AS TurnOffAutomaticDiscounts,
	CatalogDiscountCards.ValidFrom AS ValidFrom,
	CatalogDiscountCards.ValidTo AS ValidTo,
	CASE
		WHEN CatalogDiscountCards.LoyaltyType = VALUE(Enum.LoyaltyType.Bonuses)
				OR CatalogDiscountCards.LoyaltyType = VALUE(Enum.LoyaltyType.Certificate)
			THEN ISNULL(Bonuses.AmountBalance, 0)
		WHEN CatalogDiscountCards.LoyaltyType = VALUE(Enum.LoyaltyType.Discount)
				AND ISNULL(CatalogDiscountCards.DiscountType.IsAccumulatingDiscount, FALSE)
			THEN CASE
					WHEN ISNULL(CatalogDiscountCards.DiscountType.BonusCalculationFactor, 0) &lt;&gt; 0
						THEN AccumulatingDiscounts.BonusBalance
					ELSE AccumulatingDiscounts.ResourceBalance
				END
		ELSE 0
	END AS AmountBalance,
	ISNULL(BonusesValues.AmountValue, 0) AS AmountValue,
	CatalogDiscountCards.ParentDiscountCard AS ParentDiscountCard
FROM
	Catalog.DiscountCards AS CatalogDiscountCards
		LEFT JOIN (SELECT
			BonusesBalance.Card AS Card,
			BonusesBalance.QuantityBalance AS AmountBalance
		FROM
			AccumulationRegister.Bonuses.Balance(, ) AS BonusesBalance) AS Bonuses
		ON CatalogDiscountCards.Ref = Bonuses.Card
		LEFT JOIN (SELECT
			AccumulatingDiscountResourcesBalance.DiscountDimension AS Card,
			AccumulatingDiscountResourcesBalance.DiscountType AS DiscountType,
			AccumulatingDiscountResourcesBalance.BonusBalance AS BonusBalance,
			AccumulatingDiscountResourcesBalance.ResourceBalance AS ResourceBalance
		FROM
			AccumulationRegister.AccumulatingDiscountResources.Balance(, ) AS AccumulatingDiscountResourcesBalance) AS AccumulatingDiscounts
		ON CatalogDiscountCards.DiscountType = AccumulatingDiscounts.DiscountType
			AND CatalogDiscountCards.Ref = AccumulatingDiscounts.Card
		LEFT JOIN (SELECT
			BonusesReceipts.Card AS Card,
			SUM(BonusesReceipts.Quantity) AS AmountValue
		FROM
			AccumulationRegister.Bonuses AS BonusesReceipts
		WHERE
			BonusesReceipts.Card.LoyaltyType = VALUE(Enum.LoyaltyType.Certificate)
			AND BonusesReceipts.RecordType = VALUE(AccumulationRecordType.Receipt)
		
		GROUP BY
			BonusesReceipts.Card) AS BonusesValues
		ON CatalogDiscountCards.Ref = BonusesValues.Card</QueryText>
