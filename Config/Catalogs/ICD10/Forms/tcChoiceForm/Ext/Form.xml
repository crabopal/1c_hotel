	<Attributes>
		<Attribute name="List" id="1">
			<Title>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>List</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>List.IsFolder</Field>
				<Field>List.Ref</Field>
				<Field>~List.Код</Field>
				<Field>~List.Наименование</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>SELECT
	ICDCatalog.Ref AS Ref,
	ICDCatalog.IsFolder AS IsFolder,
	ICDCatalog.Code AS Code,
	ICDCatalog.Description AS Description
FROM
	Catalog.ICD10 AS ICDCatalog
WHERE
	NOT ICDCatalog.DeletionMark
	AND (&amp;qShowInHierarchy
			OR NOT ICDCatalog.IsFolder)
	AND NOT ICDCatalog.IsFolder
	AND NOT ICDCatalog.DeletionMark
	AND (&amp;qCodeIsEmpty
			OR ICDCatalog.Code LIKE &amp;qCode)
	AND (&amp;qDescriptionIsEmpty
			OR ICDCatalog.Description LIKE &amp;qDescription)</QueryText>
				<MainTable>Catalog.ICD10</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter/>
							<dcsset:appearance/>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
