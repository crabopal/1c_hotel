	ServicesWithPrice.AvailableQuantity - ISNULL(ServicesUsage.Quantity, 0) AS Quantity
FROM
	ServicesWithPrice AS ServicesWithPrice
		LEFT JOIN ServicesUsage AS ServicesUsage
		ON ServicesWithPrice.Service = ServicesUsage.Service</QueryText>
