	<Attributes>
		<Attribute name="List" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>List.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	Services.Ref AS Service,
	Services.Code AS Code,
	Services.Description AS Description,
	Services.SortCode AS SortCode,
	Services.AvailableQuantity AS AvailableQuantity,
	Services.Hotel AS Hotel
INTO ServicesToBeShown
FROM
	Catalog.Services AS Services
WHERE
	Services.DeletionMark = FALSE
	AND Services.IsFolder = FALSE
	AND (Services.Hotel = &amp;qHotel
			OR Services.Hotel = VALUE(Catalog.Hotels.EmptyRef))
	AND Services.Ref IN HIERARCHY(&amp;qParent)
	AND (NOT &amp;qUseServicesList OR &amp;qUseServicesList AND Services.Ref IN (&amp;qServicesList))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ServicesWithPrice.Service AS Service,
	ServicesWithPrice.Code AS Code,
	ServicesWithPrice.SortCode AS SortCode,
	ServicesWithPrice.Description AS Description,
	ServicesWithPrice.AvailableQuantity AS AvailableQuantity,
	CASE
		WHEN NOT ServicesPricesByClientTypeByHotel.ClientType IS NULL
			THEN ServicesPricesByClientTypeByHotel.ClientType
		WHEN NOT ServicesPricesByClientTypeByEmptyHotel.ClientType IS NULL
			THEN ServicesPricesByClientTypeByEmptyHotel.ClientType
		WHEN NOT ServicesPricesByEmptyClientTypeByHotel.ClientType IS NULL
			THEN ServicesPricesByEmptyClientTypeByHotel.ClientType
		WHEN NOT ServicesPricesByEmptyClientTypeByEmptyHotel.ClientType IS NULL
			THEN ServicesPricesByEmptyClientTypeByEmptyHotel.ClientType
		ELSE VALUE(Catalog.ClientTypes.EmptyRef)
	END AS ClientType,
	CASE
		WHEN NOT ServicesPricesByClientTypeByHotel.Hotel IS NULL
			THEN ServicesPricesByClientTypeByHotel.Hotel
		WHEN NOT ServicesPricesByClientTypeByEmptyHotel.Hotel IS NULL
			THEN ServicesWithPrice.Hotel
		WHEN NOT ServicesPricesByEmptyClientTypeByHotel.Hotel IS NULL
			THEN ServicesPricesByEmptyClientTypeByHotel.Hotel
		WHEN NOT ServicesPricesByEmptyClientTypeByEmptyHotel.Hotel IS NULL
			THEN ServicesWithPrice.Hotel
		ELSE ServicesWithPrice.Hotel
	END AS Hotel,
	CASE
		WHEN NOT ServicesPricesByClientTypeByHotel.Currency IS NULL
			THEN ServicesPricesByClientTypeByHotel.Currency
		WHEN NOT ServicesPricesByClientTypeByEmptyHotel.Currency IS NULL
			THEN ServicesPricesByClientTypeByEmptyHotel.Currency
		WHEN NOT ServicesPricesByEmptyClientTypeByHotel.Currency IS NULL
			THEN ServicesPricesByEmptyClientTypeByHotel.Currency
		WHEN NOT ServicesPricesByEmptyClientTypeByEmptyHotel.Currency IS NULL
			THEN ServicesPricesByEmptyClientTypeByEmptyHotel.Currency
		ELSE VALUE(Catalog.Currencies.EmptyRef)
	END AS Currency,
	CASE
		WHEN NOT ServicesPricesByClientTypeByHotel.Price IS NULL
			THEN ServicesPricesByClientTypeByHotel.Price
		WHEN NOT ServicesPricesByClientTypeByEmptyHotel.Price IS NULL
			THEN ServicesPricesByClientTypeByEmptyHotel.Price
		WHEN NOT ServicesPricesByEmptyClientTypeByHotel.Price IS NULL
			THEN ServicesPricesByEmptyClientTypeByHotel.Price
		WHEN NOT ServicesPricesByEmptyClientTypeByEmptyHotel.Price IS NULL
			THEN ServicesPricesByEmptyClientTypeByEmptyHotel.Price
		ELSE 0
	END AS Price
INTO ServicesWithPrice
FROM
	ServicesToBeShown AS ServicesWithPrice
		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
				&amp;qAccountingDate,
				&amp;qClientTypeIsFilled
					AND Hotel = &amp;qHotel
					AND ClientType = &amp;qClientType) AS ServicesPricesByClientTypeByHotel
		ON ServicesWithPrice.Service = ServicesPricesByClientTypeByHotel.Service
		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
				&amp;qAccountingDate,
				&amp;qClientTypeIsFilled
					AND Hotel = VALUE(Catalog.Hotels.EmptyRef)
					AND ClientType = &amp;qClientType) AS ServicesPricesByClientTypeByEmptyHotel
		ON ServicesWithPrice.Service = ServicesPricesByClientTypeByEmptyHotel.Service
		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
				&amp;qAccountingDate,
				Hotel = &amp;qHotel
					AND ClientType = VALUE(Catalog.ClientTypes.EmptyRef)) AS ServicesPricesByEmptyClientTypeByHotel
		ON ServicesWithPrice.Service = ServicesPricesByEmptyClientTypeByHotel.Service
		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
				&amp;qAccountingDate,
				Hotel = VALUE(Catalog.Hotels.EmptyRef)
					AND ClientType = VALUE(Catalog.ClientTypes.EmptyRef)) AS ServicesPricesByEmptyClientTypeByEmptyHotel
		ON ServicesWithPrice.Service = ServicesPricesByEmptyClientTypeByEmptyHotel.Service
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SalesMovements.Service AS Service,
	SUM(SalesMovements.Quantity) AS Quantity
INTO UsedServices
FROM
	AccumulationRegister.Sales AS SalesMovements
		INNER JOIN ServicesToBeShown AS ServicesToBeShown
		ON SalesMovements.Service = ServicesToBeShown.Service
WHERE
	SalesMovements.AccountingDate = &amp;qBegOfAccountingDate
	AND SalesMovements.Service.AvailableQuantity &gt; 0
	AND SalesMovements.Hotel = &amp;qHotel
	AND &amp;qHotelIsFilled

GROUP BY
	SalesMovements.Service
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SalesForecastMovements.Service AS Service,
	SUM(SalesForecastMovements.Quantity) AS Quantity
INTO UsedForecastServices
FROM
	AccumulationRegister.SalesForecast AS SalesForecastMovements
		INNER JOIN ServicesToBeShown AS ServicesToBeShown
		ON SalesForecastMovements.Service = ServicesToBeShown.Service
WHERE
	&amp;qUseForecast
	AND SalesForecastMovements.AccountingDate = &amp;qBegOfAccountingDate
	AND SalesForecastMovements.Service.AvailableQuantity &gt; 0
	AND SalesForecastMovements.Hotel = &amp;qHotel
	AND &amp;qHotelIsFilled

GROUP BY
	SalesForecastMovements.Service
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ServicesUsage.Service AS Service,
	SUM(ServicesUsage.Quantity) AS Quantity
INTO ServicesUsage
FROM
	(SELECT
		UsedServices.Service AS Service,
		UsedServices.Quantity AS Quantity
	FROM
		UsedServices AS UsedServices
	
	UNION ALL
	
	SELECT
		UsedForecastServices.Service,
		UsedForecastServices.Quantity
	FROM
		UsedForecastServices AS UsedForecastServices) AS ServicesUsage

GROUP BY
	ServicesUsage.Service
;

