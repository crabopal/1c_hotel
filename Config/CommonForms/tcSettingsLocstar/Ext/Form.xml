				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Делать карты только из списка лицевых счетов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>xs:boolean</v8:Type>
			</Type>
		</Attribute>
		<Attribute name="DoorLockSystemParameters" id="15">
