			</Title>
			<Type>
				<v8:Type>xs:boolean</v8:Type>
			</Type>
		</Attribute>
		<Attribute name="DoKeyCardsFromFoliosOnly" id="13">
			<Title>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Do key cards from folios list only</v8:content>
