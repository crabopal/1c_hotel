				<v8:item>
					<v8:lang>de</v8:lang>
					<v8:content>Übersetzen Card ID in dezimal Kalkül System</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Перевести Card ID в десятичную систему исчисления</v8:content>
