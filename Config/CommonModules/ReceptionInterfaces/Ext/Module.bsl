						vExtraServiceRow.ServiceCode = vServiceRow.Service.Code;
						If ValueIsFilled(vServiceRow.Service.DescriptionTranslations) Then
							vExtraServiceRow.ServiceDescription = cmNStr(vServiceRow.Service.DescriptionTranslations, vLanguage);
						Else
							vExtraServiceRow.ServiceDescription = vServiceRow.Service.Description;
						EndIf;
						
						vExtraServiceRow.Price = vServiceRow.Sum - vServiceRow.DiscountSum;
						vExtraServiceRow.PriceBeforeDiscount = vServiceRow.Sum;
						vExtraServiceRow.Discount = vServiceRow.Discount;
						If ValueIsFilled(vCurrency) Then 
							vExtraServiceRow.PricePresentation = cmFormatSum(vServiceRow.Sum - vServiceRow.DiscountSum,vCurrency);
							vExtraServiceRow.Currency = String(vCurrency);
							vExtraServiceRow.CurrencyCode = vCurrency.Code;
							If ValueIsFilled(vCurrency.DescriptionTranslations) Then
								vExtraServiceRow.CurrencyDescription = cmNStr(vCurrency.DescriptionTranslations, vLanguage);
							Else
								vExtraServiceRow.CurrencyDescription = vCurrency.Description;
							EndIf;							
						Else						
							vExtraServiceRow.PricePresentation = vServiceRow.Sum - vServiceRow.DiscountSum;
						EndIf;
						vExtraServiceRow.Unit = vServiceRow.Unit;
						vExtraServiceRow.Remarks = vServiceRow.Remarks;
						vExtraServices.ExtraServiceRow.Add(vExtraServiceRow);
					EndIf;
				EndDo;
				
				vStatusRow.ExtraServices = vExtraServices;
				
				vStatusRow.Discount = vDocObj.Discount;
				
				vRetXDTO.ExternalReservationStatusRow.Add(vStatusRow);
				
				// Fill main guest, customer, contract, agent
				If ValueIsFilled(vDocObj.GuestGroup) Then
					vMainGuest = vDocObj.GuestGroup.Client;
					If ValueIsFilled(vDocObj.GuestGroup.ClientDoc) Then
						vMainCustomer = vDocObj.GuestGroup.ClientDoc.Customer;
						vMainContract = vDocObj.GuestGroup.ClientDoc.Contract;
						vMainAgent = vDocObj.GuestGroup.ClientDoc.Agent;
					EndIf;
				EndIf;
				
				// Save utm tags
				If i = 1 And (Not IsBlankString(vUTM_Source) Or Not IsBlankString(vUTM_Campaign)) Then
					vUTM = InformationRegisters.UTMTags.CreateRecordManager();
					vUTM.GuestGroup = vGuestGroup;
					vUTM.Hotel = vGuestGroup.Owner;
					vUTM.utm_source = vUTM_Source;
					vUTM.utm_campaign = vUTM_Campaign;
					vUTM.utm_medium = vUTM_Medium;
					vUTM.utm_content = vUTM_Content;
					vUTM.Write(True);
				EndIf;
			Else
				vReservationNumber = "";
				vReservationDate = Undefined;
				vPriceCalculationDate = '00010101';
				vRoomCode = "";
				Raise rErrorDescription;
			EndIf;
		EndDo;
		// Write message to the reservation department that new reservation was created
		If ValueIsFilled(vGuestGroup) And IsBlankString(rErrorDescription) And ValueIsFilled(vGuestGroup.Owner) And ValueIsFilled(vGuestGroup.Owner.ReservationDepartment) Then
			vReservationDepartment = vGuestGroup.Owner.ReservationDepartment;
			vClientDoc = vGuestGroup.ClientDoc;
			If ValueIsFilled(vClientDoc) And TypeOf(vClientDoc) = Type("DocumentRef.Reservation") Then
				vPeriodStr = ", " + Format(vGuestGroup.CheckInDate, "DF='dd.MM.yyyy HH:mm'") + " - " + Format(vGuestGroup.CheckOutDate, "DF='dd.MM.yyyy HH:mm'");
				vMsgText = NStr("en='New external reservation was created! Reservation data: Group code " + TrimAll(vGuestGroup) + vPeriodStr + ", room type " + TrimAll(vClientDoc.RoomType) + ", guest " + TrimAll(vClientDoc.Guest) + "'; 
				                |de='New external reservation was created! Reservation data: Group code " + TrimAll(vGuestGroup) + vPeriodStr + ", room type " + TrimAll(vClientDoc.RoomType) + ", guest " + TrimAll(vClientDoc.Guest) + "'; 
				                |ru='Создана новая внешняя бронь! Данные брони: Код группы " + TrimAll(vGuestGroup) + vPeriodStr + ", тип номера " + TrimAll(vClientDoc.RoomType) + ", ФИО гостя " + TrimAll(vClientDoc.Guest) + "'");
				// Call API
				cmSendMessageToDepartment(vReservationDepartment, vMsgText, Undefined, False, vGuestGroup);
			EndIf;
		EndIf;
		// Send E-Mail notifications
		If ValueIsFilled(vGuestGroup) And vDocObj <> Undefined And IsBlankString(rErrorDescription) Then
			vGroupClientDoc = vGuestGroup.ClientDoc;
			If ValueIsFilled(vGroupClientDoc) And TypeOf(vGroupClientDoc) = Type("DocumentRef.Reservation") Then
				vClientDocObj = vGroupClientDoc.GetObject();
				If ValueIsFilled(vGroupClientDoc.ReservationStatus) And (vGroupClientDoc.ReservationStatus.IsActive Or vGroupClientDoc.ReservationStatus.IsPreliminary) Then
					If TrimAll(ExtSystemCode) = "1CBITRIX" And ValueIsFilled(vGuestGroup.Customer) And Not vGuestGroup.Customer.IsIndividual Then
						// Send E-Mail notification and proforma invoice to the agent
						If Not IsBlankString(vGuestGroup.Customer.EMail) Then
							cmWriteReservationConfirmationGuestGroupAttachment(vClientDocObj, True, TrimAll(vGuestGroup.Customer.EMail), 1);

							// Proforma invoice
							vWhoPaysStr = "";
							vWhoPays = vClientDocObj.pmSetPlannedPaymentMethod(vWhoPaysStr);
							If vWhoPays <> Enums.WhoPays.Guest Then
								cmWriteReservationInvoiceGuestGroupAttachment(vClientDocObj);
							EndIf;
						EndIf;
						
						// Send E-Mail notification to the reservation department
						vReservationDepartment = vHotel.ReservationDepartment;
						If ValueIsFilled(vReservationDepartment) And Not IsBlankString(vReservationDepartment.EMail) Then
							cmWriteReservationConfirmationGuestGroupAttachment(vClientDocObj, False, TrimAll(vReservationDepartment.EMail), 2);
						EndIf;
					Else
						// Send E-Mail notification to the guest
						If ValueIsFilled(vGuestGroup.Client) And Not IsBlankString(vGuestGroup.Client.EMail) Then
							If vClientDocObj.ReservationStatus.DeliveryType <> Enums.DeliveryTypes.DoNotSend Then
								cmWriteReservationConfirmationGuestGroupAttachment(vClientDocObj);
							EndIf;
						EndIf;
					EndIf;
				EndIf;
				// Release SMS delivery for this transaction
				SessionParameters.SMSDeliveryIsStopped = False;
				// Send reservation change status SMS notification
				vMessageDeliveryError = "";
				If Not SMS.SendChangeDocumentSatusMessage(vClientDocObj.Ref, vMessageDeliveryError) Then
					WriteLogEvent(NStr("en='Document.MessageDelivery';ru='Документ.РассылкаСообщений';de='Document.MessageDelivery'"), EventLogLevel.Warning, vClientDocObj.Metadata(), vClientDocObj.Ref, vMessageDeliveryError);
				EndIf;
			EndIf;
		EndIf;
		// Fill first day price totals attributes
		If vTotalFirstDaySum <> 0 Then
			vTotalFirstDaySumPresentation = cmFormatSum(vTotalFirstDaySum, vCurrency, "NZ=");
		EndIf;
		// Add totals
		vRetXDTO.GuestGroup = Format(vGuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=");
		vRetXDTO.UUID = String(vGuestGroup.UUID());
		If ValueIsFilled(vMainCustomer) Then
			vRetXDTO.Customer = TrimR(vMainCustomer.Description);
			vRetXDTO.CustomerLegacyName = TrimAll(vMainCustomer.LegacyName);
			vRetXDTO.CustomerLegacyAddress = TrimAll(vMainCustomer.LegacyAddress);
			vRetXDTO.CustomerTIN = TrimAll(vMainCustomer.TIN);
			vRetXDTO.CustomerKPP = TrimAll(vMainCustomer.KPP);
			vRetXDTO.CustomerEMail = TrimAll(vMainCustomer.EMail);
			vRetXDTO.CustomerPhone = TrimAll(vMainCustomer.Phone);
		Else
			vRetXDTO.Customer = "";
			vRetXDTO.CustomerLegacyName = "";
			vRetXDTO.CustomerLegacyAddress = "";
			vRetXDTO.CustomerTIN = "";
			vRetXDTO.CustomerKPP = "";
			vRetXDTO.CustomerEMail = "";
			vRetXDTO.CustomerPhone = "";
		EndIf;
		If ValueIsFilled(vMainContract) Then
			vRetXDTO.Contract = TrimR(vMainContract.Description);
		Else
			vRetXDTO.Contract = "";
		EndIf;
		If ValueIsFilled(vMainAgent) Then
			vRetXDTO.Agent = TrimR(vMainAgent.Description);
		Else
			vRetXDTO.Agent = "";
		EndIf;
		If ValueIsFilled(vMainGuest) Then
			vRetXDTO.GuestCode = TrimAll(vMainGuest.Code);
			vRetXDTO.GuestFullName = TrimR(vMainGuest.FullName);
			vRetXDTO.GuestBirthDate = vMainGuest.DateOfBirth;
			vRetXDTO.GuestPassport = TrimR(TrimR(vMainGuest.IdentityDocumentSeries) + " " + TrimR(vMainGuest.IdentityDocumentNumber));
			vRetXDTO.GuestPhone = TrimR(vMainGuest.Phone);
			vRetXDTO.GuestFax = TrimR(vMainGuest.Fax);
			vRetXDTO.GuestEMail = TrimR(vMainGuest.EMail);
		Else
			vRetXDTO.GuestCode = "";
			vRetXDTO.GuestFullName = "";
			vRetXDTO.GuestBirthDate = Undefined;
			vRetXDTO.GuestPassport = "";
			vRetXDTO.GuestPhone = "";
			vRetXDTO.GuestFax = "";
			vRetXDTO.GuestEMail = "";
		EndIf;
		vRetXDTO.Currency = vCurrencyExtCode;
		vRetXDTO.CurrencyCode = TrimAll(vCurrency.Code);
		vRetXDTO.CurrencyDescription = TrimAll(vCurrency.Description);
		vRetXDTO.BaseCurrency = vExtBaseCurrencyCode;
		vRetXDTO.CurrencyRate = vCurrencyRate;
		vRetXDTO.TotalSum = vTotalSum;
		vRetXDTO.TotalSumPresentation = cmFormatSum(vTotalSum, vCurrency, "NZ=");
		vRetXDTO.TotalSumBeforeDiscount = vTotalSumBeforeDiscount;
		vRetXDTO.BalanceAmount = vTotalSum;
		vRetXDTO.BalanceAmountPresentation = cmFormatSum(vTotalSum, vCurrency, "NZ=");
		vRetXDTO.BalanceAmountBeforeDiscount = vTotalSumBeforeDiscount;
		vRetXDTO.FirstDaySum = vTotalFirstDaySum;
		vRetXDTO.FirstDaySumPresentation = vTotalFirstDaySumPresentation;
		vRetXDTO.FirstDaySumBeforeDiscount = vTotalFirstDaySumBeforeDiscount;
		If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.Owner) Then
			vRetXDTO.HotelName = Catalogs.Hotels.pmGetHotelPrintName(vGuestGroup.Owner, vLanguage);
		EndIf;
		vRetXDTO.HotelCode = TrimAll(vGuestGroup.Owner.Code);
		vRetXDTO.ReservationConditions = cmNStr(vGuestGroup.Owner.ReservationConditions, vLanguage);
		vMainGroupDoc = vGuestGroup.ClientDoc;
		If ValueIsFilled(vMainGroupDoc) And 
		  (TypeOf(vMainGroupDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vMainGroupDoc) = Type("DocumentRef.Reservation")) Then
			vRoomRate = vMainGroupDoc.RoomRate;
			If ValueIsFilled(vRoomRate) Then
				vRetXDTO.RoomRateCode = TrimAll(vRoomRate.Code);
				vRetXDTO.RoomRateDescription = vRoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
				vRetXDTO.ReservationConditions = cmNStr(vRoomRate.ReservationConditions, vLanguage);
				vRetXDTO.ReservationConditionsShort = cmNStr(vRoomRate.ReservationConditionsShort, vLanguage);
				vRetXDTO.ReservationConditionsOnline = cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage);
				vRetXDTO.PaymentMethodCodesAllowedOnline = TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline);
				vRetXDTO.Discount = vMainGroupDoc.Discount;
			EndIf;
		EndIf;
		If ValueIsFilled(vGuestGroup.CheckDate) Then
			vRetXDTO.CheckDate = vGuestGroup.CheckDate;
		EndIf;
		vRetXDTO.ExtGuestGroupCode = TrimAll(vGuestGroup.ExternalCode); 
		If ValueIsFilled(vInteraction) AND vInteraction.ReturnPaymentURL Then
			vRetXDTO.PaymentURL = Catalogs.ExternalSystemInteractions.GetGuestGroupURL(vGuestGroup);
		EndIf;
		// Cancel fee attributes
		vCancelFeeDate = '00010101';
		vCancelFeeAmount = 0;
		cmGetCancelFeeAttributes(vGuestGroup, vRetXDTO.TotalSum, vRetXDTO.FirstDaySum, vCancelFeeDate, vCancelFeeAmount);
		vRetXDTO.CancelFeeDate = vCancelFeeDate;
		vRetXDTO.CancelFeeAmount = vCancelFeeAmount;
		vCancelFeeAmountBeforeDiscount = 0;
		cmGetCancelFeeAttributes(vGuestGroup, vRetXDTO.TotalSumBeforeDiscount, vRetXDTO.FirstDaySumBeforeDiscount, vCancelFeeDate, vCancelFeeAmountBeforeDiscount);
		vRetXDTO.CancelFeeAmountBeforeDiscount = vCancelFeeAmountBeforeDiscount;
		// Commit transaction
		CommitTransaction();
		// Debug
		If vWriteDebug Then
			vExtraXML = "";
			vXMLWriter = New XMLWriter; 
			vXMLWriter.SetString();
			XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
			vExtraXML = vXMLWriter.Close();

			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmWriteExternalGroupReservation", Enums.ExternalSystemEventTypes.Info, ,vExtraXML , vMsg, vInteraction.MaxLogLenght);
		EndIf;
		// Return 
		Return vRetXDTO;
	Except
		vErrorDescription = cmGetRootErrorDescription(ErrorInfo());
		// Rollback transaction
		If TransactionActive() Then
			RollbackTransaction();
		EndIf;
		If ValueIsFilled(vInteraction) And Not TransactionActive() Then
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmWriteExternalGroupReservation", Enums.ExternalSystemEventTypes.Error, , , ErrorDescription(), vInteraction.MaxLogLenght);
		Else
			// Write log event
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Error, , , 
			              NStr("en='Error description: ';ru='Описание ошибки: ';de='Fehlerbeschreibung: '") + vErrorDescription, EventLogEntryTransactionMode.Independent);
		EndIf;	
		// Run SMS delivery for this transaction
		SessionParameters.SMSDeliveryIsStopped = False;
		// Return
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
		vRetXDTO.ErrorDescription = Left(vErrorDescription, 4096);
		vRetXDTO.GuestGroup = "";
		vRetXDTO.UUID = "";
		vRetXDTO.Currency = "";
		vRetXDTO.TotalSum = 0;
		vRetXDTO.TotalSumPresentation = "";
		vRetXDTO.TotalSumBeforeDiscount = 0;
		vRetXDTO.BalanceAmount = 0;
		vRetXDTO.BalanceAmountPresentation = "";
		vRetXDTO.BalanceAmountBeforeDiscount = 0;
		vRetXDTO.FirstDaySum = 0;
		vRetXDTO.FirstDaySumPresentation = "";
		vRetXDTO.FirstDaySumBeforeDiscount = 0;
		vRetXDTO.Discount = 0;
		Return vRetXDTO;
	EndTry;
EndFunction // cmWriteExternalGroupReservation

// -----------------------------------------------------------------------------
// Description: This API is used to retrive reservation status data from the external system
// Parameters: External reservation code, Hotel code, External system code, Language code, 
//             Type of return value: XDTO object or CSV string
// Return value: XDTO ExternalReservationStatus object
// -----------------------------------------------------------------------------
Function cmGetExternalReservationStatus(pExtReservationCode, pHotelCode, pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV") Export
	WriteLogEvent(NStr("en='Get external reservation status';ru='Получить статус внешней брони';de='Liste externer Reservierung erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='External system reservation identifier: ';ru='Идентификатор брони во внешней системе: ';de='Identifikator der Reservierung im externen System: '") + pExtReservationCode);
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Try to find existing reservation with given external code
	vErrorDescription = "";
	vDocRef = cmGetReservationByExternalCode(vHotel, pExtReservationCode);
	If ValueIsFilled(vDocRef) Then
		vDocRefCustomer = vDocRef.Customer;
		// Fill reservation totals assuming that all sums are in one currency.
		vExtReservationStatusCode = "";
		vExtReservationStatusCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "ReservationStatuses", vDocRef.ReservationStatus);
		If IsBlankString(vExtReservationStatusCode) Then
			vExtReservationStatusCode = TrimAll(vDocRef.ReservationStatus.Description);
		EndIf;
		vReservationStatusDescription = Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vDocRef.ReservationStatus, vLanguage);
		vReservationSum = 0;
		vReservationCurrency = Catalogs.Currencies.EmptyRef();
		vReservationExtCurrencyCode = "";
		vReservationSumPresentation = "";
		If vDocRef.Services.Count() > 0 Then
			vReservationCurrency = vDocRef.Services.Get(0).FolioCurrency;
			vReservationExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "Currencies", vReservationCurrency);
			If IsBlankString(vReservationExtCurrencyCode) Then
				vReservationExtCurrencyCode = TrimAll(vReservationCurrency.Description);
			EndIf;
			vReservationSum = vDocRef.Services.Total("Sum") - vDocRef.Services.Total("DiscountSum");
			vReservationSumPresentation = cmFormatSum(vReservationSum, vReservationCurrency, "NZ=");
		EndIf;
		// Get base currency code
		vBaseCurrency = vDocRef.Hotel.BaseCurrency;
		vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "Currencies", vBaseCurrency);
		If IsBlankString(vExtBaseCurrencyCode) Then
			vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
		EndIf;
		// Get currency rate
		vReservationCurrencyRate = 1;
		If ValueIsFilled(vReservationCurrency) Then
			vReservationCurrencyRate = cmGetCurrencyExchangeRate(vDocRef.Hotel, vReservationCurrency, CurrentSessionDate());
		EndIf;
		// Room type and accommodation type
		vExtRoomTypeCode = "";
		vRoomTypeCode = "";
		vRoomTypeDescription = "";
		If ValueIsFilled(vDocRef.RoomTypeUpgrade) Then
			vRoomTypeObj = vDocRef.RoomTypeUpgrade.GetObject();
			vRoomTypeCode = TrimAll(vDocRef.RoomTypeUpgrade.Code);
			vRoomTypeDescription = vRoomTypeObj.pmGetRoomTypeDescription(vLanguage);
			vExtRoomTypeCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "RoomTypes", vDocRef.RoomTypeUpgrade);
			If IsBlankString(vExtRoomTypeCode) Then
				vExtRoomTypeCode = TrimAll(vDocRef.RoomTypeUpgrade.Description);
			EndIf;
		ElsIf ValueIsFilled(vDocRef.RoomType) Then
			vRoomTypeObj = vDocRef.RoomType.GetObject();
			vRoomTypeCode = TrimAll(vDocRef.RoomType.Code);
			vRoomTypeDescription = vRoomTypeObj.pmGetRoomTypeDescription(vLanguage);
			vExtRoomTypeCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "RoomTypes", vDocRef.RoomType);
			If IsBlankString(vExtRoomTypeCode) Then
				vExtRoomTypeCode = TrimAll(vDocRef.RoomType.Description);
			EndIf;
		EndIf;
		vExtAccommodationTypeCode = "";
		vAccommodationTypeCode = "";
		vAccommodationTypeDescription = "";
		If ValueIsFilled(vDocRef.AccommodationType) Then
			vAccommodationTypeObj = vDocRef.AccommodationType.GetObject();
			vAccommodationTypeCode = TrimAll(vDocRef.AccommodationType.Code);
			vAccommodationTypeDescription = vAccommodationTypeObj.pmGetAccommodationTypeDescription(vLanguage);
			vExtAccommodationTypeCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "AccommodationTypes", vDocRef.AccommodationType);
			If IsBlankString(vExtAccommodationTypeCode) Then
				vExtAccommodationTypeCode = TrimAll(vDocRef.AccommodationType.Description);
			EndIf;
		EndIf;
		// Fill reservation first day price
		vFirstDaySum = 0;
		vFirstDaySumCurrency = Undefined;
		vFirstDaySumPresentation = "";
		vPrices = vDocRef.GetObject().pmGetPrices(True);
		vFirstAccDate = Undefined;
		For Each vPricesRow In vPrices Do
			If Not ValueIsFilled(vFirstAccDate) Then
				vFirstAccDate = vPricesRow.AccountingDate;
				vFirstDaySumCurrency = vPricesRow.FolioCurrency;
			EndIf;
			If vPricesRow.AccountingDate = vFirstAccDate Then
				vFirstDaySum = vFirstDaySum + vPricesRow.Price;
			Else
				Break;
			EndIf;
		EndDo;
		If vFirstDaySumCurrency <> vReservationCurrency Then
			vFirstDaySum = Round(cmConvertCurrencies(vFirstDaySum, vFirstDaySumCurrency, , vReservationCurrency, , CurrentSessionDate(), vDocRef.Hotel), 2);
		EndIf;
		If vFirstDaySum <> 0 Then
			vFirstDaySumPresentation = cmFormatSum(vFirstDaySum, vReservationCurrency, "NZ=");
		EndIf;
		// Zero amount if this reservation is not individual
		If Not (Not ValueIsFilled(vDocRefCustomer) Or 
		   ValueIsFilled(vDocRefCustomer) And vDocRefCustomer.IsIndividual Or 
		   ValueIsFilled(vDocRefCustomer) And Not vDocRefCustomer.IsIndividual And ValueIsFilled(vDocRef) And TypeOf(vDocRef) = Type("DocumentRef.Reservation") And Not vDocRef.PlannedPaymentMethod.IsByBankTransfer) Then
			vReservationSum = 0;
			vReservationSumPresentation = "";
			vFirstDaySum = 0;
			vFirstDaySumPresentation = "";
		EndIf;
		// Build return string
		vRetStr = """" + vErrorDescription + """" + "," + """" + TrimAll(vDocRef.Number) + """" + "," + 
		          """" + TrimAll(vExtReservationStatusCode) + """" + "," + """" + cmRemoveComma(vDocRef.ConfirmationReply) + """" + "," + 
		          """" + TrimAll(vDocRef.Posted) + """" + "," + """" + Format(vDocRef.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," + 
		          """" + TrimAll(vDocRef.ReservationStatus.Code) + """" + "," + """" + cmRemoveComma(vReservationStatusDescription) + """" + "," + 
				  Format(vDocRef.RoomQuantity, "ND=10; NFD=0; NZ=; NG=") + "," + Format(vDocRef.NumberOfPersons, "ND=10; NFD=0; NZ=; NG=") + "," + 
				  """" + TrimAll(vExtRoomTypeCode) + """" + "," + """" + TrimAll(vRoomTypeCode) + """" + "," + """" + cmRemoveComma(vRoomTypeDescription) + """" + "," + 
				  """" + TrimAll(vExtAccommodationTypeCode) + """" + "," + """" + TrimAll(vAccommodationTypeCode) + """" + "," + """" + cmRemoveComma(vAccommodationTypeDescription) + """" + "," + 
				  """" + Format(vDocRef.CheckInDate, "DF='dd.MM.yyyy HH:mm'") + """" + "," + Format(vDocRef.Duration, "ND=10; NFD=0; NZ=; NG=") + "," + """" + Format(vDocRef.CheckOutDate, "DF='dd.MM.yyyy HH:mm'") + """" + "," + 
				  """" + TrimAll(vReservationExtCurrencyCode) + """" + "," + """" + TrimAll(vReservationCurrency.Code) + """" + "," + """" + cmRemoveComma(vReservationCurrency.Description) + """" + "," + 
		          Format(vReservationSum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
				  """" + StrReplace(vReservationSumPresentation, ",", ".") + """" + "," + 
				  Format(vFirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
				  """" + StrReplace(vFirstDaySumPresentation, ",", ".") + """";
		// Write log event
		WriteLogEvent(NStr("en='Get external reservation status';ru='Получить статус внешней брони';de='Liste externer Reservierung erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf:'") + vRetStr);
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vStatusRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatusRow"));
			vStatusRow.IsPosted = vDocRef.Posted;
			vStatusRow.ReservationNumber = TrimAll(vDocRef.Number);
			vStatusRow.ReservationStatus = vExtReservationStatusCode;
			vStatusRow.ReservationStatusCode = TrimAll(vDocRef.ReservationStatus.Code);
			vStatusRow.ReservationStatusDescription = vReservationStatusDescription;
			vStatusRow.ConfirmationReply = Left(TrimAll(vDocRef.ConfirmationReply), 4096);
			vStatusRow.GuestGroup = Format(vDocRef.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=");
			If ValueIsFilled(vDocRef.Guest) Then
				vStatusRow.GuestFullName = TrimR(vDocRef.Guest.FullName);
				vStatusRow.GuestBirthDate = vDocRef.Guest.DateOfBirth;
				vStatusRow.GuestPassport = TrimR(TrimR(vDocRef.Guest.IdentityDocumentSeries) + " " + TrimR(vDocRef.Guest.IdentityDocumentNumber));
				vStatusRow.GuestPhone = TrimR(vDocRef.Guest.Phone);
				vStatusRow.GuestFax = TrimR(vDocRef.Guest.Fax);
				vStatusRow.GuestEMail = TrimR(vDocRef.Guest.EMail);
				vStatusRow.GuestIdentityDocumentType = TrimAll(vDocRef.Guest.IdentityDocumentType.Code); 
				vStatusRow.GuestIdentityDocumentSeries = TrimAll(vDocRef.Guest.IdentityDocumentSeries);
				vStatusRow.GuestIdentityDocumentNumber = TrimAll(vDocRef.Guest.IdentityDocumentNumber);
				vStatusRow.GuestIdentityDocumentIssuedBy = TrimAll(vDocRef.Guest.IdentityDocumentIssuedBy);
				vStatusRow.GuestIdentityDocumentValidToDate = vDocRef.Guest.IdentityDocumentValidToDate;
				vStatusRow.GuestIdentityDocumentIssueDate = vDocRef.Guest.IdentityDocumentIssueDate;
				vStatusRow.GuestCitizenship = TrimAll(vDocRef.Guest.Citizenship.ISOCode);
				vStatusRow.GuestSendSMS = Not vDocRef.Guest.NoSMSDelivery;
				vStatusRow.GuestSex = Left(TrimAll(String(vDocRef.Guest.Sex)), 1);
				vStatusRow.GuestLastName = TrimAll(vDocRef.Guest.LastName);
				vStatusRow.GuestFirstName = TrimAll(vDocRef.Guest.FirstName);
				vStatusRow.GuestSecondName = TrimAll(vDocRef.Guest.SecondName);
				vStatusRow.GuestAddress = TrimAll(vDocRef.Guest.Address);
			Else
				vStatusRow.GuestFullName = "";
				vStatusRow.GuestBirthDate = Undefined;
				vStatusRow.GuestPassport = "";
				vStatusRow.GuestPhone = "";
				vStatusRow.GuestFax = "";
				vStatusRow.GuestEMail = "";
				vStatusRow.GuestIdentityDocumentType = ""; 
				vStatusRow.GuestIdentityDocumentSeries = ""; 
				vStatusRow.GuestIdentityDocumentNumber = ""; 
				vStatusRow.GuestIdentityDocumentIssuedBy = ""; 
				vStatusRow.GuestIdentityDocumentValidToDate = Undefined;
				vStatusRow.GuestIdentityDocumentIssueDate = Undefined;
				vStatusRow.GuestCitizenship = ""; 
				vStatusRow.GuestSendSMS = Undefined;
				vStatusRow.GuestSex = ""; 
				vStatusRow.GuestLastName = ""; 
				vStatusRow.GuestFirstName = ""; 
				vStatusRow.GuestSecondName = ""; 
				vStatusRow.GuestAddress = "";
			EndIf;
			If ValueIsFilled(vDocRef.AccommodationType) And vDocRef.AccommodationType.Type = Enums.AccomodationTypes.Room Then
				vStatusRow.RoomQuantity = vDocRef.RoomQuantity;
			Else
				vStatusRow.RoomQuantity = 0;
			EndIf;
			vStatusRow.NumberOfPersons = vDocRef.NumberOfPersons;
			vStatusRow.RoomType = vExtRoomTypeCode;
			vStatusRow.RoomTypeCode = vRoomTypeCode;
			vStatusRow.RoomTypeDescription = vRoomTypeDescription;
			vStatusRow.AccommodationType = vExtAccommodationTypeCode;
			vStatusRow.AccommodationTypeCode = vAccommodationTypeCode;
			vStatusRow.AccommodationTypeDescription = vAccommodationTypeDescription;
			vStatusRow.CheckInDate = vDocRef.CheckInDate;
			vStatusRow.Duration = vDocRef.Duration;
			vStatusRow.CheckOutDate = vDocRef.CheckOutDate;
			vStatusRow.Currency = vReservationExtCurrencyCode;
			vStatusRow.CurrencyCode = TrimAll(vReservationCurrency.Code);
			vStatusRow.CurrencyDescription = TrimAll(vReservationCurrency.Description);
			vStatusRow.BaseCurrency = vExtBaseCurrencyCode;
			vStatusRow.CurrencyRate = vReservationCurrencyRate;
			vStatusRow.Sum = vReservationSum;
			vStatusRow.SumPresentation = vReservationSumPresentation;
			vStatusRow.FirstDaySum = vFirstDaySum;
			vStatusRow.FirstDaySumPresentation = vFirstDaySumPresentation;
			vStatusRow.PaymentMethodCodesAllowedOnline = vDocRef.RoomRate.PaymentMethodCodesAllowedOnline;
			vStatusRow.ExtReservationCode = TrimAll(vDocRef.ExternalCode);
			vStatusRow.RoomQuotaCode = TrimAll(vDocRef.RoomQuota.Code);
			If ValueIsFilled(vDocRef.RoomRate) Then
				vStatusRow.RoomRateCode = TrimAll(vDocRef.RoomRate.Code);
				vStatusRow.RoomRateDescription = vDocRef.RoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
			EndIf;
			vStatusRow.Room = TrimAll(vDocRef.Room);
			vStatusRow.GuestAge = vDocRef.GuestAge;
			vStatusRow.Adults = vDocRef.NumberOfAdults; 
			vStatusRow.Children = vDocRef.NumberOfTeenagers + vDocRef.NumberOfChildren + vDocRef.NumberOfInfants;
			// Fill board place
			vBoardPlaceType = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "BoardPlace"));
			vDoorLockAuthType = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "DoorLockAuth"));
			
			vBoardPlace = vDocRef.BoardPlace;
			If ValueIsFilled(vBoardPlace) Then
				vBoardPlaceType.Code = TrimAll(vBoardPlace.Code);
				vBoardPlaceType.Description = TrimAll(vBoardPlace.Description);
				vDoorLockAuth = vBoardPlace.DoorLockSystemAuthorization;
				If ValueIsFilled(vDoorLockAuth) Then
					FillPropertyValues(vDoorLockAuthType,vDoorLockAuth,"Code,Description,KeyCardType,UserGroup,AssignedAuthorizations,DeniedAuthorizations");
					vDoorLockAuthType.Room = TrimAll(vDoorLockAuth.Room);
				EndIf;	
			EndIf;	
			vBoardPlaceType.DoorLockAuth = vDoorLockAuthType;
			vStatusRow.BoardPlace = vBoardPlaceType;
			
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatus"));
			vRetXDTO.ErrorDescription = "";  
			
			vStatusRow.PaymentList = GetPaymentsByReservation(vDocRef);
			
			vRetXDTO.ExternalReservationStatusRow = vStatusRow;
			
			
			Return vRetXDTO;
		EndIf;
	Else
		vErrorDescription = NStr("en='Reservation was not found by external system code!';ru='Не удалось найти бронь по ее коду во внешней системе!';de='Die Reservierung konnte nach ihrem Code im externen System nicht gefunden werden!'");
		// Build return string
		vRetStr = """" + vErrorDescription + """";
		// Write log event
		WriteLogEvent(NStr("en='Get external reservation status';ru='Получить статус внешней брони';de='Liste externer Reservierung erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatus"));
			vRetXDTO.ErrorDescription = vErrorDescription;
			Return vRetXDTO;
		EndIf;
	EndIf;
EndFunction

// -----------------------------------------------------------------------------
Function cmGetGroupExtraCharges(pGroupRef) Export
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Charges.Service AS Service,
	|	Charges.Price AS Price,
	|	Charges.Quantity AS Quantity,
	|	Charges.Sum AS Sum,
	|	Charges.Date AS Date,
	|	Charges.Remarks AS Remarks,
	|	Charges.DiscountSum AS DiscountSum,
	|	Charges.Discount AS Discount,
	|	Charges.FolioCurrency AS Currency,
	|	Orders.Ref AS Order,
	|	Storno.Ref AS Ref
	|FROM
	|	Document.Charge AS Charges
	|		LEFT JOIN Document.Storno AS Storno
	|		ON (Storno.ParentCharge = Charges.Ref)
	|			AND (Storno.Posted)
	|		LEFT JOIN Document.Order AS Orders
	|		ON (Orders.Charge = Charges.Ref)
	|			AND (NOT Orders.DeletionMark)
	|WHERE
	|	Charges.Posted
	|	AND Charges.Folio.GuestGroup = &qGuestGroup
	|	AND Charges.Folio.ParentDoc = UNDEFINED
	|	AND Storno.Ref IS NULL";
	vQry.SetParameter("qGuestGroup", pGroupRef);
	vCharges = vQry.Execute().Unload();
	Return vCharges;
EndFunction // cmGetGroupExtraCharges

