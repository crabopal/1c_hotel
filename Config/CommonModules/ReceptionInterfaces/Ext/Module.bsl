// -----------------------------------------------------------------------------
// Description: Calculates and returns duration for giving check-in and check-out dates
// Parameters: Room rate, Check-in date & time, Check-out date & time
// Return value: Number, duration in days or hours
// -----------------------------------------------------------------------------
Function cmCalculateDuration(pRoomRate = Undefined, pCheckInDate, pCheckOutDate) Export
	vDuration = 0;
	If ValueIsFilled(pRoomRate) And
	   ValueIsFilled(pCheckInDate) And
	   ValueIsFilled(pCheckOutDate) Then
		vRRPer = ?(pRoomRate.PeriodInHours = 0, 24, pRoomRate.PeriodInHours);
		If pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour And 
		   pRoomRate.ReferenceHour = '00010101' Then
			vPerInSec = EndOfDay(pCheckOutDate) - BegOfDay(pCheckInDate);
			vDuration = Round(vPerInSec / vRRPer / 3600, 0);
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour Then
			vReferenceHour = pRoomRate.ReferenceHour - BegOfDay(pRoomRate.ReferenceHour);
			vPerInSec = (BegOfDay(pCheckOutDate) + vReferenceHour) - (BegOfDay(pCheckInDate) + vReferenceHour);
			vDuration = Round(vPerInSec / vRRPer / 3600, 0);
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByDays Then
			vPerInSec = EndOfDay(pCheckOutDate) - BegOfDay(pCheckInDate);
			vDuration = Round(vPerInSec / vRRPer / 3600, 0);
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Then
			vPerInSec = cm0SecondShift(pCheckOutDate) - cm0SecondShift(pCheckInDate);
			vDuration = Round(vPerInSec / vRRPer / 3600, 0);
		Else
			vPerInSec = cm0SecondShift(pCheckOutDate) - cm0SecondShift(pCheckInDate);
			vDuration = Round(vPerInSec / vRRPer / 3600, 0);
		EndIf;
	EndIf;
	If Not ValueIsFilled(pRoomRate) And
	   ValueIsFilled(pCheckInDate) And
	   ValueIsFilled(pCheckOutDate) Then
		vRRPer = 24;
		vPerInSec = cm0SecondShift(pCheckOutDate) - cm0SecondShift(pCheckInDate);
		vDuration = Round(vPerInSec / vRRPer / 3600, 0);
	EndIf;
	Return vDuration;
EndFunction // cmCalculateDuration

// -----------------------------------------------------------------------------
// Description: Calculates and returns check-out date & time for the given check-in
//              date and duration
// Parameters: Room rate, Check-in date & time, Duration in days or hours
// Return value: Date, check-out date & time
// -----------------------------------------------------------------------------
Function cmCalculateCheckOutDate(pRoomRate = Undefined, pCheckInDate, pDuration) Export
	vCheckInDate = cm0SecondShift(pCheckInDate);
	vCheckOutDate = Undefined;
	vPeriodInHours = 24;
	If ValueIsFilled(pRoomRate) Then
		vPeriodInHours = ?(pRoomRate.PeriodInHours = 0, vPeriodInHours, pRoomRate.PeriodInHours);
		vReferenceHour = pRoomRate.ReferenceHour - BegOfDay(pRoomRate.ReferenceHour);
		vDefaultCheckOutTime = pRoomRate.DefaultCheckOutTime;
		If pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour Then
			If vReferenceHour = 0 Then
				vCheckOutDate = BegOfDay(vCheckInDate) + vReferenceHour + pDuration * vPeriodInHours * 3600 - 1;
			Else
				vCheckOutDate = BegOfDay(vCheckInDate) + vReferenceHour + pDuration * vPeriodInHours * 3600;
			EndIf;
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByDays Then
			vCheckOutDate = BegOfDay(vCheckInDate) + pDuration * vPeriodInHours * 3600 - 3 * 3600;
			If ValueIsFilled(vDefaultCheckOutTime) Then
				vCheckOutDate = BegOfDay(vCheckOutDate) + (vDefaultCheckOutTime - BegOfDay(vDefaultCheckOutTime));
			EndIf;
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Then
			vCheckInTime = vCheckInDate - BegOfDay(vCheckInDate);
			If vCheckInTime <= 9*3600 Then // Breakfast check-in
				vCheckOutDate = BegOfDay(vCheckInDate) + pDuration * vPeriodInHours * 3600 + 7 * 3600;
			ElsIf vCheckInTime <= 14*3600 Then // Lunch check-in
				vCheckOutDate = BegOfDay(vCheckInDate) + pDuration * vPeriodInHours * 3600 + 12 * 3600;
			ElsIf vCheckInTime <= 20*3600 Then // Supper check-in
				vCheckOutDate = BegOfDay(vCheckInDate) + pDuration * vPeriodInHours * 3600 + 18 * 3600;
			Else  // Late check-in
				vCheckOutDate = BegOfDay(vCheckInDate) + pDuration * vPeriodInHours * 3600 + 21 * 3600;
			EndIf;
		Else
			vCheckOutDate = vCheckInDate + pDuration * vPeriodInHours * 3600;
		EndIf;
	Else
		vCheckOutDate = vCheckInDate + pDuration * vPeriodInHours * 3600;
	EndIf;
	Return cm0SecondShift(vCheckOutDate); 
EndFunction // cmCalculateCheckOutDate

// -----------------------------------------------------------------------------
// Description: Calculates and returns check-in date & time for the given check-out
//              date and duration
// Parameters: Room rate, Check-out date & time, Duration in days or hours
// Return value: Date, check-in date & time
// -----------------------------------------------------------------------------
Function cmCalculateCheckInDate(pRoomRate = Undefined, pCheckOutDate, pDuration) Export
	vCheckInDate = Undefined;
	vPeriodInHours = 24;
	If ValueIsFilled(pRoomRate) Then
		vPeriodInHours = ?(pRoomRate.PeriodInHours = 0, vPeriodInHours, pRoomRate.PeriodInHours);
		vReferenceHour = pRoomRate.ReferenceHour - BegOfDay(pRoomRate.ReferenceHour);
		If pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour Then
			vCheckInDate = BegOfDay(pCheckOutDate) + vReferenceHour - pDuration * vPeriodInHours * 3600;
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByDays Then
			vCheckInDate = BegOfDay(pCheckOutDate) - (pDuration - 1) * vPeriodInHours * 3600 + 8 * 3600;
		ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Then
			vCheckOutTime = pCheckOutDate - BegOfDay(pCheckOutDate);
			If vCheckOutTime <= 8 * 3600 Then // Before breakfast check-out
				vCheckInDate = BegOfDay(pCheckOutDate) - pDuration * vPeriodInHours * 3600 + 8 * 3600;
			ElsIf vCheckOutTime <= 13 * 3600 Then // Before lunch check-out
				vCheckInDate = BegOfDay(pCheckOutDate) - pDuration * vPeriodInHours * 3600 + 12 * 3600;
			ElsIf vCheckOutTime <= 19 * 3600 Then // Before supper check-out
				vCheckInDate = BegOfDay(pCheckOutDate) - pDuration * vPeriodInHours * 3600 + 18 * 3600;
			Else // Late check-out
				vCheckInDate = BegOfDay(pCheckOutDate) - pDuration * vPeriodInHours * 3600 + 21 * 3600;
			EndIf;
		Else
			vCheckInDate = pCheckOutDate - pDuration * vPeriodInHours * 3600;
		EndIf;
	Else
		vCheckInDate = pCheckOutDate - pDuration * vPeriodInHours * 3600;
	EndIf;
	Return cm1SecondShift(vCheckInDate);
EndFunction // cmCalculateCheckInDate

// -----------------------------------------------------------------------------
// Description: Initializes date & time based on giving room rate
// Parameters: Date to be initialized, Room rate
// Return value: Date
// -----------------------------------------------------------------------------
Function cmInitializeDateTime(pDateTime, pRoomRate) Export
	vDateTime = pDateTime;
	If ValueIsFilled(vDateTime) Then
		If ValueIsFilled(pRoomRate) Then
			vRRRH = pRoomRate.ReferenceHour;
			If pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour Then
				vDateTime = Date(Year(vDateTime), Month(vDateTime), Day(vDateTime), 
				                 Hour(vRRRH), Minute(vRRRH), 0);
			ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByDays Then
				vDateTime = Date(Year(vDateTime), Month(vDateTime), Day(vDateTime), 
				                 8, 0, 0);
			ElsIf pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Then
				vDateTime = Date(Year(vDateTime), Month(vDateTime), Day(vDateTime), 
				                 8, 0, 0);
			EndIf;
		EndIf;
	EndIf;
	Return cm0SecondShift(vDateTime);
EndFunction // cmInitializeDateTime

// -----------------------------------------------------------------------------
// Description: This function checks any room services and phone calls that could be charged
//              before guest was really registered in program. Program checks period from the 
//              guest check-in time to the current time. Nothing is done if current user do not
//              have permissions to change guest check-in time 
// Parameters: Accommodation document reference
// Return value: None
// -----------------------------------------------------------------------------
Procedure cmCheckMissedRoomServices(pAccommodation) Export
	If cmCheckUserPermissions("HavePermissionToEditAccommodationCheckInDate") Then
		// Skip checks if check-in delay is less then 3 minutes
		If (CurrentSessionDate() - pAccommodation.CheckInDate) > 180 And 
		   (BegOfDay(CurrentSessionDate()) = BegOfDay(pAccommodation.CheckInDate)) Then
			// Get room services and phone calls for the current room
			vQry = New Query();
			vQry.Text = 
			"SELECT
			|	RecordPhoneCall.Ref AS Document
			|FROM
			|	Document.RecordPhoneCall AS RecordPhoneCall
			|WHERE
			|	RecordPhoneCall.Posted
			|	AND RecordPhoneCall.Room = &qRoom
			|	AND RecordPhoneCall.PhoneCallDate >= &qPeriodFrom
			|	AND RecordPhoneCall.PhoneCallDate <= &qPeriodTo
			|
			|UNION ALL
			|
			|SELECT
			|	RecordRoomService.Ref
			|FROM
			|	Document.RecordRoomService AS RecordRoomService
			|WHERE
			|	RecordRoomService.Posted
			|	AND RecordRoomService.Room = &qRoom
			|	AND RecordRoomService.ServiceDate >= &qPeriodFrom
			|	AND RecordRoomService.ServiceDate <= &qPeriodTo";
			vQry.SetParameter("qRoom", pAccommodation.Room);
			vQry.SetParameter("qPeriodFrom", pAccommodation.CheckInDate);
			vQry.SetParameter("qPeriodTo", CurrentSessionDate());
			vDocs = vQry.Execute().Unload();
			For Each vDocsRow In vDocs Do
				vCurDocObj = vDocsRow.Document.GetObject();
				vNewFolio = vCurDocObj.pmGetFolioToChargeTo();
				If ValueIsFilled(vNewFolio) And vNewFolio <> vCurDocObj.Folio Then
					vCurDocObj.Folio = vNewFolio;
					vCurDocObj.pmFillByFolio();
					vCurDocObj.pmRecalculateSums();
					vCurDocObj.Write(DocumentWriteMode.Posting);
				EndIf;
			EndDo;
		EndIf;
	EndIf;
EndProcedure // cmCheckMissedRoomServices

// -----------------------------------------------------------------------------
//  Returnes value table with room type/accommodation type pairs
//  defined (valid) for the given room rate and client type.
//
// Parameters:
//  pHotel			 - CatalogRef.Hotels - 
//  pRoomRate		 - CatalogRef.RoomRates	 - 
//  pClientType		 - CatalogRef.ClientTypes	 - 
//  pRoomType		 - CatalogRef.RoomTypes		 - 
//  pRoomQuota		 - CatalogRef.RoomQuotas	 - Room quota (to calculate vacant rooms in quota)
//  pCheckInDate	 - Date						 - 
//  pCheckOutDate	 - Date						 - 
// 
// Returns:
//  ValueTable - Number of vacant rooms and total number of rooms for the room types
//
Function cmGetRoomTypesWithBalancesAndPrices(pHotel, pRoomRate, pClientType, pRoomType, pRoomQuota, pCheckInDate, pCheckOutDate, pPriceCalculationDate = Undefined) Export
	vPriceCalculationDate = pPriceCalculationDate;
	If pPriceCalculationDate = Undefined Then
		vPriceCalculationDate = CurrentSessionDate();
	EndIf;
	
	// First get active for check in date set room rate prices documents
	vOrders = cmGetActiveSetRoomRatePrices(pRoomRate, vPriceCalculationDate, pCheckInDate, pCheckOutDate, , pHotel);
	vSetRoomRatePrices = New ValueList();
	vSetRoomRatePrices.LoadValues(vOrders.UnloadColumn("SetRoomRatePrices"));
	
	// Retrieve set room rate prices documents rows
	vQry = New Query();
	If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
		vQry.Text = 
		"SELECT
		|	AccommodationTypeFormulas.Ref.RoomRate AS RoomRate,
		|	AccommodationTypeFormulas.Ref.Hotel AS Hotel,
		|	AccommodationTypeFormulas.Ref AS SetRoomRatePrices,
		|	AccommodationTypeFormulas.Ref.CalendarDayType AS CalendarDayType,
		|	AccommodationTypeFormulas.Ref.PriceTag AS PriceTag,
		|	AccommodationTypeFormulas.ClientType AS ClientType,
		|	AccommodationTypeFormulas.Service AS Service,
		|	AccommodationTypeFormulas.RoomClass AS RoomClass,
		|	AccommodationTypeFormulas.RoomType AS RoomType,
		|	AccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	AccommodationTypeFormulas.Multiplier AS Multiplier,
		|	AccommodationTypeFormulas.BracketsConstant AS BracketsConstant,
		|	AccommodationTypeFormulas.Constant AS Constant,
		|	AccommodationTypeFormulas.LineNumber AS LineNumber,
		|	AccommodationTypeFormulas.LineNumber AS SortCode
		|INTO RateAccommodationTypeFormulas
		|FROM
		|	Document.SetRoomRatePrices.Formulas AS AccommodationTypeFormulas
		|WHERE
		|	AccommodationTypeFormulas.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	FormulasForPriceTags.Ref.RoomRate AS RoomRate,
		|	FormulasForPriceTags.Ref.Hotel AS Hotel,
		|	FormulasForPriceTags.Ref AS SetRoomRatePrices,
		|	FormulasForPriceTags.CalendarDayType AS CalendarDayType,
		|	FormulasForPriceTags.PriceTag AS PriceTag,
		|	FormulasForPriceTags.ClientType AS ClientType,
		|	FormulasForPriceTags.Service AS Service,
		|	FormulasForPriceTags.RoomClass AS RoomClass,
		|	FormulasForPriceTags.RoomType AS RoomType,
		|	FormulasForPriceTags.AccommodationType AS AccommodationType,
		|	FormulasForPriceTags.Discount AS Discount,
		|	FormulasForPriceTags.Multiplier AS Multiplier,
		|	FormulasForPriceTags.BracketsConstant AS BracketsConstant,
		|	FormulasForPriceTags.Constant AS Constant,
		|	FormulasForPriceTags.LineNumber AS LineNumber,
		|	FormulasForPriceTags.LineNumber AS SortCode
		|INTO FormulasForPriceTags
		|FROM
		|	Document.SetRoomRatePrices.FormulasForDayTypesAndPricetags AS FormulasForPriceTags
		|WHERE
		|	FormulasForPriceTags.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Ref AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRule.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RateServices
		|FROM
		|	Catalog.Services AS RateServices
		|WHERE
		|	RateServices.Ref = &qAccommodationService
		|	AND NOT RateServices.IsFolder
		|	AND NOT RateServices.DeletionMark
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Service AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly,
		|	RoomTypePricesByDates.RoomType AS RoomType,
		|	RoomTypePricesByDates.AccountingDate AS AccountingDate,
		|	RoomTypePricesByDates.CalendarDayType AS CalendarDayType,
		|	RoomTypePricesByDates.PriceTag AS PriceTag,
		|	RoomTypePricesByDates.RoomPrice AS Price,
		|	RoomTypePricesByDates.RoomPriceCurrency AS Currency
		|INTO RoomTypePricesByDates
		|FROM
		|	(SELECT DISTINCT
		|		DaysByRoomTypes.RoomType AS RoomType,
		|		DaysByRoomTypes.AccountingDate AS AccountingDate,
		|		DaysByRoomTypes.CalendarDayType AS CalendarDayType,
		|		DaysByRoomTypes.PriceTag AS PriceTag,
		|		DaysByRoomTypes.RoomPrice AS RoomPrice,
		|		DaysByRoomTypes.RoomPriceCurrency AS RoomPriceCurrency
		|	FROM
		|		(SELECT
		|			RoomTypes.Ref AS RoomType,
		|			CalendarDays.AccountingDate AS AccountingDate,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType IS NULL
		|					THEN CalendarDays.CalendarDayType
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|					THEN CalendarDays.CalendarDayType
		|				ELSE CalendarDaysByRoomTypes.CalendarDayType
		|			END AS CalendarDayType,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.PriceTag IS NULL
		|					THEN CalendarDays.PriceTag
		|				WHEN CalendarDaysByRoomTypes.PriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|					THEN CalendarDays.PriceTag
		|				ELSE CalendarDaysByRoomTypes.PriceTag
		|			END AS PriceTag,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPrice IS NULL
		|					THEN CalendarDays.RoomPrice
		|				WHEN CalendarDaysByRoomTypes.RoomPrice = 0
		|					THEN CalendarDays.RoomPrice
		|				ELSE CalendarDaysByRoomTypes.RoomPrice
		|			END AS RoomPrice,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency IS NULL
		|					THEN CalendarDays.RoomPriceCurrency
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|					THEN CalendarDays.RoomPriceCurrency
		|				ELSE CalendarDaysByRoomTypes.RoomPriceCurrency
		|			END AS RoomPriceCurrency
		|		FROM
		|			InformationRegister.CalendarDays.SliceLast(
		|					&qPriceCalculationDate,
		|					AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|					AND Calendar = &qCalendar) AS CalendarDays
		|				LEFT JOIN Catalog.RoomTypes AS RoomTypes
		|				ON (RoomTypes.Owner = &qHotel)
		|					AND (RoomTypes.Ref IN HIERARCHY (&qRoomType))
		|					AND (NOT RoomTypes.IsFolder)
		|					AND (NOT RoomTypes.DeletionMark)
		|				LEFT JOIN InformationRegister.CalendarDaysByRoomTypes.SliceLast(
		|						&qPriceCalculationDate,
		|						AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|							AND Calendar = &qCalendar) AS CalendarDaysByRoomTypes
		|				ON CalendarDays.AccountingDate = CalendarDaysByRoomTypes.AccountingDate
		|					AND (RoomTypes.Ref = CalendarDaysByRoomTypes.RoomType)) AS DaysByRoomTypes) AS RoomTypePricesByDates
		|		LEFT JOIN RateServices AS RateServices
		|		ON (TRUE)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RawRoomRatePrices.AccountingDate AS AccountingDate,
		|	RateAccommodationTypeFormulas.RoomRate AS RoomRate,
		|	CASE
		|		WHEN RawRoomRatePrices.CalendarDayType <> VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|			THEN RawRoomRatePrices.CalendarDayType
		|		ELSE RateAccommodationTypeFormulas.CalendarDayType
		|	END AS CalendarDayType,
		|	CASE
		|		WHEN RawRoomRatePrices.PriceTag <> VALUE(Catalog.PriceTags.EmptyRef)
		|			THEN RawRoomRatePrices.PriceTag
		|		ELSE RateAccommodationTypeFormulas.PriceTag
		|	END AS PriceTag,
		|	RateAccommodationTypeFormulas.ClientType AS ClientType,
		|	RawRoomRatePrices.RoomType AS RoomType,
		|	RawRoomRatePrices.RoomType.RoomClass AS RoomClass,
		|	RateAccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	RateAccommodationTypeFormulas.SetRoomRatePrices AS SetRoomRatePrices,
		|	RateAccommodationTypeFormulas.SortCode AS SortCode,
		|	RateAccommodationTypeFormulas.LineNumber AS LineNumber,
		|	RateAccommodationTypeFormulas.Hotel AS Hotel,
		|	RawRoomRatePrices.Service AS Service,
		|	(RawRoomRatePrices.Price + ISNULL(RateAccommodationTypeFormulas.BracketsConstant, 0)) * ISNULL(RateAccommodationTypeFormulas.Multiplier, 0) + ISNULL(RateAccommodationTypeFormulas.Constant, 0) AS Price,
		|	RawRoomRatePrices.Currency AS Currency,
		|	0 AS MinimumQuantity,
		|	ISNULL(ServicePrices.VATRate, RateAccommodationTypeFormulas.Hotel.Company.VATRate) AS VATRate,
		|	RawRoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RawRoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RawRoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RawRoomRatePrices.IsInPrice AS IsInPrice,
		|	RawRoomRatePrices.ChargePerPerson AS IsPricePerPerson,
		|	RawRoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RawRoomRatePrices.Unit AS Unit,
		|	RawRoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RawRoomRatePrices
		|FROM
		|	RoomTypePricesByDates AS RawRoomRatePrices
		|		LEFT JOIN RateAccommodationTypeFormulas AS RateAccommodationTypeFormulas
		|		ON (RawRoomRatePrices.Service = RateAccommodationTypeFormulas.Service
		|				OR RateAccommodationTypeFormulas.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND (RawRoomRatePrices.RoomType = RateAccommodationTypeFormulas.RoomType
		|					AND RateAccommodationTypeFormulas.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RawRoomRatePrices.RoomType.RoomClass = RateAccommodationTypeFormulas.RoomClass
		|					AND RateAccommodationTypeFormulas.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR RateAccommodationTypeFormulas.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND RateAccommodationTypeFormulas.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
		|				&qPriceCalculationDate,
		|				Service = &qAccommodationService
		|					AND Hotel = &qHotel) AS ServicePrices
		|		ON RawRoomRatePrices.Service = ServicePrices.Service
		|			AND (RateAccommodationTypeFormulas.ClientType = ServicePrices.ClientType)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.AccountingDate AS AccountingDate,
		|	RoomRatePrices.RoomRate AS RoomRate,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.ClientType AS ClientType,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.SetRoomRatePrices AS SetRoomRatePrices,
		|	RoomRatePrices.SortCode AS SortCode,
		|	RoomRatePrices.LineNumber AS LineNumber,
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Service AS Service,
		|	CASE
		|		WHEN ISNULL(FormulasForPriceTags.Discount, 0) <> 0
		|			THEN RoomRatePrices.Price - RoomRatePrices.Price * ISNULL(FormulasForPriceTags.Discount, 0) / 100
		|		ELSE (RoomRatePrices.Price + ISNULL(FormulasForPriceTags.BracketsConstant, 0)) * ISNULL(FormulasForPriceTags.Multiplier, 1) + ISNULL(FormulasForPriceTags.Constant, 0)
		|	END AS Price,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRatePrices.MinimumQuantity AS MinimumQuantity,
		|	RoomRatePrices.VATRate AS VATRate,
		|	RoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RoomRatePrices.IsInPrice AS IsInPrice,
		|	RoomRatePrices.IsPricePerPerson AS IsPricePerPerson,
		|	RoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RoomRatePrices.Unit AS Unit,
		|	RoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RoomRatePrices
		|FROM
		|	RawRoomRatePrices AS RoomRatePrices
		|		LEFT JOIN FormulasForPriceTags AS FormulasForPriceTags
		|		ON (RoomRatePrices.Service = FormulasForPriceTags.Service
		|					AND FormulasForPriceTags.Service <> VALUE(Catalog.Services.EmptyRef)
		|				OR FormulasForPriceTags.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND RoomRatePrices.ClientType = FormulasForPriceTags.ClientType
		|			AND RoomRatePrices.PriceTag = FormulasForPriceTags.PriceTag
		|			AND RoomRatePrices.CalendarDayType = FormulasForPriceTags.CalendarDayType
		|			AND (RoomRatePrices.AccommodationType = FormulasForPriceTags.AccommodationType
		|					AND FormulasForPriceTags.AccommodationType <> VALUE(Catalog.AccommodationTypes.EmptyRef)
		|				OR FormulasForPriceTags.AccommodationType = VALUE(Catalog.AccommodationTypes.EmptyRef))
		|			AND (RoomRatePrices.RoomType = FormulasForPriceTags.RoomType
		|					AND FormulasForPriceTags.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RoomRatePrices.RoomType.RoomClass = FormulasForPriceTags.RoomClass
		|					AND FormulasForPriceTags.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR FormulasForPriceTags.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND FormulasForPriceTags.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Hotel.SortCode AS HotelSortCode,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalRooms, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsInQuota, 0)
		|		END) AS TotalRooms,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalBeds, 0)
		|			ELSE ISNULL(RoomQuotas.BedsInQuota, 0)
		|		END) AS TotalBeds,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.RoomsAvailable, 0) < ISNULL(RoomQuotas.RoomsRemains, 0)
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsRemains, 0)
		|		END) AS RoomsAvailable,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.BedsAvailable, 0) < ISNULL(RoomQuotas.BedsRemains, 0)
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.BedsRemains, 0)
		|		END) AS BedsAvailable,
		|	0 AS Quantity,
		|	MAX(RoomRatePrices.RoomType.NumberOfPersonsPerRoom) AS NumberOfPersonsPerRoom
		|FROM
		|	RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN (SELECT
		|			RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance, 0)) AS TotalRooms,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance, 0)) AS TotalBeds,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance, 0)) AS RoomsAvailable,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance, 0)) AS BedsAvailable
		|		FROM
		|			AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Second,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomInventoryBalanceAndTurnovers.RoomType) AS RoomInventory
		|		ON RoomRatePrices.RoomType = RoomInventory.RoomType
		|		LEFT JOIN (SELECT
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance, 0)) AS RoomsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance, 0)) AS BedsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance, 0)) AS RoomsRemains,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance, 0)) AS BedsRemains
		|		FROM
		|			AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Minute,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)
		|						AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType) AS RoomQuotas
		|		ON RoomRatePrices.RoomType = RoomQuotas.RoomType
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.SetRoomRatePrices IN(&qSetRoomRatePrices)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|
		|GROUP BY
		|	RoomRatePrices.Hotel,
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.Hotel.SortCode,
		|	RoomRateFormulas.BracketsConstant,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier
		|
		|ORDER BY
		|	HotelSortCode,
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayType,
		|	Currency";
		vQry.SetParameter("qAccommodationService", pRoomRate.AccommodationService);
		vQry.SetParameter("qCalendar", pRoomRate.Calendar);
		vQry.SetParameter("qCheckInDate", pCheckInDate);
		vQry.SetParameter("qDateFrom", BegOfDay(pCheckInDate));
		vQry.SetParameter("qDateTo", BegOfDay(pCheckOutDate));
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qRoomQuota", pRoomQuota);
		vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
		vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	Else
		vQry.Text = 
		"SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Hotel.SortCode AS HotelSortCode,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalRooms, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsInQuota, 0)
		|		END) AS TotalRooms,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalBeds, 0)
		|			ELSE ISNULL(RoomQuotas.BedsInQuota, 0)
		|		END) AS TotalBeds,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.RoomsAvailable, 0) < ISNULL(RoomQuotas.RoomsRemains, 0)
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsRemains, 0)
		|		END) AS RoomsAvailable,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.BedsAvailable, 0) < ISNULL(RoomQuotas.BedsRemains, 0)
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.BedsRemains, 0)
		|		END) AS BedsAvailable,
		|	0 AS Quantity,
		|	MAX(RoomRatePrices.RoomType.NumberOfPersonsPerRoom) AS NumberOfPersonsPerRoom
		|FROM
		|	InformationRegister.RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN (SELECT
		|			RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance, 0)) AS TotalRooms,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance, 0)) AS TotalBeds,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance, 0)) AS RoomsAvailable,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance, 0)) AS BedsAvailable
		|		FROM
		|			AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Second,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomInventoryBalanceAndTurnovers.RoomType) AS RoomInventory
		|		ON RoomRatePrices.RoomType = RoomInventory.RoomType
		|		LEFT JOIN (SELECT
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance, 0)) AS RoomsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance, 0)) AS BedsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance, 0)) AS RoomsRemains,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance, 0)) AS BedsRemains
		|		FROM
		|			AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Minute,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)
		|						AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType) AS RoomQuotas
		|		ON RoomRatePrices.RoomType = RoomQuotas.RoomType
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.RoomRate = &qPricesRoomRate
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.SetRoomRatePrices IN(&qSetRoomRatePrices)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|
		|GROUP BY
		|	RoomRatePrices.Hotel,
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.Hotel.SortCode,
		|	RoomRateFormulas.BracketsConstant,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier
		|
		|ORDER BY
		|	HotelSortCode,
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayType,
		|	Currency";
		vQry.SetParameter("qCheckInDate", pCheckInDate);
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qRoomQuota", pRoomQuota);
		vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
		vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	EndIf;
	vList = vQry.Execute().Unload();
	
	// Process room rate service packages
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.Calendar) Then
		vPackagesList = pRoomRate.GetObject().pmGetRoomRateServicePackagesList(, True);
		vCalendarDayTypes = pRoomRate.Calendar.GetObject().pmGetDays(pCheckInDate, pCheckOutDate, pCheckInDate, pCheckOutDate, pRoomType, vPriceCalculationDate);
		vCalendarDayTypes.Sort("Period");
		For Each vListRow In vList Do
			If ValueIsFilled(vListRow.AccommodationType) And ValueIsFilled(vListRow.RoomType) Then
				vPrice = 0;
				vNumDays = 0;
				vCurrency = Undefined;
				vDate = BegOfDay(pCheckInDate);
				vEndDate = BegOfDay(pCheckOutDate);
				If pRoomRate.DurationCalculationRuleType <> Enums.DurationCalculationRuleTypes.ByDays Then
					vEndDate = vEndDate - 24*3600;
				EndIf;
				vPriceTagsList = New ValueList();
				vPriceTags = cmGetEffectivePriceTags(pHotel, pRoomRate, vListRow.RoomType, pCheckInDate, pCheckOutDate, vPriceTagsList, , vPriceCalculationDate);
				While vDate <= vEndDate Do
					vNumDays = vNumDays + 1;
					If vNumDays > 1 And ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vCalendarDayTypeRow = vCalendarDayTypes.Find(vDate, "Period");
					If vCalendarDayTypeRow <> Undefined Or ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vCalendarDayType = vCalendarDayTypeRow.CalendarDayType;
						vPriceTagRows = vPriceTags.FindRows(New Structure("Period, RoomType", vDate, vListRow.RoomType));
						If vPriceTagRows.Count() = 0 Then
							vPriceTagRow = vPriceTags.Find(vDate, "Period");
						Else
							vPriceTagRow = vPriceTagRows.Get(0);
						EndIf;
						If vPriceTagRow <> Undefined Then
							vPriceTag = vPriceTagRow.PriceTag;
							If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vPriceTag));
							Else
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, CalendarDayType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vCalendarDayType, vPriceTag));
							EndIf;
							If vRows.Count() = 1 Then
								vRow = vRows.Get(0);
								If vCurrency = Undefined Then
									vCurrency = vRow.Currency;
								EndIf;
								If vCurrency <> vRow.Currency Then
									vDate = vDate + 24*3600;
									Continue;
								EndIf;
								// Add prices from room rate service packages
								For Each vPackagesListItem In vPackagesList Do
									vServicePackage = vPackagesListItem.Value;
									If ValueIsFilled(vServicePackage) Then
										If vServicePackage.DateValidFrom <= BegOfDay(pCheckInDate) And 
											(vServicePackage.DateValidTo >= BegOfDay(pCheckInDate) Or Not ValueIsFilled(vServicePackage.DateValidTo)) Then
											vServices = Catalogs.ServicePackages.GetServices(vServicePackage, vDate, vPriceCalculationDate);
											For Each vServicesRow In vServices Do
												If vServicesRow.IsInPrice Then
													If vRow.Currency = vServicesRow.Currency And 
														(pClientType = vServicesRow.ClientType Or ValueIsFilled(pClientType) And Not ValueIsFilled(vServicesRow.ClientType)) And
														(vRow.AccommodationType = vServicesRow.AccommodationType Or Not ValueIsFilled(vServicesRow.AccommodationType)) Then
														vRow.Price = vRow.Price + vServicesRow.Quantity * vServicesRow.Price;
													EndIf;
												EndIf;
											EndDo;
										EndIf;
									EndIf;
								EndDo;
								vPrice = vPrice + vRow.Price;
							Else
								vDate = vDate + 24*3600;
								Continue;
							EndIf;
						Else
							vDate = vDate + 24*3600;
							Continue;
						EndIf;
					Else
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vDate = vDate + 24*3600;
				EndDo;
				vListRow.Price = vPrice;
			EndIf;
		EndDo;
	EndIf;
	
	// Add discounts from room rate discount type
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.DiscountType) Then
		vDiscountTypeObj = pRoomRate.DiscountType.GetObject();
		vDiscount = vDiscountTypeObj.pmGetDiscount(cm1SecondShift(pCheckInDate), , pHotel);
		For Each vListRow In vList Do
			vListRow.Price = vListRow.Price - Round(vListRow.Price * vDiscount / 100, 2);
		EndDo;
	EndIf;
	
	// Return value table with room types and prices
	Return vList;
EndFunction // cmGetRoomTypesWithBalancesAndPrices

// -----------------------------------------------------------------------------
// Description: Returnes value table with room types and with number of vacant rooms 
//              and total number of rooms for each room type
// Parameters: Hotel, Room type (as filter), Room quota 
//             (to calculate vacant rooms in quota), period from date, period to date
// Return value: Value table
// -----------------------------------------------------------------------------
Function cmGetRoomTypesWithBalances(pHotel, pRoomType, pRoomQuota, pCheckInDate, pCheckOutDate) Export
	// Log function call
	WriteLogEvent(NStr("en='Get room types with balances';ru='Получить остатки свободных номеров по категориям';de='Restbestände an freien Zimmern nach Kategorien erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotel + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomType + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты: ';de='Quotencode: '") + pRoomQuota + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pCheckInDate + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pCheckOutDate);
	// Run query
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Reservations.RoomType AS RoomType,
	|	MAX(Reservations.Date) AS LastReservationDate
	|INTO TabReservations
	|FROM
	|	Document.Reservation AS Reservations
	|WHERE
	|	Reservations.Hotel = &qHotel
	|	AND Reservations.RoomType IN HIERARCHY(&qRoomType)
	|	AND Reservations.ReservationStatus.IsActive
	|	AND Reservations.Posted
	|
	|GROUP BY
	|	Reservations.RoomType
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance) AS RoomsInQuota,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance) AS BedsInQuota,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) AS RoomsRemains,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance) AS BedsRemains
	|INTO RoomQuotas
	|FROM
	|	AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
	|			&qCheckInDate,
	|			&qCheckOutDate,
	|			Minute,
	|			RegisterRecordsAndPeriodBoundaries,
	|			Hotel = &qHotel
	|				AND RoomType IN HIERARCHY (&qRoomType)
	|				AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
	|
	|GROUP BY
	|	RoomQuotaSalesBalanceAndTurnovers.RoomType
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RoomInventoryBalanceAndTurnovers.Hotel AS Hotel,
	|	RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
	|	MIN(RoomInventoryBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|	MIN(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance) AS TotalRooms,
	|	MIN(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance) AS TotalBeds,
	|	MIN(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance) AS RoomsAvailable,
	|	MIN(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance) AS BedsAvailable,
	|	MIN(ISNULL(RoomQuotas.RoomsInQuota, 0)) AS RoomsInQuota,
	|	MIN(ISNULL(RoomQuotas.BedsInQuota, 0)) AS BedsInQuota,
	|	MIN(ISNULL(RoomQuotas.RoomsRemains, 0)) AS RoomsRemains,
	|	MIN(ISNULL(RoomQuotas.BedsRemains, 0)) AS BedsRemains
	|INTO RoomInventoryBalanceAndTurnovers
	|FROM
	|	AccumulationRegister.RoomInventory.BalanceAndTurnovers(
	|			&qCheckInDate,
	|			&qCheckOutDate,
	|			Second,
	|			RegisterRecordsAndPeriodBoundaries,
	|			Hotel = &qHotel
	|				AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
	|		LEFT JOIN RoomQuotas AS RoomQuotas
	|		ON RoomInventoryBalanceAndTurnovers.RoomType = RoomQuotas.RoomType
	|
	|GROUP BY
	|	RoomInventoryBalanceAndTurnovers.Hotel,
	|	RoomInventoryBalanceAndTurnovers.RoomType
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RoomTypeBalances.Hotel AS Hotel,
	|	RoomTypeBalances.Hotel.SortCode AS HotelSortCode,
	|	RoomTypeBalances.RoomType AS RoomType,
	|	RoomTypeBalances.RoomType.SortCode AS RoomTypeSortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate) AS LastReservationDate,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalRooms, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsInQuota, 0)
	|		END) AS TotalRooms,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalBeds, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsInQuota, 0)
	|		END) AS TotalBeds,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) AS RoomsAvailable,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.BedsAvailable, 0) < ISNULL(RoomTypeBalances.BedsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsRemains, 0)
	|		END) AS BedsAvailable,
	|	MAX(RoomTypeBalances.RoomType.NumberOfPersonsPerRoom) AS NumberOfPersonsPerRoom
	|FROM
	|	RoomInventoryBalanceAndTurnovers AS RoomTypeBalances
	|		LEFT JOIN TabReservations AS ActiveReservations
	|		ON RoomTypeBalances.RoomType = ActiveReservations.RoomType
	|
	|GROUP BY
	|	RoomTypeBalances.Hotel,
	|	RoomTypeBalances.Hotel.SortCode,
	|	RoomTypeBalances.RoomType,
	|	RoomTypeBalances.RoomType.SortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate)
	|
	|HAVING
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) > 0
	|
	|ORDER BY
	|	HotelSortCode,
	|	RoomTypeSortCode";
	vQry.SetParameter("qCheckInDate", pCheckInDate);
	vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomType", pRoomType);
	vQry.SetParameter("qRoomQuota", pRoomQuota);
	vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
	vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
	vList = vQry.Execute().Unload();
	// Return value table with room types and prices
	Return vList;
EndFunction // cmGetRoomTypesWithBalances

// -----------------------------------------------------------------------------
// Description: Returnes value table with room types and rooms
// Parameters: Hotel, Room type (as filter), Room quota 
//             (to calculate vacant rooms in quota), period from date, period to date
// Return value: Value table
// -----------------------------------------------------------------------------
Function cmGetRoomsWithBalances(pHotel, pRoomType, pRoomQuota, pCheckInDate, pCheckOutDate) Export
	// Log function call
	WriteLogEvent(NStr("en='Get rooms with balances';ru='Получить остатки свободных номеров';de='Restbestände an freien Zimmern'"), EventLogLevel.Information, , , 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotel + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomType + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты: ';de='Quotencode: '") + pRoomQuota + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pCheckInDate + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pCheckOutDate);
	// Run query
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	RoomTypeBalances.Hotel AS Hotel,
	|	RoomTypeBalances.Hotel.SortCode AS HotelSortCode,
	|	RoomTypeBalances.RoomType AS RoomType,
	|	RoomTypeBalances.RoomType.SortCode AS RoomTypeSortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate) AS LastReservationDate,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalRooms, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsInQuota, 0)
	|		END) AS TotalRooms,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalBeds, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsInQuota, 0)
	|		END) AS TotalBeds,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) AS RoomsAvailable,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.BedsAvailable, 0) < ISNULL(RoomTypeBalances.BedsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsRemains, 0)
	|		END) AS BedsAvailable,
	|	MAX(RoomTypeBalances.RoomType.NumberOfPersonsPerRoom) AS NumberOfPersonsPerRoom,
	|	RoomTypeBalances.Room
	|FROM
	|	(SELECT
	|		RoomInventoryBalanceAndTurnovers.Hotel AS Hotel,
	|		RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
	|		MIN(RoomInventoryBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|		MIN(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance) AS TotalRooms,
	|		MIN(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance) AS TotalBeds,
	|		MIN(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance) AS RoomsAvailable,
	|		MIN(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance) AS BedsAvailable,
	|		MIN(ISNULL(RoomQuotas.RoomsInQuota, 0)) AS RoomsInQuota,
	|		MIN(ISNULL(RoomQuotas.BedsInQuota, 0)) AS BedsInQuota,
	|		MIN(ISNULL(RoomQuotas.RoomsRemains, 0)) AS RoomsRemains,
	|		MIN(ISNULL(RoomQuotas.BedsRemains, 0)) AS BedsRemains,
	|		RoomInventoryBalanceAndTurnovers.Room AS Room
	|	FROM
	|		AccumulationRegister.RoomInventory.BalanceAndTurnovers(
	|				&qCheckInDate,
	|				&qCheckOutDate,
	|				Second,
	|				RegisterRecordsAndPeriodBoundaries,
	|				Hotel = &qHotel
	|					AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
	|			LEFT JOIN (SELECT
	|				RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance) AS RoomsInQuota,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance) AS BedsInQuota,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) AS RoomsRemains,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance) AS BedsRemains,
	|				RoomQuotaSalesBalanceAndTurnovers.Room AS Room
	|			FROM
	|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
	|						&qCheckInDate,
	|						&qCheckOutDate,
	|						Minute,
	|						RegisterRecordsAndPeriodBoundaries,
	|						Hotel = &qHotel
	|							AND RoomType IN HIERARCHY (&qRoomType)
	|							AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
	|			
	|			GROUP BY
	|				RoomQuotaSalesBalanceAndTurnovers.RoomType,
	|				RoomQuotaSalesBalanceAndTurnovers.Room) AS RoomQuotas
	|			ON RoomInventoryBalanceAndTurnovers.Room = RoomQuotas.Room
	|	WHERE
	|		NOT RoomInventoryBalanceAndTurnovers.Room = &qEmptyRoom
	|	
	|	GROUP BY
	|		RoomInventoryBalanceAndTurnovers.Hotel,
	|		RoomInventoryBalanceAndTurnovers.RoomType,
	|		RoomInventoryBalanceAndTurnovers.Room) AS RoomTypeBalances
	|		LEFT JOIN (SELECT
	|			Reservations.RoomType AS RoomType,
	|			MAX(Reservations.Date) AS LastReservationDate
	|		FROM
	|			Document.Reservation AS Reservations
	|		WHERE
	|			Reservations.Hotel = &qHotel
	|			AND Reservations.RoomType IN HIERARCHY(&qRoomType)
	|			AND Reservations.ReservationStatus.IsActive
	|			AND Reservations.Posted
	|		
	|		GROUP BY
	|			Reservations.RoomType) AS ActiveReservations
	|		ON (ActiveReservations.RoomType = RoomTypeBalances.RoomType)
	|
	|GROUP BY
	|	RoomTypeBalances.Hotel,
	|	RoomTypeBalances.Hotel.SortCode,
	|	RoomTypeBalances.RoomType,
	|	RoomTypeBalances.RoomType.SortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate),
	|	RoomTypeBalances.Room
	|
	|HAVING
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) > 0
	|
	|ORDER BY
	|	HotelSortCode,
	|	RoomTypeSortCode";
	vQry.SetParameter("qCheckInDate", pCheckInDate);
	vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qEmptyRoom", Catalogs.Rooms.EmptyRef());
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomType", pRoomType);
	vQry.SetParameter("qRoomQuota", pRoomQuota);
	vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
	vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
	vList = vQry.Execute().Unload();
	// Return value table with room types and prices
	Return vList;
EndFunction // cmGetRoomsWithBalances

// -----------------------------------------------------------------------------
// Description: Returnes value table with room type/accommodation type pairs
//              defined (valid) for the given room rate and client type. 
// Parameters: Hotel, Room rate, Client type, Room type (as filter), Room quota 
//             (to calculate vacant rooms in quota), period from date, period to date
// Return value: Value table
// -----------------------------------------------------------------------------
Function cmGetRoomTypesWithPricesByRoom(pHotel, pRoomRate, pClientType, pRoomType, pCheckInDate, pCheckOutDate, pAccommodationType = Undefined, pPriceCalculationDate = Undefined) Export
	vPriceCalculationDate = pPriceCalculationDate;
	If pPriceCalculationDate = Undefined Then
		vPriceCalculationDate = CurrentSessionDate();
	EndIf;
	
	// First get active for check in date set room rate prices documents
	vOrders = cmGetActiveSetRoomRatePrices(pRoomRate, vPriceCalculationDate, pCheckInDate, pCheckOutDate, , pHotel);
	vSetRoomRatePrices = New ValueList();
	vSetRoomRatePrices.LoadValues(vOrders.UnloadColumn("SetRoomRatePrices"));
	
	If pAccommodationType = Undefined Or Not ValueIsFilled(pAccommodationType) Then
		vAccommodationType = cmGetAccommodationTypeRoom(pHotel);
	Else
		vAccommodationType = pAccommodationType;
	EndIf;
	
	// Retrieve set room rate prices documents rows
	vQry = New Query();
	If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
		vQry.Text = 
		"SELECT
		|	AccommodationTypeFormulas.Ref.RoomRate AS RoomRate,
		|	AccommodationTypeFormulas.Ref.Hotel AS Hotel,
		|	AccommodationTypeFormulas.Ref AS SetRoomRatePrices,
		|	AccommodationTypeFormulas.Ref.CalendarDayType AS CalendarDayType,
		|	AccommodationTypeFormulas.Ref.PriceTag AS PriceTag,
		|	AccommodationTypeFormulas.ClientType AS ClientType,
		|	AccommodationTypeFormulas.Service AS Service,
		|	AccommodationTypeFormulas.RoomClass AS RoomClass,
		|	AccommodationTypeFormulas.RoomType AS RoomType,
		|	AccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	AccommodationTypeFormulas.Multiplier AS Multiplier,
		|	AccommodationTypeFormulas.BracketsConstant AS BracketsConstant,
		|	AccommodationTypeFormulas.Constant AS Constant,
		|	AccommodationTypeFormulas.LineNumber AS LineNumber,
		|	AccommodationTypeFormulas.LineNumber AS SortCode
		|INTO RateAccommodationTypeFormulas
		|FROM
		|	Document.SetRoomRatePrices.Formulas AS AccommodationTypeFormulas
		|WHERE
		|	AccommodationTypeFormulas.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	FormulasForPriceTags.Ref.RoomRate AS RoomRate,
		|	FormulasForPriceTags.Ref.Hotel AS Hotel,
		|	FormulasForPriceTags.Ref AS SetRoomRatePrices,
		|	FormulasForPriceTags.CalendarDayType AS CalendarDayType,
		|	FormulasForPriceTags.PriceTag AS PriceTag,
		|	FormulasForPriceTags.ClientType AS ClientType,
		|	FormulasForPriceTags.Service AS Service,
		|	FormulasForPriceTags.RoomClass AS RoomClass,
		|	FormulasForPriceTags.RoomType AS RoomType,
		|	FormulasForPriceTags.AccommodationType AS AccommodationType,
		|	FormulasForPriceTags.Discount AS Discount,
		|	FormulasForPriceTags.Multiplier AS Multiplier,
		|	FormulasForPriceTags.BracketsConstant AS BracketsConstant,
		|	FormulasForPriceTags.Constant AS Constant,
		|	FormulasForPriceTags.LineNumber AS LineNumber,
		|	FormulasForPriceTags.LineNumber AS SortCode
		|INTO FormulasForPriceTags
		|FROM
		|	Document.SetRoomRatePrices.FormulasForDayTypesAndPricetags AS FormulasForPriceTags
		|WHERE
		|	FormulasForPriceTags.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Ref AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRule.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RateServices
		|FROM
		|	Catalog.Services AS RateServices
		|WHERE
		|	RateServices.Ref = &qAccommodationService
		|	AND NOT RateServices.IsFolder
		|	AND NOT RateServices.DeletionMark
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Service AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly,
		|	RoomTypePricesByDates.RoomType AS RoomType,
		|	RoomTypePricesByDates.AccountingDate AS AccountingDate,
		|	RoomTypePricesByDates.CalendarDayType AS CalendarDayType,
		|	RoomTypePricesByDates.PriceTag AS PriceTag,
		|	RoomTypePricesByDates.RoomPrice AS Price,
		|	RoomTypePricesByDates.RoomPriceCurrency AS Currency
		|INTO RoomTypePricesByDates
		|FROM
		|	(SELECT DISTINCT
		|		DaysByRoomTypes.RoomType AS RoomType,
		|		DaysByRoomTypes.AccountingDate AS AccountingDate,
		|		DaysByRoomTypes.CalendarDayType AS CalendarDayType,
		|		DaysByRoomTypes.PriceTag AS PriceTag,
		|		DaysByRoomTypes.RoomPrice AS RoomPrice,
		|		DaysByRoomTypes.RoomPriceCurrency AS RoomPriceCurrency
		|	FROM
		|		(SELECT
		|			RoomTypes.Ref AS RoomType,
		|			CalendarDays.AccountingDate AS AccountingDate,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType IS NULL
		|					THEN CalendarDays.CalendarDayType
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|					THEN CalendarDays.CalendarDayType
		|				ELSE CalendarDaysByRoomTypes.CalendarDayType
		|			END AS CalendarDayType,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.PriceTag IS NULL
		|					THEN CalendarDays.PriceTag
		|				WHEN CalendarDaysByRoomTypes.PriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|					THEN CalendarDays.PriceTag
		|				ELSE CalendarDaysByRoomTypes.PriceTag
		|			END AS PriceTag,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPrice IS NULL
		|					THEN CalendarDays.RoomPrice
		|				WHEN CalendarDaysByRoomTypes.RoomPrice = 0
		|					THEN CalendarDays.RoomPrice
		|				ELSE CalendarDaysByRoomTypes.RoomPrice
		|			END AS RoomPrice,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency IS NULL
		|					THEN CalendarDays.RoomPriceCurrency
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|					THEN CalendarDays.RoomPriceCurrency
		|				ELSE CalendarDaysByRoomTypes.RoomPriceCurrency
		|			END AS RoomPriceCurrency
		|		FROM
		|			InformationRegister.CalendarDays.SliceLast(
		|					&qPriceCalculationDate,
		|					AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|						AND Calendar = &qCalendar) AS CalendarDays
		|				LEFT JOIN Catalog.RoomTypes AS RoomTypes
		|				ON (RoomTypes.Owner = &qHotel)
		|					AND (RoomTypes.Ref IN HIERARCHY (&qRoomType))
		|					AND (NOT RoomTypes.IsFolder)
		|					AND (NOT RoomTypes.DeletionMark)
		|				LEFT JOIN InformationRegister.CalendarDaysByRoomTypes.SliceLast(
		|						&qPriceCalculationDate,
		|						AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|							AND Calendar = &qCalendar) AS CalendarDaysByRoomTypes
		|				ON CalendarDays.AccountingDate = CalendarDaysByRoomTypes.AccountingDate
		|					AND (RoomTypes.Ref = CalendarDaysByRoomTypes.RoomType)) AS DaysByRoomTypes) AS RoomTypePricesByDates
		|		LEFT JOIN RateServices AS RateServices
		|		ON (TRUE)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RawRoomRatePrices.AccountingDate AS AccountingDate,
		|	RateAccommodationTypeFormulas.RoomRate AS RoomRate,
		|	CASE
		|		WHEN RawRoomRatePrices.CalendarDayType <> VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|			THEN RawRoomRatePrices.CalendarDayType
		|		ELSE RateAccommodationTypeFormulas.CalendarDayType
		|	END AS CalendarDayType,
		|	CASE
		|		WHEN RawRoomRatePrices.PriceTag <> VALUE(Catalog.PriceTags.EmptyRef)
		|			THEN RawRoomRatePrices.PriceTag
		|		ELSE RateAccommodationTypeFormulas.PriceTag
		|	END AS PriceTag,
		|	RateAccommodationTypeFormulas.ClientType AS ClientType,
		|	RawRoomRatePrices.RoomType AS RoomType,
		|	RawRoomRatePrices.RoomType.RoomClass AS RoomClass,
		|	RateAccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	RateAccommodationTypeFormulas.SetRoomRatePrices AS SetRoomRatePrices,
		|	RateAccommodationTypeFormulas.SortCode AS SortCode,
		|	RateAccommodationTypeFormulas.LineNumber AS LineNumber,
		|	RateAccommodationTypeFormulas.Hotel AS Hotel,
		|	RawRoomRatePrices.Service AS Service,
		|	(RawRoomRatePrices.Price + ISNULL(RateAccommodationTypeFormulas.BracketsConstant, 0)) * ISNULL(RateAccommodationTypeFormulas.Multiplier, 0) + ISNULL(RateAccommodationTypeFormulas.Constant, 0) AS Price,
		|	RawRoomRatePrices.Currency AS Currency,
		|	0 AS MinimumQuantity,
		|	ISNULL(ServicePrices.VATRate, RateAccommodationTypeFormulas.Hotel.Company.VATRate) AS VATRate,
		|	RawRoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RawRoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RawRoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RawRoomRatePrices.IsInPrice AS IsInPrice,
		|	RawRoomRatePrices.ChargePerPerson AS IsPricePerPerson,
		|	RawRoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RawRoomRatePrices.Unit AS Unit,
		|	RawRoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RawRoomRatePrices
		|FROM
		|	RoomTypePricesByDates AS RawRoomRatePrices
		|		LEFT JOIN RateAccommodationTypeFormulas AS RateAccommodationTypeFormulas
		|		ON (RawRoomRatePrices.Service = RateAccommodationTypeFormulas.Service
		|				OR RateAccommodationTypeFormulas.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND (RawRoomRatePrices.RoomType = RateAccommodationTypeFormulas.RoomType
		|					AND RateAccommodationTypeFormulas.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RawRoomRatePrices.RoomType.RoomClass = RateAccommodationTypeFormulas.RoomClass
		|					AND RateAccommodationTypeFormulas.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR RateAccommodationTypeFormulas.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND RateAccommodationTypeFormulas.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
		|				&qPriceCalculationDate,
		|				Service = &qAccommodationService
		|					AND Hotel = &qHotel) AS ServicePrices
		|		ON RawRoomRatePrices.Service = ServicePrices.Service
		|			AND (RateAccommodationTypeFormulas.ClientType = ServicePrices.ClientType)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.AccountingDate AS AccountingDate,
		|	RoomRatePrices.RoomRate AS RoomRate,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.ClientType AS ClientType,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.SetRoomRatePrices AS SetRoomRatePrices,
		|	RoomRatePrices.SortCode AS SortCode,
		|	RoomRatePrices.LineNumber AS LineNumber,
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Service AS Service,
		|	CASE
		|		WHEN ISNULL(FormulasForPriceTags.Discount, 0) <> 0
		|			THEN RoomRatePrices.Price - RoomRatePrices.Price * ISNULL(FormulasForPriceTags.Discount, 0) / 100
		|		ELSE (RoomRatePrices.Price + ISNULL(FormulasForPriceTags.BracketsConstant, 0)) * ISNULL(FormulasForPriceTags.Multiplier, 1) + ISNULL(FormulasForPriceTags.Constant, 0)
		|	END AS Price,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRatePrices.MinimumQuantity AS MinimumQuantity,
		|	RoomRatePrices.VATRate AS VATRate,
		|	RoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RoomRatePrices.IsInPrice AS IsInPrice,
		|	RoomRatePrices.IsPricePerPerson AS IsPricePerPerson,
		|	RoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RoomRatePrices.Unit AS Unit,
		|	RoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RoomRatePrices
		|FROM
		|	RawRoomRatePrices AS RoomRatePrices
		|		LEFT JOIN FormulasForPriceTags AS FormulasForPriceTags
		|		ON (RoomRatePrices.Service = FormulasForPriceTags.Service
		|					AND FormulasForPriceTags.Service <> VALUE(Catalog.Services.EmptyRef)
		|				OR FormulasForPriceTags.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND RoomRatePrices.ClientType = FormulasForPriceTags.ClientType
		|			AND RoomRatePrices.PriceTag = FormulasForPriceTags.PriceTag
		|			AND RoomRatePrices.CalendarDayType = FormulasForPriceTags.CalendarDayType
		|			AND (RoomRatePrices.AccommodationType = FormulasForPriceTags.AccommodationType
		|					AND FormulasForPriceTags.AccommodationType <> VALUE(Catalog.AccommodationTypes.EmptyRef)
		|				OR FormulasForPriceTags.AccommodationType = VALUE(Catalog.AccommodationTypes.EmptyRef))
		|			AND (RoomRatePrices.RoomType = FormulasForPriceTags.RoomType
		|					AND FormulasForPriceTags.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RoomRatePrices.RoomType.RoomClass = FormulasForPriceTags.RoomClass
		|					AND FormulasForPriceTags.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR FormulasForPriceTags.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND FormulasForPriceTags.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Hotel.SortCode AS HotelSortCode,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price
		|FROM
		|	RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.RoomRate = &qPricesRoomRate
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|	AND RoomRatePrices.AccommodationType IN HIERARCHY(&qAccType)
		|
		|GROUP BY
		|	RoomRatePrices.Hotel,
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.Hotel.SortCode,
		|	RoomRateFormulas.BracketsConstant,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier
		|
		|ORDER BY
		|	HotelSortCode,
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayType,
		|	Currency";
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qDateFrom", BegOfDay(pCheckInDate));
		vQry.SetParameter("qDateTo", BegOfDay(pCheckOutDate));
		vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qCalendar", pRoomRate.Calendar);
		vQry.SetParameter("qAccommodationService", pRoomRate.AccommodationService);
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qAccType", vAccommodationType);
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	Else
		vQry.Text = 
		"SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Hotel.SortCode AS HotelSortCode,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price
		|FROM
		|	InformationRegister.RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.RoomRate = &qPricesRoomRate
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.SetRoomRatePrices IN(&qSetRoomRatePrices)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|	AND RoomRatePrices.AccommodationType IN HIERARCHY(&qAccType)
		|
		|GROUP BY
		|	RoomRatePrices.Hotel,
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.Hotel.SortCode,
		|	RoomRateFormulas.BracketsConstant,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier
		|
		|ORDER BY
		|	HotelSortCode,
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayType,
		|	Currency";
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qAccType", vAccommodationType);
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	EndIf;
	vList = vQry.Execute().Unload();
	
	// Process room rate service packages
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.Calendar) Then
		vPackagesList = pRoomRate.GetObject().pmGetRoomRateServicePackagesList(, True);
		vCalendarDayTypes = pRoomRate.Calendar.GetObject().pmGetDays(pCheckInDate, pCheckOutDate, pCheckInDate, pCheckOutDate, pRoomType, vPriceCalculationDate);
		vCalendarDayTypes.Sort("Period");
		For Each vListRow In vList Do
			If ValueIsFilled(vListRow.AccommodationType) And ValueIsFilled(vListRow.RoomType) Then
				vPrice = 0;
				vNumDays = 0;
				vCurrency = Undefined;
				vDate = BegOfDay(pCheckInDate);
				vEndDate = BegOfDay(pCheckOutDate);
				If pRoomRate.DurationCalculationRuleType <> Enums.DurationCalculationRuleTypes.ByDays Then
					vEndDate = vEndDate - 24*3600;
				EndIf;
				vPriceTagsList = New ValueList();
				vPriceTags = cmGetEffectivePriceTags(pHotel, pRoomRate, vListRow.RoomType, pCheckInDate, pCheckOutDate, vPriceTagsList, , vPriceCalculationDate);
				While vDate <= vEndDate Do
					vNumDays = vNumDays + 1;
					If vNumDays > 1 And ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vCalendarDayTypeRow = vCalendarDayTypes.Find(vDate, "Period");
					If vCalendarDayTypeRow <> Undefined Or ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vCalendarDayType = vCalendarDayTypeRow.CalendarDayType;
						vPriceTagRows = vPriceTags.FindRows(New Structure("Period, RoomType", vDate, vListRow.RoomType));
						If vPriceTagRows.Count() = 0 Then
							vPriceTagRow = vPriceTags.Find(vDate, "Period");
						Else
							vPriceTagRow = vPriceTagRows.Get(0);
						EndIf;
						If vPriceTagRow <> Undefined Then
							vPriceTag = vPriceTagRow.PriceTag;
							If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vPriceTag));
							Else
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, CalendarDayType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vCalendarDayType, vPriceTag));
							EndIf;
							If vRows.Count() = 1 Then
								vRow = vRows.Get(0);
								If vCurrency = Undefined Then
									vCurrency = vRow.Currency;
								EndIf;
								If vCurrency <> vRow.Currency Then
									vDate = vDate + 24*3600;
									Continue;
								EndIf;
								// Add prices from room rate service packages
								For Each vPackagesListItem In vPackagesList Do
									vServicePackage = vPackagesListItem.Value;
									If ValueIsFilled(vServicePackage) Then
										If vServicePackage.DateValidFrom <= BegOfDay(pCheckInDate) And 
											(vServicePackage.DateValidTo >= BegOfDay(pCheckInDate) Or Not ValueIsFilled(vServicePackage.DateValidTo)) Then
											vServices = Catalogs.ServicePackages.GetServices(vServicePackage, vDate, vPriceCalculationDate);
											For Each vServicesRow In vServices Do
												If vServicesRow.IsInPrice Then
													If vRow.Currency = vServicesRow.Currency And 
														(pClientType = vServicesRow.ClientType Or ValueIsFilled(pClientType) And Not ValueIsFilled(vServicesRow.ClientType)) And
														(vRow.AccommodationType = vServicesRow.AccommodationType Or Not ValueIsFilled(vServicesRow.AccommodationType)) Then
														vRow.Price = vRow.Price + vServicesRow.Quantity * vServicesRow.Price;
													EndIf;
												EndIf;
											EndDo;
										EndIf;
									EndIf;
								EndDo;
								vPrice = vPrice + vRow.Price;
							Else
								vDate = vDate + 24*3600;
								Continue;
							EndIf;
						Else
							vDate = vDate + 24*3600;
							Continue;
						EndIf;
					Else
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vDate = vDate + 24*3600;
				EndDo;
				vListRow.Price = vPrice;
			EndIf;
		EndDo;
	EndIf;
	
	// Add discounts from room rate discount type
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.DiscountType) Then
		vDiscountTypeObj = pRoomRate.DiscountType.GetObject();
		vDiscount = vDiscountTypeObj.pmGetDiscount(cm1SecondShift(pCheckInDate), , pHotel);
		For Each vListRow In vList Do
			vListRow.Price = vListRow.Price - Round(vListRow.Price*vDiscount/100, 2);
		EndDo;
	EndIf;
	
	// Return value table with room types and prices
	Return vList;
EndFunction // cmGetRoomTypesWithPricesByRoom

// -----------------------------------------------------------------------------
// Description: Returnes value table with calendar day types found for the given
//              room rate and period
// Parameters: Room rate, period from date, period to date
// Return value: Value table
// -----------------------------------------------------------------------------
Function cmGetEffectiveCalendarDayTypes(pRoomRate, pCheckInDate, pCheckOutDate, pPriceCalculationDate = '00010101') Export
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.Calendar) Then
		vList = pRoomRate.Calendar.GetObject().pmGetDays(pCheckInDate, pCheckOutDate, pCheckInDate, pCheckOutDate, , pPriceCalculationDate);
		vList.Sort("CalendarDayTypeSortCode");
		vList.GroupBy("CalendarDayType", );
	Else
		vList = New ValueTable();
		vList.Columns.Add("CalendarDayType", cmGetCatalogTypeDescription("CalendarDayTypes"));
	EndIf;
	Return vList;
EndFunction // cmGetEffectiveCalendarDayTypes

// -----------------------------------------------------------------------------
// Description: This function searches calendar day types of the second value 
//              table in the rows of the first value table. If equal rows are found
//              they are deleted from the first value table
// Parameters: First value table with calendar day types where to search and where to delete,
//             Second value table with source rows to be searched
// Return value: None
// -----------------------------------------------------------------------------
Procedure cmRemoveCalendarDayTypes(pRoomTypes, pCalendarDayTypes) Export
	i = 0;
	While i < pRoomTypes.Count() Do
		vRow = pRoomTypes.Get(i);
		If ValueIsFilled(vRow.CalendarDayType) Then
			If pCalendarDayTypes.Find(vRow.CalendarDayType, "CalendarDayType") = Undefined Then
				pRoomTypes.Delete(vRow);
				Continue;
			EndIf;
		EndIf;
		i = i + 1;
	EndDo;
EndProcedure // cmRemoveCalendarDayTypes

// -----------------------------------------------------------------------------
// Description: This function searches input value table and checks each room type 
//              whether it is stop saled for the given period or not. If yes then 
//              this room type is deleted from the value table
// Parameters: Value table with room types, Period from date, Period to date
// Return value: None
// -----------------------------------------------------------------------------
Procedure cmRemoveStopSalePeriods(pRoomTypes, pPeriodFrom, pPeriodTo) Export
	i = 0;
	While i < pRoomTypes.Count() Do
		vRow = pRoomTypes.Get(i);
		If vRow.RoomType.StopSale Then
			vRemarks = "";
			If cmIsStopInternetSalePeriod(vRow.RoomType, pPeriodFrom, pPeriodTo, vRemarks) Then
				pRoomTypes.Delete(vRow);
				Continue;
			EndIf;
		EndIf;
		i = i + 1;
	EndDo;
EndProcedure // cmRemoveStopSalePeriods

// -----------------------------------------------------------------------------
// Description: This API is used to return value table of room types vacant for the 
//              given period. For each room type this function returns prices for
//              all accommodation types defined
// Parameters: Hotel code, Room rate code, Client type code, Room type code, Room 
///            quota (allotment) code, Period from date, Period to date, External 
//             system code, Language code, Output type: XDTO object or strings in 
//             CSV format
// Return value: XDTO AvailableRoomTypesWithPrices object or CSV strings
// -----------------------------------------------------------------------------
Function cmGetAvailableRoomTypesWithPrices(pHotelCode, pRoomRateCode, pClientTypeCode, pRoomTypeCode, pRoomQuotaCode, pPeriodFrom, pPeriodTo, pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV") Export
	vInputParameters = NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode + Chars.LF + 
	              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты: ';de='Quotencode: '") + pRoomQuotaCode + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo;
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);			  
	// Debug
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetAvailableRoomTypesWithPrices", Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg, vInteraction.MaxLogLenght);
	Else
		// Log all request parameters
		WriteLogEvent(NStr("en='Get available room types with prices';ru='Получить остатки свободных номеров с ценами';de='Restbestände an freien Zimmern mit Preisen erhalten'"), EventLogLevel.Information, , , vInputParameters);
	EndIf;
	// Retrieve language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	
	vRoomRate = Catalogs.RoomRates.EmptyRef();
	If IsBlankString(pRoomRateCode) Then
		If ValueIsFilled(vHotel) Then
			vRoomRate = vHotel.RoomRate;
		EndIf;
	Else
		vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode, , vInteraction);
	EndIf;
	If Not ValueIsFilled(vRoomRate) Then
		If ValueIsFilled(vHotel) Then
			vRoomRate = vHotel.RoomRate;
		EndIf;
	EndIf;
	vClientType = Catalogs.ClientTypes.EmptyRef();
	If Not IsBlankString(pClientTypeCode) Then
		vClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode, , vInteraction);
	EndIf;
	vRoomType = Catalogs.RoomTypes.EmptyRef();
	If Not IsBlankString(pRoomTypeCode) Then
		vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode, , vInteraction);
	EndIf;
	vRoomQuota = Catalogs.RoomQuotas.EmptyRef();
	If Not IsBlankString(pRoomQuotaCode) Then
		vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode, , vInteraction);
	EndIf;
	
	vPriceCalculationDate = CurrentSessionDate();
	
	// 1. Run query to retrieve prices and available rooms/beds 
	vRoomTypes = cmGetRoomTypesWithBalancesAndPrices(vHotel, vRoomRate, vClientType, vRoomType, vRoomQuota, pPeriodFrom, pPeriodTo, vPriceCalculationDate);
	
	// 2. Run query to retrieve list of day types that are into the search period
	vCalendarDayTypes = cmGetEffectiveCalendarDayTypes(vRoomRate, pPeriodFrom, pPeriodTo, vPriceCalculationDate);
	
	// 3. Remove calendar day types not into the search period from the list of prices
	cmRemoveCalendarDayTypes(vRoomTypes, vCalendarDayTypes);
	
	// 4. Remove price tags not into the search period from the list of prices
	vPriceTagsList = New ValueList();
	vPriceTags = cmGetEffectivePriceTags(vHotel, vRoomRate, vRoomType, pPeriodFrom, pPeriodTo, vPriceTagsList, , vPriceCalculationDate);
	cmRemovePriceTags(vRoomTypes, vPriceTagsList, vPriceTags);
	
	// 4. Remove stop sale periods from the list of prices
	cmRemoveStopSalePeriods(vRoomTypes, pPeriodFrom, pPeriodTo);
	
	// 5. Sort room types list
	vRoomTypes.Sort("HotelSortCode, RoomTypeSortCode, AccommodationTypeSortCode, CalendarDayType, Currency");
	
	// Add columns with hotel, room type, accommodation type and calendar day type external codes
	vRoomTypes.Columns.Add("ExtHotelCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("ExtRoomTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("RoomTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("RoomTypeDescription", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("ExtAccommodationTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("AccommodationTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("AccommodationTypeDescription", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("ExtCalendarDayTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("CalendarDayTypeCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("CalendarDayTypeDescription", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("ExtCurrencyCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("CurrencyCode", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("CurrencyDescription", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("PricePresentation", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("RoomTypePictureLink", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("RoomTypeInfoLink", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("AccommodationTypePictureLink", cmGetStringTypeDescription());
	vRoomTypes.Columns.Add("AccommodationTypeInfoLink", cmGetStringTypeDescription());
	
	// Variable with reservation conditions
	vPaymentMethodCodesAllowedOnline = "";
	vReservationConditionsShort = "";
	vReservationConditionsOnline = "";
	vReservationConditions = cmNStr(
		"ru = '* Для аннулирования брони известите отдел бронирования до 18:00 дня предшествующего дате заезда
		|
		|* Возможность поселения ранее указанного времени должна быть согласована с отделом бронирования'; 
		|de = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL'; 
		|en = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL'", vLanguage);
	If ValueIsFilled(vHotel) And Not IsBlankString(vHotel.ReservationConditions) Then
		vReservationConditions = cmNStr(vHotel.ReservationConditions, vLanguage);
	EndIf;
	If ValueIsFilled(vRoomRate) And Not IsBlankString(vRoomRate.ReservationConditions) Then
		vReservationConditions = cmNStr(vRoomRate.ReservationConditions, vLanguage);
		vReservationConditionsShort = cmNStr(vRoomRate.ReservationConditionsShort, vLanguage);
		vReservationConditionsOnline = cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage);
		vPaymentMethodCodesAllowedOnline = TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline);
	EndIf;
	vReservationConditions = Left(vReservationConditions, 4096);
	vReservationConditionsShort = Left(vReservationConditionsShort, 4096);
	vReservationConditionsOnline = Left(vReservationConditionsOnline, 4096);
	vPaymentMethodCodesAllowedOnline = Left(vPaymentMethodCodesAllowedOnline, 4096);
	
	// 6. Build return string
	vRetStr = "";
	For Each vRow In vRoomTypes Do
		vRow.ExtHotelCode = "";
		If ValueIsFilled(vRow.Hotel) Then
			vRow.ExtHotelCode = cmGetObjectExternalSystemCodeByRef(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vRow.Hotel);
			If IsBlankString(vRow.ExtHotelCode) Then
				vRow.ExtHotelCode = TrimAll(vRow.Hotel.Description);
			EndIf;
		EndIf;
		vRow.ExtRoomTypeCode = "";
		vRow.RoomTypeCode = "";
		vRow.RoomTypeDescription = "";
		If ValueIsFilled(vRow.RoomType) Then
			vRoomTypeObj = vRow.RoomType.GetObject();
			vRow.RoomTypeCode = TrimAll(vRow.RoomType.Code);
			vRow.RoomTypeDescription = vRoomTypeObj.pmGetRoomTypeDescription(vLanguage);
			vRow.ExtRoomTypeCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "RoomTypes", vRow.RoomType);
			If IsBlankString(vRow.ExtRoomTypeCode) Then
				vRow.ExtRoomTypeCode = TrimAll(vRow.RoomType.Description);
			EndIf;
			vRow.ExtRoomTypeCode = Left(vRow.ExtRoomTypeCode, 36);
			vRow.RoomTypePictureLink = TrimAll(vRow.RoomType.RoomTypePictureLink);
			If Not IsBlankString(vRow.RoomType.RoomTypeInfoLink) Then
				vRow.RoomTypeInfoLink = cmNStr(vRow.RoomType.RoomTypeInfoLink, vLanguage);
			Else
				vRow.RoomTypeInfoLink = TrimAll(vRow.RoomTypeDescription);
			EndIf;
		EndIf;
		vRow.ExtAccommodationTypeCode = "";
		vRow.AccommodationTypeCode = "";
		vRow.AccommodationTypeDescription = "";
		If ValueIsFilled(vRow.AccommodationType) Then
			vAccommodationTypeObj = vRow.AccommodationType.GetObject();
			vRow.AccommodationTypeCode = TrimAll(vRow.AccommodationType.Code);
			vRow.AccommodationTypeDescription = vAccommodationTypeObj.pmGetAccommodationTypeDescription(vLanguage);
			vRow.ExtAccommodationTypeCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "AccommodationTypes", vRow.AccommodationType);
			If IsBlankString(vRow.ExtAccommodationTypeCode) Then
				vRow.ExtAccommodationTypeCode = TrimAll(vRow.AccommodationType.Description);
			EndIf;
			vRow.ExtAccommodationTypeCode = Left(vRow.ExtAccommodationTypeCode, 36);
			vRow.AccommodationTypePictureLink = TrimAll(vRow.AccommodationType.WebSitePictureLink);
			If Not IsBlankString(vRow.AccommodationType.WebSiteInfoLink) Then
				vRow.AccommodationTypeInfoLink = cmNStr(vRow.AccommodationType.WebSiteInfoLink, vLanguage);
			Else
				vRow.AccommodationTypeInfoLink = TrimAll(vRow.AccommodationTypeDescription);
			EndIf;
		EndIf;
		vRow.ExtCalendarDayTypeCode = "";
		vRow.CalendarDayTypeCode = "";
		vRow.CalendarDayTypeDescription = "";
		If ValueIsFilled(vRow.CalendarDayType) Then
			vCalendarDayTypeObj = vRow.CalendarDayType.GetObject();
			vRow.CalendarDayTypeCode = TrimAll(vRow.CalendarDayType.Code);
			vRow.CalendarDayTypeDescription = vCalendarDayTypeObj.pmGetDayTypeDescription(vLanguage);
			vRow.ExtCalendarDayTypeCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "CalendarDayTypes", vRow.CalendarDayType);
			If IsBlankString(vRow.ExtCalendarDayTypeCode) Then
				vRow.ExtCalendarDayTypeCode = TrimAll(vRow.CalendarDayType.Description);
			EndIf;
			vRow.ExtCalendarDayTypeCode = Left(vRow.ExtCalendarDayTypeCode, 36);
		EndIf;
		vRow.ExtCurrencyCode = "";
		vRow.CurrencyCode = "";
		vRow.CurrencyDescription = "";
		If ValueIsFilled(vRow.Currency) Then
			vCurrencyObj = vRow.Currency.GetObject();
			vRow.CurrencyCode = TrimAll(vRow.Currency.Code);
			vRow.CurrencyDescription = vCurrencyObj.pmGetCurrencyDescription(vLanguage);
			vRow.ExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "Currencies", vRow.Currency);
			If IsBlankString(vRow.ExtCurrencyCode) Then
				vRow.ExtCurrencyCode = TrimAll(vRow.Currency.Description);
			EndIf;
		EndIf;
		vRow.PricePresentation = cmFormatSum(vRow.Price, vRow.Currency, "NZ=");
		vRetStr = vRetStr + """" + vRow.ExtHotelCode + """" + "," + """" + vRow.ExtRoomTypeCode + """" + "," + 
		          """" + vRow.ExtAccommodationTypeCode + """" + "," + """" + vRow.ExtCalendarDayTypeCode + """" + "," + 
		          Format(vRow.TotalRooms, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + Format(vRow.TotalBeds, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
		          Format(vRow.RoomsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + Format(vRow.BedsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
		          """" + vRow.ExtCurrencyCode + """" + "," + Format(vRow.Price, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
				  """" + vRow.RoomTypeCode + """" + "," + """" + cmRemoveComma(vRow.RoomTypeDescription) + """" + "," + 
				  """" + vRow.AccommodationTypeCode + """" + "," + """" + cmRemoveComma(vRow.AccommodationTypeDescription) + """" + "," + 
				  """" + vRow.CalendarDayTypeCode + """" + "," + """" + cmRemoveComma(vRow.CalendarDayTypeDescription) + """" + "," + 
				  """" + vRow.CurrencyCode + """" + "," + """" + cmRemoveComma(vRow.CurrencyDescription) + """" + "," + 
				  """" + cmRemoveComma(vRow.PricePresentation) + """" + "," + 
				  """" + cmRemoveComma(vRow.RoomTypePictureLink) + """" + "," + """" + cmRemoveComma(vRow.RoomTypeInfoLink) + """" + "," + 
				  """" + cmRemoveComma(vRow.AccommodationTypePictureLink) + """" + "," + """" + cmRemoveComma(vRow.AccommodationTypeInfoLink) + """" + "," + 
		          Format(vRow.NumberOfPersonsPerRoom, "ND=10; NFD=0; NZ=; NG=; NN=") + Chars.LF;
	EndDo;
	WriteLogEvent(NStr("en='Get available room types with prices';ru='Получить остатки свободных номеров с ценами';de='Restbestände an freien Zimmern mit Preisen erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
	// Return based on output type
	If pOutputType = "CSV" Then
		// Debug
		If vWriteDebug Then
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetAvailableRoomTypesWithPrices", Enums.ExternalSystemEventTypes.Info, , vRetStr , vMsg, vInteraction.MaxLogLenght);
		EndIf;
		Return vRetStr;
	Else
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesWithPrices"));
		vRetXDTO.ReservationConditions = vReservationConditions;
		vRetXDTO.ReservationConditionsShort = vReservationConditionsShort;
		vRetXDTO.ReservationConditionsOnline = vReservationConditionsOnline;
		vRetXDTO.PaymentMethodCodesAllowedOnline = vPaymentMethodCodesAllowedOnline;
		vRetRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesWithPricesRows"));
		For Each vRow In vRoomTypes Do
			vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesWithPricesRow"));
			vRetRow.Hotel = vRow.ExtHotelCode;
			vRetRow.RoomType = vRow.ExtRoomTypeCode;
			vRetRow.AccommodationType = vRow.ExtAccommodationTypeCode;
			vRetRow.CalendarDayType = vRow.ExtCalendarDayTypeCode;
			vRetRow.TotalRooms = vRow.TotalRooms;
			vRetRow.TotalBeds = vRow.TotalBeds;
			vRetRow.RoomsAvailable = vRow.RoomsAvailable;
			vRetRow.BedsAvailable = vRow.BedsAvailable;
			vRetRow.Currency = vRow.ExtCurrencyCode;
			vRetRow.Price = vRow.Price;
			vRetRow.RoomTypeCode = vRow.RoomTypeCode;
			vRetRow.RoomTypeDescription = vRow.RoomTypeDescription;
			vRetRow.AccommodationTypeCode = vRow.AccommodationTypeCode;
			vRetRow.AccommodationTypeDescription = vRow.AccommodationTypeDescription;
			vRetRow.CalendarDayTypeCode = vRow.CalendarDayTypeCode;
			vRetRow.CalendarDayTypeDescription = vRow.CalendarDayTypeDescription;
			vRetRow.CurrencyCode = vRow.CurrencyCode;
			vRetRow.CurrencyDescription = vRow.CurrencyDescription;
			vRetRow.PricePresentation = vRow.PricePresentation;
			vRetRow.RoomTypePictureLink = vRow.RoomTypePictureLink;
			vRetRow.RoomTypeInfoLink = vRow.RoomTypeInfoLink;
			vRetRow.AccommodationTypePictureLink = vRow.AccommodationTypePictureLink;
			vRetRow.AccommodationTypeInfoLink = vRow.AccommodationTypeInfoLink;
			vRetRow.NumberOfPersonsPerRoom = vRow.NumberOfPersonsPerRoom;
			
			vRetRows.AvailableRoomTypesWithPricesRow.Add(vRetRow);
		EndDo;
		vRetXDTO.AvailableRoomTypesWithPricesRows = vRetRows;
		// Debug
		If vWriteDebug Then
			vExtraXML = "";
			vXMLWriter = New XMLWriter; 
			vXMLWriter.SetString();
			XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
			vExtraXML = vXMLWriter.Close();
			
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetAvailableRoomTypesWithPrices", Enums.ExternalSystemEventTypes.Info, , vExtraXML , vMsg, vInteraction.MaxLogLenght);
		EndIf;

		Return vRetXDTO;
	EndIf;
EndFunction // cmGetAvailableRoomTypesWithPrices

// -----------------------------------------------------------------------------
// Description: This API is used to return value table of room types vacant for the 
//              given period. For each room type this function returns prices for
//              all accommodation types defined
// Parameters: Hotel code, External system code, Language code, Output type: XDTO 
//             object or strings in CSV format, Room rate code
// Return value: XDTO HotelParameters object or CSV string
// -----------------------------------------------------------------------------
Function cmGetHotelParameters(pHotelCode, pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV", pRoomRateCode = "") Export
	WriteLogEvent(NStr("en='Get hotel parameters';ru='Получить параметры гостиницы';de='Hotelparameter erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF +
	              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode);
	// Retrieve language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Build return string
	vRetStr = "";
	If ValueIsFilled(vHotel) Then
		// Retrieve room rate
		vRoomRate = Catalogs.RoomRates.EmptyRef();
		If IsBlankString(pRoomRateCode) Then
			vRoomRate = vHotel.RoomRate;
		Else
			vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode);
		EndIf;
		// Fill hotel parameters
		vHotelObj = vHotel.GetObject();
		vHotelPrintName = Left(Catalogs.Hotels.pmGetHotelPrintName(vHotelObj, vLanguage), 1024);
		vReservationConditions = "";
		vReservationConditionsShort = "";
		vReservationConditionsOnline = "";
		vPaymentMethodCodesAllowedOnline = "";
		If ValueIsFilled(vRoomRate) And Not IsBlankString(vRoomRate.ReservationConditions) Then
			vReservationConditions = cmNStr(vRoomRate.ReservationConditions, vLanguage);
			vReservationConditionsShort = cmNStr(vRoomRate.ReservationConditionsShort, vLanguage);
			vReservationConditionsOnline = cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage);
			vPaymentMethodCodesAllowedOnline = TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline);
		ElsIf Not IsBlankString(vHotelObj.ReservationConditions) Then
			vReservationConditions = cmNStr(vHotelObj.ReservationConditions, vLanguage);
		Else
			vReservationConditions = cmNStr(
				"ru = '* Для аннулирования брони известите отдел бронирования до 18:00 дня предшествующего дате заезда
				|
				|* Возможность поселения ранее указанного времени должна быть согласована с отделом бронирования'; 
				|de = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL';
				|en = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL'", vLanguage);
		EndIf;
		vReservationConditions = Left(vReservationConditions, 4096);
		vReservationConditionsShort = Left(vReservationConditionsShort, 4096);
		vReservationConditionsOnline = Left(vReservationConditionsOnline, 4096);
		vPaymentMethodCodesAllowedOnline = Left(vPaymentMethodCodesAllowedOnline, 4096);
		vHotelPostAddress = Left(Catalogs.Hotels.pmGetHotelPostAddressPresentation(vHotelObj, vLanguage), 4096);
		vHowToDriveToTheHotel = Left(Catalogs.Hotels.pmGetHotelHowToDriveToTheHotelDescription(vHotelObj, vLanguage), 4096);
		vReservationDivisionContacts = Left(Catalogs.Hotels.pmGetHotelReservationDivisionContacts(vHotelObj, vLanguage), 4096);
		vHotelPhones = Left(cmNStr(vHotelObj.Phones, vLanguage), 50);
		vHotelFax = Left(cmNStr(vHotelObj.Fax, vLanguage), 50);
		vHotelEMail = Left(TrimAll(vHotelObj.EMail), 50);
		vHotelLogoLink = TrimAll(vHotelObj.HotelLogoLink);
		vServerTimeZone = -(StandardTimeOffset(,) + DaylightTimeOffset(,));
		// Get maximum number of adults and children
		vMaxAdults = 0;
		vMaxKids = 0;
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	ISNULL(MAX(Rooms.NumberOfBedsPerRoom), 0) AS MaxNumberOfBedsPerRoom,
		|	ISNULL(MAX(Rooms.NumberOfPersonsPerRoom), 0) AS MaxNumberOfPersonsPerRoom,
		|	ISNULL(MAX(Rooms.NumberOfPersonsPerRoom - Rooms.NumberOfBedsPerRoom), 0) AS MaxNumberOfAdditionalBeds
		|FROM
		|	Catalog.Rooms AS Rooms
		|WHERE
		|	NOT Rooms.DeletionMark
		|	AND NOT Rooms.IsFolder
		|	AND NOT Rooms.IsVirtual
		|	AND Rooms.Owner = &qHotel";
		vQry.SetParameter("qHotel", vHotel);
		vPersonsData = vQry.Execute().Unload();
		If vPersonsData.Count() > 0 Then
			vPersonsDataRow = vPersonsData.Get(0);
			vMaxAdults = vPersonsDataRow.MaxNumberOfPersonsPerRoom;
			vMaxKids = vPersonsDataRow.MaxNumberOfPersonsPerRoom;
		EndIf;    
		vCheckInTime = '00010101120000';
		vCheckOutTime = '00010101120000';
		vRoomRate = vHotel.RoomRate;
		If ValueIsFilled(vRoomRate) Then 
			If ValueIsFilled(vRoomRate.DefaultCheckInTime) And ValueIsFilled(vRoomRate.DefaultCheckOutTime) Then
				vCheckInTime = vRoomRate.DefaultCheckInTime;
				vCheckOutTime = vRoomRate.DefaultCheckOutTime; 
			EndIf;
		EndIf;
		// Build return string		
		vRetStr = vRetStr + """" + TrimAll(vHotel.Code) + """" + "," + """" + vHotelPrintName + """" + "," + """" + vReservationConditions + """" + "," + 
		          """" + vHotelPostAddress + """" + "," + """" + vHowToDriveToTheHotel + """" + "," + 
		          """" + vReservationDivisionContacts + """" + "," + """" + vHotelPhones + """" + "," + 
				  """" + vHotelFax + """" + "," + """" + vHotelEMail + """" + "," + 
				  """" + vHotelLogoLink + """" + "," + Format(vServerTimeZone, "ND=6; NFD=0; NZ=; NG=") + "," + 
				  Format(vMaxAdults, "ND=10; NFD=0; NZ=; NG=") + "," + Format(vMaxKids, "ND=10; NFD=0; NZ=; NG=");
	Else
		Raise NStr("en='Hotel code was wrong!';ru='Код гостиницы указан не верно!';de='Code des Hotels ist falsch angegeben!'");
	EndIf;
	WriteLogEvent(NStr("en='Get hotel attributes';ru='Получить параметры гостиницы';de='Hotelparameter erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
	// Return based on output type
	If pOutputType = "CSV" Then
		Return vRetStr;
	Else
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "HotelParameters"));
		vRetXDTO.HotelCode = TrimAll(vHotel.Code);
		vRetXDTO.HotelPrintName = vHotelPrintName;
		vRetXDTO.ReservationConditions = vReservationConditions;
		vRetXDTO.ReservationConditionsShort = vReservationConditionsShort;
		vRetXDTO.ReservationConditionsOnline = vReservationConditionsOnline;
		vRetXDTO.PaymentMethodCodesAllowedOnline = vPaymentMethodCodesAllowedOnline;
		vRetXDTO.HotelPostAddress = vHotelPostAddress;
		vRetXDTO.HowToDriveToTheHotel = vHowToDriveToTheHotel;
		vRetXDTO.ReservationDivisionContacts = vReservationDivisionContacts;
		vRetXDTO.HotelPhones = vHotelPhones;
		vRetXDTO.HotelFax = vHotelFax;
		vRetXDTO.HotelEMail = vHotelEMail;
		vRetXDTO.HotelLogoLink = vHotelLogoLink;
		vRetXDTO.ServerTimeZone = vServerTimeZone;
		vRetXDTO.MaxAdults = vMaxAdults;
		vRetXDTO.MaxKids = vMaxKids;
		vRetXDTO.CheckInTime = vCheckInTime;
		vRetXDTO.CheckOutTime = vCheckOutTime;
		Return vRetXDTO;
	EndIf;
EndFunction // cmGetHotelParameters

// -----------------------------------------------------------------------------
// Description: Writes external payment to the external reservation folio 
// Parameters: External reservation code, External guest group code, External client 
//             code, Payer name, Payment method, Payment amount (number), Payment 
//             currency, Payment section,  Hotel code, External system code, Credit \
//             card processing reference number, Credit card processing authorisation 
//             code, Remarks as string, Output type: XDTO GuestGroupPaymentStatus object 
//             or string in CSV format
// Return value: XDTO GuestGroupPaymentStatus object or CSV string
// -----------------------------------------------------------------------------
Function cmWriteExternalPayment(pExtReservationCode, pExtGroupCode, pExtClientCode, 
                                pExtPayerCode = "", pPayerTIN = "", pPayerKPP = "", pPayerName = "", 
                                pPaymentMethod, pSum, pCurrency, pPaymentSection, pHotelCode, pExternalSystemCode, 
								pReferenceNumber, pAuthorizationCode, pRemarks, pGuaranteedReservationStatus = "", 
								pPaymentDate = Undefined, pCompanyCode = "", pPaymentExternalCode = "", 
								pOutputType = "CSV", pExternalPaymentData = Undefined) Export
	vInputParameters =  NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='External reservation code: ';ru='Код брони во внешней системе: ';de='Reservierungscode im externen System: '") + pExtReservationCode + Chars.LF + 
	              NStr("en='External group code: ';ru='Код группы во внешней системе: ';de='Gruppencode im externen System: '") + pExtGroupCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='External client code: ';ru='Код клиента во внешней системы: ';de='Kundecode im externen System: '") + pExtClientCode + Chars.LF + 
	              NStr("en='External payer code: ';ru='Код плательщика во внешней системе: ';de='Zahlercode im externen System: '") + pExtPayerCode + Chars.LF + 
	              NStr("en='Payer name: ';ru='Наименование плательщика: ';de='Bezeichnung des Zahlers: '") + pPayerName + Chars.LF + 
	              NStr("en='Payer TIN: ';ru='ИНН плательщика: ';de='INN des Zahlers: '") + pPayerTIN + Chars.LF + 
	              NStr("en='Payer KPP: ';ru='КПП плательщика: ';de='Zahler-KPP: '") + pPayerKPP + Chars.LF + 
	              NStr("en='Payment method code: ';ru='Код способа оплаты: ';de='Code der Zahlungsmethode: '") + pPaymentMethod + Chars.LF + 
	              NStr("en='Payment section code: ';ru='Код кассовой секции: ';de='Code der Kassensektion: '") + pPaymentSection + Chars.LF + 
	              NStr("en='Reference number: ';ru='Референс номер: ';de='Referenznummer: '") + pReferenceNumber + Chars.LF + 
	              NStr("en='Authorization code: ';ru='Код авторизации: ';de='Autorisierungscode: '") + pAuthorizationCode + Chars.LF + 
	              NStr("en='Remarks: ';ru='Примечания: ';de='Anmerkungen: '") + pRemarks + Chars.LF + 
	              NStr("en='Guaranteed reservation status: ';ru='Статус оплаченной брони: ';de='Status der bezahlten Reservierung: '") + pGuaranteedReservationStatus + Chars.LF + 
	              NStr("en='Currency code: ';ru='Код валюты: ';de='Währungscode: '") + pCurrency + Chars.LF + 
	              NStr("en='Payment date: ';ru='Дата платежа: ';de='Zahlungsdatum: '") + pPaymentDate + Chars.LF + 
	              NStr("en='Company code: ';ru='Код фирмы: ';de='Firmencode: '") + pCompanyCode + Chars.LF + 
	              NStr("en='Payment external code: ';ru='Код платежа во внешней системе: ';de='Zahlungscode im externen System: '") + pPaymentExternalCode + Chars.LF + 
	              NStr("en='Payment sum: ';ru='Сумма платежа: ';de='Summe der Zahlung: '") + Format(pSum, "ND=17; NFD=2; NZ=");								
				  
	vFuncLogName = NStr("en='Write external payment';ru='Записать внешний платеж';de='eine externe Zahlung einschreiben'");			  
	vInputParametersAdd = "";
	If pExternalPaymentData <> Undefined Then
		MerchantID = "";
		Try MerchantID = TrimAll(pExternalPaymentData.MerchantID); Except EndTry;
		vInputParametersAdd = NStr("en='Card number: ';ru='Номер карты: ';de='Kartenummer: '") + pExternalPaymentData.CardNumber + Chars.LF + 
					  NStr("en = 'Loyalty card ID: '; de = 'Treuekartennummer: '; ru = 'ID карты лояльности: '") + pExternalPaymentData.LoyaltyCardID + Chars.LF +
		              NStr("en='Order number: ';ru='Номер заказа: ';de='Bestellungsnummer: '") + pExternalPaymentData.OrderNumber + Chars.LF + 
		              NStr("en='Card holder: ';ru='Держатель карты: ';de='Kartenhalter: '") + pExternalPaymentData.CardHolder + Chars.LF + 
		              NStr("en='Invoice code: ';ru='Код счета на оплату: ';de='Rechnungscode: '") + pExternalPaymentData.InvoiceCode + Chars.LF + 
					  NStr("en='Payment external code from acc: ';ru='Код платежа в бух системе: ';de='Zahlungscode im externen System: '") + pExternalPaymentData.ExternalPaymentCode + Chars.LF + 
					  NStr("en='Merchant: ';ru='Merchant: ';de='Merchant: '") + MerchantID + Chars.LF + 
		              NStr("en='Operation date: ';ru='Дата операции: ';de='Betriebsdatum: '") + Format(pExternalPaymentData.Date, "DF='dd.MM.yyyy HH:mm'");
	EndIf;
	vInputParameters = vInputParameters + Chars.LF + "ExternalPaymentData: " + Chars.LF + vInputParametersAdd;			  
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLogName, Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg);
	Else
		WriteLogEvent(vFuncLogName, EventLogLevel.Information, , , vInputParameters);
	EndIf;
    BeginTransaction(DataLockControlMode.Managed);
	Try
		// Save current timestamp and start transaction
		vCurrentDate = CurrentSessionDate();
		
		// Initialize error description
		vErrorDescription = "";
		
		vFolio = Undefined;
		vCallIsByGuestGroup = True;
		
		// Try to find existing reservation with given external code
		vDocRef = Documents.Reservation.EmptyRef();
		If Not IsBlankString(pExtReservationCode) Then
			vDocRef = cmGetReservationByExternalCode(vHotel, pExtReservationCode);
			If ValueIsFilled(vDocRef) Then
				vCallIsByGuestGroup = False;
			EndIf;
		EndIf;
		// Fill payment external code
		vPaymentExternalCode = TrimAll(pPaymentExternalCode);
		If IsBlankString(vPaymentExternalCode) And pExternalPaymentData <> Undefined Then
			vPaymentExternalCode = TrimAll(pExternalPaymentData.ExternalPaymentCode);
		EndIf;	
		// Try to find guest group by code
		vGuestGroup = Catalogs.GuestGroups.EmptyRef();
		If Not IsBlankString(pExtGroupCode) And pExtGroupCode <> 0 Then
			vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pExtGroupCode, "", "", False);
		EndIf;       
		// Try to find payment method
		vPaymentMethod = Catalogs.PaymentMethods.EmptyRef();
		If Not IsBlankString(pPaymentMethod) Then
			vPaymentMethod = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentMethods", pPaymentMethod, , vInteraction);
		EndIf;
		If Not ValueIsFilled(vPaymentMethod) Then
			vPaymentMethod = vHotel.PlannedPaymentMethod;
		EndIf;
		// If status is not active, then set new
		vStatusWasRestore = False;   
		If ValueIsFilled(vPaymentMethod) And Not vPaymentMethod.IsForReturnOnly Then
			CheckAndRestoreStatus(vGuestGroup, vStatusWasRestore);      
		EndIf;
		// Invoice
		vInvoiceRef = Undefined;
		vLoyaltyCard = Catalogs.DiscountCards.EmptyRef();
		vCompany = Catalogs.Companies.EmptyRef();
		If pExternalPaymentData <> Undefined Then
			vLoyaltyCardID = "";
			If TypeOf(pExternalPaymentData) = Type("Structure") Then
				vInvoiceCode = pExternalPaymentData.InvoiceCode;
				If pExternalPaymentData.Property("LoyaltyCardID") Then
					vLoyaltyCardID = pExternalPaymentData.LoyaltyCardID;
				EndIf;	
			Else	
				vInvoiceCode = pExternalPaymentData.Get("InvoiceCode");
				vLoyaltyCardID =  pExternalPaymentData.LoyaltyCardID;
			EndIf;
			If Not IsBlankString(vLoyaltyCardID) Then
				If StrLen(vLoyaltyCardID) > 30 Then
					// Try to get card from UUID
					Try
						vCardRef = Catalogs.DiscountCards.GetRef(New UUID(vLoyaltyCardID));
						If ValueIsFilled(vCardRef) And Not vCardRef.GetObject() = Undefined Then
							vLoyaltyCard = vCardRef;
						Endif;	
					Except
					EndTry;
				Else
					// Get valid phone number
					vLoyaltyCardID 	= SMS.GetValidPhoneNumber(vLoyaltyCardID);
					vLoyaltyCardID 	= StrReplace(vLoyaltyCardID, "+", "");
					vCards = Catalogs.DiscountCards.GetActiveBonusesCards(vLoyaltyCardID);
					For Each vRow In vCards Do
						vLoyaltyCard = vRow.Ref;
						Break;
					EndDo;
				EndIf;
			EndIf;	
			If Not IsBlankString(vInvoiceCode) Then   
				// 1. Try get by invoice code
				vInvoiceRef = GetInvoiceByExternalSystemCode(vInvoiceCode);  
				If Not ValueIsFilled(vInvoiceRef) And Not ValueIsFilled(vDocRef) And (TypeOf(pExtReservationCode) = Type("String") And StrLen(pExtReservationCode) = 36) Then
					// 2. Get by external code
					vInvoiceRef = GetInvoiceByExternalSystemCode(pExtReservationCode);
				EndIf;	
				If ValueIsFilled(vInvoiceRef) And Not vInvoiceRef.GetObject() = Undefined Then
					If ValueIsFilled(vInvoiceRef.GuestGroup) And Not ValueIsFilled(vGuestGroup) Then
						vGuestGroup = vInvoiceRef.GuestGroup;
					EndIf;
					If ValueIsFilled(vInvoiceRef.Hotel) Then
						vHotel = vInvoiceRef.Hotel;
					EndIf;
					If ValueIsFilled(vInvoiceRef.Company) Then
						vCompany = vInvoiceRef.Company;
					EndIf;
					If ValueIsFilled(vInvoiceRef.Folio) Then
						vFolio = vInvoiceRef.Folio;
					ElsIf ValueIsFilled(vInvoiceRef.ParentDoc) And TypeOf(vInvoiceRef.ParentDoc) = Type("DocumentRef.Folio") Then
						vFolio = vInvoiceRef.ParentDoc;
					EndIf;
				Else
					// Silently return from function because this invoice is not from this database. Simply skip this call
					vRetStr = "";
					If TransactionActive() Then
						RollbackTransaction();
					EndIf;   
					vMsg = NStr("en = 'Invoice code passed is not from hotel database - SKIPPING THIS CALL!'; 
								|de = 'Rechnung nicht über den übertragenen Code gefunden! Dieses Proformarechnung ist kein Hotel - Anruf wird übersprungen.'; 
								|ru = 'Счет на оплату не найден по переданному коду! Этот счет не из отельной базы - ВЫЗОВ НЕ ОБРАБАТЫВАЕМ'");
					// Log success		
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, , , vMsg);
					// Return based on output type
					If pOutputType = "CSV" Then
						Return vRetStr;
					Else
						vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPaymentStatus"));
						vRetXDTO.PaymentNumber = "";
						vRetXDTO.ErrorDescription = "";
						vRetXDTO.TotalSum = 0;
						vRetXDTO.TotalSumPresentation = "";
						vRetXDTO.Balance = 0;
						vRetXDTO.BalancePresentation = "";
						vRetXDTO.UUID = "";
						Return vRetXDTO;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
		// Try to find client by code
		vClient = Catalogs.Clients.EmptyRef();
		If Not IsBlankString(pExtClientCode) Then
			vClient = cmGetClientByExternalCode(pExtClientCode);
			If Not ValueIsFilled(vClient) Then
				vClient = cmGetClientByCode(pExtClientCode);
			EndIf;
		EndIf;
		// Try to find company
		If Not ValueIsFilled(vCompany) And Not IsBlankString(pCompanyCode) Then
			vCompany = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Companies", pCompanyCode, , vInteraction);
		EndIf;
		// Try to find payment section
		vPaymentSection = Catalogs.PaymentSections.EmptyRef();
		If Not IsBlankString(pPaymentSection) Then
			vPaymentSection = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentSections", pPaymentSection, , vInteraction);
			If Not ValueIsFilled(vPaymentSection) And cmIsNumber(pPaymentSection) And String(pPaymentSection) <> "0" Then
				vPaymentSection = Catalogs.PaymentSections.FindByCode(Number(pPaymentSection));
			EndIf;
		EndIf;
		vAdvancePaymentMode = False;
		vAdvancePaymentSection = Undefined;
		vMultipleAdvanceSectionsMode = False;
		If Not ValueIsFilled(vPaymentSection) And ValueIsFilled(vHotel) Then
			If vHotel.SplitFolioBalanceByPaymentSections Or vHotel.SplitFolioBalanceByServicesAndPrices Then
				vAdvanceSettlementPaymentMethod = Undefined;
				cmFillAdvanceAndAdvanceSettlementParameters(vHotel, SessionParameters.CurrentUser, vAdvancePaymentSection, vAdvanceSettlementPaymentMethod, vMultipleAdvanceSectionsMode);
				If ValueIsFilled(vAdvancePaymentSection) And Not vMultipleAdvanceSectionsMode Then
					vPaymentSection = vAdvancePaymentSection;
				EndIf;
			EndIf;
		EndIf;
		If Not ValueIsFilled(vPaymentSection) And ValueIsFilled(vHotel) Then
			vPaymentSection = vHotel.PaymentSectionForAdvance;
		EndIf;
		// Try to find reservation status
		vGuaranteedReservationStatus = Catalogs.ReservationStatuses.EmptyRef();
		If Not IsBlankString(pGuaranteedReservationStatus) Then
			vGuaranteedReservationStatus = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ReservationStatuses", pGuaranteedReservationStatus, , vInteraction);
		Else
			vGuaranteedReservationStatus = vHotel.GuaranteedReservationStatus;
		EndIf;
		// Try to find currency
		vCurrency = Catalogs.Currencies.EmptyRef();
		If Not IsBlankString(pCurrency) Then
			If cmIsNumber(pCurrency) Then
				vCurrency = Catalogs.Currencies.FindByCode(Number(pCurrency));
			EndIf;
			If Not ValueIsFilled(vCurrency) Then
				vCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", pCurrency, , vInteraction);
			EndIf;
		EndIf;
		// Try to find payer
		vCustomer = Catalogs.Customers.EmptyRef();
		If Not IsBlankString(pExtPayerCode) Then
			// Try to find customer by external code
			vCustomer = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Customers", pExtPayerCode, , vInteraction);
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pPayerTIN) Then
			// Try to find customer by TIN and KPP
			vCustomer = cmGetCustomerByTIN(TrimR(pPayerTIN), TrimR(pPayerKPP), "", False);
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pPayerName) Then
			// Try to find customer by name
			vCustomer = cmGetCustomerByName(Upper(TrimR(pPayerName)), , False,,,,,vHotel);
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pExtPayerCode) And Not IsBlankString(pPayerTIN) And Not IsBlankString(pPayerName) Then 
			vCustomerObj = Catalogs.Customers.CreateItem();
			vCustomerObj.pmFillAttributesWithDefaultValues();
			vCustomerObj.Description = TrimR(pPayerName);
			vCustomerObj.LegacyName = TrimR(vCustomerObj.Description);
			vCustomerObj.TIN = TrimR(pPayerTIN);
			vCustomerObj.KPP = TrimR(pPayerKPP);
			vCustomerObj.ExternalCode = TrimR(pExtPayerCode);
			vCustomerObj.Write();
			vCustomerObj.pmWriteToCustomerChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			vCustomer = vCustomerObj.Ref;
		EndIf;
		// Check parameters
		If pSum = 0 Then
			Raise NStr("en='Payment sum should be filled!';ru='Сумма платежа должна быть указана!';de='Summe der Zahlung muss angegeben werden!'");
		ElsIf Not ValueIsFilled(vHotel) Then
			Raise NStr("en='Hotel should be specified!';ru='Гостиница должна быть указана!';de='Das Hotel muss angegeben sein!'");
		ElsIf Not ValueIsFilled(vCurrency) Then
			Raise NStr("en='Payment curency should be specified!';ru='Валюта платежа должна быть указана!';de='Die Zahlungswährung muss angegeben werden!'");
		ElsIf Not ValueIsFilled(vPaymentMethod) Then
			Raise NStr("en='Payment method should be choosen!';ru='Способ оплаты должен быть указан!';de='Zahlungsmethode muss definiert werden!'");
		EndIf;
		// Reset payment object
		vPaymentObj = Undefined;
		// Try to find payment document by external payment code
		If Not IsBlankString(vPaymentExternalCode) Then
			vQry = New Query();
			vQry.Text = 
			"SELECT
			|	Payments.Ref AS Ref,
			|	Payments.Date AS Date
			|FROM
			|	Document.Payment AS Payments
			|WHERE
			|	Payments.ExternalCode = &qExternalCode
			|
			|UNION ALL
			|
			|SELECT
			|	CustomerPayments.Ref,
			|	CustomerPayments.Date
			|FROM
			|	Document.CustomerPayment AS CustomerPayments
			|WHERE
			|	CustomerPayments.ExternalCode = &qExternalCode
			|
			|UNION ALL
			|
			|SELECT
			|	Returns.Ref,
			|	Returns.Date
			|FROM
			|	Document.Return AS Returns
			|WHERE
			|	Returns.ExternalCode = &qExternalCode
			|
			|ORDER BY
			|	Date";
			vQry.SetParameter("qExternalCode", TrimR(vPaymentExternalCode));
			vPayments = vQry.Execute().Unload();
			For Each vPaymentsRow In vPayments Do
				vWrkPaymentRef = vPaymentsRow.Ref;
				If vPayments.IndexOf(vPaymentsRow) > 0 Then
					If Not vWrkPaymentRef.DeletionMark Then
						vWrkPaymentObj = vWrkPaymentRef.GetObject();
						vWrkPaymentObj.SetDeletionMark(True);
					EndIf;
				Else
					If Not ValueIsFilled(vGuestGroup) And TypeOf(vWrkPaymentRef) <> Type("DocumentRef.CustomerPayment") Or 
					   ValueIsFilled(vGuestGroup) And TypeOf(vWrkPaymentRef) = Type("DocumentRef.CustomerPayment") Then
						If Not vWrkPaymentRef.DeletionMark Then
							vWrkPaymentObj = vWrkPaymentRef.GetObject();
							vWrkPaymentObj.SetDeletionMark(True);
						EndIf;
					Else
						vPaymentObj = vWrkPaymentRef.GetObject();
						If vPaymentObj.DeletionMark Then
							vPaymentObj.SetDeletionMark(False);
						EndIf;
					EndIf;
				EndIf;
			EndDo;
		EndIf;
		// Find guest group folio to write payment to
		vUseCustomerPayment = True;
		If ValueIsFilled(vGuestGroup) Or ValueIsFilled(vFolio) Then
			// Fill hotel from guest group  
			If ValueIsFilled(vGuestGroup) Then
				vHotel = vGuestGroup.Owner;      
			EndIf;
			// Run query to get folios to charge to
			vFirstGroupFolio = Undefined;
			If Not ValueIsFilled(vFolio) Then
				vQry = New Query();
				vQry.Text = 
				"SELECT
				|	Folio.Ref AS Ref,
				|	Folio.ParentDoc AS ParentDoc
				|FROM
				|	Document.Folio AS Folio
				|WHERE
				|	NOT Folio.DeletionMark
				|	AND NOT Folio.IsClosed
				|	AND Folio.Hotel = &qHotel
				|	AND (Folio.ParentDoc = &qParentDoc
				|			OR &qParentDocIsEmpty)
				|	AND Folio.GuestGroup = &qGuestGroup
				|	AND (Folio.Client = &qClient
				|			OR &qClientIsEmpty)
				|	AND (Folio.Customer In (&qCustomer)
				|			OR &qCustomerIsEmpty)
				|	AND (Folio.Company = &qCompany
				|			OR &qCompanyIsEmpty)
				|
				|ORDER BY
				|	Folio.IsClosed,
				|	Folio.PointInTime";
				vCustomerList = New Array;
				If ValueIsFilled(vCustomer) Then
					vCustomerList.Add(vCustomer);
					If vCustomer = vHotel.IndividualsCustomer Then
						vCustomerList.Add(Catalogs.Customers.EmptyRef());
					EndIf;	
				EndIf;	
				vQry.SetParameter("qHotel", vHotel);
				vQry.SetParameter("qParentDoc", vDocRef);
				vQry.SetParameter("qParentDocIsEmpty", Not ValueIsFilled(vDocRef));
				vQry.SetParameter("qGuestGroup", vGuestGroup);
				vQry.SetParameter("qClient", vClient);
				vQry.SetParameter("qClientIsEmpty", Not ValueIsFilled(vClient));
				vQry.SetParameter("qCustomer", vCustomer);
				vQry.SetParameter("qCustomerIsEmpty", vCustomerList.Count() = 0);
				vQry.SetParameter("qCompany", vCompany);
				vQry.SetParameter("qCompanyIsEmpty", Not ValueIsFilled(vCompany));
				WriteLogEvent(vFuncLogName, EventLogLevel.Information, vGuestGroup.Metadata(), vGuestGroup, 
							  NStr("en='Folios search:';ru='Поиск лицевых счетов:';de='Suche nach Personenkonten:'") + Chars.LF + 
							  "qHotel: " + vHotel + Chars.LF +
							  "qGuestGroup: " + vGuestGroup + Chars.LF +
							  "qParentDoc: " + vDocRef + Chars.LF +
							  "qParentDocIsEmpty: " + (Not ValueIsFilled(vDocRef)) + Chars.LF +
							  "qClient: " + vClient + ?(ValueIsFilled(vClient), " (" + TrimAll(vClient.Code) + ")", "") + Chars.LF +
							  "qClientIsEmpty: " + (Not ValueIsFilled(vClient)) + Chars.LF +
							  "qCustomer: " + vCustomer + ?(ValueIsFilled(vCustomer), " (" + TrimAll(vCustomer.Code) + ")", "") + Chars.LF +
							  "qCustomerIsEmpty: " + (Not ValueIsFilled(vCustomer)) + Chars.LF +
							  "qCompany: " + vCompany + ?(ValueIsFilled(vCompany), " (" + TrimAll(vCompany.Code) + ")", "") + Chars.LF +
							  "qCompanyIsEmpty: " + (Not ValueIsFilled(vCompany)));
				vFolios = vQry.Execute().Unload();
				// Find folio with room revenue services
				For Each vFoliosRow In vFolios Do
					vFirstGroupFolio = vFoliosRow.Ref;
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, vFoliosRow.Ref.Metadata(), vFoliosRow.Ref, 
								  NStr("en='Checking folio...';ru='Проверяем лицевой счет...';de='Wir überprüfen das Personenkonto...'"));
					If ValueIsFilled(vFoliosRow.ParentDoc) Then
						If TypeOf(vFoliosRow.ParentDoc) = Type("DocumentRef.Accommodation") Or
						   TypeOf(vFoliosRow.ParentDoc) = Type("DocumentRef.Reservation") Then
							If vFoliosRow.ParentDoc.Services.Count() > 0 Then
								vRoomRevenueServices = vFoliosRow.ParentDoc.Services.FindRows(New Structure("IsRoomRevenue", True));
								If vRoomRevenueServices.Count() > 0 Then
									vFolio = vRoomRevenueServices.Get(0).Folio;
									Break;
								EndIf;
							EndIf;
						EndIf;
					EndIf;
				EndDo;
			EndIf;
			// Get folio from group charging rules
			If Not ValueIsFilled(vFolio) Then
				If vGuestGroup.ChargingRules.Count() > 0 Then
					vGGCRRow = vGuestGroup.ChargingRules.Get(0);
					If ValueIsFilled(vGGCRRow.ChargingFolio) And Not vGGCRRow.ChargingFolio.IsClosed Then
						vFolio = vGGCRRow.ChargingFolio;
					EndIf;
				EndIf;
			EndIf;
			If Not ValueIsFilled(vFolio) And ValueIsFilled(vFirstGroupFolio) Then
				vFolio = vFirstGroupFolio;
			EndIf;
			If vStatusWasRestore And Not ValueIsFilled(vFolio) Then
				// Create new folio for this payment
				vClientDoc = vGuestGroup.ClientDoc;
				vFolioObj = Documents.Folio.CreateDocument();
				vFolioObj.pmFillAttributesWithDefaultValues();
				vFolioObj.ParentDoc = vClientDoc;
				vFolioObj.Company = vClientDoc.Company;
				vFolioObj.Hotel = vHotel;
				vFolioObj.FolioCurrency = vHotel.FolioCurrency;
				vFolioObj.Customer = vClientDoc.Customer;
				vFolioObj.GuestGroup = vGuestGroup;
				If TypeOf(vClientDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vClientDoc) = Type("DocumentRef.Reservation") Then
					vFolioObj.Client = vClientDoc.Guest;
					vFolioObj.DateTimeFrom = vClientDoc.CheckInDate;
					vFolioObj.DateTimeTo = vClientDoc.CheckOutDate;
				ElsIf TypeOf(vClientDoc) = Type("DocumentRef.ResourceReservation") Then
					vFolioObj.Client = vClientDoc.Client;
					vFolioObj.DateTimeFrom = vClientDoc.DateTimeFrom;
					vFolioObj.DateTimeTo = vClientDoc.DateTimeTo;
				EndIf;
				vFolioObj.Write(DocumentWriteMode.Write);
				vFolio = vFolioObj.Ref;
			ElsIf Not ValueIsFilled(vFolio) And ValueIsFilled(vGuestGroup) Then	 
				vClientDoc = vGuestGroup.ClientDoc;
				vFolioObj = Documents.Folio.CreateDocument();
				vFolioObj.pmFillAttributesWithDefaultValues();
				vFolioObj.ParentDoc = vClientDoc;
				vFolioObj.Company = vClientDoc.Company;
				vFolioObj.Hotel = vHotel;
				vFolioObj.FolioCurrency = vHotel.FolioCurrency;
				vFolioObj.Customer = vClientDoc.Customer;
				vFolioObj.GuestGroup = vGuestGroup;
				If TypeOf(vClientDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vClientDoc) = Type("DocumentRef.Reservation") Then
					vFolioObj.Client = ?(ValueIsFilled(vClient), vClient, vClientDoc.Guest);
					vFolioObj.DateTimeFrom = vClientDoc.CheckInDate;
					vFolioObj.DateTimeTo = vClientDoc.CheckOutDate;
				ElsIf TypeOf(vClientDoc) = Type("DocumentRef.ResourceReservation") Then
					vFolioObj.Client = ?(ValueIsFilled(vClient), vClient, vClientDoc.Client);
					vFolioObj.DateTimeFrom = vClientDoc.DateTimeFrom;
					vFolioObj.DateTimeTo = vClientDoc.DateTimeTo;
				EndIf;
				vFolioObj.Write(DocumentWriteMode.Write);
				vFolio = vFolioObj.Ref;  
			EndIf;	
			If ValueIsFilled(vFolio) Then
				vUseCustomerPayment = False;
				WriteLogEvent(vFuncLogName, EventLogLevel.Information, vFolio.Metadata(), vFolio, 
							  NStr("en='Folio is choosen...';ru='Назначен лицевой счет...';de='Personenkonto wurde festgelegt…'"));
				// Create payment for the folio being found  
				If vPaymentObj = Undefined Then
					vPaymentObj = Documents.Payment.CreateDocument();   
				Else	            
					vPaymentObj.AccountingContract = Undefined;
					vPaymentObj.AccountingCustomer = Undefined;
					vPaymentObj.Payer = Undefined;
				EndIf;	            
				
				vPaymentObj.Hotel = vHotel;
				vPaymentObj.Fill(vFolio);     
				If Not ValueIsFilled(vPaymentObj.Ref) Then
					If pExternalPaymentData <> Undefined And pExternalPaymentData.Date <> Undefined Then
						vPaymentObj.AccountingDate = pExternalPaymentData.Date;
						vPaymentObj.Date = CurrentSessionDate(); 
					ElsIf pPaymentDate <> Undefined Then
						If BegOfDay(pPaymentDate) < BegOfDay(CurrentSessionDate()) Then
							vPaymentObj.AccountingDate = pPaymentDate;
							vPaymentObj.Date = CurrentSessionDate(); 
						Else
							vPaymentObj.Date = pPaymentDate;
						EndIf;
					Else 
						vPaymentObj.Date = CurrentSessionDate(); 
					EndIf;
				EndIf;
				vPaymentObj.MerchantID = MerchantID;
				If ValueIsFilled(vCompany) Then
					vPaymentObj.Company = vCompany;
				EndIf;
				vPaymentObj.PaymentCurrency = vCurrency;
				vPaymentObj.PaymentMethod = vPaymentMethod;
				If Not IsBlankString(pPayerName) Then
					vPaymentObj.Remarks = pPayerName;
				EndIf;

				// Invoice
				If ValueIsFilled(vInvoiceRef) Then
					vPaymentObj.Invoice = vInvoiceRef;
				Else
					vInvoices = vFolio.GuestGroup.GetObject().pmGetInvoices(vFolio.Customer, vFolio.Contract);
					For Each vInvoicesRow In vInvoices Do
						If pSum > 0 And vInvoicesRow.Balance > 0 Then
							vPaymentObj.Invoice = vInvoices.Get(0).Invoice;
							Break;
						ElsIf pSum < 0 And vInvoicesRow.Balance = 0 Then
							vPaymentObj.Invoice = vInvoices.Get(0).Invoice;
							Break;
						EndIf;
					EndDo;
				EndIf;
				
				// Payment sections
				If ValueIsFilled(vPaymentSection) And Not vHotel.UsePrepaymentsIfPossible And 
				   (Not ValueIsFilled(vPaymentObj.PaymentSection) Or vPaymentObj.PaymentSection = vPaymentSection) And 
				   (vPaymentSection = vHotel.PaymentSectionForAdvance Or vPaymentSection.ChequeItemType = Enums.ChequeItemTypes.Payment) Then
					vPaymentObj.PaymentSections.Clear();
					vPaymentObj.PaymentSection = vPaymentSection;
					If ValueIsFilled(vPaymentSection.VATRate) Then
						vPaymentObj.VATRate = vPaymentSection.VATRate;
					EndIf;
					vPaymentObj.Sum = pSum;
					vPaymentObj.pmRecalculateSums();
				ElsIf pSum <> vPaymentObj.PaymentSections.Total("Sum") Then
					If ValueIsFilled(vHotel) And vHotel.SplitFolioBalanceByPaymentSections Then
						If vPaymentObj.PaymentSections.Count() = 0 Then
							TInvoicePS = GetInvoiceSections(vPaymentObj.Invoice);
							If TInvoicePS.Count() > 0 Then
								vInt = 0;
