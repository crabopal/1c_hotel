Function GetInvoiceSections(pInvoice)
	If Not ValueIsFilled(pInvoice) Then
		TInvoices = New ValueTable;
		TInvoices.Columns.Add("PaymentSection", cmGetCatalogTypeDescription("PaymentSections"));
		TInvoices.Columns.Add("Sum", cmGetSumTypeDescription());
		Return TInvoices;
	EndIf;
	vQ = New Query("SELECT
	               |	InvoiceServices.Service.PaymentSection AS PaymentSection,
	               |	SUM(InvoiceServices.Sum) AS Sum
	               |FROM
	               |	Document.ProformaInvoice.Services AS InvoiceServices
	               |WHERE
	               |	InvoiceServices.Ref = &qInvoice
				   |GROUP BY
				   |	InvoiceServices.Service.PaymentSection");
	vQ.SetParameter("qInvoice", pInvoice);
	TInvoices = vQ.Execute().Unload();
	TInvoices.Sort("Sum DESC");
	Return TInvoices;
EndFunction // GetInvoiceSections

// -----------------------------------------------------------------------------
Function GetInvoiceChequeServices(pInvoice)
	If Not ValueIsFilled(pInvoice) Then
		TInvoices = New ValueTable;
		TInvoices.Columns.Add("PaymentSection", cmGetCatalogTypeDescription("PaymentSections"));
		TInvoices.Columns.Add("ChequeService", cmGetCatalogTypeDescription("Services"));
		TInvoices.Columns.Add("ChequeServicePrice", cmGetSumTypeDescription());
		TInvoices.Columns.Add("ChequeServiceQuantity", cmGetQuantityTypeDescription());
		TInvoices.Columns.Add("Sum", cmGetSumTypeDescription());
		Return TInvoices;
	EndIf;
	vQ = New Query("SELECT
	               |	InvoiceServices.Service.PaymentSection AS PaymentSection,
	               |	InvoiceServices.Service AS ChequeService,
	               |	InvoiceServices.Price AS ChequeServicePrice,
	               |	SUM(InvoiceServices.Quantity) AS ChequeServiceQuantity,
	               |	SUM(InvoiceServices.Sum) AS Sum
	               |FROM
	               |	Document.ProformaInvoice.Services AS InvoiceServices
	               |WHERE
	               |	InvoiceServices.Ref = &qInvoice
				   |GROUP BY
	               |	InvoiceServices.Service.PaymentSection,
	               |	InvoiceServices.Service,
	               |	InvoiceServices.Price");
	vQ.SetParameter("qInvoice", pInvoice);
	TInvoices = vQ.Execute().Unload();
	TInvoices.Sort("Sum DESC");
	Return TInvoices;	
EndFunction // GetInvoiceChequeServices

