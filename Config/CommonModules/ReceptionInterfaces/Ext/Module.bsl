Function GetPaymentCashRegister(pCompany, pPaymentMethod, pHotel = Undefined)
	vCashRegister = Catalogs.CashRegisters.EmptyRef();
	vList = New ValueList();
	If cmCheckUserPermissions("HavePermissionToViewAllCashRegisters") Then
		vList = cmGetListOfAllCashRegisters(pCompany);
	Else
		vList = cmGetListOfCashRegistersAllowed(pCompany, SessionParameters.CurrentWorkstation, pPaymentMethod);
	EndIf;
	If ValueIsFilled(pPaymentMethod) Then
		If pPaymentMethod.BookByCashRegister Then
			For Each vListItem In vList Do
				If ValueIsFilled(vListItem.Value) Then
					If Not ValueIsFilled(pHotel) Then
						vCashRegister = vListItem.Value;
						Break;
					Else
						wCashRegister = vListItem.Value;
						If Not ValueIsFilled(wCashRegister.Hotel) Or wCashRegister.Hotel = pHotel Then
							vCashRegister = wCashRegister;
							Break;
						EndIf;
					EndIf;
				EndIf;
			EndDo;
		EndIf;
	EndIf;
	Return vCashRegister;
EndFunction // GetPaymentCashRegister

