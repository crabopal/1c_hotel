Procedure FillGuestGroupClientExternalGroupReservationStatus(pInteraction, Val vGroupRef, vRetXDTO)
	If ValueIsFilled(vGroupRef.Client) Then
		vRetXDTO.GuestCode = TrimAll(vGroupRef.Client.Code);
		
		If ValueIsFilled(pInteraction) And pInteraction.HideGuestsPersonalData Then
			vRetXDTO.GuestFullName = TrimAll(StrTemplate("%1 %2", vGroupRef.Client.FirstName, vGroupRef.Client.SecondName));
			vRetXDTO.GuestBirthDate = '00010101';
			vRetXDTO.GuestPassport = "";
			vRetXDTO.GuestFax = "";
		Else
			vRetXDTO.GuestFullName = TrimR(vGroupRef.Client.FullName);
			If ValueIsFilled(vGroupRef.Client.DateOfBirth) Then
				vRetXDTO.GuestBirthDate = vGroupRef.Client.DateOfBirth;
			Else
				vRetXDTO.GuestBirthDate = '00010101';
			EndIf;
			vRetXDTO.GuestPassport = TrimR(TrimR(vGroupRef.Client.IdentityDocumentSeries) + " " + TrimR(vGroupRef.Client.IdentityDocumentNumber));
			If ValueIsFilled(vGroupRef.ClientDoc) And 
				TypeOf(vGroupRef.ClientDoc) <> Type("DocumentRef.Folio") And 
				Not IsBlankString(vGroupRef.ClientDoc.Fax) Then
				vRetXDTO.GuestFax = TrimR(vGroupRef.ClientDoc.Fax);
			Else
				vRetXDTO.GuestFax = TrimR(vGroupRef.Client.Fax);
			EndIf;
		EndIf;
		If ValueIsFilled(vGroupRef.ClientDoc) And 
			TypeOf(vGroupRef.ClientDoc) <> Type("DocumentRef.Folio") And 
			Not IsBlankString(vGroupRef.ClientDoc.Phone) Then
			vRetXDTO.GuestPhone = TrimR(vGroupRef.ClientDoc.Phone);
		Else
			vRetXDTO.GuestPhone = TrimR(vGroupRef.Client.Phone);
		EndIf;
		If ValueIsFilled(vGroupRef.ClientDoc) And 
			TypeOf(vGroupRef.ClientDoc) <> Type("DocumentRef.Folio") And 
			Not IsBlankString(vGroupRef.ClientDoc.EMail) Then
			vRetXDTO.GuestEMail = TrimR(vGroupRef.ClientDoc.EMail);
		Else
			vRetXDTO.GuestEMail = TrimR(vGroupRef.Client.EMail);
		EndIf;
	Else
		vRetXDTO.GuestCode = "";
		vRetXDTO.GuestFullName = "";
		vRetXDTO.GuestBirthDate = '00010101';
		vRetXDTO.GuestPassport = "";
		vRetXDTO.GuestPhone = "";
		vRetXDTO.GuestFax = "";
		vRetXDTO.GuestEMail = "";
	EndIf;
EndProcedure // FillGuestGroupClientExternalGroupReservationStatus

