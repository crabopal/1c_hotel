	vBalances.Columns.Add("MinPrice", cmGetNumberTypeDescription(17, 2));
	vBalances.Columns.Add("MinPriceCurrency", cmGetCatalogTypeDescription("Currencies"));

	// Build return string
	vRetStr = "";
	vSingleTemplate = Undefined;
	vDoubleTemplate = Undefined;
	vTripleTemplate = Undefined;
	vQuadleTemplate = Undefined;
	vBeds5Template = Undefined;
	vBeds6Template = Undefined;
	vBeds7Template = Undefined;
	vBeds8Template = Undefined;
	vCurRoomType = Undefined;
	vPrevRow	= Undefined;
	For Each vRow In vBalances Do
		If vRow.Period = Null Then
			Continue;
		EndIf;
		If BegOfDay(vRow.Period) < BegOfDay(pPeriodFrom) Then
			Continue;
		EndIf;
		vRow.Period = EndOfDay(vRow.Period);
		vRow.ExtHotelCode = "";
		If vPrevRow <> Undefined And vPrevRow.Hotel = vRow.Hotel Then
			vRow.ExtHotelCode = vPrevRow.ExtHotelCode;	
		Else
			If ValueIsFilled(vRow.Hotel) Then
				vRow.ExtHotelCode = GetObjectExternalSystemCodeByRef(vCodesCash, Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vRow.Hotel);
			EndIf;
		EndIf;
		
		vRow.ExtRoomTypeCode = "";
		If vPrevRow <> Undefined And vPrevRow.Hotel = vRow.Hotel And vPrevRow.RoomType = vRow.RoomType Then
			vRow.ExtRoomTypeCode = vPrevRow.ExtRoomTypeCode;	
		Else
			If ValueIsFilled(vRow.RoomType) Then
				vRow.ExtRoomTypeCode = GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "RoomTypes", vRow.RoomType);
			EndIf;
		EndIf;

		// Get prices
		vAccommodationTypePrices.Clear();
		If ValueIsFilled(vRoomRate) And vCalcMinPrice = False Then
			vRow.Single = vSingle;
			vRow.Double = vDouble;
			vRow.Triple = vTriple;
			vRow.Quadle = vQuadle;
			vRow.Beds5 = vBeds5;
			vRow.Beds6 = vBeds6;
			vRow.Beds7 = vBeds7;
			vRow.Beds8 = vBeds8;
			vRow.ExtraBed = vExtraBed;
			vRow.Baby = vBaby;
			vRow.Child = vChild;
			vRow.Teen = vTeen;
			vRow.ExtraBaby = vExtraBaby;
			vRow.ExtraChild = vExtraChild;
			vRow.ExtraTeen = vExtraTeen;
			
			// Get templates
			If vCurRoomType <> vRow.RoomType Then
				vCurRoomType = vRow.RoomType;
				vSingleTemplate = cmGetAccommodationTemplate(vRow.RoomType, 1);
				vDoubleTemplate = cmGetAccommodationTemplate(vRow.RoomType, 2);
				vTripleTemplate = cmGetAccommodationTemplate(vRow.RoomType, 3);
				vQuadleTemplate = cmGetAccommodationTemplate(vRow.RoomType, 4);
				vBeds5Template = cmGetAccommodationTemplate(vRow.RoomType, 5);
				vBeds6Template = cmGetAccommodationTemplate(vRow.RoomType, 6);
				vBeds7Template = cmGetAccommodationTemplate(vRow.RoomType, 7);
				vBeds8Template = cmGetAccommodationTemplate(vRow.RoomType, 8);
			EndIf;
			
			vRow.SingleTemplate = vSingleTemplate;
			vRow.DoubleTemplate = vDoubleTemplate;
			vRow.TripleTemplate = vTripleTemplate;
			vRow.QuadleTemplate = vQuadleTemplate;
			vRow.Beds5Template = vBeds5Template;
			vRow.Beds6Template = vBeds6Template;
			vRow.Beds7Template = vBeds7Template;
			vRow.Beds8Template = vBeds8Template;
			
			GetDayPrices(vRow.Period, vPrices, vPriceTags, vRoomRate, vRow.RoomType, 
			             vRow.Single, vSingleTemplate, vRow.Double, vDoubleTemplate, 
						 vRow.Triple, vTripleTemplate, vRow.Quadle, vQuadleTemplate, 
						 vRow.Beds5, vBeds5Template, vRow.Beds6, vBeds6Template, 
						 vRow.Beds7, vBeds7Template, vRow.Beds8, vBeds8Template, 
						 vRow.ExtraBed, vRow.Baby, vRow.Child, vRow.Teen, 
						 vRow.ExtraBaby, vRow.ExtraChild, vRow.ExtraTeen, 
			             vRow.SinglePrice, vRow.SinglePriceCurrency, 
			             vRow.DoublePrice, vRow.DoublePriceCurrency, 
			             vRow.TriplePrice, vRow.TriplePriceCurrency, 
			             vRow.QuadlePrice, vRow.QuadlePriceCurrency, 
			             vRow.Beds5Price, vRow.Beds5PriceCurrency, 
			             vRow.Beds6Price, vRow.Beds6PriceCurrency, 
			             vRow.Beds7Price, vRow.Beds7PriceCurrency, 
			             vRow.Beds8Price, vRow.Beds8PriceCurrency, 
			             vRow.ExtraBedPrice, vRow.ExtraBedPriceCurrency, 
			             vRow.BabyPrice, vRow.BabyPriceCurrency, 
			             vRow.ChildPrice, vRow.ChildPriceCurrency, 
			             vRow.TeenPrice, vRow.TeenPriceCurrency, 
			             vRow.ExtraBabyPrice, vRow.ExtraBabyPriceCurrency, 
			             vRow.ExtraChildPrice, vRow.ExtraChildPriceCurrency, 
			             vRow.ExtraTeenPrice, vRow.ExtraTeenPriceCurrency, 
						 vAccTypes, vAccommodationTypePrices);
			vRow.AccommodationTypePrices = vAccommodationTypePrices.Copy(); 
		ElsIf vCalcMinPrice Then
			// Get calendar day type
			vCalendarDayType = cmGetCalendarDayType(vMinPriceRate, BegOfDay(vRow.Period), Undefined, Undefined, , vMinPriceRoomType);	
			vFilterRows = vPrices.FindRows(New Structure("Period, CalendarDayType", BegOfDay(vRow.Period), vCalendarDayType));
			If vFilterRows.Count() > 0 Then
				vRow.MinPrice = vFilterRows[0].Price;	
				vRow.MinPriceCurrency = vFilterRows[0].Currency;
			EndIf;	 
			vRow.AccommodationTypePrices = vAccommodationTypePrices.Copy()
		EndIf;
		// Build return string
		If pOutputType = "CSV" Then
			vRetStr = vRetStr + """" + vRow.ExtHotelCode + """" + "," + """" + TrimR(vRow.Hotel.Code) + """" + "," + """" + vRow.ExtRoomTypeCode + """" + "," + """" + TrimR(vRow.RoomType.Code) + """" + "," + 
			          """" + Format(vRow.Period, "DF=yyyy-MM-dd") + """" + "," + 
			          ?(pOutputRoomsVacant, Format(vRow.RoomsVacant, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
			          ?(pOutputBedsVacant, Format(vRow.BedsVacant, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
			          ?(pOutputRoomsInQuota, Format(vRow.RoomsInQuota, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputBedsInQuota, Format(vRow.BedsInQuota, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputRoomsChargedInQuota, Format(vRow.RoomsChargedInQuota, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputBedsChargedInQuota, Format(vRow.BedsChargedInQuota, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
			          ?(pOutputRoomsReserved, Format(vRow.RoomsReserved, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputBedsReserved, Format(vRow.BedsReserved, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputInHouseRooms, Format(vRow.InHouseRooms, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputInHouseBeds, Format(vRow.InHouseBeds, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
			          ?(pOutputRoomsRemains, Format(vRow.RoomsRemains, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(pOutputBedsRemains, Format(vRow.BedsRemains, "ND=10; NFD=0; NZ=; NG=; NN="), "") + "," + 
					  ?(ValueIsFilled(vRow.Single), Format(vRow.SinglePrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Single), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.SinglePriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Double), Format(vRow.DoublePrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Double), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.DoublePriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Triple), Format(vRow.TriplePrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Triple), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.TriplePriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Quadle), Format(vRow.QuadlePrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Quadle), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.QuadlePriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Beds5), Format(vRow.Beds5Price, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Beds5), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.Beds5PriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Beds6), Format(vRow.Beds6Price, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Beds6), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.Beds6PriceCurrency) + """", """" + """") + "," + 
