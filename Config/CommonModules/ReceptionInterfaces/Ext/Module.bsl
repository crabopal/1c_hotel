Procedure CheckAndRestoreStatus(pGuestGroup, pStatusWasRestore)       
	Try
		If ValueIsFilled(pGuestGroup) And ValueIsFilled(pGuestGroup.Status) And Not pGuestGroup.Status.IsActive Then
			If ValueIsFilled(pGuestGroup.Owner) And ValueIsFilled(pGuestGroup.Owner.CanceledButPaidReservationStatus) Then
				vClientDoc = pGuestGroup.ClientDoc;
				If ValueIsFilled(vClientDoc) And TypeOf(vClientDoc) = Type("DocumentRef.Reservation") And Not vClientDoc.ReservationStatus.IsActive Then
					vResList = pGuestGroup.GetObject().pmGetReservations(, , True);
					For Each vRowRes In vResList Do
						vClientDoc = vRowRes.Reservation;
						vClientDocObj = vClientDoc.GetObject();
						vPrevResStates = vClientDocObj.pmGetReservationHistoryState(CurrentSessionDate());
						If vPrevResStates.Count() > 0 Then
							vPrevResStatesRow = vPrevResStates.Get(0);
							vPrevResData = vClientDocObj.pmGetReservationHistoryState(New Boundary(vPrevResStatesRow.Period, BoundaryType.Excluding));
							If vPrevResData.Count() > 0 Then
								vPrevResStatesRow = vPrevResData.Get(0);
								If vPrevResStatesRow.ReservationStatus <> vClientDoc.ReservationStatus And vPrevResStatesRow.ReservationStatus.IsActive Then
									// Check room inventory
									vHasErorrs = False;
									vRoomsVacant = 0;
									vBedsVacant = 0;
									vVacantRooms = cmGetVacantRoomsByPeriodsForReservation(vClientDoc.Hotel, vClientDoc.RoomType, vClientDoc.Room, vClientDoc.RoomQuota, vClientDoc.CheckInDate, vClientDoc.CheckOutDate);
									For Each vQryTabRow In vVacantRooms Do
										vRoomsVacant = vQryTabRow.RoomsVacant;
										vBedsVacant = vQryTabRow.BedsVacant;
										Break;
									EndDo;
									pNumberOfRooms = vClientDoc.NumberOfRooms;
									pNumberOfBeds = vClientDoc.NumberOfBeds;
									vNotEnoughRooms = pNumberOfRooms - vRoomsVacant;
									vNotEnoughBeds = pNumberOfBeds - vBedsVacant;
									If pNumberOfRooms > 0 Then 
										If vNotEnoughRooms > 0 Then
											vHasErorrs = True;
										ElsIf vNotEnoughBeds > 0 Then
											vHasErorrs = True;
										EndIf;
									ElsIf pNumberOfBeds > 0 Then
										If vNotEnoughBeds > 0 Then
											vHasErorrs = True;
										EndIf;
									EndIf;	
									If vHasErorrs Then
										vClientDocObj.ReservationStatus = pGuestGroup.Owner.CanceledButPaidReservationStatus;
										vClientDocObj.Write(DocumentWriteMode.Posting);
										vClientDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
										pStatusWasRestore = True;
									Else
										vClientDocObj.ReservationStatus = vPrevResStatesRow.ReservationStatus;
										vClientDocObj.Write(DocumentWriteMode.Posting);
										vClientDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
										pStatusWasRestore = True;
									EndIf;	
								Else
									vClientDocObj.ReservationStatus = pGuestGroup.Owner.CanceledButPaidReservationStatus;
									vClientDocObj.Write(DocumentWriteMode.Posting);
									vClientDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
									pStatusWasRestore = True;
								EndIf;
							Else
								vClientDocObj.ReservationStatus = pGuestGroup.Owner.CanceledButPaidReservationStatus;
								vClientDocObj.Write(DocumentWriteMode.Posting);
								vClientDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
								pStatusWasRestore = True;
							EndIf;
						Else
							vClientDocObj.ReservationStatus = pGuestGroup.Owner.CanceledButPaidReservationStatus;
							vClientDocObj.Write(DocumentWriteMode.Posting);
							vClientDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
							pStatusWasRestore = True;
						EndIf;
					EndDo;
				EndIf;
			EndIf;
		EndIf;     
	Except
		vMsg = NStr("en = 'Error checking whether the reservation can be rolled back to its previous status: %1'; 
					|de = 'Fehler bei der Überprüfung, ob die Reservierung auf den vorherigen Status zurückgesetzt werden kann: %1'; 
					|ru = 'Ошибка проверки возможности отката брони в предыдущий статус: %1'");
		// Log success		
		WriteLogEvent("cmWriteExternalPayment.CheckAndRestoreStatus", EventLogLevel.Error, , , StrTemplate(vMsg, ErrorDescription()));
	EndTry;
EndProcedure // CheckAndRestoreStatus

