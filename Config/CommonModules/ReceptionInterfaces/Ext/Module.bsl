									vAmountBeforeDiscount = vAmountBeforeDiscount + ?(vRoomTypeBalancesRow.AmountBeforeDiscount = Undefined, 0, vRoomTypeBalancesRow.AmountBeforeDiscount);
									vAmount = vAmount + ?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount);
									vFirstDaySum = vFirstDaySum + ?(vRoomTypeBalancesRow.FirstDaySum = Undefined, 0, vRoomTypeBalancesRow.FirstDaySum);
									If ((vRoomTypeBalances.IndexOf(vRoomTypeBalancesRow)+1) = vRoomTypeBalances.Count()) 
										Or vRoomTypeBalances[vRoomTypeBalances.IndexOf(vRoomTypeBalancesRow)+1].RoomType <> vRoomTypeBalancesRow.RoomType Then
										vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesByCheckInPeriodsRow"));
										vRetRow.Hotel = vRoomTypeBalancesRow.ExtHotelCode;
										vRetRow.RoomType = vRoomTypeBalancesRow.ExtRoomTypeCode;
										vRetRow.RoomTypeCode = vRoomTypeBalancesRow.RoomTypeCode;
										vRetRow.RoomTypeDescription = vRoomTypeBalancesRow.RoomTypeDescription;
										vRetRow.RoomTypePictureLink = vRoomTypeBalancesRow.RoomTypePictureLink;
										vRetRow.RoomTypeInfoLink = vRoomTypeBalancesRow.RoomTypeInfoLink;
										vRetRow.RoomRate = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "RoomRates", vRoomRate);
										vRetRow.RoomRateCode = ?(ValueIsFilled(vRoomRate), TrimAll(vRoomRate.Code), "");
										vRetRow.RoomRateDescription =  ?(ValueIsFilled(vRoomRate), TrimAll(vRoomRate.Description), "");
										vRetRow.Currency = vRoomTypeBalancesRow.ExtCurrencyCode;
										vRetRow.CurrencyCode = vRoomTypeBalancesRow.CurrencyCode;
										vRetRow.CurrencyDescription = vRoomTypeBalancesRow.CurrencyDescription;
										vRetRow.FirstDaySum = vFirstDaySum;
										vRetRow.AmountBeforeDiscount = Round(vAmountBeforeDiscount, 2); 
										If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
											vRetRow.Discount = vRoomRate.OnlineDiscount;
										Else
											vRetRow.Discount = vProbeResObj.Discount;	
										EndIf;
										vRetRow.Amount = Round(vAmount, 2);
										vRetRow.AmountPresentation = cmFormatSum(vAmount, vRoomTypeBalancesRow.Currency, "NZ=");
										vRetRow.LimitedRoomsText = vRoomTypeBalancesRow.LimitedRoomsText;
										vRetRow.RoomsRemains = vRoomTypeBalancesRow.RoomsAvailable;
										vRetRow.BedsRemains = vRoomTypeBalancesRow.BedsAvailable;
										vRetRow.Allotment = vAllotmentCode;
										vRetRow.AllotmentDescription = vAllotmentDescription;
										vRetRow.CheckInDate = vCheckInDate;
										vRetRow.Duration = vDuration;
										vRetRow.CheckOutDate = vCheckOutDate;
										If ValueIsFilled(vRoomRate) Then
											vRetRow.ReservationConditionsShort = Left(cmNStr(vRoomRate.ReservationConditionsShort, vLanguage), 4096);
											vRetRow.ReservationConditionsOnline = Left(cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage), 4096);
											vRetRow.PaymentMethodCodesAllowedOnline = Left(TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline), 4096);
										Else
											vRetRow.ReservationConditionsShort = "";
											vRetRow.ReservationConditionsOnline = "";
											vRetRow.PaymentMethodCodesAllowedOnline = "";
										EndIf;
										vRetRow.AccommodationTypesList = vRetAccTypesList;
										vRetRow.LastReservationDate = vRoomTypeBalancesRow.LastReservationDate;
										
										If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
											vAccommodationTypesByRoomTypes.Add(vCurRoomType);
											vRetRoomTypeRow.AccommodationTypesList = vRTRetAccTypesList;
											vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
										EndIf;
										
										vRetStr = vRetStr + """" + vRoomTypeBalancesRow.ExtHotelCode + """" + "," + """" + vRoomTypeBalancesRow.ExtRoomTypeCode + """" + "," + 
										"""" + TrimAll(vRoomTypeBalancesRow.AccommodationTemplate.Code) + """" + "," + 
										Format(vRoomTypeBalancesRow.RoomsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + Format(vRoomTypeBalancesRow.BedsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
										"""" + vRoomTypeBalancesRow.ExtCurrencyCode + """" + "," + Format(vRoomTypeBalancesRow.FirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + Format(vRoomTypeBalancesRow.Amount, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
										"""" + vRoomTypeBalancesRow.RoomTypeCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypeDescription) + """" + "," + 
										"""" + TrimAll(vCurAccommodationType.Code) + """" + "," + """" + cmRemoveComma(TrimAll(vCurAccommodationType.Description)) + """" + "," + 
										"""" + vRoomTypeBalancesRow.RoomRateCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomRateDescription) + """" + "," + 
										"""" + vRoomTypeBalancesRow.CurrencyCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.CurrencyDescription) + """" + "," + 
										"""" + cmRemoveComma(vRoomTypeBalancesRow.AmountPresentation) + """" + "," + 
										"""" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypePictureLink) + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypeInfoLink) + """" + Chars.LF;
										
										vAvailableRoomTypesByCheckInPeriodsRows.AvailableRoomTypesByCheckInPeriodsRow.Add(vRetRow);
										
										vAmountBeforeDiscount = 0;
										vAmount = 0;
										vFirstDaySum = 0;
									EndIf;
								EndDo;
							EndIf;
						EndIf;
						vRoomTypes.Clear();
						vCheckInHotel = ?(ValueIsFilled(vSameCheckOutDateRow.Hotel), vSameCheckOutDateRow.Hotel, vHotel);
						vCheckInDate = vSameCheckOutDateRow.CheckInDate;
						vCheckOutDate = vSameCheckOutDateRow.CheckOutDate;
						vCustomer = vSameCheckOutDateRow.Customer;
						vDuration = vSameCheckOutDateRow.Duration;
						vAllotmentDescription = TrimAll(String(vSameCheckOutDateRow.Allotment));
						vAllotmentCode = TrimAll(vSameCheckOutDateRow.Allotment.Code);
						vAgent = vSameCheckOutDateRow.Agent;
						vContract = vSameCheckOutDateRow.Contract;
						vLastQuota = vSameCheckOutDateRow.Allotment;
						vLastPeriodFrom = vSameCheckOutDateRow.CheckInDate;
						vLastPeriodTo = vSameCheckOutDateRow.CheckOutDate;
					EndIf;
					vRoomsAvailable = vSameCheckOutDateRow.RoomsRemains;
					vBedsAvailable = vSameCheckOutDateRow.BedsRemains;
					If vRoomTypes.Find(vSameCheckOutDateRow.RoomType, "RoomType") = Undefined Then
						vNewRow = vRoomTypes.Add();
						vNewRow.RoomType = vSameCheckOutDateRow.RoomType;
						vNewRow.RoomsAvailable = vRoomsAvailable;
						vNewRow.BedsAvailable = vBedsAvailable;
					EndIf;
				EndDo; //By check-in periods
				If vLastPeriodFrom <> Undefined And vLastPeriodTo <> Undefined And vLastQuota <> Undefined Then
					If Not ValueIsFilled(vRoomRate.Allotment) Or ValueIsFilled(vRoomRate.Allotment) And (vRoomRate.Allotment.IsFolder And vLastQuota.BelongsToItem(vRoomRate.Allotment) Or (Not vRoomRate.Allotment.IsFolder) And vLastQuota = vRoomRate.Allotment) Then
						// Get room types balances table
						vRoomTypeBalances = cmGetRoomTypeBalancesTable(vRoomTypes, True, vCheckInHotel, vCheckInDate, vCheckOutDate, vClientType, vCustomer, vContract, vDiscountType, vExtHotelCode, vLanguage, pExternalSystemCode, , vRoomRate,, vAdultsQuantity, vKidsQuantity, vAgeArray, vProbeResObj, , , , vReservationRef);
						vCurRoomType = Undefined;
						vAmountBeforeDiscount = 0;
						vAmount = 0;
						vFirstDaySum = 0;
						For Each vRoomTypeBalancesRow In vRoomTypeBalances Do
							If vCurRoomType <> vRoomTypeBalancesRow.RoomType Then
								vRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
								vRTRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
								vCurRoomType = vRoomTypeBalancesRow.RoomType;
								
								// Stop sale
								If vCurRoomType.StopSale Then
									vRemarks = "";
									If cmIsStopInternetSalePeriod(vCurRoomType, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate), vRemarks) Then
										vCurRoomType = Undefined;
										Continue;
									EndIf;
								EndIf;
								
								// Check room rate restrictions
								If Not cmCheckRoomRateRestrictions(vHotel, vRoomRate, vCurRoomType, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate), cmCalculateDuration(vRoomRate, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate))) Then
									vCurRoomType = Undefined;
									Continue;
								EndIf;
								
								vRetRoomTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomType"));
								vRetRoomTypeRow.Code = TrimR(vCurRoomType.Code);
								vRetRoomTypeRow.Description = TrimR(vCurRoomType.Description);
							EndIf;
							
							vCurAccommodationType = vRoomTypeBalancesRow.AccommodationType;
							
							vRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
							vRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
							vRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
							vRetAccTypeRow.Age = vRoomTypeBalancesRow.Age;
							vRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
							vRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
							
							vAccTypeCurrency = vRoomTypeBalancesRow.Currency;
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vRetAccTypeRow.AmountBeforeDiscount = Round(?(vRoomTypeBalancesRow.Amount = Undefined, 0, (vRoomTypeBalancesRow.Amount * 100)/(100 - vRoomRate.OnlineDiscount)), 2);
								vRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
							Else
								vRetAccTypeRow.AmountBeforeDiscount = ?(vRoomTypeBalancesRow.AmountBeforeDiscount = Undefined, 0, vRoomTypeBalancesRow.AmountBeforeDiscount);
								vRetAccTypeRow.Discount = vProbeResObj.Discount;   
							EndIf;
							vRetAccTypeRow.Amount = ?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount);
							vRetAccTypeRow.AmountPresentation = cmFormatSum(?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount), vAccTypeCurrency, "NZ=");
							vRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
							If IsBlankString(vRetAccTypeRow.Currency) Then
								vRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
							EndIf;
							If ValueIsFilled(vAccTypeCurrency) Then
								vRetAccTypeRow.CurrencyCode = TrimAll(vAccTypeCurrency.Code);
								vRetAccTypeRow.CurrencyDescription = TrimAll(vAccTypeCurrency.Description);
							Else
								vRetAccTypeRow.CurrencyCode = "";
								vRetAccTypeRow.CurrencyDescription = "";
							EndIf;            	
							
							vRetAccTypesList.AccommodationType.Add(vRetAccTypeRow);
							
							vRTRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
							vRTRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
							vRTRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
							vRTRetAccTypeRow.Age = vRoomTypeBalancesRow.Age;
							vRTRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
							vRTRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
							
							vAccTypeCurrency = vRoomTypeBalancesRow.Currency;
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vRTRetAccTypeRow.AmountBeforeDiscount = Round(?(vRoomTypeBalancesRow.Amount = Undefined, 0, (vRoomTypeBalancesRow.Amount * 100)/(100 - vRoomRate.OnlineDiscount)), 2);
								vRTRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
							Else
								vRTRetAccTypeRow.AmountBeforeDiscount = ?(vRoomTypeBalancesRow.AmountBeforeDiscount = Undefined, 0, vRoomTypeBalancesRow.AmountBeforeDiscount);
								vRTRetAccTypeRow.Discount = vProbeResObj.Discount;    
							EndIf;
							vRTRetAccTypeRow.Amount = ?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount);
							vRTRetAccTypeRow.AmountPresentation = cmFormatSum(?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount), vAccTypeCurrency, "NZ=");
							vRTRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
							If IsBlankString(vRTRetAccTypeRow.Currency) Then
								vRTRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
							EndIf;
							If ValueIsFilled(vAccTypeCurrency) Then
								vRTRetAccTypeRow.CurrencyCode = TrimAll(vAccTypeCurrency.Code);
								vRTRetAccTypeRow.CurrencyDescription = TrimAll(vAccTypeCurrency.Description);
							Else
								vRTRetAccTypeRow.CurrencyCode = "";
								vRTRetAccTypeRow.CurrencyDescription = "";
							EndIf;            	
							
							vRTRetAccTypesList.AccommodationType.Add(vRTRetAccTypeRow);
							
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vAmountBeforeDiscount = vAmountBeforeDiscount + Round(?(vRoomTypeBalancesRow.Amount = Undefined, 0, (vRoomTypeBalancesRow.Amount * 100)/(100 - vRoomRate.OnlineDiscount)), 2);
							Else
								vAmountBeforeDiscount = vAmountBeforeDiscount + ?(vRoomTypeBalancesRow.AmountBeforeDiscount = Undefined, 0, vRoomTypeBalancesRow.AmountBeforeDiscount);	
							EndIf;
							vAmount = vAmount + ?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount);
							vFirstDaySum = vFirstDaySum + ?(vRoomTypeBalancesRow.FirstDaySum = Undefined, 0, vRoomTypeBalancesRow.FirstDaySum);
							If ((vRoomTypeBalances.IndexOf(vRoomTypeBalancesRow)+1) = vRoomTypeBalances.Count()) 
								Or vRoomTypeBalances[vRoomTypeBalances.IndexOf(vRoomTypeBalancesRow)+1].RoomType <> vRoomTypeBalancesRow.RoomType Then
								vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesByCheckInPeriodsRow"));
								vRetRow.Hotel = vRoomTypeBalancesRow.ExtHotelCode;
								vRetRow.RoomType = vRoomTypeBalancesRow.ExtRoomTypeCode;
								vRetRow.RoomTypeCode = vRoomTypeBalancesRow.RoomTypeCode;
								vRetRow.RoomTypeDescription = vRoomTypeBalancesRow.RoomTypeDescription;
								vRetRow.RoomTypePictureLink = vRoomTypeBalancesRow.RoomTypePictureLink;
								vRetRow.RoomTypeInfoLink = vRoomTypeBalancesRow.RoomTypeInfoLink;
								vRetRow.RoomRate = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "RoomRates", vRoomRate);
								vRetRow.RoomRateCode = ?(ValueIsFilled(vRoomRate), TrimAll(vRoomRate.Code), "");
								vRetRow.RoomRateDescription =  ?(ValueIsFilled(vRoomRate), TrimAll(vRoomRate.Description), "");
								vRetRow.Currency = vRoomTypeBalancesRow.ExtCurrencyCode;
								vRetRow.CurrencyCode = vRoomTypeBalancesRow.CurrencyCode;
								vRetRow.CurrencyDescription = vRoomTypeBalancesRow.CurrencyDescription;
								vRetRow.FirstDaySum = vFirstDaySum;
								vRetRow.AmountBeforeDiscount = Round(vAmountBeforeDiscount, 2);
								If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
									vRetRow.Discount = vRoomRate.OnlineDiscount;
								Else
									vRetRow.Discount = vProbeResObj.Discount;	
								EndIf;
								vRetRow.Amount = Round(vAmount, 2);
								vRetRow.AmountPresentation = cmFormatSum(vAmount, vRoomTypeBalancesRow.Currency, "NZ=");
								vRetRow.LimitedRoomsText = vRoomTypeBalancesRow.LimitedRoomsText;
								vRetRow.RoomsRemains = vRoomTypeBalancesRow.RoomsAvailable;
								vRetRow.BedsRemains = vRoomTypeBalancesRow.BedsAvailable;
								vRetRow.Allotment = vAllotmentCode;
								vRetRow.AllotmentDescription = vAllotmentDescription;
								vRetRow.CheckInDate = vCheckInDate;
								vRetRow.Duration = vDuration;
								vRetRow.CheckOutDate = vCheckOutDate;
								If ValueIsFilled(vRoomRate) Then
									vRetRow.ReservationConditionsShort = Left(cmNStr(vRoomRate.ReservationConditionsShort, vLanguage), 4096);
									vRetRow.ReservationConditionsOnline = Left(cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage), 4096);
									vRetRow.PaymentMethodCodesAllowedOnline = Left(TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline), 4096);
								Else
									vRetRow.ReservationConditionsShort = "";
									vRetRow.ReservationConditionsOnline = "";
									vRetRow.PaymentMethodCodesAllowedOnline = "";
								EndIf;
								vRetRow.AccommodationTypesList = vRetAccTypesList;
								vRetRow.LastReservationDate = vRoomTypeBalancesRow.LastReservationDate;
								
								If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
									vAccommodationTypesByRoomTypes.Add(vCurRoomType);
									vRetRoomTypeRow.AccommodationTypesList = vRTRetAccTypesList;
									vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
								EndIf;
								
								vRetStr = vRetStr + """" + vRoomTypeBalancesRow.ExtHotelCode + """" + "," + """" + vRoomTypeBalancesRow.ExtRoomTypeCode + """" + "," + 
								"""" + TrimAll(vRoomTypeBalancesRow.AccommodationTemplate.Code) + """" + "," + 
								Format(vRoomTypeBalancesRow.RoomsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + Format(vRoomTypeBalancesRow.BedsAvailable, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
								"""" + vRoomTypeBalancesRow.ExtCurrencyCode + """" + "," + Format(vRoomTypeBalancesRow.FirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + Format(vRoomTypeBalancesRow.Amount, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
								"""" + vRoomTypeBalancesRow.RoomTypeCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypeDescription) + """" + "," + 
								"""" + TrimAll(vCurAccommodationType.Code) + """" + "," + """" + cmRemoveComma(TrimAll(vCurAccommodationType.Description)) + """" + "," + 
								"""" + vRoomTypeBalancesRow.RoomRateCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomRateDescription) + """" + "," + 
								"""" + vRoomTypeBalancesRow.CurrencyCode + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.CurrencyDescription) + """" + "," + 
								"""" + cmRemoveComma(vRoomTypeBalancesRow.AmountPresentation) + """" + "," + 
								"""" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypePictureLink) + """" + "," + """" + cmRemoveComma(vRoomTypeBalancesRow.RoomTypeInfoLink) + """" + Chars.LF;
								
								vAvailableRoomTypesByCheckInPeriodsRows.AvailableRoomTypesByCheckInPeriodsRow.Add(vRetRow);
								
								vAmountBeforeDiscount = 0;
								vAmount = 0;
								vFirstDaySum = 0;
							EndIf;
						EndDo;
					EndIf;
				EndIf;
			EndIf;

			vDiscountType = vSavDiscountType;
			vChildrenAgesStruct = vSavChildrenAgesStruct;
		EndDo;
		If vRetAccTypesRows <> Undefined Then
			vRetXDTO.AccommodationTypes = vRetAccTypesRows;
		EndIf;
		If vAvailableRoomTypesByCheckInPeriodsRows <> Undefined Then
			vRetXDTO.AvailableRoomTypesByCheckInPeriodsRows = vAvailableRoomTypesByCheckInPeriodsRows;
		Else
			vRetXDTO.AvailableRoomTypesByCheckInPeriodsRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesByCheckInPeriodsRows"));
		EndIf;
	EndIf;
	
	WriteLogEvent(NStr("en='Get available room types';ru='Получить остатки свободных номеров';de='Restbestände an freien Zimmern erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
	
	If vProbeResObj <> Undefined Then
		For Each vCRRow In vProbeResObj.ChargingRules Do
			vFolioObj = vCRRow.ChargingFolio.GetObject();
			vFolioObj.Delete();
		EndDo;
		vProbeResObj = Undefined;
	EndIf;

	If vRoomsTable <> Undefined  And cmCheckUserPermissions("ReturnAvailableRoomsForExternalSystems") Then
		Try
			For Each vAvailableRoomTypesRow In vRetXDTO.AvailableRoomTypesRows.AvailableRoomTypesRow Do
				vRoomsEmpty = True;
				vAvailableRoomTypesRow.Rooms = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "Rooms"));
				For Each vRoomRow In vRoomsTable Do
					If TrimAll(vRoomRow.RoomType.Code) = TrimAll(vAvailableRoomTypesRow.RoomTypeCode) Then 
						vRoomAttrRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomsRow"));
						vRoomAttrRow.Room = TrimAll(vRoomRow.Room.Description);
						vRoomAttrRow.SortCode = vRoomRow.Room.SortCode;
						vRoomAttrRow.RoomsAvailable = vRoomRow.RoomsAvailable;
						vRoomAttrRow.BedsAvailable = vRoomRow.BedsAvailable;
						vRoomAttrRow.NumberOfPersonsPerRoom = vRoomRow.NumberOfPersonsPerRoom;
						vAvailableRoomTypesRow.Rooms.Room.Add(vRoomAttrRow);
						vRoomsEmpty = False;
					EndIf;
				EndDo;
				If vRoomsEmpty Then
					vAvailableRoomTypesRow.RoomsAvailable 	= 0;
					vAvailableRoomTypesRow.BedsAvailable 	= 0;	
				EndIf;
			EndDo;
		Except
		EndTry;
	EndIf;
	
	// Log request to the information register
	BeginTransaction(DataLockControlMode.Managed);
	vD = BegOfDay(pPeriodFrom);
	While vD < BegOfDay(pPeriodTo) Or BegOfDay(pPeriodFrom) = BegOfDay(pPeriodTo) And vD = BegOfDay(pPeriodFrom) Do
		vRcd = InformationRegisters.OnlineRequests.CreateRecordManager();
		vRcd.Period = CurrentSessionDate();
		vRcd.Hotel = vHotel;
		vRcd.ExtSystemCode = pExternalSystemCode;
		vRcd.Date = vD;
		vRcd.Counter = 1;
		vRcd.PeriodFrom = pPeriodFrom;
		vRcd.PeriodTo = pPeriodTo;
		vRcd.Adults = vAdultsQuantity;
		vRcd.Children = vKidsQuantity;
		If pGuestsQuantity <> Undefined And pGuestsQuantity.RequestAttributes <> Undefined Then
			FillPropertyValues(vRcd, pGuestsQuantity.RequestAttributes);
		EndIf;
		vRcd.Write(True);
		
		vD = vD + tcCommonFunctionOnClientServer.cmOneDay();
	EndDo;
	CommitTransaction();
	// Debug
	If vWriteDebug Then
		vExtraXML = "";
		vXMLWriter = New XMLWriter; 
		vXMLWriter.SetString();
		XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
		vExtraXML = vXMLWriter.Close();
		
		vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetAvailableRoomTypes", Enums.ExternalSystemEventTypes.Info, , vExtraXML , vMsg, vInteraction.MaxLogLenght);
	EndIf;

	Return vRetXDTO;
EndFunction

// -----------------------------------------------------------------------------
Procedure GetRoomTypesByCheckInPeriods(Val pPeriodFrom, Val pPeriodTo, Val vContract, Val vCustomer, Val vGuestsQuantity, Val vHotel, Val vIsByCheckInPeriods, Val vRoomQuota, Val vRoomRates, vVacantPeriods)
	
	Var vAgent, vDuration, vNoAgent, vQry, vResult, vRoomRate, vRoomRateItem, vSearchWidth, vVacantPeriodsRow;
	
	If vIsByCheckInPeriods = True And vRoomRates.Count() > 0 Then
		For Each vRoomRateItem In vRoomRates Do
			vRoomRate = vRoomRateItem.Value;
			// Check room rate is valid period
			If ValueIsFilled(vRoomRate.DateValidFrom) Or ValueIsFilled(vRoomRate.DateValidTo) Then
				If ValueIsFilled(vRoomRate.DateValidFrom) And pPeriodFrom < vRoomRate.DateValidFrom Then
					Continue;
				EndIf;
				If ValueIsFilled(vRoomRate.DateValidTo) And pPeriodTo > EndOfDay(vRoomRate.DateValidTo) Then
					Continue;
				EndIf;
			EndIf;
			Break;
		EndDo;
		
		// Call API to get value table with balances
		vAgent = Catalogs.Customers.EmptyRef();
		If ValueIsFilled(vCustomer) And ValueIsFilled(vCustomer.AgentCommissionType) Then
			vAgent = vCustomer;
		EndIf;
		If ValueIsFilled(vCustomer) Or ValueIsFilled(vContract) Or ValueIsFilled(vAgent) Then
			vNoAgent = False;
			vQry = New Query();
			vQry.Text = 
			"SELECT 
			|	RoomQuotas.Ref AS Ref
			|FROM
			|	Catalog.RoomQuotas AS RoomQuotas
			|WHERE
			|	Not RoomQuotas.DeletionMark 
			|	AND Not RoomQuotas.IsFolder
			|	AND (RoomQuotas.Agent IN HIERARCHY (&qAgent))
			|	AND (RoomQuotas.Customer IN HIERARCHY (&qCustomer))
			|	AND (RoomQuotas.Contract = &qContract)";
			vQry.SetParameter("qCustomer", vCustomer);
			vQry.SetParameter("qContract", vContract);
			vQry.SetParameter("qAgent", vAgent);
			vResult = vQry.Execute().Unload();
			If vResult.Count() = 0 Then
				vNoAgent = True;
			EndIf;
		EndIf;
		
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	CheckInPeriods.Hotel AS Hotel,
		|	CheckInPeriods.RoomQuota.RoomRate AS RoomRate,
		|	CheckInPeriods.CheckInDate AS CheckInDate,
		|	CheckInPeriods.Duration AS Duration,
		|	CheckInPeriods.CheckOutDate AS CheckOutDate,
		|	CASE
		|		WHEN BEGINOFPERIOD(CheckInPeriods.CheckOutDate, DAY) = &qBegOfPeriodTo
		|				AND BEGINOFPERIOD(CheckInPeriods.CheckInDate, DAY) = &qPeriodFromBegOfDay
		|			THEN 1
		|		ELSE CASE
		|				WHEN BEGINOFPERIOD(CheckInPeriods.CheckOutDate, DAY) <> &qBegOfPeriodTo
		|						AND BEGINOFPERIOD(CheckInPeriods.CheckInDate, DAY) = &qPeriodFromBegOfDay
		|					THEN 2
		|				ELSE 3
		|			END
		|	END AS SortCode,
		|	CheckInPeriods.RoomQuota AS Allotment,
		|	MIN(CheckInPeriods.RoomsRemains) AS RoomsRemains,
		|	MIN(CheckInPeriods.BedsRemains) AS BedsRemains,
		|	CheckInPeriods.RoomType AS RoomType
		|INTO CheckInPeriods
		|FROM
		|	(SELECT
		|		CheckInPeriods2.Hotel AS Hotel,
		|		CheckInPeriods2.RoomQuota.RoomRate AS RoomRate,
		|		CheckInPeriods2.CheckInDate AS CheckInDate,
		|		CheckInPeriods2.Duration AS Duration,
		|		CheckInPeriods2.CheckOutDate AS CheckOutDate,
		|		CheckInPeriods2.RoomQuota AS RoomQuota,
		|		RoomQuotaBalances.RoomType AS RoomType,
		|		MIN(ISNULL(RoomQuotaBalances.RoomsRemains, 0)) AS RoomsRemains,
		|		MIN(ISNULL(RoomQuotaBalances.BedsRemains, 0)) AS BedsRemains
		|	FROM
		|		InformationRegister.RoomQuotaCheckInPeriods AS CheckInPeriods2
		|			LEFT JOIN (SELECT
		|				RoomQuotaSalesBalanceAndTurnovers.Period AS Period,
		|				RoomQuotaSalesBalanceAndTurnovers.Hotel AS RoomQuotaSalesBalanceHotel,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomQuota AS RoomQuotaSalesBalanceRoomQuota,
		|				MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) AS RoomsRemains,
		|				MIN(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance) AS BedsRemains,
		|				MIN(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance) AS Counter,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType
		|			FROM
		|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|						DATEADD(&qPeriodFrom, DAY, &qNegativeSearchWidth),
		|						&qBegOfPeriodTo,
		|						DAY,
		|						RegisterRecordsAndPeriodBoundaries,
		|						(Hotel IN HIERARCHY (&qHotel)
		|							OR &qHotelIsEmpty)
		|							AND (RoomQuota.Agent IN HIERARCHY (&qAgent)
		|								OR &qAgentIsEmpty)
		|							AND (RoomQuota.Customer IN HIERARCHY (&qCustomer)
		|								OR &qCustomerIsEmpty)
		|							AND (RoomQuota.Contract = &qContract
		|								OR &qContractIsEmpty)) AS RoomQuotaSalesBalanceAndTurnovers
		|			
		|			GROUP BY
		|				RoomQuotaSalesBalanceAndTurnovers.Hotel,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomQuota,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomType,
		|				RoomQuotaSalesBalanceAndTurnovers.Period) AS RoomQuotaBalances
		|			ON (RoomQuotaBalances.RoomQuotaSalesBalanceHotel = CheckInPeriods2.Hotel)
		|				AND (RoomQuotaBalances.RoomQuotaSalesBalanceRoomQuota = CheckInPeriods2.RoomQuota)
		|				AND (RoomQuotaBalances.Period >= BEGINOFPERIOD(CheckInPeriods2.CheckInDate, DAY))
		|				AND (RoomQuotaBalances.Period < BEGINOFPERIOD(CheckInPeriods2.CheckOutDate, DAY))
		|	WHERE
		|		NOT CheckInPeriods2.IsNotActive
		|		AND CheckInPeriods2.Duration > 0
		|		AND CheckInPeriods2.RoomQuota <> &qEmptyRoomQuota
		|		AND (CheckInPeriods2.Hotel IN HIERARCHY (&qHotel)
		|				OR &qHotelIsEmpty)
		|		AND CheckInPeriods2.CheckInDate >= DATEADD(&qPeriodFromBegOfDay, DAY, &qNegativeSearchWidth)
		|		AND CheckInPeriods2.CheckInDate <= DATEADD(ENDOFPERIOD(&qPeriodTo, DAY), DAY, &qSearchWidth)
		|		AND CheckInPeriods2.CheckOutDate <= DATEADD(ENDOFPERIOD(&qPeriodTo, DAY), DAY, &qSearchWidth)
		|		AND RoomQuotaBalances.RoomType.NumberOfPersonsPerRoom >= &qNOP
		|	
		|	GROUP BY
		|		CheckInPeriods2.Hotel,
		|		CheckInPeriods2.RoomQuota.RoomRate,
		|		CheckInPeriods2.CheckInDate,
		|		CheckInPeriods2.Duration,
		|		CheckInPeriods2.CheckOutDate,
		|		CheckInPeriods2.RoomQuota,
		|		RoomQuotaBalances.RoomType) AS CheckInPeriods
		|
		|GROUP BY
		|	CheckInPeriods.Hotel,
		|	CheckInPeriods.RoomQuota.RoomRate,
		|	CheckInPeriods.CheckInDate,
		|	CheckInPeriods.Duration,
		|	CheckInPeriods.CheckOutDate,
		|	CASE
		|		WHEN BEGINOFPERIOD(CheckInPeriods.CheckOutDate, DAY) = &qBegOfPeriodTo
		|				AND BEGINOFPERIOD(CheckInPeriods.CheckInDate, DAY) = &qPeriodFromBegOfDay
		|			THEN 1
		|		ELSE CASE
		|				WHEN BEGINOFPERIOD(CheckInPeriods.CheckOutDate, DAY) <> &qBegOfPeriodTo
		|						AND BEGINOFPERIOD(CheckInPeriods.CheckInDate, DAY) = &qPeriodFromBegOfDay
		|					THEN 2
		|				ELSE 3
		|			END
		|	END,
		|	CheckInPeriods.RoomQuota,
		|	CheckInPeriods.RoomType
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 50
		|	CASE
		|		WHEN BEGINOFPERIOD(MAX(CheckInPeriods.CheckOutDate), DAY) = &qBegOfPeriodTo
		|				AND BEGINOFPERIOD(MIN(CheckInPeriods.CheckInDate), DAY) = &qPeriodFromBegOfDay
		|			THEN 1
		|		ELSE 2
		|	END AS SortCode,
		|	CASE
		|		WHEN DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration < 0
		|			THEN -(DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration)
		|		ELSE DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration
		|	END + YEAR(MIN(CheckInPeriods.CheckInDate)) + MONTH(MIN(CheckInPeriods.CheckInDate)) + MONTH(MAX(CheckInPeriods.CheckOutDate)) + DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) * DAY(MIN(CheckInPeriods.CheckInDate)) * DAY(MAX(CheckInPeriods.CheckOutDate)) AS UUID,
		|	CASE
		|		WHEN DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY) < 0
		|			THEN -DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|		ELSE DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|	END + CASE
		|		WHEN DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY) < 0
		|			THEN -DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|		ELSE DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|	END AS DifferenceFromTo,
		|	0 AS DifferenceDuration,
		|	CheckInPeriods.Hotel AS Hotel,
		|	MIN(CheckInPeriods.CheckInDate) AS CheckInDate,
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) AS Duration,
		|	MAX(CheckInPeriods.CheckOutDate) AS CheckOutDate,
		|	CheckInPeriods.RoomType AS RoomType,
		|	CheckInPeriods.Allotment AS Allotment,
		|	CheckInPeriods.Allotment.Code AS AllotmentCode,
		|	CheckInPeriods.Allotment.Customer AS Customer,
		|	CheckInPeriods.Allotment.Agent AS Agent,
		|	CheckInPeriods.Allotment.Contract AS Contract,
		|	MIN(CheckInPeriods.RoomsRemains) AS RoomsRemains,
		|	MIN(CheckInPeriods.BedsRemains) AS BedsRemains,
		|	CheckInPeriods.Allotment.RoomRate AS RoomRate,
		|	CheckInPeriods.Allotment.SortCode AS AllotmentSortCode,
		|	CheckInPeriods.Hotel.SortCode AS HotelSortCode,
		|	CheckInPeriods.RoomType.SortCode AS RoomTypeSortCode
		|INTO ResultTable
		|FROM
		|	CheckInPeriods AS CheckInPeriods
		|WHERE
		|	CheckInPeriods.Duration <= &qDuration
		|	AND CheckInPeriods.CheckInDate >= &qPeriodFromBegOfDay
		|	AND CheckInPeriods.CheckOutDate <= ENDOFPERIOD(&qPeriodTo, DAY)
		|
		|GROUP BY
		|	CheckInPeriods.Hotel,
		|	CheckInPeriods.Hotel.SortCode,
		|	CheckInPeriods.RoomType,
		|	CheckInPeriods.RoomType.SortCode,
		|	CheckInPeriods.Allotment,
		|	CheckInPeriods.Allotment.Code,
		|	CheckInPeriods.Allotment.Customer,
		|	CheckInPeriods.Allotment.Agent,
		|	CheckInPeriods.Allotment.Contract,
		|	CheckInPeriods.Allotment.RoomRate,
		|	CheckInPeriods.Allotment.SortCode
		|
		|HAVING
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) = &qDuration AND
		|	MIN(CheckInPeriods.RoomsRemains) > 0
		|
		|UNION ALL
		|
		|SELECT TOP 50
		|	CASE
		|		WHEN BEGINOFPERIOD(MAX(CheckInPeriods.CheckOutDate), DAY) = &qBegOfPeriodTo
		|				AND BEGINOFPERIOD(MIN(CheckInPeriods.CheckInDate), DAY) = &qPeriodFromBegOfDay
		|			THEN 1
		|		ELSE 2
		|	END,
		|	CASE
		|		WHEN DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration < 0
		|			THEN -(DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration)
		|		ELSE DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration
		|	END + YEAR(MIN(CheckInPeriods.CheckInDate)) + MONTH(MIN(CheckInPeriods.CheckInDate)) + MONTH(MAX(CheckInPeriods.CheckOutDate)) + DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) * DAY(MIN(CheckInPeriods.CheckInDate)) * DAY(MAX(CheckInPeriods.CheckOutDate)),
		|	CASE
		|		WHEN DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY) < 0
		|			THEN -DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|		ELSE DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|	END + CASE
		|		WHEN DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY) < 0
		|			THEN -DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|		ELSE DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|	END,
		|	0,
		|	CheckInPeriods.Hotel,
		|	MIN(CheckInPeriods.CheckInDate),
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY),
		|	MAX(CheckInPeriods.CheckOutDate),
		|	CheckInPeriods.RoomType,
		|	CheckInPeriods.Allotment,
		|	CheckInPeriods.Allotment.Code,
		|	CheckInPeriods.Allotment.Customer,
		|	CheckInPeriods.Allotment.Agent,
		|	CheckInPeriods.Allotment.Contract,
		|	MIN(CheckInPeriods.RoomsRemains),
		|	MIN(CheckInPeriods.BedsRemains),
		|	CheckInPeriods.Allotment.RoomRate,
		|	CheckInPeriods.Allotment.SortCode,
		|	CheckInPeriods.Hotel.SortCode,
		|	CheckInPeriods.RoomType.SortCode
		|FROM
		|	CheckInPeriods AS CheckInPeriods
		|
		|GROUP BY
		|	CheckInPeriods.Hotel,
		|	CheckInPeriods.Hotel.SortCode,
		|	CheckInPeriods.RoomType,
		|	CheckInPeriods.RoomType.SortCode,
		|	CheckInPeriods.Allotment,
		|	CheckInPeriods.Allotment.Code,
		|	CheckInPeriods.Allotment.Customer,
		|	CheckInPeriods.Allotment.Agent,
		|	CheckInPeriods.Allotment.Contract,
		|	CheckInPeriods.Allotment.RoomRate,
		|	CheckInPeriods.Allotment.SortCode
		|
		|HAVING
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) = &qDuration AND
		|	MIN(CheckInPeriods.RoomsRemains) > 0
		|
		|UNION ALL
		|
		|SELECT TOP 50
		|	2,
		|	CASE
		|		WHEN DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration < 0
		|			THEN -(DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration)
		|		ELSE DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration
		|	END + YEAR(MIN(CheckInPeriods.CheckInDate)) + MONTH(MIN(CheckInPeriods.CheckInDate)) + MONTH(MAX(CheckInPeriods.CheckOutDate)) + DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) / 2 * DAY(MIN(CheckInPeriods.CheckInDate)) * DAY(MAX(CheckInPeriods.CheckOutDate)),
		|	CASE
		|		WHEN DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY) < 0
		|			THEN -DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|		ELSE DATEDIFF(&qPeriodFromBegOfDay, MIN(CheckInPeriods.CheckInDate), DAY)
		|	END + CASE
		|		WHEN DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY) < 0
		|			THEN -DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|		ELSE DATEDIFF(&qBegOfPeriodTo, MAX(CheckInPeriods.CheckOutDate), DAY)
		|	END,
		|	CASE
		|		WHEN DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration < 0
		|			THEN -(DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration)
		|		ELSE DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) - &qDuration
		|	END,
		|	CheckInPeriods.Hotel,
		|	MIN(CheckInPeriods.CheckInDate),
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY),
		|	MAX(CheckInPeriods.CheckOutDate),
		|	CheckInPeriods.RoomType,
		|	CheckInPeriods.Allotment,
		|	CheckInPeriods.Allotment.Code,
		|	CheckInPeriods.Allotment.Customer,
		|	CheckInPeriods.Allotment.Agent,
		|	CheckInPeriods.Allotment.Contract,
		|	MIN(CheckInPeriods.RoomsRemains),
		|	MIN(CheckInPeriods.BedsRemains),
		|	CheckInPeriods.Allotment.RoomRate,
		|	CheckInPeriods.Allotment.SortCode,
		|	CheckInPeriods.Hotel.SortCode,
		|	CheckInPeriods.RoomType.SortCode
		|FROM
		|	CheckInPeriods AS CheckInPeriods
		|
		|GROUP BY
		|	CheckInPeriods.Hotel,
		|	CheckInPeriods.Hotel.SortCode,
		|	CheckInPeriods.RoomType,
		|	CheckInPeriods.RoomType.SortCode,
		|	CheckInPeriods.Allotment,
		|	CheckInPeriods.Allotment.Code,
		|	CheckInPeriods.Allotment.Customer,
		|	CheckInPeriods.Allotment.Agent,
		|	CheckInPeriods.Allotment.Contract,
		|	CheckInPeriods.Allotment.RoomRate,
		|	CheckInPeriods.Allotment.SortCode
		|
		|HAVING
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) >= 0 AND
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) >= &qDuration - &qSearchWidth AND
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) <= &qDuration + &qSearchWidth AND
		|	DATEDIFF(MIN(CheckInPeriods.CheckInDate), MAX(CheckInPeriods.CheckOutDate), DAY) <> &qDuration AND
		|	BEGINOFPERIOD(MIN(CheckInPeriods.CheckInDate), DAY) <> &qPeriodFromBegOfDay AND
		|	BEGINOFPERIOD(MIN(CheckInPeriods.CheckInDate), DAY) >= DATEADD(&qPeriodFromBegOfDay, DAY, &qNegativeSearchWidth) AND
		|	BEGINOFPERIOD(MIN(CheckInPeriods.CheckInDate), DAY) <= DATEADD(&qPeriodFromBegOfDay, DAY, &qSearchWidth) AND
		|	MIN(CheckInPeriods.RoomsRemains) > 0
		|
		|ORDER BY
		|	SortCode,
		|	DifferenceDuration,
		|	Duration DESC,
		|	DifferenceFromTo,
		|	HotelSortCode,
		|	CheckInDate,
		|	CheckOutDate,
		|	AllotmentSortCode,
		|	RoomTypeSortCode
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 5
		|	MAX(ResultTable.SortCode) AS SortCode,
		|	MAX(ResultTable.DifferenceFromTo) AS DifferenceFromTo,
		|	MAX(ResultTable.DifferenceDuration) AS DifferenceDuration,
		|	MAX(ResultTable.CheckInDate) AS CheckInDate,
		|	MAX(ResultTable.Duration) AS Duration,
		|	MAX(ResultTable.CheckOutDate) AS CheckOutDate,
		|	MAX(ResultTable.AllotmentSortCode) AS AllotmentSortCode,
		|	MAX(ResultTable.HotelSortCode) AS HotelSortCode,
		|	MAX(ResultTable.RoomTypeSortCode) AS RoomTypeSortCode,
		|	ResultTable.UUID AS UUID,
		|	COUNT(ResultTable.UUID) AS UUIDCount
		|INTO RTCount
		|FROM
		|	ResultTable AS ResultTable
		|
		|GROUP BY
		|	ResultTable.UUID
		|
		|ORDER BY
		|	SortCode,
		|	DifferenceDuration,
		|	Duration DESC,
		|	DifferenceFromTo,
		|	HotelSortCode,
		|	CheckInDate,
		|	CheckOutDate,
		|	AllotmentSortCode,
		|	RoomTypeSortCode
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ResultTable.SortCode AS SortCode,
		|	ResultTable.UUID AS UUID,
		|	ResultTable.DifferenceFromTo AS DifferenceFromTo,
		|	ResultTable.DifferenceDuration AS DifferenceDuration,
		|	ResultTable.Hotel AS Hotel,
		|	ResultTable.CheckInDate AS CheckInDate,
		|	ResultTable.Duration AS Duration,
		|	ResultTable.CheckOutDate AS CheckOutDate,
		|	ResultTable.RoomType AS RoomType,
		|	MAX(ResultTable.Allotment) AS Allotment,
		|	ResultTable.Customer AS Customer,
		|	ResultTable.Agent AS Agent,
		|	ResultTable.Contract AS Contract,
		|	MIN(ResultTable.RoomsRemains) AS RoomsRemains,
		|	MIN(ResultTable.BedsRemains) AS BedsRemains,
		|	ResultTable.RoomRate AS RoomRate,
		|	ResultTable.HotelSortCode AS HotelSortCode,
		|	ResultTable.RoomTypeSortCode AS RoomTypeSortCode
		|FROM
		|	ResultTable AS ResultTable
		|		INNER JOIN RTCount AS RTCount
		|		ON (RTCount.UUID = ResultTable.UUID)
		|WHERE
		|	(ResultTable.Allotment IN HIERARCHY (&qAllotment)
		|			OR &qRoomQuotaIsEmpty)
		|
		|GROUP BY
		|	ResultTable.SortCode,
		|	ResultTable.UUID,
		|	ResultTable.DifferenceFromTo,
		|	ResultTable.DifferenceDuration,
		|	ResultTable.Hotel,
		|	ResultTable.CheckInDate,
		|	ResultTable.Duration,
		|	ResultTable.CheckOutDate,
		|	ResultTable.RoomType,
		|	ResultTable.Customer,
		|	ResultTable.Agent,
		|	ResultTable.Contract,
		|	ResultTable.RoomRate,
		|	ResultTable.HotelSortCode,
		|	ResultTable.RoomTypeSortCode
		|
		|ORDER BY
		|	SortCode,
		|	DifferenceDuration,
		|	Duration DESC,
		|	DifferenceFromTo,
		|	HotelSortCode,
		|	CheckInDate,
		|	CheckOutDate,
		|	RoomTypeSortCode";
		vQry.SetParameter("qHotel", vHotel);
		vQry.SetParameter("qHotelIsEmpty", Not ValueIsFilled(vHotel));
		vQry.SetParameter("qAllotment", vRoomQuota);
		vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(vRoomQuota));
		vQry.SetParameter("qEmptyRoomQuota", Catalogs.RoomQuotas.EmptyRef());
		vQry.SetParameter("qPeriodFromBegOfDay", BegOfDay(pPeriodFrom));
		vQry.SetParameter("qPeriodFromEndOfDay", EndOfDay(pPeriodFrom));
		vQry.SetParameter("qPeriodFrom", pPeriodFrom);
		vQry.SetParameter("qPeriodTo", EndOfDay(pPeriodTo));
		vQry.SetParameter("qNOP", vGuestsQuantity);
		vQry.SetParameter("qBegOfPeriodTo", BegOfDay(pPeriodTo));
		If Not ValueIsFilled(vRoomRate) And ValueIsFilled(vHotel) And ValueIsFilled(vHotel.RoomRate) Then
			vRoomRate = vHotel.RoomRate;
		EndIf;
		vDuration = cmCalculateDuration(vRoomRate, pPeriodFrom, pPeriodTo);
		vQry.SetParameter("qDuration", vDuration);
		vQry.SetParameter("qCustomer", vCustomer);
		vQry.SetParameter("qCustomerIsEmpty", Not ValueIsFilled(vCustomer) Or vNoAgent);
		vQry.SetParameter("qContract", vContract);
		vQry.SetParameter("qContractIsEmpty", Not ValueIsFilled(vContract) Or vNoAgent);
		vQry.SetParameter("qAgent", vAgent);
		vQry.SetParameter("qAgentIsEmpty", Not ValueIsFilled(vAgent) Or vNoAgent);
		vSearchWidth = 1;
		If vDuration > 5 Then
			vSearchWidth = 3;
		ElsIf vDuration > 3 Then
			vSearchWidth = 2;
		ElsIf vDuration = 1 Then
			vSearchWidth = 0;
		EndIf;
		vQry.SetParameter("qSearchWidth", vSearchWidth);
		vQry.SetParameter("qNegativeSearchWidth", -vSearchWidth);
		vVacantPeriods = vQry.Execute().Unload();
		For Each vVacantPeriodsRow In vVacantPeriods Do
			WriteLogEvent(NStr("en='Get available room types';ru='Получить остатки свободных номеров';de='Restbestände an freien Zimmern erhalten'"), EventLogLevel.Information, , , 
			NStr("en='Vacant period: '; de='Vacant period: '; ru='Найден период: '") + vVacantPeriodsRow.CheckInDate + " - " + vVacantPeriodsRow.CheckOutDate + ", " + vVacantPeriodsRow.RoomType + ", " + vVacantPeriodsRow.RoomRate);
		EndDo;
	EndIf;

EndProcedure // cmGetAvailableRoomTypes

// -----------------------------------------------------------------------------
Function cmGetAccommodationTemplate(pRoomType, pNumberOfAdults, pNumberOfTeenagers = 0, pNumberOfChildren = 0, pNumberOfInfants = 0, pIsForFolioSplit = False) Export
	// Build and run query
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	AccommodationTemplates.Ref AS AccommodationTemplate
	|FROM
	|	Catalog.AccommodationTemplates AS AccommodationTemplates
	|WHERE
	|	(AccommodationTemplates.Hotel = &qHotel
	|			OR AccommodationTemplates.Hotel = &qEmptyHotel)
	|	AND AccommodationTemplates.NumberOfAdults = &qNumberOfAdults
	|	AND AccommodationTemplates.NumberOfTeenagers = &qNumberOfTeenagers
	|	AND AccommodationTemplates.NumberOfChildren = &qNumberOfChildren
	|	AND AccommodationTemplates.NumberOfInfants = &qNumberOfInfants
	|	AND AccommodationTemplates.IsForFolioSplit = &qIsForFolioSplit
	|	AND NOT AccommodationTemplates.DeletionMark
	|
	|ORDER BY
	|	AccommodationTemplates.Code";
	vQry.SetParameter("qHotel", pRoomType.Owner);
	vQry.SetParameter("qEmptyHotel", Catalogs.Hotels.EmptyRef());
	vQry.SetParameter("qNumberOfAdults", pNumberOfAdults);
	vQry.SetParameter("qNumberOfTeenagers", pNumberOfTeenagers);
	vQry.SetParameter("qNumberOfChildren", pNumberOfChildren);
	vQry.SetParameter("qNumberOfInfants", pNumberOfInfants);
	vQry.SetParameter("qIsForFolioSplit", pIsForFolioSplit);
	vAccTemplates = vQry.Execute().Unload();
	i = 0;
	While i < vAccTemplates.Count() Do
		vAccTemplatesRow = vAccTemplates.Get(i);
		vRoomTypes = vAccTemplatesRow.AccommodationTemplate.RoomTypes; 
		If vRoomTypes.Count() > 0 And vRoomTypes.Find(pRoomType, "RoomType") = Undefined Then
			If Not ValueIsFilled(pRoomType) Or ValueIsFilled(pRoomType) And Not ValueIsFilled(pRoomType.RoomClass) Or 
			   ValueIsFilled(pRoomType) And ValueIsFilled(pRoomType.RoomClass) And vRoomTypes.Find(pRoomType.RoomClass, "RoomClass") = Undefined Then
				vAccTemplates.Delete(i);
			Else
				i = i + 1;
			EndIf;
		Else
			i = i + 1;
		EndIf;
	EndDo;
	If vAccTemplates.Count() > 0 Then
		Return vAccTemplates.Get(0).AccommodationTemplate;
	Else
		Return Undefined;
	EndIf;
EndFunction // cmGetAccommodationTemplate

// -----------------------------------------------------------------------------
Function cmGetGuestQuantitiesPerAgeGroups(pAdultsQuantity, pKidsQuantity, pKidsAgeArray, pAgeSettingsStruct = Undefined, pHotel) Export
	// Calculate number of adults, teenagers, children and infants
	If pAgeSettingsStruct = Undefined Then
		pAgeSettingsStruct = pHotel;
	EndIf;
	vAdultsQuantity = pAdultsQuantity;
	vTeenagersQuantity = 0;
	vChildrenQuantity = 0;
	vInfantsQuantity = 0;
	If pKidsAgeArray <> Undefined Then
		For Each vKidsAgeItem In pKidsAgeArray Do
			If pAgeSettingsStruct.InfantsMaxAge >= vKidsAgeItem And pAgeSettingsStruct.InfantsMaxAge <> 0 Then
				vInfantsQuantity = vInfantsQuantity + 1;
			ElsIf pAgeSettingsStruct.ChildrenMaxAge >= vKidsAgeItem And pAgeSettingsStruct.ChildrenMaxAge <> 0 Then
				vChildrenQuantity = vChildrenQuantity + 1;
			ElsIf pAgeSettingsStruct.TeenagersMaxAge >= vKidsAgeItem And pAgeSettingsStruct.TeenagersMaxAge <> 0 Then
				vTeenagersQuantity = vTeenagersQuantity + 1;
			Else
				vAdultsQuantity = vAdultsQuantity + 1;
			EndIf;
		EndDo;
		If pKidsAgeArray.Count() < pKidsQuantity Then
			vAdultsQuantity = vAdultsQuantity + pKidsQuantity - pKidsAgeArray.Count();
		EndIf;
	Else
		vChildrenQuantity = pKidsQuantity;
	EndIf;
	Return New Structure("AdultsQuantity, TeenagersQuantity, ChildrenQuantity, InfantsQuantity", vAdultsQuantity, vTeenagersQuantity, vChildrenQuantity, vInfantsQuantity); 
EndFunction // cmGetGuestQuantitiesPerAgeGroups

// -----------------------------------------------------------------------------
Function cmGetAccommodationTemplateDetailsByGuestsQuantity(pAdultsQuantity, pKidsQuantity, pKidsAgeArray, pHotel, pNoFolioSplit = True, pAgeSettingsStruct = Undefined) Export
	// Calculate number of adults, teenagers, children and infants
	vGuestsQuantityStruct = cmGetGuestQuantitiesPerAgeGroups(pAdultsQuantity, pKidsQuantity, pKidsAgeArray, pAgeSettingsStruct, pHotel);
	vAdultsQuantity = vGuestsQuantityStruct.AdultsQuantity;
	vTeenagersQuantity = vGuestsQuantityStruct.TeenagersQuantity;
	vChildrenQuantity = vGuestsQuantityStruct.ChildrenQuantity;
	vInfantsQuantity = vGuestsQuantityStruct.InfantsQuantity;
	// Get accommodation templates suitable for this number of adults and kids
	vAccTemplates = cmGetAccommodationTemplatesByGuestsQuantity(vAdultsQuantity, vTeenagersQuantity, vChildrenQuantity, vInfantsQuantity, pHotel, pNoFolioSplit);
	Return vAccTemplates;
EndFunction // cmGetAccommodationTemplateDetailsByGuestsQuantity

// -----------------------------------------------------------------------------
Function cmGetAccommodationTemplatesByGuestsQuantity(pAdults, pTeens, pChildren, pInfants, pHotel, pNoFolioSplit = True) Export
	// Get accommodation templates suitable for this number of adults and kids
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	AccommodationTemplates.Ref AS AccommodationTemplate
	|FROM
	|	Catalog.AccommodationTemplates AS AccommodationTemplates
	|WHERE
	|	(AccommodationTemplates.Hotel = &qHotel
	|			OR AccommodationTemplates.Hotel = &qEmptyHotel)
	|	AND AccommodationTemplates.DeletionMark = FALSE
	|	AND (NOT &qNoFolioSplit
	|			OR &qNoFolioSplit
	|				AND NOT AccommodationTemplates.IsForFolioSplit)
	|	AND (AccommodationTemplates.NumberOfAdults = &qNumberOfAdults
	|			AND AccommodationTemplates.NumberOfTeenagers = &qNumberOfTeenagers
	|			AND AccommodationTemplates.NumberOfChildren = &qNumberOfChildren
	|			AND AccommodationTemplates.NumberOfInfants = &qNumberOfInfants)
	|
	|ORDER BY
	|	AccommodationTemplates.Code";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qNumberOfAdults", pAdults);
	vQry.SetParameter("qNumberOfTeenagers", pTeens);
	vQry.SetParameter("qNumberOfChildren", pChildren); 
	vQry.SetParameter("qNumberOfInfants", pInfants);
	vQry.SetParameter("qEmptyHotel", Catalogs.Hotels.EmptyRef());
	vQry.SetParameter("qNoFolioSplit", pNoFolioSplit);
	vAccTemplates = vQry.Execute().Unload();
	Return vAccTemplates;
EndFunction // cmGetAccommodationTemplatesByGuestsQuantity

// -----------------------------------------------------------------------------
Function cmGetRoomTypesByGuestQuantity(pGuestsQuantity, pRoomType, pHotel) Export
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	RoomTypes.Ref AS RoomType,
	|	RoomTypes.NumberOfBedsPerRoom AS NumberOfBedsPerRoom,
	|	RoomTypes.NumberOfPersonsPerRoom AS NumberOfPersonsPerRoom
	|FROM
	|	Catalog.RoomTypes AS RoomTypes
	|WHERE
	|	RoomTypes.NumberOfPersonsPerRoom >= &qNOP
	|	AND RoomTypes.Ref IN HIERARCHY(&qRoomType)
	|	AND NOT RoomTypes.DeletionMark
	|	AND NOT RoomTypes.IsFolder
	|	AND RoomTypes.Owner = &qHotel
	|
	|ORDER BY
	|	RoomTypes.SortCode";
	vQry.SetParameter("qNOP", pGuestsQuantity);
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomType", pRoomType);
	vRoomTypes = vQry.Execute().Unload();
	Return vRoomTypes;
EndFunction // cmGetRoomTypesByGuestQuantity

// -----------------------------------------------------------------------------
Function GetAccommodationTemplatesByGuestsQuantity(pAdultsQuantity, pKidsQuantity, pKidsAgeList, pRoomType = Undefined, pHotel = Undefined, pNoFolioSplit = False, pChildrenAgesStruct = Undefined, pAccommodationTemplate = Undefined)
	// Convert kids age list into array
	vKidsAgeArray = New Array();
	If pKidsAgeList <> Undefined And TypeOf(pKidsAgeList) = Type("ValueList") Then
		vKidsAgeArray = pKidsAgeList.UnloadValues();
	EndIf;
	If ValueIsFilled(pAccommodationTemplate) Then
		// Build return value table
		vAccTemplatesList = New ValueTable();
		vAccTemplatesList.Columns.Add("Ref", cmGetCatalogTypeDescription("AccommodationTemplates"));
		vAccTemplatesList.Columns.Add("Code", cmGetStringTypeDescription());
		vAccTemplatesList.Columns.Add("AccTypesCount", cmGetNumberTypeDescription(10, 0));
		vAccTemplatesList.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
		vAccTemplatesList.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
		vAccTemplatesList.Columns.Add("Age", cmGetNumberTypeDescription(10, 0));
		vAccTemplatesList.Columns.Add("IsMain", cmGetNumberTypeDescription(10, 0));
		j = 0;
		For Each vAccommodationTypesRow In pAccommodationTemplate.AccommodationTypes Do
			vAccTemplatesListRow = vAccTemplatesList.Add();
			vAccTemplatesListRow.Ref = pAccommodationTemplate;
			vAccTemplatesListRow.Code = TrimAll(pAccommodationTemplate.Code);
			vAccTemplatesListRow.AccTypesCount = pAccommodationTemplate.AccommodationTypes.Count();
			vAccTemplatesListRow.RoomType = pRoomType;
			vAccTemplatesListRow.AccommodationType = vAccommodationTypesRow.AccommodationType;
			vAccTemplatesListRow.IsMain = 1;
			vAccTemplatesListRow.Age = 0;
			If vKidsAgeArray.Count() > 0 Then
				vAccType = vAccommodationTypesRow.AccommodationType;
				If vAccType.AllowedClientAgeFrom <> 0 Or vAccType.AllowedClientAgeTo <> 0 Or ValueIsFilled(vAccType.AllowedClientAgeRange) Then
					For i = j To (vKidsAgeArray.Count() - 1) Do
						vAge = vKidsAgeArray.Get(i);
						If (vAccType.AllowedClientAgeFrom < vAge Or vAccType.AllowedClientAgeFrom = 0 And vAge = 0) And vAccType.AllowedClientAgeTo > vAge Then
							j = i + 1;
							vAccTemplatesListRow.Age = vAge;
							Break;
						ElsIf ValueIsFilled(vAccType.AllowedClientAgeRange) Then
							vRange = vAccType.AllowedClientAgeRange;
							If (vRange.FromAge < vAge Or vRange.FromAge = 0 And vAge = 0) And vRange.ToAge > vAge Then
								j = i + 1;
								vAccTemplatesListRow.Age = vAge;
								Break;
							EndIf;
						EndIf;
					EndDo;
				EndIf;
			EndIf;
		EndDo;
		Return vAccTemplatesList;
	EndIf;
	// Call API to get accommodation templates suitable for the guests
	vAccommodationTemplates = cmGetAccommodationTemplateDetailsByGuestsQuantity(pAdultsQuantity, pKidsQuantity, vKidsAgeArray, pHotel, pNoFolioSplit, pChildrenAgesStruct);
	If vAccommodationTemplates.Count() > 0 Then
		// Build return value table
		vAccTemplatesList = New ValueTable();
		vAccTemplatesList.Columns.Add("Ref", cmGetCatalogTypeDescription("AccommodationTemplates"));
		vAccTemplatesList.Columns.Add("Code", cmGetStringTypeDescription());
		vAccTemplatesList.Columns.Add("AccTypesCount", cmGetNumberTypeDescription(10, 0));
		vAccTemplatesList.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
		vAccTemplatesList.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
		vAccTemplatesList.Columns.Add("Age", cmGetNumberTypeDescription(10, 0));
		vAccTemplatesList.Columns.Add("IsMain", cmGetNumberTypeDescription(10, 0));
		// Filter accommodation templates by room type
		For Each vAccommodationTemplatesRow In vAccommodationTemplates Do
			vAccTemplate = vAccommodationTemplatesRow.AccommodationTemplate;
			If vAccTemplate.RoomTypes.Count() > 0 Then
				If ValueIsFilled(pRoomType) Then
					If vAccTemplate.RoomTypes.Find(pRoomType, "RoomType") = Undefined Then
						If Not ValueIsFilled(pRoomType.RoomClass) Or 
						   ValueIsFilled(pRoomType.RoomClass) And vAccTemplate.RoomTypes.Find(pRoomType.RoomClass, "RoomClass") = Undefined Then
							Continue;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
			j = 0;
			For Each vAccommodationTypesRow In vAccTemplate.AccommodationTypes Do
				vAccTemplatesListRow = vAccTemplatesList.Add();
				vAccTemplatesListRow.Ref = vAccTemplate;
				vAccTemplatesListRow.Code = TrimAll(vAccTemplate.Code);
				vAccTemplatesListRow.AccTypesCount = vAccTemplate.AccommodationTypes.Count();
				vAccTemplatesListRow.RoomType = pRoomType;
				vAccTemplatesListRow.AccommodationType = vAccommodationTypesRow.AccommodationType;
				vAccTemplatesListRow.Age = 0;
				If vKidsAgeArray.Count() > 0 Then
					vAccType = vAccommodationTypesRow.AccommodationType;
					If vAccType.AllowedClientAgeFrom <> 0 Or vAccType.AllowedClientAgeTo <> 0 Or ValueIsFilled(vAccType.AllowedClientAgeRange) Then
						For i = j To (vKidsAgeArray.Count() - 1) Do
							vAge = vKidsAgeArray.Get(i);
							If (vAccType.AllowedClientAgeFrom < vAge Or vAccType.AllowedClientAgeFrom = 0 And vAge = 0) And vAccType.AllowedClientAgeTo > vAge Then
								j = i + 1;
								vAccTemplatesListRow.Age = vAge;
								Break;
							ElsIf ValueIsFilled(vAccType.AllowedClientAgeRange) Then
								vRange = vAccType.AllowedClientAgeRange;
								If (vRange.FromAge < vAge Or vRange.FromAge = 0 And vAge = 0) And vRange.ToAge > vAge Then
									j = i + 1;
									vAccTemplatesListRow.Age = vAge;
									Break;
								EndIf;
							EndIf;
						EndDo;
					EndIf;
				EndIf;
				vAccTemplatesListRow.IsMain = ?(vAccommodationTemplates.IndexOf(vAccommodationTemplatesRow) = 0, 0, 1);
			EndDo;
		EndDo;
	Else
		// Code below is for backward compatibility only! It could be used if accommodation templates are partially filled
		vAdultsQuantity = pAdultsQuantity;
		vKidsQuantity = pKidsQuantity;
		If pKidsAgeList <> Undefined Then
			vKidsAgeList = pKidsAgeList.Copy();
		Else
			vKidsAgeList = New ValueList;
		EndIf;
		vGuestsQuantity = vAdultsQuantity + vKidsQuantity;
		vQry = New Query;
		vQry.Text = 
		"SELECT
		|	MAX(AccommodationTypes.AllowedClientAgeTo) AS AllowedClientAgeTo
		|FROM
		|	Catalog.AccommodationTypes AS AccommodationTypes
		|WHERE
		|	NOT AccommodationTypes.IsFolder
		|	AND NOT AccommodationTypes.DeletionMark";
		vQryResult = vQry.Execute().Unload();
		If vQryResult.Count() > 0 Then
			vAgeRangeToMax = vQryResult[0].AllowedClientAgeTo;
		EndIf;
		If vKidsAgeList <> Undefined Then
			vDelInd = 0;
			For vInd = 0 To vKidsAgeList.Count()-1 Do
				vAge = vKidsAgeList.Get(vInd-vDelInd);
				If vAge.Value >= vAgeRangeToMax Then
					vAdultsQuantity = vAdultsQuantity + 1;
					vKidsQuantity = vKidsQuantity - 1;
					vKidsAgeList.Delete(vAge);
					vDelInd = vDelInd + 1;
				EndIf;
			EndDo;
		EndIf;
		vQry = New Query;
		vQry.Text = 
		"SELECT
		|	AccommodationTemplatesRoomTypes.Ref AS Ref,
		|	CASE
		|		WHEN AccommodationTemplatesRoomTypes.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|			THEN AllRoomTypes.Ref
		|		ELSE AccommodationTemplatesRoomTypes.RoomType
		|	END AS RoomType
		|INTO AccTemplatesWithRT
		|FROM
		|	Catalog.AccommodationTemplates.RoomTypes AS AccommodationTemplatesRoomTypes
		|		LEFT JOIN Catalog.RoomTypes AS AllRoomTypes
		|		ON AccommodationTemplatesRoomTypes.RoomClass = AllRoomTypes.RoomClass
		|			AND (AccommodationTemplatesRoomTypes.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|			AND (NOT AllRoomTypes.DeletionMark)
		|WHERE
		|	NOT AccommodationTemplatesRoomTypes.Ref.DeletionMark
		|	AND NOT AccommodationTemplatesRoomTypes.Ref.IsForFolioSplit
		|
		|GROUP BY
		|	AccommodationTemplatesRoomTypes.Ref,
		|	CASE
		|		WHEN AccommodationTemplatesRoomTypes.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|			THEN AllRoomTypes.Ref
		|		ELSE AccommodationTemplatesRoomTypes.RoomType
		|	END
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	AccommodationTemplates.Ref AS Ref,
		|	&qRoomType AS RoomType,
		|	AccTemplatesWithRT.Ref AS RefNull
		|INTO AccTemplateRoomTypes
		|FROM
		|	Catalog.AccommodationTemplates AS AccommodationTemplates
		|		LEFT JOIN AccTemplatesWithRT AS AccTemplatesWithRT
		|		ON AccommodationTemplates.Ref = AccTemplatesWithRT.Ref
		|WHERE
		|	AccTemplatesWithRT.Ref IS NULL
		|	AND NOT AccommodationTemplates.DeletionMark
		|	AND NOT AccommodationTemplates.IsForFolioSplit
		|
		|UNION ALL
		|
		|SELECT
		|	AccTemplatesWithRT.Ref,
		|	AccTemplatesWithRT.RoomType,
		|	NULL
		|FROM
		|	AccTemplatesWithRT AS AccTemplatesWithRT
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	AccommodationTemplatesAccTypes.Ref AS Ref,
		|	AccommodationTemplatesAccTypes.AccommodationType AS AccommodationType
		|INTO AccTemplateAccTypes
		|FROM
		|	Catalog.AccommodationTemplates.AccommodationTypes AS AccommodationTemplatesAccTypes
		|WHERE
		|	NOT AccommodationTemplatesAccTypes.Ref.DeletionMark
		|	AND NOT AccommodationTemplatesAccTypes.Ref.IsForFolioSplit
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	AccommodationTemplates.Ref AS Ref,
		|	AccommodationTemplates.Code AS Code,
		|	MAX(AccommodationTemplatesAccommodationTypes.LineNumber) AS AccTypesCount
		|INTO Total
		|FROM
		|	Catalog.AccommodationTemplates.AccommodationTypes AS AccommodationTemplatesAccommodationTypes
		|		LEFT JOIN Catalog.AccommodationTemplates AS AccommodationTemplates
		|		ON AccommodationTemplatesAccommodationTypes.Ref = AccommodationTemplates.Ref
		|WHERE
		|	NOT AccommodationTemplatesAccommodationTypes.Ref.DeletionMark
		|	AND NOT AccommodationTemplatesAccommodationTypes.Ref.IsForFolioSplit
		|
		|GROUP BY
		|	AccommodationTemplates.Ref,
		|	AccommodationTemplates.Code
		|
		|HAVING
		|	MAX(AccommodationTemplatesAccommodationTypes.LineNumber) = &qGuestsQuantity
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Total.Ref AS Ref,
		|	Total.Code AS Code,
		|	Total.AccTypesCount AS AccTypesCount,
		|	AccTemplateRoomTypes.RoomType AS RoomType,
		|	AccTemplateAccTypes.AccommodationType AS AccommodationType
		|FROM
		|	Total AS Total
		|		LEFT JOIN AccTemplateRoomTypes AS AccTemplateRoomTypes
		|		ON (AccTemplateRoomTypes.Ref = Total.Ref)
		|		LEFT JOIN AccTemplateAccTypes AS AccTemplateAccTypes
		|		ON (AccTemplateAccTypes.Ref = Total.Ref)
		|WHERE
		|	(&qRoomTypeIsFilled
		|				AND AccTemplateRoomTypes.RoomType = &qRoomType
		|			OR NOT &qRoomTypeIsFilled)
		|
		|ORDER BY
		|	Total.Code,
		|	AccTemplateRoomTypes.RoomType.SortCode,
		|	AccTemplateAccTypes.AccommodationType.SortCode";
		vQry.SetParameter("qGuestsQuantity", vGuestsQuantity);
		vQry.SetParameter("qEmptyAT", Catalogs.AccommodationTemplates.EmptyRef());
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qRoomTypeIsFilled", ValueIsFilled(pRoomType));
		vAccTemplatesList = vQry.Execute().Unload();
		vArrayToDelete = New Array;
		vAccTemplatesList.Columns.Add("Age", cmGetNumberTypeDescription(10, 0));
		vAccTemplatesList.Columns.Add("IsMain", cmGetNumberTypeDescription(10, 0));
		If vAccTemplatesList.Count() > 0 Then
			vLastAT = Undefined;
			vError = False;
			vFirstATIndex = 0;
			vTogetherIndex = 0;
			For Each vAccRow In vAccTemplatesList Do
				If vLastAT <> vAccRow.Ref Then
					vLastAT = vAccRow.Ref;
					vATAdultInd = vAdultsQuantity;
					vATKidInd = vKidsQuantity;
					vTogetherIndex = 0;
					If vError Then
						vLastATIndex = vAccTemplatesList.IndexOf(vAccRow)-1;
						For vATInd = vFirstATIndex To vLastATIndex Do
							vArrayToDelete.Add(vAccTemplatesList.Get(vATInd));
						EndDo;
					EndIf;
					vFirstATIndex = vAccTemplatesList.IndexOf(vAccRow);
					vError = False;
				EndIf;
				
				If vAccRow.AccommodationType.AllowedClientAgeTo = 0 Then
					If vAccRow.AccommodationType.Type = Enums.AccomodationTypes.Together Or vAccRow.AccommodationType.Type = Enums.AccomodationTypes.AdditionalBed Then
						vTogetherIndex = vTogetherIndex + 1;
					EndIf;
					If vATAdultInd = 0 Then
						If vTogetherIndex > 0 Then
							vTogetherIndex = vTogetherIndex - 1;
						Else
							vError = True;
						EndIf;
					Else
						If vTogetherIndex > 0 Then
							vTogetherIndex = vTogetherIndex - 1;
						EndIf;
						vATAdultInd = vATAdultInd - 1;
					EndIf;
				Else
					If vATKidInd = 0 Then
						If vTogetherIndex > 0 Then
							vTogetherIndex = vTogetherIndex - 1;
						Else
							vError = True;
						EndIf;
					Else
						vATKidInd = vATKidInd - 1;
					EndIf;
				EndIf;
			EndDo;
			If vError Then
				vLastATIndex = vAccTemplatesList.IndexOf(vAccRow);
				For vATInd = vFirstATIndex To vLastATIndex Do
					vArrayToDelete.Add(vAccTemplatesList.Get(vATInd));
				EndDo;
			EndIf;
			For Each vDelItem In vArrayToDelete Do
				vAccTemplatesList.Delete(vDelItem);
			EndDo;
			vArrayToDelete.Clear();
			If vKidsQuantity > 0 Then
				// Try to find suitable template
				vWrkKidsAgeList = vKidsAgeList.Copy();
				vAdultInd = vAdultsQuantity;
				vKidInd = vKidsQuantity;
				vLastAccTempRef = Catalogs.AccommodationTemplates.EmptyRef();
				vMainAccTempRef = Catalogs.AccommodationTemplates.EmptyRef();
				For Each vRow In vAccTemplatesList Do
					If vLastAccTempRef <> vRow.Ref Then
						If ValueIsFilled(vLastAccTempRef) Then
							// Check results
							If vAdultInd = 0 And vWrkKidsAgeList.Count() = 0 Then
								vMainAccTempRef = vLastAccTempRef;
								Break;
							EndIf;
						EndIf;
						vLastAccTempRef = vRow.Ref;
						vWrkKidsAgeList = vKidsAgeList.Copy();
						vAdultInd = vAdultsQuantity;
						vKidInd = vKidsQuantity;
					EndIf;
					If vRow.AccommodationType.AllowedClientAgeTo <> 0 Then
						vKidWasFound = False;
						For Each vAge In vWrkKidsAgeList Do
							If vRow.AccommodationType.AllowedClientAgeTo > vAge.Value And 
							   (vRow.AccommodationType.AllowedClientAgeFrom < vAge.Value Or vRow.AccommodationType.AllowedClientAgeFrom = 0 And vAge.Value = 0) Then
								vKidInd = vKidInd - 1;
								vRow.Age = vAge.Value;
								vWrkKidsAgeList.Delete(vAge);
								vKidWasFound = True;
								Break;
							EndIf;
						EndDo;
						If Not vKidWasFound Then
							vAdultInd = vAdultInd - 1;
						EndIf;
					Else
						vAdultInd = vAdultInd - 1;
					EndIf;
				EndDo;
				If ValueIsFilled(vLastAccTempRef) Then
					// Check results
					If vAdultInd = 0 And vWrkKidsAgeList.Count() = 0 Then
						vMainAccTempRef = vLastAccTempRef;
					EndIf;
				EndIf;
				If ValueIsFilled(vMainAccTempRef) Then
					i = 0;
					While i < vAccTemplatesList.Count() Do
						vRow = vAccTemplatesList.Get(i);
						If vRow.Ref <> vMainAccTempRef Then
							vAccTemplatesList.Delete(i);
						Else
							vRow.IsMain = 0;
							i = i + 1;
						EndIf;
					EndDo;
					Return vAccTemplatesList;
				EndIf;
				// Try to find any suitable template
				vAdultInd = vAdultsQuantity;
				vKidInd = vKidsQuantity;
				vAddKidInd = vKidsQuantity;
				vMinAddKidInd = vKidsQuantity;
				vInd = 0;
				vLastRT = Catalogs.RoomTypes.EmptyRef();
				vLastAccTempRef = Catalogs.AccommodationTemplates.EmptyRef();
				vMainAccTempRef = Catalogs.AccommodationTemplates.EmptyRef();
				For Each vRow In vAccTemplatesList Do
					vArrayToDelete.Add(vRow);
					vRow.IsMain = 1;
					If vLastAccTempRef <> vRow.Ref Then
						vWrkKidsAgeList = vKidsAgeList.Copy();
						If vAddKidInd < vKidsQuantity And vAddKidInd < vMinAddKidInd Then
							vMainAccTempRef = vLastAccTempRef;
						EndIf;
						If vAddKidInd < vMinAddKidInd Then
							vMinAddKidInd = vAddKidInd;
						EndIf;
						vAddKidInd = vKidsQuantity;
						vLastAccTempRef = vRow.Ref;
					EndIf;
					If vRow.AccommodationType.AllowedClientAgeTo = 0 Then
						If vAdultInd = 0 And (vRow.AccommodationType.Type <> Enums.AccomodationTypes.Together And vRow.AccommodationType.Type <> Enums.AccomodationTypes.AdditionalBed) Then
							vAdultInd = vAdultInd - 1;
						EndIf;
					EndIf;
					If vRow.AccommodationType.AllowedClientAgeTo > 0 Or (vRow.AccommodationType.AllowedClientAgeTo = 0 And vAdultInd = 0 And (vRow.AccommodationType.Type = Enums.AccomodationTypes.Together Or vRow.AccommodationType.Type = Enums.AccomodationTypes.AdditionalBed)) Then
						For Each vAge In vWrkKidsAgeList Do
							If vRow.AccommodationType.AllowedClientAgeTo > vAge.Value Or (vRow.AccommodationType.AllowedClientAgeTo = 0 And vAdultInd = 0 And (vRow.AccommodationType.Type = Enums.AccomodationTypes.Together 
								Or vRow.AccommodationType.Type = Enums.AccomodationTypes.AdditionalBed)) Then
								If vRow.AccommodationType.AllowedClientAgeTo > vAge.Value Then
									vAddKidInd = vAddKidInd - 1;
								EndIf;
								vKidInd = vKidInd - 1;
								vRow.Age = vAge.Value;
								vWrkKidsAgeList.Delete(vAge);
								Break;
							EndIf;
						EndDo;
					EndIf;
					If vRow.AccommodationType.AllowedClientAgeTo = 0 Then
						If vAdultInd > 0 Then
							vAdultInd = vAdultInd - 1;
						EndIf;
					EndIf;
					vInd = vInd + 1;
					If vInd = vGuestsQuantity Then
						If vKidInd = 0 And vAdultInd = 0 Then
							vCount = vArrayToDelete.Count();
							For vDelInd = 1 To vGuestsQuantity Do
								vArrayToDelete.Delete(vCount - vDelInd);
							EndDo;
						EndIf;
						vAdultInd = vAdultsQuantity;
						vKidInd = vKidsQuantity;
						vInd = 0;
					EndIf;
				EndDo;
				If ValueIsFilled(vLastAccTempRef) Then
					If vAddKidInd < vKidsQuantity And vAddKidInd < vMinAddKidInd Then
						vMainAccTempRef = vLastAccTempRef;
					EndIf;
				EndIf;
				For Each vItem In vArrayToDelete Do
					vAccTemplatesList.Delete(vItem);
				EndDo;
				If ValueIsFilled(vMainAccTempRef) Then
					vFindedRows = vAccTemplatesList.FindRows(New Structure("Ref", vMainAccTempRef));
					For Each vFindedRow In vFindedRows Do
						vFindedRow.IsMain = 0;
					EndDo;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	Return vAccTemplatesList;
EndFunction // GetAccommodationTemplatesByGuestsQuantity

// -----------------------------------------------------------------------------
Function cmGetAccommodationTemplateByGuestsQuantityAndRoomType(pNumberOfAdults, pNumberOfTeenagers = 0, pNumberOfChildren = 0, pNumberOfInfants = 0, pRoomType, pHotel, pIsForFolioSplit = False, pDoExtraSearchByAdults = False, pExternalSystemCode = "") Export
	vAccommodationTemplate = Undefined;
	
	// Check parameters
	vHotel = Undefined;
	If TypeOf(pHotel) = Type("String") And Not IsBlankString(pExternalSystemCode) Then
		vHotel = cmGetObjectRefByExternalSystemCode(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", pHotel);
	Else
		vHotel = pHotel;
	EndIf;
	If Not ValueIsFilled(vHotel) Then
		Raise NStr("en='Failed to find hotel by parameters data when searching for accommodation template!'; 
		           |ru='Не удалось найти гостиницу по переданным параметрам при поиске шаблона размещения гостей!';
				   |de='Das Hotel konnte bei der Suche nach einer Vorlage für die Unterbringung von Gästen anhand der übergebenen Parameter nicht gefunden werden!'");
	EndIf;
	vRoomType = Undefined;
	If TypeOf(pRoomType) = Type("String") And Not IsBlankString(pExternalSystemCode) Then
		vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomType);
	Else
		vRoomType = pRoomType;
	EndIf;
	If Not ValueIsFilled(vRoomType) Then
		Raise NStr("en='Failed to find room type by parameters data when searching for accommodation template!'; 
		           |ru='Не удалось найти тип номера по переданным параметрам при поиске шаблона размещения гостей!';
				   |de='Das Zimmertyp konnte bei der Suche nach einer Vorlage für die Unterbringung von Gästen anhand der übergebenen Parameter nicht gefunden werden!'");
	EndIf;
	vRoomClass = vRoomType.RoomClass;
	
	// Try to find template by given guest quantities
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	AccommodationTemplates.Ref AS Ref
	|FROM
	|	Catalog.AccommodationTemplates AS AccommodationTemplates
	|WHERE
	|	(AccommodationTemplates.Hotel = &qHotel OR AccommodationTemplates.Hotel = VALUE(Catalog.Hotels.EmptyRef))
	|	AND (AccommodationTemplates.NumberOfAdults = &qNumberOfAdults
	|			AND AccommodationTemplates.NumberOfTeenagers = &qNumberOfTeenagers
	|			AND AccommodationTemplates.NumberOfChildren = &qNumberOfChildren
	|			AND AccommodationTemplates.NumberOfInfants = &qNumberOfInfants)
	|	AND AccommodationTemplates.IsForFolioSplit = &qIsForFolioSplit
	|
	|ORDER BY
	|	AccommodationTemplates.Code,
	|	AccommodationTemplates.Description";
	vQry.SetParameter("qHotel", vHotel);
	vQry.SetParameter("qRoomType", vRoomType);
	vQry.SetParameter("qNumberOfAdults", pNumberOfAdults);
	vQry.SetParameter("qNumberOfTeenagers", pNumberOfTeenagers);
	vQry.SetParameter("qNumberOfChildren", pNumberOfChildren);
	vQry.SetParameter("qNumberOfInfants", pNumberOfInfants);
	vQry.SetParameter("qIsForFolioSplit", pIsForFolioSplit);
	vTemplates = vQry.Execute().Unload();
	For Each vTemplatesRow In vTemplates Do
		vCurTemplate = vTemplatesRow.Ref;
		
		If vCurTemplate.RoomTypes.Count() > 0 Then
			For Each vRTRow In vCurTemplate.RoomTypes Do
				If vRoomType = vRTRow.RoomType Or ValueIsFilled(vRoomClass) And vRoomClass = vRTRow.RoomClass Then
					vAccommodationTemplate = vCurTemplate;
					Break;
				EndIf;
			EndDo;
		Else
			vAccommodationTemplate = vCurTemplate;
		EndIf;
		If ValueIsFilled(vAccommodationTemplate) Then
			Break;
		EndIf;
	EndDo;
	
	// Check if search was no successfull
	If Not ValueIsFilled(vAccommodationTemplate) Then
		If pDoExtraSearchByAdults And (pNumberOfTeenagers <> 0 Or pNumberOfChildren <> 0 Or pNumberOfInfants <> 0) Then
			vAccommodationTemplate = cmGetAccommodationTemplateByGuestsQuantityAndRoomType(pNumberOfAdults + pNumberOfTeenagers + pNumberOfChildren + pNumberOfInfants, 
			                                                                               0, 0, 0, vRoomType, vHotel, pIsForFolioSplit, False, pExternalSystemCode);
		EndIf;
	EndIf;
	
	Return vAccommodationTemplate;
EndFunction // cmGetAccommodationTemplateByGuestsQuantityAndRoomType

// -----------------------------------------------------------------------------
// Description: Returns annulation status for the given annulation
// -----------------------------------------------------------------------------
Function cmGetReservationAnnulationStatus(pDocRef) Export
	vAnnulationStatus = Catalogs.ReservationStatuses.EmptyRef();
	// Try to find annulation reservation status
	vStatuses = cmGetAllReservationStatuses(True);
	For Each vStatusesRow In vStatuses Do
		vStatusRef = vStatusesRow.ReservationStatus;
		If Not vStatusRef.IsActive And 
		   Not vStatusRef.IsCheckIn And 
		   Not vStatusRef.IsInWaitingList And 
		   Not vStatusRef.IsNoShow And 
		   Not vStatusRef.DoNotCreateReservationsInBlock And 
		   Not vStatusRef.IsPreliminary Then
			vAnnulationStatus = vStatusRef;
			Break;
		EndIf;
	EndDo;
	If ValueIsFilled(pDocRef) And TypeOf(pDocRef) = Type("DocumentRef.Reservation") Then
		If ValueIsFilled(pDocRef.FeeTerms) Then
			vFeeTerms = pDocRef.FeeTerms;
		ElsIf ValueIsFilled(pDocRef.Contract) And ValueIsFilled(pDocRef.Contract.FeeTerms) Then
			vFeeTerms = pDocRef.Contract.FeeTerms;
		ElsIf ValueIsFilled(pDocRef.Customer) And ValueIsFilled(pDocRef.Customer.FeeTerms) Then
			vFeeTerms = pDocRef.Customer.FeeTerms;
		ElsIf ValueIsFilled(pDocRef.RoomRate) And ValueIsFilled(pDocRef.RoomRate.FeeTerms) Then
			vFeeTerms = pDocRef.RoomRate.FeeTerms;
		EndIf;
		If ValueIsFilled(vFeeTerms) And 
		  (ValueIsFilled(vFeeTerms.LateAnnulationStatus) Or ValueIsFilled(vFeeTerms.LateAnnulationStatus1)) Then
			vDays = (pDocRef.CheckInDate - CurrentSessionDate())/(24*3600);
			If vFeeTerms.LateAnnulationPeriod > 0 And vFeeTerms.LateAnnulationPeriod1 > 0 And vFeeTerms.LateAnnulationPeriod <= vFeeTerms.LateAnnulationPeriod1 Then
				If vDays < vFeeTerms.LateAnnulationPeriod Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus;
					EndIf;
				ElsIf vDays < vFeeTerms.LateAnnulationPeriod1 Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus1) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus1;
					EndIf;
				EndIf;
			ElsIf vFeeTerms.LateAnnulationPeriod > 0 And vFeeTerms.LateAnnulationPeriod1 > 0 And vFeeTerms.LateAnnulationPeriod > vFeeTerms.LateAnnulationPeriod1 Then
				If vDays < vFeeTerms.LateAnnulationPeriod1 Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus1) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus1;
					EndIf;
				ElsIf vDays < vFeeTerms.LateAnnulationPeriod Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus;
					EndIf;
				EndIf;
			ElsIf vFeeTerms.LateAnnulationPeriod > 0 Then
				If vDays < vFeeTerms.LateAnnulationPeriod Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus;
					EndIf;
				EndIf;
			ElsIf vFeeTerms.LateAnnulationPeriod1 > 0 Then
				If vDays < vFeeTerms.LateAnnulationPeriod1 Then
					If ValueIsFilled(vFeeTerms.LateAnnulationStatus1) Then
						vAnnulationStatus = vFeeTerms.LateAnnulationStatus1;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	If Not ValueIsFilled(vAnnulationStatus) Then
		Raise NStr("en='There is no reservation annulation status defined in system!';ru='В справочнике статусов брони не найден статус аннуляции брони!';de='Im Verzeichnis der Reservierungsstatus wurde kein Reservierungsstorno-Status gefunden!'");
	EndIf;
	Return vAnnulationStatus;
EndFunction // cmGetReservationAnnulationStatus

// -----------------------------------------------------------------------------
// Description: Returns annulation status for the given annulation
// -----------------------------------------------------------------------------
Function cmGetAccommodationAnnulationStatus(pDocRef) Export
	vAnnulationStatus = Catalogs.AccommodationStatuses.EmptyRef();
	// Try to find annulation reservation status
	vStatuses = cmGetAllAccommodationStatuses();
	For Each vStatusesRow In vStatuses Do
		vStatusRef = vStatusesRow.AccommodationStatus;
		If Not vStatusRef.IsActive And 
		   Not vStatusRef.IsCheckIn And 
		   Not vStatusRef.IsRoomChange And 
		   Not vStatusRef.IsCheckOut Then
			vAnnulationStatus = vStatusRef;
			Break;
		EndIf;
	EndDo;
	If Not ValueIsFilled(vAnnulationStatus) Then
		Raise NStr("en='There is no accommodation annulation status defined in system!';ru='В справочнике статусов размещения гостей не найден статус аннуляции!';de='Im Verzeichnis der Unterbringungsstatus wurde kein Storno-Status gefunden!'");
	EndIf;
	Return vAnnulationStatus;
EndFunction // cmGetAccommodationAnnulationStatus

// -----------------------------------------------------------------------------
// Description: Checks if accommodation type could be used for the given guest age
// -----------------------------------------------------------------------------
Function cmCheckGuestDateOfBirth(pDateOfBirth, pAccommodationType, pCheckInDate, pCheckOutDate, pHotel = Undefined) Export
	If pHotel = Undefined Then
		pHotel = SessionParameters.CurrentHotel;
	EndIf;
	vCheckDate = pCheckInDate;
	vAge = 0;
	// Get guest age on check moment
	vAge = Year(vCheckDate)-Year(pDateOfBirth);
	If (Month(vCheckDate)-Month(pDateOfBirth)) < 0 Then
		vAge = vAge + 1;
	EndIf;
	If pAccommodationType.AllowedClientAgeFrom < vAge And pAccommodationType.AllowedClientAgeTo > vAge Then
		Return True;
	EndIf;
	Return False;
EndFunction // cmCheckGuestDateOfBirth

// -----------------------------------------------------------------------------
// Description: Returns value table with accommodation types and ages
// -----------------------------------------------------------------------------
Function cmGetAvailableAccommodationTypesWithKidsAges(pAdultsQuantity, pKidsQuantity, pAgeArray, pExternalSystemCode, pHotel, pRoomType, pAccommodationTypes = Undefined, pOnlyTheFirstTemplate = False, pNoFolioSplit = False, pChildrenAgesStruct = Undefined, pAccommodationTemplate = Undefined) Export
	vHotel = pHotel;
	vRoomType = pRoomType;
    			
	// Adults quantity
	vAdultsQuantity = pAdultsQuantity;
	// Kids quantity
	vKidsQuantity = pKidsQuantity;
	// Guests quantity
	vGuestsQuantity = vAdultsQuantity + vKidsQuantity;
	
	vKidsAgeList = New ValueList;
	If vKidsQuantity > 0 Then
		vKidsAgeList = GetKidsSortedByAge(pAgeArray);
	EndIf;

	// Get accommodation template ref
	vAccTemplates = GetAccommodationTemplatesByGuestsQuantity(vAdultsQuantity, vKidsQuantity, vKidsAgeList, vRoomType, pHotel, pNoFolioSplit, pChildrenAgesStruct, pAccommodationTemplate);
	
	// Join both tables
	vQry = New Query;
	If pAccommodationTypes = Undefined Then
		vQry.Text =
		"SELECT
		|	Templates.Ref AS Ref,
		|	Templates.IsMain AS IsMain,
		|	Templates.RoomType AS RoomType,
		|	Templates.Code AS Code,
		|	Templates.AccommodationType AS AccommodationType,
		|	Templates.Age AS Age
		|INTO Templates
		|FROM
		|	&qTemplates AS Templates
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT  
		|	Templates.Ref AS AccTemplate,
		|	Templates.AccommodationType AS AccommodationType,
		|	Templates.Age AS Age,
		|	0 AS Amount,
		|	&qEmptyString AS AmountPresentation,
		|	&qEmptyCurrency AS Currency
		|FROM
		|	Templates AS Templates
		|WHERE
		|	Templates.RoomType.Owner = &qHotel
		|	AND	Templates.RoomType = &qRoomType
		|ORDER BY
		|	Templates.IsMain,
		|	Templates.Ref.Code,
		|	Templates.AccommodationType.SortCode";
		vQry.SetParameter("qTemplates", vAccTemplates);
		vQry.SetParameter("qRoomType", vRoomType);
	Else
		vQry.Text =
		"SELECT
		|	AccTypes.AccommodationType AS AccommodationType
		|INTO AccTypes
		|FROM
		|	&qAccTypes AS AccTypes
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT  
		|	&qEmptyTemplate AS AccTemplate,
		|	AccTypes.AccommodationType AS AccommodationType,
		|	0 AS Age,
		|	0 AS Amount,
		|	&qEmptyString AS AmountPresentation,
		|	&qEmptyCurrency AS Currency
		|FROM
		|	AccTypes AS AccTypes
		|ORDER BY
		|	AccTypes.AccommodationType.SortCode";
		vQry.SetParameter("qAccTypes", pAccommodationTypes);
		vQry.SetParameter("qEmptyTemplate", Catalogs.AccommodationTemplates.EmptyRef());
	EndIf;
	vQry.SetParameter("qHotel", vHotel);
	vQry.SetParameter("qEmptyCurrency", Catalogs.Currencies.EmptyRef());
	vQry.SetParameter("qEmptyString", "");
	vAccTypesWithAgeList = vQry.Execute().Unload();
	If pOnlyTheFirstTemplate And vAccTypesWithAgeList.Count() > 0 Then
		vLastTemplateRef = Catalogs.AccommodationTemplates.EmptyRef();
		vRowsToDeleteArray = New Array;
		For Each vRow In vAccTypesWithAgeList Do
			If vLastTemplateRef = Catalogs.AccommodationTemplates.EmptyRef() Then
				vLastTemplateRef = vRow.AccTemplate;
			EndIf;
			If vLastTemplateRef <> Catalogs.AccommodationTemplates.EmptyRef() And vLastTemplateRef <> vRow.AccTemplate Then
				vRowsToDeleteArray.Add(vRow);
			EndIf;
		EndDo;
		For Each vItem In vRowsToDeleteArray Do
			vAccTypesWithAgeList.Delete(vItem);
		EndDo;
	EndIf;
	If vAccTypesWithAgeList.Count() = 0 And cmGetAllAccommodationTemplates(vHotel).Count() = 0 Then
		// Adults
		vAdultsQuantityInd = pAdultsQuantity;
		// Kids
		vKidsQuantityInd = pKidsQuantity;
		vQry = New Query;
		vQryMainText = 
		"SELECT 
		|	AccommodationTypes.Ref AS Ref
		|FROM
		|	Catalog.AccommodationTypes AS AccommodationTypes
		|WHERE
		|	AccommodationTypes.Type = &qType ";
		vQryOrderText =
		" AND NOT AccommodationTypes.DeletionMark
		|	AND NOT AccommodationTypes.IsFolder
		|
		|ORDER BY
		|	AccommodationTypes.SortCode";
		vQry.Text = vQryMainText + " AND AccommodationTypes.NumberOfPersons4Reservation >= &qNOP4Reserv " + vQryOrderText;
		vQry.SetParameter("qType", Enums.AccomodationTypes.Room);
		vQry.SetParameter("qNOP4Reserv", vAdultsQuantityInd);
		vAccList = vQry.Execute().Unload();
		If vAccList.Count() = 0 Then
			vQry.Text = vQryMainText + vQryOrderText;
			vQry.SetParameter("qType", Enums.AccomodationTypes.Room);
			vAccList = vQry.Execute().Unload();
		EndIf;
		If vAccList.Count() > 0 Then
			vNewGuest = vAccTypesWithAgeList.Add();
			vNewGuest.Age = 0;
			If vGuestsQuantity > 1 Then
				If vGuestsQuantity = 2 And vAccList.Count() > 1 Then
					vNewGuest.AccommodationType = vAccList[1].Ref;
				ElsIf vGuestsQuantity = 3 And vAccList.Count() > 2 Then
					vNewGuest.AccommodationType = vAccList[2].Ref;
				ElsIf vGuestsQuantity = 4 And vAccList.Count() > 3 Then
					vNewGuest.AccommodationType = vAccList[3].Ref;
				Else
					vNewGuest.AccommodationType = vAccList[vAccList.Count()-1].Ref;
				EndIf;
			Else
				vNewGuest.AccommodationType = vAccList[0].Ref;
			EndIf;
			vAdultsQuantityInd = vAdultsQuantityInd - 1;
		EndIf;
		vKids = vKidsAgeList.Copy();
		For vInd = 2 To vRoomType.NumberOfBedsPerRoom Do
			vQry.Text = vQryMainText + vQryOrderText;
			vQry.SetParameter("qType", Enums.AccomodationTypes.Together);
			vAccList = vQry.Execute().Unload();
			vAge = 0;
			If vAdultsQuantityInd = 0 Then
				If vKidsQuantityInd > 0 Then
					vAge = vKids[0].Value;
					vKids.Delete(0);
					vKidsQuantityInd = vKidsQuantityInd - 1;
				Else
					Break;
				EndIf;
			Else
				vAdultsQuantityInd = vAdultsQuantityInd - 1;
			EndIf;
			If vAccList.Count() > 0 Then
				vNewGuest = vAccTypesWithAgeList.Add();
				vNewGuest.Age = vAge;
				vNewGuest.AccommodationType = vAccList[0].Ref;
			EndIf;
		EndDo;
		vAddGuestsQuantity = vAdultsQuantityInd + vKidsQuantityInd;
		If vAddGuestsQuantity > 0 Then
			If (vRoomType.NumberOfPersonsPerRoom - vRoomType.NumberOfBedsPerRoom)>vAddGuestsQuantity Then
				vAdditionalBedsQuantity = vAddGuestsQuantity
			Else
				vAdditionalBedsQuantity = vRoomType.NumberOfPersonsPerRoom - vRoomType.NumberOfBedsPerRoom;
			EndIf;
			For vInd = 1 To vAdditionalBedsQuantity Do
				vAge = 0;
				If vAdultsQuantityInd > 0 Then
					vQry.Text = vQryMainText + vQryOrderText;
					vQry.SetParameter("qType", Enums.AccomodationTypes.AdditionalBed);
					vAccList = vQry.Execute().Unload();
					vAdultsQuantityInd = vAdultsQuantityInd - 1;
				Else
					If vKidsQuantityInd > 0 Then
						vAge = vKids[0].Value;
						vKids.Delete(0);
						vQry.Text = vQryMainText + " AND AccommodationTypes.AllowedClientAgeFrom < &qClientAge
						|	AND AccommodationTypes.AllowedClientAgeTo > &qClientAge "
						+ vQryOrderText;
						vQry.SetParameter("qType", Enums.AccomodationTypes.AdditionalBed);
						vQry.SetParameter("qClientAge", vAge);
						vAccList = vQry.Execute().Unload();
						If vAccList.Count() = 0 Then
							vQry.Text = vQryMainText + vQryOrderText;
							vQry.SetParameter("qType", Enums.AccomodationTypes.AdditionalBed);
							vAccList = vQry.Execute().Unload();
						EndIf;
						vKidsQuantityInd = vKidsQuantityInd - 1;
					Else
						Break;
					EndIf;
				EndIf;
				If vAccList.Count() > 0 Then
					vNewGuest = vAccTypesWithAgeList.Add();
					vNewGuest.Age = vAge;
					vNewGuest.AccommodationType = vAccList[0].Ref;
				EndIf;	
			EndDo;
		EndIf;
	EndIf;
	Return vAccTypesWithAgeList;
EndFunction // cmGetAvailableAccommodationTypesWithKidsAges

// -----------------------------------------------------------------------------
// Description: Returns room types balances table with calculated prices
// -----------------------------------------------------------------------------
Function cmGetRoomTypeBalancesTable(pRoomTypes, pExtRoomTypesTable = True, pHotel = Undefined, pPeriodFrom, pPeriodTo, pClientType = Undefined, pCustomer = Undefined, pContract = Undefined, pDiscountType = Undefined, pExtHotelCode = Undefined, pLanguage = Undefined, pExternalSystemCode = Undefined, pRoomType = Undefined, pRoomRate = Undefined, pAccommodationTypes = Undefined, pAdultsQuantity, pKidsQuantity, pAgeArray, pProbeResObj = Undefined, pIsForFolioSplit = Undefined, pServicePackage = Undefined, rAccommodationTemplate = Undefined, pReservationRef = Undefined, rServicesTable = Undefined, pIgnoreRestrictions = False) Export
	// Retrieve language
	vLanguage = pLanguage;
	If pLanguage = Undefined Then
		vLanguage = cmGetLanguageByCode("");
	EndIf;
	vAdultsQuantity = pAdultsQuantity; 
	vKidsQuantity = pKidsQuantity; 
	vAgeArray = pAgeArray;
	vGuestsQuantity = vAdultsQuantity + vKidsQuantity;
	// Retrieve parameter references based on codes
	vHotel = pHotel;
	If pHotel = Undefined Then
		vHotel = SessionParameters.CurrentHotel;
	EndIf;
	vExtHotelCode = pExtHotelCode;
	If pExtHotelCode = Undefined Then
		vExtHotelCode = "";
	EndIf;
	vExternalSystemCode = pExternalSystemCode;
	If pExternalSystemCode = Undefined Then
		vExternalSystemCode = "";
	EndIf;
	vClientType = pClientType;
	If pClientType = Undefined Then
		vClientType = Catalogs.ClientTypes.EmptyRef();
	EndIf;
	vRoomRate = pRoomRate;
	If pRoomRate = Undefined Then
		vRoomRate = Catalogs.RoomRates.EmptyRef();
	EndIf;
	vDiscountType = pDiscountType;
	If pDiscountType = Undefined Then
		vDiscountType = Catalogs.DiscountTypes.EmptyRef();
	EndIf;
	vCustomer = pCustomer;
	If pCustomer = Undefined Then
		vCustomer = Catalogs.Customers.EmptyRef();
	EndIf;
	vContract = pContract;
	If pContract = Undefined Then
		vContract = Catalogs.Contracts.EmptyRef();
	EndIf;
	vServicePackage = pServicePackage;
	If pServicePackage = Undefined Then
		vServicePackage = Catalogs.ServicePackages.EmptyRef();
	EndIf;
	vAccommodationTemplate = Undefined;
	If ValueIsFilled(rAccommodationTemplate) Then
		vAccommodationTemplate = rAccommodationTemplate;
	EndIf;
	
	If rServicesTable <> Undefined And TypeOf(rServicesTable) = Type("ValueTable") Then
		If rServicesTable.Columns.Find("AccTypeIndex") = Undefined Then
			rServicesTable.Columns.Add("AccTypeIndex", cmGetNumberTypeDescription(6, 0));
		EndIf;
	EndIf;
	
	// Add columns with hotel, room type, accommodation type and calendar day type external codes
	If pExtRoomTypesTable Then
		vRoomTypeBalances = New ValueTable();
		vRoomTypeBalances.Columns.Add("ExtHotelCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("ExtRoomTypeCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
		vRoomTypeBalances.Columns.Add("RoomTypeCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomTypeDescription", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("ExtRoomRateCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomRate", cmGetCatalogTypeDescription("RoomRates"));
		vRoomTypeBalances.Columns.Add("RoomRateCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomRateDescription", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("Currency", cmGetCatalogTypeDescription("Currencies"));
		vRoomTypeBalances.Columns.Add("ExtCurrencyCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("CurrencyCode", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("CurrencyDescription", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("AccommodationTemplate", cmGetCatalogTypeDescription("AccommodationTemplates"));
		vRoomTypeBalances.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
		vRoomTypeBalances.Columns.Add("FirstDaySum", cmGetNumberTypeDescription(17, 2));
		vRoomTypeBalances.Columns.Add("AmountBeforeDiscount", cmGetNumberTypeDescription(17, 2));
		vRoomTypeBalances.Columns.Add("Amount", cmGetNumberTypeDescription(17, 2));
		vRoomTypeBalances.Columns.Add("AmountPresentation", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomTypePictureLink", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomTypeInfoLink", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("RoomsAvailable", cmGetNumberTypeDescription(10, 0));
		vRoomTypeBalances.Columns.Add("BedsAvailable", cmGetNumberTypeDescription(10, 0));
		vRoomTypeBalances.Columns.Add("LimitedRoomsText", cmGetStringTypeDescription());
		vRoomTypeBalances.Columns.Add("Age", cmGetNumberTypeDescription(3, 0));
		vRoomTypeBalances.Columns.Add("LastReservationDate", cmGetDateTimeTypeDescription());
	EndIf;
	
	// Build probe reservation object to calaculate services
	If pProbeResObj <> Undefined Then
		vProbeResObj = pProbeResObj;
		vProbeResObj.OccupationPercents.Clear();
		vProbeResObj.Services.Clear();
	Else
		vProbeResObj = Documents.Reservation.CreateDocument();
		vProbeResObj.Hotel = vHotel;
		vProbeResObj.pmFillAttributesWithDefaultValues(True);
	EndIf;
	vProbeResObj.PriceCalculationDate = Undefined;
	vProbeResObj.ClientType = vClientType;
	vProbeResObj.Customer = vCustomer;
	vProbeResObj.Contract = vContract;
	vProbeResObj.ServicePackage = vServicePackage;

	If vRoomRate <> Undefined Then
		vProbeResObj.RoomRate = vRoomRate;
	EndIf;

	If ValueIsFilled(vProbeResObj.Contract) And ValueIsFilled(vProbeResObj.Contract.AgentCommissionType) Then
		// Agent commission
		If Not vProbeResObj.Contract.IsSubagent Then
			vProbeResObj.Agent = vProbeResObj.Contract.Agent;
			If ValueIsFilled(vProbeResObj.Customer) And ValueIsFilled(vProbeResObj.Contract.AgentCommissionType) Then
				If Not ValueIsFilled(vProbeResObj.Agent) Then
					vProbeResObj.Agent = vProbeResObj.Customer;
				EndIf;
				vProbeResObj.AgentCommission = vProbeResObj.Contract.AgentCommission;
				vProbeResObj.AgentCommissionType = vProbeResObj.Contract.AgentCommissionType;
				vProbeResObj.AgentCommissionServiceGroup = vProbeResObj.Contract.AgentCommissionServiceGroup;
			EndIf;
		Else
			vAgent = vProbeResObj.Contract.Owner;
			vProbeResObj.Agent = vAgent;
			If ValueIsFilled(vAgent.Agent) Then
				vProbeResObj.Agent = vAgent.Agent;
			EndIf;
			If vAgent.AgentCommission <> 0 Then
				vProbeResObj.AgentCommission = vAgent.AgentCommission;
				vProbeResObj.AgentCommissionType = vAgent.AgentCommissionType;
				vProbeResObj.AgentCommissionServiceGroup = vAgent.AgentCommissionServiceGroup;
			EndIf;
		EndIf;
		If Not ValueIsFilled(vProbeResObj.Agent) Then
			vProbeResObj.AgentCommission = 0;
			vProbeResObj.AgentCommissionType = Undefined;
			vProbeResObj.AgentCommissionServiceGroup = Catalogs.ServiceGroups.EmptyRef();
		EndIf;
		// Room rate
		vChangeRR = False;
		If ValueIsFilled(vProbeResObj.RoomRate) Then
			vFindedRR = vProbeResObj.Contract.RoomRates.Find(vProbeResObj.RoomRate, "RoomRate");
			If vFindedRR = Undefined And vProbeResObj.RoomRate <> vProbeResObj.Contract.RoomRate Then
				vChangeRR = True;
			EndIf;
		Else
			vChangeRR = True;
		EndIf;
		If vChangeRR Then
			If ValueIsFilled(vProbeResObj.Contract.RoomRate) Then
				vProbeResObj.RoomRate = vProbeResObj.Contract.RoomRate;
				vProbeResObj.RoomRateServiceGroup = vProbeResObj.Contract.RoomRateServiceGroup;
			ElsIf ValueIsFilled(vProbeResObj.Customer) And ValueIsFilled(vProbeResObj.Customer.RoomRate) Then
				vProbeResObj.RoomRate = vProbeResObj.Customer.RoomRate;
				vProbeResObj.RoomRateServiceGroup = vProbeResObj.Customer.RoomRateServiceGroup;
			ElsIf ValueIsFilled(vProbeResObj.Hotel) And ValueIsFilled(vProbeResObj.Hotel.RoomRate) Then
				vProbeResObj.RoomRate = vProbeResObj.Hotel.RoomRate;
				vProbeResObj.RoomRateServiceGroup = vProbeResObj.Hotel.RoomRateServiceGroup;
			EndIf;
			// Client type
			If ValueIsFilled(vProbeResObj.RoomRate) And ValueIsFilled(vProbeResObj.RoomRate.ClientType) Then
				vProbeResObj.ClientType = vProbeResObj.RoomRate.ClientType;
				vProbeResObj.ClientTypeConfirmationText = vProbeResObj.RoomRate.ClientTypeConfirmationText;
			EndIf;
		EndIf;
		// Client type
		If ValueIsFilled(vProbeResObj.Contract.ClientType) Then
			vProbeResObj.ClientType = vProbeResObj.Contract.ClientType;
			vProbeResObj.ClientTypeConfirmationText = vProbeResObj.Contract.ClientTypeConfirmationText;
		EndIf;
		// Charging rules
		vProbeResObj.pmLoadChargingRules(vProbeResObj.Contract);
	EndIf;
	If ValueIsFilled(vProbeResObj.RoomRate) Then
		vProbeResObj.RoomRateType = vProbeResObj.RoomRate.RoomRateType;
	EndIf;
	If ValueIsFilled(vProbeResObj.RoomRate) And vProbeResObj.RoomRate.DurationCalculationRuleType <> Enums.DurationCalculationRuleTypes.ByReferenceHour Then
		vProbeResObj.CheckInDate = cm1SecondShift(pPeriodFrom);
		vProbeResObj.CheckOutDate = cm0SecondShift(pPeriodTo);
	Else
		vReferenceHour = cmGetReferenceHour(vProbeResObj.RoomRate);
		vCheckInTime = cmGetDefaultCheckInTime(vProbeResObj.RoomRate);
		vPeriodFrom = BegOfDay(pPeriodFrom)+(vCheckInTime-BegOfDay(vCheckInTime));
		vPeriodTo = BegOfDay(pPeriodTo)+(vReferenceHour-BegOfDay(vReferenceHour));
		If pPeriodFrom = pPeriodTo Then
			vPeriodTo = EndOfDay(pPeriodTo);
		EndIf;
		vProbeResObj.CheckInDate = cm1SecondShift(vPeriodFrom);
		vProbeResObj.CheckOutDate = cm0SecondShift(vPeriodTo);
	EndIf;
	vProbeResObj.Duration = vProbeResObj.pmCalculateDuration();
	vProbeResObj.pmSetDiscounts();
	If ValueIsFilled(vDiscountType) And ValueIsFilled(vProbeResObj.RoomRate) And Not vProbeResObj.RoomRate.NoDiscounts Then
		vProbeResObj.DiscountType = vDiscountType;
		vProbeResObj.DiscountServiceGroup = vDiscountType.DiscountServiceGroup;
		vProbeResObj.Discount = vProbeResObj.DiscountType.GetObject().pmGetDiscount(vProbeResObj.CheckInDate, , vProbeResObj.Hotel);
	EndIf;
	
	// Build structure with children ages
	vChildrenAgesStruct = Undefined;
	If ValueIsFilled(vProbeResObj.Contract) Then
		vAllotmentContract = vProbeResObj.Contract;
		If vAllotmentContract.TeenagersMaxAge <> 0 Or vAllotmentContract.ChildrenMaxAge <> 0 Or vAllotmentContract.InfantsMaxAge <> 0 Then
			vChildrenAgesStruct = vAllotmentContract;
		EndIf;
	EndIf;
	
	// Fill some attributes from the parameter document
	If ValueIsFilled(pReservationRef) And ValueIsFilled(vRoomRate) And pReservationRef.RoomRate = vRoomRate Then
		vProbeResObj.ClientType = pReservationRef.ClientType;
		vProbeResObj.DiscountCard = pReservationRef.DiscountCard;
		vProbeResObj.Discount = pReservationRef.Discount;
		vProbeResObj.DiscountSum = pReservationRef.DiscountSum;
		vProbeResObj.DiscountType = pReservationRef.DiscountType;
		vProbeResObj.DiscountServiceGroup = pReservationRef.DiscountServiceGroup;
		vProbeResObj.TurnOffAutomaticDiscounts = pReservationRef.TurnOffAutomaticDiscounts;
		vProbeResObj.Services.Load(pReservationRef.Services.Unload());
		vProbeResObj.PriceCalculationDate = pReservationRef.PriceCalculationDate;
		vProbeResObj.RoomQuota = pReservationRef.RoomQuota;
		vProbeResObj.NumberOfPersons = pReservationRef.NumberOfPersons;
		vProbeResObj.NumberOfAdults = pReservationRef.NumberOfAdults;
		vProbeResObj.NumberOfTeenagers = pReservationRef.NumberOfTeenagers;
		vProbeResObj.NumberOfChildren = pReservationRef.NumberOfChildren;
		vProbeResObj.NumberOfInfants = pReservationRef.NumberOfInfants;
		If ValueIsFilled(vRoomRate.PriceTagType) And 
		   (BegOfDay(vProbeResObj.CheckInDate) <> BegOfDay(pReservationRef.CheckInDate) Or BegOfDay(vProbeResObj.CheckOutDate) <> BegOfDay(pReservationRef.CheckOutDate)) Then
			vProbeResObj.Services.Clear();
		EndIf;
	EndIf;
	
	// Do for each room type in balances
	vCurrency = vHotel.ReportingCurrency;
	If pExtRoomTypesTable Then
		vLastRoomType = Catalogs.RoomTypes.EmptyRef();
		For Each vRoomTypesRow In pRoomTypes Do
			vError = False;
			If vRoomTypesRow.RoomType <> vLastRoomType Then
				vProbeResObj.RoomType = vRoomTypesRow.RoomType;
				vProbeResObj.RoomTypeUpgrade = Catalogs.RoomTypes.EmptyRef();
				If ValueIsFilled(vRoomTypesRow.RoomType.BaseRoomType) Then
					vProbeResObj.RoomType = vRoomTypesRow.RoomType.BaseRoomType;
					vProbeResObj.RoomTypeUpgrade = vRoomTypesRow.RoomType;
				EndIf;
				vLastRoomType = vRoomTypesRow.RoomType;
				
				vProbeResObj.pmClearOccupationPercents();
				If Not ValueIsFilled(pReservationRef) Or ValueIsFilled(pReservationRef) And pReservationRef.RoomRate <> vProbeResObj.RoomRate Then
					vProbeResObj.Services.Clear();
				EndIf;
				
				// Get active special offers
				If ValueIsFilled(vHotel) And (vHotel.TeenagersMaxAge <> 0 Or vHotel.ChildrenMaxAge <> 0 Or vHotel.InfantsMaxAge <> 0) Then
					vOffers = cmGetConfirmedSpecialOffersForReservation(Undefined, vHotel, vProbeResObj.RoomRate, vProbeResObj.RoomRateType, vProbeResObj.Guest, vProbeResObj.ClientType, vProbeResObj.Customer, vProbeResObj.CustomerType, vProbeResObj.GuestGroup, vProbeResObj.SourceOfBusiness, vProbeResObj.MarketingCode, vProbeResObj.TripPurpose, vProbeResObj.CheckInDate, vProbeResObj.Duration, vProbeResObj.CheckOutDate, CurrentSessionDate(), vProbeResObj.RoomType);
					For Each vOffersRow In vOffers Do
						vOffer = vOffersRow.SpecialOffer;
						If vOffer.TeenagersMaxAge <> 0 Or vOffer.ChildrenMaxAge <> 0 Or vOffer.InfantsMaxAge <> 0 Then
							vChildrenAgesStruct = vOffer;
							Break;
						EndIf;
					EndDo;
				EndIf;
			EndIf;
			
			If Not pIgnoreRestrictions Then
				If Not cmCheckRoomRateRestrictions(vProbeResObj.Hotel, vProbeResObj.RoomRate, vProbeResObj.RoomType, vProbeResObj.CheckInDate, vProbeResObj.CheckOutDate, vProbeResObj.Duration) Then
					Continue;
				EndIf;
			EndIf;
			
			// Get accommodation types table with ages
			If ValueIsFilled(vAccommodationTemplate) Then
				vAccTypesWithAgeList = New ValueTable();
				vAccTypesWithAgeList.Columns.Add("AccTemplate", cmGetCatalogTypeDescription("AccommodationTemplates"));
				vAccTypesWithAgeList.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
				vAccTypesWithAgeList.Columns.Add("Age", cmGetNumberTypeDescription(10, 0));
				For Each vATAccTypesRow In vAccommodationTemplate.AccommodationTypes Do
					vAccTypesWithAgeListRow = vAccTypesWithAgeList.Add();
					vAccTypesWithAgeListRow.AccTemplate = vAccommodationTemplate;
					vAccTypesWithAgeListRow.AccommodationType = vATAccTypesRow.AccommodationType;
					vAccTypesWithAgeListRow.Age = 0;
				EndDo;
			Else
				vAccTypesWithAgeList = cmGetAvailableAccommodationTypesWithKidsAges(vAdultsQuantity, vKidsQuantity, vAgeArray, vExternalSystemCode, vHotel, vRoomTypesRow.RoomType, pAccommodationTypes, False, False, vChildrenAgesStruct);
			EndIf;
			
			// Get accommodation types for current room type
			If vAccTypesWithAgeList.Count() = 0 Then
				Continue;
			EndIf;
			
			// Process accommodation types
			vLastAT = Undefined;
			vATError = Undefined;
			vFindedAT = Undefined;
			vArrayOfRowsToDelete = New Array;
			vOverrides = New ValueTable();
			vAccommodationTypesRow = Undefined;
			For Each vAccommodationTypesRow In vAccTypesWithAgeList Do
				If vAccommodationTypesRow.AccTemplate = Undefined Then
					vAccommodationTypesRow.AccTemplate = Catalogs.AccommodationTemplates.EmptyRef();
				EndIf;
				If vLastAT <> vAccommodationTypesRow.AccTemplate Then
					If vATError<>Undefined And vATError Then
						vFindedRowsToDelete = vRoomTypeBalances.FindRows(New Structure("AccommodationTemplate, RoomType", vLastAT, vRoomTypesRow.RoomType));
						For Each vItem In vFindedRowsToDelete Do
							vArrayOfRowsToDelete.Add(vItem);
						EndDo;
						vLastAT = Undefined;
						vFindedAT = Undefined;
						vATError = False;
					EndIf;
					If (vATError = Undefined Or Not vATError) And vLastAT <> Undefined Then
						vFindedAT = vLastAT;
						Break;
					EndIf;
					vLastAT = vAccommodationTypesRow.AccTemplate;
				EndIf;
				If vATError <> Undefined And vATError Then
					Continue;
				EndIf;
				vProbeResObj.AccommodationType = vAccommodationTypesRow.AccommodationType;
				
				rAccommodationTemplate = vAccommodationTypesRow.AccTemplate;
				
				vAccTypeIndex = vAccTypesWithAgeList.IndexOf(vAccommodationTypesRow);
				If vAccTypeIndex = 0 Then
					vProbeResObj.AccommodationTemplate = rAccommodationTemplate;
				Else
					vProbeResObj.AccommodationTemplate = Catalogs.AccommodationTemplates.EmptyRef();
					vProbeResObj.ServicePackages.Clear();
					vProbeResObj.Prices.Clear();
				EndIf;

				vAccTypesRow = Undefined;
				If pAccommodationTypes <> Undefined And TypeOf(pAccommodationTypes)	= Type("ValueTable") Then
					If vAccTypeIndex < pAccommodationTypes.Count() Then
						vAccTypesRow = pAccommodationTypes.Get(vAccTypeIndex);
						If ValueIsFilled(vAccTypesRow.AccommodationType) Then
							vProbeResObj.AccommodationType = vAccTypesRow.AccommodationType;
						EndIf;
						If pAccommodationTypes.Columns.Find("RoomRate") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
							vProbeResObj.RoomRate = vAccTypesRow.RoomRate;
							vProbeResObj.RoomRateType = vAccTypesRow.RoomRate.RoomRateType;
						EndIf;
						If pAccommodationTypes.Columns.Find("ClientType") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
							vProbeResObj.ClientType = vAccTypesRow.ClientType;
						EndIf;
						If pAccommodationTypes.Columns.Find("ServicePackage") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
							vProbeResObj.ServicePackage = vAccTypesRow.ServicePackage;
						EndIf;
						If pAccommodationTypes.Columns.Find("DiscountType") <> Undefined Then
							vProbeResObj.DiscountType = vAccTypesRow.DiscountType;
							If ValueIsFilled(vProbeResObj.DiscountType) Then
								vProbeResObj.DiscountServiceGroup = vProbeResObj.DiscountType.DiscountServiceGroup;
								vProbeResObj.pmSetDiscounts();
								If ValueIsFilled(vProbeResObj.DiscountType) Then
									vProbeResObj.Discount = vProbeResObj.DiscountType.GetObject().pmGetDiscount(vProbeResObj.CheckInDate, , vProbeResObj.Hotel);
								EndIf;
							Else
								If pAccommodationTypes.Columns.Find("Discount") <> Undefined Then
									vProbeResObj.Discount = vAccTypesRow.Discount;
								EndIf;
							EndIf;
						EndIf;
					EndIf;
				EndIf;
				
				// Get room rate accommodation type overrides
				If ValueIsFilled(vProbeResObj.AccommodationTemplate) Then
					vOverrides = cmGetRoomRateOverrides(vProbeResObj.RoomRate, vProbeResObj.Hotel, vProbeResObj.AccommodationTemplate, ?(ValueIsFilled(vProbeResObj.RoomTypeUpgrade), vProbeResObj.RoomTypeUpgrade, vProbeResObj.RoomType));
				EndIf;
				If vOverrides.Count() > 0 Then
					vOverrideRows = vOverrides.FindRows(New Structure("AccommodationType, TemplateLineNumber", vProbeResObj.AccommodationType, vAccTypeIndex + 1));
					If vOverrideRows.Count() > 0 And ValueIsFilled(vOverrideRows.Get(0).ToAccommodationType) Then
						vProbeResObj.AccommodationType = vOverrideRows.Get(0).ToAccommodationType;
						If vAccTypesRow <> Undefined Then
							vAccTypesRow.AccommodationType = vProbeResObj.AccommodationType;
						EndIf;
						If vAccommodationTypesRow <> Undefined Then
							vAccommodationTypesRow.AccommodationType = vProbeResObj.AccommodationType;
						EndIf;
					EndIf;
				EndIf;
				
				// Calculate resources
				vProbeResObj.pmCalculateResources(True);
				// Automatic services list calculation
				vProbeResObj.pmCalculateServices(, , , , , False, pIgnoreRestrictions);
				
				// Check if there are any services for this accommodation type
				vRoomRevenueServices = vProbeResObj.Services.FindRows(New Structure("IsRoomRevenue", True));
				
				// Calculate accommodation type amount
				vAccTypeAmountBeforeDiscount = vProbeResObj.Services.Total("Sum");
				vAccTypeAmount = vProbeResObj.Services.Total("Sum") - vProbeResObj.Services.Total("DiscountSum");
				
				// Get currency
				For Each vSrvRow In vProbeResObj.Services Do
					If vSrvRow.IsRoomRevenue Then
						vCurrency = vSrvRow.FolioCurrency;
						Break;
					EndIf;
				EndDo;
				
				// Check if there are any services is in price
				vIsInPriceServices = vProbeResObj.Services.FindRows(New Structure("IsInPrice", True));
				vFirstDaySum = 0;
				vCheckInDate = BegOfDay(vProbeResObj.CheckInDate);
				vCheckInCurrency = vCurrency;
				For Each vIsInPriceServicesRow In vIsInPriceServices Do
					If vIsInPriceServicesRow.AccountingDate <> vCheckInDate Then
						Break;
					Else
						vCheckInDate = vIsInPriceServicesRow.AccountingDate;
						If vCheckInCurrency = Undefined Then
							vCheckInCurrency = vIsInPriceServicesRow.FolioCurrency;
						ElsIf vCheckInCurrency <> vIsInPriceServicesRow.FolioCurrency Then
							Continue;
						EndIf;
						vFirstDaySum = vFirstDaySum + Round((vIsInPriceServicesRow.Sum - vIsInPriceServicesRow.DiscountSum)/?(vIsInPriceServicesRow.Quantity = 0, 1, vIsInPriceServicesRow.Quantity), 2);
					EndIf;
				EndDo;
				If rServicesTable <> Undefined Then
					For Each vProbeResServicesRow In vProbeResObj.Services Do
						vServicesTableRow = rServicesTable.Add();
						FillPropertyValues(vServicesTableRow, vProbeResServicesRow);
						If TypeOf(vServicesTableRow) = Type("ValueTableRow") Then
							vServicesTableRow.AccTypeIndex = vAccTypeIndex;
						EndIf;
					EndDo;
				EndIf;
				
				// Save amount to the accommodation types value table
				vRoomTypeBalancesRow = vRoomTypeBalances.Add();
				vRoomTypeBalancesRow.Age = vAccommodationTypesRow.Age;
				vRoomTypeBalancesRow.AccommodationTemplate = vAccommodationTypesRow.AccTemplate;
				vRoomTypeBalancesRow.AccommodationType = vAccommodationTypesRow.AccommodationType;
				vRoomTypeBalancesRow.Currency = vCurrency;
				vRoomTypeBalancesRow.ExtHotelCode = vExtHotelCode;
				vRoomTypeBalancesRow.RoomType = vRoomTypesRow.RoomType;
				vRoomTypeObj = vRoomTypesRow.RoomType.GetObject();
				vRoomTypeBalancesRow.RoomTypeCode = TrimAll(vRoomTypeObj.Code);
				vRoomTypeBalancesRow.RoomTypeDescription = vRoomTypeObj.pmGetRoomTypeDescription(vLanguage);
				vRoomTypeBalancesRow.ExtRoomTypeCode = cmGetObjectExternalSystemCodeByRef(vHotel, vExternalSystemCode, "RoomTypes", vRoomTypesRow.RoomType);
				If IsBlankString(vRoomTypeBalancesRow.ExtRoomTypeCode) Then
					vRoomTypeBalancesRow.ExtRoomTypeCode = TrimAll(vRoomTypeObj.Description);
				EndIf;
				vRoomTypeBalancesRow.ExtRoomTypeCode = Left(vRoomTypeBalancesRow.ExtRoomTypeCode, 36);
				vRoomTypeBalancesRow.RoomTypePictureLink = TrimAll(vRoomTypeObj.RoomTypePictureLink);
				If Not IsBlankString(vRoomTypeObj.RoomTypeInfoLink) Then
					vRoomTypeBalancesRow.RoomTypeInfoLink = cmNStr(vRoomTypeObj.RoomTypeInfoLink, vLanguage);
				Else
					vRoomTypeBalancesRow.RoomTypeInfoLink = "";
				EndIf;
				vRoomTypeBalancesRow.RoomRate = vProbeResObj.RoomRate;
				vRoomRateObj = vProbeResObj.RoomRate.GetObject();
				vRoomTypeBalancesRow.RoomRateCode = TrimAll(vRoomRateObj.Code);
				vRoomTypeBalancesRow.RoomRateDescription = vRoomRateObj.pmGetRoomRateDescription(vLanguage);
				vRoomTypeBalancesRow.ExtRoomRateCode = cmGetObjectExternalSystemCodeByRef(vHotel, vExternalSystemCode, "RoomRates", vProbeResObj.RoomRate);
				If IsBlankString(vRoomTypeBalancesRow.ExtRoomRateCode) Then
					vRoomTypeBalancesRow.ExtRoomRateCode = TrimAll(vRoomRateObj.Description);
				EndIf;
				vRoomTypeBalancesRow.ExtRoomRateCode = Left(vRoomTypeBalancesRow.ExtRoomRateCode, 36);
				vRoomTypeBalancesRow.ExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vHotel, vExternalSystemCode, "Currencies", vCurrency);
				If IsBlankString(vRoomTypeBalancesRow.ExtCurrencyCode) Then
					vRoomTypeBalancesRow.ExtCurrencyCode = TrimAll(vCurrency.Description);
				EndIf;
				vRoomTypeBalancesRow.CurrencyCode = TrimAll(vCurrency.Code);
				vRoomTypeBalancesRow.CurrencyDescription = TrimAll(vCurrency.Description);
				vRoomTypeBalancesRow.FirstDaySum = vFirstDaySum;
				vRoomTypeBalancesRow.AmountBeforeDiscount = vAccTypeAmountBeforeDiscount;
				vRoomTypeBalancesRow.Amount = vAccTypeAmount;
				vRoomTypeBalancesRow.AmountPresentation = cmFormatSum(vAccTypeAmount, vCurrency, "NZ=");
				vRoomTypeBalancesRow.RoomsAvailable = vRoomTypesRow.RoomsAvailable;
				vRoomTypeBalancesRow.BedsAvailable = vRoomTypesRow.BedsAvailable;
				vRoomTypeBalancesRow.LimitedRoomsText = "";
				If vRoomTypeObj.LimitedRooms > 0 And vRoomTypeBalancesRow.RoomsAvailable > 0 And 
					vRoomTypeBalancesRow.RoomsAvailable <= vRoomTypeObj.LimitedRooms Then
					If vRoomTypeBalancesRow.RoomsAvailable = 1 Then
						vRoomTypeBalancesRow.LimitedRoomsText = cmNStr("en='Only ';ru='Остался только ';de='Übrig nur '", vLanguage) + Format(vRoomTypeBalancesRow.RoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' room left';ru=' номер';de=' Zimmer(n)'", vLanguage);
					ElsIf vRoomTypeBalancesRow.RoomsAvailable >= 2 And vRoomTypeBalancesRow.RoomsAvailable < 5 Then
						vRoomTypeBalancesRow.LimitedRoomsText = cmNStr("en='Only ';ru='Осталось только ';de='Übrig nur '", vLanguage) + Format(vRoomTypeBalancesRow.RoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' rooms left';ru=' номера';de=' Zimmer(n)'", vLanguage);
					Else
						vRoomTypeBalancesRow.LimitedRoomsText = cmNStr("en='Only ';ru='Осталось только ';de='Übrig nur '", vLanguage) + Format(vRoomTypeBalancesRow.RoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' rooms left';ru=' номеров';de=' Zimmer(n)'", vLanguage);
					EndIf;
				EndIf;
				vRoomTypeBalancesRow.LastReservationDate = vRoomTypesRow.LastReservationDate;
				
				// Reset services list
				If Not ValueIsFilled(pReservationRef) Or ValueIsFilled(pReservationRef) And pReservationRef.RoomRate <> vProbeResObj.RoomRate Then
					vProbeResObj.Services.Clear();
				EndIf;
			EndDo;
			If (vATError = Undefined Or Not vATError) And vLastAT<>Undefined Then
				vFindedAT = vLastAT;
			EndIf;
			For Each vArrayItem In vArrayOfRowsToDelete Do
				vRoomTypeBalances.Delete(vArrayItem);
			EndDo;
			If Not ValueIsFilled(vFindedAT) And vFindedAT<>Catalogs.AccommodationTemplates.EmptyRef() Then
				vFindedRowsToDelete = vRoomTypeBalances.FindRows(New Structure("RoomType", vRoomTypesRow.RoomType));
				For Each vItem In vFindedRowsToDelete Do
					vRoomTypeBalances.Delete(vItem);
				EndDo;
				Continue;
			EndIf;
		EndDo;
	Else 
		vFindedRow = pRoomTypes.Find(pRoomType, "RoomType");
		If vFindedRow = Undefined And ValueIsFilled(pRoomType) Then
			vMessage = New UserMessage;
			vMessage.Text = NStr("en = 'The number of guests in current room type can not accommodate'; 
								 |de = 'Im Zimmer des gewählten Typs kann die genannten Anzahl von Gästen nicht untergebracht werden'; 
								 |ru = 'В выбранный тип номера указанное число гостей разместить нельзя'");
			vMessage.Field = "SelRoomType";
			vMessage.Message();
		Else
			vRoomTypeBalances = New ValueTable;
			vRoomTypeBalances.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
			vRoomTypeBalances.Columns.Add("AccommodationTemplate", cmGetCatalogTypeDescription("AccommodationTemplates"));
			vRoomTypeBalances.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
			vRoomTypeBalances.Columns.Add("FirstDaySum", cmGetNumberTypeDescription(17, 2));
			vRoomTypeBalances.Columns.Add("AmountBeforeDiscount", cmGetNumberTypeDescription(17, 2));
			vRoomTypeBalances.Columns.Add("Amount", cmGetNumberTypeDescription(17, 2));
			vRoomTypeBalances.Columns.Add("AmountPresentation", cmGetStringTypeDescription());
			vRoomTypeBalances.Columns.Add("Currency", cmGetCatalogTypeDescription("Currencies"));
			vRoomTypesList = New ValueList;
			vRowsToDeleteArray = New Array;
			If ValueIsFilled(pRoomType) Then
				vFindedRowIndex = pRoomTypes.IndexOf(vFindedRow);
				vRoomTypesList.Add(vFindedRow.RoomType);
				If vFindedRowIndex > 0 Then
					vPrevIndex = vFindedRowIndex - 1;
					vRoomTypesList.Add(pRoomTypes.Get(vPrevIndex).RoomType);
				EndIf;
				If vFindedRowIndex < (pRoomTypes.Count() - 1) Then
					vNextIndex = vFindedRowIndex + 1;
					vRoomTypesList.Add(pRoomTypes.Get(vNextIndex).RoomType);
				EndIf;
			Else
				For Each vRow In pRoomTypes Do
					vRoomTypesList.Add(vRow.RoomType);
				EndDo;
			EndIf;
			vLastRoomType = Catalogs.RoomTypes.EmptyRef();
			For Each vRTItem In vRoomTypesList Do
				// Get active special offers
				If ValueIsFilled(vHotel) And (vHotel.TeenagersMaxAge <> 0 Or vHotel.ChildrenMaxAge <> 0 Or vHotel.InfantsMaxAge <> 0) Then
					vOffers = cmGetConfirmedSpecialOffersForReservation(Undefined, vHotel, vProbeResObj.RoomRate, vProbeResObj.RoomRateType, vProbeResObj.Guest, vProbeResObj.ClientType, vProbeResObj.Customer, vProbeResObj.CustomerType, vProbeResObj.GuestGroup, vProbeResObj.SourceOfBusiness, vProbeResObj.MarketingCode, vProbeResObj.TripPurpose, vProbeResObj.CheckInDate, vProbeResObj.Duration, vProbeResObj.CheckOutDate, CurrentSessionDate(), vRTItem.Value);
					For Each vOffersRow In vOffers Do
						vOffer = vOffersRow.SpecialOffer;
						If vOffer.TeenagersMaxAge <> 0 Or vOffer.ChildrenMaxAge <> 0 Or vOffer.InfantsMaxAge <> 0 Then
							vChildrenAgesStruct = vOffer;
							Break;
						EndIf;
					EndDo;
				EndIf;
				// Get accommodation types table with ages
				If ValueIsFilled(vAccommodationTemplate) Then
					vAccTypesWithAgeList = New ValueTable();
					vAccTypesWithAgeList.Columns.Add("AccTemplate", cmGetCatalogTypeDescription("AccommodationTemplates"));
					vAccTypesWithAgeList.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
					vAccTypesWithAgeList.Columns.Add("Age", cmGetNumberTypeDescription(10, 0));
					For Each vATAccTypesRow In vAccommodationTemplate.AccommodationTypes Do
						vAccTypesWithAgeListRow = vAccTypesWithAgeList.Add();
						vAccTypesWithAgeListRow.AccTemplate = vAccommodationTemplate;
						vAccTypesWithAgeListRow.AccommodationType = vATAccTypesRow.AccommodationType;
						vAccTypesWithAgeListRow.Age = 0;
					EndDo;
				Else
					vAccTypesWithAgeList = cmGetAvailableAccommodationTypesWithKidsAges(vAdultsQuantity, vKidsQuantity, vAgeArray, vExternalSystemCode, vHotel, vRTItem.Value, pAccommodationTypes, False, False, vChildrenAgesStruct);
				EndIf;
				If vAccTypesWithAgeList.Count() = 0 Then
					Continue;
				EndIf;
				// Filter result by is for folio split
				If pIsForFolioSplit <> Undefined Then
					// Save initial list
					vSavAccTypesWithAgeList = vAccTypesWithAgeList.Copy();
					// Remove items
					t = 0;
					While t < vAccTypesWithAgeList.Count() Do
						vAccTypesWithAgeListRow = vAccTypesWithAgeList.Get(t);
						
						If ValueIsFilled(vAccTypesWithAgeListRow.AccTemplate) And pIsForFolioSplit <> vAccTypesWithAgeListRow.AccTemplate.IsForFolioSplit Then
							vAccTypesWithAgeList.Delete(t);
							Continue;
						EndIf;
						
						t = t + 1;
					EndDo;
					// Restore list if it became empty
					If vAccTypesWithAgeList.Count() = 0 Then
						vAccTypesWithAgeList = vSavAccTypesWithAgeList;
					EndIf;
				EndIf;
				// Do for each accommodation type
				If vRTItem.Value <> vLastRoomType Then
					vProbeResObj.RoomType = vRTItem.Value;
					vLastRoomType = vRTItem.Value;
					
					vProbeResObj.pmClearOccupationPercents();
					If Not ValueIsFilled(pReservationRef) Or ValueIsFilled(pReservationRef) And pReservationRef.RoomRate <> vProbeResObj.RoomRate Then
						vProbeResObj.Services.Clear();
					EndIf;
				EndIf;
				vLastAT = Undefined;
				vATError = Undefined;
				vFindedAT = Undefined;
				vArrayOfRowsToDelete = New Array;
				vOverrides = New ValueTable();
				vATRow = Undefined;
				For Each vATRow In vAccTypesWithAgeList Do
					If vLastAT <> vATRow.AccTemplate Then
						If vATError<>Undefined And vATError Then
							vFindedRowsToDelete = vRoomTypeBalances.FindRows(New Structure("AccommodationTemplate, RoomType", vLastAT, vRTItem.Value));
							For Each vItem In vFindedRowsToDelete Do
								vArrayOfRowsToDelete.Add(vItem);
							EndDo;
							vLastAT = Undefined;
							vFindedAT = Undefined;
							vATError = False;
						EndIf;
						If (vATError = Undefined Or Not vATError) And vLastAT <> Undefined Then
							vFindedAT = vLastAT;
							Break;
						EndIf;
						vLastAT = vATRow.AccTemplate;
					EndIf;
					If vATError<>Undefined And vATError Then
						Continue;
					EndIf;
					vProbeResObj.AccommodationType = vATRow.AccommodationType;
					
					rAccommodationTemplate = vATRow.AccTemplate;
					vAccTypeIndex = vAccTypesWithAgeList.IndexOf(vATRow);
					If vAccTypeIndex = 0 Then
						vProbeResObj.AccommodationTemplate = rAccommodationTemplate;
					Else
						vProbeResObj.AccommodationTemplate = Catalogs.AccommodationTemplates.EmptyRef();
					EndIf;
					
					If pIsForFolioSplit <> Undefined Then
						vProbeResObj.IsForFolioSplit = pIsForFolioSplit;
					Endif;

					vAccTypesRow = Undefined;
					If pAccommodationTypes <> Undefined And TypeOf(pAccommodationTypes)	= Type("ValueTable") Then
						If vAccTypeIndex < pAccommodationTypes.Count() Then
							vAccTypesRow = pAccommodationTypes.Get(vAccTypeIndex);
							If ValueIsFilled(vAccTypesRow.AccommodationType) Then
								vProbeResObj.AccommodationType = vAccTypesRow.AccommodationType;
								If pIsForFolioSplit <> Undefined And pIsForFolioSplit Then
									vATRow.AccommodationType = vAccTypesRow.AccommodationType; 
								EndIf;
							EndIf;
							If pAccommodationTypes.Columns.Find("RoomRate") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
								vProbeResObj.RoomRate = vAccTypesRow.RoomRate;
								vProbeResObj.RoomRateType = vAccTypesRow.RoomRate.RoomRateType;
							EndIf;
							If pAccommodationTypes.Columns.Find("ClientType") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
								vProbeResObj.ClientType = vAccTypesRow.ClientType;
							EndIf;
							If pAccommodationTypes.Columns.Find("ServicePackage") <> Undefined And ValueIsFilled(vAccTypesRow.RoomRate) Then
								vProbeResObj.ServicePackage = vAccTypesRow.ServicePackage;
							EndIf;
							If pAccommodationTypes.Columns.Find("DiscountType") <> Undefined Then
								vProbeResObj.DiscountType = vAccTypesRow.DiscountType;
								If ValueIsFilled(vProbeResObj.DiscountType) Then
									vProbeResObj.DiscountServiceGroup = vProbeResObj.DiscountType.DiscountServiceGroup;
									vProbeResObj.pmSetDiscounts();
									If ValueIsFilled(vProbeResObj.DiscountType) Then
										vProbeResObj.Discount = vProbeResObj.DiscountType.GetObject().pmGetDiscount(vProbeResObj.CheckInDate, , vProbeResObj.Hotel);
									EndIf;
								Else
									If pAccommodationTypes.Columns.Find("Discount") <> Undefined Then
										vProbeResObj.Discount = vAccTypesRow.Discount;
									EndIf;
								EndIf;
							EndIf;
						EndIf;
					EndIf;
					
					// Process room rate accommodation type overrides
					If ValueIsFilled(vProbeResObj.AccommodationTemplate) Then
						If ValueIsFilled(vProbeResObj.RoomRate) And ValueIsFilled(vProbeResObj.AccommodationTemplate) Then
							vOverrides = cmGetRoomRateOverrides(vProbeResObj.RoomRate, vProbeResObj.Hotel, vProbeResObj.AccommodationTemplate, ?(ValueIsFilled(vProbeResObj.RoomTypeUpgrade), vProbeResObj.RoomTypeUpgrade, vProbeResObj.RoomType));
						EndIf;
					EndIf;
					If vOverrides.Count() > 0 Then
						vOverrideRows = vOverrides.FindRows(New Structure("AccommodationType, TemplateLineNumber", vProbeResObj.AccommodationType, vAccTypeIndex + 1));
						If vOverrideRows.Count() > 0 And ValueIsFilled(vOverrideRows.Get(0).ToAccommodationType) Then
							vProbeResObj.AccommodationType = vOverrideRows.Get(0).ToAccommodationType;
							If vAccTypesRow <> Undefined Then
								vAccTypesRow.AccommodationType = vProbeResObj.AccommodationType;
							EndIf;
							If vATRow <> Undefined Then
								vATRow.AccommodationType = vProbeResObj.AccommodationType;
							EndIf;
						EndIf;
					EndIf;
					
					// Calculate resources
					vProbeResObj.pmCalculateResources(True);
					// Automatic services list calculation
					vProbeResObj.pmCalculateServices(, , , , , pIsForFolioSplit, pIgnoreRestrictions);
					
					// Check if there are any services for this accommodation type
					vRoomRevenueServices = vProbeResObj.Services.FindRows(New Structure("IsRoomRevenue", True));
					
					// Calculate accommodation type amount
					vAccTypeAmountBeforeDiscount = vProbeResObj.Services.Total("Sum");
					vAccTypeAmount = vProbeResObj.Services.Total("Sum") - vProbeResObj.Services.Total("DiscountSum");
					
					// Get currency
					For Each vSrvRow In vProbeResObj.Services Do
						If vSrvRow.IsRoomRevenue Then
							vCurrency = vSrvRow.FolioCurrency;
							Break;
						EndIf;
					EndDo;
					
					// Check if there are any services is in price
					vIsInPriceServices = vProbeResObj.Services.FindRows(New Structure("IsInPrice", True));
					vFirstDaySum = 0;
					vCheckInDate = BegOfDay(vProbeResObj.CheckInDate);
					vCheckInCurrency = vCurrency;
					For Each vIsInPriceServicesRow In vIsInPriceServices Do
						If vIsInPriceServicesRow.AccountingDate <> vCheckInDate Then
							Break;
						Else
							vCheckInDate = vIsInPriceServicesRow.AccountingDate;
							If vCheckInCurrency = Undefined Then
								vCheckInCurrency = vIsInPriceServicesRow.FolioCurrency;
							ElsIf vCheckInCurrency <> vIsInPriceServicesRow.FolioCurrency Then
								Continue;
							EndIf;
							vFirstDaySum = vFirstDaySum + Round((vIsInPriceServicesRow.Sum - vIsInPriceServicesRow.DiscountSum)/?(vIsInPriceServicesRow.Quantity = 0, 1, vIsInPriceServicesRow.Quantity), 2);
						EndIf;
					EndDo;
					If rServicesTable <> Undefined Then
						For Each vProbeResServicesRow In vProbeResObj.Services Do
							vServicesTableRow = rServicesTable.Add();
							FillPropertyValues(vServicesTableRow, vProbeResServicesRow);
							If TypeOf(vServicesTableRow) = Type("ValueTableRow") Then
								vServicesTableRow.AccTypeIndex = vAccTypeIndex;
							EndIf;
						EndDo;
					EndIf;
					
					// Save amount to the accommodation types value table
					vNewBalanceRow = vRoomTypeBalances.Add();
					vNewBalanceRow.RoomType = vRTItem.Value;
					vNewBalanceRow.AccommodationTemplate = vATRow.AccTemplate;
					vNewBalanceRow.AccommodationType = vATRow.AccommodationType;
					vNewBalanceRow.FirstDaySum = vFirstDaySum;
					vNewBalanceRow.AmountBeforeDiscount = vAccTypeAmountBeforeDiscount;
					vNewBalanceRow.Amount = vAccTypeAmount;
					vNewBalanceRow.AmountPresentation = cmFormatSum(vAccTypeAmount, vCurrency, "NZ=");
					vNewBalanceRow.Currency = vCurrency;
					
					// Reset services list
					If Not ValueIsFilled(pReservationRef) Or ValueIsFilled(pReservationRef) And pReservationRef.RoomRate <> vProbeResObj.RoomRate Then
						vProbeResObj.Services.Clear();
					EndIf;
				EndDo;
				If (vATError = Undefined Or Not vATError) And vLastAT<>Undefined Then
					vFindedAT = vLastAT;
				EndIf;
				For Each vArrayItem In vArrayOfRowsToDelete Do
					vRoomTypeBalances.Delete(vArrayItem);
				EndDo;
				If Not ValueIsFilled(vFindedAT) And vATError = True Then
					vFindedRowsToDelete = vRoomTypeBalances.FindRows(New Structure("RoomType", vRTItem.Value));
					For Each vItem In vFindedRowsToDelete Do
						vRoomTypeBalances.Delete(vItem);
					EndDo;
					Continue;
				EndIf;
			EndDo;
		EndIf;
	EndIf;
	// Remove folios created by documents
	If pProbeResObj = Undefined Then
		For Each vCRRow In vProbeResObj.ChargingRules Do
			vFolioObj = vCRRow.ChargingFolio.GetObject();
			vFolioObj.Delete();
		EndDo;
		vProbeResObj = Undefined;
	EndIf;
	// Return
	Return vRoomTypeBalances;
EndFunction // cmGetRoomTypeBalancesTable

// -----------------------------------------------------------------------------
// Description: Returns list of services with appropriate service type
// Parameters: Hotel code, Service type code, External system code, Language code
// Return value: Array of services as XDTO object
// -----------------------------------------------------------------------------
Function cmGetExtraServices(pHotelCode, pServiceTypeCode, pClientTypeCode, pExternalSystemCode, pLanguageCode = "RU") Export
	WriteLogEvent(NStr("en='Get extra services';ru='Получить доп. услуги';de='Zusätzliche Dienstleistungen erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Service type code: ';ru='Код типа услуги: ';de='Dienstleistungstypcode: '") + pServiceTypeCode + Chars.LF + 
	              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode);
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get service type
	vServiceType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ServiceTypes", pServiceTypeCode);
	// Get client type
	vClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode);
	If vClientType = Undefined Then
		vClientType = Catalogs.ClientTypes.EmptyRef();
	EndIf;
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExtraServices"));
	// Run query
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Services.Ref AS Ref,
	|	Services.Parent AS Parent
	|FROM
	|	Catalog.Services AS Services
	|WHERE
	|	NOT Services.IsFolder
	|	AND NOT Services.DeletionMark
	|	AND (Services.Hotel = &qHotel
	|				AND Services.Hotel <> &qEmptyHotel
	|			OR Services.Hotel = &qEmptyHotel)
	|	AND (Services.ServiceType = &qServiceType
	|			OR &qServiceTypeIsEmpty)
	|	AND Services.OnlineAvaliable
	|
	|ORDER BY
	|	Services.SortCode,
	|	Services.Description";
	vQry.SetParameter("qHotel", vHotel);
	vQry.SetParameter("qEmptyHotel", Catalogs.Hotels.EmptyRef());
	vQry.SetParameter("qServiceType", vServiceType);
	vQry.SetParameter("qServiceTypeIsEmpty", Not ValueIsFilled(vServiceType));
	vServices = vQry.Execute().Unload();
	For Each vServicesRow In vServices Do
		WriteLogEvent(NStr("en = 'Get extra services'; de = 'Zusätzliche Dienstleistungen erhalten'; ru = 'Получить доп. услуги'"), EventLogLevel.Information, , , TrimAll(vServicesRow.Ref));
		// Get service object
		vExtraServiceObj = vServicesRow.Ref.GetObject();
		vSrvPrices = vExtraServiceObj.pmGetServicePrices(vHotel, CurrentSessionDate(), vClientType);
		If vSrvPrices.Count() = 0 Then
			Continue;
		EndIf;
		vSrvPriceRow = vSrvPrices.Get(0);
		If Not ValueIsFilled(vSrvPriceRow.Currency) Then
			Continue;
		EndIf;	
		// Build return object
		vExtraServiceDetails = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExtraServiceRow"));
		// Fill XDTO object attributes
		vExtraServiceDetails.ServiceCode = TrimAll(vExtraServiceObj.Code);
		vExtraServiceDetails.ServiceDescription = vExtraServiceObj.pmGetServiceDescription(vLanguage);
		vExtraServiceDetails.Price = vSrvPriceRow.Price;
		vExtraServiceDetails.PricePresentation = cmFormatSum(vSrvPriceRow.Price, vSrvPriceRow.Currency, "NZ=", vLanguage);
		vExtraServiceDetails.Unit = vExtraServiceObj.pmGetServiceUnitDescription(vLanguage);
		vExtraServiceDetails.Remarks = cmNStr(vExtraServiceObj.Remarks, vLanguage);
		vExtraServiceDetails.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vSrvPriceRow.Currency);
		vExtraServiceDetails.CurrencyCode = TrimAll(vSrvPriceRow.Currency.Code);
		vExtraServiceDetails.CurrencyDescription = TrimAll(vSrvPriceRow.Currency.Description);    
		vExtraServiceDetails.Group = TrimAll(vServicesRow.Parent);    
		
		// Add extra service to the return object
		vRetXDTO.ExtraServiceRow.Add(vExtraServiceDetails);
	EndDo;
	Return vRetXDTO;
EndFunction // cmGetExtraServices 

// ----------------------------------------------------------------------------
// Description: Checks if all client data is filled
// Parameters: Guest group item reference
// Return value: True or False
// ----------------------------------------------------------------------------
Function cmCheckGuestsInformationFullness(pGuestGroup) Export
	vGGroupObj = pGuestGroup.GetObject();
	vReservations = vGGroupObj.pmGetReservations(True, True);
	vOK = True;
	For Each vReservation In vReservations Do
		vClient = vReservation.Guest;
		If Not ValueIsFilled(vCLient.LastName) Or Not ValueIsFilled(vCLient.FirstName) Or Not ValueIsFilled(vCLient.DateOfBirth) Or
			 Not ValueIsFilled(vCLient.Citizenship) Or Not ValueIsFilled(vCLient.IdentityDocumentType) Or
			  Not ValueIsFilled(vCLient.IdentityDocumentNumber) Or Not ValueIsFilled(vCLient.IdentityDocumentIssueDate) Or
			  Not ValueIsFilled(vCLient.Address) Then
			  vOK = False;
			  Break;
		EndIf;
	EndDo;
	Return vOK;
EndFunction // cmCheckGuestsInformationFullness

// ----------------------------------------------------------------------------
// Description: returns list of client identification document types
// ----------------------------------------------------------------------------
Function cmGetIdentityDocumentsList() Export
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	IdentityDocumentTypes.Ref,
	|	IdentityDocumentTypes.Code,
	|	IdentityDocumentTypes.Description
	|FROM
	|	Catalog.IdentityDocumentTypes AS IdentityDocumentTypes
	|WHERE
	|	NOT IdentityDocumentTypes.DeletionMark
	|	AND NOT IdentityDocumentTypes.IsFolder";
	vQryChoice = vQry.Execute().Select();
	// Get language
	vLanguageRU = cmGetLanguageByCode("RU");
	vLanguageEN = cmGetLanguageByCode("EN");
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "IdentityDocumentsList"));
	While vQryChoice.Next() Do
		vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "IdentityDocument"));
		vRetRow.IdentityDocumentTypeCode = TrimAll(vQryChoice.Code);
		vRetRow.IdentityDocumentTypeNameRU = cmNStr(vQryChoice.Description, vLanguageRU);
		vRetRow.IdentityDocumentTypeNameEN = cmNStr(vQryChoice.Description, vLanguageEN);
		vRetXDTO.IdentityDocument.Add(vRetRow);
	EndDo;
	Return vRetXDTO;
EndFunction // cmGetIdentityDocumentsList

// ----------------------------------------------------------------------------
// If pIsOnServer = TRUE then pHotel and pGroup parameters is catalog item references
// else string parameters
// ----------------------------------------------------------------------------
Function cmSendExpressCheckInMessage(pHotel, pGroup, pExpressCheckInPath = "", pQRCodePath = "", pQRCodeFileName = "", pIsExpress = False, pExtHotelID = "", pIsOnServer = False) Export
	WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс заезда'"), EventLogLevel.Information, , , 
	              NStr("en='Hotel: ';ru='Гостиница: ';de='Hotel: '") + String(pHotel) + Chars.LF + 
	              NStr("en='Group: '; de='Gastgruppe: '; ru='Группа гостей: '") + String(pGroup) + Chars.LF + 
				  NStr("en='Express check-in: '; de='Express check-in: '; ru='Экспресс заезд: '") + String(pIsExpress) + Chars.LF +
				  NStr("en='Express check-in path: '; de='Express check-in path: '; ru='Путь к модулю Экспресс заезда: '") + TrimAll(pExpressCheckInPath) + Chars.LF +
				  NStr("en='QR-code full path: '; de='QR-code full path: '; ru='Полный путь к QR-коду: '") + TrimAll(pQRCodePath) + Chars.LF +
				  NStr("en='QR-code file name: '; de='QR-code file name: '; ru='Имя файла с QR-кодом: '") + TrimAll(pQRCodeFileName) + Chars.LF +
				  NStr("en='External hotel ID: '; de='External hotel ID: '; ru='Код гостиницы во внешней системе: '") + TrimAll(pExtHotelID) + Chars.LF +
				  NStr("en='Is on server: '; de='Is on server: '; ru='На сервере: '") + String(pIsOnServer));

	vHotelRef = Catalogs.Hotels.EmptyRef();			  
	vGroupRef = Catalogs.GuestGroups.EmptyRef();
	If pIsOnServer Then
		If ValueIsFilled(pHotel) Then
			vHotelRef = pHotel;
		Else
			If ValueIsFilled(pGroup) And ValueIsFilled(pGroup.Owner) Then
				vHotelRef = pGroup.Owner;
			EndIf;
		EndIf;
		If ValueIsFilled(pGroup) Then
			vGroupRef = pGroup;
		EndIf;
	Else
		If ValueIsFilled(pHotel) Then
			// Try to find hotel by name or code
			vHotelRef = cmGetHotelByCode(pHotel, "1CBITRIX");
		Else
			vHotelRef = SessionParameters.CurrentHotel;
		EndIf;
		If ValueIsFilled(pGroup) And ValueIsFilled(vHotelRef) Then
			// Get guest group by code
			vGroupRef = cmGetGuestGroupByExternalCode(vHotelRef, pGroup, "", "", False);
		EndIf;
	EndIf;				  
	// Express check-in
	If pIsExpress = True Then
		If ValueIsFilled(vHotelRef) And ValueIsFilled(vGroupRef) And ValueIsFilled(vGroupRef.Client) And ValueIsFilled(vGroupRef.Client.EMail) Then
			vLanguage = vHotelRef.Language;
			If Not ValueIsFilled(vLanguage) Then
				vLanguage = SessionParameters.CurrentLanguage;
			EndIf;
			// If guest information is full
			If cmCheckGuestsInformationFullness(vGroupRef) Then
				If ValueIsFilled(pQRCodePath) And ValueIsFilled(pQRCodeFileName) Then
					vFilePath = cmTempFilesDir()+pQRCodeFileName;
					FileCopy(pQRCodePath+pQRCodeFileName, vFilePath);
					// Send e-mail with qr-code
					If ValueIsFilled(vHotelRef.TemplateSendExpressCheckInInvitationByEMail) Then
						vTemplate = vHotelRef.TemplateSendExpressCheckInInvitationByEMail;
						vText = ""; 
						If ValueIsFilled(vTemplate.HTMLTextRu) Or ValueIsFilled(vTemplate.HTMLTextEn) Or ValueIsFilled(vTemplate.HTMLTextDe) Then
							vText = SMS.GetHTMLTextByLanguage(vTemplate, vGroupRef.Client.Language);
							vText = StrReplace(vText, "&QRCodePath", vFilePath);
						EndIf;
						If IsBlankString(vText) Then
							vText = SMS.GetSMSTextByLanguage(vTemplate, vGroupRef.Client.Language);
						EndIf;
						rErrorMessage = "";
						If Not JobsScheduled.cmSendTextByEMail(cmNStr(TrimAll(vTemplate.Description), vGroupRef.Client.Language), TrimAll(vText), TrimAll(vGroupRef.Client.EMail), False, rErrorMessage,,,, vTemplate) Then
							InformationRegisters.GuestGroupAttachments.WriteData(, vGroupRef,,,,,, TrimAll(vGroupRef.Client.EMail),, Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, TrimAll(vText), vTemplate,,,,,,,);
							vError = cmNStr("ru='Ошибка отправки E-Mail! '; en='E-Mail sending failed! '; de='E-Mail sending failed! '", vLanguage)+rErrorMessage;
							WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс Заезда'"), EventLogLevel.Error, , , vError);
						EndIf;
					Else
						WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс Заезда'"), EventLogLevel.Error, , , 
						NStr("en='E-Mail sending failed! Template not found'; de='E-Mail sending failed! Template not found'; ru='Ошибка отправки E-Mail! Шаблон сообщения не найден'"));
					EndIf;
				Else
					WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс Заезда'"), EventLogLevel.Error, , , 
					NStr("en='E-Mail sending failed! QR-code path is not filled'; de='E-Mail sending failed! QR-code path is not filled'; ru='Ошибка отправки E-Mail! Не указаны пути к QR-коду'"));
				EndIf;
			Else
				If ValueIsFilled(pExpressCheckInPath) Then
					vClientEMail = "";
					vClientPhone = "";
					If ValueIsFilled(vGroupRef) And ValueIsFilled(vGroupRef.Client) Then
						vClientEMail = vGroupRef.Client.Email;
						vClientPhone = vGroupRef.Client.Phone;
					EndIf;
					If Not ValueIsFilled(vClientEMail) Or Not ValueIsFilled(vClientPhone) Then
						vLink = pExpressCheckInPath+"print_checkin.php?hotel="+TrimAll(pExtHotelID)+"&booking="+TrimAll(vGroupRef.Code)+?(ValueIsFilled(vClientPhone),"&phone="+TrimAll(vClientPhone), "")+?(ValueIsFilled(vClientEMail),"&email="+TrimAll(vClientEMail), "");
						// Send e-mail with express check-in invitation
						If ValueIsFilled(vHotelRef.ExpressCheckInInvitationMessageTemplate) Then
							vTemplate = vHotelRef.ExpressCheckInInvitationMessageTemplate;
							vText = "";   
							If ValueIsFilled(vTemplate.HTMLTextRu) Or ValueIsFilled(vTemplate.HTMLTextEn) Or ValueIsFilled(vTemplate.HTMLTextDe) Then
								vText = SMS.GetHTMLTextByLanguage(vTemplate, vGroupRef.Client.Language);
								vText = StrReplace(vText, "&ExpressCheckInLink", vLink);
							EndIf;
							If IsBlankString(vText) Then
								vText = SMS.GetSMSTextByLanguage(vTemplate, vGroupRef.Client.Language);
							EndIf;
							rErrorMessage = "";
							If Not JobsScheduled.cmSendTextByEMail(cmNStr(TrimAll(vTemplate.Description), vGroupRef.Client.Language), TrimAll(vText), TrimAll(vGroupRef.Client.EMail), False, rErrorMessage,,,, vTemplate) Then
								InformationRegisters.GuestGroupAttachments.WriteData(, vGroupRef,,,,,, TrimAll(vGroupRef.Client.EMail),, Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, TrimAll(vText), vTemplate,,,,,, True, "");
								vError = cmNStr("ru='Ошибка отправки E-Mail! '; en='E-Mail sending failed! '", vLanguage)+rErrorMessage;
								WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс заезда'"), EventLogLevel.Error, , , vError);
							EndIf;
						Else
							WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс заезда'"), EventLogLevel.Error, , , 
							NStr("en='E-Mail sending failed! Template not found'; de='E-Mail sending failed! Template not found'; ru='Ошибка отправки E-Mail! Шаблон сообщения не найден'"));
						EndIf;
					EndIf;
				Else
					WriteLogEvent(NStr("en='Send Express Check-In Messages'; de='Send Express Check-In Messages'; ru='Отправка сообщений модуля экспресс заезда'"), EventLogLevel.Error, , , 
					NStr("en='E-Mail sending failed! Express check-in module path is not filled'; de='E-Mail sending failed! Express check-in module path is not filled'; ru='Ошибка отправки E-Mail! Не указан путь к модулю экспресс заезда'"));
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	Return "";
EndFunction // cmSendExpressCheckInMessage

// -----------------------------------------------------------------------------
// Function is used to update client contact data from external system data
// -----------------------------------------------------------------------------
Function cmUpdateClientInfo(pClientInfo, pHotelCode = "", pGroupCode, pExternalSystemCode, pLanguageCode = "RU", pQRCodePath = "", pQRCodeFileName = "") Export
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get guest group by code
	vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pGroupCode, "", "", False);
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExpressCheckInUUID"));
		WriteLogEvent(NStr("en='Update client information'; ru='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Information, , , TypeOf(pClientInfo));
		WriteLogEvent(NStr("en='Update client information'; de='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Information, , , pClientInfo);
	For Each vClientInfo In pClientInfo.ClientRow Do
		WriteLogEvent(NStr("en='Update client information'; de='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Information, , , 
					NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems:'") + pExternalSystemCode + Chars.LF + 
					NStr("en='Guest group code: '; de='Guest group code: '; ru='Код группы гостей: '") + pGroupCode + Chars.LF + 
					NStr("en='QR-code full path: '; de='QR-code full path: '; ru='Полный путь к QR-коду: '") + pQRCodePath + Chars.LF + 
					NStr("en='QR-code file name: '; de='QR-code file name: '; ru='Имя файла QR-кода: '") + pQRCodeFileName + Chars.LF + 
					NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
					NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
					NStr("en='Client last name: ';ru='Фамилия гостя: ';de='Familienname des Gastes: '") + vClientInfo.ClientLastName + Chars.LF + 
					NStr("en='Client first name: ';ru='Имя гостя: ';de='Name des Gastes: '") + vClientInfo.ClientFirstName + Chars.LF + 
					NStr("en='Client second name: ';ru='Отчество гостя: ';de='Vatersname des Gastes: '") + vClientInfo.ClientSecondName + Chars.LF + 
					NStr("en='Client sex code: ';ru='Код пола гостя: ';de='Code des Geschlechts des Gastes: '") + vClientInfo.ClientSex + Chars.LF + 
					NStr("en='Client citizenship code: ';ru='Код гражданства гостя: ';de='Code der Stadtbürgerschaft des Gastes: '") + vClientInfo.ClientCitizenship + Chars.LF + 
					NStr("en='Client birth date: ';ru='Дата рождения гостя: ';de='Geburtsdatum des Gastes: '") + vClientInfo.ClientBirthDate + Chars.LF + 
					NStr("en='Client phone: ';ru='Телефон гостя: ';de='Telefon des Gastes: '") + vClientInfo.ClientPhone + Chars.LF + 
					NStr("en='Client fax: ';ru='Факс гостя: ';de='Fax des Gastes: '") + vClientInfo.ClientFax + Chars.LF + 
					NStr("en='Client E-Mail: ';ru='E-Mail гостя: ';de='E-Mail-Adresse des Gastes: '") + vClientInfo.ClientEMail + Chars.LF + 
					NStr("en='Client identity document type code: '; de='Client identity document type code: '; ru='Код типа документа удостоверяющего личность: '") + vClientInfo.ClientIdentityDocumentType + Chars.LF + 
					NStr("en='Client identity document series: '; de='Client identity document series: '; ru='Серия документа удостоверяющего личность: '") + vClientInfo.ClientIdentityDocumentSeries + Chars.LF + 
					NStr("en='Client identity document number: '; de='Client identity document number: '; ru='Номер документа удостоверяющего личность: '") + vClientInfo.ClientIdentityDocumentNumber + Chars.LF + 
					NStr("en='Client identity document issued by: '; de='Client identity document issued by: '; ru='Кем выдан документ удостоверяющего личность: '") + vClientInfo.ClientIdentityDocumentIssuedBy + Chars.LF + 
					NStr("en='Client identity document valid to date: '; de='Client identity document valid to date: '; ru='Действителен до: '") + vClientInfo.ClientIdentityDocumentValidToDate + Chars.LF + 
					NStr("en='Client identity document issued date: '; de='Client identity document issued date: '; ru='Дата выдачи документа удостоверяющего личность: '") + vClientInfo.ClientIdentityDocumentIssueDate + Chars.LF + 
					NStr("en='Client address: '; de='Client address: '; ru='Адрес клиента: '") + vClientInfo.Address);
		vError = "";
		vCltRef = Catalogs.Clients.EmptyRef();
		// Check if group was found
		If Not ValueIsFilled(vGuestGroup) Then
			vError = cmNStr("en='Guest group was not found!';ru='Группа не найдена!';de='Gruppe nicht gefunden!'", vLanguage);
			WriteLogEvent(NStr("en='Update client information'; de='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Error, , , vError);
			vRetXDTO.Error = vError;
			Return vRetXDTO;
		EndIf;
		vQry = New Query;
		vQry.Text = 
		"SELECT
		|	Reservation.Guest,
		|	Reservation.Guest.Phone AS Phone,
		|	Reservation.Guest.Email AS Email
		|FROM
		|	Document.Reservation AS Reservation
		|WHERE
		|	Reservation.Posted
		|	AND NOT Reservation.DeletionMark
		|	AND Reservation.GuestGroup = &qGroup
		|	AND Reservation.CheckInDate > &qCurDate"+
		?(ValueIsFilled(vClientInfo.ClientLastName)," AND Reservation.Guest.LastName = &qLastName", "")+
		?(ValueIsFilled(vClientInfo.ClientFirstName)," AND Reservation.Guest.FirstName = &qFirstName", "")+
		?(ValueIsFilled(vClientInfo.ClientSecondName)," AND Reservation.Guest.SecondName = &qSecondName", "");
		If ValueIsFilled(vClientInfo.ClientLastName) Then
			vQry.SetParameter("qLastName", vClientInfo.ClientLastName);
		EndIf;
		If ValueIsFilled(vClientInfo.ClientFirstName) Then
			vQry.SetParameter("qFirstName", vClientInfo.ClientFirstName);
		EndIf;
		If ValueIsFilled(vClientInfo.ClientSecondName) Then
			vQry.SetParameter("qSecondName", vClientInfo.ClientSecondName);
		EndIf;
		vQry.SetParameter("qCurDate", CurrentSessionDate());
		vQry.SetParameter("qGroup", vGuestGroup);
		vQryResult = vQry.Execute().Unload();
		If vQryResult.Count()>0 Then
			If vQryResult.Count() = 1 Then
				vCltRef = vQryResult[0].Guest;
			Else
				For Each vQryRow In vQryResult Do
					If ValueIsFilled(vClientInfo.ClientPhone) Then
						If SMS.GetValidPhoneNumber(TrimAll(vClientInfo.ClientPhone)) = vQryRow.Phone Then
							vCltRef = vQryRow.Guest;
							Break;
						EndIf;
						If TrimAll(vClientInfo.ClientEmail) = vQryRow.Email Then
							vCltRef = vQryRow.Guest;
							Break;
						EndIf;
					EndIf;
				EndDo;
				If Not ValueIsFilled(vCltRef) Then
					vCltRef = vQryResult[0].Guest;
				EndIf;
			EndIf;
			WriteLogEvent(NStr("en='Client was found'; de='Client was found'; ru='Клиент найден'"), EventLogLevel.Information, , , 
			NStr("en='Client code: ';ru='Код клиента: ';de='Kundencode: '") + vCltRef.Code + Chars.LF + 
			NStr("ru='Фамилия клиента: '; en='Client last name: '; de='Client last name: '") + vCltRef.LastName + Chars.LF + 
			NStr("ru='Имя клиента: '; en='Client first name: '; de='Client first name: '") + vCltRef.FirstName + Chars.LF + 
			NStr("ru='Отчество клиента: '; en='Client second name: '; de='Client second name: '") + vCltRef.SecondName);
		EndIf;
		If Not ValueIsFilled(vCltRef) Then
			vError = cmNStr("en='Client not finded!';ru='Клиент не найден!';de='Der Kunde wurde nicht gefunden!'", vLanguage);
			WriteLogEvent(NStr("en='Update client information'; de='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Error, , , vError);
			vRetXDTO.Error = vError;
			Return vRetXDTO;
		EndIf;
		Try
			vCltObj = vCltRef.GetObject();
			// Second name
			If ValueIsFilled(vClientInfo.ClientSecondName) And Not ValueIsFilled(vCltObj.SecondName) Then
				vCltObj.SecondName = vClientInfo.ClientSecondName;
			EndIf;
			// Date of birth
			If ValueIsFilled(vClientInfo.ClientBirthDate) Then
				vCltObj.DateOfBirth = BegOfDay(vClientInfo.ClientBirthDate);
			EndIf;
			If ValueIsFilled(vHotel) Then
				// Citizenship
				If Not ValueIsFilled(vCltObj.Citizenship) Then
					If IsBlankString(vClientInfo.ClientCitizenship) Then
						vCltObj.Citizenship = vHotel.Citizenship;
					Else
						vCltObj.Citizenship = cmGetCountryByCode(vClientInfo.ClientCitizenship);
					EndIf;
				ElsIf Not IsBlankString(vClientInfo.ClientCitizenship) Then
					vCltObj.Citizenship = cmGetCountryByCode(vClientInfo.ClientCitizenship);
				EndIf;
				// Language
				If Not ValueIsFilled(vCltObj.Language) Then
					vCltObj.Language = vHotel.Language;
				EndIf;
				// Identity document
				If Not ValueIsFilled(vCltObj.IdentityDocumentType) Then
					If vCltObj.Citizenship = vHotel.Citizenship Then
						vCltObj.IdentityDocumentType = vHotel.IdentityDocumentType;
					Else
						vCltObj.IdentityDocumentType = vHotel.IdentityDocumentTypeForForeigners;
					EndIf;
				EndIf;
			EndIf;
			// Sex
			If Not IsBlankString(vClientInfo.ClientSex) Then
				vSexLetter = Upper(Left(TrimAll(vClientInfo.ClientSex), 1));
				If vSexLetter = "F" Or vSexLetter = "Ж" Then
					vCltObj.Sex = Enums.Sex.Female;
				Else
					vCltObj.Sex = Enums.Sex.Male;
				EndIf;
			Else
				vCltObj.Sex = cmGetSexByNames(vCltObj.LastName, vCltObj.FirstName, vCltObj.SecondName);
			EndIf;
			// Contacts
			If ValueIsFilled(vClientInfo.ClientPhone) Then
				vCltObj.Phone = TrimAll(vClientInfo.ClientPhone);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientEMail) Then
				vCltObj.EMail = TrimAll(vClientInfo.ClientEMail);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientFax) Then
				vCltObj.Fax = TrimAll(vClientInfo.ClientFax);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentType) Then
				vIdentityDocumentType = Catalogs.IdentityDocumentTypes.FindByCode(TrimAll(vClientInfo.ClientIdentityDocumentType));
				If ValueIsFilled(vIdentityDocumentType) Then
					vCltObj.IdentityDocumentType = vIdentityDocumentType;
				EndIf;
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentNumber) Then
				vCltObj.IdentityDocumentNumber = TrimAll(vClientInfo.ClientIdentityDocumentNumber);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentSeries) Then
				vCltObj.IdentityDocumentSeries = TrimAll(vClientInfo.ClientIdentityDocumentSeries);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentIssuedBy) Then
				vCltObj.IdentityDocumentIssuedBy = TrimAll(vClientInfo.ClientIdentityDocumentIssuedBy);
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentValidToDate) Then
				vCltObj.IdentityDocumentValidToDate = vClientInfo.ClientIdentityDocumentValidToDate;
			EndIf;
			If ValueIsFilled(vClientInfo.ClientIdentityDocumentIssueDate) Then
				vCltObj.IdentityDocumentIssueDate = vClientInfo.ClientIdentityDocumentIssueDate;
			EndIf;
			If ValueIsFilled(vClientInfo.Address) Then
				vCltObj.Address = TrimAll(vClientInfo.Address);
			EndIf;
			// No SMS delivery
			If TypeOf(vClientInfo.ClientSendSMS) = Type("Boolean") Then
				vCltObj.NoSMSDelivery = Not vClientInfo.ClientSendSMS;
			EndIf;
			// Run some internal client functions to fill some client parameters
			vCltObj.Description = vCltObj.pmGetDescription();
			vCltObj.FullName = vCltObj.pmGetFullName();
			// Write
			vCltObj.Write();
			// Save data to the client change history
			vCltObj.pmWriteToClientChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
		Except
			vError = cmNStr("ru='Ошибка обновления данных клиента!'; en='Client information updating failed!'; de='Client information updating failed!'", vLanguage);
			WriteLogEvent(NStr("en='Update client information'; de='Update client information'; ru='Обновить информацию клиента'"), EventLogLevel.Error, , , vError);
			vRetXDTO.Error = vError;
			Return vRetXDTO;
		EndTry;
	EndDo;
	// Send E-Mail
	cmSendExpressCheckInMessage(vHotel, vGuestGroup,, pQRCodePath, pQRCodeFileName, True, "",True);
	Return vRetXDTO;
EndFunction // cmUpdateClientInfo

// -----------------------------------------------------------------------------
// Function returns guest groups for the given agent. Groups are returned for the given period and hotel
// -----------------------------------------------------------------------------
Function cmGetAgentGroupsList(pLogin, pHotelCode, pExternalSystemCode, pPeriodFrom = '00010101', pPeriodTo = '00010101', pLanguageCode = "RU") Export
	WriteLogEvent(NStr("en='Get active groups list';ru='Получить список действующих групп';de='Liste der aktiven Gruppen erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Login: ';ru='Логин: ';de='Login: '") + pLogin + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode);
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GroupsList"));
	If Not ValueIsFilled(pExternalSystemCode) Then
		Return vRetXDTO;
	EndIf;
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get customer and contract by login
	vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
	// Try to find marketing code
	vSourceOfBusiness = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "SourcesOfBusiness", pExternalSystemCode);
	// Get active reservations and group by them by guest group
	If (vCustomerStruct <> Undefined And ValueIsFilled(vCustomerStruct.Customer)) Or ValueIsFilled(vSourceOfBusiness) Then
		// Get customer and contract references
		vCustomer = vCustomerStruct.Customer;
		vContract = vCustomerStruct.Contract;
		// Run query
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	GuestGroups.GuestGroup AS GuestGroup,
		|	GuestGroups.GuestGroupCode AS GuestGroupCode,
		|	GuestGroups.Status AS Status,
		|	GuestGroups.CheckInDate AS CheckInDate,
		|	GuestGroups.Duration AS Duration,
		|	GuestGroups.CheckOutDate AS CheckOutDate,
		|	GuestGroups.NumberOfPersons AS NumberOfPersons,
		|	GuestGroups.GuestFullName AS GuestFullName,
		|	GuestGroups.Remarks AS Remarks,
		|	GuestGroups.Agent AS Agent,
		|	GuestGroups.Contract AS Contract,
		|	ISNULL(GuestGroupTotalSales.Sales, 0) AS Sales,
		|	GuestGroupTotalSales.Currency AS Currency,
		|	GuestGroupTotalSales.Currency.Code AS CurrencyCode,
		|	GuestGroupTotalSales.Currency.Description AS CurrencyDescription,
		|	ISNULL(GuestGroupPayments.PaymentAmount, 0) AS PaymentAmount,
		|	GuestGroupPayments.PaymentCurrency AS PaymentCurrency
		|FROM
		|	(SELECT
		|		Reservation.GuestGroup AS GuestGroup,
		|		Reservation.GuestGroupCode AS GuestGroupCode,
		|		Reservation.Status AS Status,
		|		Reservation.CheckInDate AS CheckInDate,
		|		Reservation.Duration AS Duration,
		|		Reservation.CheckOutDate AS CheckOutDate,
		|		Reservation.NumberOfPersons AS NumberOfPersons,
		|		Reservation.GuestFullName AS GuestFullName,
		|		Reservation.Remarks AS Remarks,
		|		Reservation.Agent AS Agent,
		|		Reservation.Contract AS Contract
		|	FROM
		|		(SELECT
		|			ReservationDocs.GuestGroup AS GuestGroup,
		|			ReservationDocs.GuestGroup.Code AS GuestGroupCode,
		|			ReservationDocs.GuestGroup.Status AS Status,
		|			ReservationDocs.GuestGroup.CheckInDate AS CheckInDate,
		|			ReservationDocs.GuestGroup.Duration AS Duration,
		|			ReservationDocs.GuestGroup.CheckOutDate AS CheckOutDate,
		|			ReservationDocs.GuestGroup.GuestsCheckedIn AS NumberOfPersons,
		|			ReservationDocs.GuestGroup.Client.FullName AS GuestFullName,
		|			ReservationDocs.GuestGroup.Description AS Remarks,
		|			ReservationDocs.Agent.Description AS Agent,
		|			ReservationDocs.Contract.Description AS Contract
		|		FROM
		|			Document.Reservation AS ReservationDocs
		|		WHERE
		|			ReservationDocs.Posted
		|			AND ReservationDocs.Hotel = &qHotel
		|			AND (ReservationDocs.Customer = &qCustomer
		|						AND (ReservationDocs.Contract = &qContract
		|							OR &qContractIsEmpty)
		|					OR ReservationDocs.Agent = &qCustomer
		|					OR &qCustomerIsEmpty)
		|			AND (ReservationDocs.SourceOfBusiness = &qSourceOfBusiness
		|					OR &qSourceOfBusinessIsEmpty)
		|			AND (ReservationDocs.ReservationStatus.IsActive
		|					OR ReservationDocs.ReservationStatus.IsPreliminary)
		|		
		|		UNION ALL
		|		
		|		SELECT
		|			AccommodationDocs.GuestGroup,
		|			AccommodationDocs.GuestGroup.Code,
		|			AccommodationDocs.GuestGroup.Status,
		|			AccommodationDocs.GuestGroup.CheckInDate,
		|			AccommodationDocs.GuestGroup.Duration,
		|			AccommodationDocs.GuestGroup.CheckOutDate,
		|			AccommodationDocs.GuestGroup.GuestsCheckedIn,
		|			AccommodationDocs.GuestGroup.Client.FullName,
		|			AccommodationDocs.GuestGroup.Description,
		|			AccommodationDocs.Agent.Description,
		|			AccommodationDocs.Contract.Description
		|		FROM
		|			Document.Accommodation AS AccommodationDocs
		|		WHERE
		|			AccommodationDocs.Posted
		|			AND AccommodationDocs.Hotel = &qHotel
		|			AND (AccommodationDocs.Customer = &qCustomer
		|						AND (AccommodationDocs.Contract = &qContract
		|							OR &qContractIsEmpty)
		|					OR AccommodationDocs.Agent = &qCustomer
		|					OR &qCustomerIsEmpty)
		|			AND (AccommodationDocs.SourceOfBusiness = &qSourceOfBusiness
		|					OR &qSourceOfBusinessIsEmpty)
		|			AND AccommodationDocs.AccommodationStatus.IsActive) AS Reservation
		|	
		|	GROUP BY
		|		Reservation.GuestGroup,
		|		Reservation.Status,
		|		Reservation.CheckInDate,
		|		Reservation.Duration,
		|		Reservation.CheckOutDate,
		|		Reservation.NumberOfPersons,
		|		Reservation.GuestFullName,
		|		Reservation.Remarks,
		|		Reservation.Agent,
		|		Reservation.Contract,
		|		Reservation.GuestGroupCode) AS GuestGroups
		|		LEFT JOIN (SELECT
		|			GuestGroupSales.GuestGroup AS GuestGroup,
		|			GuestGroupSales.Currency AS Currency,
		|			SUM(GuestGroupSales.SalesTurnover) + SUM(GuestGroupSales.SalesForecastTurnover) AS Sales
		|		FROM
		|			(SELECT
		|				CurrentAccountsReceivableTurnovers.GuestGroup AS GuestGroup,
		|				CurrentAccountsReceivableTurnovers.FolioCurrency AS Currency,
		|				CurrentAccountsReceivableTurnovers.SumReceipt - CurrentAccountsReceivableTurnovers.CommissionSumReceipt AS SalesTurnover,
		|				0 AS SalesForecastTurnover
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(
		|						,
		|						,
		|						Period,
		|						Customer = &qCustomer
		|							AND (Contract = &qContract
		|								OR &qContractIsEmpty)
		|							AND Hotel = &qHotel) AS CurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				AccountsReceivableForecastTurnovers.GuestGroup,
		|				AccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				AccountsReceivableForecastTurnovers.SalesTurnover - AccountsReceivableForecastTurnovers.CommissionSumTurnover
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(
		|						&qForecastPeriodFrom,
		|						&qForecastPeriodTo,
		|						Period,
		|						Customer = &qCustomer
		|							AND (Contract = &qContract
		|								OR &qContractIsEmpty)
		|							AND Hotel = &qHotel) AS AccountsReceivableForecastTurnovers) AS GuestGroupSales
		|		
		|		GROUP BY
		|			GuestGroupSales.GuestGroup,
		|			GuestGroupSales.Currency) AS GuestGroupTotalSales
		|		ON GuestGroups.GuestGroup = GuestGroupTotalSales.GuestGroup
		|		LEFT JOIN (SELECT
		|			Payments.GuestGroup AS GuestGroup,
		|			Payments.AccountingCurrency AS PaymentCurrency,
		|			SUM(Payments.SumExpense) AS PaymentAmount
		|		FROM
		|			AccumulationRegister.CustomerAccounts.BalanceAndTurnovers(
		|					,
		|					,
		|					Period,
		|					RegisterRecordsAndPeriodBoundaries,
		|					AccountingCustomer = &qCustomer
		|						AND (AccountingContract = &qContract
		|							OR &qContractIsEmpty)
		|						AND Hotel = &qHotel) AS Payments
		|		
		|		GROUP BY
		|			Payments.GuestGroup,
		|			Payments.AccountingCurrency) AS GuestGroupPayments
		|		ON GuestGroups.GuestGroup = GuestGroupPayments.GuestGroup
		|
		|ORDER BY
		|	GuestGroups.CheckInDate,
		|	GuestGroups.GuestGroupCode";
		vQry.SetParameter("qHotel", vHotel);
		vQry.SetParameter("qCustomer", vCustomer);
		vQry.SetParameter("qCustomerIsEmpty", Not ValueIsFilled(vCustomer));
		vQry.SetParameter("qContract", vContract);
		vQry.SetParameter("qContractIsEmpty", Not ValueIsFilled(vContract));
		vQry.SetParameter("qSourceOfBusiness", Catalogs.SourcesOfBusiness.EmptyRef());
		vQry.SetParameter("qSourceOfBusinessIsEmpty", True);
		vForecastStartDate = tcOnServer.GetForecastStartDate(vHotel);
		vQry.SetParameter("qForecastPeriodFrom", vForecastStartDate);
		vQry.SetParameter("qForecastPeriodTo", '39991231235959');
		vGuestGroups = vQry.Execute().Unload();
		For Each vGuestGroupsRow In vGuestGroups Do
			// Build return object
			vGuestGroupDetails = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupDetails"));
			// Get guest group object
			vGuestGroupObj = vGuestGroupsRow.GuestGroup.GetObject();
			// Fill XDTO object attributes
			vGuestGroupDetails.GuestGroup = Format(vGuestGroupObj.Code, "ND=12; NFD=0; NZ=; NG=");
			vGuestGroupDetails.Customer = TrimAll(vCustomer.Description);
			vGuestGroupDetails.Contract = TrimAll(vGuestGroupsRow.Contract);
			vGuestGroupDetails.Agent = TrimAll(vGuestGroupsRow.Agent);
			If ValueIsFilled(vGuestGroupsRow.Status) Then
				vGuestGroupDetails.Status = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "ReservationStatuses", vGuestGroupsRow.Status);
				vGuestGroupDetails.StatusCode = TrimAll(vGuestGroupsRow.Status.Code);
				vGuestGroupDetails.StatusDescription = TrimAll(vGuestGroupsRow.Status.Description);
			Else
				vGuestGroupDetails.Status = "";
				vGuestGroupDetails.StatusCode = "";
				vGuestGroupDetails.StatusDescription = "";
			EndIf;
			vGuestGroupDetails.CheckInDate = vGuestGroupsRow.CheckInDate;
			vGuestGroupDetails.Duration = vGuestGroupsRow.Duration;
			vGuestGroupDetails.CheckOutDate = vGuestGroupsRow.CheckOutDate;
			vGuestGroupDetails.NumberOfPersons = vGuestGroupsRow.NumberOfPersons;
			vGuestGroupDetails.GuestFullName = TrimAll(vGuestGroupsRow.GuestFullName);
			vGuestGroupDetails.Remarks = Left(vGuestGroupsRow.Remarks, 4096);
			vGuestGroupDetails.Amount = vGuestGroupsRow.Sales;
			vGuestGroupDetails.Balance = vGuestGroupsRow.Sales - vGuestGroupsRow.PaymentAmount;
			If vGuestGroupsRow.Sales <> 0 And ValueIsFilled(vGuestGroupsRow.Currency) Then
				vGuestGroupDetails.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vGuestGroupsRow.Currency);
				vGuestGroupDetails.CurrencyCode = TrimAll(vGuestGroupsRow.CurrencyCode);
				vGuestGroupDetails.CurrencyDescription = TrimAll(vGuestGroupsRow.CurrencyDescription);
				vGuestGroupDetails.PaymentPercent = Round(vGuestGroupsRow.PaymentAmount/vGuestGroupsRow.Sales*100, 0);
			Else
				vGuestGroupDetails.Currency = "";
				vGuestGroupDetails.CurrencyCode = "";
				vGuestGroupDetails.CurrencyDescription = "";
				vGuestGroupDetails.PaymentPercent = 0;
			EndIf;
			// Add guest group to the return object
			vRetXDTO.GuestGroupDetails.Add(vGuestGroupDetails);
		EndDo;
	EndIf;	
	Return vRetXDTO;
EndFunction // cmGetAgentGroupsList 

// -----------------------------------------------------------------------------
// Description: Returns the amount of the certificate
// Parameters: Hotel code, Gift certificate code
// Return value: -1 - if certificate is not found, -2 - certificate is blocked,  or amount of the certificate
// -----------------------------------------------------------------------------
Function cmGetCertificateAmount(pGiftCertificate) Export 
	WriteLogEvent(NStr("en='Pay by certificate';ru='Оплата сертификатом.ЗапросБаланса';de='Pay by certificate'"), EventLogLevel.Information, , , 
	NStr("en='Certificate code: ';ru='Код сертификата: ';de='Gutschein-Code: '")+pGiftCertificate);
	vHotel = SessionParameters.CurrentHotel;
	
	If Not cmGiftCertificateExists(vHotel,pGiftCertificate) Then
		Return -1;
	EndIf;
	
	vDate = CurrentSessionDate();
	
	If cmGiftCertificateIsBlocked (vHotel,pGiftCertificate,vDate,"") Then
		Return -2;
	EndIf;

	Return cmGetGiftCertificateBalance(vHotel, pGiftCertificate, vDate); 

EndFunction //  cmGetCertificateAmount()

// -----------------------------------------------------------------------------
Function GetAccommodationTypePriceFromRoomRatePrices(pHotel, pRoomQuota, pRoomType, pAccommodationType, pClientType, pRoomRate, pCheckInDate, pCheckOutDate, pCalendarDayTypes = Undefined, pOrders = Undefined, pPriceTags = Undefined, pPriceCalculationDate = Undefined)
	vPriceCalculationDate = pPriceCalculationDate;
	If pPriceCalculationDate = Undefined Then
		vPriceCalculationDate = CurrentSessionDate();
	EndIf;
	// First get active for check in date set room rate prices documents
	vOrders = pOrders;
	If Not ValueIsFilled(vOrders) Then
		vOrders = cmGetActiveSetRoomRatePrices(pRoomRate, vPriceCalculationDate, pCheckInDate, pCheckOutDate, , pHotel);
	EndIf;
	vSetRoomRatePrices = New ValueList();
	vSetRoomRatePrices.LoadValues(vOrders.UnloadColumn("SetRoomRatePrices"));
	// Retrieve set room rate prices documents rows
	vQry = New Query();
	If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
		vQry.Text = 
		"SELECT
		|	AccommodationTypeFormulas.Ref.RoomRate AS RoomRate,
		|	AccommodationTypeFormulas.Ref.Hotel AS Hotel,
		|	AccommodationTypeFormulas.Ref AS SetRoomRatePrices,
		|	AccommodationTypeFormulas.Ref.CalendarDayType AS CalendarDayType,
		|	AccommodationTypeFormulas.Ref.PriceTag AS PriceTag,
		|	AccommodationTypeFormulas.ClientType AS ClientType,
		|	AccommodationTypeFormulas.Service AS Service,
		|	AccommodationTypeFormulas.RoomClass AS RoomClass,
		|	AccommodationTypeFormulas.RoomType AS RoomType,
		|	AccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	AccommodationTypeFormulas.Multiplier AS Multiplier,
		|	AccommodationTypeFormulas.BracketsConstant AS BracketsConstant,
		|	AccommodationTypeFormulas.Constant AS Constant,
		|	AccommodationTypeFormulas.LineNumber AS LineNumber,
		|	AccommodationTypeFormulas.LineNumber AS SortCode
		|INTO RateAccommodationTypeFormulas
		|FROM
		|	Document.SetRoomRatePrices.Formulas AS AccommodationTypeFormulas
		|WHERE
		|	AccommodationTypeFormulas.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	FormulasForPriceTags.Ref.RoomRate AS RoomRate,
		|	FormulasForPriceTags.Ref.Hotel AS Hotel,
		|	FormulasForPriceTags.Ref AS SetRoomRatePrices,
		|	FormulasForPriceTags.CalendarDayType AS CalendarDayType,
		|	FormulasForPriceTags.PriceTag AS PriceTag,
		|	FormulasForPriceTags.ClientType AS ClientType,
		|	FormulasForPriceTags.Service AS Service,
		|	FormulasForPriceTags.RoomClass AS RoomClass,
		|	FormulasForPriceTags.RoomType AS RoomType,
		|	FormulasForPriceTags.AccommodationType AS AccommodationType,
		|	FormulasForPriceTags.Discount AS Discount,
		|	FormulasForPriceTags.Multiplier AS Multiplier,
		|	FormulasForPriceTags.BracketsConstant AS BracketsConstant,
		|	FormulasForPriceTags.Constant AS Constant,
		|	FormulasForPriceTags.LineNumber AS LineNumber,
		|	FormulasForPriceTags.LineNumber AS SortCode
		|INTO FormulasForPriceTags
		|FROM
		|	Document.SetRoomRatePrices.FormulasForDayTypesAndPricetags AS FormulasForPriceTags
		|WHERE
		|	FormulasForPriceTags.Ref IN(&qSetRoomRatePrices)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Ref AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRule.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RateServices
		|FROM
		|	Catalog.Services AS RateServices
		|WHERE
		|	RateServices.Ref = &qAccommodationService
		|	AND NOT RateServices.IsFolder
		|	AND NOT RateServices.DeletionMark
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RateServices.Service AS Service,
		|	RateServices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RateServices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RateServices.IsRoomRevenue AS IsRoomRevenue,
		|	RateServices.IsInPrice AS IsInPrice,
		|	RateServices.ChargePerPerson AS ChargePerPerson,
		|	RateServices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RateServices.Unit AS Unit,
		|	RateServices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly,
		|	RoomTypePricesByDates.RoomType AS RoomType,
		|	RoomTypePricesByDates.AccountingDate AS AccountingDate,
		|	RoomTypePricesByDates.CalendarDayType AS CalendarDayType,
		|	RoomTypePricesByDates.PriceTag AS PriceTag,
		|	RoomTypePricesByDates.RoomPrice AS Price,
		|	RoomTypePricesByDates.RoomPriceCurrency AS Currency
		|INTO RoomTypePricesByDates
		|FROM
		|	(SELECT DISTINCT
		|		DaysByRoomTypes.RoomType AS RoomType,
		|		DaysByRoomTypes.AccountingDate AS AccountingDate,
		|		DaysByRoomTypes.CalendarDayType AS CalendarDayType,
		|		DaysByRoomTypes.PriceTag AS PriceTag,
		|		DaysByRoomTypes.RoomPrice AS RoomPrice,
		|		DaysByRoomTypes.RoomPriceCurrency AS RoomPriceCurrency
		|	FROM
		|		(SELECT
		|			RoomTypes.Ref AS RoomType,
		|			CalendarDays.AccountingDate AS AccountingDate,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType IS NULL
		|					THEN CalendarDays.CalendarDayType
		|				WHEN CalendarDaysByRoomTypes.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|					THEN CalendarDays.CalendarDayType
		|				ELSE CalendarDaysByRoomTypes.CalendarDayType
		|			END AS CalendarDayType,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.PriceTag IS NULL
		|					THEN CalendarDays.PriceTag
		|				WHEN CalendarDaysByRoomTypes.PriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|					THEN CalendarDays.PriceTag
		|				ELSE CalendarDaysByRoomTypes.PriceTag
		|			END AS PriceTag,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPrice IS NULL
		|					THEN CalendarDays.RoomPrice
		|				WHEN CalendarDaysByRoomTypes.RoomPrice = 0
		|					THEN CalendarDays.RoomPrice
		|				ELSE CalendarDaysByRoomTypes.RoomPrice
		|			END AS RoomPrice,
		|			CASE
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency IS NULL
		|					THEN CalendarDays.RoomPriceCurrency
		|				WHEN CalendarDaysByRoomTypes.RoomPriceCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|					THEN CalendarDays.RoomPriceCurrency
		|				ELSE CalendarDaysByRoomTypes.RoomPriceCurrency
		|			END AS RoomPriceCurrency
		|		FROM
		|			InformationRegister.CalendarDays.SliceLast(
		|					&qPriceCalculationDate,
		|					AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|						AND Calendar = &qCalendar) AS CalendarDays
		|				LEFT JOIN Catalog.RoomTypes AS RoomTypes
		|				ON (RoomTypes.Owner = &qHotel)
		|					AND (RoomTypes.Ref IN HIERARCHY (&qRoomType))
		|					AND (NOT RoomTypes.IsFolder)
		|					AND (NOT RoomTypes.DeletionMark)
		|				LEFT JOIN InformationRegister.CalendarDaysByRoomTypes.SliceLast(
		|						&qPriceCalculationDate,
		|						AccountingDate BETWEEN &qDateFrom AND &qDateTo
		|							AND Calendar = &qCalendar) AS CalendarDaysByRoomTypes
		|				ON CalendarDays.AccountingDate = CalendarDaysByRoomTypes.AccountingDate
		|					AND (RoomTypes.Ref = CalendarDaysByRoomTypes.RoomType)) AS DaysByRoomTypes) AS RoomTypePricesByDates
		|		LEFT JOIN RateServices AS RateServices
		|		ON (TRUE)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RawRoomRatePrices.AccountingDate AS AccountingDate,
		|	RateAccommodationTypeFormulas.RoomRate AS RoomRate,
		|	CASE
		|		WHEN RawRoomRatePrices.CalendarDayType <> VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|			THEN RawRoomRatePrices.CalendarDayType
		|		ELSE RateAccommodationTypeFormulas.CalendarDayType
		|	END AS CalendarDayType,
		|	CASE
		|		WHEN RawRoomRatePrices.PriceTag <> VALUE(Catalog.PriceTags.EmptyRef)
		|			THEN RawRoomRatePrices.PriceTag
		|		ELSE RateAccommodationTypeFormulas.PriceTag
		|	END AS PriceTag,
		|	RateAccommodationTypeFormulas.ClientType AS ClientType,
		|	RawRoomRatePrices.RoomType AS RoomType,
		|	RawRoomRatePrices.RoomType.RoomClass AS RoomClass,
		|	RateAccommodationTypeFormulas.AccommodationType AS AccommodationType,
		|	RateAccommodationTypeFormulas.SetRoomRatePrices AS SetRoomRatePrices,
		|	RateAccommodationTypeFormulas.SortCode AS SortCode,
		|	RateAccommodationTypeFormulas.LineNumber AS LineNumber,
		|	RateAccommodationTypeFormulas.Hotel AS Hotel,
		|	RawRoomRatePrices.Service AS Service,
		|	(RawRoomRatePrices.Price + ISNULL(RateAccommodationTypeFormulas.BracketsConstant, 0)) * ISNULL(RateAccommodationTypeFormulas.Multiplier, 0) + ISNULL(RateAccommodationTypeFormulas.Constant, 0) AS Price,
		|	RawRoomRatePrices.Currency AS Currency,
		|	0 AS MinimumQuantity,
		|	ISNULL(ServicePrices.VATRate, RateAccommodationTypeFormulas.Hotel.Company.VATRate) AS VATRate,
		|	RawRoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RawRoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RawRoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RawRoomRatePrices.IsInPrice AS IsInPrice,
		|	RawRoomRatePrices.ChargePerPerson AS IsPricePerPerson,
		|	RawRoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RawRoomRatePrices.Unit AS Unit,
		|	RawRoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RawRoomRatePrices
		|FROM
		|	RoomTypePricesByDates AS RawRoomRatePrices
		|		LEFT JOIN RateAccommodationTypeFormulas AS RateAccommodationTypeFormulas
		|		ON (RawRoomRatePrices.Service = RateAccommodationTypeFormulas.Service
		|				OR RateAccommodationTypeFormulas.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND (RawRoomRatePrices.RoomType = RateAccommodationTypeFormulas.RoomType
		|					AND RateAccommodationTypeFormulas.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RawRoomRatePrices.RoomType.RoomClass = RateAccommodationTypeFormulas.RoomClass
		|					AND RateAccommodationTypeFormulas.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR RateAccommodationTypeFormulas.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND RateAccommodationTypeFormulas.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|		LEFT JOIN InformationRegister.ServicePrices.SliceLast(
		|				&qPriceCalculationDate,
		|				Service = &qAccommodationService
		|					AND Hotel = &qHotel) AS ServicePrices
		|		ON RawRoomRatePrices.Service = ServicePrices.Service
		|			AND (RateAccommodationTypeFormulas.ClientType = ServicePrices.ClientType)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.AccountingDate AS AccountingDate,
		|	RoomRatePrices.RoomRate AS RoomRate,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.ClientType AS ClientType,
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.SetRoomRatePrices AS SetRoomRatePrices,
		|	RoomRatePrices.SortCode AS SortCode,
		|	RoomRatePrices.LineNumber AS LineNumber,
		|	RoomRatePrices.Hotel AS Hotel,
		|	RoomRatePrices.Service AS Service,
		|	CASE
		|		WHEN ISNULL(FormulasForPriceTags.Discount, 0) <> 0
		|			THEN RoomRatePrices.Price - RoomRatePrices.Price * ISNULL(FormulasForPriceTags.Discount, 0) / 100
		|		ELSE (RoomRatePrices.Price + ISNULL(FormulasForPriceTags.BracketsConstant, 0)) * ISNULL(FormulasForPriceTags.Multiplier, 1) + ISNULL(FormulasForPriceTags.Constant, 0)
		|	END AS Price,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRatePrices.MinimumQuantity AS MinimumQuantity,
		|	RoomRatePrices.VATRate AS VATRate,
		|	RoomRatePrices.QuantityCalculationRule AS QuantityCalculationRule,
		|	RoomRatePrices.QuantityCalculationRuleType AS QuantityCalculationRuleType,
		|	RoomRatePrices.IsRoomRevenue AS IsRoomRevenue,
		|	RoomRatePrices.IsInPrice AS IsInPrice,
		|	RoomRatePrices.IsPricePerPerson AS IsPricePerPerson,
		|	RoomRatePrices.ChargeToEachGuestSeparately AS ChargeToEachGuestSeparately,
		|	RoomRatePrices.Unit AS Unit,
		|	RoomRatePrices.RoomRevenueAmountsOnly AS RoomRevenueAmountsOnly
		|INTO RoomRatePrices
		|FROM
		|	RawRoomRatePrices AS RoomRatePrices
		|		LEFT JOIN FormulasForPriceTags AS FormulasForPriceTags
		|		ON (RoomRatePrices.Service = FormulasForPriceTags.Service
		|					AND FormulasForPriceTags.Service <> VALUE(Catalog.Services.EmptyRef)
		|				OR FormulasForPriceTags.Service = VALUE(Catalog.Services.EmptyRef))
		|			AND RoomRatePrices.ClientType = FormulasForPriceTags.ClientType
		|			AND RoomRatePrices.PriceTag = FormulasForPriceTags.PriceTag
		|			AND RoomRatePrices.CalendarDayType = FormulasForPriceTags.CalendarDayType
		|			AND (RoomRatePrices.AccommodationType = FormulasForPriceTags.AccommodationType
		|					AND FormulasForPriceTags.AccommodationType <> VALUE(Catalog.AccommodationTypes.EmptyRef)
		|				OR FormulasForPriceTags.AccommodationType = VALUE(Catalog.AccommodationTypes.EmptyRef))
		|			AND (RoomRatePrices.RoomType = FormulasForPriceTags.RoomType
		|					AND FormulasForPriceTags.RoomType <> VALUE(Catalog.RoomTypes.EmptyRef)
		|				OR RoomRatePrices.RoomType.RoomClass = FormulasForPriceTags.RoomClass
		|					AND FormulasForPriceTags.RoomClass <> VALUE(Catalog.RoomTypeClasses.EmptyRef)
		|				OR FormulasForPriceTags.RoomType = VALUE(Catalog.RoomTypes.EmptyRef)
		|					AND FormulasForPriceTags.RoomClass = VALUE(Catalog.RoomTypeClasses.EmptyRef))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.CalendarDayType.SortCode AS CalendarDayTypeSortCode,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.PriceTag.SortCode AS PriceTagSortCode,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRatePrices.Currency.SortCode AS CurrencySortCode,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS PriceBeforeDiscount,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalRooms, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsInQuota, 0)
		|		END) AS TotalRooms,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalBeds, 0)
		|			ELSE ISNULL(RoomQuotas.BedsInQuota, 0)
		|		END) AS TotalBeds,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.RoomsAvailable, 0) < ISNULL(RoomQuotas.RoomsRemains, 0)
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsRemains, 0)
		|		END) AS RoomsAvailable,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.BedsAvailable, 0) < ISNULL(RoomQuotas.BedsRemains, 0)
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.BedsRemains, 0)
		|		END) AS BedsAvailable,
		|	1 AS Quantity,
		|	0 AS Sum,
		|	0 AS AvgPrice,
		|	0 AS Discount,
		|	0 AS SumBeforeDiscount
		|FROM
		|	RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN (SELECT
		|			RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance, 0)) AS TotalRooms,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance, 0)) AS TotalBeds,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance, 0)) AS RoomsAvailable,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance, 0)) AS BedsAvailable
		|		FROM
		|			AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Second,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomInventoryBalanceAndTurnovers.RoomType) AS RoomInventory
		|		ON RoomRatePrices.RoomType = RoomInventory.RoomType
		|		LEFT JOIN (SELECT
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance, 0)) AS RoomsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance, 0)) AS BedsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance, 0)) AS RoomsRemains,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance, 0)) AS BedsRemains
		|		FROM
		|			AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Minute,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)
		|						AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType) AS RoomQuotas
		|		ON RoomRatePrices.RoomType = RoomQuotas.RoomType
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.RoomRate = &qPricesRoomRate
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.AccommodationType IN HIERARCHY(&qAccommodationType)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|
		|GROUP BY
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.CalendarDayType.SortCode,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.PriceTag.SortCode,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.Currency.SortCode,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier,
		|	RoomRateFormulas.ReplaceWithService
		|
		|ORDER BY
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayTypeSortCode,
		|	PriceTagSortCode,
		|	CurrencySortCode
		|TOTALS BY
		|	RoomType ONLY HIERARCHY";
		vQry.SetParameter("qDateFrom", BegOfDay(pCheckInDate));
		vQry.SetParameter("qDateTo", BegOfDay(pCheckOutDate));
		vQry.SetParameter("qCheckInDate", cm1SecondShift(pCheckInDate));
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qCheckOutDate", New Boundary(cm0SecondShift(pCheckOutDate), BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qCalendar", pRoomRate.Calendar);
		vQry.SetParameter("qAccommodationService", pRoomRate.AccommodationService);
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomQuota", pRoomQuota);
		vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
		vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qAccommodationType", pAccommodationType);
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	Else
		vQry.Text = 
		"SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRatePrices.RoomType AS RoomType,
		|	RoomRatePrices.RoomType.SortCode AS RoomTypeSortCode,
		|	RoomRatePrices.AccommodationType AS AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode AS AccommodationTypeSortCode,
		|	RoomRatePrices.CalendarDayType AS CalendarDayType,
		|	RoomRatePrices.CalendarDayType.SortCode AS CalendarDayTypeSortCode,
		|	RoomRatePrices.PriceTag AS PriceTag,
		|	RoomRatePrices.PriceTag.SortCode AS PriceTagSortCode,
		|	RoomRatePrices.Currency AS Currency,
		|	RoomRatePrices.Currency.SortCode AS CurrencySortCode,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS Price,
		|	SUM(CASE
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons4Reservation > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons4Reservation
		|			WHEN RoomRatePrices.IsPricePerPerson
		|					AND RoomRatePrices.AccommodationType.NumberOfPersons > 1
		|				THEN ((RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)) * RoomRatePrices.AccommodationType.NumberOfPersons
		|			ELSE (RoomRatePrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0)
		|		END) AS PriceBeforeDiscount,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalRooms, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsInQuota, 0)
		|		END) AS TotalRooms,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.TotalBeds, 0)
		|			ELSE ISNULL(RoomQuotas.BedsInQuota, 0)
		|		END) AS TotalBeds,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.RoomsAvailable, 0) < ISNULL(RoomQuotas.RoomsRemains, 0)
		|				THEN ISNULL(RoomInventory.RoomsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.RoomsRemains, 0)
		|		END) AS RoomsAvailable,
		|	MIN(CASE
		|			WHEN &qRoomQuotaIsEmpty
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			WHEN &qRoomQuotaDoNotWriteOff
		|					AND ISNULL(RoomInventory.BedsAvailable, 0) < ISNULL(RoomQuotas.BedsRemains, 0)
		|				THEN ISNULL(RoomInventory.BedsAvailable, 0)
		|			ELSE ISNULL(RoomQuotas.BedsRemains, 0)
		|		END) AS BedsAvailable,
		|	1 AS Quantity,
		|	0 AS Sum,
		|	0 AS AvgPrice,
		|	0 AS Discount,
		|	0 AS SumBeforeDiscount
		|FROM
		|	InformationRegister.RoomRatePrices AS RoomRatePrices
		|		LEFT JOIN (SELECT
		|			RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance, 0)) AS TotalRooms,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance, 0)) AS TotalBeds,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance, 0)) AS RoomsAvailable,
		|			MIN(ISNULL(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance, 0)) AS BedsAvailable
		|		FROM
		|			AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Second,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)) AS RoomInventoryBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomInventoryBalanceAndTurnovers.RoomType) AS RoomInventory
		|		ON RoomRatePrices.RoomType = RoomInventory.RoomType
		|		LEFT JOIN (SELECT
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance, 0)) AS CounterClosingBalance,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance, 0)) AS RoomsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance, 0)) AS BedsInQuota,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance, 0)) AS RoomsRemains,
		|			MIN(ISNULL(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance, 0)) AS BedsRemains
		|		FROM
		|			AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|					&qCheckInDate,
		|					&qCheckOutDate,
		|					Minute,
		|					RegisterRecordsAndPeriodBoundaries,
		|					Hotel = &qHotel
		|						AND RoomType IN HIERARCHY (&qRoomType)
		|						AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
		|		
		|		GROUP BY
		|			RoomQuotaSalesBalanceAndTurnovers.RoomType) AS RoomQuotas
		|		ON RoomRatePrices.RoomType = RoomQuotas.RoomType
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRatePrices.RoomRate = RoomRateFormulas.BasedOnRoomRate
		|			AND RoomRatePrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRatePrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRatePrices.ClientType = RoomRateFormulas.ClientType
		|					AND RoomRatePrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (RoomRatePrices.CalendarDayType = RoomRateFormulas.CalendarDayType
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|					AND (RoomRatePrices.Service = RoomRateFormulas.Service
		|						OR RoomRateFormulas.Service = VALUE(Catalog.Services.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRatePrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRatePrices.Hotel = &qHotel
		|	AND RoomRatePrices.RoomRate = &qPricesRoomRate
		|	AND RoomRatePrices.ClientType = &qClientType
		|	AND RoomRatePrices.RoomType IN HIERARCHY(&qRoomType)
		|	AND RoomRatePrices.AccommodationType IN HIERARCHY(&qAccommodationType)
		|	AND RoomRatePrices.SetRoomRatePrices IN(&qSetRoomRatePrices)
		|	AND RoomRatePrices.IsInPrice = TRUE
		|
		|GROUP BY
		|	RoomRatePrices.RoomType,
		|	RoomRatePrices.RoomType.SortCode,
		|	RoomRatePrices.AccommodationType,
		|	RoomRatePrices.AccommodationType.SortCode,
		|	RoomRatePrices.CalendarDayType,
		|	RoomRatePrices.CalendarDayType.SortCode,
		|	RoomRatePrices.PriceTag,
		|	RoomRatePrices.PriceTag.SortCode,
		|	RoomRatePrices.Currency,
		|	RoomRatePrices.Currency.SortCode,
		|	RoomRateFormulas.Constant,
		|	RoomRateFormulas.Multiplier,
		|	RoomRateFormulas.ReplaceWithService
		|
		|ORDER BY
		|	RoomTypeSortCode,
		|	AccommodationTypeSortCode,
		|	CalendarDayTypeSortCode,
		|	PriceTagSortCode,
		|	CurrencySortCode
		|TOTALS BY
		|	RoomType ONLY HIERARCHY";
		vQry.SetParameter("qCheckInDate", cm1SecondShift(pCheckInDate));
		vQry.SetParameter("qPriceCalculationDate", vPriceCalculationDate);
		vQry.SetParameter("qCheckOutDate", New Boundary(cm0SecondShift(pCheckOutDate), BoundaryType.Excluding));
		vQry.SetParameter("qClientType", pClientType);
		vQry.SetParameter("qPricesRoomRate", ?(ValueIsFilled(pRoomRate.BasedOnRoomRate), pRoomRate.BasedOnRoomRate, pRoomRate));
		vQry.SetParameter("qRoomRate", pRoomRate);
		vQry.SetParameter("qHotel", pHotel);
		vQry.SetParameter("qRoomQuota", pRoomQuota);
		vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
		vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
		vQry.SetParameter("qRoomType", pRoomType);
		vQry.SetParameter("qAccommodationType", pAccommodationType);
		vQry.SetParameter("qSetRoomRatePrices", vSetRoomRatePrices);
	EndIf;
	vList = vQry.Execute().Unload();
	// Add discounts from room rate discount type
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.DiscountType) Then
		vDiscountTypeObj = pRoomRate.DiscountType.GetObject();
		vDiscount = vDiscountTypeObj.pmGetDiscount(cm1SecondShift(pCheckInDate), , pHotel);
		For Each vListRow In vList Do
			vListRow.Discount = vDiscount;
			vListRow.Price = vListRow.Price - Round(vListRow.Price*vDiscount/100, 2);
		EndDo;
	EndIf;
	// Calculate new row values
	If ValueIsFilled(pRoomRate) And ValueIsFilled(pRoomRate.Calendar) Then
		vPackagesList = pRoomRate.GetObject().pmGetRoomRateServicePackagesList(, True);
		vCalendarDayTypes = pCalendarDayTypes;
		If Not ValueIsFilled(vCalendarDayTypes) Then
			vCalendarDayTypes = pRoomRate.Calendar.GetObject().pmGetDays(pCheckInDate, pCheckOutDate, pCheckInDate, pCheckOutDate, pRoomType, vPriceCalculationDate);
			vCalendarDayTypes.Sort("Period");
		EndIf;
		vPriceTags = pPriceTags;
		For Each vListRow In vList Do
			If ValueIsFilled(vListRow.AccommodationType) And ValueIsFilled(vListRow.RoomType) Then
				vSumBeforeDiscount = 0;
				vSum = 0;
				vNumDays = 0;
				vAvgPrice = 0;
				vCurrency = Undefined;
				vDate = BegOfDay(pCheckInDate);
				vEndDate = BegOfDay(pCheckOutDate);
				If pRoomRate.DurationCalculationRuleType <> Enums.DurationCalculationRuleTypes.ByDays Then
					vEndDate = vEndDate - 24*3600;
				EndIf;
				If Not ValueIsFilled(pPriceTags) Then
					rPriceTagsList = New ValueList();
					vPriceTags = cmGetEffectivePriceTags(pHotel, pRoomRate, vListRow.RoomType, pCheckInDate, pCheckOutDate, rPriceTagsList, , vPriceCalculationDate);
				EndIf;
				While vDate <= vEndDate Do
					vNumDays = vNumDays + 1;
					If vNumDays > 1 And ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vCalendarDayTypeRow = vCalendarDayTypes.Find(vDate, "Period");
					If vCalendarDayTypeRow <> Undefined Or ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
						vCalendarDayType = vCalendarDayTypeRow.CalendarDayType;
						vPriceTagRows = vPriceTags.FindRows(New Structure("Period, RoomType", vDate, vListRow.RoomType));
						If vPriceTagRows.Count() = 0 Then
							vPriceTagRow = vPriceTags.Find(vDate, "Period");
						Else
							vPriceTagRow = vPriceTagRows.Get(0);
						EndIf;
						If vPriceTagRow <> Undefined Then
							vPriceTag = vPriceTagRow.PriceTag;
							If ValueIsFilled(pRoomRate) And pRoomRate.UsePricesFromCalendar Then
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vPriceTag));
							Else
								vRows = vList.FindRows(New Structure("RoomType, AccommodationType, CalendarDayType, PriceTag", vListRow.RoomType, vListRow.AccommodationType, vCalendarDayType, vPriceTag));
							EndIf;
							If vRows.Count() = 1 Then
								vRow = vRows.Get(0);
								If vCurrency = Undefined Then
									vCurrency = vRow.Currency;
								EndIf;
								If vCurrency <> vRow.Currency Then
									vDate = vDate + 24*3600;
									Continue;
								EndIf;
								// Add prices from room rate service packages
								For Each vPackagesListItem In vPackagesList Do
									vServicePackage = vPackagesListItem.Value;
									If ValueIsFilled(vServicePackage) Then
										If vServicePackage.DateValidFrom <= BegOfDay(pCheckInDate) And 
											(vServicePackage.DateValidTo >= BegOfDay(pCheckInDate) Or Not ValueIsFilled(vServicePackage.DateValidTo)) Then
											vServices = Catalogs.ServicePackages.GetServices(vServicePackage, vDate, vPriceCalculationDate);
											For Each vServicesRow In vServices Do
												If vServicesRow.IsInPrice Then
													If vRow.Currency = vServicesRow.Currency And 
														(pClientType = vServicesRow.ClientType Or ValueIsFilled(pClientType) And Not ValueIsFilled(vServicesRow.ClientType)) And
														(vRow.AccommodationType = vServicesRow.AccommodationType Or Not ValueIsFilled(vServicesRow.AccommodationType)) Then
														vRow.PriceBeforeDiscount = vRow.PriceBeforeDiscount + vServicesRow.Quantity * vServicesRow.Price;
														vRow.Price = vRow.Price + vServicesRow.Quantity * vServicesRow.Price;
													EndIf;
												EndIf;
											EndDo;
										EndIf;
									EndIf;
								EndDo;
								vSumBeforeDiscount = vSumBeforeDiscount + vRow.PriceBeforeDiscount;
								vSum = vSum + vRow.Price;
							Else
								vDate = vDate + 24*3600;
								Continue;
							EndIf;
						Else
							vDate = vDate + 24*3600;
							Continue;
						EndIf;
					Else
						vDate = vDate + 24*3600;
						Continue;
					EndIf;
					vDate = vDate + 24*3600;
				EndDo;
				vListRow.SumBeforeDiscount = vSumBeforeDiscount * vListRow.Quantity;
				vListRow.Sum = vSum * vListRow.Quantity;
				If vNumDays > 0 Then 
					vListRow.AvgPrice = Round(vListRow.Sum/vNumDays, 2);
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	// Return
	Return vList;
EndFunction // GetAccommodationTypePriceFromRoomRatePrices

// -----------------------------------------------------------------------------
// Description: Writes external preauthorisation to the external reservation folio 
// Parameters: External reservation code, External guest group code, External client 
//             code, Payer name, Payment method, Payment amount (number), Payment 
//             currency, Hotel code, External system code, Credit \
//             card processing reference number, Credit card processing authorisation 
//             code, Remarks as string, Output type: XDTO GuestGroupPreauthorisationStatus object 
//             or string in CSV format
// Return value: XDTO GuestGroupPreauthorisationStatus object or CSV string
// -----------------------------------------------------------------------------
Function cmWriteExternalPreauthorisation(pExtReservationCode, pExtGroupCode, pExtClientCode, 
                                pExtPayerCode = "", pPayerTIN = "", pPayerKPP = "", pPayerName = "", 
                                pPaymentMethod, pSum, pCurrency, pHotelCode, pExternalSystemCode, 
								pReferenceNumber, pAuthorizationCode, pRemarks, pGuaranteedReservationStatus = "", 
								pPreauthorisationDate = Undefined, pCompanyCode = "", pPreauthorisationExternalCode = "", 
								pOutputType = "CSV", pExternalPaymentData = Undefined) Export
	WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='External reservation code: ';ru='Код брони во внешней системе: ';de='Reservierungscode im externen System: '") + pExtReservationCode + Chars.LF + 
	              NStr("en='External group code: ';ru='Код группы во внешней системе: ';de='Gruppencode im externen System: '") + pExtGroupCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='External client code: ';ru='Код клиента во внешней системы: ';de='Kundecode im externen System: '") + pExtClientCode + Chars.LF + 
	              NStr("en='External payer code: ';ru='Код плательщика во внешней системе: ';de='Zahlercode im externen System: '") + pExtPayerCode + Chars.LF + 
	              NStr("en='Payer name: ';ru='Наименование плательщика: ';de='Bezeichnung des Zahlers: '") + pPayerName + Chars.LF + 
	              NStr("en='Payer TIN: ';ru='ИНН плательщика: ';de='INN des Zahlers: '") + pPayerTIN + Chars.LF + 
	              NStr("en='Payer KPP: ';ru='КПП плательщика: ';de='Zahler-KPP: '") + pPayerKPP + Chars.LF + 
	              NStr("en='Payment method code: ';ru='Код способа оплаты: ';de='Code der Zahlungsmethode: '") + pPaymentMethod + Chars.LF + 
	              NStr("en='Reference number: ';ru='Референс номер: ';de='Referenznummer: '") + pReferenceNumber + Chars.LF + 
	              NStr("en='Authorization code: ';ru='Код авторизации: ';de='Autorisierungscode: '") + pAuthorizationCode + Chars.LF + 
	              NStr("en='Remarks: ';ru='Примечания: ';de='Anmerkungen: '") + pRemarks + Chars.LF + 
	              NStr("en='Guaranteed reservation status: ';ru='Статус оплаченной брони: ';de='Status der bezahlten Reservierung: '") + pGuaranteedReservationStatus + Chars.LF + 
	              NStr("en='Currency code: ';ru='Код валюты: ';de='Währungscode: '") + pCurrency + Chars.LF + 
	              NStr("en='Preauthorisation date: ';ru='Дата преавторизации: ';de='Vorautorisierung Datum: '") + pPreauthorisationDate + Chars.LF + 
	              NStr("en='Company code: ';ru='Код фирмы: ';de='Firmencode: '") + pCompanyCode + Chars.LF + 
	              NStr("en='Preauthorisation external code: ';ru='Код преавторизации во внешней системе: ';de='Vorautorisierung externen Code: '") + pPreauthorisationExternalCode + Chars.LF + 
	              NStr("en='Preauthorisation sum: ';ru='Сумма преавторизации: ';de='Vorautorisierung Summe: '") + Format(pSum, "ND=17; NFD=2; NZ="));
	If pExternalPaymentData <> Undefined Then
		WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, , , 
		              NStr("en='Card number: ';ru='Номер карты: ';de='Kartenummer: '") + pExternalPaymentData.CardNumber + Chars.LF + 
		              NStr("en='Order number: ';ru='Номер заказа: ';de='Bestellungsnummer: '") + pExternalPaymentData.OrderNumber + Chars.LF + 
		              NStr("en='Card holder: ';ru='Держатель карты: ';de='Kartenhalter: '") + pExternalPaymentData.CardHolder + Chars.LF + 
		              NStr("en='Invoice code: ';ru='Код счета на оплату: ';de='Rechnungscode: '") + pExternalPaymentData.InvoiceCode + Chars.LF + 
					  NStr("en='Preauthorisation external code from acc: ';ru='Код преавторизации в бух системе: ';de='Vorautorisierung code im externen System: '") + pExternalPaymentData.ExternalPaymentCode + Chars.LF + 
		              NStr("en='Operation date: ';ru='Дата операции: ';de='Betriebsdatum: '") + Format(pExternalPaymentData.Date, "DF='dd.MM.yyyy HH:mm'"));
	EndIf;
	Try
		// Save current timestamp and start transaction
		vCurrentDate = CurrentSessionDate();
		BeginTransaction(DataLockControlMode.Managed);
		// Initialize error description
		vErrorDescription = "";
		// Try to find hotel by name or code
		vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
		// Try to find existing reservation with given external code
		vDocRef = Documents.Reservation.EmptyRef();
		If Not IsBlankString(pExtReservationCode) Then
			vDocRef = cmGetReservationByExternalCode(vHotel, pExtReservationCode);
		EndIf;
		//
		If Not ValueIsFilled(pPreauthorisationExternalCode) And pExternalPaymentData <> Undefined Then
			pPreauthorisationExternalCode = pExternalPaymentData.ExternalPaymentCode; 
		EndIf;	
		// Try to find guest group by code
		vGuestGroup = Catalogs.GuestGroups.EmptyRef();
		If Not IsBlankString(pExtGroupCode) Then
			vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pExtGroupCode, "", "", False);
		EndIf;
		// Invoice
		vInvoiceRef = Undefined;
		If pExternalPaymentData <> Undefined And ValueIsFilled(pExternalPaymentData.Get("InvoiceCode")) Then
			vInvoiceCode = pExternalPaymentData.Get("InvoiceCode");
			vInvoiceRef = GetInvoiceByExternalSystemCode(vInvoiceCode);
			If ValueIsFilled(vInvoiceRef) Then
				If ValueIsFilled(vInvoiceRef.GuestGroup) And Not ValueIsFilled(vGuestGroup) Then
					vGuestGroup = vInvoiceRef.GuestGroup;
				EndIf;
			Else
				// Silently return from function because this invoice is not from this database. Simply skip this call
				vRetStr = "";
				If TransactionActive() Then
					RollbackTransaction();
				EndIf;
				// Log success		
				WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, , , 
							  NStr("en='Invoice code passed is not from hotel database - SKIPPING THIS CALL!';ru='Счет на оплату не найден по переданному коду! Этот счет не из отельной базы - ВЫЗОВ НЕ ОБРАБАТЫВАЕМ';de='Rechnung nicht über den übertragenen Code gefunden! Dieses Proformarechnung ist kein Hotel - Anruf wird übersprungen.'"));
				// Return based on output type
				If pOutputType = "CSV" Then
					Return vRetStr;
				Else
					vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPreauthorisationStatus"));
					vRetXDTO.PreauthorisationNumber = "";
					vRetXDTO.ErrorDescription = "";
					vRetXDTO.TotalSum = 0;
					vRetXDTO.TotalSumPresentation = "";
					vRetXDTO.Balance = 0;
					vRetXDTO.BalancePresentation = "";
					vRetXDTO.UUID = "";
					Return vRetXDTO;
				EndIf;
			EndIf;
		EndIf;
		// Try to find client by code
		vClient = Catalogs.Clients.EmptyRef();
		If Not IsBlankString(pExtClientCode) Then
			vClient = cmGetClientByExternalCode(pExtClientCode);
			If Not ValueIsFilled(vClient) Then
				vClient = cmGetClientByCode(pExtClientCode);
			EndIf;
		EndIf;
		// Try to find company
		vCompany = Catalogs.Companies.EmptyRef();
		If Not IsBlankString(pCompanyCode) Then
			vCompany = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Companies", pCompanyCode);
		EndIf;
		// Try to find payment method
		vPaymentMethod = Catalogs.PaymentMethods.EmptyRef();
		If Not IsBlankString(pPaymentMethod) Then
			vPaymentMethod = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentMethods", pPaymentMethod);
		EndIf;
		// Try to find reservation status
		vGuaranteedReservationStatus = Catalogs.ReservationStatuses.EmptyRef();
		If Not IsBlankString(pGuaranteedReservationStatus) Then
			vGuaranteedReservationStatus = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ReservationStatuses", pGuaranteedReservationStatus);
		Else
			vGuaranteedReservationStatus = vHotel.GuaranteedReservationStatus;
		EndIf;
		// Try to find currency
		vCurrency = Catalogs.Currencies.EmptyRef();
		If Not IsBlankString(pCurrency) Then
			If cmIsNumber(pCurrency) Then
				vCurrency = Catalogs.Currencies.FindByCode(Number(pCurrency));
			EndIf;
			If Not ValueIsFilled(vCurrency) Then
				vCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", pCurrency);
			EndIf;
		EndIf;
		// Try to find payer
		vCustomer = Catalogs.Customers.EmptyRef();
		If Not IsBlankString(pExtPayerCode) Then
			// Try to find customer by external code
			vCustomer = cmGetCustomerByExternalCode(TrimR(pExtPayerCode));
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pPayerTIN) Then
			// Try to find customer by TIN and KPP
			vCustomer = cmGetCustomerByTIN(TrimR(pPayerTIN), TrimR(pPayerKPP), "", False);
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pPayerName) Then
			// Try to find customer by name
			vCustomer = cmGetCustomerByName(Upper(TrimR(pPayerName)), , False,,,,,vHotel);
		EndIf;
		If Not ValueIsFilled(vCustomer) And Not IsBlankString(pExtPayerCode) And Not IsBlankString(pPayerTIN) And Not IsBlankString(pPayerName) Then 
			vCustomerObj = Catalogs.Customers.CreateItem();
			vCustomerObj.pmFillAttributesWithDefaultValues();
			vCustomerObj.Description = TrimR(pPayerName);
			vCustomerObj.LegacyName = TrimR(vCustomerObj.Description);
			vCustomerObj.TIN = TrimR(pPayerTIN);
			vCustomerObj.KPP = TrimR(pPayerKPP);
			vCustomerObj.ExternalCode = TrimR(pExtPayerCode);
			vCustomerObj.Write();
			vCustomerObj.pmWriteToCustomerChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			vCustomer = vCustomerObj.Ref;
		EndIf;
		// Check parameters
		If pSum = 0 Then
			Raise NStr("en='Preauthorisation sum should be filled!';ru='Сумма преавторизации должна быть указана!';de='Vorautorisierung Summe sollte ausgefüllt werden!'");
		ElsIf Not ValueIsFilled(vHotel) Then
			Raise NStr("en='Hotel should be specified!';ru='Гостиница должна быть указана!';de='Das Hotel muss angegeben sein!'");
		ElsIf Not ValueIsFilled(vCurrency) Then
			Raise NStr("en='Preauthorisation curency should be specified!';ru='Валюта преавторизации должна быть указана!';de='Vorautorisierung curency sollte festgelegt werden!'");
		ElsIf Not ValueIsFilled(vPaymentMethod) Then
			Raise NStr("en='Payment method should be choosen!';ru='Способ оплаты должен быть указан!';de='Zahlungsmethode muss definiert werden!'");
		EndIf;
		// Reset preauthorisation object
		vPreauthObj = Undefined;
		// Try to find preauthorisation document by external preauthorisation code
		If Not IsBlankString(pPreauthorisationExternalCode) Then
			vQry = New Query();
			vQry.Text = 
			"SELECT
			|	Preauthorisations.Ref AS Ref,
			|	Preauthorisations.Date AS Date
			|FROM
			|	Document.Preauthorisation AS Preauthorisations
			|WHERE
			|	Preauthorisations.ExternalCode = &qExternalCode
			|ORDER BY
			|	Date";
			vQry.SetParameter("qExternalCode", TrimR(pPreauthorisationExternalCode));
			vPreauthorisations = vQry.Execute().Unload();
			For Each vPreauthorisationsRow In vPreauthorisations Do
				vWrkPreauthorisationRef = vPreauthorisationsRow.Ref;
				If vPreauthorisations.IndexOf(vPreauthorisationsRow) > 0 Then
					If Not vWrkPreauthorisationRef.DeletionMark Then
						vWrkPreauthorisationObj = vWrkPreauthorisationRef.GetObject();
						vWrkPreauthorisationObj.SetDeletionMark(True);
					EndIf;
				EndIf;
			EndDo;
		EndIf;
		// Find guest group folio to write preauthorisation to
		If ValueIsFilled(vGuestGroup) Then
			// Fill hotel from guest group
			vHotel = vGuestGroup.Owner;
			// Run query to get folios to charge to
			vFolio = Undefined;
			If Not ValueIsFilled(vFolio) Then
				vQry = New Query();
				vQry.Text = 
				"SELECT
				|	Folio.Ref,
				|	Folio.ParentDoc
				|FROM
				|	Document.Folio AS Folio
				|WHERE
				|	(NOT Folio.DeletionMark)
				|	AND Folio.Hotel = &qHotel
				|	AND (Folio.ParentDoc = &qParentDoc
				|			OR &qParentDocIsEmpty)
				|	AND Folio.GuestGroup = &qGuestGroup
				|	AND (Folio.Client = &qClient
				|			OR &qClientIsEmpty)
				|	AND (Folio.Customer = &qCustomer
				|			OR &qCustomerIsEmpty)
				|	AND (Folio.Company = &qCompany
				|			OR &qCompanyIsEmpty)
				|ORDER BY
				|	Folio.PointInTime";
				vQry.SetParameter("qHotel", vHotel);
				vQry.SetParameter("qParentDoc", vDocRef);
				vQry.SetParameter("qParentDocIsEmpty", Not ValueIsFilled(vDocRef));
				vQry.SetParameter("qGuestGroup", vGuestGroup);
				vQry.SetParameter("qClient", vClient);
				vQry.SetParameter("qClientIsEmpty", Not ValueIsFilled(vClient));
				vQry.SetParameter("qCustomer", vCustomer);
				vQry.SetParameter("qCustomerIsEmpty", Not ValueIsFilled(vCustomer));
				vQry.SetParameter("qCompany", vCompany);
				vQry.SetParameter("qCompanyIsEmpty", Not ValueIsFilled(vCompany));
				WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, vGuestGroup.Metadata(), vGuestGroup, 
							  NStr("en='Folios search:';ru='Поиск лицевых счетов:';de='Suche nach Personenkonten:'") + Chars.LF + 
							  "qHotel: " + vHotel + Chars.LF +
							  "qGuestGroup: " + vGuestGroup + Chars.LF +
							  "qParentDoc: " + vDocRef + Chars.LF +
							  "qParentDocIsEmpty: " + (Not ValueIsFilled(vDocRef)) + Chars.LF +
							  "qClient: " + vClient + ?(ValueIsFilled(vClient), " (" + TrimAll(vClient.Code) + ")", "") + Chars.LF +
							  "qClientIsEmpty: " + (Not ValueIsFilled(vClient)) + Chars.LF +
							  "qCustomer: " + vCustomer + ?(ValueIsFilled(vCustomer), " (" + TrimAll(vCustomer.Code) + ")", "") + Chars.LF +
							  "qCustomerIsEmpty: " + (Not ValueIsFilled(vCustomer)) + Chars.LF +
							  "qCompany: " + vCompany + ?(ValueIsFilled(vCompany), " (" + TrimAll(vCompany.Code) + ")", "") + Chars.LF +
							  "qCompanyIsEmpty: " + (Not ValueIsFilled(vCompany)));
				vFolios = vQry.Execute().Unload();
				// Find folio with room revenue services
				For Each vFoliosRow In vFolios Do
					WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, vFoliosRow.Ref.Metadata(), vFoliosRow.Ref, 
								  NStr("en='Checking folio...';ru='Проверяем лицевой счет...';de='Wir überprüfen das Personenkonto...'"));
					If ValueIsFilled(vFoliosRow.ParentDoc) Then
						If TypeOf(vFoliosRow.ParentDoc) = Type("DocumentRef.Accommodation") Or
						   TypeOf(vFoliosRow.ParentDoc) = Type("DocumentRef.Reservation") Then
							If vFoliosRow.ParentDoc.Services.Count() > 0 Then
								vRoomRevenueServices = vFoliosRow.ParentDoc.Services.FindRows(New Structure("IsRoomRevenue", True));
								If vRoomRevenueServices.Count() > 0 Then
									vFolio = vRoomRevenueServices.Get(0).Folio;
									Break;
								EndIf;
							EndIf;
						EndIf;
					EndIf;
				EndDo;
			EndIf;
			// Get folio from group charging rules
			If Not ValueIsFilled(vFolio) Then
				If vGuestGroup.ChargingRules.Count() > 0 Then
					vGGCRRow = vGuestGroup.ChargingRules.Get(0);
					If ValueIsFilled(vGGCRRow.ChargingFolio) Then
						vFolio = vGGCRRow.ChargingFolio;
					EndIf;
				EndIf;
			EndIf;
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Preauthorisation folio was not found!';ru='Не найден лицевой счет!';de='Personenkonto nicht gefunden!'");
			EndIf;
			WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, vFolio.Metadata(), vFolio, 
						  NStr("en='Folio is choosen...';ru='Назначен лицевой счет...';de='Personenkonto wurde festgelegt…'"));
			// Create preauthorisation for the folio being found
			If vPreauthObj = Undefined Then
				vPreauthObj = Documents.Preauthorisation.CreateDocument();
				vPreauthObj.Hotel = vHotel;
			EndIf;
			vPreauthObj.Fill(vFolio);
			If pPreauthorisationDate <> Undefined Then
				vPreauthObj.Date = pPreauthorisationDate;
			EndIf;
			If ValueIsFilled(vCompany) Then
				vPreauthObj.Company = vCompany;
			EndIf;
			If Not IsBlankString(pPayerName) Then
				vPreauthObj.Remarks = pPayerName;
			EndIf;
			vPreauthObj.Status = Enums.PreauthorisationStatuses.Authorised;
			vPreauthObj.PaymentCurrency = vCurrency;
			vPreauthObj.PaymentMethod = vPaymentMethod;
			// Invoice
			If ValueIsFilled(vInvoiceRef) Then
				vPreauthObj.Invoice = vInvoiceRef;
			Else
				vInvoices = vFolio.GuestGroup.GetObject().pmGetInvoices(vFolio.Customer, vFolio.Contract);
				For Each vInvoicesRow In vInvoices Do
					If pSum > 0 And vInvoicesRow.Balance > 0 Then
						vPreauthObj.Invoice = vInvoices.Get(0).Invoice;
						Break;
					ElsIf pSum < 0 And vInvoicesRow.Balance = 0 Then
						vPreauthObj.Invoice = vInvoices.Get(0).Invoice;
						Break;
					EndIf;
				EndDo;
			EndIf;
			vPreauthObj.Sum = pSum;
			vPreauthObj.pmRecalculateSums();			
			// Reference and authorization codes
			vPreauthObj.ReferenceNumber = TrimAll(pReferenceNumber);
			vPreauthObj.AuthorizationCode = TrimAll(pAuthorizationCode);
			// Preauthorisation remarks
			vPreauthObj.SlipText = TrimR(pRemarks);
			// External system preauthorisation code
			vPreauthObj.ExternalCode = TrimR(pPreauthorisationExternalCode);
			// Set customer as payer
			If ValueIsFilled(vCustomer) And ValueIsFilled(vPreauthObj.PaymentMethod) And vPreauthObj.PaymentMethod.IsByBankTransfer Then
				If ValueIsFilled(vPreauthObj.Hotel) And vCustomer <> vPreauthObj.Hotel.IndividualsCustomer Then
					vPreauthObj.Payer = vCustomer;
				EndIf;
			EndIf;
			// Credit card
			vCreditCard = Catalogs.CreditCards.EmptyRef();
			If pExternalPaymentData <> Undefined Then
				If ValueIsFilled(pExternalPaymentData.CardNumber) Then
					// Search cards with given owner and number
					vQry = New Query();
					vQry.Text = 
					"SELECT
					|	CreditCards.Ref AS CreditCard
					|FROM
					|	Catalog.CreditCards AS CreditCards
					|WHERE
					|	CreditCards.CardOwner = &qCardOwner
					|	AND CreditCards.CardNumber = &qCardNumber
					|	AND CreditCards.DeletionMark = FALSE";
					vQry.SetParameter("qCardOwner", vPreauthObj.Payer);
					vQry.SetParameter("qCardNumber", TrimAll(pExternalPaymentData.CardNumber));
					vCards = vQry.Execute().Unload();
					If vCards.Count() > 0 Then
						// Return first found
						vCreditCard = vCards.Get(0).CreditCard;
					Else
						vCreditCardObj = Catalogs.CreditCards.CreateItem();
						vCreditCardObj.Description = cmGetCreditCardDescription(pExternalPaymentData.CardNumber);
						vCreditCardObj.pmFillAttributesWithDefaultValues();
						vCreditCardObj.CardOwner = vPreauthObj.Payer;
						vCreditCardObj.CardNumber = pExternalPaymentData.CardNumber;
						vCreditCardObj.CardHolder = pExternalPaymentData.CardHolder;
						vCreditCardObj.Write();
						vCreditCard = vCreditCardObj.Ref;
					EndIf;
				EndIf;
			EndIf;
			vPreauthObj.CreditCard = vCreditCard;
			// Post preauthorisation
			vPreauthObj.Write(DocumentWriteMode.Posting);
			// Update guest group reservation status
			If ValueIsFilled(vGuaranteedReservationStatus) And ValueIsFilled(vGuestGroup) Then 
				vOperationParameters = New Array();
				vOperationParameters.Add(vGuestGroup);
				vOperationParameters.Add(vGuaranteedReservationStatus);
				vOperationParameters.Add(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"));
				// Submit background update group status process
				AsyncCalls.StartBackgroundJob("ProlongedOperations.GuestGroups_SetReservationsStatus", vOperationParameters, String(vGuestGroup.UUID()), NStr("en='Update status of guest group reservations'; ru='Изменение статуса брони по группе'; de='Änderung des Gruppereservierungsstatus'"));
			EndIf;
			// Write guest group attachment that preauthorisation was received
			If Not vHotel.DoNotSendPaymentConfirmationEMailsForExternalSystemPayments Then
				vLanguage = vHotel.Language;
				If ValueIsFilled(vPreauthObj.Payer) And ValueIsFilled(vPreauthObj.Payer.Language) Then
					vLanguage = vPreauthObj.Payer.Language;
				EndIf;   
				vHotelPrintName = "";
				If ValueIsFilled(vHotel) Then
					vHotelPrintName = Catalogs.Hotels.pmGetHotelPrintName(vHotel, vLanguage);
				EndIf;
				vRemarks = vHotelPrintName + 
				StrTemplate(cmNStr("en = '. Preauthorisation N%1 at %2'; de = '. Preauthorisation N%1 at %2'; ru = '. Преавторизация №%1 от %2'", vLanguage), 
				TrimAll(vPreauthObj.Number), Format(vPreauthObj.Date, "DF=dd.MM.yy"));
				vClientFullName = "";
				If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.Client) Then
					vClientFullName = cmNStr("en='Client name: ';ru='Клиент: ';de='Kunde: '", vLanguage) + TrimAll(vGuestGroup.Client.FullName) + Chars.LF;
				EndIf;	    
				vPeriod = "";
				If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.CheckInDate) And ValueIsFilled(vGuestGroup.CheckOutDate) Then
					vPeriod = StrTemplate(cmNStr("en='Period of stay: %1 - %2';ru='Период проживания: %1 - %2';de='Unterbringungszeitraum: %1 - %2'", vLanguage), Format(vGuestGroup.CheckInDate, "DF='dd.MM.yyyy HH:mm'"), Format(vGuestGroup.CheckOutDate, "DF='dd.MM.yyyy HH:mm'")) + Chars.LF;
				EndIf;
				
				vGuaranteedReservationStatusPres = Chars.LF; 
				If ValueIsFilled(vGuaranteedReservationStatus) Then
					vGuaranteedReservationStatusPres = Chars.LF + cmNStr("en = 'Reservation status was changed to '; 
																		 |de = 'Status der Reservierung wurde verändert zu '; 
																		 |ru = 'Статус брони был изменен на '", vLanguage) + Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vGuaranteedReservationStatus, vLanguage) + Chars.LF; 
					
				EndIf;	   
				vDocumentText = vClientFullName 
								+ vPeriod
								+ Chars.LF 
								+ StrTemplate(cmNStr("en = 'Preauthorisation with amount %1 for reservation number %2 was received and successfully processed!'; 
													 |de = 'Preauthorisation with amount %1 for reservation number %2 was received and successfully processed!'; 
													 |ru = 'Преавторизация на сумму %1 по брони номер %2 был получен и успешно обработан!'", vLanguage), 
													  cmFormatSum(vPreauthObj.Sum, vPreauthObj.PaymentCurrency, "NZ="), Format(vGuestGroup.Code, "ND=12; NFD=0; NG=")) + Chars.LF  
								+ vGuaranteedReservationStatusPres + Chars.LF  
								+ cmNStr("en='Preauthorisation details are ';ru='Детали преавторизации ';de='Vorautorisierung Details '", vLanguage) + Chars.LF  
								+ TrimAll(vPreauthObj.SlipText) + Chars.LF + Chars.LF  
								+ cmNStr("en='Best regards,'; 
										 |de='Best regards,'; 
										 |ru='С уважением,'", vLanguage) + Chars.LF  
								+ vHotelPrintName + Chars.LF 
								+ cmNStr(SessionParameters.ConfigurationName, vLanguage);
				// Write attachment   
				InformationRegisters.GuestGroupAttachments.WriteData(, vGuestGroup,,,,,,,, Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, vDocumentText,,,,,,, True, vRemarks);
			EndIf;
		Else
			Raise NStr("en='Failed to get guest group!';ru='Не удалось определить группу гостей!';de='Fehler beim Gast Gruppe erhalten!'");
		EndIf;
		vGroupObj = vGuestGroup.GetObject();
		vSalesTotals = vGroupObj.pmGetSalesTotals();
		vPaymentTotals = vGroupObj.pmGetPaymentsTotals();
		// Get total group amount
		vSum = 0;
		vCurrency = vHotel.BaseCurrency;
		vExtCurrencyCode = "";
		vSumPresentation = "";
		If vSalesTotals.Count() > 0 Then
			vCurrency = vSalesTotals.Get(0).Currency;
			For Each vSalesTotalsRow In vSalesTotals Do
				If vSalesTotalsRow.Currency = vCurrency Then
					vSum = vSum + vSalesTotalsRow.Sales + vSalesTotalsRow.SalesForecast;
				Else
					vSum = vSum + cmConvertCurrencies(vSalesTotalsRow.Sales + vSalesTotalsRow.SalesForecast, vSalesTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
				EndIf;
			EndDo;
			vSum = Round(vSum, 2);
		EndIf;
		vSumPresentation = cmFormatSum(vSum, vCurrency, "NZ=");
		vExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGuestGroup.Owner, pExternalSystemCode, "Currencies", vCurrency);
		If IsBlankString(vExtCurrencyCode) Then
			vExtCurrencyCode = TrimAll(vCurrency.Description);
		EndIf;
		// Get base currency code
		vBaseCurrency = vHotel.BaseCurrency;
		vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGuestGroup.Owner, pExternalSystemCode, "Currencies", vBaseCurrency);
		If IsBlankString(vExtBaseCurrencyCode) Then
			vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
		EndIf;
		// Get currency rate
		vCurrencyRate = cmGetCurrencyExchangeRate(vHotel, vCurrency, CurrentSessionDate());
		// Get group balance
		vPaymentSum = 0;
		For Each vPaymentTotalsRow In vPaymentTotals Do
			If vPaymentTotalsRow.Currency = vCurrency Then
				vPaymentSum = vPaymentSum + vPaymentTotalsRow.Sum;
			Else
				vPaymentSum = vPaymentSum + cmConvertCurrencies(vPaymentTotalsRow.Sum, vPaymentTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
			EndIf;
			vPaymentSum = Round(vPaymentSum, 2);
		EndDo;
		vBalanceAmount = vSum - vPaymentSum;
		vBalanceAmountPresentation = cmFormatSum(vBalanceAmount, vCurrency, "NZ=");
		CommitTransaction();
		// Build return string
		vRetStr = """" + TrimAll(vPreauthObj.Number) + """" + "," + """" + """";
		// Log success		
		WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Information, vPreauthObj.Metadata(), vPreauthObj.Ref, 
					  NStr("en='Preauthorisation is written - OK!';ru='Преавторизация записана в БД!';de='Vorautorisierung geschrieben - OK!'") + Chars.LF + vRetStr);
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPreauthorisationStatus"));
			vRetXDTO.PreauthorisationNumber = TrimAll(vPreauthObj.Number);
			vRetXDTO.ErrorDescription = "";
			vRetXDTO.TotalSum = vSum;
			vRetXDTO.TotalSumPresentation = vSumPresentation;
			vRetXDTO.Balance = vBalanceAmount;
			vRetXDTO.BalancePresentation = vBalanceAmountPresentation;
			vRetXDTO.UUID = String(vGuestGroup.UUID());
			Return vRetXDTO;
		EndIf;
	Except
		vErrorDescription = ErrorDescription();
		If TransactionActive() Then
			RollbackTransaction();
		EndIf;
		// Write log event
		WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Error, , , 
		              NStr("en='Error description: ';ru='Описание ошибки: ';de='Fehlerbeschreibung: '") + ErrorDescription());
		// Send error notifications
		If ValueIsFilled(SessionParameters.CurrentUser) And Not IsBlankString(SessionParameters.CurrentUser.BccEMail) Then
			WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Error, , , 
						  NStr("en='Send notification e-mail: ';ru='Отправка e-mail уведомления об ошибке: ';de='Versenden einer Fehlermeldung per E-Mail: '") + NStr("en='Failed to write external preauthorisation! ';ru='Ошибка при сохранении внешней преавторизации! ';de='Fehler beim externen Vorautorisierung schreiben! '") + pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " + pCurrency + " -> " + TrimAll(SessionParameters.CurrentUser.BccEMail));
			vEMailErrorMessage = "";
			JobsScheduled.cmSendTextByEMail(NStr("en='Failed to write external preauthorisation! ';ru='Ошибка при сохранении внешней преавторизации! ';de='Fehler beim externen Vorautorisierung schreiben! '") + pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " + pCurrency, pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " + pCurrency + Chars.LF + Chars.LF + vErrorDescription, SessionParameters.CurrentUser.BccEMail, False, vEMailErrorMessage);
			If Not IsBlankString(vEMailErrorMessage) Then
				WriteLogEvent(NStr("en='Write external preauthorisation';ru='Записать внешнюю преавторизацию';de='Schreiben externen Vorautorisierung'"), EventLogLevel.Error, , , 
							  NStr("en='Error sending notification e-mail: ';ru='Не удалось отправить e-mail уведомление об ошибке: ';de='Es konnte keine E-Mail-Fehlerbenachrichtigung verschickt werden: '") + vEMailErrorMessage);
			EndIf;
		EndIf;
		// Build return string
		vRetStr = """" + """" + "," + """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPreauthorisationStatus"));
			vRetXDTO.PreauthorisationNumber = "";
			vRetXDTO.ErrorDescription = Left(vErrorDescription, 4096);
			vRetXDTO.TotalSum = 0;
			vRetXDTO.TotalSumPresentation = "";
			vRetXDTO.Balance = 0;
			vRetXDTO.BalancePresentation = "";
			vRetXDTO.UUID = "";
			Return vRetXDTO;
		EndIf;
	EndTry;
EndFunction // cmWriteExternalPreauthorisation

// -----------------------------------------------------------------------------
// Description: Checks-in guest group reservations checking user identity according to the 
//              user e-mail or phone number or reservation UUID e.t.c.
// Parameters: E-Mail, Phone, Login, Group code, Hotel code, External system code, Language code
// Return value: XDTO ExternalGroupReservationStatus object
// -----------------------------------------------------------------------------
Function cmCheckInGroupReservation(pEMail, pPhone, pLogin, pGuestGroupCode, pReservationCode, pExtraCheckInData, pHotelCode, pExternalSystemCode, pLanguageCode = "RU") Export
	vErrorMessage = "";
	// Build return XDTO object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get guest group by extrenal code
	vGroupRef = Undefined;
	If StrLen(pGuestGroupCode) = 36 Then
		vGroupRef = Catalogs.GuestGroups.GetRef(New UUID(TrimAll(pGuestGroupCode)));
	Else
		vGroupRef = cmGetGuestGroupByExternalCode(vHotel, pGuestGroupCode, "", "", False);
	EndIf;
	If Not ValueIsFilled(vGroupRef) Then
		vErrorMessage = cmNStr("en='Failed to find guest group by code '; ru='Не удалось найти группу по коду '; de='Fehler bei der Suche nach Gastgruppe nach Code '", vLanguage) + pGuestGroupCode;
	Else
		// Check if authentication data are present in the returned data
		If IsBlankString(pEMail) And IsBlankString(pPhone) And IsBlankString(pLogin) And StrLen(pGuestGroupCode) <> 36 Then
			vErrorMessage = cmNStr("en='Not authenticated!';ru='Пользователь не авторизован!';de='Der Nutzer ist nicht autorisiert!'", vLanguage);
		Else
			vIsAuthorized = False;
			vGuestEMail = "";
			vGuestPhone = "";
			If ValueIsFilled(vGroupRef.ClientDoc) Then
				vClientDoc = vGroupRef.ClientDoc;
				If Not IsBlankString(vClientDoc.EMail) Then
					vGuestEMail = TrimAll(vClientDoc.EMail);
				EndIf;
				If Not IsBlankString(vClientDoc.Phone) Then
					vGuestPhone = TrimAll(vClientDoc.Phone);
				EndIf;
			EndIf;
			If ValueIsFilled(vGroupRef.Client) Then
				vClient = vGroupRef.Client;
				If Not IsBlankString(vClient.EMail) And IsBlankString(vGuestEMail) Then
					vGuestEMail = TrimAll(vClient.EMail);
				EndIf;
				If Not IsBlankString(vClient.Phone) And IsBlankString(vGuestPhone) Then
					vGuestPhone = TrimAll(vClient.Phone);
				EndIf;
			EndIf;
			If Not IsBlankString(pEMail) Then
				If cmCheckEMailIsValid(TrimAll(pEMail)) And Find(Lower(vGuestEMail), Lower(TrimAll(pEMail))) > 0 Then
					vIsAuthorized = True;
				EndIf;
			EndIf;
			If Not IsBlankString(pPhone) Then
				If StrLen(TrimAll(pPhone)) >= 7 And Find(SMS.GetValidPhoneNumber(TrimAll(vGuestPhone)), SMS.GetValidPhoneNumber(TrimAll(pPhone))) > 0 Then
					vIsAuthorized = True;
				EndIf;
			EndIf;
			If Not IsBlankString(pLogin) Then
				vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
				If vCustomerStruct <> Undefined Then
					If ValueIsFilled(vCustomerStruct.Customer) Then
						If Find(Lower(vGroupRef.Customer), Lower(TrimAll(vCustomerStruct.Customer.Description))) > 0 Then
							vIsAuthorized = True;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
			If StrLen(pGuestGroupCode) = 36 Then
				vIsAuthorized = True;
			EndIf;
			If Not vIsAuthorized Then
				vErrorMessage = cmNStr("en='Not authenticated!';ru='Пользователь не авторизован!';de='Der Nutzer ist nicht autorisiert!'", vLanguage);
			Else
				vReservationsToCheckInList = New ValueList();
				If StrLen(pReservationCode) = 36 Then 
					vResDocRef = Documents.Reservation.GetRef(New UUID(TrimAll(pReservationCode)));
					If ValueIsFilled(vResDocRef) And Not vResDocRef.GetObject() = Undefined Then
						vReservationsToCheckInList.Add(vResDocRef);
					EndIf;
				EndIf;
				If vReservationsToCheckInList.Count() = 0 Then
					vGroupObj = vGroupRef.GetObject();
					vReservations = vGroupObj.pmGetReservations(True, True);
					
					For Each vReservationsRow In vReservations Do
						If Not IsBlankString(pReservationCode) Then
							If pReservationCode <> TrimAll(vReservationsRow.Number) And pReservationCode <> TrimAll(vReservationsRow.ExternalCode) Then
								Continue;
							EndIf;
						EndIf;
						vReservationsToCheckInList.Add(vReservationsRow.Reservation);
					EndDo;
				EndIf;
				If vReservationsToCheckInList.Count() = 0 Then
					vErrorMessage = cmNStr("en='No active reservations found for group/code '; ru='Не удалось найти действующую бронь по группе/коду '; de='Keine aktiven reservierungen für Gruppe/Code gefunden: '", vLanguage) + pGuestGroupCode + "/" + pReservationCode;
				Else
					cmCheckInGuests(vReservationsToCheckInList, pExtraCheckInData.KeyCards.KeyCard, vErrorMessage);
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	// Error message
	vGroupStatusXDTOObj = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
	If Not IsBlankString(vErrorMessage) Then
		vGroupStatusXDTOObj.ErrorDescription = vErrorMessage;
	Else
		// Return group description
		vGroupStatusXDTOObj = cmGetExternalGroupReservationStatus(pGuestGroupCode, pHotelCode, pExternalSystemCode, pLanguageCode, "XDTO", pLogin);
	EndIf;
	Return vGroupStatusXDTOObj;
EndFunction // cmCheckInGroupReservation

// -----------------------------------------------------------------------------
// Description: Checks-out guest group reservations checking user identity according to the 
//              user e-mail or phone number or reservation UUID e.t.c.
// Parameters: E-Mail, Phone, Login, Group code, Hotel code, External system code, Language code
// Return value: Error description if something went wrong or empty string if OK
// -----------------------------------------------------------------------------
Function cmCheckOutGroupReservation(pEMail, pPhone, pLogin, pGuestGroupCode, pReservationCode, pExtraCheckOutData, pHotelCode, pExternalSystemCode, pLanguageCode = "RU") Export
	vErrorMessage = "";
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get guest group by extrenal code
	vGroupRef = Undefined;
	If StrLen(pGuestGroupCode) = 36 Then
		vGroupRef = Catalogs.GuestGroups.GetRef(New UUID(TrimAll(pGuestGroupCode)));
	Else
		vGroupRef = cmGetGuestGroupByExternalCode(vHotel, pGuestGroupCode, "", "", False);
	EndIf;
	If Not ValueIsFilled(vGroupRef) And pExtraCheckOutData = Undefined Then
		vErrorMessage = cmNStr("en='Failed to find guest group by code '; ru='Не удалось найти группу по коду '; de='Fehler bei der Suche nach Gastgruppe nach Code '", vLanguage) + pGuestGroupCode;
	Else
		// Check if authentication data are present in the parameters
		If IsBlankString(pEMail) And IsBlankString(pPhone) And IsBlankString(pLogin) And StrLen(pGuestGroupCode) <> 36 And pExtraCheckOutData = Undefined Then
			vErrorMessage = cmNStr("en='Not authenticated!';ru='Пользователь не авторизован!';de='Der Nutzer ist nicht autorisiert!'", vLanguage);
		Else
			vIsAuthorized = False;
			vGuestEMail = "";
			vGuestPhone = "";
			If ValueIsFilled(vGroupRef.ClientDoc) Then
				vClientDoc = vGroupRef.ClientDoc;
				If Not IsBlankString(vClientDoc.EMail) Then
					vGuestEMail = TrimAll(vClientDoc.EMail);
				EndIf;
				If Not IsBlankString(vClientDoc.Phone) Then
					vGuestPhone = TrimAll(vClientDoc.Phone);
				EndIf;
			EndIf;
			If ValueIsFilled(vGroupRef.Client) Then
				vClient = vGroupRef.Client;
				If Not IsBlankString(vClient.EMail) And IsBlankString(vGuestEMail) Then
					vGuestEMail = TrimAll(vClient.EMail);
				EndIf;
				If Not IsBlankString(vClient.Phone) And IsBlankString(vGuestPhone) Then
					vGuestPhone = TrimAll(vClient.Phone);
				EndIf;
			EndIf;
			If Not IsBlankString(pEMail) Then
				If cmCheckEMailIsValid(TrimAll(pEMail)) And Find(Lower(vGuestEMail), Lower(TrimAll(pEMail))) > 0 Then
					vIsAuthorized = True;
				EndIf;
			EndIf;
			If Not IsBlankString(pPhone) Then
				If StrLen(TrimAll(pPhone)) >= 7 And Find(SMS.GetValidPhoneNumber(TrimAll(vGuestPhone)), SMS.GetValidPhoneNumber(TrimAll(pPhone))) > 0 Then
					vIsAuthorized = True;
				EndIf;
			EndIf;
			If Not IsBlankString(pLogin) Then
				vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
				If vCustomerStruct <> Undefined Then
					If ValueIsFilled(vCustomerStruct.Customer) Then
						If Find(Lower(vGroupRef.Customer), Lower(TrimAll(vCustomerStruct.Customer.Description))) > 0 Then
							vIsAuthorized = True;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
			If StrLen(pGuestGroupCode) = 36 Then
				vIsAuthorized = True;
			EndIf;
			vAccommodationsToCheckOutList = New ValueList();
			If pExtraCheckOutData <> Undefined And pExtraCheckOutData.KeyCards.KeyCard.Count() > 0 Then
				For Each vKeyCardXDTO In pExtraCheckOutData.KeyCards.KeyCard Do
					vKeyCardID = TrimAll(vKeyCardXDTO.KeyCardId);
					If Not IsBlankString(vKeyCardID) Then
						vIDCard = cmGetClientIdentificationCardById(vKeyCardID);
						If ValueIsFilled(vIDCard) And ValueIsFilled(vIDCard.ParentDoc) And TypeOf(vIDCard.ParentDoc) = Type("DocumentRef.Accommodation") Then
							vAccommodationsToCheckOutList.Add(vIDCard.ParentDoc);
						Else
							vErrorMessage = cmNStr("en='Guest not found for card '; ru='Не удалось найти гостя по карте '; de='Keine in-house Gaste für Kard gefunden: '", vLanguage) + vKeyCardID;
							Return vErrorMessage;
						EndIf;
					EndIf;
				EndDo;
			Else
				If Not vIsAuthorized Then
					vErrorMessage = cmNStr("en='Not authenticated!';ru='Пользователь не авторизован!';de='Der Nutzer ist nicht autorisiert!'", vLanguage);
				Else
					vGroupObj = vGroupRef.GetObject();
					vAccommodations = vGroupObj.pmGetAccommodations(True);
					For Each vAccommodationsRow In vAccommodations Do
						If Not IsBlankString(pReservationCode) Then
							If pReservationCode <> TrimAll(vAccommodationsRow.Number) And pReservationCode <> TrimAll(vAccommodationsRow.ExternalCode) Then
								Continue;
							EndIf;
						EndIf;
						vAccommodationsToCheckOutList.Add(vAccommodationsRow.Accommodation);
					EndDo;
				EndIf;
			EndIf;
			If vAccommodationsToCheckOutList.Count() = 0 Then
				vErrorMessage = cmNStr("en='No in-house guests found for group/code '; ru='Не удалось найти проживающих гостей по группе/коду '; de='Keine in-house Gaste für Gruppe/Code gefunden: '", vLanguage) + pGuestGroupCode + "/" + pReservationCode;
			Else
				vErrorMessage = cmCheckOutGuests(vAccommodationsToCheckOutList);
			EndIf;
		EndIf;
	EndIf;
	// Error message
	Return vErrorMessage;
EndFunction // cmCheckOutGroupReservation

// -----------------------------------------------------------------------------
// This function is used to check-in reservations in the input reservations list. 
// It also registers key id's for each checked-in guest
// -----------------------------------------------------------------------------
Function cmCheckInGuests(pGuestsToCheckIn, pKeys, rErrorDescription) Export
	rErrorDescription = "";
	vAccList = New ValueList;
	vRoom = Undefined;
	
	// Write
	BeginTransaction(DataLockControlMode.Managed);
	Try
		For Each vGuestsToCheckItem In pGuestsToCheckIn Do
			vReservationRef = vGuestsToCheckItem.Value;
			If Not ValueIsFilled(vReservationRef.Room) Or ValueIsFilled(vReservationRef.Room) And vReservationRef.Room.RoomStatus <> vReservationRef.Hotel.VacantRoomStatus Then
				If Not ValueIsFilled(vRoom) Then
					vRoom = cmGetDefaultRoom(vReservationRef.NumberOfBeds, vReservationRef.Hotel, vReservationRef.Company, vReservationRef.RoomQuota, vReservationRef.RoomTYpe, vReservationRef.CheckInDate, vReservationRef.CheckOutDate, vReservationRef.Guest);
				EndIf;
			Else
				vRoom = vReservationRef.Room;
			EndIf;
			If ValueIsFilled(vRoom) Then
				vResObj = vReservationRef.GetObject();
				vResObj.Room = vRoom;
				vResObj.Write(DocumentWriteMode.Write);
			EndIf;
			vAccObject = Documents.Accommodation.CreateDocument();
			vAccObject.Fill(vReservationRef);
			vAccObject.Write(DocumentWriteMode.Posting);
			vAccList.Add(vAccObject.Ref);
		EndDo;
		
		// Register keys
		If pKeys <> Undefined And vAccList.Count() > 0 Then
			vCardIndex = 0;
			For Each vKeyKardRow In pKeys Do
				vParentDoc = Undefined;
				If vCardIndex < vAccList.Count() Then
					vParentDoc = vAccList.Get(vCardIndex).Value;
				Else
					vParentDoc = vAccList.Get(0).Value;
				EndIf;
				vFolio = Undefined;
				If vParentDoc.ChargingRules.Count() > 0 Then
					vFolio = vParentDoc.ChargingRules.Get(vParentDoc.ChargingRules.Count() - 1).ChargingFolio;
					vIdentificationCard = cmGetClientIdentificationCard(vKeyKardRow.KeyCardId, cmGetClientIdentificationCardById(vKeyKardRow.KeyCardId), vParentDoc, vFolio, vParentDoc.Guest, vParentDoc.Room, vParentDoc.CheckInDate, vParentDoc.CheckOutDate, True);
				EndIf;
				vCardIndex = vCardIndex + 1;
			EndDo;
		EndIf;
		
		// Commit transactions
		CommitTransaction();
	Except
		rErrorDescription = cmGetRootErrorDescription(ErrorInfo());
		// Rollback any transaction if active
		If TransactionActive() Then
			RollbackTransaction();
		EndIf;
		// Log and show error information
		WriteLogEvent(NStr("en='Document.Posting';ru='Документ.Проведение';de='Document.Posting'"), EventLogLevel.Warning, vAccObject.Metadata(), vAccObject.Ref, rErrorDescription);
	EndTry;
	
	Return vAccList;
EndFunction // cmCheckInGuests

// -----------------------------------------------------------------------------
// This function is used to check-in reservations in the input reservations list. 
// It also registers key id's for each checked-in guest
// -----------------------------------------------------------------------------
Function cmCheckOutGuests(pGuestsToCheckOut) Export
	vErrorDescription = "";
	
	// Write
	BeginTransaction(DataLockControlMode.Managed);
	Try
		For Each vGuestsToCheckOutItem In pGuestsToCheckOut Do
			vAccommodationRef = vGuestsToCheckOutItem.Value;
			If ValueIsFilled(vAccommodationRef) And vAccommodationRef.Posted And ValueIsFilled(vAccommodationRef.AccommodationStatus) And vAccommodationRef.AccommodationStatus.IsInHouse Then
				vAccObj = vAccommodationRef.GetObject();
				vAccObj.pmCheckOut(CurrentSessionDate(), , vAccObj.IsForFolioSplit);
				vAccObj.Write(DocumentWriteMode.Posting);
				vAccObj.pmWriteToAccommodationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			EndIf;
		EndDo;
		
		// Commit transactions
		CommitTransaction();
	Except
		vErrorDescription = cmGetRootErrorDescription(ErrorInfo());
		// Rollback any transaction if active
		If TransactionActive() Then
			RollbackTransaction();
		EndIf;
		// Log and show error information
		WriteLogEvent(NStr("en='Document.Posting';ru='Документ.Проведение';de='Document.Posting'"), EventLogLevel.Warning, vAccObj.Metadata(), vAccommodationRef, vErrorDescription);
	EndTry;
	Return vErrorDescription;
EndFunction // cmCheckInGuests

// -----------------------------------------------------------------------------
// This function is used to get main cancel fee attributes: amount and date
// -----------------------------------------------------------------------------
Procedure cmGetCancelFeeAttributes(pGuestGroup, pAmount, pFirstDayAmount, rCancelFeeDate, rCancelFeeAmount) Export
	rCancelFeeDate = pGuestGroup.CheckInDate;
	rCancelFeeAmount = 0; 
	vBasePercent = 100;
	vFeeTerms = Undefined;
	If ValueIsFilled(pGuestGroup.ClientDoc) And TypeOf(pGuestGroup.ClientDoc) = Type("DocumentRef.Reservation") And ValueIsFilled(pGuestGroup.ClientDoc.FeeTerms) Then
		vFeeTerms = pGuestGroup.ClientDoc.FeeTerms;		
	ElsIf ValueIsFilled(pGuestGroup.ClientDoc) And TypeOf(pGuestGroup.ClientDoc) = Type("DocumentRef.Reservation") And ValueIsFilled(pGuestGroup.ClientDoc.RoomRate) And ValueIsFilled(pGuestGroup.ClientDoc.RoomRate.FeeTerms) Then
		vFeeTerms = pGuestGroup.ClientDoc.RoomRate.FeeTerms;
	ElsIf ValueIsFilled(pGuestGroup.Contract) And ValueIsFilled(pGuestGroup.Contract.FeeTerms) Then
		vFeeTerms = pGuestGroup.Contract.FeeTerms;
	ElsIf ValueIsFilled(pGuestGroup.Customer) And ValueIsFilled(pGuestGroup.Customer.FeeTerms) Then
		vFeeTerms = pGuestGroup.Contract.FeeTerms;
	EndIf;
	If ValueIsFilled(vFeeTerms) And ValueIsFilled(pGuestGroup.CheckInDate) Then
		vDays = (pGuestGroup.CheckInDate - CurrentSessionDate()) / (tcCommonFunctionOnClientServer.cmOneDay());
		If vFeeTerms.LateAnnulationPeriod > 0 And vFeeTerms.LateAnnulationPeriod1 > 0 And vFeeTerms.LateAnnulationPeriod <= vFeeTerms.LateAnnulationPeriod1 Then
			If vDays < vFeeTerms.LateAnnulationPeriod Then
				rCancelFeeDate = pGuestGroup.CheckInDate;
				If vFeeTerms.LateAnnulationChargeWholePeriod Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				EndIf;
			ElsIf vDays < vFeeTerms.LateAnnulationPeriod1 Then
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod * tcCommonFunctionOnClientServer.cmOneDay());
				If vFeeTerms.LateAnnulationChargeWholePeriod1 Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				EndIf;
			Else
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod1 * tcCommonFunctionOnClientServer.cmOneDay());
				rCancelFeeAmount = 0;
			EndIf;
		ElsIf vFeeTerms.LateAnnulationPeriod > 0 And vFeeTerms.LateAnnulationPeriod1 > 0 And vFeeTerms.LateAnnulationPeriod > vFeeTerms.LateAnnulationPeriod1 Then
			If vDays < vFeeTerms.LateAnnulationPeriod1 Then
				rCancelFeeDate = pGuestGroup.CheckInDate;
				If vFeeTerms.LateAnnulationChargeWholePeriod1 Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				EndIf;
			ElsIf vDays < vFeeTerms.LateAnnulationPeriod Then
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod1 * tcCommonFunctionOnClientServer.cmOneDay());
				If vFeeTerms.LateAnnulationChargeWholePeriod Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				EndIf;
			Else
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod * tcCommonFunctionOnClientServer.cmOneDay());
				rCancelFeeAmount = 0;
			EndIf;
		ElsIf vFeeTerms.LateAnnulationPeriod > 0 Then
			If vDays < vFeeTerms.LateAnnulationPeriod Then
				rCancelFeeDate = pGuestGroup.CheckInDate;
				If vFeeTerms.LateAnnulationChargeWholePeriod Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent / vBasePercent + vFeeTerms.LateAnnulationFeeSum;
				EndIf;
			Else
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod * tcCommonFunctionOnClientServer.cmOneDay());
				rCancelFeeAmount = 0;
			EndIf;
		ElsIf vFeeTerms.LateAnnulationPeriod1 > 0 Then
			If vDays < vFeeTerms.LateAnnulationPeriod1 Then
				rCancelFeeDate = pGuestGroup.CheckInDate;
				If vFeeTerms.LateAnnulationChargeWholePeriod1 Then
					rCancelFeeAmount = pAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				Else
					rCancelFeeAmount = pFirstDayAmount * vFeeTerms.LateAnnulationFeePercent1 / vBasePercent + vFeeTerms.LateAnnulationFeeSum1;
				EndIf;
			Else
				rCancelFeeDate = pGuestGroup.CheckInDate - (vFeeTerms.LateAnnulationPeriod1 * tcCommonFunctionOnClientServer.cmOneDay());
				rCancelFeeAmount = 0;
			EndIf;
		EndIf;
	EndIf;
	rCancelFeeAmount = Round(rCancelFeeAmount, 2);
EndProcedure // cmGetCancelFeeAttributes

// -----------------------------------------------------------------------------
Function cmArrayToString(pArray) Export
	vStr = "";
	If TypeOf(pArray) = Type("Array") Then
		For Each vItem In pArray Do
			vStr = vStr + ?(IsBlankString(vStr), "", ", ") + TrimAll(vItem);
		EndDo;
	EndIf;
	Return vStr;
EndFunction // cmArrayToString

// -----------------------------------------------------------------------------
// Description: This API is used to retrieve daily vacant room balances for the 
//              given room quota or room inventory in total and join this data with
//              daily room rate prices for the given number of adults and kids.
// Parameters: Hotel, Room type, Customer, Contract, Agent, Room quota, Period from,
//             Period to, Room rate code, Client type code, Number of adults, Number of kids, Kid ages array, 
//             External system code, Language code
// Return value: XDO AvailableRoomsWithDailyPrices object with vacant room 
//               balances grouped by hotel, room type and day joined with prices for the 
//               room rate 
// -----------------------------------------------------------------------------
Function cmGetAvailableRoomsWithDailyPrices(pHotelCode, pRoomTypeCode, pRoomQuotaCode, pPeriodFrom, pPeriodTo, pClientTypeCode = "", pRoomRateCodesArray, 
									        pNumberOfAdults, pNumberOfKids = 0, pKidAgesArray = Undefined, pClientIsAuthorized = False,  
								            pExternalSystemCode, pLanguageCode = "RU", pExtraParameters = Undefined) Export
	WriteLogEvent(NStr("en='Get available rooms with daily prices';ru='Получить свободные номера с ценами по дням';de='Verfügbare Zimmer mit Tagespreisen'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты номеров: ';de='Zimmerquotencode: '") + pRoomQuotaCode + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo + Chars.LF +  
	              NStr("en='Room rate codes: ';ru='Коды тарифов: ';de='Tarifcoden: '") + cmArrayToString(pRoomRateCodesArray) + Chars.LF + 
	              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
	              NStr("en='Number of adults: ';ru='Кол-во взрослых: ';de='Anzahl der Erwachsenen: '") + pNumberOfAdults + Chars.LF + 
	              NStr("en='Number of kids: ';ru='Кол-во детей: ';de='Anzahl der Kinder: '") + pNumberOfKids + Chars.LF + 
				  NStr("en='Kids age: ';ru='Возраст детей: ';de='Alter der Kinder: '") + cmArrayToString(pKidAgesArray) + Chars.LF + 
				  NStr("en='Client is authorized: ';ru='Клиент авторизован: ';de='Der Kunde ist autorisiert: '") + pClientIsAuthorized);
	// Return object			  
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomsWithDailyPrices"));
	
	vExtraParameters = New Structure("ForSiteminder, AccTemplateCode, IsCustomer, ProfileCode, Duration");
	If pExtraParameters <> Undefined Then	
		Try
			If pExtraParameters.ForSiteminder <> Undefined Then
				vExtraParameters.ForSiteminder = pExtraParameters.ForSiteminder; 
			EndIf;
		Except
		EndTry;
		Try
			If pExtraParameters.AccTemplateCode <> Undefined Then
				vExtraParameters.AccTemplateCode = pExtraParameters.AccTemplateCode; 
			EndIf;
		Except
		EndTry;	
		Try
			If pExtraParameters.IsCustomer <> Undefined Then
				vExtraParameters.IsCustomer = pExtraParameters.IsCustomer; 
			EndIf;
		Except
		EndTry;	
		Try
			If pExtraParameters.ProfileCode <> Undefined Then
				vExtraParameters.ProfileCode = pExtraParameters.ProfileCode; 
			EndIf;
		Except
		EndTry;	
		Try
			If pExtraParameters.Duration <> Undefined Then
				vExtraParameters.Duration = pExtraParameters.Duration; 
			EndIf;
		Except
		EndTry;
	EndIf;
		
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	If Not ValueIsFilled(vHotel) Then
		Raise NStr("en='Hotel not found by code '; ru='Гостиница не найдена по коду '; de='Hotel nicht nach Code gefunden '") + pHotelCode;
	EndIf;
	
	If vExtraParameters <> Undefined and vExtraParameters.ForSiteminder = True Then
		vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Siteminder_RoomMapping_RT", pRoomTypeCode);
	Else
		vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode, True, , True);
		If vRoomType = Undefined Then
			Try
				vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "VirtualRoomTypes", pRoomTypeCode);
			Except
			EndTry;
		EndIf;
	EndIf;
	If vRoomType = Undefined Then
		vRoomType = Catalogs.RoomTypes.EmptyRef();
	EndIf;
	vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode);
	If vRoomQuota = Undefined Then
		vRoomQuota = Catalogs.RoomQuotas.EmptyRef();
	EndIf;
	
	vClient 		= Undefined;
	vCustomer 		= Undefined;
	vDiscountType 	= Undefined;
	If vExtraParameters.IsCustomer = True and ValueIsFilled(vExtraParameters.ProfileCode) Then
		vClient = Catalogs.Customers.FindByCode(vExtraParameters.ProfileCode);
		If ValueIsFilled(vClient) Then
			vDiscountType = vClient.DiscountType;
		EndIf;
	ElsIf vExtraParameters.IsCustomer = False and ValueIsFilled(vExtraParameters.ProfileCode) Then
		vCustomer = Catalogs.Clients.FindByCode(vExtraParameters.ProfileCode);
		If ValueIsFilled(vCustomer) Then
			vDiscountType = vCustomer.DiscountType;
		EndIf;
	EndIf;
	
	vClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode);
	If vClientType = Undefined Then	
		If ValueIsFilled(vClient) Then
			vClientType = vClient.ClientType;
		ElsIf ValueIsFilled(vCustomer) Then
			vClientType = vCustomer.ClientType;	
		Else
			vClientType = Catalogs.ClientTypes.EmptyRef();
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(vDiscountType) and ValueIsFilled(vClientType) Then
		vDiscountType = vClientType.DiscountType;
	EndIf;
	
	vLanguage = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Languages", pLanguageCode);
	If vLanguage = Undefined Then
		vLanguage = Catalogs.Languages.RU;
	EndIf;
	
	// Codes cache
	vHotelsCache = New ValueTable();
	vHotelsCache.Columns.Add("Hotel", cmGetCatalogTypeDescription("Hotels"));
	vHotelsCache.Columns.Add("HotelExt");
	vHotelsCache.Columns.Add("HotelCode");
	vHotelsCache.Columns.Add("HotelDescription");
	
	vRoomTypesCache = New ValueTable();
	vRoomTypesCache.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
	vRoomTypesCache.Columns.Add("RoomTypeExt");
	vRoomTypesCache.Columns.Add("RoomTypeCode");
	vRoomTypesCache.Columns.Add("RoomTypeDescription");
	
	vRoomRatesCache = New ValueTable();
	vRoomRatesCache.Columns.Add("RoomRate", cmGetCatalogTypeDescription("RoomRates"));
	vRoomRatesCache.Columns.Add("RoomRateExt");
	vRoomRatesCache.Columns.Add("RoomRateCode");
	vRoomRatesCache.Columns.Add("RoomRateDescription");
	
	vCurrenciesCache = New ValueTable();
	vCurrenciesCache.Columns.Add("Currency", cmGetCatalogTypeDescription("Currencies"));
	vCurrenciesCache.Columns.Add("CurrencyExt");
	vCurrenciesCache.Columns.Add("CurrencyCode");
	vCurrenciesCache.Columns.Add("CurrencyDescription");
	
	// Build structure with children ages
	vChildrenAgesStruct = Undefined;
	If ValueIsFilled(vRoomQuota) And ValueIsFilled(vRoomQuota.Contract) Then
		vAllotmentContract = vRoomQuota.Contract;
		If vAllotmentContract.TeenagersMaxAge <> 0 Or vAllotmentContract.ChildrenMaxAge <> 0 Or vAllotmentContract.InfantsMaxAge <> 0 Then
			vChildrenAgesStruct = vAllotmentContract;
		EndIf;
	EndIf;
	
	// Call API to get value table with balances
	vBalances = cmGetRoomQuotaBalances(vHotel, vRoomType, Undefined, Undefined, Undefined, vRoomQuota, BegOfDay(pPeriodFrom) - (12*3600), BegOfDay(pPeriodTo) + (36*3600));
	
	// Check for stop internet sales
	For Each vRow In vBalances Do
		If vRow.Period = Null Then                                                           
			Continue;
		EndIf;
		vCurRoomType = vRow.RoomType;
		If vCurRoomType.StopSale Then
			vRemarks = "";
			If cmIsStopInternetSalePeriod(vCurRoomType, EndOfDay(vRow.Period), EndOfDay(vRow.Period), vRemarks) Then
				vRow.RoomsVacant = 0;
				vRow.BedsVacant = 0;
				vRow.RoomsRemains = 0;
				vRow.BedsRemains = 0;
			EndIf;
		EndIf;
	EndDo;
	
	// Get room rate prices
	vRoomRatesList = New ValueList();
	If TypeOf(pRoomRateCodesArray) = Type("Array") And pRoomRateCodesArray.Count() > 0 Then
		For Each vRoomRateCode In pRoomRateCodesArray Do
			If vExtraParameters <> Undefined and vExtraParameters.ForSiteminder = True Then
				vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Siteminder_RoomMapping_RR", vRoomRateCode);
			Else
				vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", vRoomRateCode);
			EndIf;
			If ValueIsFilled(vRoomRate) Then
				If vRoomRatesList.FindByValue(vRoomRate) = Undefined Then
					vRoomRatesList.Add(vRoomRate);
				EndIf;
			Else
				Raise NStr("en='Room rate was not found by code '; ru='Тариф не найден по коду '; de='Tarif wird nicht nach Code gefunden '") + vRoomRateCode;
			EndIf;
		EndDo;
	Else
		If Upper(TrimAll(pExternalSystemCode)) = "HOTELBI" Or Upper(TrimAll(pExternalSystemCode)) = "BITRIX24" Then
			vRoomRatesList = cmGetHotelBIRoomRates(vHotel, pPeriodFrom, pPeriodTo, True);
		Else
			vRoomRatesList = cmGetOnlineRoomRates(vHotel, pPeriodFrom, pPeriodTo, pClientIsAuthorized, True);
		EndIf;
	EndIf;
	
	If vRoomRatesList.Count() > 0 Then
		vFirstRoomRate = vRoomRatesList.Get(0).Value;
		vReferenceHour = vFirstRoomRate.ReferenceHour - BegOfDay(vFirstRoomRate.ReferenceHour);
		If vReferenceHour = 0 Then
			vReferenceHour = 12*3600;
		EndIf;
		
		If ValueIsFilled(vHotel) And vHotel.UseRoomRateDailyPrices And cmRoomRatePricesCacheIsFilled(vHotel, vRoomRatesList, vClientType, pPeriodFrom, pPeriodTo) Then
			// Get accommodation templates suitable for each room rate  room type
			vAccTemplatesList = New ValueList();
			If vExtraParameters <> Undefined and ValueIsFilled(vExtraParameters.AccTemplateCode) Then
				If vExtraParameters.ForSiteminder = True Then
					vAccTemplate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Siteminder_RoomMapping_AT", vExtraParameters.AccTemplateCode);
				Else			
					vAccTemplate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "AccommodationTemplates", vExtraParameters.AccTemplateCode);
					If Not ValueIsFilled(vAccTemplate) Then
						Try
							vAccTemplate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "VirtualAccommodationTemplates", vExtraParameters.AccTemplateCode);
						Except
						EndTry;
					EndIf;
				EndIf;
				If ValueIsFilled(vAccTemplate) Then
					vAccTemplatesList.Add(vAccTemplate);
				EndIf;
			Else
				vAccTemplates = cmGetAccommodationTemplateDetailsByGuestsQuantity(pNumberOfAdults, pNumberOfKids, pKidAgesArray, vHotel, True, vChildrenAgesStruct);
				vAccTemplatesList.LoadValues(vAccTemplates.UnloadColumn("AccommodationTemplate"));
			EndIf;
			
			// Create 2 different lists of rates. One list with normal rates and another one with rates that use price tags
			vNormalRatesList = New ValueList();
			vPriceTagRatesList = New ValueList();
			For Each vRoomRatesListItem In vRoomRatesList Do
				vCurRoomRate = vRoomRatesListItem.Value;
				If ValueIsFilled(vCurRoomRate.PriceTagType) Then
					vPriceTagRatesList.Add(vCurRoomRate);
				Else
					vNormalRatesList.Add(vCurRoomRate);
				EndIf;
			EndDo;
			
			// Get prices
			vPeriodPrices = New ValueTable();
			If vNormalRatesList.Count() > 0 Then 
				vPeriodPrices = cmGetCachedPricesByDays(vHotel, vClientType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), Catalogs.PriceTags.EmptyRef(), vNormalRatesList, vAccTemplatesList, ?(Upper(TrimAll(pExternalSystemCode)) = "HOTELBI" 
														Or Upper(TrimAll(pExternalSystemCode)) = "BITRIX24", True, False), True, vDiscountType, pExternalSystemCode);
			EndIf;
			vPeriodPricesByPriceTags = New ValueTable();
			If vPriceTagRatesList.Count() > 0 Then
				vDurationForPriceTags = 1;
				If vExtraParameters <> Undefined Then
					If TypeOf(vExtraParameters.Duration) = Type("Number") Then
						If vExtraParameters.Duration > 0 Then
							vDurationForPriceTags = vExtraParameters.Duration;
						EndIf;
					EndIf;
				EndIf;
				vPeriodPricesByPriceTags = cmGetCachedPricesForPriceTagsByDays(vHotel, vClientType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), vPriceTagRatesList, vAccTemplatesList, ?(Upper(TrimAll(pExternalSystemCode)) = "HOTELBI" 
													   Or Upper(TrimAll(pExternalSystemCode)) = "BITRIX24", True, False), True, vDiscountType, pExternalSystemCode, vDurationForPriceTags);
			EndIf;
					
			// Return structure by room type
			vRoomTypeXDTO = Undefined;
			
			// Do for each date
			vCurDate = BegOfDay(pPeriodFrom);
			While vCurDate < BegOfDay(pPeriodTo) Do
				vDateTimeFrom = cm1SecondShift(vCurDate + vReferenceHour);
				vDateTimeTo = cm0SecondShift(vCurDate + vReferenceHour + 24*3600);
				
				// Do for each room type
				vRoomTypes = vBalances.FindRows(New Structure("Period", vCurDate));
				For Each vRoomTypesRow In vRoomTypes Do
					vCurRoomType = vRoomTypesRow.RoomType;
					
					vRoomTypeXDTO = Undefined;
					
					// Check room type filter
					If ValueIsFilled(vRoomType) Then
						If vRoomType.IsFolder Then
							If Not vCurRoomType.BelongsToItem(vRoomType) Then
								Continue;
							EndIf;
						Else
							If vCurRoomType <> vRoomType Then
								Continue;
							EndIf;
						EndIf;
					EndIf;
					
					vRoomTypeXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomTypeDailyAvailabilityAndPrices"));
					
					vHotelsCacheRow = vHotelsCache.Find(vHotel, "Hotel");
					If vHotelsCacheRow <> Undefined Then
						vRoomTypeXDTO.Hotel = vHotelsCacheRow.HotelExt;
						vRoomTypeXDTO.HotelCode = vHotelsCacheRow.HotelCode;
					Else
						vRoomTypeXDTO.Hotel = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Hotels", vHotel);
						vRoomTypeXDTO.HotelCode = TrimR(vHotel.Code);
						
						vHotelsCacheRow = vHotelsCache.Add();
						vHotelsCacheRow.Hotel = vHotel;
						vHotelsCacheRow.HotelExt = vRoomTypeXDTO.Hotel;
						vHotelsCacheRow.HotelCode = vRoomTypeXDTO.HotelCode;
					EndIf;
					
					vRoomTypesCacheRow = vRoomTypesCache.Find(vCurRoomType, "RoomType");
					If vRoomTypesCacheRow <> Undefined Then
						vRoomTypeXDTO.RoomType = vRoomTypesCacheRow.RoomTypeExt;
						vRoomTypeXDTO.RoomTypeCode = vRoomTypesCacheRow.RoomTypeCode;
						vRoomTypeXDTO.RoomTypeDescription = vRoomTypesCacheRow.RoomTypeDescription;
					Else
						vRoomTypeXDTO.RoomType = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "RoomTypes", vCurRoomType);
						If Not ValueIsFilled(vRoomTypeXDTO.RoomType) Then
							Try
								vRoomTypeXDTO.RoomType = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "VirtualRoomTypes", vCurRoomType);
							Except
							EndTry;
						EndIf;
						vRoomTypeXDTO.RoomTypeCode = TrimR(vCurRoomType.Code);
						vRoomTypeXDTO.RoomTypeDescription = vCurRoomType.GetObject().pmGetRoomTypeDescription(vLanguage);
						
						vRoomTypesCacheRow = vRoomTypesCache.Add();
						vRoomTypesCacheRow.RoomType = vCurRoomType;
						vRoomTypesCacheRow.RoomTypeExt = vRoomTypeXDTO.RoomType;
						vRoomTypesCacheRow.RoomTypeCode = vRoomTypeXDTO.RoomTypeCode;
						vRoomTypesCacheRow.RoomTypeDescription = vRoomTypeXDTO.RoomTypeDescription;
					EndIf;
					
					vRoomTypeXDTO.Period = vCurDate;
					
					vRoomTypeXDTO.RoomsVacant = vRoomTypesRow.RoomsVacant;
					vRoomTypeXDTO.BedsVacant = vRoomTypesRow.BedsVacant;
					vRoomTypeXDTO.RoomsInQuota = vRoomTypesRow.RoomsInQuota;
					vRoomTypeXDTO.BedsInQuota = vRoomTypesRow.BedsInQuota;
					vRoomTypeXDTO.RoomsChargedInQuota = vRoomTypesRow.RoomsChargedInQuota;
					vRoomTypeXDTO.BedsChargedInQuota = vRoomTypesRow.BedsChargedInQuota;
					vRoomTypeXDTO.RoomsReserved = vRoomTypesRow.RoomsReserved;
					vRoomTypeXDTO.BedsReserved = vRoomTypesRow.BedsReserved;
					vRoomTypeXDTO.InHouseRooms = vRoomTypesRow.InHouseRooms;
					vRoomTypeXDTO.InHouseBeds = vRoomTypesRow.InHouseBeds;
					vRoomTypeXDTO.RoomsRemains = vRoomTypesRow.RoomsRemains;
					vRoomTypeXDTO.BedsRemains = vRoomTypesRow.BedsRemains;
					
					vRoomTypeDailyPricesXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomTypeDailyPrices"));
					
					vRoomRateXDTO = Undefined;
					
					// Get prices for each room rate
					For Each vRoomRateItem In vRoomRatesList Do
						vCurRoomRate = vRoomRateItem.Value;
						
						// Check room rate is valid period
						If ValueIsFilled(vCurRoomRate.DateValidFrom) Or ValueIsFilled(vCurRoomRate.DateValidTo) Then
							If ValueIsFilled(vCurRoomRate.DateValidFrom) And vDateTimeFrom < vCurRoomRate.DateValidFrom Then
								Continue;
							EndIf;
							If ValueIsFilled(vCurRoomRate.DateValidTo) And vDateTimeTo > EndOfDay(vCurRoomRate.DateValidTo) Then
								Continue;
							EndIf;
						EndIf;
						
						vRoomRateXDTO = Undefined;
						
						// Filter prices by price tags
						vRoomRateRoomTypePrices = Undefined;
						If ValueIsFilled(vCurRoomRate.PriceTagType) Then
							vRoomRateRoomTypePrices = vPeriodPricesByPriceTags.FindRows(New Structure("Period, RoomRate, RoomType", vCurDate, vCurRoomRate, vCurRoomType));
						Else
							vRoomRateRoomTypePrices = vPeriodPrices.FindRows(New Structure("Period, RoomRate, RoomType", vCurDate, vCurRoomRate, vCurRoomType));
						EndIf;
						
						// Define accommodation template valid for the current room type
						vCurAccommodationTemplate = Undefined;
						For Each vRoomRateRoomTypePricesRow In vRoomRateRoomTypePrices Do
							vCurAccommodationTemplate = vRoomRateRoomTypePricesRow.AccommodationTemplate;
							If ValueIsFilled(vCurAccommodationTemplate) Then
								If vCurAccommodationTemplate.RoomTypes.Count() <> 0 And vCurAccommodationTemplate.RoomTypes.Find(vCurRoomType, "RoomType") = Undefined Then
									If ValueIsFilled(vCurRoomType) And ValueIsFilled(vCurRoomType.RoomClass) And vCurAccommodationTemplate.RoomTypes.Find(vCurRoomType.RoomClass, "RoomClass") <> Undefined Then
										Break;
									Else
										vCurAccommodationTemplate = Undefined;
										Continue;
									EndIf;
								Else
									Break;
								EndIf;
							EndIf;
						EndDo;
						t = 0;
						While t < vRoomRateRoomTypePrices.Count() Do
							vRoomRateRoomTypePricesRow = vRoomRateRoomTypePrices.Get(t);
							If vRoomRateRoomTypePricesRow.AccommodationTemplate <> vCurAccommodationTemplate Then
								vRoomRateRoomTypePrices.Delete(t);
							Else
								t = t + 1;
							EndIf;
						EndDo;
						
						vRoomRateXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomRateDailyPriceRow"));
						
						vRoomRatesCacheRow = vRoomRatesCache.Find(vCurRoomRate, "RoomRate");
						If vRoomRatesCacheRow <> Undefined Then
							vRoomRateXDTO.RoomRate = vRoomRatesCacheRow.RoomRateExt;
							vRoomRateXDTO.RoomRateCode = vRoomRatesCacheRow.RoomRateCode;
							vRoomRateXDTO.RoomRateDescription = vRoomRatesCacheRow.RoomRateDescription;
						Else
							vRoomRateXDTO.RoomRate = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "RoomRates", vCurRoomRate);
							vRoomRateXDTO.RoomRateCode = TrimR(vCurRoomRate.Code);
							vRoomRateXDTO.RoomRateDescription = vCurRoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
						
							vRoomRatesCacheRow = vRoomRatesCache.Add();
							vRoomRatesCacheRow.RoomRate = vCurRoomRate;
							vRoomRatesCacheRow.RoomRateExt = vRoomRateXDTO.RoomRate;
							vRoomRatesCacheRow.RoomRateCode = vRoomRateXDTO.RoomRateCode;
							vRoomRatesCacheRow.RoomRateDescription = vRoomRateXDTO.RoomRateDescription;
						EndIf;
						
						// Fill XDTO object for each date
						If vRoomRateRoomTypePrices <> Undefined And vRoomRateRoomTypePrices.Count() > 0 Then
							vDayPrice = 0;
							vDayCurrency = Undefined;
							For Each vRoomRateRoomTypePricesRow In vRoomRateRoomTypePrices Do
								If Not ValueIsFilled(vDayCurrency) Then
									vDayCurrency = vRoomRateRoomTypePricesRow.Currency;
								EndIf;
								vDayPrice = vDayPrice + vRoomRateRoomTypePricesRow.Amount;
							EndDo; // By price rows
							If ValueIsFilled(vDayCurrency) Then
								vRoomRateXDTO.Price = vDayPrice;
								
								vCurrenciesCacheRow = vCurrenciesCache.Find(vDayCurrency, "Currency");
								If vCurrenciesCacheRow <> Undefined Then
									vRoomRateXDTO.Currency = vCurrenciesCacheRow.CurrencyExt;
									vRoomRateXDTO.CurrencyCode = vCurrenciesCacheRow.CurrencyCode;
									vRoomRateXDTO.CurrencyDescription = vCurrenciesCacheRow.CurrencyDescription;
								Else
									vRoomRateXDTO.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vDayCurrency);
									If IsBlankString(vRoomRateXDTO.Currency) Then
										vRoomRateXDTO.Currency = TrimAll(vDayCurrency);
									EndIf;
									vRoomRateXDTO.CurrencyCode = TrimAll(vDayCurrency.Code);
									vRoomRateXDTO.CurrencyDescription = TrimAll(vDayCurrency.Description);
									
									vCurrenciesCacheRow = vCurrenciesCache.Add();
									vCurrenciesCacheRow.Currency = vDayCurrency;
									vCurrenciesCacheRow.CurrencyExt = vRoomRateXDTO.Currency;
									vCurrenciesCacheRow.CurrencyCode = vRoomRateXDTO.CurrencyCode;
									vCurrenciesCacheRow.CurrencyDescription = vRoomRateXDTO.CurrencyDescription;
								EndIf;
								vRoomRateXDTO.PricePresentation = cmFormatSum(vDayPrice, vDayCurrency);
							EndIf;
						EndIf;
						
						// Add room rate XDTO
						If vRoomRateXDTO <> Undefined Then
							vRoomTypeDailyPricesXDTO.RoomRateDailyPriceRow.Add(vRoomRateXDTO);
						EndIf;
					EndDo; // By room rates
					
					If vRoomTypeDailyPricesXDTO <> Undefined And vRoomTypeDailyPricesXDTO.RoomRateDailyPriceRow <> Undefined And vRoomTypeDailyPricesXDTO.RoomRateDailyPriceRow.Count() > 0 Then
						vRoomTypeXDTO.RoomTypeDailyPrices = vRoomTypeDailyPricesXDTO;
						
						If vRoomTypeXDTO <> Undefined Then
							vRetXDTO.RoomTypeDailyAvailabilityAndPricesRow.Add(vRoomTypeXDTO);
						EndIf;
					EndIf;
				EndDo; // By room type
				
				vCurDate = vCurDate + (24*3600);
			EndDo; // By dates
		Else
			Raise NStr("en='Price cache is not filled for room rates: '; ru='Кэш цен не заполнен для тарифов: '; de='Der Preiscache ist nicht für der Tariffen belegt: '") + cmArrayToString(vRoomRatesList);
		EndIf;
	Else
		Raise NStr("en='Could not find on-line room rates!'; ru='On-line тарифы не определены!'; de='On-line Tarif ist nicht angegeben!'");
	EndIf;
	
	// Return XDTO
	Return vRetXDTO;
EndFunction // cmGetAvailableRoomsWithDailyPrices

// -----------------------------------------------------------------------------
Function cmRequestCode(pPhone, pExternalSystemCode, pHotelCode, pLanguageCode = "RU") Export
	WriteLogEvent(NStr("en='Request code';ru='Запросить код';de='Um Code anzufordern'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF +
				  NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF +
	              NStr("en='Phone number: ';ru='Номер телефона: ';de='Telefonnummer: '") + pPhone);

	vRetXDTO 			= XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "VerifyCode"));
	vErrorDescription 	= "";
	vCodeIsSent 		= False;
	Try
		vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
		If Not ValueIsFilled(vHotel) Then
			vRetXDTO.ErrorDescription = NStr("en='Hotel not found by code '; ru='Гостиница не найдена по коду '; de='Hotel nicht nach Code gefunden '") + pHotelCode;
			Return vRetXDTO;
		EndIf;

		vLanguage = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Languages", pLanguageCode);
		If vLanguage = Undefined Then
			vLanguage = SessionParameters.CurrentLanguage;
		EndIf;
		
		If Not IsBlankString(pPhone) Then
			vPhone = SMS.GetValidPhoneNumber(pPhone);
		Else
			vErrorDescription = cmNStr("en='Phone number to send SMS with verification code is empty!'; ru='Не указан номер телефона для отправки СМС с кодом подтверждения!'; de='Keine Telefonnummer für das Versenden von SMS mit Bestätigungscode!'",vLanguage);
		EndIf;
		
		// Generate unique verification code
		vVerificationCode = GenerateVerificationCode();
		
		// Send verification code by SMS
		vSMSTemplate = Catalogs.SMSTemplates.SendVerificationCodeMessage;
		vMessageText = SMS.GetSMSTextByLanguage(vSMSTemplate, vLanguage);
		If IsBlankString(vMessageText) Then
			vMessageText = cmNStr("en='Your verification code is '; ru='Код подтверждения '; de='Ihr Bestätigungscode ist '", vLanguage) + "&VerificationCode";
		EndIf;
		vMessageText = StrReplace(vMessageText, "&VerificationCode", vVerificationCode);
		vMessageID = Undefined;
		
		SMS.SendMessage(vMessageText, vPhone, vSMSTemplate, TrimAll(vSMSTemplate.Sender), Undefined, , SessionParameters.CurrentUser, , vErrorDescription, vMessageID);
		
		If ValueIsFilled(vMessageID) Then
			// Save verification code to the database
			vRcdMgr 					= InformationRegisters.ClientVerificationCodes.CreateRecordManager();
			vRcdMgr.PromoCode 			= pExternalSystemCode;
			vRcdMgr.Phone 				= vPhone;
			vRcdMgr.VerificationCode 	= vVerificationCode;
			vRcdMgr.IsSent 				= True;
			vRcdMgr.DateSent 			= CurrentSessionDate();
			vRcdMgr.IsUsed 				= False;
			vRcdMgr.DateUsed 			= '00010101';
			vRcdMgr.Write(True);
			
			vCodeIsSent = True;
		Else
			vErrorDescription = cmNStr("en = 'The authorization system is temporarily not available. You can continue booking.'; ru = 'Система авторизации временно не работает. Можете продолжить бронирование.'; de = 'Das Autorisierungssystem ist vorübergehend nicht verfügbar. Sie können weiter buchen.'",vLanguage);
		EndIf;
	Except
		WriteLogEvent(NStr("en='Request code.Error';ru='Запросить код.Ошибка';de='Um Code anzufordern.Feller'"), EventLogLevel.Error, , , ErrorDescription());
		vErrorDescription = cmNStr("en = 'The authorization system is temporarily not available. You can continue booking.'; ru = 'Система авторизации временно не работает. Можете продолжить бронирование.'; de = 'Das Autorisierungssystem ist vorübergehend nicht verfügbar. Sie können weiter buchen.'",vLanguage);
	EndTry;
	
	vRetXDTO.ErrorDescription 	= vErrorDescription;
	vRetXDTO.CodeIsSent 		= vCodeIsSent;
	
	Return vRetXDTO;
EndFunction

// -----------------------------------------------------------------------------
Function cmVerifyClient(pPhone, pCode, pExternalSystemCode, pHotelCode, pLanguageCode="RU") Export
	WriteLogEvent(NStr("en='Verify client';ru='Проверить клиента';de='Überprüfen Sie den Client'"), EventLogLevel.Information, , , 
					NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF +
					NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF +
					NStr("en='Phone number: ';ru='Номер телефона: ';de='Telefonnummer: '") + pPhone);
	
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "VerifyClient"));
	Try

		vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
		If Not ValueIsFilled(vHotel) Then
			vRetXDTO.ErrorDescription = NStr("en='Hotel not found by code '; ru='Гостиница не найдена по коду '; de='Hotel nicht nach Code gefunden '") + pHotelCode;
			Return vRetXDTO;
		EndIf;
		vLanguage = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Languages", pLanguageCode);
		If vLanguage = Undefined Then
			vLanguage = SessionParameters.CurrentLanguage;
		EndIf;
		
		If IsBlankString(pPhone) Or IsBlankString(pCode) Or IsBlankString(pExternalSystemCode) Then
			If IsBlankString(pPhone) Then
				vRetXDTO.ErrorDescription = cmNStr("en='Phone number is missing; ';ru='Номер телефона отсутствует; ';de='Telefonnummer fehlt; '", vLanguage);
			EndIf;
			If IsBlankString(pCode) Then
				vRetXDTO.ErrorDescription = vRetXDTO.ErrorDescription + cmNStr("en='Code is missing; ';ru='Пароль отсутствует; ';de='Code fehlt; '", vLanguage);
			EndIf;
			If IsBlankString(pExternalSystemCode) Then
				vRetXDTO.ErrorDescription = vRetXDTO.ErrorDescription + cmNStr("en='External system code is missing; ';ru='Код внешней системы отсутствует; ';de='Code des externen Systems fehlt; '", vLanguage);
			EndIf;
			Return vRetXDTO; 
		EndIf;
		
		// Try to check verification code over phone
		vRcdMgr = GetVerificationRecordByPhoneAndCode(pExternalSystemCode, pPhone, pCode);
		If vRcdMgr <> Undefined Then
			If Not vRcdMgr.IsUsed Then
				vRcdMgr.IsUsed = True;
				vRcdMgr.DateUsed = CurrentSessionDate();
				vRcdMgr.Write();
			EndIf;
			vClients = GetClientsByPhone(SMS.GetValidPhoneNumber(pPhone));
			If vClients.Count() > 0 Then
				vIsCustomer = vClients.Get(0).IsCustomer;
				
				vRetXDTO.IsCustomer = vIsCustomer;
				
				vDefaultClient = Undefined;
				If vIsCustomer Then
					vCustomer = vClients.Get(0).Client;
					vRetXDTO.ProfileCode = vCustomer.Code;
					If vCustomer.IsIndividual Then
						vRetXDTO.CustomerName = Title(TrimAll(vCustomer.Description));
					Else
						vRetXDTO.CustomerName = TrimAll(vCustomer.LegacyName);
					EndIf;
					vDiscountType = vCustomer.DiscountType;
					If Not ValueIsFilled(vDiscountType) And ValueIsFilled(vCustomer.ClientType) Then
						vDiscountType = vCustomer.ClientType.DiscountType;
					EndIf;
					vDefaultClient = vCustomer.Client;
				Else
					vDefaultClient = vClients.Get(0).Client;
					vRetXDTO.ProfileCode = vDefaultClient.Code;
					vDiscountType = vDefaultClient.DiscountType;
					If Not ValueIsFilled(vDiscountType) And ValueIsFilled(vDefaultClient.ClientType) Then
						vDiscountType = vDefaultClient.ClientType.DiscountType;
					EndIf;
				EndIf;
				
				vWriteExternalClient	 					= XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "WriteExternalClient"));
				If ValueIsFilled(vDefaultClient) Then 
					vWriteExternalClient.ClientCode 		= vDefaultClient.Code;
					vWriteExternalClient.ClientLastName 	= vDefaultClient.LastName;
					vWriteExternalClient.ClientFirstName 	= vDefaultClient.FirstName;
					vWriteExternalClient.ClientSecondName 	= vDefaultClient.SecondName;
					If vDefaultClient.Sex = Enums.Sex.Male Then 
						vWriteExternalClient.ClientSex = nstr("en = 'M'; ru = 'М'; de = 'M'");
					Else
						vWriteExternalClient.ClientSex = nstr("en = 'F'; ru = 'Ж'; de = 'F'");
					EndIf;
					vWriteExternalClient.ClientCitizenship 	= vDefaultClient.Citizenship.Description;
					vWriteExternalClient.ClientBirthDate 	= vDefaultClient.DateOfBirth;
					vWriteExternalClient.ClientPhone 		= vDefaultClient.Phone;
					vWriteExternalClient.ClientFax 			= vDefaultClient.Fax;
					vWriteExternalClient.ClientEMail 		= vDefaultClient.EMail;
					vWriteExternalClient.ClientRemarks 		= vDefaultClient.Remarks;
					vWriteExternalClient.Address 			= vDefaultClient.Address;
				Else
					vWriteExternalClient.ClientCode 		= "";
					vWriteExternalClient.ClientLastName 	= "";
					vWriteExternalClient.ClientFirstName 	= "";
					vWriteExternalClient.ClientSecondName 	= "";
					vWriteExternalClient.ClientSex 			= "";
					vWriteExternalClient.ClientCitizenship 	= "";
					vWriteExternalClient.ClientBirthDate 	= '00010101';
					vWriteExternalClient.ClientPhone 		= "";
					vWriteExternalClient.ClientFax 			= "";
					vWriteExternalClient.ClientEMail 		= "";
					vWriteExternalClient.ClientRemarks 		= "";
					vWriteExternalClient.Address 			= "";
				EndIf;
				
				vRetXDTO.IndividualCustomer = vWriteExternalClient;
				
				vServicesDiscount = Prices.GetServicesDiscount(pExternalSystemCode, vDiscountType, vHotel);
				vRoomDiscount     = Prices.GetDiscountByType(pExternalSystemCode, vDiscountType, vHotel);
				
				vServicesDiscountXDTO 	= XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ServicesDiscount"));
				For Each vDiscount In vServicesDiscount Do
					vServiceDiscountRow 				= XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ServiceDiscountRow"));
					vServiceDiscountRow.ServiceGroup	= vDiscount.ObjectExternalCode;
					vServiceDiscountRow.Discount		= vDiscount.Discount;
					vServicesDiscountXDTO.ServiceDiscountRow.Add(vServiceDiscountRow);
				EndDo;
				
				vRetXDTO.RoomDiscount 		= vRoomDiscount;
				vRetXDTO.ServicesDiscount 	= vServicesDiscountXDTO;
				vRetXDTO.ClientType 		= vDefaultClient.ClientType.Description;
			Else
				vWriteExternalClient = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "WriteExternalClient"));
				vRetXDTO.ErrorDescription = "";
				vRetXDTO.IsCustomer = False;
				vRetXDTO.ProfileCode = "";
			EndIf;			
		Else
			vRetXDTO.ErrorDescription = cmNStr("en='Wrong code';ru='Неверный пароль';de='Falscher Code'",vLanguage);	
		EndIf;
	Except
		vError = ErrorDescription();
		vRetXDTO.ErrorDescription = vError;
	EndTry;
	
	Return vRetXDTO;
EndFunction

// -----------------------------------------------------------------------------
// Description: Get all reservations with transactions
// Parameters: pHotelCode, pGuestGroup, pPeriodFrom, pPeriodTo, pExternalSystemCode, pSendAccommodationTypes
// Return value: Error description as string
Function cmGetAllReservationsWithTransactions(pHotelCode, pGuestGroup, pPeriodFrom, pPeriodTo, pExternalSystemCode, pSendAccommodationTypes = False) Export
	WriteLogEvent(NStr("en='Get all reservations with transactions';ru='Получить список броней c транзакциями';de='Get all reservations with transactions'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	               NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo + Chars.LF +  
				  NStr("en='Guest Group: ';ru='Группа гостей: ';de='Gastgruppe: '") + pGuestGroup);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	vLanguage = SessionParameters.CurrentLanguage;
	
	If Not IsBlankString(pGuestGroup) Then
		Try
		    vGuestGroup = Number(pGuestGroup);
		Except
		    Raise Nstr("en = 'Incorrect number of guest group'; de = 'Falsche Nummer der Gastgruppe'; ru = 'Некорректно указан номер группы гостей'");
		EndTry;
	EndIf;	
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ReservationsList"));
	
	// Get all reservations
	If vHotel <> Undefined Then
		vCustomersList = ChannelManagers.GetMappedListObjects(vHotel, pExternalSystemCode, "Customers").UnloadColumn("ObjectRef");
		// Run query
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Reservation.Ref AS Ref
		|INTO Res
		|FROM
		|	Document.Reservation AS Reservation
		|WHERE
		|	CASE
		|			WHEN &qGuestGroup = 0
		|				THEN Reservation.CheckInDate <= &qPeriodTo
		|						AND Reservation.CheckOutDate >= &qPeriodFrom
		|			ELSE Reservation.GuestGroup.Code = &qGuestGroup
		|		END
		|	AND Reservation.Hotel = &qHotel
		|	AND CASE
		|			WHEN &qCustomersListIsEmpty
		|				THEN TRUE
		|			ELSE Reservation.Customer IN (&qCustomersList)
		|					OR Reservation.Agent IN (&qCustomersList)
		|		END
		|	AND Reservation.Posted = TRUE
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SalesTurnovers.AccountingDate AS TransactionDate,
		|	SalesTurnovers.Service.HideIntoServiceOnPrint AS Service,
		|	SUM(ISNULL(SalesTurnovers.SalesTurnover, 0)) AS Sales,
		|	Res.Ref.GuestGroup AS GuestGroup,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.RoomType
		|		ELSE SalesTurnovers.ParentDoc.RoomType
		|	END AS RoomType
		|INTO AdditionalServiceTab
		|FROM
		|	Res AS Res
		|		LEFT JOIN AccumulationRegister.Sales.Turnovers(
		|				,
		|				,
		|				Record,
		|				ParentDoc.ParentDoc IN
		|						(SELECT
		|							Res.Ref AS Ref
		|						FROM
		|							Res AS Res)
		|					OR ParentDoc IN
		|						(SELECT
		|							Res.Ref AS Ref
		|						FROM
		|							Res AS Res)) AS SalesTurnovers
		|		ON (Res.Ref = SalesTurnovers.ParentDoc.ParentDoc
		|				OR Res.Ref = SalesTurnovers.ParentDoc)
		|			AND (SalesTurnovers.SalesTurnover > 0)
		|WHERE
		|	CASE
		|			WHEN SalesTurnovers.Recorder REFS Document.Charge
		|				THEN SalesTurnovers.Recorder.Service <> SalesTurnovers.Service
		|			ELSE TRUE
		|		END
		|
		|GROUP BY
		|	SalesTurnovers.AccountingDate,
		|	SalesTurnovers.Service.HideIntoServiceOnPrint,
		|	Res.Ref.GuestGroup,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.RoomType
		|		ELSE SalesTurnovers.ParentDoc.RoomType
		|	END
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Res.Ref AS Reservation,
		|	SalesTurnovers.AccountingDate AS TransactionDate,
		|	SalesTurnovers.Recorder.Number AS TransactionNumber,
		|	SalesTurnovers.Service AS Service,
		|	SalesTurnovers.Customer AS ServiceCustomer,
		|	SalesTurnovers.Contract AS ServiceContract,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.Guest
		|		ELSE SalesTurnovers.Client
		|	END AS Client,
		|	ISNULL(SalesTurnovers.SalesTurnover, 0) + ISNULL(AdditionalServiceTab.Sales, 0) AS Sales,
		|	ISNULL(SalesTurnovers.QuantityTurnover, 1) AS Quantity,
		|	SalesTurnovers.ParentDoc AS Accomodation,
		|	Res.Ref.GuestGroup AS GuestGroup,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.Room
		|		ELSE SalesTurnovers.ParentDoc.Room
		|	END AS Room,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.RoomType
		|		ELSE SalesTurnovers.ParentDoc.RoomType
		|	END AS RoomType,
		|	Res.Ref.Number AS DocNumber,
		|	Res.Ref.ExternalCode AS ExternalCode,
		|	Res.Ref.Remarks AS DocRemarks,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.RoomRate
		|		ELSE SalesTurnovers.ParentDoc.RoomRate
		|	END AS RoomRate,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.ReservationStatus
		|		ELSE CASE
		|				WHEN SalesTurnovers.ParentDoc REFS Document.Accommodation
		|					THEN SalesTurnovers.ParentDoc.AccommodationStatus
		|				ELSE Res.Ref.ReservationStatus
		|			END
		|	END AS Status,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.ReservationStatus.SortCode
		|		ELSE CASE
		|				WHEN SalesTurnovers.ParentDoc REFS Document.Accommodation
		|					THEN SalesTurnovers.ParentDoc.AccommodationStatus.SortCode
		|				ELSE Res.Ref.ReservationStatus.SortCode
		|			END
		|	END AS StatusSortCode,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.CheckInDate
		|		ELSE SalesTurnovers.ParentDoc.CheckInDate
		|	END AS CheckInDate,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.CheckOutDate
		|		ELSE SalesTurnovers.ParentDoc.CheckOutDate
		|	END AS CheckOutDate,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfAdults
		|		ELSE SalesTurnovers.ParentDoc.NumberOfAdults
		|	END AS Adults,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfTeenagers
		|		ELSE SalesTurnovers.ParentDoc.NumberOfTeenagers
		|	END AS Kids,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfChildren + Res.Ref.NumberOfInfants
		|		ELSE SalesTurnovers.ParentDoc.NumberOfChildren + SalesTurnovers.ParentDoc.NumberOfInfants
		|	END AS Kids2,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.AccommodationType
		|		ELSE SalesTurnovers.ParentDoc.AccommodationType
		|	END AS AccommodationType,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.RoomQuota
		|		ELSE SalesTurnovers.ParentDoc.RoomQuota
		|	END AS RoomQuota,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.ServicePackage
		|		ELSE SalesTurnovers.ParentDoc.ServicePackage
		|	END AS ServicePackage,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.Customer
		|		ELSE SalesTurnovers.ParentDoc.Customer
		|	END AS Customer,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.Contract
		|		ELSE SalesTurnovers.ParentDoc.Contract
		|	END AS Contract,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.Agent
		|		ELSE SalesTurnovers.ParentDoc.Agent
		|	END AS Agent,
		|	CASE
		|		WHEN SalesTurnovers.ParentDoc IS NULL
		|			THEN Res.Ref.AgentCommission
		|		ELSE SalesTurnovers.ParentDoc.AgentCommission
		|	END AS AgentCommission,
		|	SalesTurnovers.Recorder.Remarks AS TransactionRemarks,
		|	NULL AS PaymentMethod,
		|	ISNULL(SalesTurnovers.DiscountSumTurnover, 0) AS DiscountSum,
		|	ISNULL(SalesTurnovers.Recorder.IsAdditional, FALSE) AS IsAdditional
		|FROM
		|	Res AS Res
		|		LEFT JOIN AccumulationRegister.Sales.Turnovers(
		|				,
		|				,
		|				Record,
		|				ParentDoc.ParentDoc IN
		|						(SELECT
		|							Res.Ref AS Ref
		|						FROM
		|							Res AS Res)
		|					OR ParentDoc IN
		|						(SELECT
		|							Res.Ref AS Ref
		|						FROM
		|							Res AS Res)) AS SalesTurnovers
		|			LEFT JOIN AdditionalServiceTab AS AdditionalServiceTab
		|			ON SalesTurnovers.AccountingDate = AdditionalServiceTab.TransactionDate
		|				AND SalesTurnovers.Service = AdditionalServiceTab.Service
		|				AND SalesTurnovers.GuestGroup = AdditionalServiceTab.GuestGroup
		|				AND SalesTurnovers.RoomType = AdditionalServiceTab.RoomType
		|		ON (Res.Ref = SalesTurnovers.ParentDoc.ParentDoc
		|				OR Res.Ref = SalesTurnovers.ParentDoc)
		|			AND (SalesTurnovers.SalesTurnover > 0)
		|			AND (CASE
		|				WHEN SalesTurnovers.Recorder REFS Document.Charge
		|						AND SalesTurnovers.Recorder.Service = SalesTurnovers.Service
		|					THEN TRUE
		|				ELSE FALSE
		|			END)
		|
		|UNION ALL
		|
		|SELECT
		|	Res.Ref,
		|	Accounts.Period,
		|	Accounts.Recorder.Number,
		|	Accounts.ChequeService,
		|	Accounts.Recorder.AccountingCustomer,
		|	Accounts.Recorder.AccountingContract,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.Guest
		|		ELSE Accounts.ParentDoc.Guest
		|	END,
		|	ISNULL(Accounts.Sum, 0),
		|	ISNULL(Accounts.Quantity, 1),
		|	Accounts.ParentDoc,
		|	Res.Ref.GuestGroup,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.Room
		|		ELSE Accounts.ParentDoc.Room
		|	END,
		|	Res.Ref.RoomType,
		|	Res.Ref.Number,
		|	Res.Ref.ExternalCode,
		|	Res.Ref.Remarks,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.RoomRate
		|		ELSE Accounts.ParentDoc.RoomRate
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.ReservationStatus
		|		ELSE Accounts.ParentDoc.AccommodationStatus
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.ReservationStatus.SortCode
		|		ELSE Accounts.ParentDoc.AccommodationStatus.SortCode
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.CheckInDate
		|		ELSE Accounts.ParentDoc.CheckInDate
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.CheckOutDate
		|		ELSE Accounts.ParentDoc.CheckOutDate
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfAdults
		|		ELSE Accounts.ParentDoc.NumberOfAdults
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfTeenagers
		|		ELSE Accounts.ParentDoc.NumberOfTeenagers
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.NumberOfChildren + Res.Ref.NumberOfInfants
		|		ELSE Accounts.ParentDoc.NumberOfChildren + Accounts.ParentDoc.NumberOfInfants
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.AccommodationType
		|		ELSE Accounts.ParentDoc.AccommodationType
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.RoomQuota
		|		ELSE Accounts.ParentDoc.RoomQuota
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.ServicePackage
		|		ELSE Accounts.ParentDoc.ServicePackage
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.Customer
		|		ELSE Accounts.ParentDoc.Customer
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.Contract
		|		ELSE Accounts.ParentDoc.Contract
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.Agent
		|		ELSE Accounts.ParentDoc.Agent
		|	END,
		|	CASE
		|		WHEN Accounts.ParentDoc IS NULL
		|			THEN Res.Ref.AgentCommission
		|		ELSE Accounts.ParentDoc.AgentCommission
		|	END,
		|	Accounts.Remarks,
		|	Accounts.PaymentMethod,
		|	0,
		|	FALSE
		|FROM
		|	Res AS Res
		|		LEFT JOIN AccumulationRegister.Accounts AS Accounts
		|		ON (Res.Ref = Accounts.Recorder.ParentDoc
		|				OR Res.Ref = Accounts.Recorder.ParentDoc.ParentDoc)
		|WHERE
		|	Accounts.RecordType = VALUE(AccumulationRecordType.Expense)
		|	AND (Accounts.ParentDoc.ParentDoc IN
		|				(SELECT
		|					Res.Ref AS Ref
		|				FROM
		|					Res AS Res)
		|			OR Accounts.ParentDoc IN
		|				(SELECT
		|					Res.Ref AS Ref
		|				FROM
		|					Res AS Res))
		|	AND Accounts.Recorder.Hotel = &qHotel
		|
		|ORDER BY
		|	StatusSortCode,
		|	DocNumber";

		vQry.SetParameter("qHotel", 	vHotel);
		vQry.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom));
		vQry.SetParameter("qPeriodTo", 	EndOfDay(pPeriodTo));
		vQry.SetParameter("qGuestGroup", ?(IsBlankString(pGuestGroup), 0, Number(pGuestGroup)));
		vQry.SetParameter("qCustomersList", 	vCustomersList);
		vQry.SetParameter("qCustomersListIsEmpty", 	vCustomersList.Count()=0);

		vReservations = vQry.Execute().Unload();
		
		// Custom attributes
		vQry.Text = 
		"SELECT
		|	Reservation.Ref AS Ref
		|INTO Res
		|FROM
		|	Document.Reservation AS Reservation
		|WHERE
		|	CASE
		|			WHEN &qGuestGroup = 0
		|				THEN Reservation.CheckInDate <= &qPeriodTo
		|						AND Reservation.CheckOutDate >= &qPeriodFrom
		|			ELSE Reservation.GuestGroup.Code = &qGuestGroup
		|		END
		|	AND Reservation.Hotel = &qHotel
		|	AND CASE
		|			WHEN &qCustomersListIsEmpty
		|				THEN TRUE
		|			ELSE Reservation.Customer IN (&qCustomersList)
		|					OR Reservation.Agent IN (&qCustomersList)
		|		END
		|	AND Reservation.Posted = TRUE
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Res.Ref AS Ref,
		|	ReservationCustomAttributeValues.Characteristic AS Characteristic,
		|	ReservationCustomAttributeValues.CharacteristicValue AS CharacteristicValue
		|FROM
		|	Res AS Res
		|		LEFT JOIN InformationRegister.ReservationCustomAttributeValues AS ReservationCustomAttributeValues
		|		ON Res.Ref = ReservationCustomAttributeValues.Owner
		|WHERE
		|	NOT ReservationCustomAttributeValues.Characteristic IS NULL
		|	AND ReservationCustomAttributeValues.Owner IN
		|			(SELECT
		|				Res.Ref AS Ref
		|			FROM
		|				Res AS Res)";
		
		vRevReservationsCustomAttributes = vQry.Execute().Unload();
		
		vCurResRef = Undefined;
		vCurDocNumber = Undefined;
		vCurRoom = Undefined;
		vXDTOReservationRow = Undefined;
		vAlreadyUnload = New Array;
		For Each vReservationRow In vReservations Do
			// Build return object
			If vCurDocNumber <> vReservationRow.DocNumber Then
				If vXDTOReservationRow = Undefined Then
					vXDTOReservationRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ReservationsListRow"));
					vXDTOReservationRow.Amount = 0;
					vXDTOReservationRow.AmountAddServices = 0;
				Else
					vRetXDTO.ReservationsListRow.Add(vXDTOReservationRow);
					vXDTOReservationRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ReservationsListRow"));
					vXDTOReservationRow.Amount = 0;
					vXDTOReservationRow.AmountAddServices = 0;
				EndIf;
				// Fill XDTO object attributes
				If ValueIsFilled(vReservationRow.GuestGroup) Then
					vXDTOReservationRow.GuestGroup = Format(vReservationRow.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=");
				Else
					vXDTOReservationRow.GuestGroup = "";
				EndIf;
				// Number				
				vXDTOReservationRow.Number = TrimAll(vReservationRow.DocNumber);
				// Guest name
				vClient = vReservationRow.GuestGroup.Client;
				vRoom = vReservationRow.Room;
				If ValueIsFilled(vReservationRow.Accomodation) And TypeOf(vReservationRow.Accomodation) = Type("DocumentRef.Accommodation") Then
					vQry = New Query();
					vQry.Text = 
					"SELECT
					|	Docs.Ref AS Ref
					|FROM
					|	Document.Accommodation AS Docs
					|WHERE
					|	Docs.Room = &qRoom
					|	AND (&qNumberIsEmpty
					|			OR NOT &qNumberIsEmpty
					|				AND Docs.Number = &qNumber)
					|	AND Docs.GuestGroup = &qGuestGroup
					|	AND Docs.Posted
					|	AND Docs.CheckInDate < &qCheckOutDate
					|	AND Docs.CheckOutDate > &qCheckInDate
					|	AND Docs.AccommodationType.Type = &qRoomAccommodationType
					|
					|ORDER BY
					|	Docs.Date,
					|	Docs.PointInTime";
					vQry.SetParameter("qRoom", vRoom);
					vQry.SetParameter("qNumber", vXDTOReservationRow.Number);
					vQry.SetParameter("qNumberIsEmpty", IsBlankString(vXDTOReservationRow.Number));
					vQry.SetParameter("qGuestGroup", vReservationRow.GuestGroup);
					vQry.SetParameter("qCheckInDate", vReservationRow.CheckInDate);
					vQry.SetParameter("qCheckOutDate", vReservationRow.CheckOutDate);
					vQry.SetParameter("qRoomAccommodationType", Enums.AccomodationTypes.Room);
					vOneRoomDocs = vQry.Execute().Unload();
					If vOneRoomDocs.Count() > 0 Then
						vAcc = vOneRoomDocs.Get(0).Ref;
					Else
						vAcc = Undefined;
					EndIf;
					
					If Not vAcc = Undefined Then
						If ValueIsFilled(vAcc.Guest) Then
							vClient = vAcc.Guest;
						EndIf;	
					EndIf;	
				Else
					vQry = New Query();
					vQry.Text = 
					"SELECT
					|	Reservation.Ref AS Ref
					|FROM
					|	Document.Reservation AS Reservation
					|WHERE
					|	(NOT &qRoomIsFilled
					|				AND Reservation.Number = &qNumber
					|			OR &qRoomIsFilled
					|				AND Reservation.Room = &qRoom)
					|	AND Reservation.GuestGroup = &qGuestGroup
					|	AND Reservation.Posted
					|	AND Reservation.AccommodationType.Type = &qRoomAccommodationType
					|
					|ORDER BY
					|	Reservation.Date,
					|	Reservation.PointInTime";
					vQry.SetParameter("qNumber", TrimAll(vXDTOReservationRow.Number));
					vQry.SetParameter("qGuestGroup", vReservationRow.GuestGroup);
					vQry.SetParameter("qRoomIsFilled", ValueIsFilled(vRoom));
					vQry.SetParameter("qRoom", vRoom);
					vQry.SetParameter("qRoomAccommodationType", Enums.AccomodationTypes.Room);
					vOneRoomDocs = vQry.Execute().Unload();
					If vOneRoomDocs.Count() > 0 Then
						vRes = vOneRoomDocs.Get(0).Ref;
					Else
						vRes = Undefined;
					EndIf;
					
					If Not vRes = Undefined Then
						If ValueIsFilled(vRes.Guest) Then
							vClient = vRes.Guest;
						EndIf;	
					EndIf;	
				EndIf;	
				If ValueIsFilled(vClient) Then
					vXDTOReservationRow.GuestFullName = vClient.FullName;
				Else
					vXDTOReservationRow.GuestFullName = "";
				EndIf;
				// Room
				vXDTOReservationRow.Room = TrimAll(vRoom.Description);
				// Room type
				If ValueIsFilled(vReservationRow.RoomType) Then
					If ValueIsFilled(cmNStr(vReservationRow.RoomType.DescriptionTranslations, vLanguage)) Then
						vXDTOReservationRow.RoomType = cmNStr(vReservationRow.RoomType.DescriptionTranslations, vLanguage);
					Else
						vXDTOReservationRow.RoomType = TrimAll(vReservationRow.RoomType.Description);
					EndIf;
					vXDTOReservationRow.RoomTypeCode = TrimAll(vReservationRow.RoomType.Code);
				Else
					vXDTOReservationRow.RoomType = "";
					vXDTOReservationRow.RoomTypeCode = "";
				EndIf;
				// Status
				If ValueIsFilled(vReservationRow.Status) Then
					vXDTOReservationRow.Status = TrimAll(vReservationRow.Status.Description);
					If ValueIsFilled(vReservationRow.Accomodation) And TypeOf(vReservationRow.Accomodation) = Type("DocumentRef.Accommodation") Then
						If vReservationRow.Status.IsActive And vReservationRow.Status.IsInHouse And vReservationRow.Status.IsCheckIn Then
							vXDTOReservationRow.StatusCode 			    = "I";
						ElsIf vReservationRow.Status.IsActive And vReservationRow.Status.IsInHouse = False And vReservationRow.Status.IsCheckIn Then
							vXDTOReservationRow.StatusCode 			    = "O";
						ElsIf vReservationRow.Status.IsActive = False Then
							vXDTOReservationRow.StatusCode 			    = "C";
						Else
							vXDTOReservationRow.StatusCode 			    = "";
						EndIf;
					Else
						If vReservationRow.Status.IsActive And vReservationRow.Status.IsCheckIn = False Then
							vXDTOReservationRow.StatusCode 			    = "R";
						ElsIf vReservationRow.Status.IsCheckIn  Then
							vXDTOReservationRow.StatusCode 			    = "I";	
						ElsIf vReservationRow.Status.IsNoShow  Then
							vXDTOReservationRow.StatusCode 			    = "N";
						Else
							vXDTOReservationRow.StatusCode 			    = "C";
						EndIf;	
					EndIf;
				EndIf;
				// Period
				vXDTOReservationRow.CheckInDate = vReservationRow.CheckInDate;
				vXDTOReservationRow.CheckOutDate = vReservationRow.CheckOutDate;
				// Totals guest
				vXDTOReservationRow.Adults = vReservationRow.Adults;
				vXDTOReservationRow.Kids = vReservationRow.Kids;
				vXDTOReservationRow.Kids2 = vReservationRow.Kids2;
				// Remarks
				vXDTOReservationRow.Remarks = Left(vReservationRow.DocRemarks, 4096);
				// Accommodation type				
				If ValueIsFilled(vReservationRow.AccommodationType) And pSendAccommodationTypes Then
					If ValueIsFilled(cmNStr(vReservationRow.AccommodationType.DescriptionTranslations, vLanguage)) Then
						vXDTOReservationRow.AccommodationType = cmNStr(vReservationRow.AccommodationType.DescriptionTranslations, vLanguage);
					Else
						vXDTOReservationRow.AccommodationType = TrimAll(vReservationRow.AccommodationType.Description);
					EndIf;
					vXDTOReservationRow.AccommodationTypeCode = TrimAll(vReservationRow.AccommodationType.Code);
				Else
					vXDTOReservationRow.AccommodationType = "";
					vXDTOReservationRow.AccommodationTypeCode = "";
				EndIf;
				// Room rate
				If ValueIsFilled(vReservationRow.RoomRate) Then
					If ValueIsFilled(cmNStr(vReservationRow.RoomRate.DescriptionTranslations, vLanguage)) Then
						vXDTOReservationRow.RoomRate = cmNStr(vReservationRow.RoomRate.DescriptionTranslations, vLanguage);
					Else
						vXDTOReservationRow.RoomRate = TrimAll(vReservationRow.RoomRate.Description);
					EndIf;
					vXDTOReservationRow.RoomRateCode = TrimAll(vReservationRow.RoomRate.Code);
				Else
					vXDTOReservationRow.RoomRate = "";
					vXDTOReservationRow.RoomRateCode = "";
				EndIf;
				// Service package
				If ValueIsFilled(vReservationRow.ServicePackage) Then
					If ValueIsFilled(cmNStr(vReservationRow.ServicePackage.DescriptionTranslations, vLanguage)) Then
						vXDTOReservationRow.ServicePackage = cmNStr(vReservationRow.ServicePackage.DescriptionTranslations, vLanguage);
					Else
						vXDTOReservationRow.ServicePackage = TrimAll(vReservationRow.ServicePackage.Description);
					EndIf;
					vXDTOReservationRow.ServicePackageCode = TrimAll(vReservationRow.ServicePackage.Code);
				Else
					vXDTOReservationRow.ServicePackage = "";
					vXDTOReservationRow.ServicePackageCode = "";
				EndIf;
				// Room quota
				If ValueIsFilled(vReservationRow.RoomQuota) Then
					vXDTOReservationRow.RoomQuota = TrimAll(vReservationRow.RoomQuota.Description);
					vXDTOReservationRow.RoomQuotaCode = TrimAll(vReservationRow.RoomQuota.Code);
				EndIf;
				// Customer
				If ValueIsFilled(vReservationRow.Customer) Then
					If ValueIsFilled(vReservationRow.Customer.LegacyName) Then
						vXDTOReservationRow.CustomerName = TrimAll(vReservationRow.Customer.LegacyName);
					Else
						vXDTOReservationRow.CustomerName = TrimAll(vReservationRow.Customer.Description);
					EndIf;
					vXDTOReservationRow.CustomerCode = vReservationRow.Customer.Code;
				Else
					vXDTOReservationRow.CustomerName = "";
					vXDTOReservationRow.CustomerCode = "";
				EndIf;
				// Contract
				If ValueIsFilled(vReservationRow.Contract) Then
					vXDTOReservationRow.Contract = TrimAll(vReservationRow.Contract.Description);
					vXDTOReservationRow.ContractCode = TrimAll(vReservationRow.Customer.Code);
				Else
					vXDTOReservationRow.Contract = "";
					vXDTOReservationRow.ContractCode = "";
				EndIf;
				// Agent
				If ValueIsFilled(vReservationRow.Agent) Then
					If ValueIsFilled(vReservationRow.Agent.LegacyName) Then
						vXDTOReservationRow.Agent = TrimAll(vReservationRow.Agent.LegacyName);
					EndIf;
					vXDTOReservationRow.AgentCode = TrimAll(vReservationRow.Agent.Code);
				Else
					vXDTOReservationRow.Agent = "";
					vXDTOReservationRow.AgentCode = "";
				EndIf;
	            // AgentCommission
				If ValueIsFilled(vReservationRow.AgentCommission) Then
					vXDTOReservationRow.AgentCommission = vReservationRow.AgentCommission;
				EndIf;	
				// Amount
				vServices = vReservationRow.Reservation.Services;
				If vAlreadyUnload.Find(vReservationRow.Reservation) = Undefined Then
					vXDTOReservationRow.Amount = vServices.Total("Sum") - vServices.Total("DiscountSum");
					vAlreadyUnload.Add(vReservationRow.Reservation);
				EndIf;
				// Currency
				If vServices.Count() > 0 Then
					vCurrency = vServices[0].FolioCurrency;
					If ValueIsFilled(vCurrency) Then
						If ValueIsFilled(cmNStr(vCurrency.DescriptionTranslations, vLanguage)) Then
							vXDTOReservationRow.Currency = cmNStr(vCurrency.DescriptionTranslations, vLanguage);
						Else
							vXDTOReservationRow.Currency = TrimAll(vCurrency.Description);
						EndIf;
						vXDTOReservationRow.CurrencyCode = TrimAll(vCurrency.Code);
					EndIf;
				Else
					vXDTOReservationRow.Currency = "";
					vXDTOReservationRow.CurrencyCode = ""; 
				EndIf;	
				// External code
				vXDTOReservationRow.ExternalCode = TrimAll(vReservationRow.ExternalCode);
				// Amount additional services
				If vReservationRow.IsAdditional And (ValueIsFilled(vReservationRow.ServiceCustomer) And Not vReservationRow.ServiceCustomer = vHotel.IndividualsCustomer) Then
					vXDTOReservationRow.AmountAddServices = vReservationRow.Sales; 
				EndIf;	

				// Filling details transactions
				vXDTOReservationRow.Transactions = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "Transactions"));
				If  ValueIsFilled(vReservationRow.Service) Or ValueIsFilled(vReservationRow.PaymentMethod) Then 
					vXDTOTransactionsRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "TransactionsRow"));
					
					vXDTOTransactionsRow.TransactionNumber = cmGetDocumentNumberPresentation(Right(vReservationRow.TransactionNumber,10));
					vXDTOTransactionsRow.TransactionDate = vReservationRow.TransactionDate;
					If  ValueIsFilled(vReservationRow.PaymentMethod) Then
						vXDTOTransactionsRow.TransactionDescription = TrimAll(vReservationRow.PaymentMethod.Description);
						vXDTOTransactionsRow.TransactionCode = TrimAll(vReservationRow.PaymentMethod.Code);
					Else	
						vXDTOTransactionsRow.TransactionDescription = TrimAll(vReservationRow.Service.Description);
						vXDTOTransactionsRow.TransactionCode = TrimAll(vReservationRow.Service.Code);
					EndIf;
					If ValueIsFilled(vReservationRow.ServiceCustomer) And Not vReservationRow.ServiceCustomer = vHotel.IndividualsCustomer Then
						If ValueIsFilled(vReservationRow.ServiceCustomer.LegacyName) Then
							vXDTOTransactionsRow.PayerName = TrimAll(vReservationRow.ServiceCustomer.LegacyName);
						Else
							vXDTOTransactionsRow.PayerName = TrimAll(vReservationRow.ServiceCustomer.Description);
						EndIf;
						vXDTOTransactionsRow.PayerCode = TrimAll(vReservationRow.ServiceCustomer.Code);
					Else
						vXDTOTransactionsRow.PayerName = "";
						vXDTOTransactionsRow.PayerCode = "";
					EndIf;	
					vQuantity = ?(vReservationRow.Quantity <> 0,vReservationRow.Quantity,1);
					vXDTOTransactionsRow.Quantity = vQuantity;
					vXDTOTransactionsRow.Price = Round(vReservationRow.Sales/vXDTOTransactionsRow.Quantity);  
					If vXDTOTransactionsRow.Price < 0 Then 
						vXDTOTransactionsRow.Price = vXDTOTransactionsRow.Price *(-1);
					EndIf;	
					vAmountTransaction = 0;
					If ValueIsFilled(vReservationRow.PaymentMethod) Then
						vAmountTransaction = vReservationRow.Sales * (-1);
					Else
						vAmountTransaction = vReservationRow.Sales - vReservationRow.DiscountSum;
					EndIf;
					vXDTOTransactionsRow.Amount = vAmountTransaction;
					vXDTOTransactionsRow.Remarks = Left(vReservationRow.TransactionRemarks, 4096);
					
					vXDTOReservationRow.Transactions.TransactionsRow.Add(vXDTOTransactionsRow);
				EndIf;
				
				// Filling reservation custom attributes
				vXDTOReservationRow.CustomAttributes = "";
				vFilter = vRevReservationsCustomAttributes.FindRows(New Structure("Ref",vReservationRow.Reservation));
				If vFilter.Count() > 0 Then
					vJSONResponse 	= New JSONWriter;
					vJSONResponse.ValidateStructure = False;
					vJSONResponse.SetString();
					
					vArr = New Array;
					For Each vCA In vFilter Do
						vStr = New Structure;
						
						// Attribute
						vStr.Insert("AttributeCode",TrimAll(vCA.Characteristic.Code));
						vStr.Insert("AttributeDescription",TrimAll(vCA.Characteristic.Description));
						vStr.Insert("AttributeValueType",Metadata.FindByType(TypeOf(vCA.CharacteristicValue)).FullName());
						
						// Value
						Try vStr.Insert("ValueCode",TrimAll(vCA.CharacteristicValue.Code)); Except EndTry;
						Try vStr.Insert("ValueDescription",TrimAll(vCA.CharacteristicValue.Description)); Except EndTry;
						Try vStr.Insert("ValueExternalCode",TrimAll(vCA.CharacteristicValue.ExternalCode)); Except EndTry;
						Try vStr.Insert("ValueUUID",XMLString(vCA.CharacteristicValue)); Except EndTry;
						
						// Add to array
						vArr.Add(vStr);
					EndDo;
					
					WriteJSON(vJSONResponse, vArr);
					vJSONText = vJSONResponse.Close();
					
					vXDTOReservationRow.CustomAttributes = vJSONText;
				EndIf;	
			Else
				// Other accommadation in room
				
				// Calculate amount document
				If vCurResRef <> vReservationRow.Reservation Then
					If vAlreadyUnload.Find(vReservationRow.Reservation) = Undefined Then
						vServices = vReservationRow.Reservation.Services;
						vXDTOReservationRow.Amount = vXDTOReservationRow.Amount + vServices.Total("Sum") - vServices.Total("DiscountSum");
						// Totals guest
						vXDTOReservationRow.Adults = vXDTOReservationRow.Adults + vReservationRow.Adults;
						vXDTOReservationRow.Kids = vXDTOReservationRow.Kids + vReservationRow.Kids;
						vXDTOReservationRow.Kids2 = vXDTOReservationRow.Kids2 + vReservationRow.Kids2;
						vAlreadyUnload.Add(vReservationRow.Reservation);
					EndIf;
				EndIf;

				// Amount additional services
				If vReservationRow.IsAdditional  And (ValueIsFilled(vReservationRow.ServiceCustomer) And Not vReservationRow.ServiceCustomer = vHotel.IndividualsCustomer) Then
					vXDTOReservationRow.AmountAddServices = vXDTOReservationRow.AmountAddServices + vReservationRow.Sales; 
				EndIf;
				If ValueIsFilled(vReservationRow.Service) Or ValueIsFilled(vReservationRow.PaymentMethod) Then 
					vXDTOTransactionsRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "TransactionsRow"));
					
					vXDTOTransactionsRow.TransactionNumber =  cmGetDocumentNumberPresentation(Right(vReservationRow.TransactionNumber,10));
					vXDTOTransactionsRow.TransactionDate = vReservationRow.TransactionDate;
					If  ValueIsFilled(vReservationRow.PaymentMethod) Then
						vXDTOTransactionsRow.TransactionDescription = TrimAll(vReservationRow.PaymentMethod.Description);
						vXDTOTransactionsRow.TransactionCode = TrimAll(vReservationRow.PaymentMethod.Code);
					Else	
						vXDTOTransactionsRow.TransactionDescription = TrimAll(vReservationRow.Service.Description);
						vXDTOTransactionsRow.TransactionCode = TrimAll(vReservationRow.Service.Code);
					EndIf;
					If ValueIsFilled(vReservationRow.ServiceCustomer) And Not vReservationRow.ServiceCustomer = vHotel.IndividualsCustomer Then
						If ValueIsFilled(vReservationRow.ServiceCustomer.LegacyName) Then
							vXDTOTransactionsRow.PayerName = TrimAll(vReservationRow.ServiceCustomer.LegacyName);
						Else
							vXDTOTransactionsRow.PayerName = TrimAll(vReservationRow.ServiceCustomer.Description);
						EndIf;
						vXDTOTransactionsRow.PayerCode = vReservationRow.ServiceCustomer.Code;
					Else
						vXDTOTransactionsRow.PayerName = "";
						vXDTOTransactionsRow.PayerCode = "";
					EndIf;	
					vQuantity = ?(vReservationRow.Quantity <> 0,vReservationRow.Quantity,1);
					vXDTOTransactionsRow.Quantity = vQuantity;
					vXDTOTransactionsRow.Price = Round(vReservationRow.Sales/vXDTOTransactionsRow.Quantity);  
					If vXDTOTransactionsRow.Price < 0 Then 
						vXDTOTransactionsRow.Price = vXDTOTransactionsRow.Price *(-1);
					EndIf;	
					vAmountTransaction = 0;
					If ValueIsFilled(vReservationRow.PaymentMethod) Then
						vAmountTransaction = vReservationRow.Sales * (-1);
					Else
						vAmountTransaction = vReservationRow.Sales - vReservationRow.DiscountSum;
					EndIf;
					vXDTOTransactionsRow.Amount = vAmountTransaction;
					vXDTOTransactionsRow.Remarks = Left(vReservationRow.TransactionRemarks, 4096);
					
					vXDTOReservationRow.Transactions.TransactionsRow.Add(vXDTOTransactionsRow);
				EndIf;
			EndIf;
			vCurResRef = vReservationRow.Reservation;
			vCurDocNumber = vReservationRow.DocNumber;
		EndDo;
		If Not vXDTOReservationRow = Undefined Then
			vRetXDTO.ReservationsListRow.Add(vXDTOReservationRow);
		EndIf;
	EndIf;	
	Return vRetXDTO;
EndFunction // GetAllReservationsWithTransactions 

// -----------------------------------------------------------------------------
// Description: Returnes value table with room types and with number of vacant rooms 
//              and total number of rooms for each room type
// Parameters: Hotel, Room class (as filter), Room quota 
//             (to calculate vacant rooms in quota), period from date, period to date
// Return value: Value table
// -----------------------------------------------------------------------------
Function cmGetRoomTypesWithBalancesByClass(pHotel, pRoomClass, pRoomQuota, pCheckInDate, pCheckOutDate) Export
	// Log function call
	WriteLogEvent(NStr("en='Get room types with balances by class';ru='Получить остатки свободных типов номеров по классу';de='Restbestände an freien Zimmern nach Kategorien erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotel + Chars.LF + 
	              NStr("en='Room class: ';ru='Класс номера: ';de='Zimmerklasse: '") + pRoomClass + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты: ';de='Quotencode: '") + pRoomQuota + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pCheckInDate + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pCheckOutDate);
	// Run query
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	RoomTypeBalances.Hotel AS Hotel,
	|	RoomTypeBalances.Hotel.SortCode AS HotelSortCode,
	|	RoomTypeBalances.RoomType AS RoomType,
	|	RoomTypeBalances.RoomType.SortCode AS RoomTypeSortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate) AS LastReservationDate,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalRooms, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsInQuota, 0)
	|		END) AS TotalRooms,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.TotalBeds, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsInQuota, 0)
	|		END) AS TotalBeds,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) AS RoomsAvailable,
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.BedsAvailable, 0) < ISNULL(RoomTypeBalances.BedsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.BedsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.BedsRemains, 0)
	|		END) AS BedsAvailable,
	|	MAX(RoomTypeBalances.RoomType.NumberOfPersonsPerRoom) AS NumberOfPersonsPerRoom
	|FROM
	|	(SELECT
	|		RoomInventoryBalanceAndTurnovers.Hotel AS Hotel,
	|		RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
	|		MIN(RoomInventoryBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|		MIN(RoomInventoryBalanceAndTurnovers.TotalRoomsClosingBalance) AS TotalRooms,
	|		MIN(RoomInventoryBalanceAndTurnovers.TotalBedsClosingBalance) AS TotalBeds,
	|		MIN(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance) AS RoomsAvailable,
	|		MIN(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance) AS BedsAvailable,
	|		MIN(ISNULL(RoomQuotas.RoomsInQuota, 0)) AS RoomsInQuota,
	|		MIN(ISNULL(RoomQuotas.BedsInQuota, 0)) AS BedsInQuota,
	|		MIN(ISNULL(RoomQuotas.RoomsRemains, 0)) AS RoomsRemains,
	|		MIN(ISNULL(RoomQuotas.BedsRemains, 0)) AS BedsRemains
	|	FROM
	|		AccumulationRegister.RoomInventory.BalanceAndTurnovers(
	|				&qCheckInDate,
	|				&qCheckOutDate,
	|				Second,
	|				RegisterRecordsAndPeriodBoundaries,
	|				Hotel = &qHotel
	|					AND RoomType.RoomClass = &qRoomClass) AS RoomInventoryBalanceAndTurnovers
	|			LEFT JOIN (SELECT
	|				RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance) AS RoomsInQuota,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance) AS BedsInQuota,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) AS RoomsRemains,
	|				MIN(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance) AS BedsRemains
	|			FROM
	|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
	|						&qCheckInDate,
	|						&qCheckOutDate,
	|						Minute,
	|						RegisterRecordsAndPeriodBoundaries,
	|						Hotel = &qHotel
	|							AND RoomType.RoomClass = &qRoomClass
	|							AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
	|			
	|			GROUP BY
	|				RoomQuotaSalesBalanceAndTurnovers.RoomType) AS RoomQuotas
	|			ON RoomInventoryBalanceAndTurnovers.RoomType = RoomQuotas.RoomType
	|	
	|	GROUP BY
	|		RoomInventoryBalanceAndTurnovers.Hotel,
	|		RoomInventoryBalanceAndTurnovers.RoomType) AS RoomTypeBalances
	|		LEFT JOIN (SELECT
	|			Reservations.RoomType AS RoomType,
	|			MAX(Reservations.Date) AS LastReservationDate
	|		FROM
	|			Document.Reservation AS Reservations
	|		WHERE
	|			Reservations.Hotel = &qHotel
	|			AND Reservations.RoomType.RoomClass = &qRoomClass
	|			AND Reservations.ReservationStatus.IsActive
	|			AND Reservations.Posted
	|		
	|		GROUP BY
	|			Reservations.RoomType) AS ActiveReservations
	|		ON (ActiveReservations.RoomType = RoomTypeBalances.RoomType)
	|
	|GROUP BY
	|	RoomTypeBalances.Hotel,
	|	RoomTypeBalances.Hotel.SortCode,
	|	RoomTypeBalances.RoomType,
	|	RoomTypeBalances.RoomType.SortCode,
	|	ISNULL(ActiveReservations.LastReservationDate, &qEmptyDate)
	|
	|HAVING
	|	MIN(CASE
	|			WHEN &qRoomQuotaIsEmpty
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			WHEN &qRoomQuotaDoNotWriteOff
	|					AND ISNULL(RoomTypeBalances.RoomsAvailable, 0) < ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|				THEN ISNULL(RoomTypeBalances.RoomsAvailable, 0)
	|			ELSE ISNULL(RoomTypeBalances.RoomsRemains, 0)
	|		END) > 0
	|
	|ORDER BY
	|	RoomsAvailable DESC,
	|	RoomTypeSortCode";
	vQry.SetParameter("qCheckInDate", pCheckInDate);
	vQry.SetParameter("qCheckOutDate", New Boundary(pCheckOutDate, BoundaryType.Excluding));
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomClass", pRoomClass);
	vQry.SetParameter("qRoomQuota", pRoomQuota);
	vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
	vQry.SetParameter("qRoomQuotaDoNotWriteOff", ?(ValueIsFilled(pRoomQuota), Not pRoomQuota.DoWriteOff, False));
	vList = vQry.Execute().Unload();
	// Return value table with room types and prices
	Return vList;
EndFunction // cmGetRoomTypesWithBalances

// -----------------------------------------------------------------------------
//  Gets the printable by the form ID and UUID of the document
//
// Parameters:
//  pDocumentPrintingForm	 - XDTO	- DocumentType.String, UUID.String, PrintingFormID/String  
//  pExternalSystemCode		 - String - External system code
// 
// Returns:
//   - XDTO   - PDF.Base64String, ErrorDescription 
//
Function cmGetObjectPrintingFormPDF(pDocumentPrintingForm, pExternalSystemCode, pHotelCode) Export    
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "DocumentPDF"));
	vRetXDTO.ErrorDescription = "Not formed";
	vRetXDTO.PDF = "";
    vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Check if external system is active  
	vExtSystem = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);     
	vExtraXML = cmGetXMLStringFromXDTO(pDocumentPrintingForm) + Chars.LF + "External system: " + pExternalSystemCode + Chars.LF + "Hotel code: " + pHotelCode;
    vWriteDebug = False;      
	vFunc = "cmGetObjectPrintingFormPDF";
	vTitle = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
	If ValueIsFilled(vExtSystem) Then 
		vWriteDebug = vExtSystem.DebugMode;
		If vWriteDebug Then
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Info, vExtraXML, , vTitle);	
		Else
			WriteLogEvent(vFunc, EventLogLevel.Information, , , vExtraXML);
		EndIf;	
	Else
		WriteLogEvent(vFunc, EventLogLevel.Information, , , vExtraXML);	
	EndIf;
	// Check external system
	If Not ValueIsFilled(vExtSystem) Or IsBlankString(pExternalSystemCode) Then
		vMsg =  NStr("en = 'Failed to determine interaction from external code: %1'; de = 'Interaktion von externem Code konnte nicht bestimmt werden: %1'; ru = 'Не удалось определить взаимодействие по внешнему коду: %1'");	
		vRetXDTO.ErrorDescription = StrTemplate(vMsg, pExternalSystemCode);     
		WriteLogEvent(vFunc, EventLogLevel.Error, , , cmGetXMLStringFromXDTO(vRetXDTO));
		Return vRetXDTO; 
	EndIf;    
    // Check attributes
	vTitle =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
	vErr = "";
	vErrTemplate = NStr("en = 'Parameter %1 is empty';de = 'Parameter %1 fehlt';ru = 'Параметр %1 не заполнен'");  
	
	vCheckParams = StrSplit("DocumentType,UUID,PrintingFormID", ",", False);
	For Each vId In vCheckParams Do
		If Not ValueIsFilled(pDocumentPrintingForm[vId]) Then
			vErr = vErr + Chars.LF + StrTemplate(vErrTemplate, vId);
		EndIf;
	EndDo;    
	If StrLen(TrimAll(pDocumentPrintingForm.UUID)) <> 36 Then
		vErr = vErr + Chars.LF + NStr("en = 'Invalid document UUID passed'; de = 'Ungültige Dokument-UUID übergeben'; ru = 'Передан неверный UUID документа'");	
	EndIf;	
	If Not IsBlankString(vErr) Then  
		vRetXDTO.ErrorDescription = vErr;    
		vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
		If ValueIsFilled(vExtSystem) Or vWriteDebug Then
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vTitle);	
		Else
			WriteLogEvent(vFunc, EventLogLevel.Error, , , vExtraXML);
		EndIf;	
		Return vRetXDTO; 
	EndIf;
	
	Try   
		vLanguage = Undefined;     
		If ValueIsFilled(pDocumentPrintingForm.Language) Then
			vLanguage = Catalogs.Languages[pDocumentPrintingForm.Language];	
		EndIf;
		// Get document ref   
		vDocumentType = TrimAll(pDocumentPrintingForm.DocumentType);
		vDocManager = Documents[vDocumentType];
		vRef = vDocManager.GetRef(New UUID(TrimAll(pDocumentPrintingForm.UUID)));
		If Not ValueIsFilled(vRef) Or vRef.GetObject() = Undefined Then
			vMsg =  NStr("en = 'Failed to find document for external code: %1'; de = 'Dokument für externen Code konnte nicht gefunden werden: %1'; ru = 'Не удалось найти документ внешнему коду: %1'");	
			vRetXDTO.ErrorDescription = StrTemplate(vMsg, TrimAll(pDocumentPrintingForm.UUID));   
			vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
			If ValueIsFilled(vExtSystem) Or vWriteDebug Then
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vTitle);	
			Else
				WriteLogEvent(vFunc, EventLogLevel.Error, , , vExtraXML);
			EndIf;	
            Return vRetXDTO;
		EndIf;	
		// Get printing form   
		vFormList = cmGetObjectPrintingForms(vDocManager.EmptyRef(), vLanguage);  
		vPrintForm = Undefined;
		If vFormList.Count() = 0 Then
			vMsg =  NStr("en = 'No printables found'; de = 'Keine Ausdrucke gefunden'; ru = 'Не удалось найти ни одной действующей печатной формы'");	
			vRetXDTO.ErrorDescription = vMsg;   
			vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
			If ValueIsFilled(vExtSystem) Or vWriteDebug Then
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vTitle);	
			Else
				WriteLogEvent(vFunc, EventLogLevel.Error, , , vExtraXML);
			EndIf;	
            Return vRetXDTO;  
		Else
			For Each vRow In vFormList Do
				If TrimAll(vRow.Code) = TrimAll(pDocumentPrintingForm.PrintingFormID) Then
					vPrintForm = vRow.ObjectPrintingForm;
					Break;
				EndIf;	
			EndDo;    
		EndIf;    
		If Not ValueIsFilled(vPrintForm) Then
			vMsg =  NStr("en = 'Printable with code %1 for object %2 not found'; de = 'Druckbar mit Code %1 für Objekt %2 nicht gefunden'; ru = 'Печатная форма с кодом %1 для объекта %2 не найдена'");	
			vRetXDTO.ErrorDescription = StrTemplate(vMsg, TrimAll(pDocumentPrintingForm.PrintingFormID), vDocumentType);   
			vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
			If ValueIsFilled(vExtSystem) Or vWriteDebug Then
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vTitle);	
			Else
				WriteLogEvent(vFunc, EventLogLevel.Error, , , vExtraXML);
			EndIf;	
			Return vRetXDTO; 
		EndIf;  
		vSpreadsheet = New SpreadsheetDocument;  
		vTempName = GetTempFileName();
		// Try printing
		If vDocumentType = "Accommodation" Then
			vRetXDTO.ErrorDescription = "Not supported for this document type";	
		ElsIf vDocumentType = "Folio" Then	 
			If ValueIsFilled(vPrintForm.ExternalProcessing) Then
				vExtDataProcessor = cmGetExternalDataProcessorObject(vPrintForm.ExternalProcessing);
				vExtDataProcessor.PrintFolio(vRef, New Array, "", vLanguage, vPrintForm, New ValueTable, vSpreadsheet, vErr);
			Else
				Documents.Folio.PrintFolio(vRef, New Array, "", vLanguage, vPrintForm, New ValueTable, vSpreadsheet, vErr);  
			EndIf;
			vSpreadsheet.Write(vTempName, SpreadsheetDocumentFileType.PDF);
			vRetXDTO.PDF = Base64String(New BinaryData(vTempName));  
			vRetXDTO.ErrorDescription = "";
		ElsIf vDocumentType = "Reservation" Then
			If ValueIsFilled(vPrintForm.ExternalProcessing) Then
				vExtDataProcessor = cmGetExternalDataProcessorObject(vPrintForm.ExternalProcessing);
				vExtDataProcessor.pmPrintConfirmation(vSpreadsheet, vRef, Undefined, 0, Catalogs.ServiceGroups.EmptyRef(), False, vLanguage, vPrintForm);
			Else
				vRef.GetObject().pmPrintConfirmation(vSpreadsheet, vRef, Undefined, 0, Catalogs.ServiceGroups.EmptyRef(), False, vLanguage, vPrintForm);
			EndIf;
			vSpreadsheet.Write(vTempName, SpreadsheetDocumentFileType.PDF);
			vRetXDTO.PDF = Base64String(New BinaryData(vTempName));  
			vRetXDTO.ErrorDescription = "";
		EndIf;	
		DeleteFiles(vTempName);
	Except
		vErrInfo = ErrorInfo();	
		vRetXDTO.ErrorDescription = BriefErrorDescription(vErrInfo);   
		vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
		If ValueIsFilled(vExtSystem) Or vWriteDebug Then
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vTitle);	
		Else
			WriteLogEvent(vFunc, EventLogLevel.Error, , , vExtraXML);
		EndIf;	
		Return vRetXDTO;
	EndTry;    
	
	vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
	If vWriteDebug Then
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vExtSystem, vFunc, Enums.ExternalSystemEventTypes.Info, , vExtraXML, vTitle);	
	Else
		WriteLogEvent(vFunc, EventLogLevel.Information, , , vExtraXML);
	EndIf;	

    Return vRetXDTO;	
EndFunction //  cmGetObjectPrintingFormPDF

// -----------------------------------------------------------------------------
// Description: This API is used to retrive guest group status data
// Parameters: External guest group code, Hotel code, External system code, Language code, 
//             Type of return value: XDTO object or CSV string
// Return value: XDTO ExternalGroupReservationStatus object
// -----------------------------------------------------------------------------
Function cmGetExternalGroupReservationStatus(pExtGroupCode, pHotelCode, pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV", pLogin = "") Export
	vInputParameters = NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	NStr("en='External system group code: ';ru='Код группы во внешней системе: ';de='Gruppencode im externen System: '") + pExtGroupCode;
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetExternalGroupReservationStatus", Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg, vInteraction.MaxLogLenght);
	Else
		WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , vInputParameters);
	EndIf;	
	
	vRetStr = "";
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find existing guest group with given external code
	vErrorDescription = "";
	vMainCustomer = Undefined;
	vMainContract = Undefined;
	vMainAgent = Undefined;
	vReservation = Undefined;
	vProformaInvoice = Undefined;
	vCompany = Undefined;
	If StrLen(pExtGroupCode) = 36 Then     
		vUUID = New UUID(TrimAll(pExtGroupCode));
		vGroupRef = Catalogs.GuestGroups.GetRef(vUUID);
		If vGroupRef.GetObject() = Undefined Then
			// Try get document
			vRes = Documents.Reservation.GetRef(vUUID);
			If Not vRes.GetObject() = Undefined Then
				vReservation = vRes;
				vGroupRef = vRes.GuestGroup;
			Else
				// Try to get proforma invoice
				vProformaInvoice = Documents.ProformaInvoice.GetRef(vUUID);
				If Not ValueIsFilled(vProformaInvoice) Or vProformaInvoice.GetObject() = Undefined Then
					vProformaInvoice = Undefined;
				Else
					vGroupRef = Undefined;
					vCompany = vProformaInvoice.Company;
				EndIf;
			EndIf;	
		EndIf;	
	Else
		vGroupRef = cmGetGuestGroupByExternalCode(vHotel, pExtGroupCode, "", "", False);
	EndIf;
	If ValueIsFilled(vGroupRef) And vGroupRef.GetObject() <> Undefined Then
		vHotel = vGroupRef.Owner;
		// Get group totals
		vGroupObj = vGroupRef.GetObject();
		vReservations = New ValueTable();
		vSalesTotals = New ValueTable();
		vPaymentTotals = New ValueTable();
		vClientDoc = Undefined;
		If ValueIsFilled(vReservation) Then
			vReservations = cmGetOneRoomReservations(vReservation.Number, vGroupRef, vReservation.CheckInDate, vReservation.CheckOutDate);
			vDocsList = New ValueList();
			vCompany = vReservation.Company;
			For Each vReservationsRow In vReservations Do
				vDocsList.Add(vReservationsRow.Reservation);
				If vClientDoc = Undefined Then
					vClientDoc = vReservationsRow.Reservation;
					vMainCustomer = vClientDoc.Customer;
					vMainContract = vClientDoc.Contract;
					vMainAgent = vClientDoc.Agent;
				EndIf;
			EndDo;
			vSalesTotals = vGroupObj.pmGetSalesTotals(, vDocsList);
			vPaymentTotals = vGroupObj.pmGetPaymentsTotals(vDocsList);
		Else
			vReservations = vGroupObj.pmGetReservations(True, True);
			If ValueIsFilled(vGroupRef.ClientDoc) Then
				vClientDoc = vGroupRef.ClientDoc;
				vMainCustomer = vClientDoc.Customer;
				vMainContract = vClientDoc.Contract;
				vMainAgent = vClientDoc.Agent;
				vCompany = vClientDoc.Company;
			EndIf;
			vSalesTotals = vGroupObj.pmGetSalesTotals();
			vPaymentTotals = vGroupObj.pmGetPaymentsTotals();
		EndIf;
		// Get total group amount
		vSum = 0;
		vCurrency = vHotel.BaseCurrency;
		vExtCurrencyCode = "";
		vSumPresentation = "";
		vSumBeforeDiscount = 0;
		vHideAmount = True;
		If Not ValueIsFilled(vMainCustomer) Or ValueIsFilled(vMainCustomer) And vMainCustomer.IsIndividual 
			Or ValueIsFilled(vMainCustomer) And Not vMainCustomer.IsIndividual And ValueIsFilled(vClientDoc) 
			And TypeOf(vClientDoc) = Type("DocumentRef.Reservation") And Not vClientDoc.PlannedPaymentMethod.IsByBankTransfer Then
			vHideAmount = False;
		EndIf;
		If Not IsBlankString(pLogin) Then
			vHideAmount = False;
		EndIf;
		If Not vHideAmount Then
			If vSalesTotals.Count() > 0 Then
				vCurrency = vSalesTotals.Get(0).Currency;
				For Each vSalesTotalsRow In vSalesTotals Do
					If vSalesTotalsRow.Currency = vCurrency Then
						vSum = vSum + vSalesTotalsRow.SalesWithCommission + vSalesTotalsRow.SalesWithCommissionForecast;
						vSumBeforeDiscount = vSumBeforeDiscount + vSalesTotalsRow.SalesWithCommission + vSalesTotalsRow.SalesWithCommissionForecast + vSalesTotalsRow.DiscountSum;
					Else
						vSum = vSum + cmConvertCurrencies(vSalesTotalsRow.SalesWithCommission + vSalesTotalsRow.SalesWithCommissionForecast, vSalesTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
						vSumBeforeDiscount = vSumBeforeDiscount + cmConvertCurrencies(vSalesTotalsRow.SalesWithCommission + vSalesTotalsRow.SalesWithCommissionForecast + vSalesTotalsRow.DiscountSum, vSalesTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
					EndIf;
				EndDo;
				vSum = Round(vSum, 2);
				vSumBeforeDiscount = Round(vSumBeforeDiscount, 2);
			EndIf;
		EndIf;
		vSumPresentation = cmFormatSum(vSum, vCurrency, "NZ=");
		vExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGroupRef.Owner, pExternalSystemCode, "Currencies", vCurrency);
		If IsBlankString(vExtCurrencyCode) Then
			vExtCurrencyCode = TrimAll(vCurrency.Description);
		EndIf;
		// Get base currency code
		vBaseCurrency = vHotel.BaseCurrency;
		vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGroupRef.Owner, pExternalSystemCode, "Currencies", vBaseCurrency);
		If IsBlankString(vExtBaseCurrencyCode) Then
			vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
		EndIf;
		// Get currency rate
		vCurrencyRate = cmGetCurrencyExchangeRate(vHotel, vCurrency, CurrentSessionDate());
		// Get group balance
		vPaymentSum = 0;
		If Not vHideAmount Then
			For Each vPaymentTotalsRow In vPaymentTotals Do
				If vPaymentTotalsRow.Currency = vCurrency Then
					vPaymentSum = vPaymentSum + vPaymentTotalsRow.Sum;
				Else
					vPaymentSum = vPaymentSum + cmConvertCurrencies(vPaymentTotalsRow.Sum, vPaymentTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
				EndIf;
				vPaymentSum = Round(vPaymentSum, 2);
			EndDo;
		EndIf;
		vBalanceAmount = vSum - vPaymentSum;
		vBalanceAmountPresentation = cmFormatSum(vBalanceAmount, vCurrency, "NZ=");
		vBalanceAmountBeforeDiscount = vSumBeforeDiscount - vPaymentSum;
		// Initialize first day amount
		vFirstDayAmount = 0;
		vFirstDayAmountPresentation = "";
		vFirstDayAmountBeforeDiscount = 0;
		// Check number of room reservations found
		If vReservations.Count() = 0 Then
			If ValueIsFilled(vGroupRef.Status) Then
				If TypeOf(vGroupRef.Status) = Type("CatalogRef.ReservationStatuses") Then
					vErrorDescription = cmNStr("en='Reservation is canceled with status: ';ru='Бронь аннулирована! Статус брони: ';de='Die Reservierung wurde storniert! Reservierungsstatus: '", vLanguage) + cmNStr(?(IsBlankString(vGroupRef.Status.DescriptionTranslations), TrimAll(vGroupRef.Status.Description), TrimAll(vGroupRef.Status.DescriptionTranslations)), vLanguage);
				ElsIf TypeOf(vGroupRef.Status) = Type("CatalogRef.AccommodationStatuses") Then 
					vErrorDescription = cmNStr("en='Reservation is checked-in!';ru='По брони оформлено поселение!';de='Nach der Reservierung wurde ein Check-In vorgenommen!'", vLanguage);
				ElsIf TypeOf(vGroupRef.Status) = Type("CatalogRef.ResourceReservationStatuses") Then 
					vErrorDescription = cmNStr("en='There is no room reservations for this booking!';ru='В группе нет брони номеров!';de='In der Gruppe sind keine Zimmerreservierungen vorhanden!'", vLanguage);
				EndIf;
			Else
				vErrorDescription = cmNStr("en='Reservation is canceled!';ru='Бронь аннулирована!';de='Die Reservierung wurde storniert!'", vLanguage);
			EndIf;
		EndIf;
		// Build return XDTO object
		If pOutputType = "XDTO" Then
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
			vRetXDTO.ErrorDescription = "";
			vRetXDTO.GuestGroup = Format(vGroupRef.Code, "ND=12; NFD=0; NZ=; NG=; NN=");
			vRetXDTO.UUID = String(vGroupRef.UUID());
			vRetXDTO.DateFrom = vGroupRef.CheckInDate;
			vRetXDTO.DateTo = vGroupRef.CheckOutDate;
			If vReservations.Count() = 0 Then
				// Build return string
				vRetStr = """" + vErrorDescription + """" + "," + 
				"""" + Format(vGroupRef.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," + 
				"""" + TrimAll(vGroupRef.ExternalCode) + """";
				// Write log event
				WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
				// Fill error description
				vRetXDTO.ErrorDescription = vErrorDescription;
				// Return
				Return vRetXDTO;
			EndIf;
			// Main customer
			FillMainCustomerExternalGroupReservationStatusRow(vMainCustomer, vRetXDTO);
			// Main contract
			If ValueIsFilled(vMainContract) Then
				vRetXDTO.Contract = TrimR(vMainContract.Description);
			Else
				vRetXDTO.Contract = "";
			EndIf;
			// Main agent
			If ValueIsFilled(vMainAgent) Then
				vRetXDTO.Agent = TrimR(vMainAgent.Description);
			Else
				vRetXDTO.Agent = "";
			EndIf;
			// Client
			FillGuestGroupClientExternalGroupReservationStatus(vInteraction, vGroupRef, vRetXDTO);
			
			vRetXDTO.Currency = vExtCurrencyCode;
			vRetXDTO.CurrencyCode = TrimR(vCurrency.Code);
			vRetXDTO.CurrencyDescription = TrimR(vCurrency.Description);
			vRetXDTO.BaseCurrency = vExtBaseCurrencyCode;
			vRetXDTO.CurrencyRate = vCurrencyRate;
			vRetXDTO.TotalSum = vSum;
			vRetXDTO.TotalSumPresentation = vSumPresentation;
			vRetXDTO.TotalSumBeforeDiscount = vSumBeforeDiscount;
			vRetXDTO.BalanceAmount = vBalanceAmount;
			vRetXDTO.BalanceAmountPresentation = vBalanceAmountPresentation;
			vRetXDTO.BalanceAmountBeforeDiscount = vBalanceAmountBeforeDiscount;
			vRetXDTO.ReservationConditions = cmNStr(vGroupRef.Owner.ReservationConditions, vLanguage);
			vGroupClientDoc = vGroupRef.ClientDoc;
			If ValueIsFilled(vGroupClientDoc) And 
				(TypeOf(vGroupClientDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vGroupClientDoc) = Type("DocumentRef.Reservation")) Then
				vRoomRate = vGroupClientDoc.RoomRate;
				If ValueIsFilled(vRoomRate) Then
					vRetXDTO.RoomRateCode = TrimAll(vRoomRate.Code);
					vRetXDTO.RoomRateDescription = vRoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
					vRetXDTO.ReservationConditions = cmNStr(vRoomRate.ReservationConditions, vLanguage);
					vRetXDTO.ReservationConditionsShort = cmNStr(vRoomRate.ReservationConditionsShort, vLanguage);
					vRetXDTO.ReservationConditionsOnline = cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage);
					vRetXDTO.PaymentMethodCodesAllowedOnline = TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline);
				EndIf;
				vRetXDTO.Discount = vGroupClientDoc.Discount;
			EndIf;
			If ValueIsFilled(vGroupRef.CheckDate) Then
				vRetXDTO.CheckDate = vGroupRef.CheckDate;
			EndIf;
			
			vExternalCode = TrimAll(vGroupRef.ExternalCode);
			If IsBlankString(vExternalCode) Then
				vExternalCode = String(vGroupRef.UUID());
				vObj = vGroupRef.GetObject();
				vObj.ExternalCode = vExternalCode;
				vObj.Write();
			EndIf;	
			vRetXDTO.ExtGuestGroupCode = vExternalCode;
			If ValueIsFilled(vInteraction) AND vInteraction.ReturnPaymentURL Then
				vRetXDTO.PaymentURL = Catalogs.ExternalSystemInteractions.GetGuestGroupURL(vGroupRef);
			EndIf;
			// Payment by bonuses maximum amount
			vBonusesLimit = vBalanceAmount;
			If vHotel.PayByBonusesMaxAmount > 0 Then
				vBonusesLimit = Min(vBonusesLimit, vHotel.PayByBonusesMaxAmount);
			EndIf;
			If vHotel.PayByBonusesMaxPercentage > 0 And vSum > 0 Then
				vBonusesLimitByPercentage = Round(vSum * vHotel.PayByBonusesMaxPercentage / 100, 2);
				vBonusesLimit = Min(vBonusesLimit, vBonusesLimitByPercentage);
			EndIf;
			If vHotel.PayByBonusesMLOS > 0 Then
				If vGroupRef.Duration < vHotel.PayByBonusesMLOS Then
					vBonusesLimit = 0;
				EndIf;
			EndIf;
			vRetXDTO.BonusesLimit = vBonusesLimit;
			
			// Extra charges
			FillExtraCargesGuestGroupExternalGroupReservationStatus(pExternalSystemCode, vGroupRef, vHotel, vLanguage, vRetXDTO);
			
		ElsIf pOutputType = "CSV" Then
			If vReservations.Count() = 0 Then
				// Build return string
				vRetStr = """" + vErrorDescription + """" + "," + 
				"""" + Format(vGroupRef.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," +
				"""" + TrimAll(vGroupRef.ExternalCode) + """";
				// Write log event
				WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
				// Return
				Return vRetStr;
			EndIf;
		EndIf;			
		// Do for each document in the group
		vDocsStr = "";
		For Each vReservationsRow In vReservations Do
			vDocRef = vReservationsRow.Reservation;
			vDocRefCustomer = vDocRef.Customer;
			// Fill reservation totals assuming that all sums are in one currency.
			vExtReservationStatusCode = "";
			vExtReservationStatusCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "ReservationStatuses", vDocRef.ReservationStatus);
			If IsBlankString(vExtReservationStatusCode) Then
				vExtReservationStatusCode = TrimAll(vDocRef.ReservationStatus.Description);
			EndIf;
			vReservationStatusDescription = Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vDocRef.ReservationStatus, vLanguage);
			vReservationSum = 0;
			vReservationCurrency = Catalogs.Currencies.EmptyRef();
			vReservationSumBeforeDiscount = 0;
			vReservationExtCurrencyCode = "";
			vReservationSumPresentation = "";
			If vDocRef.Services.Count() > 0 Then
				vReservationCurrency = vDocRef.Services.Get(0).FolioCurrency;
				vReservationExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "Currencies", vReservationCurrency);
				If IsBlankString(vReservationExtCurrencyCode) Then
					vReservationExtCurrencyCode = TrimAll(vReservationCurrency.Description);
				EndIf;
				vReservationSum = vDocRef.Services.Total("Sum") - vDocRef.Services.Total("DiscountSum");
				vReservationSumPresentation = cmFormatSum(vReservationSum, vReservationCurrency, "NZ=");
				vReservationSumBeforeDiscount = vDocRef.Services.Total("Sum");
			EndIf;
			// Get base currency code
			vBaseCurrency = vDocRef.Hotel.BaseCurrency;
			vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocRef.Hotel, pExternalSystemCode, "Currencies", vBaseCurrency);
			If IsBlankString(vExtBaseCurrencyCode) Then
				vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
			EndIf;
			// Get currency rate
			vReservationCurrencyRate = 1;
			If ValueIsFilled(vReservationCurrency) Then
				vReservationCurrencyRate = cmGetCurrencyExchangeRate(vDocRef.Hotel, vReservationCurrency, CurrentSessionDate());
			EndIf;
			// Room type and accommodation type
			vExtRoomTypeCode = "";
			vRoomTypeCode = "";
			vRoomTypeDescription = "";
			FillRoomTypeExternalGroupReservationStatusRow(pExternalSystemCode, vDocRef, vLanguage, vExtRoomTypeCode, vRoomTypeCode, vRoomTypeDescription);
			// Accommodation type
			vExtAccommodationTypeCode = "";
			vAccommodationTypeCode = "";
			vAccommodationTypeDescription = "";
			FillAccommodationTypeExternalGroupReservationStatusRow(pExternalSystemCode, vAccommodationTypeCode, vAccommodationTypeDescription, vDocRef, vExtAccommodationTypeCode, vLanguage);
			
			// Fill reservation first day price
			vFirstDaySum = 0;
			vFirstDaySumCurrency = Undefined;
			vFirstDaySumPresentation = "";
			vFirstDaySumBeforeDiscount = 0;
			vPrices = vDocRef.GetObject().pmGetPrices(True);
			vFirstAccDate = Undefined;
			For Each vPricesRow In vPrices Do
				If Not ValueIsFilled(vFirstAccDate) Then
					vFirstAccDate = vPricesRow.AccountingDate;
					vFirstDaySumCurrency = vPricesRow.FolioCurrency;
				EndIf;
				If vPricesRow.AccountingDate = vFirstAccDate Then
					vFirstDaySum = vFirstDaySum + vPricesRow.Price;
					vFirstDaySumBeforeDiscount = vFirstDaySumBeforeDiscount + vPricesRow.PriceBeforeDiscount;
				Else
					Break;
				EndIf;
			EndDo;
			If vFirstDaySum <> 0 Then
				If vFirstDaySumCurrency <> vCurrency Then
					vFirstDaySum = Round(cmConvertCurrencies(vFirstDaySum, vFirstDaySumCurrency, , vCurrency, , CurrentSessionDate(), vDocRef.Hotel), 2);
					vFirstDaySumBeforeDiscount = Round(cmConvertCurrencies(vFirstDaySumBeforeDiscount, vFirstDaySumCurrency, , vCurrency, , CurrentSessionDate(), vDocRef.Hotel), 2);
				EndIf;
				vFirstDaySumPresentation = cmFormatSum(vFirstDaySum, vCurrency, "NZ=");
			EndIf;
			vFirstDayAmount = vFirstDayAmount + vFirstDaySum;
			vFirstDayAmountBeforeDiscount = vFirstDayAmountBeforeDiscount + vFirstDaySumBeforeDiscount;
			// Zero amount if this reservation is not individual
			If vHideAmount Then
				vReservationSum = 0;
				vReservationSumPresentation = "";
				vReservationSumBeforeDiscount = 0;
				vFirstDaySum = 0;
				vFirstDaySumPresentation = "";
				vFirstDaySumBeforeDiscount = 0;
			EndIf;
			// Build return string
			vDocsStr = vDocsStr + Chars.LF + """" + TrimAll(vDocRef.Number) + """" + "," + """" + TrimAll(vDocRef.ExternalCode) + """" + "," + 
			"""" + TrimAll(vExtReservationStatusCode) + """" + "," + """" + cmRemoveComma(vDocRef.ConfirmationReply) + """" + "," + 
			"""" + TrimAll(vDocRef.Posted) + """" + "," + """" + Format(vDocRef.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," + 
			"""" + TrimAll(vDocRef.ReservationStatus.Code) + """" + "," + """" + cmRemoveComma(vReservationStatusDescription) + """" + "," + 
			Format(vDocRef.RoomQuantity, "ND=10; NFD=0; NZ=; NG=") + "," + Format(vDocRef.NumberOfPersons, "ND=10; NFD=0; NZ=; NG=") + "," + 
			"""" + TrimAll(vExtRoomTypeCode) + """" + "," + """" + TrimAll(vRoomTypeCode) + """" + "," + """" + cmRemoveComma(vRoomTypeDescription) + """" + "," + 
			"""" + TrimAll(vExtAccommodationTypeCode) + """" + "," + """" + TrimAll(vAccommodationTypeCode) + """" + "," + """" + cmRemoveComma(vAccommodationTypeDescription) + """" + "," + 
			"""" + Format(vDocRef.CheckInDate, "DF='dd.MM.yyyy HH:mm'") + """" + "," + Format(vDocRef.Duration, "ND=10; NFD=0; NZ=; NG=") + "," + """" + Format(vDocRef.CheckOutDate, "DF='dd.MM.yyyy HH:mm'") + """" + "," + 
			"""" + TrimAll(vReservationExtCurrencyCode) + """" + "," + """" + TrimAll(vReservationCurrency.Code) + """" + "," + """" + cmRemoveComma(vReservationCurrency.Description) + """" + "," + 
			Format(vReservationSum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
			"""" + StrReplace(vReservationSumPresentation, ",", ".") + """" + "," + 
			Format(vFirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
			"""" + StrReplace(vFirstDaySumPresentation, ",", ".") + """";
			If pOutputType = "XDTO" Then
				vStatusRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatusRow"));
				vStatusRow.IsPosted = vDocRef.Posted;
				vStatusRow.ReservationNumber = TrimAll(vDocRef.Number);
				vStatusRow.ReservationStatus = vExtReservationStatusCode;
				vStatusRow.ReservationStatusCode = TrimAll(vDocRef.ReservationStatus.Code);
				vStatusRow.ReservationStatusDescription = vReservationStatusDescription;
				vStatusRow.ConfirmationReply = Left(TrimAll(vDocRef.ConfirmationReply), 4096);
				vStatusRow.GuestGroup = Format(vDocRef.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=");
				
				// Guest
				FillGuestDataExternalGroupReservationStatusRow(vInteraction, vDocRef, vStatusRow);
				
				If ValueIsFilled(vDocRef.AccommodationType) And vDocRef.AccommodationType.Type = Enums.AccomodationTypes.Room Then
					vStatusRow.RoomQuantity = vDocRef.RoomQuantity;
				Else
					vStatusRow.RoomQuantity = 0;
				EndIf;
				vStatusRow.NumberOfPersons = vDocRef.NumberOfPersons;  
				vStatusRow.GuestAge = vDocRef.GuestAge;
				vStatusRow.Adults = vDocRef.NumberOfAdults; 
				vStatusRow.Children = vDocRef.NumberOfTeenagers + vDocRef.NumberOfChildren + vDocRef.NumberOfInfants;
				vStatusRow.RoomType = vExtRoomTypeCode;
				vStatusRow.RoomTypeCode = vRoomTypeCode;
				vStatusRow.RoomTypeDescription = vRoomTypeDescription;
				vStatusRow.AccommodationType = vExtAccommodationTypeCode;
				vStatusRow.AccommodationTypeCode = vAccommodationTypeCode;
				vStatusRow.AccommodationTypeDescription = vAccommodationTypeDescription;
				vStatusRow.CheckInDate = vDocRef.CheckInDate;
				vStatusRow.Duration = vDocRef.Duration;
				vStatusRow.CheckOutDate = vDocRef.CheckOutDate;
				vStatusRow.Currency = vReservationExtCurrencyCode;
				vStatusRow.CurrencyCode = TrimAll(vReservationCurrency.Code);
				vStatusRow.CurrencyDescription = TrimAll(vReservationCurrency.Description);
				vStatusRow.BaseCurrency = vExtBaseCurrencyCode;
				vStatusRow.CurrencyRate = vReservationCurrencyRate;
				vStatusRow.Sum = vReservationSum;
				vStatusRow.SumPresentation = vReservationSumPresentation;
				vStatusRow.SumBeforeDiscount = vReservationSumBeforeDiscount;
				vStatusRow.FirstDaySum = vFirstDaySum;
				vStatusRow.FirstDaySumPresentation = vFirstDaySumPresentation;
				vStatusRow.FirstDaySumBeforeDiscount = vFirstDaySumBeforeDiscount;
				vStatusRow.PaymentMethodCodesAllowedOnline = vDocRef.RoomRate.PaymentMethodCodesAllowedOnline;
				vExtReservationCode = String(vDocRef.UUID());
				If IsBlankString(vDocRef.ExternalCode) Then
					vDocObj = vDocRef.GetObject();
					vDocObj.ExternalCode = vExtReservationCode;
					vDocObj.Write();
				Else
					vExtReservationCode = TrimAll(vDocRef.ExternalCode);
				EndIf;	
				vStatusRow.UUID = String(vDocRef.UUID());
				vStatusRow.ExtReservationCode = vExtReservationCode;
				vStatusRow.RoomQuotaCode = TrimAll(vDocRef.RoomQuota.Code);
				If ValueIsFilled(vDocRef.RoomRate) Then
					vStatusRow.RoomRateCode = TrimAll(vDocRef.RoomRate.Code);
					vStatusRow.RoomRateDescription = vDocRef.RoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
				EndIf;
				vStatusRow.Room = TrimAll(vDocRef.Room);
				vStatusRow.URL 	= GetURL(vDocRef);
				vStatusRow.Discount = vDocRef.Discount;
				
				// Check if room upgrade is available
				FillUpgradeAvailableExternalGroupReservationStatusRow(vDocRef, vLanguage, vStatusRow);
				// Extra charges
				FillExtraChargesExternalGroupReservationStatusRow(pExternalSystemCode, vDocRef, vHotel, vLanguage, vStatusRow);
				// Extra services
				FillExtraServicesExternalGroupReservationStatusRow(vDocRef, vLanguage, vStatusRow);
				// Prices per day.
				FillPricesPerDateFillExtraServicesExternalGroupReservationStatusRow(vDocRef, vStatusRow);
				// Fill board place
				FillBordPlaceExternalGroupReservationStatusRow(vDocRef, vStatusRow);
				
				vStatusRow.PaymentList = GetPaymentsByReservation(vDocRef);
				vRetXDTO.ExternalReservationStatusRow.Add(vStatusRow);
			EndIf;
		EndDo;
		vFirstDayAmount = Round(vFirstDayAmount, 2);
		vFirstDayAmountPresentation = cmFormatSum(vFirstDayAmount, vCurrency, "NZ=");
		vFirstDayAmountBeforeDiscount = Round(vFirstDayAmountBeforeDiscount, 2);
		// Build return string
		vRetStr = """" + vErrorDescription + """" + "," + 
		"""" + Format(vGroupRef.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," + 
		"""" + TrimAll(vGroupRef.ExternalCode) + """" + "," + 
		"""" + TrimAll(vExtCurrencyCode) + """" + "," + 
		Format(vSum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
		"""" + StrReplace(vSumPresentation, ",", ".") + """" + "," + 
		Format(vFirstDayAmount, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
		"""" + StrReplace(vFirstDayAmountPresentation, ",", ".") + """" + "," + 
		Format(vBalanceAmount, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
		"""" + StrReplace(vBalanceAmountPresentation, ",", ".") + """" + "," + 
		vDocsStr;
		// Write log event
		WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO.FirstDaySum = vFirstDayAmount;
			vRetXDTO.FirstDaySumPresentation = vFirstDayAmountPresentation;
			vRetXDTO.FirstDaySumBeforeDiscount = vFirstDayAmountBeforeDiscount;
			vRetXDTO.HotelName = Catalogs.Hotels.pmGetHotelPrintName(vGroupObj.Owner, vLanguage);
			vRetXDTO.HotelCode = TrimAll(vGroupObj.Owner.Code);
			vRetXDTO.ErrorDescription = "";
			// Cancel fee attributes
			vCancelFeeDate = '00010101';
			vCancelFeeAmount = 0;
			cmGetCancelFeeAttributes(vGroupRef, vRetXDTO.TotalSum, vRetXDTO.FirstDaySum, vCancelFeeDate, vCancelFeeAmount);
			vRetXDTO.CancelFeeDate = vCancelFeeDate;
			vRetXDTO.CancelFeeAmount = vCancelFeeAmount;
			vCancelFeeAmountBeforeDiscount = 0;
			cmGetCancelFeeAttributes(vGroupRef, vRetXDTO.TotalSumBeforeDiscount, vRetXDTO.FirstDaySumBeforeDiscount, vCancelFeeDate, vCancelFeeAmountBeforeDiscount);
			vRetXDTO.CancelFeeAmountBeforeDiscount = vCancelFeeAmountBeforeDiscount;
			// Company	
			If NOT ValueIsFilled(vCompany) Then
				vCompany = vGroupObj.Owner.Company;
			EndIf;
			FillCompanyExternalGroupReservationStatusRow(vCompany, vRetXDTO);
			// Bank account 
			FillBankAccountExternalGroupReservationStatusRow(vCompany, vRetXDTO);
			// Fill Proforma-invoice
			FillProformaInvoiceExternalGroupReservationStatus(vProformaInvoice, vRetXDTO,pExternalSystemCode);
		EndIf;
		// Debug
		If vWriteDebug Then
			vInputParameters = "";
			vXMLWriter = New XMLWriter; 
			vXMLWriter.SetString();
			XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
			vInputParameters = vXMLWriter.Close();
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetExternalGroupReservationStatus", Enums.ExternalSystemEventTypes.Info, , vInputParameters , vMsg, vInteraction.MaxLogLenght);
		EndIf;
		Return vRetXDTO; 
	ElsIf ValueIsFilled(vProformaInvoice) And vProformaInvoice.GetObject() <> Undefined Then
		// Proforma invoice does not need information about group reservation
		// Only the value table pf proforma and amounts to be paid
		// Extra information is added: hotel, customer, contract, company
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
		vRetXDTO.ErrorDescription = "";
		
		vRetXDTO.HotelName = Catalogs.Hotels.pmGetHotelPrintName(vProformaInvoice.Hotel, vLanguage);
		vRetXDTO.HotelCode = TrimAll(vProformaInvoice.Hotel.Code);
		
		// Proforma customer
		FillMainCustomerExternalGroupReservationStatusRow(vProformaInvoice.AccountingCustomer, vRetXDTO);
		// Proforma contract
		If ValueIsFilled(vProformaInvoice.AccountingContract) Then
			vRetXDTO.Contract = TrimR(vProformaInvoice.AccountingContract.Description);
		Else
			vRetXDTO.Contract = "";
		EndIf;
		// Company	
		vCompany = vProformaInvoice.Company;
		FillCompanyExternalGroupReservationStatusRow(vCompany, vRetXDTO);
		// Bank account 
		FillBankAccountExternalGroupReservationStatusRow(vCompany, vRetXDTO);
		
		vExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vProformaInvoice.Hotel, pExternalSystemCode, "Currencies", vProformaInvoice.AccountingCurrency);
		If IsBlankString(vExtCurrencyCode) Then
			vExtCurrencyCode = TrimAll(vProformaInvoice.AccountingCurrency.Description);
		EndIf;
		vRetXDTO.Currency = vExtCurrencyCode;
		vRetXDTO.CurrencyCode = TrimR(vProformaInvoice.AccountingCurrency.Code);
		vRetXDTO.CurrencyDescription = TrimR(vProformaInvoice.AccountingCurrency.Description);
		
		// Fill Proforma-invoice
		FillProformaInvoiceExternalGroupReservationStatus(vProformaInvoice, vRetXDTO); 
		// Debug
		If vWriteDebug Then
			vInputParameters = "";
			vXMLWriter = New XMLWriter; 
			vXMLWriter.SetString();
			XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
			vInputParameters = vXMLWriter.Close();
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetExternalGroupReservationStatus", Enums.ExternalSystemEventTypes.Info, , vInputParameters , vMsg, vInteraction.MaxLogLenght);
		EndIf; 
		Return vRetXDTO;
	Else
		vErrorDescription = cmNStr("en='Guest group was not found by external system code!';ru='Не удалось найти группу по ее коду во внешней системе!';de='Die Gruppe konnte nach ihrem Code im externen System nicht gefunden werden!'", vLanguage);
		// Build return string
		vRetStr = """" + vErrorDescription + """";
		
		If vWriteDebug Then
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetExternalGroupReservationStatus", Enums.ExternalSystemEventTypes.Error, , , vErrorDescription, vInteraction.MaxLogLenght);
		Else
			// Write log event
			WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
		EndIf;	
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
			vRetXDTO.ErrorDescription = vErrorDescription;  
			// Debug
			If vWriteDebug Then
				vInputParameters = "";
				vXMLWriter = New XMLWriter; 
				vXMLWriter.SetString();
				XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
				vInputParameters = vXMLWriter.Close();
				vMsg =  NStr("en = 'End of processing'; de = 'Ende des Ausführung'; ru = 'Конец выполнения'");
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetExternalGroupReservationStatus", Enums.ExternalSystemEventTypes.Info, , vInputParameters , vMsg, vInteraction.MaxLogLenght);
			EndIf;
			
			Return vRetXDTO;
		EndIf;
	EndIf;
EndFunction // cmGetExternalGroupReservationStatus

