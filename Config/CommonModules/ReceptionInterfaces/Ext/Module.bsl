						vContract = vSameCheckOutDateRow.Contract;
						vLastQuota = vSameCheckOutDateRow.Allotment;
						vLastPeriodFrom = vSameCheckOutDateRow.CheckInDate;
						vLastPeriodTo = vSameCheckOutDateRow.CheckOutDate;
					EndIf;
					If vRoomTypesBalances.Find(vSameCheckOutDateRow.RoomType, "RoomType") = Undefined Then
						vNewRow = vRoomTypesBalances.Add();
						vNewRow.RoomType = vSameCheckOutDateRow.RoomType;
						vNewRow.RoomsAvailable = vSameCheckOutDateRow.RoomsRemains;
						vNewRow.BedsAvailable = vSameCheckOutDateRow.BedsRemains;
					EndIf;
				EndDo; // By check-in periods
				vRestrictionsCache.Clear();
				vRoomsAvailable = 0;
				vBedsAvailable = 0;
				If vLastPeriodFrom <> Undefined And vLastPeriodTo <> Undefined And vLastQuota <> Undefined Then
					If Not ValueIsFilled(vRoomRate.Allotment) Or ValueIsFilled(vRoomRate.Allotment) And (vRoomRate.Allotment.IsFolder And vLastQuota.BelongsToItem(vRoomRate.Allotment) Or (Not vRoomRate.Allotment.IsFolder) And vLastQuota = vRoomRate.Allotment) Then
						// Get prices for each suitable template
						vAgeValueTable.FillValues(False, "IsUsed");
						vRoomDiscount = 0;
						If ValueIsFilled(vRoomRate.PriceTagType) Then
							vCheckInPeriodPrices = cmGetCachedPricesForPriceTags(vCheckInHotel, vClientType, BegOfDay(vCheckInDate), BegOfDay(vCheckOutDate), vRoomRate, , vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
						Else
							vCheckInPeriodPrices = cmGetCachedPrices(vCheckInHotel, vClientType, BegOfDay(vCheckInDate), BegOfDay(vCheckOutDate), Catalogs.PriceTags.EmptyRef(), vRoomRate, vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
						EndIf;
						vCurRoomType = Undefined;
						vAmountBeforeDiscount = 0;
						vAmount = 0;
						vFirstDaySum = 0;
						vCurAccommodationTemplate = Undefined;
						For Each vPricesRow In vCheckInPeriodPrices Do
							vCurAccommodationTemplate = vPricesRow.AccommodationTemplate;
							If vCurRoomType <> vPricesRow.RoomType Then
								vAgeValueTable.FillValues(False, "IsUsed");
								vRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
								vRTRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
								vCurRoomType = vPricesRow.RoomType;
								
								// Check if current room type is valid for the current template
								If ValueIsFilled(vCurAccommodationTemplate) Then
									If vCurAccommodationTemplate.RoomTypes.Count() <> 0 And vCurAccommodationTemplate.RoomTypes.Find(vCurRoomType, "RoomType") = Undefined Then
										If Not ValueIsFilled(vCurRoomType) Or ValueIsFilled(vCurRoomType) And Not ValueIsFilled(vCurRoomType.RoomClass) Or 
										   ValueIsFilled(vCurRoomType) And ValueIsFilled(vCurRoomType.RoomClass) And vWrkAccommodationTemplate.RoomTypes.Find(vCurRoomType.RoomClass, "RoomClass") = Undefined Then
											vCurRoomType = Undefined;
											Continue;
										EndIf;
									EndIf;
								EndIf;
								
								// Stop sale
								If vCurRoomType.StopSale Then
									vRemarks = "";
									If cmIsStopInternetSalePeriod(vCurRoomType, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate), vRemarks) Then
										vCurRoomType = Undefined;
										Continue;
									EndIf;
								EndIf;
										
								// Check room rate restrictions
								vRestrictionsCacheRows = vRestrictionsCache.FindRows(New Structure("RoomType, PeriodFrom, PeriodTo", vCurRoomType, BegOfDay(vCheckInDate), BegOfDay(vCheckOutDate)));
								If vRestrictionsCacheRows.Count() > 0 Then
									vRestrictionsCacheRow = vRestrictionsCacheRows.Get(0);
									If vRestrictionsCacheRow.IsRestricted Then
										vCurRoomType = Undefined;
										Continue;
									EndIf;
								Else
									vRestrictionsCacheRow = vRestrictionsCache.Add();
									vRestrictionsCacheRow.RoomType = vCurRoomType;
									vRestrictionsCacheRow.PeriodFrom = BegOfDay(vCheckInDate);
									vRestrictionsCacheRow.PeriodTo = BegOfDay(vCheckOutDate);
									vRestrictionsCacheRow.IsRestricted = False;
									If Not cmCheckRoomRateRestrictions(vHotel, vRoomRate, vCurRoomType, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate), cmCalculateDuration(vRoomRate, cm1SecondShift(vCheckInDate), cm0SecondShift(vCheckOutDate))) Then
										vRestrictionsCacheRow.IsRestricted = True;
										vCurRoomType = Undefined;
										Continue;
									EndIf;
								EndIf;
								
								// Get balances
								vRoomTypesBalancesRow = vRoomTypesBalances.Find(vCurRoomType, "RoomType");
								If vRoomTypesBalancesRow = Undefined Then
									vCurRoomType = Undefined;
									Continue;
								Else
									vRoomsAvailable = vRoomTypesBalancesRow.RoomsAvailable;
									vBedsAvailable = vRoomTypesBalancesRow.BedsAvailable;
								EndIf;
								
								// Check room type filter
								If ValueIsFilled(vRoomType) Then
									If vRoomType.IsFolder Then
										If Not vCurRoomType.BelongsToItem(vRoomType) Then
											vCurRoomType = Undefined;
											Continue;
										EndIf;
									Else
										If vCurRoomType <> vRoomType Then
											vCurRoomType = Undefined;
											Continue;
										EndIf;
									EndIf;
								EndIf;
								
								vRetRoomTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomType"));
								vRetRoomTypeRow.Code = TrimR(vCurRoomType.Code);
								vRetRoomTypeRow.Description = TrimR(vCurRoomType.Description);
							Else
								If ValueIsFilled(vCurAccommodationTemplate) And vCurAccommodationTemplate <> vPricesRow.AccommodationTemplate Then
									Break;
								EndIf;
							EndIf;
							
							vCurAccommodationType = vPricesRow.AccommodationType;
							
							vRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
							vRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
							vRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
							vRetAccTypeRow.Age = 0;
							For Each vAgeRow In vAgeValueTable Do
								If Not vAgeRow.IsUsed And vAgeRow.Age > vCurAccommodationType.AllowedClientAgeFrom And vAgeRow.Age < vCurAccommodationType.AllowedClientAgeTo Then
									vRetAccTypeRow.Age = vAgeRow.Age;
									vAgeRow.IsUsed = True;
									Break;
								EndIf;
							EndDo;
							vRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
							vRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
							
							vAccTypeCurrency = vPricesRow.Currency;
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vRetAccTypeRow.AmountBeforeDiscount = Round(?(vPricesRow.Amount = Undefined, 0, (vPricesRow.Amount * 100) / (100 - vRoomRate.OnlineDiscount)), 2);
								vRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
							Else
								vRetAccTypeRow.AmountBeforeDiscount = ?(vPricesRow.AmountBeforeDiscount = Undefined, 0, vPricesRow.AmountBeforeDiscount);
								vRetAccTypeRow.Discount = vRoomDiscount;    
							EndIf;
							vRetAccTypeRow.Amount = ?(vPricesRow.Amount = Undefined, 0, vPricesRow.Amount);
							vRetAccTypeRow.AmountPresentation = cmFormatSum(?(vPricesRow.Amount = Undefined, 0, vPricesRow.Amount), vAccTypeCurrency, "NZ=");
							vRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
							If IsBlankString(vRetAccTypeRow.Currency) Then
								vRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
							EndIf;
							If ValueIsFilled(vAccTypeCurrency) Then
								vRetAccTypeRow.CurrencyCode = TrimAll(vPricesRow.CurrencyCode);
								vRetAccTypeRow.CurrencyDescription = TrimAll(vPricesRow.CurrencyDescription);
							Else
								vRetAccTypeRow.CurrencyCode = "";
								vRetAccTypeRow.CurrencyDescription = "";
							EndIf;            	
							
							vRetAccTypesList.AccommodationType.Add(vRetAccTypeRow);
							
							vRTRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
							vRTRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
							vRTRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
							vRTRetAccTypeRow.Age = vRetAccTypeRow.Age;
							vRTRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
							vRTRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
							
							vAccTypeCurrency = vPricesRow.Currency;
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vRTRetAccTypeRow.AmountBeforeDiscount = Round(?(vPricesRow.Amount = Undefined, 0, (vPricesRow.Amount * 100) / (100 - vRoomRate.OnlineDiscount)), 2);
								vRTRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
							Else
								vRTRetAccTypeRow.AmountBeforeDiscount = ?(vPricesRow.AmountBeforeDiscount = Undefined, 0, vPricesRow.AmountBeforeDiscount);
								vRTRetAccTypeRow.Discount = vRoomDiscount; 
							EndIf;
							vRTRetAccTypeRow.Amount = ?(vPricesRow.Amount = Undefined, 0, vPricesRow.Amount);
							vRTRetAccTypeRow.AmountPresentation = cmFormatSum(?(vPricesRow.Amount = Undefined, 0, vPricesRow.Amount), vAccTypeCurrency, "NZ=");
							vRTRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
							If IsBlankString(vRTRetAccTypeRow.Currency) Then
								vRTRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
							EndIf;
							If ValueIsFilled(vAccTypeCurrency) Then
								vRTRetAccTypeRow.CurrencyCode = TrimAll(vPricesRow.CurrencyCode);
								vRTRetAccTypeRow.CurrencyDescription = TrimAll(vPricesRow.CurrencyDescription);
							Else
								vRTRetAccTypeRow.CurrencyCode = "";
								vRTRetAccTypeRow.CurrencyDescription = "";
							EndIf;            	
							
							vRTRetAccTypesList.AccommodationType.Add(vRTRetAccTypeRow);
							
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vAmountBeforeDiscount = vAmountBeforeDiscount + Round(?(vPricesRow.Amount = Undefined, 0, (vPricesRow.Amount * 100) / (100 - vRoomRate.OnlineDiscount)), 2);
							Else
								vAmountBeforeDiscount = vAmountBeforeDiscount + ?(vPricesRow.AmountBeforeDiscount = Undefined, 0, vPricesRow.AmountBeforeDiscount);	
							EndIF;
							vAmount = vAmount + ?(vPricesRow.Amount = Undefined, 0, vPricesRow.Amount);
							vFirstDaySum = vFirstDaySum + ?(vPricesRow.FirstDaySum = Undefined, 0, vPricesRow.FirstDaySum);
							If ((vCheckInPeriodPrices.IndexOf(vPricesRow) + 1) = vCheckInPeriodPrices.Count()) 
								Or vCheckInPeriodPrices[vCheckInPeriodPrices.IndexOf(vPricesRow)+1].RoomType <> vPricesRow.RoomType Then
								vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesByCheckInPeriodsRow"));
								vRetRow.Hotel = cmGetObjectExternalSystemCodeByRef(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vCheckInHotel);
								vRetRow.RoomType = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "RoomTypes", vCurRoomType);
								vRetRow.RoomTypeCode = TrimAll(vPricesRow.RoomTypeCode);
								vRetRow.RoomTypeDescription = TrimAll(vPricesRow.RoomTypeDescription);
								vRetRow.RoomTypePictureLink = TrimAll(vPricesRow.RoomTypePictureLink);
								vRetRow.RoomTypeInfoLink = TrimAll(vPricesRow.RoomTypeInfoLink);
								vRetRow.RoomRate = cmGetObjectExternalSystemCodeByRef(vCheckInHotel, pExternalSystemCode, "RoomRates", vRoomRate);
								vRetRow.RoomRateCode = TrimAll(vPricesRow.RoomRateCode);
								vRetRow.RoomRateDescription = TrimAll(vPricesRow.RoomRateDescription);
								vRetRow.Currency = vRetAccTypeRow.Currency;
								vRetRow.CurrencyCode = vPricesRow.CurrencyCode;
								vRetRow.CurrencyDescription = vPricesRow.CurrencyDescription;
								vRetRow.FirstDaySum = vFirstDaySum;
								vRetRow.AmountBeforeDiscount = Round(vAmountBeforeDiscount, 2);
								If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then 
									vRetRow.Discount = vRoomRate.OnlineDiscount;	
								Else
									vRetRow.Discount = vRoomDiscount;
								EndIf;
								vRetRow.Amount = Round(vAmount , 2);
								vRetRow.AmountPresentation = cmFormatSum(vAmount, vPricesRow.Currency, "NZ=");
								
								vRetRow.LimitedRoomsText = "";
								If vCurRoomType.LimitedRooms > 0 And vRoomsAvailable > 0 And vRoomsAvailable <= vCurRoomType.LimitedRooms Then
									If vRoomsAvailable = 1 Then
										vRetRow.LimitedRoomsText = cmNStr("en='Only ';ru='Остался только ';de='Übrig nur '", vLanguage) + Format(vRoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' room left';ru=' номер';de=' Zimmer(n)'", vLanguage);
									ElsIf vRoomsAvailable >= 2 And vRoomsAvailable < 5 Then
										vRetRow.LimitedRoomsText = cmNStr("en='Only ';ru='Осталось только ';de='Übrig nur '", vLanguage) + Format(vRoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' rooms left';ru=' номера';de=' Zimmer(n)'", vLanguage);
									Else
										vRetRow.LimitedRoomsText = cmNStr("en='Only ';ru='Осталось только ';de='Übrig nur '", vLanguage) + Format(vRoomsAvailable, "ND=10; NFD=0; NG=") + cmNStr("en=' rooms left';ru=' номеров';de=' Zimmer(n)'", vLanguage);
									EndIf;
								EndIf;
								
								vRetRow.RoomsRemains = vRoomsAvailable;
								vRetRow.BedsRemains = vBedsAvailable;
								vRetRow.Allotment = vAllotmentCode;
								vRetRow.AllotmentDescription = vAllotmentDescription;
								vRetRow.CheckInDate = vCheckInDate;
								vRetRow.Duration = vDuration;
								vRetRow.CheckOutDate = vCheckOutDate;
								If ValueIsFilled(vRoomRate) Then
									vRetRow.ReservationConditionsShort = Left(cmNStr(vRoomRate.ReservationConditionsShort, vLanguage), 4096);
									vRetRow.ReservationConditionsOnline = Left(cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage), 4096);
									vRetRow.PaymentMethodCodesAllowedOnline = Left(TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline), 4096);
								Else
									vRetRow.ReservationConditionsShort = "";
									vRetRow.ReservationConditionsOnline = "";
									vRetRow.PaymentMethodCodesAllowedOnline = "";
								EndIf;
								vRetRow.AccommodationTypesList = vRetAccTypesList;
								
								If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
									vAccommodationTypesByRoomTypes.Add(vCurRoomType);
									vRetRoomTypeRow.AccommodationTypesList = vRTRetAccTypesList;
									vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
								EndIf;
								
								vRetStr = vRetStr + """" + vRetRow.Hotel + """" + "," + """" + vRetRow.RoomType + """" + "," + 
								"""" + TrimAll(vCurAccommodationTemplate.Code) + """" + "," + 
								Format(vRetRow.RoomsRemains, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + Format(vRetRow.BedsRemains, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
								"""" + vRetRow.Currency + """" + "," + Format(vRetRow.FirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + Format(vRetRow.Amount, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
								"""" + vRetRow.RoomTypeCode + """" + "," + """" + cmRemoveComma(vRetRow.RoomTypeDescription) + """" + "," + 
								"""" + TrimAll(vRetAccTypeRow.Code) + """" + "," + """" + cmRemoveComma(TrimAll(vRetAccTypeRow.Description)) + """" + "," + 
								"""" + vRetRow.RoomRateCode + """" + "," + """" + cmRemoveComma(vRetRow.RoomRateDescription) + """" + "," + 
								"""" + vRetRow.CurrencyCode + """" + "," + """" + cmRemoveComma(vRetRow.CurrencyDescription) + """" + "," + 
								"""" + cmRemoveComma(vRetRow.AmountPresentation) + """" + "," + 
								"""" + cmRemoveComma(vRetRow.RoomTypePictureLink) + """" + "," + """" + cmRemoveComma(vRetRow.RoomTypeInfoLink) + """" + Chars.LF;
								
								vAvailableRoomTypesByCheckInPeriodsRows.AvailableRoomTypesByCheckInPeriodsRow.Add(vRetRow);
								
								vAmountBeforeDiscount = 0;
								vAmount = 0;
								vFirstDaySum = 0;
							EndIf;
						EndDo;
					EndIf;
				EndIf;
			EndIf; // Check-in periods are available
		EndDo; // By room rates
		If vRetAccTypesRows <> Undefined Then
			vRetXDTO.AccommodationTypes = vRetAccTypesRows;
		EndIf;
		If vAvailableRoomTypesByCheckInPeriodsRows <> Undefined Then
			vRetXDTO.AvailableRoomTypesByCheckInPeriodsRows = vAvailableRoomTypesByCheckInPeriodsRows;
		Else
			vRetXDTO.AvailableRoomTypesByCheckInPeriodsRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesByCheckInPeriodsRows"));
		EndIf;
	Else
		WriteLogEvent(NStr("en='Get available room types';ru='Получить остатки свободных номеров';de='Restbestände an freien Zimmern erhalten'"), EventLogLevel.Information, , , "PROBE DOC IS USED"); 
		
		// Probe document object to calculate prices
		vProbeResObj = Documents.Reservation.CreateDocument();
		vProbeResObj.Hotel = vHotel;
		vProbeResObj.pmFillAttributesWithDefaultValues(True);
		
		vPriceCalculationDate = CurrentSessionDate();
		
		vRetStr = "";
		vRetAccTypesRows = Undefined;
		For Each vRoomRateItem In vRoomRates Do
			vRoomRate = vRoomRateItem.Value;
			// Check room rate is valid period
			If ValueIsFilled(vRoomRate.DateValidFrom) Or ValueIsFilled(vRoomRate.DateValidTo) Then
				If ValueIsFilled(vRoomRate.DateValidFrom) And pPeriodFrom < vRoomRate.DateValidFrom Then
					Continue;
				EndIf;
				If ValueIsFilled(vRoomRate.DateValidTo) And pPeriodTo > EndOfDay(vRoomRate.DateValidTo) Then
					Continue;
				EndIf;
			EndIf;
			vSavChildrenAgesStruct = vChildrenAgesStruct;
			vSavDiscountType = vDiscountType;
			
			// Clear discounts from probe object
			vProbeResObj.DiscountType = Catalogs.DiscountTypes.EmptyRef();
			vProbeResObj.DiscountConfirmationText = "";
			vProbeResObj.DiscountServiceGroup = Catalogs.ServiceGroups.EmptyRef();
			vProbeResObj.Discount = 0;
			
			vProbeResObj.SourceOfBusiness = vSourceOfBusiness;
			vProbeResObj.MarketingCode = vMarketingCode;
			
			// Get room types balances table
			vRoomTypeBalances = cmGetRoomTypeBalancesTable(vRoomTypes, True, vHotel, pPeriodFrom, pPeriodTo, vClientType, vCustomer, vContract, vDiscountType, vExtHotelCode, vLanguage, pExternalSystemCode, , vRoomRate, , vAdultsQuantity, vKidsQuantity, vAgeArray, vProbeResObj, , , , vReservationRef);
			
			// Build XDTO object
			If vRetAccTypesRows = Undefined Then
				vRetAccTypesRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypes"));
			EndIf;
			vRetRoomTypeRow = Undefined;
			vRetAccTypesList = Undefined;
			vCurRoomType = Undefined;
			For Each vRoomTypeBalancesRow In vRoomTypeBalances Do
				If vCurRoomType <> vRoomTypeBalancesRow.RoomType Then
					If vRetRoomTypeRow <> Undefined Then
						vRetRoomTypeRow.AccommodationTypesList = vRetAccTypesList;
						If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
							vAccommodationTypesByRoomTypes.Add(vCurRoomType);
							vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
						EndIf;
					EndIf;
					
					vCurRoomType = vRoomTypeBalancesRow.RoomType;
					
					vRetRoomTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomType"));
					vRetRoomTypeRow.Code = TrimR(vCurRoomType.Code);
					vRetRoomTypeRow.Description = TrimR(vCurRoomType.Description);
					
					vRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
				EndIf;
				
				vCurAccommodationType = vRoomTypeBalancesRow.AccommodationType;
				
				vRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
				vRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
				vRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
				vRetAccTypeRow.Age = vRoomTypeBalancesRow.Age;
				vRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
				vRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
				
				vAccTypeCurrency = vRoomTypeBalancesRow.Currency;
				If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
					vRetAccTypeRow.AmountBeforeDiscount = Round(?(vRoomTypeBalancesRow.Amount = Undefined, 0, (vRoomTypeBalancesRow.Amount * 100)/(100 - vRoomRate.OnlineDiscount)), 2);    
					vRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
				Else
					vRetAccTypeRow.AmountBeforeDiscount = ?(vRoomTypeBalancesRow.AmountBeforeDiscount = Undefined, 0, vRoomTypeBalancesRow.AmountBeforeDiscount);
					vRetAccTypeRow.Discount = vProbeResObj.Discount;       
				EndIf;
				vRetAccTypeRow.Amount = ?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount);
				vRetAccTypeRow.AmountPresentation = cmFormatSum(?(vRoomTypeBalancesRow.Amount = Undefined, 0, vRoomTypeBalancesRow.Amount), vAccTypeCurrency, "NZ=");
				vRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
				If IsBlankString(vRetAccTypeRow.Currency) Then
					vRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
				EndIf;
				If ValueIsFilled(vAccTypeCurrency) Then
					vRetAccTypeRow.CurrencyCode = TrimAll(vAccTypeCurrency.Code);
					vRetAccTypeRow.CurrencyDescription = TrimAll(vAccTypeCurrency.Description);
				Else
					vRetAccTypeRow.CurrencyCode = "";
					vRetAccTypeRow.CurrencyDescription = "";
				EndIf;
				
				vRetAccTypesList.AccommodationType.Add(vRetAccTypeRow);
			EndDo;
			If vRetAccTypesList <> Undefined Then
				If vRetRoomTypeRow <> Undefined Then
					vRetRoomTypeRow.AccommodationTypesList = vRetAccTypesList;
					If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
						vAccommodationTypesByRoomTypes.Add(vCurRoomType);
						vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
					EndIf;
				EndIf;
			EndIf;
			If ValueIsFilled(vRoomType) And vRetAccTypesList = Undefined Then
				// Get active special offers
				If ValueIsFilled(vHotel) And (vHotel.TeenagersMaxAge <> 0 Or vHotel.ChildrenMaxAge <> 0 Or vHotel.InfantsMaxAge <> 0) Then
