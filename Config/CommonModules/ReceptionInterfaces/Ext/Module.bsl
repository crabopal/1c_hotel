							EndIf;
							If vMultipleAdvanceSectionsMode And pSum <> 0 Then
								For Each vPSRow In vPaymentObj.PaymentSections Do
									vPSRow.Sum = 0;
								EndDo;
								
								vCurSum = pSum;
