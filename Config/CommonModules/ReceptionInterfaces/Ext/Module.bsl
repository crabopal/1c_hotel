// -----------------------------------------------------------------------------
// Finds client by his social network login
// -----------------------------------------------------------------------------
Function cmGetAuthorizedClient(pLogin) Export
	vAuthorizedClient = Undefined;
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	ClientSocialNetworkLogins.Client,
	|	ClientSocialNetworkLogins.Login AS Login
	|FROM
	|	InformationRegister.ClientSocialNetworkLogins AS ClientSocialNetworkLogins
	|WHERE
	|	ClientSocialNetworkLogins.Login = &qLogin";
	vQry.SetParameter("qLogin", TrimAll(pLogin));
	vClients = vQry.Execute().Unload();
	If vClients.Count() = 1 Then
		vAuthorizedClient = vClients.Get(0).Client;
	EndIf;
	Return vAuthorizedClient;
EndFunction // cmGetAuthorizedClient

// -----------------------------------------------------------------------------
// Saves client social network login
// -----------------------------------------------------------------------------
Procedure cmSaveClientSocialNetworkLogin(pClient, pLogin) Export
	If ValueIsFilled(pClient) And Not IsBlankString(pLogin) Then
		vRcdMgr = InformationRegisters.ClientSocialNetworkLogins.CreateRecordManager();
		vRcdMgr.Client = pClient;
		vRcdMgr.Login = pLogin;
		vRcdMgr.Write(True);
	EndIf;
EndProcedure // cmSaveClientSocialNetworkLogin

// -----------------------------------------------------------------------------
// Checks if login received is social network login
// -----------------------------------------------------------------------------
Function cmCheckIfLoginIsSocialNetworkLogin(pLogin) Export
	If Find(pLogin, "vk.com") > 0 Or Find(pLogin, "facebook.com") > 0 Or Find(pLogin, "ok.ru") > 0 Then
		Return True;
	Else
		Return False;
	EndIf;
EndFunction // cmCheckIfLoginIsSocialNetworkLogin 	

// -----------------------------------------------------------------------------
// Description: Returns list of room type balances
// -----------------------------------------------------------------------------
Function cmGetAvailableRoomTypes(pHotelCode, pRoomRateCode, pClientTypeCode, pRoomTypeCode, pRoomQuotaCode, pPeriodFrom, pPeriodTo, pExternalSystemCode, pLanguageCode = "RU", pGuestsQuantity, pEMail, pPhone, pLogin, pPromoCode, pOutputType = "XDTO", pExtraParams = Undefined) Export
	// Serialize guests quantity as XML
	vGuestsQuantityXML = "";
	If pGuestsQuantity <> Undefined Then
		If TypeOf(pGuestsQuantity) = Type("Structure") Then
			vGuestsQuantityXML = "<Adults>" + Format(pGuestsQuantity.Adults.Quantity, "NFD=0; NZ=; NG=") + "</Adults>" + "<Kids>" + Format(pGuestsQuantity.Kids.Quantity, "NFD=0; NZ=; NG=") + "</Kids>";
		Else
			vXMLWriter = New XMLWriter; 
		    vXMLWriter.SetString();
		    XDTOFactory.WriteXML(vXMLWriter, pGuestsQuantity);
		    vGuestsQuantityXML = vXMLWriter.Close();
		EndIf;
	EndIf;
	
	// Serialize extra parameters as XML string
	If pExtraParams = Undefined Then
		vExtraParamsXML = "";
	Else
		vExtraParamsXML = "";
		vXMLWriter = New XMLWriter; 
	    vXMLWriter.SetString();
	    XDTOFactory.WriteXML(vXMLWriter, pExtraParams);
	    vExtraParamsXML = vXMLWriter.Close();
	EndIf;
	
	vInputParameters = NStr("en='Output type: ';ru='Формат выдачи: ';de='Ausgabetyp: '") + pOutputType + Chars.LF + 
				  NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
				  NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
				  NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
				  NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode + Chars.LF + 
				  NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
				  NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
				  NStr("en='Allotment code: ';ru='Код квоты: ';de='Allotmentcode: '") + pRoomQuotaCode + Chars.LF + 
				  NStr("en='E-Mail: '; ru='E-Mail: '") + pEMail + Chars.LF + 
				  NStr("en='Phone number: ';ru='Номер телефона: ';de='Telefonnummer: '") + pPhone + Chars.LF + 
				  NStr("en='Login: ';ru='Логин: ';de='Login: '") + pLogin + Chars.LF + 
				  NStr("en='Promotion code: ';ru='Промокод: ';de='Promo Code: '") + pPromoCode + Chars.LF +
				  NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
				  NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo + Chars.LF + 
				  NStr("en='Guest quantity: '; ru='Количество гостей: '") + Chars.LF + vGuestsQuantityXML + Chars.LF + 
				  NStr("en='Extra params: ';ru='Доп. параметры: ';de='Extra params: '") + Chars.LF + vExtraParamsXML;
				  
	// Do not allow requests in the past			  
	If Not IsBlankString(pExternalSystemCode) And BegOfDay(pPeriodFrom) < BegOfDay(CurrentSessionDate()) Then
		Raise NStr("en='Check-in date is in the past!'; ru='Дата заезда указана в прошлом!'; de='Das Anreisedatum liegt in der Vergangenheit!'");
	EndIf;
	If pPeriodFrom > pPeriodTo Then
		Raise NStr("en = 'Check-in date cannot be more than check-out date!'; de = 'Das Check-in-Datum darf nicht länger als das Check-out-Datum sein!'; ru = 'Дата заезда не может быть больше даты выезда!'");
	EndIf;
	If BegOfDay(pPeriodTo) >= Date(2100,1,1) Then
		 Raise NStr("en = 'Check that the end date is correct!'; de = 'Überprüfen Sie, ob das Enddatum korrekt ist!'; ru = 'Проверьте правильность указания даты окончания!'");
	EndIf;
	
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	
	// Debug
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmGetAvailableRoomTypes", Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg, vInteraction.MaxLogLenght);
	Else
		// Log all request parameters
		WriteLogEvent(NStr("en='Get available room types';ru='Получить остатки свободных номеров';de='Restbestände an freien Zimmern erhalten'"), EventLogLevel.Information, , , vInputParameters);
	EndIf;
	
	vIsByCheckInPeriods = False;
	If ValueIsFilled(vInteraction) Then
		vIsByCheckInPeriods = vInteraction.IsByCheckInPeriods;	
	EndIf;	
	
	// Initialize return XDTO object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypes"));
	
	// Parse extra parameters
	vExtraParams = New Structure("Employee, Contract, Customer, IsCustomer, ProfileCode");
	If pExtraParams <> Undefined Then	
		Try
			If pExtraParams.Employee <> Undefined Then
				vExtraParams.Employee = pExtraParams.Employee; 
			EndIf;
		Except
		EndTry;
		Try
			If pExtraParams.Contract <> Undefined Then
				vExtraParams.Contract = pExtraParams.Contract; 
			EndIf;
		Except
		EndTry;
		Try
			If pExtraParams.Customer <> Undefined Then
				vExtraParams.Customer = pExtraParams.Customer; 
			EndIf;
		Except
		EndTry;
		Try
			If pExtraParams.IsCustomer <> Undefined Then
				vExtraParams.IsCustomer = pExtraParams.IsCustomer; 
			EndIf;
		Except
		EndTry;
		Try
			If pExtraParams.ProfileCode <> Undefined Then
				vExtraParams.ProfileCode = pExtraParams.ProfileCode; 
			EndIf;
		Except
		EndTry;
	EndIf;
	
	// Retrieve language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	
	vExtHotelCode = cmGetObjectExternalSystemCodeByRef(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vHotel);
	
	// Check if guest is authorized client
	vAuthorizedClient = Undefined;
	vClientIsAuthorized = False;
	If Not IsBlankString(pLogin) Then
		If cmCheckIfLoginIsSocialNetworkLogin(pLogin) Then
			vClientIsAuthorized = True;
			// Try to save client login and get client data back
			vAuthorizedClient = cmGetAuthorizedClient(pLogin);
			If ValueIsFilled(vAuthorizedClient) Then
				vAuthorizedClientXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "WriteExternalClient"));
				vAuthorizedClientXDTO.ClientCode = TrimAll(vAuthorizedClient.Code);
				vAuthorizedClientXDTO.ClientLastName = TrimAll(vAuthorizedClient.LastName);
				vAuthorizedClientXDTO.ClientFirstName = TrimAll(vAuthorizedClient.FirstName);
				vAuthorizedClientXDTO.ClientSecondName = TrimAll(vAuthorizedClient.SecondName);
				vAuthorizedClientXDTO.ClientSex = Left(TrimAll(vAuthorizedClient.Sex), 1);
				vAuthorizedClientXDTO.ClientBirthDate = vAuthorizedClient.DateOfBirth;
				vAuthorizedClientXDTO.ClientCitizenship = "";
				If ValueIsFilled(vAuthorizedClient.Citizenship) Then
					vAuthorizedClientXDTO.ClientCitizenship = TrimAll(vAuthorizedClient.Citizenship.ISOCode3);
				EndIf;
				vAuthorizedClientXDTO.ClientPhone = TrimAll(vAuthorizedClient.Phone);
				vAuthorizedClientXDTO.ClientFax = TrimAll(vAuthorizedClient.Fax);
				vAuthorizedClientXDTO.ClientEMail = TrimAll(vAuthorizedClient.EMail);
				vAuthorizedClientXDTO.ClientSendSMS = Not vAuthorizedClient.NoSMSDelivery;
				vRetXDTO.AuthorizedClient = vAuthorizedClientXDTO;
			EndIf;
		EndIf;
	EndIf;
	
	// Other request parameters
	vClient = Undefined;
	If vExtraParams <> Undefined And vExtraParams.IsCustomer = False and Not IsBlankString(vExtraParams.ProfileCode) Then
		vClient = Catalogs.Clients.FindByCode(vExtraParams.ProfileCode);
		If ValueIsFilled(vClient) Then
			vClientIsAuthorized = True;
			vAuthorizedClient = vClient;
			vAuthorizedClientXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "WriteExternalClient"));
			vAuthorizedClientXDTO.ClientCode = TrimAll(vAuthorizedClient.Code);
			vAuthorizedClientXDTO.ClientLastName = TrimAll(vAuthorizedClient.LastName);
			vAuthorizedClientXDTO.ClientFirstName = TrimAll(vAuthorizedClient.FirstName);
			vAuthorizedClientXDTO.ClientSecondName = TrimAll(vAuthorizedClient.SecondName);
			vAuthorizedClientXDTO.ClientSex = Left(TrimAll(vAuthorizedClient.Sex), 1);
			vAuthorizedClientXDTO.ClientBirthDate = vAuthorizedClient.DateOfBirth;
			vAuthorizedClientXDTO.ClientCitizenship = "";
			If ValueIsFilled(vAuthorizedClient.Citizenship) Then
				vAuthorizedClientXDTO.ClientCitizenship = TrimAll(vAuthorizedClient.Citizenship.ISOCode3);
			EndIf;
			vAuthorizedClientXDTO.ClientPhone = TrimAll(vAuthorizedClient.Phone);
			vAuthorizedClientXDTO.ClientFax = TrimAll(vAuthorizedClient.Fax);
			vAuthorizedClientXDTO.ClientEMail = TrimAll(vAuthorizedClient.EMail);
			vAuthorizedClientXDTO.ClientSendSMS = Not vAuthorizedClient.NoSMSDelivery;
			vRetXDTO.AuthorizedClient = vAuthorizedClientXDTO;
		EndIf;
	EndIf;
	
	// Room rates valid for this request 
	vRoomRates = New ValueList();
	vCRSRoomRates = New ValueList();
	vOnlineRoomRates = New ValueList();
	vEmployeeRoomRates = New ValueList();
	vCustomerRoomRates = New ValueList();
	vUseCustomerRoomRates = False;
	
	// Check extra parameters
	vEmployee = Catalogs.Employees.EmptyRef();
	vCustomer = Catalogs.Customers.EmptyRef();
	vContract = Catalogs.Contracts.EmptyRef();
	vRoomQuota = Catalogs.RoomQuotas.EmptyRef();
	vRoomRate = Catalogs.RoomRates.EmptyRef();
	vClientType = Catalogs.ClientTypes.EmptyRef();
	
	vUseOnlineRoomRates = False;
	If Not IsBlankString(pRoomRateCode) Then
		// Use parameter room rate only
		vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode);
		If ValueIsFilled(vRoomRate) Then
			vRoomRates.Clear();
			vRoomRates.Add(vRoomRate);
		EndIf;
	Else
		If Not IsBlankString(pLogin) And Not vClientIsAuthorized Then
			vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
			If vCustomerStruct <> Undefined Then
				vCustomer = vCustomerStruct.Customer;
				vContract = vCustomerStruct.Contract;
				If ValueIsFilled(vContract) And Not vContract.DeletionMark Then
					If ValueIsFilled(vCustomer) And Not vCustomer.DeletionMark Then
						// Room rate
						If vContract.RoomRates.Count() > 0 Then
							vRoomRates.LoadValues(vContract.RoomRates.UnloadColumn("RoomRate"));
							If ValueIsFilled(vContract.RoomRate) Then
								vRoomRate = vContract.RoomRate;
								vFindedRR = vRoomRates.FindByValue(vRoomRate);
								If vFindedRR = Undefined Then
									vRoomRates.Add(vRoomRate);
								EndIf;
							EndIf;
							r = 0;
							While r < vRoomRates.Count() Do
								If Not ValueIsFilled(vRoomRates.Get(r).Value) Then
									vRoomRates.Delete(r);
								Else
									r = r + 1;
								EndIf;
							EndDo;
						EndIf;
						// Client type
						If ValueIsFilled(vContract.ClientType) Then
							vClientType = vContract.ClientType;
						EndIf;
					EndIf;
				ElsIf ValueIsFilled(vCustomer) And Not vCustomer.DeletionMark Then
					// Room rate
					If vCustomer.RoomRates.Count() > 0 Then
						vRoomRates.LoadValues(vCustomer.RoomRates.UnloadColumn("RoomRate"));
						If ValueIsFilled(vCustomer.RoomRate) Then
							vRoomRate = vCustomer.RoomRate;
							vFindedRR = vRoomRates.FindByValue(vRoomRate);
							If vFindedRR = Undefined Then
								vRoomRates.Add(vRoomRate);
							EndIf;
						EndIf;
					EndIf;
					// Client type
					If ValueIsFilled(vCustomer.ClientType) Then
						vClientType = vCustomer.ClientType;
					EndIf;
				Else
					vCustomer = Undefined;
					vContract = Undefined;
				EndIf;
			EndIf;
		Else
			If vExtraParams <> Undefined Then	
				If vExtraParams.Employee <> Undefined And Not IsBlankString(vExtraParams.Employee) Then
					vEmployee = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Employees", TrimR(vExtraParams.Employee));
					If Not ValueIsFilled(vEmployee) Then
						vEmployee = cmGetObjectRefByExternalSystemCode(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Employees", TrimR(vExtraParams.Employee));
					EndIf;
					If ValueIsFilled(vEmployee) Then
						SessionParameters.CurrentUser = vEmployee;
					EndIf;
				EndIf;
				If vExtraParams.Contract <> Undefined And Not IsBlankString(vExtraParams.Contract) Then
					vContract = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Contracts", TrimR(vExtraParams.Contract));
				EndIf;
						
				If vExtraParams.Customer <> Undefined And Not IsBlankString(vExtraParams.Customer) Then
					vCustomer = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Customers", TrimR(vExtraParams.Customer));
				ElsIf vExtraParams.IsCustomer = True and Not IsBlankString(vExtraParams.ProfileCode) Then
					vCustomer = Catalogs.Customers.FindByCode(vExtraParams.ProfileCode);
				EndIf;
				
				If ValueIsFilled(vCustomer) And ValueIsFilled(vContract) Then
					If vContract.Owner <> vCustomer Then
						vCustomer = vContract.Owner;
					EndIf;
				EndIf;
				If ValueIsFilled(vEmployee) Then
					// Create list of room rates allowed to this employee
					vEmployeeRoomRates = cmGetAllowedRoomRates(pPeriodFrom, pPeriodTo, CurrentSessionDate(), Undefined, vHotel, ?(Upper(TrimAll(pExternalSystemCode)) = "HOTELBI" Or Upper(TrimAll(pExternalSystemCode)) = "BITRIX24", True, False));
				Else
					If Upper(TrimAll(pExternalSystemCode)) = "HOTELBI" Or Upper(TrimAll(pExternalSystemCode)) = "BITRIX24" Then
						// Create list of Central Reservation System room rates
						vOnlineRoomRates = cmGetHotelBIRoomRates(vHotel, pPeriodFrom, pPeriodTo, False);
					Else
						// Create list of online room rates
						vOnlineRoomRates = cmGetOnlineRoomRates(vHotel, pPeriodFrom, pPeriodTo, vClientIsAuthorized);
					EndIf;
				EndIf;
				If ValueIsFilled(vContract) And Not vContract.DeletionMark Then
					If ValueIsFilled(vCustomer) And Not vCustomer.DeletionMark Then
						If vContract.RoomRates.Count() > 0 Then
							vUseCustomerRoomRates = True;
							vCustomerRoomRates.LoadValues(vContract.RoomRates.UnloadColumn("RoomRate"));
							If ValueIsFilled(vContract.RoomRate) Then
								vRoomRate = vContract.RoomRate;
								vFindedRR = vCustomerRoomRates.FindByValue(vRoomRate);
								If vFindedRR = Undefined Then
									vCustomerRoomRates.Add(vRoomRate);
								EndIf;
							EndIf;
							r = 0;
							While r < vCustomerRoomRates.Count() Do
								If Not ValueIsFilled(vCustomerRoomRates.Get(r).Value) Then
									vCustomerRoomRates.Delete(r);
								Else
									r = r + 1;
								EndIf;
							EndDo;
						EndIf;
						// Client type
						If ValueIsFilled(vContract.ClientType) Then
							vClientType = vContract.ClientType;
						EndIf;
					EndIf;
				ElsIf ValueIsFilled(vCustomer) And Not vCustomer.DeletionMark Then
					If vCustomer.RoomRates.Count() > 0 Then
						vUseCustomerRoomRates = True;
						vCustomerRoomRates.LoadValues(vCustomer.RoomRates.UnloadColumn("RoomRate"));
						If ValueIsFilled(vCustomer.RoomRate) Then
							vRoomRate = vCustomer.RoomRate;
							vFindedRR = vCustomerRoomRates.FindByValue(vRoomRate);
							If vFindedRR = Undefined Then
								vCustomerRoomRates.Add(vRoomRate);
							EndIf;
						EndIf;
					EndIf;
					// Client type
					If ValueIsFilled(vCustomer.ClientType) Then
						vClientType = vCustomer.ClientType;
					EndIf;
				EndIf;
				// Fill room rates list
				If Not ValueIsFilled(vEmployee) And Not ValueIsFilled(vCustomer) Then
					vRoomRates = vOnlineRoomRates;
					vUseOnlineRoomRates = True;
				Else
					If ValueIsFilled(vEmployee) And vEmployeeRoomRates.Count() > 0 And Not ValueIsFilled(vCustomer) Then
						vRoomRates = vEmployeeRoomRates;
					ElsIf Not ValueIsFilled(vEmployee) And ValueIsFilled(vCustomer) And vUseCustomerRoomRates Then
						vRoomRates = vCustomerRoomRates;
					Else
						If vCustomerRoomRates.Count() > 0 Then
							If vEmployeeRoomRates.Count() > 0 Then
								i = 0;
								While i < vCustomerRoomRates.Count() Do
									vWrkRoomRate = vCustomerRoomRates.Get(i).Value;
									If vEmployeeRoomRates.FindByValue(vWrkRoomRate) = Undefined Then
										vCustomerRoomRates.Delete(i);
									Else
										i = i + 1;
									EndIf;
								EndDo;
							EndIf;
							vRoomRates = vCustomerRoomRates;
						Else
							If vEmployeeRoomRates.Count() > 0 Then
								vRoomRates = vEmployeeRoomRates;
							Else
								vRoomRates = vOnlineRoomRates;
								vUseOnlineRoomRates = True;
							EndIf;
						EndIf;
					EndIf;
				EndIf;
			Else
				// Create list of online room rates
				vRoomRates = cmGetOnlineRoomRates(vHotel, pPeriodFrom, pPeriodTo, vClientIsAuthorized);
				vUseOnlineRoomRates = True;
			EndIf;
		EndIf;
	EndIf;
	
	If ValueIsFilled(vContract) And ValueIsFilled(vContract.RoomQuota) Then
		vRoomQuota = vContract.RoomQuota;
	EndIf;
	
	If Not vUseOnlineRoomRates And 
	   Not ValueIsFilled(vRoomRate) And 
	   vRoomRates.Count() = 0 Then
		If ValueIsFilled(vHotel) Then
			vRoomRate = vHotel.RoomRate;
			If ValueIsFilled(vRoomRate) Then
				vRoomRates.Add(vRoomRate);
			EndIf;
		EndIf;
	EndIf;

	If Not IsBlankString(pClientTypeCode) Then
		vClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode);
	ElsIf ValueIsFilled(vClient) Then
		vClientType = vClient.ClientType;
	ElsIf ValueIsFilled(vCustomer) Then
		vClientType = vCustomer.ClientType;	
	EndIf; 
	
	vRoomType = Catalogs.RoomTypes.EmptyRef();
	If Not IsBlankString(pRoomTypeCode) Then
		vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode, True, , True);
	EndIf;
	If Not IsBlankString(pRoomQuotaCode) Then
		vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode);
	EndIf;
	vDiscountType = Undefined;
	vPromoDiscountType = Undefined;
	If Not IsBlankString(pPromoCode) Then
		// Try to find discount card by promo code
		vPromoDiscountCard = Catalogs.DiscountCards.GetDiscountCardByPromoCode(pPromoCode, pPeriodFrom, pPeriodTo);
		If ValueIsFilled(vPromoDiscountCard) Then
			vPromoDiscountType = vPromoDiscountCard.DiscountType;
		EndIf;
		If Not ValueIsFilled(vPromoDiscountType) Then
			vPromoDiscountType = Catalogs.DiscountTypes.GetDiscountTypeByPromoCode(pPromoCode, vHotel, pPeriodFrom, pPeriodTo);
		EndIf;
	EndIf;
	If ValueIsFilled(vPromoDiscountType) Then
		vDiscountType = vPromoDiscountType;
	EndIf;
	If Not ValueIsFilled(vDiscountType) Then
		If ValueIsFilled(vClient) Then
			vDiscountType = vClient.DiscountType;
		ElsIf ValueIsFilled(vCustomer) Then
			vDiscountType = vCustomer.DiscountType;		
		EndIf;
		If Not ValueIsFilled(vDiscountType) And ValueIsFilled(vClientType) Then
			vDiscountType = vClientType.DiscountType;
		EndIf;
	EndIf;
	
	// Source and market
	vMarketingCode = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "MarketingCodes", pExternalSystemCode);
	vSourceOfBusiness = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "SourcesOfBusiness", pExternalSystemCode);
	
	// Retrieve reservation conditions
	vPaymentMethodCodesAllowedOnline = "";
	vReservationConditionsShort = "";
	vReservationConditionsOnline = "";
	vReservationConditions = cmNStr("ru = '* Для аннулирования брони известите отдел бронирования до 18:00 дня предшествующего дате заезда
	                                |
	                                |* Возможность поселения ранее указанного времени должна быть согласована с отделом бронирования';
	                                |de = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL';
	                                |en = '* To cancel the booking, you may notify reservation department by 6 p.m. ONE DAY PRIOR THE DATE OF ARRIVAL'", 
	                                vLanguage);
	If ValueIsFilled(vHotel) And Not IsBlankString(vHotel.ReservationConditions) Then
		vReservationConditions = cmNStr(vHotel.ReservationConditions, vLanguage);
	EndIf;
	If ValueIsFilled(vRoomRate) And Not IsBlankString(vRoomRate.ReservationConditions) And Not IsBlankString(pRoomRateCode) Then
		vReservationConditions = cmNStr(vRoomRate.ReservationConditions, vLanguage);
		vReservationConditionsShort = cmNStr(vRoomRate.ReservationConditionsShort, vLanguage);
		vReservationConditionsOnline = cmNStr(vRoomRate.ReservationConditionsOnline, vLanguage);
		vPaymentMethodCodesAllowedOnline = TrimAll(vRoomRate.PaymentMethodCodesAllowedOnline);
	EndIf;
	vReservationConditions = Left(vReservationConditions, 4096);
	vReservationConditionsShort = Left(vReservationConditionsShort, 4096);
	vReservationConditionsOnline = Left(vReservationConditionsOnline, 4096);
	vPaymentMethodCodesAllowedOnline = Left(vPaymentMethodCodesAllowedOnline, 4096);
	
	vRetXDTO.ReservationConditions = vReservationConditions;
	vRetXDTO.ReservationConditionsShort = vReservationConditionsShort;
	vRetXDTO.ReservationConditionsOnline = vReservationConditionsOnline;
	vRetXDTO.PaymentMethodCodesAllowedOnline = vPaymentMethodCodesAllowedOnline;
	
	// Build structure with children ages
	vChildrenAgesStruct = Undefined;
	If ValueIsFilled(vRoomQuota) And ValueIsFilled(vRoomQuota.Contract) Then
		vAllotmentContract = vRoomQuota.Contract;
		If vAllotmentContract.TeenagersMaxAge <> 0 Or vAllotmentContract.ChildrenMaxAge <> 0 Or vAllotmentContract.InfantsMaxAge <> 0 Then
			vChildrenAgesStruct = vAllotmentContract;
		EndIf;
	EndIf;
	
	// Get accommodation types list with ages
	vAdultsQuantity = pGuestsQuantity.Adults.Quantity;
	vKidsQuantity = pGuestsQuantity.Kids.Quantity;
	vGuestsQuantity = vAdultsQuantity + vKidsQuantity;
	
	vAgeValueTable = New ValueTable();
	vAgeValueTable.Columns.Add("Age", cmGetNumberTypeDescription(3, 0));
	vAgeValueTable.Columns.Add("IsUsed", cmGetBooleanTypeDescription());
	vAgeArray = New Array();
	Try
		For Each vAge In pGuestsQuantity.Kids.Age Do
			vAgeRow = vAgeValueTable.Add();
			vAgeRow.Age = vAge;
			vAgeRow.IsUsed = False;
			vAgeArray.Add(vAge);
		EndDo;
	Except
	EndTry;
	
	// Get available room types
	vRoomTypesByGQ = cmGetRoomTypesByGuestQuantity(vGuestsQuantity, vRoomType, vHotel);
	
	// Run query to retrieve available rooms/beds 
	vRoomTypes = cmGetRoomTypesWithBalances(vHotel, vRoomTypesByGQ.UnloadColumn("RoomType"), vRoomQuota, pPeriodFrom, pPeriodTo);
	
	vRoomsTable = Undefined;
	If cmCheckUserPermissions("ReturnAvailableRoomsForExternalSystems") Then
		vRoomsTable = cmGetRoomsWithBalances(vHotel, vRoomTypesByGQ.UnloadColumn("RoomType"), vRoomQuota, pPeriodFrom, pPeriodTo);
	EndIf;
	
	// Remove stop sale periods from the list of prices
	cmRemoveStopSalePeriods(vRoomTypes, pPeriodFrom, pPeriodTo);
	
	// Sort room types list
	vRoomTypes.Sort("HotelSortCode, RoomTypeSortCode");
	
	vRetAccTypesRows = Undefined;
	vRetAccTypesList = Undefined;
	vAvailableRoomTypesRows = Undefined;
	vAvailableRoomTypesByCheckInPeriodsRows = Undefined;
	vNoAgent = True; // If we have at least one quota with this customer\agent\contract - vNoAgent = False else True
	
	// Get check-in periods for the first room rate in the list of room rates      
	vVacantPeriods = New ValueTable();
	GetRoomTypesByCheckInPeriods(pPeriodFrom, pPeriodTo, vContract, vCustomer, vGuestsQuantity, vHotel, vIsByCheckInPeriods, vRoomQuota, vRoomRates, vVacantPeriods);

	
	vAccommodationTypesByRoomTypes = New ValueList();
	
	vRestrictionsCache = New ValueTable();
	vRestrictionsCache.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
	vRestrictionsCache.Columns.Add("PeriodFrom", cmGetDateTypeDescription());
	vRestrictionsCache.Columns.Add("PeriodTo", cmGetDateTypeDescription());
	vRestrictionsCache.Columns.Add("IsRestricted", cmGetBooleanTypeDescription());

	vReservationRef = Undefined;
	If pExtraParams <> Undefined And pExtraParams.ReservationCode <> Undefined And Not IsBlankString(pExtraParams.ReservationCode) Then
		vReservationRef = Documents.Reservation.GetRef(New UUID(pExtraParams.ReservationCode));
	EndIf;
	
	// Check if we can use prices cache
	vUseRoomRateDailyPrices = False;
	If ValueIsFilled(vHotel) And vHotel.UseRoomRateDailyPrices And cmRoomRatePricesCacheIsFilled(vHotel, vRoomRates, vClientType, pPeriodFrom, pPeriodTo) And Not ValueIsFilled(vReservationRef) Then
		vUseRoomRateDailyPrices = True;
		// Check if room rates in list do not have accumulation discount types attached
		For Each vRoomRateItem In vRoomRates Do
			vRoomRate = vRoomRateItem.Value;
			If ValueIsFilled(vRoomRate.DiscountType) And vRoomRate.DiscountType.IsAccumulatingDiscount Then
				vUseRoomRateDailyPrices = False;
				Break;
			EndIf;
		EndDo;
	EndIf;
	
	// Check if rooom rate prices cache is filled
	If vUseRoomRateDailyPrices Then
		WriteLogEvent(NStr("en = 'Get available room types'; de = 'Restbestände an freien Zimmern erhalten'; ru = 'Получить остатки свободных номеров'"), EventLogLevel.Information, , , "PRICE CACHE IS USED"); 
		
		// Build structure with children ages
		vChildrenAgesStruct = Undefined;
		If ValueIsFilled(vRoomQuota) And ValueIsFilled(vRoomQuota.Contract) Then
			vAllotmentContract = vRoomQuota.Contract;
			If vAllotmentContract.TeenagersMaxAge <> 0 Or vAllotmentContract.ChildrenMaxAge <> 0 Or vAllotmentContract.InfantsMaxAge <> 0 Then
				vChildrenAgesStruct = vAllotmentContract;
			EndIf;
		EndIf;
		
		// Fill list of accommodation types (common structure for all room rates)
		vRetStr = "";
		vRetAccTypesRows = Undefined;
		For Each vRoomRateItem In vRoomRates Do
			vRoomRate = vRoomRateItem.Value;
			vSavChildrenAgesStruct = vChildrenAgesStruct;
		  	
			// Duration
			vDuration = cmCalculateDuration(vRoomRate, pPeriodFrom, pPeriodTo);

			// Get active special offers
			If ValueIsFilled(vHotel) And ValueIsFilled(vRoomRate) Then
				vOffers = cmGetConfirmedSpecialOffersForReservation(Undefined, vHotel, vRoomRate, vRoomRate.RoomRateType, vClient, ?(ValueIsFilled(vClient), vClient.ClientType, vClientType), vCustomer, ?(ValueIsFilled(vCustomer), vCustomer.CustomerType, Undefined), Undefined, vSourceOfBusiness, vMarketingCode, Undefined, pPeriodFrom, vDuration, pPeriodTo, ?(ValueIsFilled(vReservationRef), ?(ValueIsFilled(vReservationRef.GuestGroup.CreateDate), vReservationRef.GuestGroup.CreateDate, CurrentSessionDate()), CurrentSessionDate()), vRoomType);
				For Each vOffersRow In vOffers Do
					vOffer = vOffersRow.SpecialOffer;
					If vOffer.TeenagersMaxAge <> 0 Or vOffer.ChildrenMaxAge <> 0 Or vOffer.InfantsMaxAge <> 0 Then
						vChildrenAgesStruct = vOffer;
						Break;
					EndIf;
				EndDo;
			EndIf;

			// Special offers by promo code
			vPromoCodeStruct = New Structure("PromoCode, Hotel, Date, PeriodFrom, Duration, PeriodTo, RoomRate, RoomRateType, ClientType, CustomerType,  SourceOfBusiness, MarketingCode, TripPurpose, RoomType", 
			                                 pPromoCode, vHotel, ?(ValueIsFilled(vReservationRef), ?(ValueIsFilled(vReservationRef.GuestGroup), vReservationRef.GuestGroup.CreateDate, vReservationRef.Date), CurrentSessionDate()), 
			                                 pPeriodFrom, vDuration, pPeriodTo, vRoomRate, vRoomRate.RoomRateType,
			                                 ?(ValueIsFilled(vClient), vClient.ClientType, vClientType), ?(ValueIsFilled(vCustomer), vCustomer.CustomerType, Undefined), 
			                                 vSourceOfBusiness, vMarketingCode, Undefined, vRoomType);
			vSpecialOfferByPromoCode = Undefined;
			If Not IsBlankString(pPromoCode) Then
				// Try to find special offer for this promocode
				vSpecialOfferByPromoCode = Catalogs.SpecialOffers.GetSpecialOfferByPromoCode(vPromoCodeStruct.PromoCode, vPromoCodeStruct.Hotel, vPromoCodeStruct.Date, vPromoCodeStruct.PeriodFrom, vPromoCodeStruct.Duration, vPromoCodeStruct.PeriodTo, vPromoCodeStruct.RoomRate, vPromoCodeStruct.RoomRateType, vPromoCodeStruct.ClientType, vPromoCodeStruct.CustomerType, vPromoCodeStruct.SourceOfBusiness, vPromoCodeStruct.MarketingCode, vPromoCodeStruct.TripPurpose, vPromoCodeStruct.RoomType);
				If ValueIsFilled(vSpecialOfferByPromoCode) Then
					If vSpecialOfferByPromoCode.TeenagersMaxAge <> 0 Or vSpecialOfferByPromoCode.ChildrenMaxAge <> 0 Or vSpecialOfferByPromoCode.InfantsMaxAge <> 0 Then
						vChildrenAgesStruct = vSpecialOfferByPromoCode;
					EndIf;
				EndIf;
			EndIf;
 			
			// Get accommodation templates suitable for each room rate / room type
			vAccTemplates = cmGetAccommodationTemplateDetailsByGuestsQuantity(vAdultsQuantity, vKidsQuantity, vAgeArray, vHotel, True, vChildrenAgesStruct);
			vAccTemplatesList = New ValueList();
			vAccTemplatesList.LoadValues(vAccTemplates.UnloadColumn("AccommodationTemplate"));

			vRoomDiscount = 0;
			
			// Get prices for each suitable template
			vPrices = cmGetCachedPrices(vHotel, vClientType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), Catalogs.PriceTags.EmptyRef(), vRoomRate, vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
			If vPrices.Count() = 0 And ValueIsFilled(vClientType) Then
				vPrices = cmGetCachedPrices(vHotel, Catalogs.ClientTypes.EmptyRef(), BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), Catalogs.PriceTags.EmptyRef(), vRoomRate, vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
			EndIf;	
			vChildrenAgesStruct = vSavChildrenAgesStruct;
			
			// Check room rate is valid period
			If ValueIsFilled(vRoomRate.DateValidFrom) Or ValueIsFilled(vRoomRate.DateValidTo) Then
				If ValueIsFilled(vRoomRate.DateValidFrom) And pPeriodFrom < vRoomRate.DateValidFrom Then
					Continue;
				EndIf;
				If ValueIsFilled(vRoomRate.DateValidTo) And pPeriodTo > EndOfDay(vRoomRate.DateValidTo) Then
					Continue;
				EndIf;
			EndIf;
			
			vCurAccommodationTemplate = Undefined;
			
			vRestrictionsCache.Clear();
			vCurRoomType = Undefined;
			vRoomRateRoomTypePrices = Undefined;
			If ValueIsFilled(vRoomRate.PriceTagType) Then
				vRoomDiscount = 0;
				vRoomRatePrices = cmGetCachedPricesForPriceTags(vHotel, vClientType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), vRoomRate, vCurRoomType, vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
				If vRoomRatePrices.Count() = 0 And ValueIsFilled(vClientType) Then
					vRoomRatePrices = cmGetCachedPricesForPriceTags(vHotel, Catalogs.ClientTypes.EmptyRef(), BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo), vRoomRate, vCurRoomType, vAccTemplatesList, , , vDiscountType, pExternalSystemCode, vRoomDiscount, vPromoCodeStruct);
				EndIf;
			EndIf;
			
			// Build XDTO object
			If vRetAccTypesRows = Undefined Then
				vRetAccTypesRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypes"));
			EndIf;
			
			vRetRoomTypeRow = Undefined;
			vRetAccTypesList = Undefined;
		
			For Each vRoomTypesRow In vRoomTypes Do
				vCurRoomType = vRoomTypesRow.RoomType;
				
				// Check room type filter
				If ValueIsFilled(vRoomType) Then
					If vRoomType.IsFolder Then
						If Not vCurRoomType.BelongsToItem(vRoomType) Then
							vCurRoomType = Undefined;
							Continue;
						EndIf;
					Else
						If vCurRoomType <> vRoomType Then
							vCurRoomType = Undefined;
							Continue;
						EndIf;
					EndIf;
				EndIf;
				
				// Check room rate restrictions
				vRestrictionsCacheRows = vRestrictionsCache.FindRows(New Structure("RoomType, PeriodFrom, PeriodTo", vCurRoomType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo)));
				If vRestrictionsCacheRows.Count() > 0 Then
					vRestrictionsCacheRow = vRestrictionsCacheRows.Get(0);
					If vRestrictionsCacheRow.IsRestricted Then
						vCurRoomType = Undefined;
						Continue;
					EndIf;
				Else
					vRestrictionsCacheRow = vRestrictionsCache.Add();
					vRestrictionsCacheRow.RoomType = vCurRoomType;
					vRestrictionsCacheRow.PeriodFrom = BegOfDay(pPeriodFrom);
					vRestrictionsCacheRow.PeriodTo = BegOfDay(pPeriodTo);
					vRestrictionsCacheRow.IsRestricted = False;
					If Not cmCheckRoomRateRestrictions(vHotel, vRoomRate, vCurRoomType, cm1SecondShift(pPeriodFrom), cm0SecondShift(pPeriodTo), cmCalculateDuration(vRoomRate, cm1SecondShift(pPeriodFrom), cm0SecondShift(pPeriodTo))) Then
						vRestrictionsCacheRow.IsRestricted = True;
						vCurRoomType = Undefined;
						Continue;
					EndIf;
				EndIf;
				
				// Get prices for current room rate and room type
				If ValueIsFilled(vRoomRate.PriceTagType) Then
					vRoomRateRoomTypePrices = vRoomRatePrices.FindRows(New Structure("RoomRate, RoomType", vRoomRate, vCurRoomType));
				Else
					vRoomRateRoomTypePrices = vPrices.FindRows(New Structure("RoomRate, RoomType", vRoomRate, vCurRoomType));
				EndIf;
				
				vRetRoomTypeRow = Undefined;
				vRetAccTypesList = Undefined;
				
				vAgeValueTable.FillValues(False, "IsUsed");
				
				If vRoomRateRoomTypePrices <> Undefined And vRoomRateRoomTypePrices.Count() > 0 Then
					vCurAccommodationTemplate = Undefined;
					For Each vRoomRateRoomTypePricesRow In vRoomRateRoomTypePrices Do
						vWrkAccommodationTemplate = vRoomRateRoomTypePricesRow.AccommodationTemplate;
						If ValueIsFilled(vWrkAccommodationTemplate) Then
							If vWrkAccommodationTemplate.RoomTypes.Count() <> 0 And vWrkAccommodationTemplate.RoomTypes.Find(vCurRoomType, "RoomType") = Undefined Then
								If Not ValueIsFilled(vCurRoomType) Or ValueIsFilled(vCurRoomType) And Not ValueIsFilled(vCurRoomType.RoomClass) Or 
								   ValueIsFilled(vCurRoomType) And ValueIsFilled(vCurRoomType.RoomClass) And vWrkAccommodationTemplate.RoomTypes.Find(vCurRoomType.RoomClass, "RoomClass") = Undefined Then
									Continue;
								EndIf;
							EndIf;
						EndIf;
						If ValueIsFilled(vCurAccommodationTemplate) And vCurAccommodationTemplate <> vRoomRateRoomTypePricesRow.AccommodationTemplate Then
							Break;
						EndIf;
						vCurAccommodationTemplate = vRoomRateRoomTypePricesRow.AccommodationTemplate;
						vCurAccommodationType = vRoomRateRoomTypePricesRow.AccommodationType;
						
						vRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
						vRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
						vRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
						vRetAccTypeRow.Age = 0;
						
						For Each vAgeRow In vAgeValueTable Do
							If Not vAgeRow.IsUsed And vAgeRow.Age > vCurAccommodationType.AllowedClientAgeFrom And vAgeRow.Age < vCurAccommodationType.AllowedClientAgeTo Then
								vRetAccTypeRow.Age = vAgeRow.Age;
								vAgeRow.IsUsed = True;
								Break;
							EndIf;
						EndDo;
						
						vRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
						vRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
						
						vAccTypeCurrency = vRoomRateRoomTypePricesRow.Currency;
						If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then 
							vRetAccTypeRow.AmountBeforeDiscount = Round((vRoomRateRoomTypePricesRow.Amount * 100) / (100 - vRoomRate.OnlineDiscount), 2);
							vRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
						Else
							vRetAccTypeRow.AmountBeforeDiscount = Round(vRoomRateRoomTypePricesRow.AmountBeforeDiscount, 2);
							vRetAccTypeRow.Discount = vRoomDiscount; 
						EndIf;
						vRetAccTypeRow.Amount = Round(vRoomRateRoomTypePricesRow.Amount, 2);
						vRetAccTypeRow.AmountPresentation = cmFormatSum(vRoomRateRoomTypePricesRow.Amount, vAccTypeCurrency, "NZ=");
						vRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
						If IsBlankString(vRetAccTypeRow.Currency) Then
							vRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
						EndIf;
						If ValueIsFilled(vAccTypeCurrency) Then
							vRetAccTypeRow.CurrencyCode = TrimAll(vAccTypeCurrency.Code);
							vRetAccTypeRow.CurrencyDescription = TrimAll(vAccTypeCurrency.Description);
						Else
							vRetAccTypeRow.CurrencyCode = "";
							vRetAccTypeRow.CurrencyDescription = "";
						EndIf;
						
						If vRetAccTypesList = Undefined Then
							vRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
						EndIf;
					
						vRetAccTypesList.AccommodationType.Add(vRetAccTypeRow);
					EndDo; // By prices
				EndIf;
				If vRetAccTypesList <> Undefined Then
					If vAccommodationTypesByRoomTypes.FindByValue(vCurRoomType) = Undefined Then
						vAccommodationTypesByRoomTypes.Add(vCurRoomType);
						If vRetRoomTypeRow = Undefined Then
							vRetRoomTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "RoomType"));
							vRetRoomTypeRow.Code = TrimR(vCurRoomType.Code);
							vRetRoomTypeRow.Description = TrimR(vCurRoomType.Description);
						EndIf;
						vRetRoomTypeRow.AccommodationTypesList = vRetAccTypesList;
						vRetAccTypesRows.RoomType.Add(vRetRoomTypeRow);
					EndIf;
				EndIf;
			EndDo; // By room types
			
			// Build XDTO return object
			If vAvailableRoomTypesRows = Undefined Then
				vAvailableRoomTypesRows = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesRows"));
			EndIf;
			vCurRoomType = Undefined;
			vAmountBeforeDiscount = 0;
			vAmount = 0;
			vFirstDaySum = 0;
			vRetAccTypesList = Undefined;
			For Each vRoomTypesRow In vRoomTypes Do
				If vCurRoomType <> vRoomTypesRow.RoomType Then
					vCurRoomType = vRoomTypesRow.RoomType;
					
					// Check room rate restrictions
					vRestrictionsCacheRows = vRestrictionsCache.FindRows(New Structure("RoomType, PeriodFrom, PeriodTo", vCurRoomType, BegOfDay(pPeriodFrom), BegOfDay(pPeriodTo)));
					If vRestrictionsCacheRows.Count() > 0 Then
						vRestrictionsCacheRow = vRestrictionsCacheRows.Get(0);
						If vRestrictionsCacheRow.IsRestricted Then
							vCurRoomType = Undefined;
							Continue;
						EndIf;
					Else
						vRestrictionsCacheRow = vRestrictionsCache.Add();
						vRestrictionsCacheRow.RoomType = vCurRoomType;
						vRestrictionsCacheRow.PeriodFrom = BegOfDay(pPeriodFrom);
						vRestrictionsCacheRow.PeriodTo = BegOfDay(pPeriodTo);
						vRestrictionsCacheRow.IsRestricted = False;
						If Not cmCheckRoomRateRestrictions(vHotel, vRoomRate, vCurRoomType, cm1SecondShift(pPeriodFrom), cm0SecondShift(pPeriodTo), cmCalculateDuration(vRoomRate, cm1SecondShift(pPeriodFrom), cm0SecondShift(pPeriodTo))) Then
							vRestrictionsCacheRow.IsRestricted = True;
							vCurRoomType = Undefined;
							Continue;
						EndIf;
					EndIf;
					
					vAmountBeforeDiscount = 0;
					vAmount = 0;
					vFirstDaySum = 0;
					
					vRetAccTypesList = Undefined;
				EndIf;
				
				// Get prices for current room rate, room type
				j = 0;
				vGoToOutput = False;
				vAgeValueTable.FillValues(False, "IsUsed");
				
				// Get prices for current room rate and room type
				If ValueIsFilled(vRoomRate.PriceTagType) Then
					vRoomRateRoomTypePrices = vRoomRatePrices.FindRows(New Structure("RoomRate, RoomType", vRoomRate, vCurRoomType));
				Else
					vRoomRateRoomTypePrices = vPrices.FindRows(New Structure("RoomRate, RoomType", vRoomRate, vCurRoomType));
				EndIf;
					
				vCurAccommodationTemplate = Undefined;
				For Each vRoomRateRoomTypePricesRow In vRoomRateRoomTypePrices Do
					j = j + 1;
					vWrkAccommodationTemplate = vRoomRateRoomTypePricesRow.AccommodationTemplate;
					If ValueIsFilled(vWrkAccommodationTemplate) Then
						If vWrkAccommodationTemplate.RoomTypes.Count() <> 0 And vWrkAccommodationTemplate.RoomTypes.Find(vCurRoomType, "RoomType") = Undefined Then
							If Not ValueIsFilled(vCurRoomType) Or ValueIsFilled(vCurRoomType) And Not ValueIsFilled(vCurRoomType.RoomClass) Or 
							   ValueIsFilled(vCurRoomType) And ValueIsFilled(vCurRoomType.RoomClass) And vWrkAccommodationTemplate.RoomTypes.Find(vCurRoomType.RoomClass, "RoomClass") = Undefined Then
								Continue;
							EndIf;
						EndIf;
					EndIf;
					If ValueIsFilled(vCurAccommodationTemplate) And vCurAccommodationTemplate <> vRoomRateRoomTypePricesRow.AccommodationTemplate Then
						vGoToOutput = True;
					EndIf;
					If Not vGoToOutput Then
						vCurAccommodationTemplate = vRoomRateRoomTypePricesRow.AccommodationTemplate;
						vCurRoomRate = vRoomRateRoomTypePricesRow.RoomRate;
						vCurAccommodationType = vRoomRateRoomTypePricesRow.AccommodationType;
						
						vRetAccTypeRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationType"));
						vRetAccTypeRow.Code = TrimR(vCurAccommodationType.Code);
						vRetAccTypeRow.Description = vCurAccommodationType.GetObject().pmGetAccommodationTypeDescription(vLanguage);
						vRetAccTypeRow.Age = 0;
						For Each vAgeRow In vAgeValueTable Do
							If Not vAgeRow.IsUsed And vAgeRow.Age > vCurAccommodationType.AllowedClientAgeFrom And vAgeRow.Age < vCurAccommodationType.AllowedClientAgeTo Then
								vRetAccTypeRow.Age = vAgeRow.Age;
								vAgeRow.IsUsed = True;
								Break;
							EndIf;
						EndDo;
						vRetAccTypeRow.ClientAgeFrom = vCurAccommodationType.AllowedClientAgeFrom;
						vRetAccTypeRow.ClientAgeTo = vCurAccommodationType.AllowedClientAgeTo;
						
						vAccTypeCurrency = vRoomRateRoomTypePricesRow.Currency; 
						If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
							vRetAccTypeRow.AmountBeforeDiscount = Round((vRoomRateRoomTypePricesRow.Amount * 100) / (100 - vRoomRate.OnlineDiscount), 2);
							vRetAccTypeRow.Discount = vRoomRate.OnlineDiscount; 	
						Else
							vRetAccTypeRow.AmountBeforeDiscount = Round(vRoomRateRoomTypePricesRow.AmountBeforeDiscount, 2);
							vRetAccTypeRow.Discount = vRoomDiscount;
						EndIf;
						vRetAccTypeRow.Amount = Round(vRoomRateRoomTypePricesRow.Amount, 2);
						vRetAccTypeRow.AmountPresentation = cmFormatSum(vRoomRateRoomTypePricesRow.Amount, vAccTypeCurrency, "NZ=");
						vRetAccTypeRow.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vAccTypeCurrency);
						If IsBlankString(vRetAccTypeRow.Currency) Then
							vRetAccTypeRow.Currency = TrimAll(vAccTypeCurrency);
						EndIf;
						If ValueIsFilled(vAccTypeCurrency) Then
							vRetAccTypeRow.CurrencyCode = TrimAll(vAccTypeCurrency.Code);
							vRetAccTypeRow.CurrencyDescription = TrimAll(vAccTypeCurrency.Description);
						Else
							vRetAccTypeRow.CurrencyCode = "";
							vRetAccTypeRow.CurrencyDescription = "";
						EndIf;            	
						
						If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
							vAmountBeforeDiscount = Round(vAmountBeforeDiscount + (vRoomRateRoomTypePricesRow.Amount * 100)/(100 - vRoomRate.OnlineDiscount), 2);
						Else
							vAmountBeforeDiscount = vAmountBeforeDiscount + vRoomRateRoomTypePricesRow.AmountBeforeDiscount;	
						EndIf;
						vAmount = vAmount + vRoomRateRoomTypePricesRow.Amount;
						vFirstDaySum = vFirstDaySum + vRoomRateRoomTypePricesRow.FirstDaySum;
						
						If vRetAccTypesList = Undefined Then
							vRetAccTypesList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AccommodationTypesList"));
						EndIf;
						vRetAccTypesList.AccommodationType.Add(vRetAccTypeRow);
					EndIf;
					
					If vGoToOutput Or j = vRoomRateRoomTypePrices.Count() Or j < vRoomRateRoomTypePrices.Count() And vRoomRateRoomTypePrices.Get(j).AccommodationTemplate <> vCurAccommodationTemplate Then
						If vRetAccTypesList <> Undefined Then
							vRetRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "AvailableRoomTypesRow"));
							vRetRow.Hotel = cmGetObjectExternalSystemCodeByRef(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vRoomRateRoomTypePricesRow.Hotel);
							vRetRow.RoomsAvailable = vRoomTypesRow.RoomsAvailable;
							vRetRow.BedsAvailable = vRoomTypesRow.BedsAvailable;
							vRetRow.RoomRate = cmGetObjectExternalSystemCodeByRef(vRoomRateRoomTypePricesRow.Hotel, pExternalSystemCode, "RoomRates", vRoomRateRoomTypePricesRow.RoomRate);
							vRetRow.RoomRateCode = vRoomRateRoomTypePricesRow.RoomRateCode;
							vRetRow.RoomRateDescription = vRoomRateRoomTypePricesRow.RoomRateDescription;
							vRetRow.Currency = vRetAccTypeRow.Currency;
							vRetRow.AmountBeforeDiscount = Round(vAmountBeforeDiscount, 2);
							If ValueIsFilled(vRoomRate) And vRoomRate.OnlineDiscount <> 0 Then
								vRetRow.Discount = vRoomRate.OnlineDiscount;
							Else
								vRetRow.Discount = vRoomDiscount;	
							EndIf;
							vRetRow.FirstDaySum = vFirstDaySum;
							vRetRow.Amount = Round(vAmount, 2);
							vRetRow.RoomType = cmGetObjectExternalSystemCodeByRef(vRoomRateRoomTypePricesRow.Hotel, pExternalSystemCode, "RoomTypes", vRoomRateRoomTypePricesRow.RoomType);
							vRetRow.RoomTypeCode = vRoomRateRoomTypePricesRow.RoomTypeCode;
							vRoomClass = vRoomRateRoomTypePricesRow.RoomType.RoomClass;
							If ValueIsFilled(vRoomClass) Then
								vRetRow.RoomClass = TrimAll(vRoomClass);
								vRoomClassExtCode = cmGetObjectExternalSystemCodeByRef(vRoomRateRoomTypePricesRow.Hotel, pExternalSystemCode, "RoomTypeClasses", vRoomClass, True);
								vRetRow.RoomClassCode = ?(IsBlankString(vRoomClassExtCode), TrimAll(vRoomClass.Code), vRoomClassExtCode); 
							EndIf;
							vRetRow.RoomTypeDescription = vRoomRateRoomTypePricesRow.RoomTypeDescription;
							vRetRow.CurrencyCode = vRoomRateRoomTypePricesRow.CurrencyCode;
							vRetRow.CurrencyDescription = vRoomRateRoomTypePricesRow.CurrencyDescription;
							vRetRow.RoomTypePictureLink = vRoomRateRoomTypePricesRow.RoomTypePictureLink;
							vRetRow.RoomTypeInfoLink = vRoomRateRoomTypePricesRow.RoomTypeInfoLink;
							vRetRow.AmountPresentation = cmFormatSum(vAmount, vRoomRateRoomTypePricesRow.Currency, "NZ=");
							vRetRow.LimitedRoomsText = "";
							If vCurRoomType.LimitedRooms > 0 And vRoomTypesRow.RoomsAvailable > 0 And vRoomTypesRow.RoomsAvailable <= vCurRoomType.LimitedRooms Then
								If vRoomTypesRow.RoomsAvailable = 1 Then
