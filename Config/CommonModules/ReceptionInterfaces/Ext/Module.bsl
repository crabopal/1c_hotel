Function GetInvoiceByExternalSystemCode(pInvoiceCode)
	If TypeOf(pInvoiceCode) <> Type("String") Or IsBlankString(pInvoiceCode) Then
		Return Documents.ProformaInvoice.EmptyRef();
	EndIf;
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Invoice.Ref AS Ref
	|FROM
	|	Document.ProformaInvoice AS Invoice
	|WHERE
	|	NOT Invoice.DeletionMark
	|	AND Invoice.ExternalCode = &qExternalCode
	|
	|ORDER BY
	|	Invoice.ChangeDate DESC,
	|	Invoice.Date DESC";
	vQry.SetParameter("qExternalCode", pInvoiceCode);
	vInvoices = vQry.Execute().Unload();
	If vInvoices.Count() > 0 Then
		Return vInvoices.Get(0).Ref;
	Else
		If StrLen(TrimAll(pInvoiceCode)) = 36 Then
			Try
				vProfUUID = New UUID(TrimAll(pInvoiceCode));
				Return Documents.ProformaInvoice.GetRef(vProfUUID);
			Except
				Return Documents.ProformaInvoice.EmptyRef();
			EndTry;
		Else
			Return Documents.ProformaInvoice.EmptyRef();
		EndIf;
	EndIf;
EndFunction // GetInvoiceByExternalSystemCode

