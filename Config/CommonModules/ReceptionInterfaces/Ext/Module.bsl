Function GetPaymentsByReservation(Val vDocRef)
	// Fill payments
	vQuery = New Query;
	vQuery.Text = 
	"SELECT
	|	Folio.Ref AS Ref
	|INTO TabClientFolios
	|FROM
	|	Document.Folio AS Folio
	|WHERE
	|	Folio.DeletionMark = FALSE
	|	AND Folio.ParentDoc = &qParentDoc
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Payments.Recorder AS Recorder,
	|	Payments.Recorder.Number AS Number,
	|	Payments.Recorder.Date AS Date,
	|	Payments.Recorder.Folio.Number AS FolioNumber,
	|	Payments.Recorder.AuthorizationCode AS AuthorizationCode,
	|	Payments.Recorder.ReferenceNumber AS RRN,
	|	Payments.Recorder.MerchantID AS MerchantID,
	|	Payments.Recorder.PaymentMethod.Code AS PaymentMethodCode,
	|	Payments.Recorder.ExternalCode AS ExternalCode,
	|	Payments.SumExpense AS Sum,
	|	Payments.Recorder.PaymentCurrency.Code AS PaymentCurrencyCode
	|FROM
	|	AccumulationRegister.CustomerAccounts.BalanceAndTurnovers(, , Recorder, RegisterRecordsAndPeriodBoundaries, GuestGroup = &qGuestGroup) AS Payments
	|WHERE
	|	(Payments.Recorder REFS Document.Payment
	|			OR Payments.Recorder REFS Document.Return)
	|	AND Payments.Recorder.Folio IN
	|			(SELECT
	|				TabClientFolios.Ref AS Ref
	|			FROM
	|				TabClientFolios AS TabClientFolios)";
	vQuery.SetParameter("qGuestGroup", vDocRef.GuestGroup);
	vQuery.SetParameter("qParentDoc", vDocRef);
	vPaymentResult = vQuery.Execute();
	vPaymentRow = vPaymentResult.Select();
	vPaymentList = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "PaymentList"));
	While vPaymentRow.Next() Do
		vPaymentXDTORow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "PaymentRow"));
		vPaymentXDTORow.PaymentNumber = TrimAll(vPaymentRow.Number);
		vPaymentXDTORow.PaymentDate = vPaymentRow.Date;
		vPaymentXDTORow.FolioNumber = TrimAll(vPaymentRow.FolioNumber);
		vPaymentXDTORow.MerchantID = TrimAll(vPaymentRow.MerchantID);
		vPaymentXDTORow.RRN = TrimAll(vPaymentRow.RRN);
		vPaymentXDTORow.ExternalCode = TrimAll(vPaymentRow.ExternalCode);
		vPaymentXDTORow.AuthCode = TrimAll(vPaymentRow.AuthorizationCode);
		vPaymentXDTORow.Sum = vPaymentRow.Sum;
		vPaymentXDTORow.PaymentMethodCode = TrimAll(vPaymentRow.PaymentMethodCode);
		vPaymentXDTORow.CurrencyCode = TrimAll(vPaymentRow.PaymentCurrencyCode);
		vPaymentList.PaymentRow.Add(vPaymentXDTORow);
	EndDo;
	Return vPaymentList;
EndFunction // GetPaymentsByReservation

