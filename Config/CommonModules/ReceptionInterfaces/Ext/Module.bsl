							EndIf;
							vPaymentObj.pmCalculateTotalsByPaymentSections();
						Else
							// Check if this is advance with multiple payment sections mode
							If vMultipleAdvanceSectionsMode And vPaymentObj.PaymentSections.Count() > 1 Then
								For Each vPSRow In vPaymentObj.PaymentSections Do
									If Not (Not ValueIsFilled(vPSRow.ChequeService) And 
										        ValueIsFilled(vPSRow.PaymentSection) And 
