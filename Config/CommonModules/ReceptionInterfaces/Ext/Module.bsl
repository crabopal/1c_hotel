// -----------------------------------------------------------------------------
Function cmGetRoomRatesRestrictions(pHotel, pRoomRatesList = Undefined, pRoomTypesList = Undefined, pCheckInDate, pCheckOutDate, pWithoutOnline = False) Export
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	RoomRateRestrictions.RoomRate AS RoomRate,
	|	RoomRateRestrictions.RoomType AS RoomType,
	|	RoomRateRestrictions.AccountingDate AS AccountingDate,
	|	RoomRateRestrictions.DayOfWeek AS DayOfWeek,
	|	RoomRateRestrictions.CalendarDayType AS CalendarDayType,
	|	RoomRateRestrictions.MLOS AS MLOS,
	|	RoomRateRestrictions.MaxLOS AS MaxLOS,
	|	RoomRateRestrictions.MinDaysBeforeCheckIn AS MinDaysBeforeCheckIn,
	|	RoomRateRestrictions.MaxDaysBeforeCheckIn AS MaxDaysBeforeCheckIn,
	|	RoomRateRestrictions.StopSale AS StopSale,
	|	RoomRateRestrictions.CTA AS CTA,
	|	RoomRateRestrictions.CTD AS CTD
	|FROM
	|	InformationRegister.RoomRateRestrictions AS RoomRateRestrictions
	|WHERE
	|	RoomRateRestrictions.Hotel = &qHotel
	|	AND (RoomRateRestrictions.RoomRate IN (&qRoomRatesList)
	|			OR &qAllRoomRates
	|			OR RoomRateRestrictions.RoomRate = VALUE(Catalog.RoomRates.EmptyRef))
	|	AND (RoomRateRestrictions.RoomType IN (&qRoomTypesList)
	|			OR &qAllRoomTypes
	|			OR RoomRateRestrictions.RoomType = VALUE(Catalog.RoomTypes.EmptyRef))
	|	AND (RoomRateRestrictions.AccountingDate >= &qPeriodFrom
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate)
	|	AND (RoomRateRestrictions.AccountingDate <= &qPeriodTo
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate)
	|	AND (NOT &qWithoutOnline
	|			OR &qWithoutOnline
	|				AND NOT RoomRateRestrictions.IsForOnlineOnly)";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomRatesList", ?(pRoomRatesList = Undefined, New ValueList(), pRoomRatesList));
	vQry.SetParameter("qAllRoomRates", ?(pRoomRatesList = Undefined, True, False));
	vQry.SetParameter("qRoomTypesList", ?(pRoomTypesList = Undefined, New ValueList(), pRoomTypesList));
	vQry.SetParameter("qAllRoomTypes", ?(pRoomTypesList = Undefined, True, False));
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qPeriodFrom", BegOfDay(pCheckInDate));
	vQry.SetParameter("qPeriodTo", BegOfDay(pCheckOutDate));
	vQry.SetParameter("qWithoutOnline", pWithoutOnline);
	vRestrictions = vQry.Execute().Unload();
	Return vRestrictions;
EndFunction // cmGetRoomRatesRestrictions

// -----------------------------------------------------------------------------
Function cmCheckRestrictions(pRestrictions, pHotel, pRoomRate, pRoomType, pCheckInDate, pCheckOutDate, pWithoutLOSAndCTs = False) Export
	// Calculate some parameters used in check
	vCheckInDayOfWeek = WeekDay(pCheckInDate);
	vCheckOutDayOfWeek = WeekDay(pCheckOutDate);
	vCheckOutDate = BegOfDay(pCheckOutDate);
	If BegOfDay(pCheckInDate) < BegOfDay(pCheckOutDate) And 
	   ValueIsFilled(pRoomRate) And Not pRoomRate.IsFolder And
	   (pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Or 
	    pRoomRate.DurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour) Then
		vCheckOutDate = vCheckOutDate - 24*3600;
	EndIf;
	vWeekDays = New ValueList();
	If ValueIsFilled(pCheckInDate) And ValueIsFilled(pCheckOutDate) And BegOfDay(pCheckOutDate) >= BegOfDay(pCheckInDate) Then
		vCurDay = BegOfDay(pCheckInDate);
		While vCurDay <= vCheckOutDate Do
			vWeekDay = WeekDay(vCurDay);
			If vWeekDays.FindByValue(vWeekDay) = Undefined Then
				vWeekDays.Add(vWeekDay);
			EndIf;
			If vWeekDays.Count() = 7 Then
				Break;
			EndIf;
			vCurDay = vCurDay + 24*3600;
		EndDo;
	EndIf;
	vDuration = cmCalculateDuration(pRoomRate, cm1SecondShift(pCheckInDate), cm0SecondShift(pCheckOutDate));
	vDaysBeforeCheckIn = Int((BegOfDay(pCheckInDate) - BegOfDay(CurrentSessionDate()))/(24*3600));
	
	// Do check
	For Each vRestrictionsRow In pRestrictions Do
		If (Not ValueIsFilled(vRestrictionsRow.RoomRate) Or vRestrictionsRow.RoomRate = pRoomRate) And 
		   (Not ValueIsFilled(vRestrictionsRow.RoomType) Or vRestrictionsRow.RoomType = pRoomType) Then
			If vRestrictionsRow.StopSale Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) And vRestrictionsRow.AccountingDate <= vCheckOutDate Then
					Return False;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vWeekDays.FindByValue(vRestrictionsRow.DayOfWeek) <> Undefined Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.CTA And Not pWithoutLOSAndCTs Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckInDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckInDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.CTD And Not pWithoutLOSAndCTs Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckOutDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckOutCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckOutDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckOutCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckOutDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.MLOS <> 0 And vDuration < vRestrictionsRow.MLOS And Not pWithoutLOSAndCTs Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckInDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckInDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.MaxLOS <> 0 And vDuration > vRestrictionsRow.MaxLOS And Not pWithoutLOSAndCTs Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckInDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckInDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.MinDaysBeforeCheckIn <> 0 And vDaysBeforeCheckIn < vRestrictionsRow.MinDaysBeforeCheckIn Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckInDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckInDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
			If vRestrictionsRow.MaxDaysBeforeCheckIn <> 0 And vDaysBeforeCheckIn > vRestrictionsRow.MaxDaysBeforeCheckIn Then
				If ValueIsFilled(vRestrictionsRow.AccountingDate) Then
					If vRestrictionsRow.AccountingDate = BegOfDay(pCheckInDate) Then
						Return False;
					EndIf;
				Else
					If ValueIsFilled(vRestrictionsRow.CalendarDayType) Then
						vCheckInCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType);
						If vCheckInCalendarDayType = vRestrictionsRow.CalendarDayType Then
							Return False;
						EndIf;
					ElsIf vRestrictionsRow.DayOfWeek <> 0 And vCheckInDayOfWeek = vRestrictionsRow.DayOfWeek Then
						Return False;
					ElsIf Not ValueIsFilled(vRestrictionsRow.CalendarDayType) And vRestrictionsRow.DayOfWeek = 0 Then
						Return False;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
	EndDo;
	Return True;
EndFunction // cmCheckRestrictions

// -----------------------------------------------------------------------------
Function cmCheckRoomRateRestrictions(pHotel, pRoomRate, pRoomType, pCheckInDate, pCheckOutDate, pDuration, pWithoutOnline = False, pWithoutLOSAndCTs = False, pPriceCalculationDate = '00010101') Export
	vDayOfWeek = WeekDay(pCheckInDate);
	vCheckOutDayOfWeek = WeekDay(pCheckOutDate);
	vWeekDays = New ValueList();
	If ValueIsFilled(pCheckInDate) And ValueIsFilled(pCheckOutDate) And BegOfDay(pCheckOutDate) >= BegOfDay(pCheckInDate) Then
		vCurDay = BegOfDay(pCheckInDate);
		While vCurDay <= pCheckOutDate Do
			vWeekDay = WeekDay(vCurDay);
			If vWeekDays.FindByValue(vWeekDay) = Undefined Then
				vWeekDays.Add(vWeekDay);
			EndIf;
			If vWeekDays.Count() = 7 Then
				Break;
			EndIf;
			vCurDay = vCurDay + tcCommonFunctionOnClientServer.cmOneDay();
		EndDo;
	EndIf;
	vCalendarDayType = cmGetCalendarDayType(pRoomRate, pCheckInDate, pCheckInDate, pCheckOutDate, , pRoomType, pPriceCalculationDate);
	vResult = True;
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	RoomRateRestrictions.MLOS AS MLOS,
	|	RoomRateRestrictions.MaxLOS AS MaxLOS,
	|	RoomRateRestrictions.MinDaysBeforeCheckIn AS MinDaysBeforeCheckIn,
	|	RoomRateRestrictions.MaxDaysBeforeCheckIn AS MaxDaysBeforeCheckIn,
	|	RoomRateRestrictions.StopSale AS StopSale,
	|	RoomRateRestrictions.CTA AS CTA,
	|	RoomRateRestrictions.CTD AS CTD,
	|	RoomRateRestrictions.CalendarDayType AS CalendarDayType
	|FROM
	|	InformationRegister.RoomRateRestrictions AS RoomRateRestrictions
	|WHERE
	|	RoomRateRestrictions.Hotel = &qHotel
	|	AND (RoomRateRestrictions.RoomRate = &qRoomRate
	|			OR RoomRateRestrictions.RoomRate = VALUE(Catalog.RoomRates.EmptyRef))
	|	AND (RoomRateRestrictions.RoomType = &qRoomType
	|			OR RoomRateRestrictions.RoomType = &qEmptyRoomType)
	|	AND (RoomRateRestrictions.AccountingDate = &qAccountingDate
	|				AND (RoomRateRestrictions.CTA
	|					OR RoomRateRestrictions.MinDaysBeforeCheckIn > 0
	|					OR RoomRateRestrictions.MaxDaysBeforeCheckIn > 0
	|					OR RoomRateRestrictions.MLOS > 0
	|					OR RoomRateRestrictions.MaxLOS > 0)
	|			OR RoomRateRestrictions.AccountingDate >= &qAccountingDate
	|				AND (RoomRateRestrictions.AccountingDate < &qCheckOutAccountingDate
	|					OR RoomRateRestrictions.AccountingDate = &qAccountingDate
	|						AND &qAccountingDate = &qCheckOutAccountingDate)
	|				AND RoomRateRestrictions.StopSale
	|			OR RoomRateRestrictions.AccountingDate = &qCheckOutAccountingDate
	|				AND RoomRateRestrictions.CTD
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = &qDayOfWeek
	|				AND RoomRateRestrictions.CalendarDayType = &qCalendarDayType
	|				AND NOT RoomRateRestrictions.StopSale
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek IN (&qDaysOfWeek)
	|				AND RoomRateRestrictions.CalendarDayType = &qCalendarDayType
	|				AND RoomRateRestrictions.StopSale
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = &qCheckOutDayOfWeek
	|				AND RoomRateRestrictions.CalendarDayType = &qCalendarDayType
	|				AND RoomRateRestrictions.CTD
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = &qDayOfWeek
	|				AND RoomRateRestrictions.CalendarDayType = &qEmptyCalendarDayType
	|				AND NOT RoomRateRestrictions.StopSale
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek IN (&qDaysOfWeek)
	|				AND RoomRateRestrictions.CalendarDayType = &qEmptyCalendarDayType
	|				AND RoomRateRestrictions.StopSale
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = &qCheckOutDayOfWeek
	|				AND RoomRateRestrictions.CalendarDayType = &qEmptyCalendarDayType
	|				AND RoomRateRestrictions.CTD
	|				AND RoomRateRestrictions.DayOfWeek <> 0
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = 0
	|				AND RoomRateRestrictions.CalendarDayType = &qCalendarDayType
	|			OR RoomRateRestrictions.AccountingDate = &qEmptyDate
	|				AND RoomRateRestrictions.DayOfWeek = 0
	|				AND RoomRateRestrictions.CalendarDayType = &qEmptyCalendarDayType)
	|	AND (RoomRateRestrictions.MLOS > 0
	|				AND RoomRateRestrictions.MLOS > &qDuration
	|				AND NOT &qWithoutLOSAndCTs
	|			OR RoomRateRestrictions.MaxLOS > 0
	|				AND RoomRateRestrictions.MaxLOS < &qDuration
	|				AND NOT &qWithoutLOSAndCTs
	|			OR RoomRateRestrictions.MinDaysBeforeCheckIn > 0
	|				AND RoomRateRestrictions.MinDaysBeforeCheckIn > &qDaysBeforeCheckIn
	|			OR RoomRateRestrictions.MaxDaysBeforeCheckIn > 0
	|				AND RoomRateRestrictions.MaxDaysBeforeCheckIn < &qDaysBeforeCheckIn
	|			OR RoomRateRestrictions.StopSale
	|			OR RoomRateRestrictions.CTA
	|				AND NOT &qWithoutLOSAndCTs
	|			OR RoomRateRestrictions.CTD
	|				AND NOT &qWithoutLOSAndCTs)
	|	AND (NOT &qWithoutOnline
	|			OR &qWithoutOnline
	|				AND NOT RoomRateRestrictions.IsForOnlineOnly)";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomRate", pRoomRate);
	vQry.SetParameter("qRoomType", pRoomType);
	vQry.SetParameter("qEmptyRoomType", Catalogs.RoomTypes.EmptyRef());
	vQry.SetParameter("qDayOfWeek", vDayOfWeek);
	vQry.SetParameter("qCheckOutDayOfWeek", vCheckOutDayOfWeek);
	vQry.SetParameter("qDaysOfWeek", vWeekDays);
	vQry.SetParameter("qDuration", pDuration);
	vDaysBeforeCheckIn = Int((BegOfDay(pCheckInDate) - BegOfDay(CurrentSessionDate()))/(24*3600));
	vQry.SetParameter("qDaysBeforeCheckIn", vDaysBeforeCheckIn);
	vQry.SetParameter("qCalendarDayType", vCalendarDayType);
	vQry.SetParameter("qEmptyCalendarDayType", Catalogs.CalendarDayTypes.EmptyRef());
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qAccountingDate", BegOfDay(pCheckInDate));
	vQry.SetParameter("qCheckOutAccountingDate", BegOfDay(pCheckOutDate));
	vQry.SetParameter("qWithoutOnline", pWithoutOnline);
	vQry.SetParameter("qWithoutLOSAndCTs", pWithoutLOSAndCTs);
	vQryResult = vQry.Execute();
	If Not vQryResult.IsEmpty() Then
		vResult = False;
	EndIf;		
	Return vResult;
EndFunction // cmCheckRoomRateRestrictions

// -----------------------------------------------------------------------------
// Checks if it is possible to use cached prices for calculations
// -----------------------------------------------------------------------------
Function cmRoomRatePricesCacheIsFilled(pHotel, pRoomRatesList, pClientType, pPeriodFrom, pPeriodTo) Export
	// Check hotel parameters
	If ValueIsFilled(pHotel) And Not pHotel.UseRoomRateDailyPrices Then
		Return False;
	EndIf;
	// Build list of rates with cache
	vRoomRatesList = New ValueList();
	For Each vRoomRatesItem In pRoomRatesList Do
		vRoomRate = vRoomRatesItem.Value;
		If vRoomRate.DateValidFrom > BegOfDay(pPeriodFrom) Or 
		   ValueIsFilled(vRoomRate.DateValidTo) And vRoomRate.DateValidTo < BegOfDay(pPeriodTo) Then
			Continue;
		EndIf;
		If ValueIsFilled(vRoomRate.BasedOnRoomRate) Then
			If vRoomRatesList.FindByValue(vRoomRate.BasedOnRoomRate) = Undefined Then
				vRoomRatesList.Add(vRoomRate.BasedOnRoomRate);
			EndIf;
		Else
			If vRoomRatesList.FindByValue(vRoomRate) = Undefined Then
				vRoomRatesList.Add(vRoomRate);
			EndIf;
		EndIf;
	EndDo;
	// Check room rates
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	RoomRates.Ref AS Ref,
	|	RoomRates.DurationCalculationRuleType AS DurationCalculationRuleType,
	|	RoomRates.SortCode AS SortCode,
	|	RoomRates.Description AS Description
	|INTO RRates
	|FROM
	|	Catalog.RoomRates AS RoomRates
	|WHERE
	|	RoomRates.Ref IN(&qRoomRates)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RRates.Ref AS RoomRate,
	|	RRates.DurationCalculationRuleType AS RoomRateDurationCalculationRuleType,
	|	MIN(RoomRateDailyPrices.Period) AS MinPeriod,
	|	MAX(RoomRateDailyPrices.Period) AS MaxPeriod
	|INTO RRTab
	|FROM
	|	InformationRegister.RoomRateDailyPrices AS RoomRateDailyPrices
	|		INNER JOIN RRates AS RRates
	|		ON (RRates.Ref = RoomRateDailyPrices.RoomRate)
	|WHERE
	|	RoomRateDailyPrices.Hotel = &qHotel
	|	AND CASE
	|			WHEN &qClientType = VALUE(Catalog.ClientTypes.EmptyRef)
	|					OR &qClientType = UNDEFINED
	|				THEN RoomRateDailyPrices.ClientType = VALUE(Catalog.ClientTypes.EmptyRef)
	|			ELSE RoomRateDailyPrices.ClientType = &qClientType
	|					OR RoomRateDailyPrices.ClientType = VALUE(Catalog.ClientTypes.EmptyRef)
	|		END
	|	AND RoomRateDailyPrices.Period BETWEEN &qPeriodFrom AND &qPeriodTo
	|
	|GROUP BY
	|	RRates.Ref,
	|	RRates.DurationCalculationRuleType
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RRTab.RoomRate AS RoomRate,
	|	RRTab.RoomRateDurationCalculationRuleType AS RoomRateDurationCalculationRuleType,
	|	RRTab.MinPeriod AS MinPeriod,
	|	RRTab.MaxPeriod AS MaxPeriod
	|FROM
	|	RRTab AS RRTab
	|		LEFT JOIN RRates AS RRates
	|		ON RRTab.RoomRate = RRates.Ref
	|
	|ORDER BY
	|	RRates.SortCode,
	|	RRates.Description";
	
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qClientType", pClientType);
	vQry.SetParameter("qRoomRates", vRoomRatesList);
	vQry.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom));
	vQry.SetParameter("qPeriodTo", EndOfDay(pPeriodTo));
	vQry.SetParameter("qEmptyDate", '00010101');
	vRatesInCache = vQry.Execute().Unload();
	i = 0;
	While i < vRoomRatesList.Count() Do
		vRoomRate = vRoomRatesList.Get(i).Value;
		vRoomRateRow = vRatesInCache.Find(vRoomRate, "RoomRate");
		If vRoomRateRow = Undefined Then
			WriteLogEvent("cmRoomRatePricesCacheIsFilled", EventLogLevel.Information, , , "Check failed for room rate: " + vRoomRate);
			vRoomRatesList.Delete(i);
			Continue;
		Else
			vPeriodTo = pPeriodTo;
			If BegOfDay(pPeriodTo) > BegOfDay(pPeriodFrom) Then
				If vRoomRateRow.RoomRateDurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByReferenceHour Or 
				   vRoomRateRow.RoomRateDurationCalculationRuleType = Enums.DurationCalculationRuleTypes.ByNights Then
					vPeriodTo = vPeriodTo - (24*3600);
				EndIf;
			EndIf;
			If BegOfDay(pPeriodFrom) < BegOfDay(vRoomRateRow.MinPeriod) Or BegOfDay(vPeriodTo) > BegOfDay(vRoomRateRow.MaxPeriod) Then
				WriteLogEvent("cmRoomRatePricesCacheIsFilled", EventLogLevel.Information, , , "Check failed for room rate: " + vRoomRate + ", " + BegOfDay(vRoomRateRow.MinPeriod) + " - " + BegOfDay(vRoomRateRow.MaxPeriod));
				vRoomRatesList.Delete(i);
				Continue;
			EndIf;
		EndIf;
		i = i + 1;
	EndDo;
	If vRoomRatesList.Count() = 0 Then
		Return False;
	Else
		// Remove rates without cache from the input list
		i = 0;
		While i < pRoomRatesList.Count() Do
			vRoomRate = pRoomRatesList.Get(i).Value;
			If ValueIsFilled(vRoomRate.BasedOnRoomRate) Then
				vRoomRate = vRoomRate.BasedOnRoomRate;
			EndIf;
			If vRoomRatesList.FindByValue(vRoomRate) = Undefined Then
				pRoomRatesList.Delete(i);
				Continue;
			Else
				i = i + 1;
			EndIf;
		EndDo;
		Return True;
	EndIf;
EndFunction // cmRoomRatePricesCacheIsFilled

// -----------------------------------------------------------------------------
// Build list of days with discounted or zero accommodation prices
// -----------------------------------------------------------------------------
Function cmGetZeroPriceDaysByDiscountType(pDiscountType, pPeriodFrom, pPeriodTo) Export
	vZeroPriceDays = New ValueList();
	If ValueIsFilled(pDiscountType) And pDiscountType.EachNDayIsFreeOfCharge > 0 And 
	   ValueIsFilled(pPeriodFrom) And ValueIsFilled(pPeriodTo) And 
	   BegOfDay(pPeriodTo) >= BegOfDay(pPeriodFrom) Then
    	vEachNDayIsFreeOfCharge = pDiscountType.EachNDayIsFreeOfCharge;
    	vNumberOfFreeOfChargeDays = ?(pDiscountType.NumberOfFreeOfChargeDays > 0, pDiscountType.NumberOfFreeOfChargeDays, 1);
		vPeriodInDays = vEachNDayIsFreeOfCharge + vNumberOfFreeOfChargeDays - 1;

		vStartDate = BegOfDay(pPeriodFrom);
		vEndDate = BegOfDay(pPeriodTo);
		vCurDate = vStartDate;
		While vCurDate <= vEndDate Do
			vNumberOfDays = Round((vCurDate - vStartDate)/(24*3600), 0) + 1;
			For d = 1 To vNumberOfFreeOfChargeDays Do
				If vNumberOfDays <> 0 And Int((vNumberOfDays + vNumberOfFreeOfChargeDays - d) / vPeriodInDays) = (vNumberOfDays + vNumberOfFreeOfChargeDays - d) / vPeriodInDays Then
					vZeroPriceDays.Add(vCurDate);
					Break;
				EndIf;
			EndDo;
			
        	vCurDate = vCurDate + 24*3600;
		EndDo;
	EndIf;
	Return vZeroPriceDays;
EndFunction // cmGetZeroPriceDaysByDiscountType

