// -----------------------------------------------------------------------------
// Description: This API is used to create new client from an external system data 
//              or update one with changed data
// Parameters: Client data fileds
// Return value: String with client code if success, String with error description 
//               in case of failure
// -----------------------------------------------------------------------------
Function cmWriteExternalClient(pExtClientCode, pExtReservationCode, 
                               pClientLastName, pClientFirstName, pClientSecondName, 
                               pClientSexCode, pClientCitizenshipCode, pClientBirthDate,
                               pClientPhone, pClientFax, pClientEMail, pClientRemarks, pClientSendSMS = Undefined,  
                               pHotelCode, pExternalSystemCode, pParentCode = "", 
							   pClientIdentityDocumentTypeCode = "", pClientIdentityDocumentSeries = "", pClientIdentityDocumentNumber = "", 
							   pClientIdentityDocumentIssueDate = '00010101', pClientIdentityDocumentValidToDate = '00010101', pClientIdentityDocumentUnitCode = "", pClientIdentityDocumentIssuedBy = "", 
							   pClientPlaceOfBirth = "", pClientAddress = "", pClientExtraData = Undefined,
							   pLanguage = Undefined, pOutputType = "CSV", pNewExtReservationCode = Undefined) Export   
							   
	vInputParameters = NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='External client code: ';ru='Код клиента во внешней системе: ';de='Kundencode im externen System: '") + pExtClientCode + Chars.LF + 
	              NStr("en='External reservation code: ';ru='Код брони во внешней системе: ';de='Reservierungscode im externen System: '") + pExtReservationCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Client last name: ';ru='Фамилия гостя: ';de='Familienname des Gastes: '") + pClientLastName + Chars.LF + 
	              NStr("en='Client first name: ';ru='Имя гостя: ';de='Name des Gastes: '") + pClientFirstName + Chars.LF + 
	              NStr("en='Client second name: ';ru='Отчество гостя: ';de='Vatersname des Gastes: '") + pClientSecondName + Chars.LF + 
	              NStr("en='Client sex code: ';ru='Код пола гостя: ';de='Code des Geschlechts des Gastes: '") + pClientSexCode + Chars.LF + 
	              NStr("en='Client citizenship code: ';ru='Код гражданства гостя: ';de='Code der Stadtbürgerschaft des Gastes: '") + pClientCitizenshipCode + Chars.LF + 
	              NStr("en='Client birth date: ';ru='Дата рождения гостя: ';de='Geburtsdatum des Gastes: '") + Format(pClientBirthDate, "DF='dd.MM.yyyy'") + Chars.LF + 
	              NStr("en='Client phone: ';ru='Телефон гостя: ';de='Telefon des Gastes: '") + pClientPhone + Chars.LF + 
	              NStr("en='Client fax: ';ru='Факс гостя: ';de='Fax des Gastes:'") + pClientFax + Chars.LF + 
	              NStr("en='Client E-Mail: ';ru='E-Mail гостя: ';de='E-Mail-Adresse des Gastes: '") + pClientEMail + Chars.LF + 
	              NStr("en='Client remarks: ';ru='Примечания гостя: ';de='Anmerkungen des Gastes: '") + pClientRemarks + Chars.LF + 
	              NStr("en='Send SMS: ';ru='Рассылка СМС: ';de='Versand von SMS: '") + pClientSendSMS + Chars.LF + 
	              NStr("en='Language: ';ru='Язык гостя: ';de='Sprache des Gastes: '") + pLanguage + Chars.LF + 
	              NStr("en = 'Identity document type code: '; de = 'Art des Ausweisdokuments: '; ru = 'Код док. удост. личности: '") + TrimAll(pClientIdentityDocumentTypeCode) + Chars.LF +
				  NStr("en = 'Identity document series: '; de = 'Ausweisserie: '; ru = 'Серия док. удост. личности: '") + TrimAll(pClientIdentityDocumentSeries) + Chars.LF + 
				  NStr("en = 'Identity document number: '; de = 'Ausweisnummer: '; ru = 'Номер док. удост. личности: '") + TrimAll(pClientIdentityDocumentNumber) + Chars.LF +  
				  NStr("en = 'Identity document issue date: '; de = 'Ausstellungsdatum des Personalausweises: '; ru = 'Дата выдачи док. удост. личности: '") + TrimAll(pClientIdentityDocumentIssueDate) + Chars.LF +
				  NStr("en = 'Identity document valid to date: '; de = 'Bis heute gültiges Ausweisdokument: '; ru = 'Док. удост. личности действует до: '") + TrimAll(pClientIdentityDocumentValidToDate) + Chars.LF + 
				  NStr("en = 'Client identity document unit code: '; de = 'Abteilung code durch wen wurde der Personalausweis ausgestellt: '; ru = 'Код подразделения выдавшего документ удост. личность: '") + TrimAll(pClientIdentityDocumentUnitCode) + Chars.LF +
				  NStr("en = 'Client identity document issued by: '; de = 'Durch wen wurde der Personalausweis ausgestellt: '; ru = 'Кем выдан документ удост. личность: '") + TrimAll(pClientIdentityDocumentIssuedBy) + Chars.LF + 
				  NStr("en = 'Client place of birth: '; de = 'Geburtsort: '; ru = 'Место рождения гостя: '") + TrimAll(pClientPlaceOfBirth) + Chars.LF + 
				  NStr("en = 'Client address: '; de = 'Wohnanschrift: '; ru = 'Адрес гостя: '") + TrimAll(pClientAddress) + Chars.LF +
                  NStr("en = 'OutputType: '; de = 'OutputType: '; ru = 'OutputType: '") + TrimAll(pOutputType) + Chars.LF +
				  NStr("en = 'NewExtReservationCode: '; de = 'NewExtReservationCode: '; ru = 'NewExtReservationCode: '") + TrimAll(pNewExtReservationCode) + Chars.LF +
				  NStr("en = 'ClientExtraData: '; de = 'ClientExtraData: '; ru = 'ClientExtraData: '") + cmGetXMLStringFromXDTO(pClientExtraData);
				  
  	// Try to find hotel by name or code
  	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);			  
  	vFuncLog = NStr("en='Write external client';ru='Записать внешнего клиента';de='den externen Kunden einschreiben'");
  	vWriteDebug = False;   
	vSearchB24Mapping = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then  
			vWriteDebug = vInteraction.DebugMode;
			If vInteraction.IntegrationType = Enums.Integrations.Bitrix24 Then
				vSearchB24Mapping = True;
			EndIf;	
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vMsg = NStr("en = 'Start of processing'; de = 'Anfang der Ausführung'; ru = 'Начало выполнения'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLog, Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg);
	Else
		WriteLogEvent(vFuncLog, EventLogLevel.Information, , , vInputParameters);
	EndIf;

	Try
		vCltObj = Undefined;
		
		// Initialize client reference
		vCltRef = Undefined;   
		
		vSuccessfullSeachByCode = False;
		
		vClientMapRow = Undefined;
		vNeedSaveOTAExtCode = False; 
		// Try to find client by bitrix 24 code
		If vSearchB24Mapping And Not IsBlankString(pExtClientCode) Then
			vClientMapRows = InformationRegisters.ExternalSystemIntegrationData.GetData(vInteraction, "clients", "updatePeriod", , , ,pExtClientCode);  
			If vClientMapRows.Count() > 0 Then 
				vClientMapRow =  vClientMapRows[0];
				vCltRef = vClientMapRow.RefKey1; 
				vSuccessfullSeachByCode = True;
			EndIf;
		EndIf;
		// Try to find client by OTA client code
		If Not vSuccessfullSeachByCode And Not IsBlankString(pExtClientCode) And ValueIsFilled(vInteraction) Then
			vCltRef = InformationRegisters.OTAID.GetClient(vInteraction, pExtClientCode);
			If ValueIsFilled(vCltRef) Then
				vSuccessfullSeachByCode = True;  
			Else
				vNeedSaveOTAExtCode = True;
			EndIf;
		EndIf;

		// Try to find client by inner client code
		If Not vSuccessfullSeachByCode And Not IsBlankString(pExtClientCode) And StrLen(pExtClientCode) = 12 Then
			vCltRef = cmGetClientByCode(pExtClientCode);
			If ValueIsFilled(vCltRef) Then
				vSuccessfullSeachByCode = True;
			EndIf;
		EndIf;
		// Try to find client by full name and birth date
		If Not vSuccessfullSeachByCode And Not IsBlankString(pClientLastName) And 
		   Not IsBlankString(pClientFirstName) And
		   ValueIsFilled(pClientBirthDate) Then
			vCltRef = cmGetClientByFullNameAndBirthdate(pClientLastName, pClientFirstName, pClientSecondName, BegOfDay(pClientBirthDate));
		EndIf;
		// Try to find client by external client code
		If Not ValueIsFilled(vCltRef) And Not IsBlankString(pExtClientCode) Then
			vCltRef = cmGetClientByExternalCode(pExtClientCode);
			If ValueIsFilled(vCltRef) Then
				vSuccessfullSeachByCode = True;
			Else
				vSuccessfullSeachByCode = False;
			EndIf;
		EndIf;

		vExtReservationCode 	= "";
		vNewExtReservationCode 	= "";
		If Not vSuccessfullSeachByCode Then
			If Not ValueIsFilled(vCltRef) And Not IsBlankString(pExtReservationCode) Then
				// We can use external reservation code only in case last name didn't change, otherwise we may overwrite different client
				vExtReservationCode = TrimAll(pClientLastName)+pExtReservationCode;
				If ValueIsFilled(pNewExtReservationCode) Then
					vNewExtReservationCode = TrimAll(pClientLastName) + pNewExtReservationCode;
				EndIf;
				vCltRef = cmGetClientByExternalCode(vExtReservationCode);
			EndIf;
			If Not ValueIsFilled(vCltRef) And Not IsBlankString(pClientPhone) Then
				vCltRef = cmGetClientByFullnameAndPhone(pClientLastName, pClientFirstName, pClientSecondName, pClientPhone);
			EndIf;
			If Not ValueIsFilled(vCltRef) And Not IsBlankString(pClientEMail) Then
				vCltRef = cmGetClientByFullnameAndEmail(pClientLastName, pClientFirstName, pClientSecondName, pClientEMail);
			EndIf;
			If ValueIsFilled(vCltRef) Then
				If Not IsBlankString(pClientSecondName) And ValueIsFilled(vCltRef.SecondName) Then
					If Lower(TrimAll(vCltRef.SecondName)) <> Lower(TrimAll(pClientSecondName)) Then
						vCltRef = Undefined;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
		// Check client reference
		If ValueIsFilled(vCltRef) Then
			// Log that we've found client by external code    
			If vWriteDebug Then
				vMsg = NStr("en = 'Client is found!'; de = 'Der Kunde wurde gefunden!'; ru = 'Клиент найден!'");
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLog, Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg);
			Else
				WriteLogEvent(vFuncLog, EventLogLevel.Information, vCltRef.Metadata(), vCltRef, vMsg);
			EndIf;
			
			// Get client object
			vCltObj = vCltRef.GetObject();
		Else
			// Create new client object
			vCltObj = Catalogs.Clients.CreateItem();
			// Author and date
			vCltObj.Author = SessionParameters.CurrentUser;
			vCltObj.CreateDate = CurrentSessionDate();
			// Default charging rules
			If vHotel.AlwaysCreateDefaultChargingRulesForNewClients Then
				vCltObj.pmCreateFolios(vHotel, vCltObj.CreateDate);
			EndIf;
			// Refused from E-Mail/SMS mailings
			If Constants.NoSMSDeliveryByDefault.Get() Then
				vCltObj.NoSMSDelivery = True;
			EndIf;
		EndIf;
		
		// External code
		If Not IsBlankString(pExtClientCode) Then
			vCltObj.ExternalCode = pExtClientCode;
		ElsIf Not IsBlankString(vExtReservationCode) Or Not IsBlankString(vNewExtReservationCode) Then
			If IsBlankString(vNewExtReservationCode) Then
				vCltObj.ExternalCode = vExtReservationCode;
			Else
				vCltObj.ExternalCode = vNewExtReservationCode;	
			EndIf;
		EndIf;
		// Parent folder
		If Not IsBlankString(pParentCode) Then
			vCltObj.Parent = Catalogs.Clients.FindByCode(pParentCode);
		EndIf;
		If Not ValueIsFilled(vCltObj.Parent) Then
			vCltObj.Parent = Catalogs.Clients.ReservedGuests;
		EndIf;
		// Language
		If ValueIsFilled(pLanguage) Then
			If ValueIsFilled(vHotel) Then
				If Not ValueIsFilled(vCltObj.Language) Or
				   ValueIsFilled(vCltObj.Language) And 
				   vCltObj.Language = vHotel.Language And 
				   pLanguage <> vHotel.Language And 
				   pLanguage <> Catalogs.Languages.RU Then
					vCltObj.Language = pLanguage;
				EndIf;
			Else
				vCltObj.Language = pLanguage;
			EndIf;
		EndIf;
		// Initialization based on hotel
		If ValueIsFilled(vHotel) Then
			// Citizenship
			If Not ValueIsFilled(vCltObj.Citizenship) Then
				If IsBlankString(pClientCitizenshipCode) Then
					vCltObj.Citizenship = vHotel.Citizenship;
				Else
					vCltObj.Citizenship = cmGetCountryByCode(pClientCitizenshipCode);
				EndIf;
			ElsIf Not IsBlankString(pClientCitizenshipCode) Then
				vClientCitizenship = cmGetCountryByCode(pClientCitizenshipCode);
				If ValueIsFilled(vClientCitizenship) And 
				   vCltObj.Citizenship <> vClientCitizenship And 
				   vClientCitizenship <> vHotel.Citizenship Then
					vCltObj.Citizenship = vClientCitizenship;
				EndIf;
			EndIf;
			// Language
			If Not ValueIsFilled(vCltObj.Language) Or vCltObj.IsNew() Then
				If ValueIsFilled(vCltObj.Citizenship) And ValueIsFilled(vCltObj.Citizenship.Language) Then
					vCltObj.Language = vCltObj.Citizenship.Language;
				Else
					vCltObj.Language = vHotel.Language;
				EndIf;
			EndIf;
			// Identity document
			If Not ValueIsFilled(vCltObj.IdentityDocumentType) Then
				If vCltObj.Citizenship = vHotel.Citizenship Then
					vCltObj.IdentityDocumentType = vHotel.IdentityDocumentType;
				Else
					vCltObj.IdentityDocumentType = vHotel.IdentityDocumentTypeForForeigners;
				EndIf;
			EndIf;
		EndIf;
		// Names
		If pExternalSystemCode = "WUBOOK" Then
			If IsBlankString(vCltObj.FirstName) Then
				vCltObj.FirstName = Title(TrimAll(pClientFirstName));
			EndIf;
			If IsBlankString(vCltObj.LastName) Then
				vCltObj.LastName = Title(TrimAll(pClientLastName));
			EndIf;
			If IsBlankString(vCltObj.SecondName) Then
				vCltObj.SecondName = Title(TrimAll(pClientSecondName));
			EndIf;
		Else
			If Not IsBlankString(pClientFirstName) Then
				vCltObj.FirstName = Title(TrimAll(pClientFirstName));
			EndIf;
			If Not IsBlankString(pClientLastName) Then
				vCltObj.LastName = Title(TrimAll(pClientLastName));
			EndIf;
			If Not IsBlankString(pClientSecondName) Then
				vCltObj.SecondName = Title(TrimAll(pClientSecondName));
			EndIf;
		EndIf;
		// Birth date
		If ValueIsFilled(pClientBirthDate) Then
			If pExternalSystemCode = "WUBOOK" Then
				If Not ValueIsFilled(vCltObj.DateOfBirth) Then
					vCltObj.DateOfBirth = BegOfDay(pClientBirthDate);
				EndIf;
			Else
				vCltObj.DateOfBirth = BegOfDay(pClientBirthDate);
			EndIf;
		EndIf;
		// Sex
		If Not IsBlankString(pClientSexCode) Then
			vSexLetter = Upper(Left(TrimAll(pClientSexCode), 1));
			If vSexLetter = "F" Or vSexLetter = "Ж" Then
				vCltObj.Sex = Enums.Sex.Female;
			ElsIf Not ValueIsFilled(vCltObj.Sex) Then
				vCltObj.Sex = Enums.Sex.Male;
			EndIf;
		ElsIf Not ValueIsFilled(vCltObj.Sex) Or 
		      ValueIsFilled(vHotel) And 
			  ValueIsFilled(vHotel.Citizenship) And 
			  vHotel.Citizenship.Code = 643 And 
			  Not IsBlankString(vCltObj.SecondName) Then
			vCltObj.Sex = cmGetSexByNames(vCltObj.LastName, vCltObj.FirstName, vCltObj.SecondName);
		EndIf;
		// Contacts
		If Not IsBlankString(pClientPhone) Then
			vCltObj.Phone = TrimAll(pClientPhone);
		EndIf;
		If Not IsBlankString(pClientFax) Then
			vCltObj.Fax = TrimAll(pClientFax);
		EndIf;
		If Not IsBlankString(pClientEMail) Then
			If IsBlankString(vCltObj.EMail) Then
				vCltObj.EMail = TrimAll(pClientEMail);
			Else
				If Not cmCheckIfEMailIsInBlackList(pClientEMail) Then
					vCltObj.EMail = TrimAll(pClientEMail);
				EndIf;
			EndIf;
		EndIf;
		// Remarks
		If Not IsBlankString(pClientRemarks) Then
			vCltObj.Remarks = TrimAll(pClientRemarks);
		EndIf;
		// No SMS delivery
		If TypeOf(pClientSendSMS) = Type("Boolean") Then
			vCltObj.NoSMSDelivery = Not pClientSendSMS;
		EndIf;
		// Identity document data
		If Not IsBlankString(pClientIdentityDocumentTypeCode) Then
			vCltObj.IdentityDocumentType = cmGetObjectRefByExternalSystemCode(vHotel, ?(ValueIsFilled(vInteraction), vInteraction.InteractionID, pExternalSystemCode), "IdentityDocumentTypes", TrimAll(pClientIdentityDocumentTypeCode));
		EndIf;
		If Not IsBlankString(pClientIdentityDocumentSeries) Then
			vCltObj.IdentityDocumentSeries = TrimAll(pClientIdentityDocumentSeries);
		EndIf;
		If Not IsBlankString(pClientIdentityDocumentNumber) Then
			vCltObj.IdentityDocumentNumber = TrimAll(pClientIdentityDocumentNumber);
		EndIf;
		If Not IsBlankString(pClientIdentityDocumentUnitCode) Then
			vCltObj.IdentityDocumentUnitCode = TrimAll(pClientIdentityDocumentUnitCode);
		EndIf;
		If Not IsBlankString(pClientIdentityDocumentIssuedBy) Then
			vCltObj.IdentityDocumentIssuedBy = TrimAll(pClientIdentityDocumentIssuedBy);
		EndIf;
		If ValueIsFilled(pClientIdentityDocumentIssueDate) Then
			vCltObj.IdentityDocumentIssueDate = pClientIdentityDocumentIssueDate;
		EndIf;
		If ValueIsFilled(pClientIdentityDocumentValidToDate) Then
			vCltObj.IdentityDocumentValidToDate = pClientIdentityDocumentValidToDate;
		EndIf;
		// Place of birth
		If Not IsBlankString(pClientPlaceOfBirth) Then
			vCltObj.PlaceOfBirth = TrimAll(pClientPlaceOfBirth);
		EndIf;
		// Address
		If Not IsBlankString(pClientAddress) Then
			vCltObj.Address = TrimAll(pClientAddress);
		EndIf;     
		If pClientExtraData <> Undefined And ValueIsFilled(pClientExtraData.ClientAddressRegistrationDate) Then
			vCltObj.AddressRegistrationDate = pClientExtraData.ClientAddressRegistrationDate;	
		EndIf;
		// Run some internal client functions to fill some client parameters
		vCltObj.Description = vCltObj.pmGetDescription();
		vCltObj.FullName = vCltObj.pmGetFullName();
		// Run some internal client functions to fill some client parameters
		vCltObj.Description = vCltObj.pmGetDescription();
		vCltObj.FullName = vCltObj.pmGetFullName();    
		If pClientExtraData <> Undefined And ValueIsFilled(pClientExtraData.EMailAdditional) Then
			vCltObj.EMailAdditional = TrimAll(pClientExtraData.EMailAdditional);	
		EndIf;	                   
		If pClientExtraData <> Undefined And ValueIsFilled(pClientExtraData.Organisation) Then
			vCltObj.FolioCustomerPresentation = TrimAll(pClientExtraData.Organisation);	
		EndIf;		
		// Write item
		vCltObj.Write();
		// Save data to the client change history
		vCltObj.pmWriteToClientChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);  
		
		// Save B24 mapping
		If vSearchB24Mapping And Not IsBlankString(pExtClientCode) And vClientMapRow = Undefined Then
			InformationRegisters.ExternalSystemIntegrationData.WriteData(vInteraction, "clients", "updatePeriod", vCltObj.Ref, , CurrentSessionDate(), pExtClientCode); 
		EndIf;
		If vNeedSaveOTAExtCode Then
			InformationRegisters.OTAID.WriteOTA_ID(vInteraction, vCltObj.Ref, pExtClientCode);
		EndIf;	
		If Not IsBlankString(pExtReservationCode) And StrLen(pExtReservationCode) = 36 Then
			vResUUID = New UUID(pExtReservationCode);
			vResRef = Documents.Reservation.GetRef(vResUUID);
		EndIf;  
		// Fill discount card
		If pClientExtraData <> Undefined And pClientExtraData.DiscountCard <> Undefined Then 
			vCardXDTO = pClientExtraData.DiscountCard;
			If Not IsBlankString(vCardXDTO.DiscountType) Then 
				// Search discount type
				vDicountType = cmGetObjectRefByExternalSystemCode(vHotel, ?(ValueIsFilled(vInteraction), vInteraction.InteractionID, pExternalSystemCode), "DiscountTypes", vCardXDTO.DiscountType);
				If ValueIsFilled(vDicountType) Then  
					vDiscountCard = Undefined;
					If Not IsBlankString(vCardXDTO.CardID) Then	
						vDiscountCard = cmGetDiscountCardById(TrimAll(vCardXDTO.CardID), True);
					EndIf;	
					If Not ValueIsFilled(vDiscountCard) And vDicountType.NumberingRule = 0 Or vDicountType.NumberingRule = 2 And Not IsBlankString(pClientPhone) Then
						// If discound card not found and cards of this discount type numbered by phone - try to get card by phone
						vDiscountCard = cmGetDiscountCardByPhone(TrimAll(pClientPhone), True);						
					EndIf;
					If ValueIsFilled(vDiscountCard) Then 
						vDCObj = vDiscountCard.GetObject();
					Else      
						// Create a discount card
						vDCObj = Catalogs.DiscountCards.CreateItem();  
					EndIf;
					vDCObj.DiscountType = vDicountType;
					vDCObj.LoyaltyType = vDicountType.LoyaltyType;
					If vDicountType.Validity > 0 Then
						vDCObj.ValidFrom = BegOfDay(CurrentSessionDate());
						vDCObj.ValidTo = vDCObj.ValidFrom + vDicountType.Validity * 86400;
					EndIf;
					vDCObj.CreateHotel = Undefined;
					vDCObj.Client = vCltObj.Ref;
					vDCObj.Phone = TrimAll(pClientPhone);
					vDCObj.Identifier = TrimAll(vCardXDTO.CardID);
					// Create discount card folio
					vDCObj.SetNewCode();
					// 0 = Phone, 1 = Code, 2 = Both- card number or phone
					If IsBlankString(vDCObj.Identifier) Then
						If vDicountType.NumberingRule = 0 Then //by phone
							vDCObj.Identifier = vDCObj.Phone;
						Else
							// 1 or 2 = by code or both
							vDCObj.Identifier = vDCObj.Code;
						EndIf;
					EndIf;
					// Save discount card
					vDCObj.Description = Catalogs.DiscountCards.GetCardDescription(vDCObj);
					vDCObj.Write();
					
					vCltObj.DiscountCard = vDCObj.Ref; 
					// Write item
					vCltObj.Write();
				EndIf;
			EndIf;
		EndIf;

		// Process client extra data
		If pClientExtraData <> Undefined And pClientExtraData.IdentityDocumentPages <> Undefined Then
			vGuestGroup = Undefined;
			If Not IsBlankString(pClientExtraData.GuestGroup) Then
				vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pClientExtraData.GuestGroup, "", "", False);
			EndIf;
			vCltDSRef = cmGetDataScansDocument(vGuestGroup, vCltObj.Ref, True, vResRef, vHotel);
			If ValueIsFilled(vCltDSRef) Then
				vCltDSObj = vCltDSRef.GetObject();
				For Each vPictureStruct In pClientExtraData.IdentityDocumentPages.Picture Do
					vScanConfiguration = Catalogs.ScanConfigurations.EmptyRef();
					vPicture = New Picture();
					If Not IsBlankString(vPictureStruct.PictureType) Then
						vScanConfiguration = cmGetObjectRefByExternalSystemCode(vHotel, ?(ValueIsFilled(vInteraction), vInteraction.InteractionID, pExternalSystemCode), "ScanConfigurations", TrimAll(vPictureStruct.PictureType));
					Endif;
					If Not IsBlankString(vPictureStruct.PictureData) Then
						vPicture = New Picture(Base64Value(vPictureStruct.PictureData));
					EndIf;
					vSPRow = vCltDSObj.ScanPictures.Find(vScanConfiguration, "ScanConfiguration");
					If vSPRow = Undefined Then
						vSPRow = vCltDSObj.ScanPictures.Add();
					EndIf;
					vSPRow.ScanConfiguration = vScanConfiguration;
					vSPRow.ScanPicture = New ValueStorage(vPicture);
				EndDo;
				If vCltDSObj.Modified() Then
					vCltDSObj.Write(DocumentWriteMode.Posting);
				EndIf;
			EndIf;
		EndIf;
		// Assign client to the reservation	
		If ValueIsFilled(vResRef) And vResRef.Posted And (vResRef.Guest <> vCltObj.Ref Or lower(TrimAll(vResRef.GuestFullName)) <> lower(TrimAll(vCltObj.FullName))) Then
			vResObj = vResRef.GetObject();
			vResObj.Guest = vCltObj.Ref;
			vResObj.Write(DocumentWriteMode.Posting);
			vResObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
		EndIf;  
		// Build return string
		vRetStr = """" + TrimAll(vCltObj.Code) + """" + "," + """" + """";   
		
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalClientStatus"));
		vRetXDTO.ClientCode = vCltObj.Code;
		vRetXDTO.ErrorDescription = "";
		
		// Log success		
		vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
		If vWriteDebug Then
			vMsg = NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLog, Enums.ExternalSystemEventTypes.Info, , vExtraXML, vMsg);
		Else
			WriteLogEvent(vFuncLog, EventLogLevel.Information, , , vExtraXML);
		EndIf;   
		
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			Return vRetXDTO;
		EndIf;
	Except
		vErrorDescription = ErrorDescription();   
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalClientStatus"));
		vRetXDTO.ClientCode = "";
		vRetXDTO.ErrorDescription = vErrorDescription;
		
		vExtraXML = cmGetXMLStringFromXDTO(vRetXDTO);
		If vWriteDebug Then
			vMsg = NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLog, Enums.ExternalSystemEventTypes.Error, , vExtraXML, vMsg);
		Else
			WriteLogEvent(vFuncLog, EventLogLevel.Error, , , vExtraXML);
		EndIf;

		// Build return string
		vRetStr = """" + """" + "," + """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
						Return vRetXDTO;
		EndIf;
	EndTry;
EndFunction // cmWriteExternalClient

// -----------------------------------------------------------------------------
Function cmGetDataScansDocument(pGuestGroup, pGuest, pCreateNewIfNotFound = False, pParentDoc = Undefined, pHotel = Undefined) Export
	vDocRef = Documents.ClientDataScans.EmptyRef();
	If ValueIsFilled(pGuest) Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	ClientDataScans.Ref AS Ref
		|FROM
		|	Document.ClientDataScans AS ClientDataScans
		|WHERE
		|	ClientDataScans.Posted
		|	AND ClientDataScans.GuestGroup = &qGuestGroup
		|	AND ClientDataScans.Guest = &qGuest
		|	AND ClientDataScans.Hotel = &qHotel
		|
		|ORDER BY
		|	ClientDataScans.PointInTime DESC";  
		If ValueIsFilled(pGuestGroup) Then
			vQry.SetParameter("qGuestGroup", pGuestGroup);
		Else
			vQry.SetParameter("qGuestGroup", Catalogs.GuestGroups.EmptyRef());	
		EndIf;
		vQry.SetParameter("qGuest", pGuest); 
		vQry.SetParameter("qHotel", pHotel);
		vDocs = vQry.Execute().Unload();
		For Each vDocsRow In vDocs Do
			vDocRef = vDocsRow.Ref;
			Break;
		EndDo;
		vDocObj = Undefined;
		If Not ValueIsFilled(vDocRef) And pCreateNewIfNotFound Then
			vDocObj = Documents.ClientDataScans.CreateDocument();
			vDocObj.Hotel = pHotel;
			If ValueIsFilled(pParentDoc) Then
				vDocObj.Fill(pParentDoc);	
			Else
				vDocObj.Fill(pGuest);
				vDocObj.GuestGroup = pGuestGroup;
			EndIf;
			vDocObj.Write(DocumentWriteMode.Posting);
			vDocRef = vDocObj.Ref;
		EndIf;
	EndIf;
	Return vDocRef;
EndFunction // cmGetDataScansDocument

// -----------------------------------------------------------------------------
// Description: Finds customer by TIN and KPP
// Parameters: Customer TIN, Customer KPP, Customer name used to create new customer, 
//             Whether to create new customer if nothing was found or not
// Return value: Customer reference
// -----------------------------------------------------------------------------
Function cmGetCustomerByExternalCode(pCustomerExternalCode) Export
	vCustomer = Catalogs.Customers.EmptyRef();
	// Try to find customer by description or external code
	If Not IsBlankString(pCustomerExternalCode) Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Customers.Ref AS Ref
		|FROM
		|	Catalog.Customers AS Customers
		|WHERE
		|	Customers.ExternalCode = &qExternalCode
		|	AND NOT Customers.DeletionMark
		|	AND NOT Customers.IsFolder
		|
		|ORDER BY
		|	Customers.Code DESC";
		vQry.SetParameter("qExternalCode", TrimAll(pCustomerExternalCode));
		vCustomers = vQry.Execute().Unload();
		If vCustomers.Count() > 0 Then
			vCustomer = vCustomers.Get(0).Ref;
		EndIf;
	EndIf;
	Return vCustomer;
EndFunction // cmGetCustomerByExternalCode

// -----------------------------------------------------------------------------
// Description: Finds customer by name
// Parameters: Customer name, Whether to create new customer if nothing was found or not
// Return value: Customer reference
// -----------------------------------------------------------------------------
Function cmGetCustomerByName(pCustomerName, pDateOfBirth = '00010101', pCreate = True, pIsIndividualPerson = False, pPaymentMethod = Undefined, pPhone = "", pEMail = "", pHotel = Undefined, pClient = Undefined) Export
	WriteLogEvent(NStr("en='Get customer by name';ru='Поиск контрагента по наименованию';de='Suche nach dem Partner nach Bezeichnung'"), EventLogLevel.Information, , , NStr("en='Input parameters: ';ru='Входные параметры: ';de='Eingangsparameter:'") + Chars.LF 
				 + NStr("en='Customer name: ';ru='Наименование контрагента: ';de='Bezeichnung des Partners: '") + pCustomerName + Chars.LF 
				 + NStr("en='Date of birth: ';ru='Дата рождения: ';de='Geburtsdatum: '") + BegOfDay(pDateOfBirth) + Chars.LF 
				 + NStr("en='Is individuals person: ';ru='Частное лицо: ';de='Privatperson: '") + pIsIndividualPerson + Chars.LF 
				 + NStr("en='Payment method: ';ru='Способ оплаты: ';de='Zahlungsmethode: '") + pPaymentMethod + Chars.LF 
				 + NStr("en='Phone: ';ru='Телефон: ';de='Telefon: '") + TrimAll(pPhone) + Chars.LF 
				 + NStr("en='E-Mail: ';ru='E-Mail: ';de='E-Mail: '") + TrimAll(pEMail) + Chars.LF 
				 + NStr("en='Client: ';ru='Клиент: ';de='Client: '") + TrimAll(pClient) + Chars.LF 
				 + NStr("en='Do create new if not found: ';ru='Создавать новую карточку если не найден: ';de='Neue Karte generieren falls nicht gefunden: '") + pCreate);
	vCustomer = Catalogs.Customers.EmptyRef();       
	If ValueIsFilled(pClient) And pIsIndividualPerson Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Customers.Ref AS Ref
		|FROM
		|	Catalog.Customers AS Customers
		|WHERE
		|	NOT Customers.DeletionMark
		|	AND NOT Customers.IsFolder
		|	AND Customers.Client = &qClient
		|	AND Customers.IsIndividual = &qIsIndividual
		|
		|ORDER BY
		|	Customers.Code DESC";
		vQry.SetParameter("qClient", pClient);
		vQry.SetParameter("qIsIndividual", pIsIndividualPerson);
		vCustomers = vQry.Execute().Unload();
		If vCustomers.Count() > 0 Then
			vCustomer = vCustomers.Get(0).Ref;
			WriteLogEvent(NStr("en='Get customer by client';ru='Поиск контрагента по клиенту';de='Suche nach dem Partner nach Bezeichnung'"), EventLogLevel.Information, , , NStr("en='Customer is found: ';ru='Найден контрагент: ';de='Partner gefunden: '") + TrimAll(vCustomer.Description) + " (" + TrimAll(vCustomer.Code) + ")");	
		EndIf;	
	EndIf;	
	// Try to find customer by description or external code
	If Not IsBlankString(pCustomerName) Then     
		If Not ValueIsFilled(vCustomer) Then 
			vQry = New Query();
			vQry.Text = 
			"SELECT
			|	Customers.Ref AS Ref
			|FROM
			|	Catalog.Customers AS Customers
			|WHERE
			|	(Customers.Description = &qCustomerName
			|			OR Customers.LegacyName = &qCustomerName
			|			OR Customers.ExternalCode = &qCustomerName)
			|	AND NOT Customers.DeletionMark
			|	AND NOT Customers.IsFolder
			|	AND (NOT &qIsIndividual
			|			OR &qIsIndividual
			|				AND Customers.IsIndividual
			|				AND (Customers.DateOfBirth = &qDateOfBirth
			|					OR &qDateOfBirthIsEmpty)
			|				AND (Customers.Phone = &qPhone
			|					OR &qPhoneIsEmpty)
			|				AND (Customers.EMail = &qEmail
			|					OR &qEMailIsEmpty))
			|
			|ORDER BY
			|	Customers.Code DESC";
			vQry.SetParameter("qCustomerName", Upper(TrimAll(pCustomerName)));
			vQry.SetParameter("qIsIndividual", pIsIndividualPerson);
			vQry.SetParameter("qDateOfBirth", BegOfDay(pDateOfBirth));
			vQry.SetParameter("qDateOfBirthIsEmpty", Not ValueIsFilled(BegOfDay(pDateOfBirth)));
			vQry.SetParameter("qPhone", SMS.GetValidPhoneNumber(TrimAll(pPhone)));
			vQry.SetParameter("qPhoneIsEmpty", IsBlankString(TrimAll(pPhone)));
			vQry.SetParameter("qEMail", Lower(TrimAll(pEMail)));
			vQry.SetParameter("qEMailIsEmpty", IsBlankString(TrimAll(pEMail)));
			vCustomers = vQry.Execute().Unload();
			If vCustomers.Count() > 0 Then
				vCustomer = vCustomers.Get(0).Ref;
				WriteLogEvent(NStr("en='Get customer by name';ru='Поиск контрагента по наименованию';de='Suche nach dem Partner nach Bezeichnung'"), EventLogLevel.Information, , , NStr("en='Customer is found: ';ru='Найден контрагент: ';de='Partner gefunden: '") + TrimAll(vCustomer.Description) + " (" + TrimAll(vCustomer.Code) + ")");
			EndIf;	
		EndIf;	
		If Not ValueIsFilled(vCustomer) And pCreate Then
			WriteLogEvent(NStr("en='Get customer by name';ru='Поиск контрагента по наименованию';de='Suche nach dem Partner nach Bezeichnung'"), EventLogLevel.Information, , , NStr("en='Customer is not found!';ru='Не найден контрагент!';de='Partner nicht gefunden!'"));
			// Create new customer
			vCustomerObj = Catalogs.Customers.CreateItem();
			If pIsIndividualPerson Then
				vIndividualsFolder = Constants.IndividualsFolder.Get();
				If Not ValueIsFilled(vIndividualsFolder) Then
					vIndividualsFolder = Catalogs.Customers.IndividualsFolder;
				EndIf;
				vCustomerObj.Parent = vIndividualsFolder;
				If ValueIsFilled(pDateOfBirth) Then
					vCustomerObj.DateOfBirth = pDateOfBirth;
				EndIf;     
				vCustomerObj.Client = pClient;
				vCustomerObj.IsIndividual = True;
			EndIf;
			If Not IsBlankString(pPhone) Then
				vCustomerObj.Phone = SMS.GetValidPhoneNumber(TrimAll(pPhone));
			EndIf;
			If Not IsBlankString(pEMail) Then
				vCustomerObj.EMail = Lower(TrimAll(pEMail));
			EndIf;
			vCustomerObj.Description = TrimAll(pCustomerName);
			vCustomerObj.pmFillAttributesWithDefaultValues(pHotel);
			If ValueIsFilled(pPaymentMethod) Then
				vCustomerObj.PlannedPaymentMethod = pPaymentMethod;
				If vCustomerObj.ChargingRules.Count() > 0 Then
					v1CRRow = vCustomerObj.ChargingRules.Get(0);
					v1CRRowFolioObj = v1CRRow.ChargingFolio.GetObject();
					v1CRRowFolioObj.PaymentMethod = pPaymentMethod;
					v1CRRowFolioObj.Write(DocumentWriteMode.Write);
				EndIf;
			EndIf;   
			vCustomerObj.Write();
			// Save data to the customer change history
			vCustomerObj.pmWriteToCustomerChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			// Fill reference
			vCustomer = vCustomerObj.Ref;
		EndIf;
	EndIf;
	Return vCustomer;
EndFunction // cmGetCustomerByName 

// -----------------------------------------------------------------------------
// Description: Finds customer by TIN and KPP
// Parameters: Customer TIN, Customer KPP, Customer name used to create new customer, 
//             Whether to create new customer if nothing was found or not
// Return value: Customer reference
// -----------------------------------------------------------------------------
Function cmGetCustomerByTIN(pCustomerTIN, pCustomerKPP, pCustomerName, pCreate = True) Export
	vCustomer = Catalogs.Customers.EmptyRef();
	// Try to find customer by description or external code
	If Not IsBlankString(pCustomerTIN) Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Customers.Ref AS Ref
		|FROM
		|	Catalog.Customers AS Customers
		|WHERE
		|	Customers.TIN = &qCustomerTIN
		|	AND (NOT &qDoNotCheckKPP
		|				AND Customers.KPP = &qCustomerKPP
		|			OR &qDoNotCheckKPP)
		|	AND NOT Customers.DeletionMark
		|	AND NOT Customers.IsFolder
		|
		|ORDER BY
		|	Customers.Description";
		vQry.SetParameter("qCustomerTIN", TrimAll(pCustomerTIN));
		vQry.SetParameter("qCustomerKPP", TrimAll(pCustomerKPP));
		If IsBlankString(pCustomerKPP) Or StrLen(TrimAll(pCustomerTIN)) > 10 Then
			vQry.SetParameter("qDoNotCheckKPP", True);
		Else
			vQry.SetParameter("qDoNotCheckKPP", False);
		EndIf;
		vCustomers = vQry.Execute().Unload();
		If vCustomers.Count() > 0 Then
			vCustomer = vCustomers.Get(0).Ref;
		ElsIf pCreate And Not IsBlankString(pCustomerName) Then
			// Create new customer
			vCustomerObj = Catalogs.Customers.CreateItem();
			vCustomerObj.Description = TrimAll(pCustomerName);
			vCustomerObj.LegacyName = Title(TrimAll(vCustomerObj.Description));
			vCustomerObj.TIN = TrimAll(pCustomerTIN);
			vCustomerObj.KPP = TrimAll(pCustomerKPP);
			vCustomerObj.pmFillAttributesWithDefaultValues();
			vCustomerObj.Write();
			// Save data to the customer change history
			vCustomerObj.pmWriteToCustomerChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			// Fill reference
			vCustomer = vCustomerObj.Ref;
		EndIf;
	EndIf;
	Return vCustomer;
EndFunction // cmGetCustomerByTIN 

// -----------------------------------------------------------------------------
// Description: Finds contract by description
// Parameters: Customer ref, Contract description, Whether to create new contract 
//             if nothing was found or not
// Return value: Contract reference
// -----------------------------------------------------------------------------
Function cmGetContractByName(pCustomerRef, pContractName, pCreate = True) Export
	vContract = Catalogs.Contracts.EmptyRef();
	// Try to find contract by code, description or external code
	If Not IsBlankString(pContractName) Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Contracts.Ref AS Ref
		|FROM
		|	Catalog.Contracts AS Contracts
		|WHERE
		|	(Contracts.Code = &qContractName
		|			OR Contracts.Description = &qContractName
		|			OR Contracts.ExternalCode = &qContractName)
		|	AND NOT Contracts.DeletionMark
		|	AND Contracts.Owner = &qCustomer
		|
		|ORDER BY
		|	Contracts.Code";
		vQry.SetParameter("qContractName", TrimAll(pContractName));
		vQry.SetParameter("qCustomer", pCustomerRef);
		vContracts = vQry.Execute().Unload();
		If vContracts.Count() > 0 Then
			vContract = vContracts.Get(0).Ref;
		ElsIf pCreate And ValueIsFilled(pCustomerRef) Then
			// Create new contract
			vContractObj = Catalogs.Contracts.CreateItem();
			vContractObj.Code = TrimAll(pContractName);
			vContractObj.Description = TrimAll(pContractName);
			vContractObj.Owner = pCustomerRef;
			vContractObj.pmFillAttributesWithDefaultValues();
			vContractObj.Write();
			// Save data to the contract change history
			vContractObj.pmWriteToContractChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
			// Fill reference
			vContract = vContractObj.Ref;
		EndIf;
	EndIf;
	Return vContract;
EndFunction // cmGetContractByName 

// -----------------------------------------------------------------------------
// Description: Searches reservation by it's external code
// Parameters: Hotel, Reservation external code
// Return value: Reservation reference
// -----------------------------------------------------------------------------
Function cmGetReservationByExternalCode(pHotelRef, pExtReservationCode) Export
	vReservation = Documents.Reservation.EmptyRef();
	// Try to find reservation by external code
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Reservations.Ref AS Ref
	|FROM
	|	Document.Reservation AS Reservations
	|WHERE
	|	Reservations.ExternalCode = &qExternalCode
	|	AND NOT Reservations.DeletionMark
	|	AND Reservations.Hotel = &qHotel
	|
	|ORDER BY
	|	Reservations.PointInTime";
	vQry.SetParameter("qHotel", pHotelRef);
	vQry.SetParameter("qExternalCode", TrimAll(pExtReservationCode));
	vReservations = vQry.Execute().Unload();
	If vReservations.Count() > 0 Then
		vReservation = vReservations.Get(0).Ref;
	ElsIf StrLen(pExtReservationCode) = 12 Then
		// Try to find reservation by external code
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	Reservations.Ref
		|FROM
		|	Document.Reservation AS Reservations
		|WHERE
		|	Reservations.Number = &qExternalCode
		|	AND NOT Reservations.DeletionMark
		|	AND Reservations.Hotel = &qHotel
		|
		|ORDER BY
		|	Reservations.PointInTime";
		vQry.SetParameter("qHotel", pHotelRef);
		vQry.SetParameter("qExternalCode", TrimAll(pExtReservationCode));
		vReservations = vQry.Execute().Unload();
		If vReservations.Count() > 0 Then
			vReservation = vReservations.Get(0).Ref;
		EndIf;
	ElsIf StrLen(pExtReservationCode) = 36 Then 
		Try
			vDoc = Documents.Reservation.GetRef(New UUID(TrimAll(pExtReservationCode))); 
			If Not vDoc.GetObject() = Undefined Then
				vReservation = vDoc; 
			EndIf;	   
		Except EndTry;
	EndIf;
	Return vReservation;
EndFunction // cmGetReservationByExternalCode

// -----------------------------------------------------------------------------
// Description: Searches guest group by it's external code. This function can 
//              create new guest group if nothing was found
// Parameters: Hotel, Guest group external code, Guest group description, 
//             Guest group customer name as string, Whether to create new guest 
//             group if nothing was found
// Return value: Guest froup reference
// -----------------------------------------------------------------------------
Function cmGetGuestGroupByExternalCode(pHotelRef, pExtGroupCode, pExtGroupDescription, pGroupCustomerName, pCreateNew = True, pID = "") Export
	vGuestGroup = Catalogs.GuestGroups.EmptyRef();
	If IsBlankString(pExtGroupCode) Then
		Return vGuestGroup;
	EndIf;
	// Try to find guest group by external code
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	GuestGroups.Ref AS Ref
	|FROM
	|	Catalog.GuestGroups AS GuestGroups
	|WHERE
	|	(GuestGroups.ExternalCode = &qExternalCode
	|			OR GuestGroups.Description = &qExternalCode)
	|	AND NOT GuestGroups.DeletionMark
	|	AND NOT GuestGroups.IsFolder
	|	AND GuestGroups.Owner = &qHotel
	|
	|ORDER BY
	|	GuestGroups.Code";
	vQry.SetParameter("qHotel", pHotelRef);
	vQry.SetParameter("qExternalCode", TrimAll(pExtGroupCode));
	vGuestGroups = vQry.Execute().Unload();
	If vGuestGroups.Count() > 0 Then
		vGuestGroup = vGuestGroups.Get(0).Ref;
	ElsIf pCreateNew Then
		// Create new guest group
		vGuestGroupObj = Catalogs.GuestGroups.CreateItem();
		vGuestGroupObj.Owner = pHotelRef;
		vGuestGroupFolder = pHotelRef.GetObject().pmGetGuestGroupFolder();
		If ValueIsFilled(vGuestGroupFolder) Then
			vGuestGroupObj.Parent = vGuestGroupFolder;
			vGuestGroupObj.SetNewCode();
		EndIf;
		If ValueIsFilled(vGuestGroupObj.Owner) Then
			vGuestGroupObj.OneCustomerPerGuestGroup = vGuestGroupObj.Owner.OneCustomerPerGuestGroup;
		EndIf;
		If Not IsBlankString(TrimAll(pExtGroupCode)) And TrimAll(pExtGroupCode) <> "0" Then
			vGuestGroupObj.ExternalCode = TrimAll(pExtGroupCode);
			If StrLen(TrimAll(pExtGroupCode)) < 36 Then
				If IsBlankString(pExtGroupDescription) Then
					vGuestGroupObj.Description = TrimAll(pExtGroupCode);
				Else
					vGuestGroupObj.Description = TrimAll(pExtGroupDescription);
				EndIf;
				
				If Not IsBlankString(pID) Then
					vGuestGroupObj.ID = TrimAll(pID);
				Else
					vGuestGroupObj.ID = TrimAll(pExtGroupCode);
				EndIf;
			Else
				vGuestGroupObj.Description = TrimAll(pExtGroupDescription);
			EndIf;
		Else
			vGuestGroupObj.Description = TrimAll(pExtGroupDescription);
		EndIf;
		If Not IsBlankString(pGroupCustomerName) Then
			vGuestGroupObj.Customer = cmGetCustomerByName(pGroupCustomerName, , , , , , , pHotelRef);
		EndIf;
		vGuestGroupObj.Write();
		// Fill reference
		vGuestGroup = vGuestGroupObj.Ref;
	ElsIf cmIsNumber(pExtGroupCode) And Format(Number(pExtGroupCode), "NFD=0; NG=") = TrimAll(pExtGroupCode) Then
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	GuestGroups.Ref AS Ref
		|FROM
		|	Catalog.GuestGroups AS GuestGroups
		|WHERE
		|	GuestGroups.Code = &qExternalCode
		|	AND NOT GuestGroups.DeletionMark
		|	AND NOT GuestGroups.IsFolder
		|	AND GuestGroups.Owner = &qHotel
		|
		|ORDER BY
		|	GuestGroups.Code";
		vQry.SetParameter("qHotel", pHotelRef);
		vQry.SetParameter("qExternalCode", Number(pExtGroupCode));
		vGuestGroups = vQry.Execute().Unload();
		If vGuestGroups.Count() > 0 Then
			vGuestGroup = vGuestGroups.Get(0).Ref;
		EndIf;
	EndIf;
	Return vGuestGroup;
EndFunction // cmGetGuestGroupByExternalCode

// -----------------------------------------------------------------------------
// Description: Searches customer contract by contract type
// Parameters: Hotel, Company, Customer, Contract type, Periiod from, Period to
// Return value: Contract reference
// -----------------------------------------------------------------------------
Function cmGetCustomerContractByContractType(pHotel, pCompany, pCustomer, pContractType, pPeriodFrom, pPeriodTo) Export
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Contracts.Ref AS Ref
	|FROM
	|	Catalog.Contracts AS Contracts
	|WHERE
	|	NOT Contracts.DeletionMark
	|	AND Contracts.Owner = &qCustomer
	|	AND Contracts.ContractType = &qContractType
	|	AND (Contracts.Hotel = &qHotel
	|			OR Contracts.Hotel = &qEmptyHotel)
	|	AND (NOT &qCompanyIsFilled
	|			OR &qCompanyIsFilled
	|				AND Contracts.Company = &qCompany)
	|	AND (Contracts.PeriodCheckType = &qByCheckInDates
	|				AND Contracts.ValidFromDate <= &qPeriodFrom
	|				AND (Contracts.ValidToDate >= &qPeriodTo
	|					OR Contracts.ValidToDate = &qEmptyDate)
	|			OR Contracts.PeriodCheckType = &qByReservationDate
	|				AND Contracts.ValidFromDate <= &qCurrentDate
	|				AND (Contracts.ValidToDate >= &qCurrentDate
	|					OR Contracts.ValidToDate = &qEmptyDate))
	|
	|ORDER BY
	|	Contracts.CreateDate DESC,
	|	Contracts.ValidFromDate,
	|	Contracts.Description";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qEmptyHotel", Catalogs.Hotels.EmptyRef());
	vQry.SetParameter("qCustomer", pCustomer);
	vQry.SetParameter("qContractType", pContractType);
	vQry.SetParameter("qCompany", pCompany);
	vQry.SetParameter("qCompanyIsFilled", ValueIsFilled(pCompany));
	vQry.SetParameter("qByCheckInDates", 0);
	vQry.SetParameter("qByReservationDate", 1);
	vQry.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom));
	vQry.SetParameter("qPeriodTo", BegOfDay(pPeriodTo));
	vQry.SetParameter("qEmptyDate", '00010101');
	vQry.SetParameter("qCurrentDate", CurrentSessionDate());
	vContracts = vQry.Execute().Unload();
	For Each vContractsRow In vContracts Do
		Return vContractsRow.Ref;
	EndDo;
	Return Undefined;
EndFunction // cmGetCustomerContractByContractType

// -----------------------------------------------------------------------------
// Description: This API is used to create/update reservation from the external system.
//              Reservation will not be posted by default
// Parameters: External reservation data, External system code, Whether to post 
//             new reservation or write only, Returns error description if any
// Return value: Reservation object
// -----------------------------------------------------------------------------
Function cmWriteExternalReservationRow(pExtReservationCode, pExtGroupCode, pExtGroupDescription, pGroupCustomerName,  
                                       pReservationStatusCode, pPeriodFrom, pPeriodTo, pHotelCode, pRoomTypeCode, 
                                       pAccommodationTypeCode, pClientTypeCode, pRoomQuotaCode, pRoomRateCode,
                                       pCustomerName, pContractName, pAgentName, pContactPerson, 
                                       pNumberOfRooms, pNumberOfPersons, 
                                       pExtClientCode, pClientLastName, pClientFirstName, pClientSecondName, 
                                       pClientSexCode, pClientCitizenshipCode, pClientBirthDate, 
                                       pClientPhone, pClientFax, pClientEMail, pClientRemarks, pClientSendSMS = Undefined, pRemarks, pCar, 
                                       pPlannedPaymentMethodCode, pCreateDate = Undefined, pExternalSystemCode, pDoPosting = False, 
									   pPromoCode = "", rErrorDescription = "", pSkipNotification = False, 
									   pReservationNumber = "", pRoomReservation = Undefined, pIgnoreCustomerChargingRules = False,
									   pLanguage = Undefined, rOldReservationStatus = Undefined, pTransferData = Undefined, pExtraServices = Undefined, 
									   pCreditCardData = Undefined, pDiscountType = Undefined, pDiscountSum = Undefined, pRoomCode = "", 
									   pChargeExtraServices = Undefined, pGuaranteeTypeCode = "", pPricesPerDate = Undefined, pLogin = "", 
									   pClientPlaceOfBirth = "", pClientAddress = "", pClientAddressRegistrationDate = '00010101', pAuthor = "", pMarketingCode = "", pSourceOfBusinessCode = "", pCustomerData = Undefined, 
									   pRatePlans = Undefined,  pClientIdentityDocumentTypeCode = "", pClientIdentityDocumentSeries = "", pClientIdentityDocumentNumber = "", 
								 	   pClientIdentityDocumentIssueDate = '00010101', pClientIdentityDocumentValidToDate = '00010101', pClientIdentityDocumentUnitCode = "", 
									   pClientIdentityDocumentIssuedBy = "",
									   pAccommodationTemplate = Undefined, pGuestAge = 0, pIsUpgrade = False, pMealBoardTerm = Undefined, pNewReservationCode = Undefined, pID = "", 
									   pRoomClass = Undefined, pNewExtGroupCode = Undefined, pDiscountConfirmationText = "", pPriceCalculationDate = '00010101') Export
	If TypeOf(pClientBirthDate) <> Type("Date") Then
		pClientBirthDate = '00010101';
	EndIf;
	vDocObj = Undefined;

	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);

	// Interaction
	vExtSystem = Undefined;
	If Not IsBlankString(TrimAll(pExternalSystemCode)) Then
		vExtSystem = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
	EndIf;

	// Try to find marketing code
	vMarketingCode = Undefined;
	If IsBlankString(pMarketingCode) Then
		vMarketingCode = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "MarketingCodes", pExternalSystemCode);
	Else
		vMarketingCode = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "MarketingCodes", pMarketingCode);
	EndIf;
	// Try to find source of business
	vSourceOfBusiness = Undefined;
	If IsBlankString(pSourceOfBusinessCode) Then
		vSourceOfBusiness = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "SourcesOfBusiness", pExternalSystemCode);
	Else
		vSourceOfBusiness = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "SourcesOfBusiness", pSourceOfBusinessCode);
	EndIf;
	
	// Fill guest group external code
	vGuestGroup = Undefined;
	If Not IsBlankString(TrimAll(pExternalSystemCode)) And Not IsBlankString(TrimAll(pID)) Then
		If ValueIsFilled(vExtSystem) And vExtSystem.IntegrationType = Enums.Integrations.Bitrix24 Then
			// Bitrix24 deal ID is stored in special mapping register. Retrieve it.
	       	vTDeals = InformationRegisters.ExternalSystemIntegrationData.GetData(vExtSystem, "deals", "updatePeriod", Undefined, Undefined, Undefined, pID);
			If ValueIsFilled(vTDeals) And vTDeals.Count() > 0 Then
				vGuestGroup =  vTDeals[0].RefKey1;
			EndIf;
		EndIf;
	EndIf;
	If vGuestGroup = Undefined And Not IsBlankString(pExtGroupCode) Then
		vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pExtGroupCode, pExtGroupDescription, pGroupCustomerName, , pID);
	EndIf;

	vUse_client = False;
	If ValueIsFilled(vExtSystem) And vExtSystem.UseClient Or ValueIsFilled(pCustomerName) And pCustomerName = "USE_CLIENT" Then
		vUse_client = True;
	EndIf;	

	// Extra services
	vExtraServices = New ValueList();
	vOrders = New ValueList();
	If pExtraServices <> Undefined And TypeOf(pExtraServices) = Type("ValueList") Then
		vExtraServices = pExtraServices.Copy();
	EndIf;
	Try
		If pChargeExtraServices <> Undefined Then
			If TypeOf(pChargeExtraServices) = Type("ValueList") Then
				For Each vExtraChargeSeviceItem In pChargeExtraServices Do
					vExtraServices.Add(vExtraChargeSeviceItem.Value);
				EndDo;
			Else
				For Each vExtraChargeSevice In pChargeExtraServices.ChargeExtraServiceRow Do
					If vExtraChargeSevice <> Undefined Then
						Try
							// Fill sum if its Undefined
							If vExtraChargeSevice.Sum = Undefined Then
								If vExtraChargeSevice.Price <> Undefined Then
									If vExtraChargeSevice.Quantity <> Undefined And vExtraChargeSevice.Quantity > 0 Then
										vExtraChargeSevice.Sum = vExtraChargeSevice.Price * vExtraChargeSevice.Quantity; 
									Else
										vExtraChargeSevice.Sum = vExtraChargeSevice.Price; 
									EndIf;
								EndIf;
							EndIf;
							
							vServiceRef = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Services", vExtraChargeSevice.Service);
							If Not ValueIsFilled(vServiceRef) And ValueIsFilled(vExtSystem) Then
								vServiceMapping = InformationRegisters.ExternalSystemIntegrationData.GetData(vExtSystem, "services", "id", , , , vExtraChargeSevice.Service);
								For Each vServiceMappingRow In vServiceMapping Do
									vServiceRef = vServiceMappingRow.RefKey1;
									Break;
								EndDo;
							EndIf;
							
							If vExtraChargeSevice.OrderType = Undefined Then
								vOrderType = Undefined;
								If ValueIsFilled(vServiceRef) Then
									vOrderType = GetOrderTypeByService(vServiceRef, vHotel);
								EndIf;
								If ValueIsFilled(vOrderType) Then
									vOrderItem = New Structure("Service, Price, Quantity, Remarks, Currency, ChargeDate, Department, Destination, OrderType, PassengersNumber, Sum, TransferChildseats, OrderDate, TransferRemarks, TransferType", vServiceRef, vExtraChargeSevice.Price, vExtraChargeSevice.Quantity, vExtraChargeSevice.Remarks, vExtraChargeSevice.Currency, vExtraChargeSevice.ChargeDate, vExtraChargeSevice.Department, vExtraChargeSevice.Destination, TrimAll(vOrderType.Code), vExtraChargeSevice.PassengersNumber, vExtraChargeSevice.Sum, vExtraChargeSevice.TransferChildseats, vExtraChargeSevice.OrderDate, vExtraChargeSevice.TransferRemarks, vExtraChargeSevice.TransferType);
									vOrders.Add(vOrderItem);
								Else
									vExtraServicesItem = New Structure("Service, Price, Quantity, Remarks, Currency, ChargeDate", vExtraChargeSevice.Service, vExtraChargeSevice.Price, vExtraChargeSevice.Quantity, vExtraChargeSevice.Remarks, vExtraChargeSevice.Currency, vExtraChargeSevice.ChargeDate);
									vExtraServices.Add(vExtraServicesItem);
								EndIf;
							Else
								vOrderItem = New Structure("Service, Price, Quantity, Remarks, Currency, ChargeDate,Department, Destination, OrderType, PassengersNumber,Sum,TransferChildseats,OrderDate,TransferRemarks,TransferType", vServiceRef, vExtraChargeSevice.Price, vExtraChargeSevice.Quantity, vExtraChargeSevice.Remarks, vExtraChargeSevice.Currency, vExtraChargeSevice.ChargeDate, vExtraChargeSevice.Department, vExtraChargeSevice.Destination, vExtraChargeSevice.OrderType, vExtraChargeSevice.PassengersNumber, vExtraChargeSevice.Sum, vExtraChargeSevice.TransferChildseats, vExtraChargeSevice.OrderDate, vExtraChargeSevice.TransferRemarks, vExtraChargeSevice.TransferType);
								vOrders.Add(vOrderItem);
							EndIf;
						Except
							vErrorDescriptionTemp = ErrorDescription();
							WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
					  		              NStr("en='ChargeExtraServices row data error: ';ru='Ошибка в персональном блоке ChargeExtraServices: ';de='Fehlerbeschreibung: '") + vErrorDescriptionTemp);
						EndTry;
					EndIf;
				EndDo;
			EndIf;
		EndIf;
	Except
		vErrorDescription = ErrorDescription();
		WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
					  NStr("en='ChargeExtraServices row data error: ';ru='Ошибка в персональном блоке ChargeExtraServices: ';de='Fehlerbeschreibung: '") + vErrorDescription);
	EndTry;
	
	// Initialize occupation percents
	vOccupationPercents = Undefined;
	
	// Try to get accommodation type
	vAccommodationType = Undefined;
	If Not IsBlankString(pAccommodationTypeCode) Then
		vAccommodationType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "AccommodationTypes", pAccommodationTypeCode);
		// Reset reservation number
		If ValueIsFilled(vAccommodationType) And 
		  (vAccommodationType.Type = Enums.AccomodationTypes.Room) Then
			pReservationNumber = "";
		ElsIf ValueIsFilled(vAccommodationType) And Not IsBlankString(pReservationNumber) Then
			vOneRoomDoc = cmGetOneRoomReservation(pReservationNumber, vGuestGroup);
			If ValueIsFilled(vOneRoomDoc) Then
				vOccupationPercents = vOneRoomDoc.OccupationPercents.Unload();
			EndIf;
		EndIf;
	EndIf;
	
	// Try to get discount type
	vDiscountType = Undefined;
	If Not IsBlankString(pDiscountType) Then
		vDiscountType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "DiscountTypes", pDiscountType);
	EndIf;
	
	// Try to find existing reservation with given external code
	If Not IsBlankString(pExtReservationCode) Then
		vDocRef = cmGetReservationByExternalCode(vHotel, pExtReservationCode);
	EndIf;
	If ValueIsFilled(vDocRef) Then
		// Log that we've found client by external code
		WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Information, vDocRef.Metadata(), vDocRef, NStr("en='Reservation is found by external code!';ru='Бронь найдена по коду во внешней системе!';de='Die Reservierung wurde nach dem Code im externen System gefunden!'"));
		// Save current reservation status
		rOldReservationStatus = vDocRef.ReservationStatus;
		// Get reservation object
		vDocObj = vDocRef.GetObject();
		// Fill reservation status
		vReservationStatus = Catalogs.ReservationStatuses.EmptyRef();
		If ValueIsFilled(vHotel) Then
			vReservationStatus = vHotel.NewReservationStatus;
			If Not IsBlankString(pReservationStatusCode) Then
				vReservationStatus = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ReservationStatuses", pReservationStatusCode);
			EndIf;
			If ValueIsFilled(vReservationStatus) And vDocObj.ReservationStatus <> vReservationStatus Then
				If Not vDocObj.ReservationStatus.IsCheckIn Then
					vDocObj.ReservationStatus = vReservationStatus;
					If Not ValueIsFilled(vDocObj.GuaranteeType) And vDocObj.ReservationStatus.IsGuaranteed And ValueIsFilled(vDocObj.ReservationStatus.GuaranteeType) Then
						vDocObj.GuaranteeType = vDocObj.ReservationStatus.GuaranteeType;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
		// Fill guest group external code
		If Not IsBlankString(pExtGroupCode) Then
			vDocObj.GuestGroup = vGuestGroup;
		EndIf;
	Else
		// Create new reservation
		vDocObj = Documents.Reservation.CreateDocument();
		// Fill reservation hotel
		If ValueIsFilled(vHotel) And vHotel <> SessionParameters.CurrentHotel Then
			vDocObj.Hotel = vHotel;
			If IsBlankString(pReservationNumber) Then
				vDocObj.SetNewNumber();
			EndIf;
		EndIf;
		// Fill reservation number
		If Not IsBlankString(pReservationNumber) Then
			vDocObj.Number = TrimR(pReservationNumber);
		EndIf;
		// Fill reservation status
		If Not IsBlankString(pReservationStatusCode) Then
			vDocObj.ReservationStatus = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ReservationStatuses", pReservationStatusCode);
			If ValueIsFilled(vDocObj.ReservationStatus) And Not ValueIsFilled(vDocObj.GuaranteeType) And vDocObj.ReservationStatus.IsGuaranteed And ValueIsFilled(vDocObj.ReservationStatus.GuaranteeType) Then
				vDocObj.GuaranteeType = vDocObj.ReservationStatus.GuaranteeType;
			EndIf;
		EndIf;
		// Fill guest group external code
		If Not IsBlankString(pExtGroupCode) Then
			vDocObj.GuestGroup = vGuestGroup;
		Endif;
		// Fill other default atributes
		vDocObj.pmFillAttributesWithDefaultValues();
		// Fill author
		If Not IsBlankString(pAuthor) Then
			vAuthor = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Employees", pAuthor);
			If Not ValueIsFilled(vAuthor) Then
				vAuthor = cmGetObjectRefByExternalSystemCode(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Employees", pAuthor);
			EndIf;
			If ValueIsFilled(vAuthor) Then
				vDocObj.Author = vAuthor;
				Try
					SessionParameters.CurrentUser = vAuthor;
				Except
				EndTry;
			EndIf;
		EndIf;
		// Employee company
		If ValueIsFilled(SessionParameters.CurrentUser) And ValueIsFilled(SessionParameters.CurrentUser.Company) Then
			vDocObj.Company = SessionParameters.CurrentUser.Company;
		EndIf;
		// External code
		If ValueIsFilled(pNewReservationCode) Then
			vDocObj.ExternalCode = TrimAll(pNewReservationCode);
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Information, vDocRef.Metadata(), vDocRef, NStr("en = 'Reservation external code has been changed!'; de = 'Der externe Reservierungscode wurde geändert!'; ru = 'Внешний код брони изменен!'") + "; " + pExtReservationCode + " => " + pNewReservationCode);
		Else
			vDocObj.ExternalCode = TrimAll(pExtReservationCode);
		EndIf;
		// Create date
		If ValueIsFilled(pCreateDate) Then
			vDocObj.SetTime(AutoTimeMode.DontUse);
			vDocObj.Date = pCreateDate;
			If Not IsBlankString(pReservationNumber) Then
				vDocObj.Date = vDocObj.Date + 1;
			EndIf;
		EndIf;
		// Price calculation date
		If ValueIsFilled(pPriceCalculationDate) Then
			vDocObj.PriceCalculationDate = pPriceCalculationDate;
		EndIf;
	EndIf;
	// Check should we do chargings
	vDocObj.pmSetDoCharging();
	
	// Fill base reservation attributes
	vDocObj.CheckInDate = cm1SecondShift(pPeriodFrom);
	vDocObj.Duration = 0; // will be calculated further
	vDocObj.CheckOutDate = cm0SecondShift(pPeriodTo);
	
	// Update price calculation date
	vDocObj.pmUpdatePriceCalculationDate();
	
	// Allotment
	vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode);
	If Not IsBlankString(pRoomTypeCode) Then
		vDocObj.RoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode);
	ElsIf IsBlankString(pRoomTypeCode) And Not IsBlankString(pRoomClass) Then
		vRoomClass = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypeClasses", pRoomClass);
		If ValueIsFilled(vRoomClass) Then
			vRoomTypesByClass = cmGetAllRoomTypes(vHotel, , vRoomClass);
			If vRoomTypesByClass.Count() > 0 Then
				vRoomTypeList = cmGetRoomTypesWithBalancesByClass(vHotel, vRoomClass, vRoomQuota, vDocObj.CheckInDate, vDocObj.CheckOutDate);
				If vRoomTypeList.Count() > 0 Then
					vDocObj.RoomType = vRoomTypeList[0].RoomType;
				EndIf;	
			EndIf;
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.RoomType) And ValueIsFilled(vDocObj.RoomType.BaseRoomType) Then
		vDocObj.RoomTypeUpgrade = vDocObj.RoomType;
		vDocObj.RoomType = vDocObj.RoomType.BaseRoomType;
	EndIf;
	If ValueIsFilled(vAccommodationType) Then
		vDocObj.AccommodationType = vAccommodationType;
	EndIf;
	If ValueIsFilled(vDiscountType) Then
		vDocObj.DiscountType = vDiscountType;
		vDocObj.DiscountServiceGroup = vDiscountType.DiscountServiceGroup;
		If vDiscountType.IsAmountDiscount And ValueIsFilled(pDiscountSum) Then
			If cmIsNumber(pDiscountSum) Then
				vDocObj.DiscountSum = Number(pDiscountSum);
			EndIf;
		Else
			If vDiscountType.IsAccumulatingDiscount Then
				For Each vDocSrvRow In vDocObj.Services Do
					If vDocSrvRow.IsManual Then
						If cmIsServiceInServiceGroup(vDocSrvRow.Service, vDocObj.DiscountServiceGroup) Then
							vDocObj.pmCalculateAccumulationDiscountForAdditionalService(vDocSrvRow);
							vDocObj.pmCalculateServiceDiscounts(vDocSrvRow);
						Else
							vDocSrvRow.DiscountType = Catalogs.DiscountTypes.EmptyRef();
							vDocSrvRow.DiscountServiceGroup = Catalogs.ServiceGroups.EmptyRef();
							vDocSrvRow.Discount = 0;
							vDocSrvRow.DiscountConfirmationText = "";
						EndIf;
					EndIf;
				EndDo;
			Else
				vDiscountTypeObj = vDiscountType.GetObject();
				vDocObj.Discount = vDiscountTypeObj.pmGetDiscount(vDocObj.CheckInDate, , vDocObj.Hotel);
			EndIf;
		EndIf;
		If Not IsBlankString(pDiscountConfirmationText) Then
			vDocObj.DiscountConfirmationText = TrimAll(pDiscountConfirmationText);
		EndIf;
	EndIf;
	If Not IsBlankString(pClientTypeCode) Then
		vDocObj.ClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode);
	EndIf;
	If Not IsBlankString(pRoomRateCode) And TrimAll(pRoomRateCode) <> "0" Then
		vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode);
		If ValueIsFilled(vRoomRate) And vRoomRate <> vDocObj.RoomRate Then
			vDocObj.RoomRate = vRoomRate;
			vDocObj.PriceCalculationDate = '00010101';
		EndIf;
	EndIf;
	If Not ValueIsFilled(vDocObj.RoomRate) Then
		If ValueIsFilled(vDocObj.Hotel) Then
			vDocObj.RoomRate = vDocObj.Hotel.RoomRate;
			vDocObj.PriceCalculationDate = '00010101';
		EndIf;
	EndIf;
	If pIsUpgrade <> Undefined And pIsUpgrade Then
		If Not ValueIsFilled(vDocObj.RoomTypeUpgrade) Then
			vDocObj.RoomTypeBeforeUpgrade = vDocObj.Ref.RoomType;
		EndIf;
		vDocObj.PriceCalculationDate = '00010101';
	EndIf;
	If ValueIsFilled(vDocObj.RoomType) Then
		If ValueIsFilled(vDocObj.RoomType.Company) Then
			vDocObj.Company = vDocObj.RoomType.Company;
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.RoomRate) Then
		If ValueIsFilled(vDocObj.RoomRate.SourceOfBusiness) Then
			vDocObj.SourceOfBusiness = vDocObj.RoomRate.SourceOfBusiness;
		EndIf;
		If ValueIsFilled(vDocObj.RoomRate.MarketingCode) Then
			vDocObj.MarketingCode = vDocObj.RoomRate.MarketingCode;
		EndIf;
		If IsBlankString(pClientTypeCode) Then
			If ValueIsFilled(vDocObj.RoomRate.ClientType) Then
				vDocObj.ClientType = vDocObj.RoomRate.ClientType;
				vDocObj.ClientTypeConfirmationText = vDocObj.RoomRate.ClientTypeConfirmationText;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObj.RoomRate.Company) Then
			vDocObj.Company = vDocObj.RoomRate.Company;
		EndIf;
	EndIf;
	vPaymentMethod = Undefined;
	If Not IsBlankString(pPlannedPaymentMethodCode) Then
		vPaymentMethod = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentMethods", pPlannedPaymentMethodCode);
		If ValueIsFilled(vPaymentMethod) Then
			vDocObj.PlannedPaymentMethod = vPaymentMethod;
		EndIf;
	EndIf;     
	vClientExtraData = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ClientExtraData")); 
	vClientExtraData.ClientAddressRegistrationDate = pClientAddressRegistrationDate;
	
	// Try to find client by external code
	vGuestRef = Catalogs.Clients.EmptyRef();
	// Create new client
	If Not IsBlankString(pClientLastName) Or Not IsBlankString(pClientFirstName) Or Not IsBlankString(pExtClientCode) Then
		vRC = cmWriteExternalClient(pExtClientCode, pExtReservationCode, 
									pClientLastName, pClientFirstName, pClientSecondName, 
									pClientSexCode, pClientCitizenshipCode, pClientBirthDate,
									pClientPhone, pClientFax, pClientEMail, pClientRemarks, pClientSendSMS,  
									pHotelCode, pExternalSystemCode, Catalogs.Clients.ReservedGuests, pClientIdentityDocumentTypeCode,
									pClientIdentityDocumentSeries,pClientIdentityDocumentNumber,pClientIdentityDocumentIssueDate,
									pClientIdentityDocumentValidToDate,	pClientIdentityDocumentUnitCode,pClientIdentityDocumentIssuedBy,
									pClientPlaceOfBirth, pClientAddress, vClientExtraData,
									pLanguage, "XDTO");
		If IsBlankString(vRC.ErrorDescription) Then
			// Try to find client by external client code or by external system code
			If Not IsBlankString(vRC.ClientCode) Then
				If Not ValueIsFilled(vGuestRef) Then
					vGuestRef = cmGetClientByCode(TrimAll(vRC.ClientCode));
				EndIf;
				// Try to find client by external client code or by external system code
				If Not ValueIsFilled(vGuestRef) And Not IsBlankString(pExtClientCode) Then
					vGuestRef = cmGetClientByExternalCode(pExtClientCode);
				EndIf;
				If Not ValueIsFilled(vGuestRef) And Not IsBlankString(pExtReservationCode) Then
					vGuestRef = cmGetClientByExternalCode(pExtReservationCode);
				EndIf;
				If Not ValueIsFilled(vGuestRef) And Not IsBlankString(pClientPhone) Then
					vGuestRef = cmGetClientByFullnameAndPhone(pClientLastName, pClientFirstName, pClientSecondName, pClientPhone);
				EndIf;
				If Not ValueIsFilled(vGuestRef) And Not IsBlankString(pClientEMail) Then
					vGuestRef = cmGetClientByFullnameAndEmail(pClientLastName, pClientFirstName, pClientSecondName, pClientEMail);
				EndIf;
			EndIf;
		Else
			rErrorDescription = vRC.ErrorDescription;
			// Write log event
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Error, , , 
						  NStr("en='Error description: ';ru='Описание ошибки: ';de='Fehlerbeschreibung: '") + rErrorDescription);
			// Return nothing
			Return Undefined;
		EndIf;
	EndIf;

	If Not IsBlankString(pCustomerName) Then
		If vUse_client Then
			If ValueIsFilled(vDocObj.GuestGroup) And vDocObj.GuestGroup.OneCustomerPerGuestGroup And ValueIsFilled(vDocObj.GuestGroup.Customer) Then
				vDocObj.Customer = vDocObj.GuestGroup.Customer;
			Else
				If Not IsBlankString(pPlannedPaymentMethodCode) And ValueIsFilled(vPaymentMethod) And vPaymentMethod.IsByBankTransfer Then
					vDocObj.Customer = cmGetCustomerByName(TrimAll(pClientLastName) + " " + TrimAll(pClientFirstName) + " " + TrimAll(pClientSecondName), pClientBirthDate, True, True, vDocObj.PlannedPaymentMethod, , , vHotel, vGuestRef);
				Else
					vDocObj.Customer = cmGetCustomerByName(TrimAll(pClientLastName) + " " + TrimAll(pClientFirstName) + " " + TrimAll(pClientSecondName), pClientBirthDate, True, True, , , , vHotel, vGuestRef);
				EndIf;
			EndIf;
		Else
			vDocObj.Customer = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Customers", TrimAll(pCustomerName));
			If Not ValueIsFilled(vDocObj.Customer) Then
				vCustomerDataPhone = "";
				vCustomerDataEmail = "";
				vCustomerBirthDate = '00010101';
				vIsIndividual = False;
				If pCustomerData <> Undefined Then
					vCustomerDataPhone = pCustomerData.Get("Phone");
					vCustomerDataEmail = pCustomerData.Get("EMail"); 
					If Not ValueIsFilled(vCustomerDataPhone) Then
						vCustomerDataPhone = "";
					EndIf;
					If Not ValueIsFilled(vCustomerDataEmail) Then
						vCustomerDataEmail = "";
					EndIf;
					vCustomerIndividualData = pCustomerData.Get("IndividualCustomer");
					If vCustomerIndividualData <> Undefined Then
						vIsIndividual = True;
						vCustomerBirthDate = vCustomerIndividualData.Get("ClientBirthDate");
					EndIf; 
				EndIf;
				If ValueIsFilled(vCustomerBirthDate) Then
					vDocObj.Customer = cmGetCustomerByName(pCustomerName, vCustomerBirthDate, , vIsIndividual, , vCustomerDataPhone, vCustomerDataEmail, vHotel);
				Else					
					vDocObj.Customer = cmGetCustomerByName(pCustomerName, , , vIsIndividual, , vCustomerDataPhone, vCustomerDataEmail, vHotel);
				EndIf;
			EndIf;
		EndIf;
		// Try to find contract by contract type taken from the room rate
		If ValueIsFilled(vDocObj.Customer) And ValueIsFilled(vDocObj.RoomRate) And ValueIsFilled(vDocObj.RoomRate.ContractType) Then
			vCustomerContract = cmGetCustomerContractByContractType(vDocObj.Hotel, Undefined, vDocObj.Customer, vDocObj.RoomRate.ContractType, vDocObj.CheckInDate, vDocObj.CheckOutDate);
			If ValueIsFilled(vCustomerContract) Then
				vDocObj.Contract = vCustomerContract;
			EndIf;
		EndIf;
	EndIf;
	If Not IsBlankString(pContractName) And Not vUse_client Then
		vDocObj.Contract = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Contracts", pContractName);
		If Not ValueIsFilled(vDocObj.Contract) Then
			vDocObj.Contract = cmGetContractByName(vDocObj.Customer, pContractName, False);
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.Contract) Then
		vDocObjContract = vDocObj.Contract;
		If vDocObjContract.Owner <> vDocObj.Customer Then
			vDocObj.Customer = vDocObjContract.Owner;
		EndIf;
		If ValueIsFilled(vDocObjContract.RoomRate) Then
			If Upper(TrimAll(pExternalSystemCode)) <> "HOTELBI" And Upper(TrimAll(pExternalSystemCode)) <> "BITRIX24" Then
				vDocObj.RoomRate = vDocObjContract.RoomRate;
			EndIf;
		EndIf;
		If IsBlankString(pRoomQuotaCode) Then
			If ValueIsFilled(vDocObjContract.RoomQuota) Then
				vDocObj.RoomQuota = vDocObjContract.RoomQuota;
				If ValueIsFilled(vDocObj.RoomQuota.Company) Then
					vDocObj.Company = vDocObj.RoomQuota.Company;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	If Not IsBlankString(pAgentName) Then
		vDocObj.Agent = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Customers", pAgentName);
		If Not ValueIsFilled(vDocObj.Agent) Then
			vDocObj.Agent = cmGetCustomerByName(pAgentName, , , , , , , vHotel);
		EndIf;
	EndIf;
	If Not IsBlankString(pContactPerson) Then
		vDocObj.ContactPerson = TrimAll(pContactPerson);
	EndIf;
	If ValueIsFilled(vDocObj.ReservationStatus) And Not vDocObj.ReservationStatus.IsCheckIn Then
		If ValueIsFilled(vRoomQuota) Then
			If Not vRoomQuota.IsFolder Then
				vDocObj.RoomQuota = vRoomQuota;
			EndIf;
			If ValueIsFilled(vDocObj.RoomQuota) And ValueIsFilled(vDocObj.RoomQuota.Company) Then
				vDocObj.Company = vDocObj.RoomQuota.Company;
			EndIf;
		EndIf;
	EndIf;
	If pNumberOfRooms > 0 Then
		vDocObj.RoomQuantity = pNumberOfRooms;
	EndIf;
	If pNumberOfPersons > 0 Then
		vDocObj.NumberOfPersons = pNumberOfPersons;
	EndIf;
	vIgnoreCustomerPaymentMethod = False;
	If Not IsBlankString(pPlannedPaymentMethodCode) And Not vUse_client Then
		vIgnoreCustomerPaymentMethod = True;
	EndIf;
	
	// Fill default values based on document attributes already filled
	If ValueIsFilled(vDocObj.Customer) Then
		vDocObjCustomer = vDocObj.Customer;
		// when pLogin is filled it's b2b agent reservation and no need to update the customer object
		If pCustomerData <> Undefined AND IsBlankString(pLogin) Then
			vCustomerDataPhone = pCustomerData.Get("Phone");
			vCustomerDataEmail = pCustomerData.Get("EMail"); 
			If ValueIsFilled(vCustomerDataPhone) Or ValueIsFilled(vCustomerDataEmail) Then
				vCustomerObj = vDocObjCustomer.GetObject();
				If ValueIsFilled(vCustomerDataPhone) Then
					vCustomerPhone = SMS.GetValidPhoneNumber(TrimAll(vCustomerDataPhone));
					If vCustomerPhone <> vCustomerObj.Phone Then
						vCustomerObj.Phone = vCustomerPhone;
					EndIf;
				EndIf;
				If ValueIsFilled(vCustomerDataEmail) Then
					If vCustomerObj.EMail <> Lower(TrimAll(vCustomerDataEmail)) Then
						vCustomerObj.EMail = Lower(TrimAll(vCustomerDataEmail));
					EndIf;
				EndIf;
				vCustomerIndividualData = pCustomerData.Get("IndividualCustomer");
				If vCustomerIndividualData <> Undefined Then
					// Identity document data for cruises
					vCustomerIdentityDocumentData = New Structure("ClientIdentityDocumentTypeCode, ClientIdentityDocumentSeries, ClientIdentityDocumentNumber, ClientIdentityDocumentIssueDate, ClientIdentityDocumentValidToDate, ClientIdentityDocumentUnitCode, ClientIdentityDocumentIssuedBy", 
					                                              "", "", "", '00010101', '00010101', "", "");
					FillPropertyValues(vCustomerIdentityDocumentData, vCustomerIndividualData);
					// Identity document data
					If Not IsBlankString(vCustomerIdentityDocumentData.ClientIdentityDocumentTypeCode) Then
						vCustomerObj.IdentityDocumentType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "IdentityDocumentTypes", TrimAll(vCustomerIdentityDocumentData.ClientIdentityDocumentTypeCode));
					EndIf;
					If Not IsBlankString(vCustomerIdentityDocumentData.ClientIdentityDocumentSeries) Then
						vCustomerObj.IdentityDocumentSeries = TrimAll(vCustomerIdentityDocumentData.ClientIdentityDocumentSeries);
					EndIf;
					If Not IsBlankString(vCustomerIdentityDocumentData.ClientIdentityDocumentNumber) Then
						vCustomerObj.IdentityDocumentNumber = TrimAll(vCustomerIdentityDocumentData.ClientIdentityDocumentNumber);
					EndIf;
					If Not IsBlankString(vCustomerIdentityDocumentData.ClientIdentityDocumentIssuedBy) Then
						vCustomerObj.IdentityDocumentIssuedBy = TrimAll(vCustomerIdentityDocumentData.ClientIdentityDocumentIssuedBy);
					EndIf;
					If ValueIsFilled(vCustomerIdentityDocumentData.ClientIdentityDocumentIssueDate) Then
						vCustomerObj.IdentityDocumentIssueDate = vCustomerIdentityDocumentData.ClientIdentityDocumentIssueDate;
					EndIf;
					If ValueIsFilled(vCustomerIdentityDocumentData.ClientIdentityDocumentValidToDate) Then
						vCustomerObj.IdentityDocumentValidToDate = vCustomerIdentityDocumentData.ClientIdentityDocumentValidToDate;
					EndIf;
					vIndividualsFolder = Constants.IndividualsFolder.Get();
					If Not ValueIsFilled(vIndividualsFolder) Then
						vIndividualsFolder = Catalogs.Customers.IndividualsFolder;
					EndIf;
					If vCustomerObj.Parent <> vIndividualsFolder Then
						vCustomerObj.Parent = vIndividualsFolder;
					EndIf;
					If Not vCustomerObj.IsIndividual Then
						vCustomerObj.IsIndividual = True;
					EndIf;
				EndIf;	
				If vCustomerObj.Modified() Then
					vCustomerObj.Write();
					vCustomerObj.pmWriteToCustomerChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
				EndIf;
			EndIf;
		EndIf;
		vDocObj.CustomerType = vDocObjCustomer.CustomerType;
		If ValueIsFilled(vDocObj.CustomerType) Then
			If Not ValueIsFilled(vDocObj.RoomRateType) Then
				vDocObj.RoomRateType = vDocObj.CustomerType.RoomRateType;
			EndIf;
		EndIf;
		If IsBlankString(vDocObj.ContactPerson) Then
			If Not IsBlankString(vDocObjCustomer.ContactPerson) Then
				vDocObj.ContactPerson = TrimR(vDocObjCustomer.ContactPerson);
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjCustomer.PlannedPaymentMethod) And Not pIgnoreCustomerChargingRules And Not vIgnoreCustomerPaymentMethod Then
			vDocObj.PlannedPaymentMethod = vDocObjCustomer.PlannedPaymentMethod;
		EndIf;
		If IsBlankString(pAgentName) Then
			If ValueIsFilled(vDocObjCustomer.AgentCommissionType) Or vDocObjCustomer.AgentCommission <> 0 Then
				If ValueIsFilled(vDocObjCustomer.Agent) Then
					vDocObj.Agent = vDocObjCustomer.Agent;
				Else
					vDocObj.Agent = vDocObjCustomer;
				EndIf;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObj.Agent) Then
			vDocObjAgent = vDocObj.Agent;
			If ValueIsFilled(vDocObjAgent.AgentCommissionType) Or vDocObjAgent.AgentCommission <> 0 Then
				vDocObj.AgentCommission = vDocObjAgent.AgentCommission;
				vDocObj.AgentCommissionType = vDocObjAgent.AgentCommissionType;
				vDocObj.AgentCommissionServiceGroup = vDocObjAgent.AgentCommissionServiceGroup;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjCustomer.RoomRate) Then
			If Upper(TrimAll(pExternalSystemCode)) <> "HOTELBI" And Upper(TrimAll(pExternalSystemCode)) <> "BITRIX24" Then
				vRoomRate = vDocObjCustomer.RoomRate;
				If vRoomRate <> vDocObj.RoomRate Then
					vDocObj.RoomRate = vRoomRate;
					vDocObj.RoomRateServiceGroup = vDocObjCustomer.RoomRateServiceGroup;
					vDocObj.PriceCalculationDate = '00010101';
				EndIf;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObj.RoomRate) Then
			If ValueIsFilled(vDocObj.RoomRate.SourceOfBusiness) Then
				vDocObj.SourceOfBusiness = vDocObj.RoomRate.SourceOfBusiness;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.MarketingCode) Then
				vDocObj.MarketingCode = vDocObj.RoomRate.MarketingCode;
			EndIf;
			If IsBlankString(pClientTypeCode) Then
				If ValueIsFilled(vDocObj.RoomRate.ClientType) Then
					vDocObj.ClientType = vDocObj.RoomRate.ClientType;
					vDocObj.ClientTypeConfirmationText = vDocObj.RoomRate.ClientTypeConfirmationText;
				EndIf;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.Company) Then
				vDocObj.Company = vDocObj.RoomRate.Company;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjCustomer.MarketingCode) Then
			vDocObj.MarketingCode = vDocObjCustomer.MarketingCode;
			vDocObj.MarketingCodeConfirmationText = "";
		EndIf;
		If ValueIsFilled(vDocObjCustomer.SourceOfBusiness) Then
			vDocObj.SourceOfBusiness = vDocObjCustomer.SourceOfBusiness;
		EndIf;
		If IsBlankString(pClientTypeCode) Then
			If ValueIsFilled(vDocObjCustomer.ClientType) Then
				vDocObj.ClientType = vDocObjCustomer.ClientType;
				vDocObj.ClientTypeConfirmationText = vDocObjCustomer.ClientTypeConfirmationText;
			EndIf;
		EndIf;
		If Not IsBlankString(vDocObjCustomer.Remarks) And vDocObjCustomer.CopyRemarksToDocuments Then
			vDocObj.Remarks = TrimAll(TrimAll(vDocObjCustomer.Remarks) + Chars.LF + TrimAll(vDocObj.Remarks));
		EndIf;
		vDefaultContract = vDocObjCustomer.Contract;
		If ValueIsFilled(vDefaultContract) And ValueIsFilled(vDefaultContract.Hotel) And vDefaultContract.Hotel <> vDocObj.Hotel Then
			vDefaultContract = Undefined;
		EndIf;
		If Not ValueIsFilled(vDefaultContract) Then
			vValidContracts = cmGetListOfValidContracts(vDocObjCustomer, vDocObj.CheckInDate, vDocObj.CheckOutDate, ?(ValueIsFilled(vDocObj.GuestGroup), vDocObj.GuestGroup.CreateDate, vDocObj.Date), vDocObj.Hotel);
			If vValidContracts.Count() = 1 Then
				vDefaultContract = vValidContracts.Get(0).Value;
			EndIf;
		EndIf;
		If Not ValueIsFilled(vDocObj.Contract) And ValueIsFilled(vDefaultContract) Then
			vDocObj.Contract = vDefaultContract;
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.Contract) Then
		vDocObjContract = vDocObj.Contract;
		If ValueIsFilled(vDocObjContract.PlannedPaymentMethod) And Not pIgnoreCustomerChargingRules And Not vIgnoreCustomerPaymentMethod Then
			vDocObj.PlannedPaymentMethod = vDocObjContract.PlannedPaymentMethod;
		EndIf;
		If ValueIsFilled(vDocObjContract.AgentCommissionType) Or vDocObjContract.AgentCommission <> 0 Then
			If IsBlankString(pAgentName) Then
				If Not ValueIsFilled(vDocObjContract.Agent) Then
					vAgent = vDocObjContract.Owner;
					vDocObj.Agent = vAgent;
					If vDocObjContract.IsSubagent And ValueIsFilled(vAgent.Agent) Then
						vDocObj.Agent = vAgent.Agent;
					EndIf;
				Else
					vAgent = vDocObjContract.Agent;
					vDocObj.Agent = vAgent;
					If vDocObjContract.IsSubagent And ValueIsFilled(vAgent.Agent) Then
						vDocObj.Agent = vAgent.Agent;
					EndIf;
				EndIf;
				vDocObj.AgentCommission = vDocObjContract.AgentCommission;
				vDocObj.AgentCommissionType = vDocObjContract.AgentCommissionType;
				vDocObj.AgentCommissionServiceGroup = vDocObjContract.AgentCommissionServiceGroup;
			ElsIf ValueIsFilled(vDocObj.Agent) Then
				If Not ValueIsFilled(vDocObjContract.Agent) Then
					If vDocObjContract.Owner = vDocObj.Agent Then
						vDocObj.AgentCommission = vDocObjContract.AgentCommission;
						vDocObj.AgentCommissionType = vDocObjContract.AgentCommissionType;
						vDocObj.AgentCommissionServiceGroup = vDocObjContract.AgentCommissionServiceGroup;
					EndIf;
				Else
					If vDocObjContract.Agent = vDocObj.Agent Then
						vDocObj.AgentCommission = vDocObjContract.AgentCommission;
						vDocObj.AgentCommissionType = vDocObjContract.AgentCommissionType;
						vDocObj.AgentCommissionServiceGroup = vDocObjContract.AgentCommissionServiceGroup;
					EndIf;
				EndIf;
			EndIf;
		Else
			If IsBlankString(pAgentName) Then
				vDocObj.AgentCommission = 0;
				vDocObj.AgentCommissionType = Undefined;
				vDocObj.AgentCommissionServiceGroup = Undefined;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjContract.RoomRate) Then
			If Upper(TrimAll(pExternalSystemCode)) <> "HOTELBI" And Upper(TrimAll(pExternalSystemCode)) <> "BITRIX24" Then
				vRoomRate = vDocObjContract.RoomRate;
				If vRoomRate <> vDocObj.RoomRate Then
					vDocObj.RoomRate = vRoomRate;
					vDocObj.RoomRateServiceGroup = vDocObjContract.RoomRateServiceGroup;
					vDocObj.PriceCalculationDate = '00010101';
				EndIf;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObj.RoomRate) Then
			If ValueIsFilled(vDocObj.RoomRate.SourceOfBusiness) Then
				vDocObj.SourceOfBusiness = vDocObj.RoomRate.SourceOfBusiness;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.MarketingCode) Then
				vDocObj.MarketingCode = vDocObj.RoomRate.MarketingCode;
			EndIf;
			If IsBlankString(pClientTypeCode) Then
				If ValueIsFilled(vDocObj.RoomRate.ClientType) Then
					vDocObj.ClientType = vDocObj.RoomRate.ClientType;
					vDocObj.ClientTypeConfirmationText = vDocObj.RoomRate.ClientTypeConfirmationText;
				EndIf;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.Company) Then
				vDocObj.Company = vDocObj.RoomRate.Company;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjContract.Company) Then
			vDocObj.Company = vDocObjContract.Company;
		EndIf;
		If ValueIsFilled(vDocObjContract.MarketingCode) Then
			vDocObj.MarketingCode = vDocObjContract.MarketingCode;
			vDocObj.MarketingCodeConfirmationText = "";
		EndIf;
		If ValueIsFilled(vDocObjContract.SourceOfBusiness) Then
			vDocObj.SourceOfBusiness = vDocObjContract.SourceOfBusiness;
		EndIf;
		If IsBlankString(pClientTypeCode) Then
			If ValueIsFilled(vDocObjContract.ClientType) Then
				vDocObj.ClientType = vDocObjContract.ClientType;
				vDocObj.ClientTypeConfirmationText = vDocObjContract.ClientTypeConfirmationText;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjContract.RoomQuota) And vDocObj.RoomQuota <> vDocObjContract.RoomQuota Then
			vDocObj.RoomQuota = vDocObjContract.RoomQuota;
			If ValueIsFilled(vDocObj.RoomQuota.Company) Then
				vDocObj.Company = vDocObj.RoomQuota.Company;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObjContract.MealBoardTerm) Then
			vDocObj.ServicePackage = vDocObjContract.MealBoardTerm;
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.Agent) Then
		If ValueIsFilled(vDocObj.Agent.MarketingCode) Then
			vDocObj.MarketingCode = vDocObj.Agent.MarketingCode;
			vDocObj.MarketingCodeConfirmationText = "";
		EndIf;
		If ValueIsFilled(vDocObj.Agent.SourceOfBusiness) Then
			vDocObj.SourceOfBusiness = vDocObj.Agent.SourceOfBusiness;
		EndIf;
		If IsBlankString(pClientTypeCode) Then
			If ValueIsFilled(vDocObj.Agent.ClientType) Then
				vDocObj.ClientType = vDocObj.Agent.ClientType;
				vDocObj.ClientTypeConfirmationText = vDocObj.Agent.ClientTypeConfirmationText;
			EndIf;
		EndIf;
	EndIf;
	
	// Terms
	If Not IsBlankString(pMealBoardTerm) Then
		vMealBoardTerm = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ServicePackages", pMealBoardTerm);
		If ValueIsFilled(vMealBoardTerm) Then
			vDocObj.ServicePackage = vMealBoardTerm;
		EndIf;
	EndIf;
	
	If ValueIsFilled(vGuestRef) Then
		vDocObj.Guest = vGuestRef;
		// Marketing code
		If ValueIsFilled(vGuestRef.MarketingCode) Then
			vDocObj.MarketingCode = vGuestRef.MarketingCode;
			vDocObj.MarketingCodeConfirmationText = "";
		EndIf;
		// Source of business
		If ValueIsFilled(vGuestRef.SourceOfBusiness) Then
			vDocObj.SourceOfBusiness = vGuestRef.SourceOfBusiness;
		EndIf;
		// Client type
		If Not ValueIsFilled(vDocObj.ClientType) Then
			If ValueIsFilled(vGuestRef.ClientType) Then
				vDocObj.ClientType = vGuestRef.ClientType;
				vDocObj.ClientTypeConfirmationText = vGuestRef.ClientTypeConfirmationText;
			EndIf;
		EndIf;
		// Room rate
		If ValueIsFilled(vDocObj.Guest.RoomRate) Then
			If Upper(TrimAll(pExternalSystemCode)) <> "HOTELBI" And Upper(TrimAll(pExternalSystemCode)) <> "BITRIX24" Then
				vRoomRate = vDocObj.Guest.RoomRate;
				If vRoomRate <> vDocObj.RoomRate Then
					vDocObj.RoomRate = vRoomRate;
					vDocObj.RoomRateServiceGroup = vDocObj.Guest.RoomRateServiceGroup;
					vDocObj.PriceCalculationDate = '00010101';
				EndIf;
			EndIf;
		EndIf;
		If ValueIsFilled(vDocObj.RoomRate) Then
			If ValueIsFilled(vDocObj.RoomRate.SourceOfBusiness) Then
				vDocObj.SourceOfBusiness = vDocObj.RoomRate.SourceOfBusiness;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.MarketingCode) Then
				vDocObj.MarketingCode = vDocObj.RoomRate.MarketingCode;
			EndIf;
			If IsBlankString(pClientTypeCode) Then
				If ValueIsFilled(vDocObj.RoomRate.ClientType) Then
					vDocObj.ClientType = vDocObj.RoomRate.ClientType;
					vDocObj.ClientTypeConfirmationText = vDocObj.RoomRate.ClientTypeConfirmationText;
				EndIf;
			EndIf;
			If ValueIsFilled(vDocObj.RoomRate.Company) Then
				vDocObj.Company = vDocObj.RoomRate.Company;
			EndIf;
		EndIf;
		// Social network login
		If Not IsBlankString(pLogin) Then
			If cmCheckIfLoginIsSocialNetworkLogin(pLogin) Then
				cmSaveClientSocialNetworkLogin(vGuestRef, pLogin);
			EndIf;
		EndIf;
		// Remarks
		vGuestRef = vDocObj.Guest;
		If ValueIsFilled(vGuestRef) And Not IsBlankString(vGuestRef.Remarks) And vGuestRef.CopyRemarksToDocuments Then
			If vDocObj.IsNew() Or ValueIsFilled(vDocObj.Ref) And vGuestRef <> vDocObj.Ref.Guest Then
				vDocObj.Remarks = TrimAll(TrimAll(vGuestRef.Remarks) + Chars.LF + TrimAll(vDocObj.Remarks));
			EndIf;
		EndIf;
	EndIf;
	If ValueIsFilled(vSourceOfBusiness) And Not ValueIsFilled(vDocObj.SourceOfBusiness) Then
		vDocObj.SourceOfBusiness = vSourceOfBusiness;
	EndIf;
	If ValueIsFilled(vMarketingCode) And Not ValueIsFilled(vDocObj.MarketingCode) Then
		vDocObj.MarketingCode = vMarketingCode;
	EndIf;
	
	// Guest age
	If pGuestAge <> Undefined And pGuestAge > 0 Then
		If Not ValueIsFilled(vDocObj.Guest) Or ValueIsFilled(vDocObj.Guest) And Not ValueIsFilled(vDocObj.Guest.DateOfBirth) Then
			vDocObj.GuestAge = pGuestAge;
		ElsIf ValueIsFilled(vDocObj.Guest) And ValueIsFilled(vDocObj.Guest.DateOfBirth) Then
			vDocObj.GuestAge = cmGetClientAge(vDocObj.Guest.DateOfBirth, vDocObj.CheckInDate);
		EndIf;
	ElsIf ValueIsFilled(vDocObj.Guest) And ValueIsFilled(vDocObj.Guest.DateOfBirth) Then
		vDocObj.GuestAge = cmGetClientAge(vDocObj.Guest.DateOfBirth, vDocObj.CheckInDate);
	ElsIf ValueIsFilled(vDocObj.AccommodationType) And vDocObj.AccommodationType.AllowedClientAgeTo > 0 Then
		vDocObj.GuestAge = vDocObj.AccommodationType.AllowedClientAgeTo - 1;
	EndIf;
	
	If ValueIsFilled(vDocObj.ClientType) And ValueIsFilled(vDocObj.Guest) Then
		vDocObjClientType = vDocObj.ClientType;
		vDocObjGuest = vDocObj.Guest;
		
		// Client type modifications
		If ValueIsFilled(vDocObjGuest.DateOfBirth) Then
			vAge = Format(vDocObjGuest.Age, "ND=2; NFD=0; NZ=; NLZ=; NG=");
			vClientTypeCodeWithAge = TrimAll(vDocObjClientType.Code) + "_" + vAge;
			vClientTypeByAge = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", vClientTypeCodeWithAge);
			If ValueIsFilled(vClientTypeByAge) Then
				vDocObj.ClientType = vClientTypeByAge;
				vDocObjClientType = vDocObj.ClientType;
			EndIf;
		EndIf;
	
		// Update guest client type
		If vDocObjClientType.Mode = Enums.ClientTypeModes.PerClient Then
			If vDocObjGuest.ClientType <> vDocObjClientType Then
				vDocObjGuestObj = vDocObjGuest.GetObject();
				vDocObjGuestObj.ClientType = vDocObjClientType;
				vDocObjGuestObj.Write();
				vDocObjGuestObj.pmWriteToClientChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
				
				vDocObj.Guest = vDocObjGuestObj.Ref;
			EndIf;
		EndIf;
	EndIf;
	
	// If reservation loaded again extra service has to be cleared before adding new line
	// or it may be that new version has no extra services
	vIsManualServices = vDocObj.Services.FindRows(New Structure("IsManual", True));  
	For Each vRowServ In vIsManualServices Do
		vDocObj.Services.Delete(vRowServ);
	EndDo; 
	
	// Message text with extra services info
	vServicesMessage = "";
	
	// Transfer
	If pTransferData <> Undefined And pTransferData.Need Then
		// Try to get transfer service according to place of transfer
		vTranseferService = cmGetObjectRefByExternalSystemCode(vDocObj.Hotel, pExternalSystemCode, "Services", pTransferData.Place);
		If ValueIsFilled(vTranseferService) Then
			vCurRow = vDocObj.Services.Add();
			
			vCurRow.AccountingDate = pTransferData.Date;
			vCurRow.IsManual = True;
			vCurRow.Service = vTranseferService;
			vCurRow.Remarks = Format(pTransferData.Date, "DF='dd.MM.yyyy HH:mm'") + ", " + pTransferData.Place + ", " + pTransferData.Remarks;
			vCurRow.Unit = vCurRow.Service.Unit;
			vChargingRules = vDocObj.ChargingRules.Unload();
			If Not vDocObj.IgnoreGroupChargingRules Then
				cmAddGuestGroupChargingRules(vChargingRules, vDocObj.GuestGroup);
			EndIf;
			// Fill folio and folio currency for service
			vDocObj.pmSetServiceFolioBasedOnChargingRules(vCurRow, vChargingRules, True);
			vCurRow.CalendarDayType = cmGetCalendarDayType(vDocObj.RoomRate, vCurRow.AccountingDate, vDocObj.CheckInDate, vDocObj.CheckOutDate, , ?(ValueIsFilled(vDocObj.RoomTypeUpgrade), vDocObj.RoomTypeUpgrade, vDocObj.RoomType), vDocObj.PriceCalculationDate);
	        vCurRow.Company = vCurRow.Folio.Company;
			// Get service prices
			vTPrices = vCurRow.Service.GetObject().pmGetServicePrices(vDocObj.Hotel,vCurRow.AccountingDate,vDocObj.ClientType);
			If vTPrices.Count() > 0 Then
				vCurRow.Quantity = 1;
				vCurRow.Price = cmConvertCurrencies(vTPrices[0].Price, vTPrices[0].Currency, , vCurRow.FolioCurrency, , vCurRow.AccountingDate, vDocObj.Hotel);
				vCurRow.VATRate = vTPrices[0].VATRate;
				vCurRow.Sum = vCurRow.Price;
			Else
				vCurRow.Quantity = 1;
				vCurRow.Price = 0;
				vCurRow.VATRate = ?(ValueIsFilled(vCurRow.Company), vCurRow.Company.VATRate, vDocObj.Company.VATRate);
				vCurRow.Sum = 0;
			EndIf;
			vCurRow.VATSum = cmCalculateVATSum(vCurRow.VATRate, vCurRow.Sum, vCurRow.AccountingDate);
			vServicesMessage = vServicesMessage + ?(IsBlankString(vServicesMessage), "", Chars.LF) + TrimAll(vTranseferService);
		Else
			// Transfer service is not found so just write a remarks to reservation
			pRemarks = Format(pTransferData.Date, "DF='dd.MM.yyyy HH:mm'") + ", " + TrimAll(pTransferData.Place) + Chars.LF + 
				              TrimAll(pTransferData.Remarks)+Chars.CR+TrimAll(pRemarks);
		EndIf;		
	EndIf;
	
	// Extra services
	If vExtraServices.Count() > 0 Then
		For Each vExtraServicesItem In vExtraServices Do
			vExtraServiceStruct = vExtraServicesItem.Value;
			// Try to get extra service item reference
			vExtraServicePackage = cmGetObjectRefByExternalSystemCode(vDocObj.Hotel, pExternalSystemCode, "ServicePackages", vExtraServiceStruct.Service);
			If Not ValueIsFilled(vExtraServicePackage) And ValueIsFilled(vExtSystem) Then
				vServicePackageMapping = InformationRegisters.ExternalSystemIntegrationData.GetData(vExtSystem, "servicepackages", "id", , , , vExtraServiceStruct.Service);
				For Each vServicePackageMappingRow In vServicePackageMapping Do
					vExtraServicePackage = vServicePackageMappingRow.RefKey1;
					Break;
				EndDo;
			EndIf;
			If ValueIsFilled(vExtraServicePackage) Then
				If Not vExtraServicePackage.IsFolder Then
					vIsRemoved = Undefined;
					vExtraServiceStruct.Property("IsRemoved", vIsRemoved);
					If vIsRemoved = Undefined Then
						vIsRemoved = False;
					EndIf;
					If Not vIsRemoved Then
						vExistedSP = vDocObj.ServicePackages.Find(vExtraServicePackage, "ServicePackage");
						If vExistedSP = Undefined Then
							vCurRow = vDocObj.ServicePackages.Add();
							vCurRow.ServicePackage = vExtraServicePackage;
							vCurRow.Quantity = vExtraServiceStruct.Quantity; 
							vServicesMessage = vServicesMessage + ?(IsBlankString(vServicesMessage), "", Chars.LF) + TrimAll(vExtraServicePackage);
						EndIf;
					Else
						If ValueIsFilled(vDocObj.ServicePackage) And vDocObj.ServicePackage = vExtraServicePackage Then
							vDocObj.ServicePackage = Undefined;
						EndIf;
						spi = 0;
						While spi < vDocObj.ServicePackages.Count() Do
							vSPRow = vDocObj.ServicePackages.Get(spi);
							If ValueIsFilled(vSPRow.ServicePackage) And vSPRow.ServicePackage = vExtraServicePackage Then
								vDocObj.ServicePackages.Delete(spi);
							Else
								spi = spi + 1;
							EndIf;
						EndDo;
					EndIf;
				EndIf;
			Else
				// Try to get extra service item reference
				vExtraService = cmGetObjectRefByExternalSystemCode(vDocObj.Hotel, pExternalSystemCode, "Services", vExtraServiceStruct.Service);
				If Not ValueIsFilled(vExtraService) And ValueIsFilled(vExtSystem) Then
					vServiceMapping = InformationRegisters.ExternalSystemIntegrationData.GetData(vExtSystem, "services", "id", , , , vExtraServiceStruct.Service);
					For Each vServiceMappingRow In vServiceMapping Do
						vExtraService = vServiceMappingRow.RefKey1;
						Break;
					EndDo;
				EndIf;

				// The extra service line has to be added anyway
				vChargeDate = vExtraServiceStruct.ChargeDate;
				If Not ValueIsFilled(vChargeDate) Then
					vChargeDate = vDocObj.CheckInDate;
				EndIf;
				
				vCurRow = vDocObj.Services.Add();
				
				vCurRow.AccountingDate = vChargeDate;
				vCurRow.IsManual = True;
				If ValueIsFilled(vExtraServiceStruct.Remarks) Then
					vCurRow.Remarks = Format(vChargeDate, "DF='dd.MM.yyyy HH:mm'") + ", " + TrimAll(vExtraServiceStruct.Remarks);
				EndIf;
				
				vChargingRules = vDocObj.ChargingRules.Unload();
				If Not vDocObj.IgnoreGroupChargingRules Then
					cmAddGuestGroupChargingRules(vChargingRules, vDocObj.GuestGroup);
				EndIf;
				
				vCurRow.Service = vExtraService;
				
				vDocObj.pmSetServiceFolioBasedOnChargingRules(vCurRow, vChargingRules, True);
				
				// Fill folio and folio currency for service
				vDocObj.pmSetServiceFolioBasedOnChargingRules(vCurRow, vChargingRules, True);
				vCurRow.CalendarDayType = cmGetCalendarDayType(vDocObj.RoomRate, vCurRow.AccountingDate, vDocObj.CheckInDate, vDocObj.CheckOutDate, , ?(ValueIsFilled(vDocObj.RoomTypeUpgrade), vDocObj.RoomTypeUpgrade, vDocObj.RoomType), vDocObj.PriceCalculationDate);
		        vCurRow.Company = vCurRow.Folio.Company;
				
				vCurRow.VATRate = ?(ValueIsFilled(vCurRow.Company),vCurRow.Company.VATRate,Catalogs.VATRates.EmptyRef()); // Default VAT Rate
				
				// Get service price currency
				vPriceCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", vExtraServiceStruct.Currency);
				If Not ValueIsFilled(vPriceCurrency) Then
					If ValueIsFilled(vHotel.FolioCurrency) Then
						vPriceCurrency = vHotel.FolioCurrency;
					Else
						Raise NStr("en='Extra service currency not found! ';ru='Валюта доп. услуги не найдена по коду! ';de='Währung der zus. Dienstleistung wurde nicht nach dem Code gefunden! '") + vExtraServiceStruct.Currency;
					EndIf;
				EndIf;
			
				vQuantity = vExtraServiceStruct.Quantity;
				If Not ValueIsFilled(vQuantity) Then
					vQuantity = 1;
				EndIf;
				vCurRow.Quantity = vQuantity;
				vCurRow.Price = cmConvertCurrencies(vExtraServiceStruct.Price, vPriceCurrency, , vCurRow.FolioCurrency, , vCurRow.AccountingDate, vDocObj.Hotel);
				vCurRow.Sum = Round(vCurRow.Price * vCurRow.Quantity, 2);
				
				If ValueIsFilled(vExtraService) And Not vExtraService.IsFolder Then
					vCurRow.Unit = vExtraService.Unit;
					// Get service VAT rate
					vTPrices = vCurRow.Service.GetObject().pmGetServicePrices(vDocObj.Hotel, vCurRow.AccountingDate, vDocObj.ClientType);
					If vTPrices.Count() > 0 Then
						vCurRow.VATRate = vTPrices[0].VATRate;
					EndIf;			
					vServicesMessage = vServicesMessage + ?(IsBlankString(vServicesMessage), "", Chars.LF) + TrimAll(vExtraService);
				EndIf;
				
				vCurRow.VATSum = cmCalculateVATSum(vCurRow.VATRate, vCurRow.Sum, vCurRow.AccountingDate);
			EndIf;
		EndDo;
		vExistedSingleSP = vDocObj.ServicePackages.Find(1, "Quantity");
		If vExistedSingleSP <> Undefined Then
			vDocObj.ServicePackage = vExistedSingleSP.ServicePackage;
			vDocObj.ServicePackages.Delete(vExistedSingleSP);
		EndIf;
	EndIf;
	
	// Credit card data
	If pCreditCardData <> Undefined And ValueIsFilled(vDocObj.Guest) And Not IsBlankString(pCreditCardData.CardNumber) Then
		// Search cards with given owner and number
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	CreditCards.Ref AS CreditCard
		|FROM
		|	Catalog.CreditCards AS CreditCards
		|WHERE
		|	CreditCards.CardOwner = &qCardOwner
		|	AND CreditCards.CardNumber = &qCardNumber
		|	AND CreditCards.DeletionMark = FALSE";
		vQry.SetParameter("qCardOwner", vDocObj.Guest);
		vQry.SetParameter("qCardNumber", TrimAll(pCreditCardData.CardNumber));
		vCards = vQry.Execute().Unload();
		vCreditCardRef = Undefined;
		If vCards.Count() > 0 Then
			// Return first found
			vCreditCardRef = vCards.Get(0).CreditCard;
		Else
			// Create new card if necessary
			vCardObj = Catalogs.CreditCards.CreateItem();
			vCardObj.CardOwner = vDocObj.Guest;
			vCardObj.Description = cmGetCreditCardDescription(TrimAll(pCreditCardData.CardNumber));
			vCardObj.CardNumber = TrimAll(pCreditCardData.CardNumber);
			vCardObj.CardHolder = TrimAll(pCreditCardData.CardHolder);
			vCardObj.CardValidTillDate = pCreditCardData.CardValidTillDate;
			vCardObj.CardSecurityCode = TrimAll(pCreditCardData.CardSecurityCode);
			vCardObj.Author = SessionParameters.CurrentUser;
			vCardObj.CreateDate = CurrentSessionDate();
			vCardObj.Write();
			vCreditCardRef = vCardObj.Ref;
		EndIf;
		If ValueIsFilled(vCreditCardRef) Then
			vDocObj.CreditCard = vCreditCardRef;
		EndIf;
	EndIf;
	
	// Contacts
	vDocObj.Phone = TrimAll(pClientPhone);
	vDocObj.Fax = TrimAll(pClientFax);
	vDocObj.EMail = TrimAll(pClientEMail);
	
	// Reservation remarks and car description
	If Not IsBlankString(pRemarks) Then
		vCharSep = Char(750); // ˮ
		vCharSepPos1 = StrFind(TrimAll(vDocObj.Remarks), vCharSep);
		vCharSepPos2 = 0;
		If vCharSepPos1 > 0 And vCharSepPos1 < StrLen(TrimAll(vDocObj.Remarks)) Then
			vCharSepPos2 = StrFind(TrimAll(vDocObj.Remarks), vCharSep, , vCharSepPos1 + 1);
		EndIf;
		vUserRemarks1 = "";
		vUserRemarks2 = "";
		If vCharSepPos1 = 0 Then
			vUserRemarks1 = TrimAll(vDocObj.Remarks);
		Else
			vUserRemarks1 = TrimAll(Left(TrimAll(vDocObj.Remarks), vCharSepPos1 - 1));
			If vCharSepPos2 > 0 Then
				vUserRemarks2 = TrimAll(Mid(TrimAll(vDocObj.Remarks), vCharSepPos2 + 1));
			EndIf;
		EndIf;
		vDocObj.Remarks = ?(IsBlankString(vUserRemarks1), "", vUserRemarks1 + Chars.LF + Chars.LF) + vCharSep + TrimAll(pRemarks) + vCharSep + ?(IsBlankString(vUserRemarks2), "", Chars.LF + Chars.LF + TrimAll(vUserRemarks2));
	EndIf;
	If Not IsBlankString(pCar) Then
		vCharSep = Char(750); // ˮ
		vCharSepPos1 = StrFind(TrimAll(vDocObj.Car), vCharSep);
		vCharSepPos2 = 0;
		If vCharSepPos1 > 0 And vCharSepPos1 < StrLen(TrimAll(vDocObj.Car)) Then
			vCharSepPos2 = StrFind(TrimAll(vDocObj.Car), vCharSep, , vCharSepPos1 + 1);
		EndIf;
		vUserCar1 = "";
		vUserCar2 = "";
		If vCharSepPos1 = 0 Then
			vUserCar1 = TrimAll(vDocObj.Car);
		Else
			vUserCar1 = TrimAll(Left(TrimAll(vDocObj.Car), vCharSepPos1 - 1));
			If vCharSepPos2 > 0 Then
				vUserCar2 = TrimAll(Mid(TrimAll(vDocObj.Car), vCharSepPos2 + 1));
			EndIf;
		EndIf;
		vDocObj.Car = ?(IsBlankString(vUserCar1), "", vUserCar1 + " ") + vCharSep + TrimAll(pCar) + vCharSep + ?(IsBlankString(vUserCar2), "", " " + TrimAll(vUserCar2));
	EndIf;
	
	// Guarantee type
	If Not IsBlankString(pGuaranteeTypeCode) Then
		vGuaranteeType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "GuaranteeTypes", pGuaranteeTypeCode);
		If ValueIsFilled(vGuaranteeType) Then
			vDocObj.GuaranteeType = vGuaranteeType;
		EndIf;
	EndIf;
	
	// Call API to fill duration
	vDocObj.Duration = vDocObj.pmCalculateDuration();
	
	// Calculate discounts
	vDocObj.pmSetDiscounts();
	vSpecialOfferByPromoCode = Undefined;
	vPromoDiscountType = Undefined;
	If Not IsBlankString(pPromoCode) Then
		// Try to find discount card by promo code
		vPromoDiscountCard = Catalogs.DiscountCards.GetDiscountCardByPromoCode(pPromoCode, vDocObj.CheckInDate, vDocObj.CheckOutDate);
		If ValueIsFilled(vPromoDiscountCard) Then
			vPromoDiscountType = vPromoDiscountCard.DiscountType;
		EndIf;
		// Try to find discount type by promo code
		If Not ValueIsFilled(vPromoDiscountType) Then
			vPromoDiscountType = Catalogs.DiscountTypes.GetDiscountTypeByPromoCode(pPromoCode, vHotel, vDocObj.CheckInDate, vDocObj.CheckOutDate);
		EndIf;
		// Try to find special offer by promo code
		vGroupCreateDate = CurrentSessionDate();
		If ValueIsFilled(vDocObj.GuestGroup) And ValueIsFilled(vDocObj.GuestGroup.CreateDate) Then
			vGroupCreateDate = vDocObj.GuestGroup.CreateDate;
		ElsIf ValueIsFilled(vDocObj.Date) Then
			vGroupCreateDate = vDocObj.Date;
		EndIf;
		vSpecialOfferByPromoCode = Catalogs.SpecialOffers.GetSpecialOfferByPromoCode(pPromoCode, vHotel, vGroupCreateDate, vDocObj.CheckInDate, vDocObj.Duration, vDocObj.CheckOutDate, vDocObj.RoomRate, vDocObj.RoomRate.RoomRateType, vDocObj.ClientType, vDocObj.CustomerType, vDocObj.SourceOfBusiness, vDocObj.MarketingCode, vDocObj.TripPurpose, vDocObj.RoomType);
		If ValueIsFilled(vSpecialOfferByPromoCode) Then
			// Add special offer to the guest group
			vMgr = InformationRegisters.SpecialOffersForReservations.CreateRecordManager();
			vMgr.SpecialOffer = vSpecialOfferByPromoCode;
			vMgr.ParentDoc = Undefined;
			vMgr.GuestGroup = vDocObj.GuestGroup;
			vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
			vMgr.Write(True);
		EndIf;
	EndIf;
	If ValueIsFilled(vPromoDiscountType) Then
		vDocObj.DiscountCard = vPromoDiscountCard;
		vDocObj.DiscountType = vPromoDiscountType;
		vDocObj.DiscountServiceGroup = vDocObj.DiscountType.DiscountServiceGroup;
		vDiscountTypeObj = vDocObj.DiscountType.GetObject();
		vDocObj.Discount = vDiscountTypeObj.pmGetDiscount(vDocObj.CheckInDate, , vDocObj.Hotel);
		For Each vRRRow In vDocObj.RoomRates Do
			vRRRow.Discount = "";
		EndDo;
	EndIf;
	
	// Try to find previous reservation to be used as template for guest and charging rules
	vPrevReservation = cmGetPreviousReservation(vDocObj.GuestGroup, vDocObj.CheckInDate, vDocObj.AccommodationType, , vDocObj.Guest, vDocObj.Customer);
	If ValueIsFilled(vPrevReservation) Then
		// Fill bound attributes
		cmFillAttributesFromParentDocument(vDocObj, vPrevReservation, True);
	ElsIf vDocObj.IsNew() Then
		If ValueIsFilled(pRoomReservation) And ValueIsFilled(vDocObj.AccommodationType) And vDocObj.AccommodationType.PostToRoomMainFolio Then
			// Use folios from the one room document
			cmUseParentChargingRules(vDocObj, pRoomReservation, True);
		Else
			// Call API to fill default charging rules
			If Not pIgnoreCustomerChargingRules Then
				vNewPaymentMethod = Undefined;
				If vIgnoreCustomerPaymentMethod And ValueIsFilled(vPaymentMethod) Then
					vNewPaymentMethod = vPaymentMethod;
				EndIf;	
				vDocObj.pmLoadChargingRules(?(ValueIsFilled(vDocObj.Contract), vDocObj.Contract, vDocObj.Customer), vNewPaymentMethod);
			EndIf;
			// Fill charging rules according to the payment method selected
			If ValueIsFilled(vDocObj.PlannedPaymentMethod) Then
				// Get first charging rules row
				v1CRRow = vDocObj.ChargingRules.Get(0);
				// Check planned payment method
				If vDocObj.PlannedPaymentMethod.IsByBankTransfer Then
					If ValueIsFilled(vDocObj.Customer) Then
						If ValueIsFilled(v1CRRow.Owner) And 
						   (v1CRRow.Owner = vDocObj.Customer Or v1CRRow.Owner = vDocObj.Contract) Then
							// Update folio payment method to the document one
							vFolioObj = v1CRRow.ChargingFolio.GetObject();
							vFolioObj.PaymentMethod = vDocObj.PlannedPaymentMethod;
							vFolioObj.Write(DocumentWriteMode.Write);
						Else
							// Create new folio and take parameters from the hotel
							If Not pIgnoreCustomerChargingRules Then
								vCR = vDocObj.ChargingRules.Insert(0);
								// Fill folio
								vOldFolioRef = cmGetChargingRulesRowFolio(vDocObj.GuestGroup, vDocObj.Ref, vCR.LineNumber);
								If ValueIsFilled(vOldFolioRef) Then
									vFolioObj = vOldFolioRef.GetObject();
									vFolioObj.DeletionMark = False;
								Else
									vFolioObj = Documents.Folio.CreateDocument();
								EndIf;
								cmFillFolioFromTemplate(vFolioObj, Undefined, vDocObj.Hotel, vDocObj.Date);
								vFolioObj.ParentDoc = vDocObj.Ref;
								vFolioObj.Customer = vDocObj.Customer;
								vFolioObj.Contract = vDocObj.Contract;
								vFolioObj.Agent = vDocObj.Agent;
								vFolioObj.GuestGroup = vDocObj.GuestGroup;
								vFolioObj.FolioCurrency = vDocObj.Customer.AccountingCurrency;
								vFolioObj.PaymentMethod = vDocObj.PlannedPaymentMethod;
								vFolioObj.Write(DocumentWriteMode.Write);
								// Add this folio to the reservation charging rules
								vCR.ChargingRule = Enums.ChargingRuleTypes.InRate;
								If ValueIsFilled(vDocObj.Contract) Then
									vCR.Owner = vDocObj.Contract;
								Else
									vCR.Owner = vDocObj.Customer;
								EndIf;
								vCR.ChargingFolio = vFolioObj.Ref;
							EndIf;
						EndIf;
					EndIf;
				Else
					// Delete or update customer charging rule row
					If ValueIsFilled(vDocObj.Customer) And ValueIsFilled(vPaymentMethod) Then
						vDocObj.pmRemoveChargingRules(?(ValueIsFilled(vDocObj.Contract), vDocObj.Contract, vDocObj.Customer));
					EndIf;
					// Update folio payment method to the document one
					For Each v1CRRow In vDocObj.ChargingRules Do
						If Not v1CRRow.IsTransfer Then
							vFolioObj = v1CRRow.ChargingFolio.GetObject();
							vFolioObj.PaymentMethod = vDocObj.PlannedPaymentMethod;
							vFolioObj.Write(DocumentWriteMode.Write);
							Break;
						EndIf;
					EndDo;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	
	// Load occupation percents
	If vOccupationPercents <> Undefined Then
		vDocObj.OccupationPercents.Load(vOccupationPercents);
	EndIf;
	
	// Calculate resources
	vDocObj.pmCalculateResources();
	
	// Fill room
	If Not IsBlankString(pRoomCode) Then
		vDocObj.Room = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Rooms", pRoomCode);
	Else
		If Not ValueIsFilled(vDocObj.Room) And ValueIsFilled(vDocObj.AccommodationType) And vDocObj.AccommodationType.Type = Enums.AccomodationTypes.Room Then
			vDocObj.Room = cmGetDefaultRoom(vDocObj.NumberOfBeds, vDocObj.Hotel, vDocObj.Company, vDocObj.RoomQuota, vDocObj.RoomType, vDocObj.CheckInDate, vDocObj.CheckOutDate, vDocObj.Guest);
		EndIf;
	EndIf;
	If ValueIsFilled(vDocObj.Room) Then
		If ValueIsFilled(vDocObj.Room.Company) Then
			vDocObj.Company = vDocObj.Room.Company;
		EndIf;
	EndIf;
	
	// Recalculate resources after room change
	vDocObj.pmCalculateResources();
	
	If pRatePlans <> Undefined Then
		vCurRate = vDocObj.RoomRate;
		For Each vRatePlanRow In pRatePlans Do
			If ValueIsFilled(vRatePlanRow.RoomRateCode) and ValueIsFilled(vRatePlanRow.Period) Then
				vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", vRatePlanRow.RoomRateCode);
				If ValueIsFilled(vRoomRate) And vCurRate <> vRoomRate Then
					vNewRow = vDocObj.RoomRates.Add();
					vNewRow.RoomRate = vRoomRate;
					vNewRow.AccountingDate = vRatePlanRow.Period;
					vNewRow.ChangeTime = ?(ValueIsFilled(vRoomRate.ReferenceHour), vRoomRate.ReferenceHour, '00010101' + 12 * 3600);
					
					vCurRate = vRoomRate;
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	
	// Accommodation template
	vDocObj.AccommodationTemplate = pAccommodationTemplate;
	If ValueIsFilled(pAccommodationTemplate) Then
		vDocObj.NumberOfAdults = pAccommodationTemplate.NumberOfAdults;
		vDocObj.NumberOfTeenagers = pAccommodationTemplate.NumberOfTeenagers;
		vDocObj.NumberOfChildren = pAccommodationTemplate.NumberOfChildren;
		vDocObj.NumberOfInfants = pAccommodationTemplate.NumberOfInfants;
	Else
		vDocObj.NumberOfAdults = 0;
		vDocObj.NumberOfTeenagers = 0;
		vDocObj.NumberOfChildren = 0;
		vDocObj.NumberOfInfants = 0;
	EndIf;
	
	// Update special offer status if found
	If pIsUpgrade <> Undefined And pIsUpgrade Then
		WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Information, , , "Room type UPGRADE is found! Room type is " + TrimAll(vDocObj.RoomType) + ", price is calculated for " + TrimAll(vDocObj.RoomTypeUpgrade) + ". Document is " + TrimAll(vDocObj.Ref), EventLogEntryTransactionMode.Independent); 
		vOffer = Undefined;
		vOfferWasFound = False;
		vOffers = cmGetPendingSpecialOffersForReservation(vDocObj.Ref, True);
		For Each vOffersRow In vOffers Do
			vOffer = vOffersRow.SpecialOffer;
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Information, , , "Special offer " + TrimAll(vOffer) + " is found", EventLogEntryTransactionMode.Independent); 
			For Each vOfferRow In vOffer.RoomTypeUpgrades Do
				If vOfferRow.RoomTypeTo = vDocObj.RoomType And vOfferRow.RoomTypeFrom = vDocObj.RoomTypeBeforeUpgrade Then
					vOfferWasFound = True;
					Break;
				EndIf;
			EndDo;
			If vOfferWasFound Then
				WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Information, , , "Special offer " + TrimAll(vOffer) + " will be processed for upgrade", EventLogEntryTransactionMode.Independent); 
				Break;
			EndIf;
		EndDo;
		// Check reservation period
		vRecalcDuration = False;
		If ValueIsFilled(vDocObj.RoomRate) Then
			vWrkRoomRate = vDocObj.RoomRate;
			If BegOfDay(cm0SecondShift(vDocObj.CheckInDate)) = cm0SecondShift(vDocObj.CheckInDate) Then
				If ValueIsFilled(vWrkRoomRate.DefaultCheckInTime) Then
					vDocObj.CheckInDate = cm1SecondShift(BegOfDay(vDocObj.CheckInDate) + (vWrkRoomRate.DefaultCheckInTime - BegOfDay(vWrkRoomRate.DefaultCheckInTime))); 
				ElsIf ValueIsFilled(vWrkRoomRate.ReferenceHour) Then
					vDocObj.CheckInDate = cm1SecondShift(BegOfDay(vDocObj.CheckInDate) + (vWrkRoomRate.ReferenceHour - BegOfDay(vWrkRoomRate.ReferenceHour))); 
				EndIf;
				vRecalcDuration = True;
			EndIf;
			If BegOfDay(cm0SecondShift(vDocObj.CheckOutDate)) = cm0SecondShift(vDocObj.CheckOutDate) Then
				If ValueIsFilled(vWrkRoomRate.DefaultCheckOutTime) Then
					vDocObj.CheckOutDate = cm0SecondShift(BegOfDay(vDocObj.CheckOutDate) + (vWrkRoomRate.DefaultCheckOutTime - BegOfDay(vWrkRoomRate.DefaultCheckOutTime))); 
				ElsIf ValueIsFilled(vWrkRoomRate.ReferenceHour) Then
					vDocObj.CheckOutDate = cm0SecondShift(BegOfDay(vDocObj.CheckOutDate) + (vWrkRoomRate.ReferenceHour - BegOfDay(vWrkRoomRate.ReferenceHour))); 
				EndIf;
				vRecalcDuration = True;
			EndIf;
		EndIf;
		If vRecalcDuration Then
			vDocObj.Duration = vDocObj.pmCalculateDuration();
		EndIf;
		// Try to find this offer in registers and update it's status
		vOfferIsUpdated = False;
		If ValueIsFilled(vOffer) Then
			// Search and update
			vMgr = InformationRegisters.SpecialOffersForReservations.CreateRecordManager();
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.ParentDoc = vDocObj.Ref;
				vMgr.GuestGroup = Catalogs.GuestGroups.EmptyRef();
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.ParentDoc = Undefined;
				vMgr.GuestGroup = vDocObj.GuestGroup;
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.ParentDoc = vDocObj.Ref;
				vMgr.GuestGroup = vDocObj.GuestGroup;
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			vMgr = InformationRegisters.SpecialOffersForClients.CreateRecordManager();
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.Client = vDocObj.Guest;
				vMgr.Customer = Catalogs.Customers.EmptyRef();
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.Client = Catalogs.Clients.EmptyRef();
				vMgr.Customer = vDocObj.Customer;
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			If Not vOfferIsUpdated Then
				vMgr.SpecialOffer = vOffer;
				vMgr.Client = vDocObj.Guest;
				vMgr.Customer = vDocObj.Customer;
				vMgr.Read();
				If vMgr.Selected() And vMgr.OfferStatus = Enums.OfferStatuses.Pending Then
					vMgr.OfferStatus = Enums.OfferStatuses.Confirmed;
					vMgr.Write(True);
					vOfferIsUpdated = True;
				EndIf;
			EndIf;
			If Not vOfferIsUpdated Then
				WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Externe Reservierung einschreiben'"), EventLogLevel.Warning, , , 
									"Special offer " + TrimAll(vOffer) + " status record was not found!", EventLogEntryTransactionMode.Independent); 
			EndIf;
		EndIf;
	EndIf;
	
	// Calculate services
	vDocObj.pmCalculateServices();
	
	// Set planned payment method
	vDocObj.pmSetPlannedPaymentMethod();
	
	// Prices per date
	If pPricesPerDate <> Undefined Then
		vServices = vDocObj.Services.Unload();
		For Each vServicesRow In vServices Do
			vServiceRef = vServicesRow.Service;
			If ValueIsFilled(vServiceRef) And ValueIsFilled(vServiceRef.QuantityCalculationRule) Then
				vAccountingDateMove = cmGetAccountingDateMove(vServiceRef.QuantityCalculationRule, vServicesRow.IsManual, vDocObj, False); 
				If vAccountingDateMove < 0 Then
					vServicesRow.AccountingDate = vServicesRow.AccountingDate - tcCommonFunctionOnClientServer.cmOneDay();
				EndIf;
			EndIf;
		EndDo;
		For Each vPricePerDateRow In pPricesPerDate.PricePerDateRow Do
			If ValueIsFilled(vPricePerDateRow.Date) Then
				vDayPriceCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", vPricePerDateRow.Currency);
				If ValueIsFilled(vDayPriceCurrency) Then
					vDayPrice = vPricePerDateRow.Price;
					vDayRoomRate = Undefined;
					vFirstRoomRevenueServiceIsFound = False;
					vFirstRoomRevenueDayServicesRowIndex = -1;
					vDayServicesRows = vServices.FindRows(New Structure("AccountingDate, IsInPrice", BegOfDay(vPricePerDateRow.Date), True));
					i = 0;
					For Each vDayServicesRow In vDayServicesRows Do
						If Not vFirstRoomRevenueServiceIsFound And vDayServicesRow.IsRoomRevenue And Not vDayServicesRow.IsSplit And Not vDayServicesRow.RoomRevenueAmountsOnly Then
							vFirstRoomRevenueServiceIsFound = True;
							vFirstRoomRevenueDayServicesRowIndex = i;
							vDayRoomRate = vDayServicesRow.RoomRate;
							Break;
						EndIf;
						i = i + 1;
					EndDo;
					i = 0;
					For Each vDayServicesRow In vDayServicesRows Do
						If i <> vFirstRoomRevenueDayServicesRowIndex Then
							vSubtractServicesRowPrice = False;
							vDayServicesRowServicePackage = vDayServicesRow.ServicePackage;
							If ValueIsFilled(vDayServicesRowServicePackage) Then
								vServicePackageIsFromRoomRate = False;
								If ValueIsFilled(vRoomRate) Then
									If vRoomRate.ServicePackage = vDayServicesRowServicePackage Or 
									   vRoomRate.ServicePackages.Find(vDayServicesRowServicePackage, "ServicePackage") <> Undefined Then
										vServicePackageIsFromRoomRate = True;
									EndIf;
								EndIf;
								If vServicePackageIsFromRoomRate Then
									// This service package is from the room rate
									vSubtractServicesRowPrice = True;
								Else
									// This service package is added in reservation
									If vDayServicesRowServicePackage.UsageType = Enums.ServicePackageUsageType.SubtractFromRoomRatePrice Then
										vSubtractServicesRowPrice = True;
									EndIf;
								EndIf;
							Else
								// This is service from the room rate specification
								vSubtractServicesRowPrice = True;
							EndIf;
							If vSubtractServicesRowPrice And vDayServicesRow.Sum > 0 Then
								vDayPrice = vDayPrice - vDayServicesRow.Sum;
							EndIf;
						EndIf;
						i = i + 1;
					EndDo;
					If vDayPrice >= 0 Then
						vServicesRows = vDocObj.Services.FindRows(New Structure("AccountingDate, IsRoomRevenue, IsInPrice, IsSplit, RoomRevenueAmountsOnly", BegOfDay(vPricePerDateRow.Date), True, True, False, False));
						If vServicesRows.Count() > 0 Then
							vServicesRow = vServicesRows.Get(0);
							vDayPrice = cmConvertCurrencies(vDayPrice, vDayPriceCurrency, , vServicesRow.FolioCurrency, , vDocObj.ExchangeRateDate, vHotel);
							If vDayPrice >= 0 Then
								vServicesRow.Sum = vDayPrice;
								cmSumOnChange(vServicesRow.Service, vServicesRow.Price, vServicesRow.Quantity, vServicesRow.Sum, vServicesRow.VATRate, vServicesRow.VATSum, True, vServicesRow.AccountingDate);
								vServicesRow.IsManualPrice = True;
								vServicesRow.DiscountType = Undefined;
								vServicesRow.Discount = 0;
								vServicesRow.DiscountSum = 0;
								vDocObj.pmCalculateServiceCommissions(vServicesRow);
							EndIf;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	
    // Recalculate price presentation
	vDocObj.PricePresentation = vDocObj.pmCalculatePricePresentation();
	
	// Write document
	If pDoPosting Then
		vDocObj.Write(DocumentWriteMode.Posting);
	Else
		If vDocObj.Posted Then
			vDocObj.Write(DocumentWriteMode.Posting);
		Else
			vDocObj.Write(DocumentWriteMode.Write);
		EndIf;
	EndIf;
	// Save data to the reservation change history
	vDocObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
	
	// Update group external code if necessary
	If pNewExtGroupCode <> Undefined And Not IsBlankString(pNewExtGroupCode) And ValueIsFilled(vDocObj.GuestGroup) And TrimAll(vDocObj.GuestGroup.ExternalCode) <> TrimAll(pNewExtGroupCode) Then
		vGuestGroupObj = vDocObj.GuestGroup.GetObject();
		vGuestGroupObj.ExternalCode = TrimAll(pNewExtGroupCode);
		If TrimAll(vGuestGroupObj.Description) = TrimAll(pExtGroupCode) Then
			vGuestGroupObj.Description = TrimAll(pNewExtGroupCode);
		EndIf;
		If TrimAll(vGuestGroupObj.ID) = TrimAll(pExtGroupCode) Then
			vGuestGroupObj.ID = TrimAll(pNewExtGroupCode);
		EndIf;
		vGuestGroupObj.Write();
	EndIf;
	// Save deal ID mapping for bitrix24 in order to export data from 1C-Hotel to Bitrix24 and update the deal	
	If ValueIsFilled(vExtSystem) And vExtSystem.IntegrationType = Enums.Integrations.Bitrix24  Then
		// Bitrix24 deal ID is stored in special mapping register. Retrieve it.
		InformationRegisters.ExternalSystemIntegrationData.WriteData(vExtSystem, "deals", "updatePeriod", vDocObj.GuestGroup, Undefined,CurrentSessionDate(),pID);
	EndIf;
	
	// Orders and transfer orders
	If vOrders.Count() > 0 Then
		For Each vOrderItem In vOrders Do
			vOrder = vOrderItem.Value;
			vType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "OrderTypes", vOrder.OrderType);
			vDepartment = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Departments", vOrder.Department);
			vPassengersNumber = vOrder.PassengersNumber;
			vTransferService = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Services", vOrder.TransferType);
			vTransferType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "TransferTypes", vOrder.TransferType);
			Orders.CreateOrderFromObjects(pExternalSystemCode, vDocObj.Hotel, "", vType, 
										  vDepartment, vOrder.OrderDate, vDocObj.Guest, vDocObj.Room, vDocObj.Phone,
										  vOrder.TransferRemarks, vOrder.Sum, vOrder.Destination, "", vPassengersNumber, vOrder.TransferChildseats, vTransferType, , , ,
										  vDocObj.Ref, vDocObj.GuestGroup, ?(ValueIsFilled(vOrder.TransferType), vTransferService, vOrder.Service));
			
		EndDo;
	EndIf;
	
	// Write guest group attachment that reservation was received
	vSkipNotification = pSkipNotification;
	If Not vSkipNotification And ValueIsFilled(vDocObj.GuestGroup.Client) And 
	   Not IsBlankString(vDocObj.GuestGroup.Client.EMail) And 
	   ValueIsFilled(vDocObj.ReservationStatus) Then
		If vDocObj.ReservationStatus.DeliveryType <> Enums.DeliveryTypes.DoNotSend Then
			cmWriteReservationConfirmationGuestGroupAttachment(vDocObj);
		EndIf;
	EndIf;
	
	// Write task with extra services description for that guest
	If Not IsBlankString(vServicesMessage) And ValueIsFilled(vDocObj.Ref) Then
		cmSendMessageToObject(vDocObj.Ref, vServicesMessage, , False);
	EndIf;
	
	// Return
	Return vDocObj;
EndFunction // cmWriteExternalReservationRow

// -----------------------------------------------------------------------------
// Description: This API is used to return allotment from allotments folder with 
// specified number of vacant rooms for the given period
// -----------------------------------------------------------------------------
Function GetSuitableAllotment(pHotel, pAllotmentsFolder, pRoomType, pNumberOfRooms, pCheckInDate, pCheckOutDate)
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	RoomQuotaSalesBalanceAndTurnovers.RoomQuota AS RoomQuota,
	|	MAX(RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) AS RoomsRemains,
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance) AS BedsRemains
	|FROM
	|	AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
	|			&qPeriodFrom,
	|			&qPeriodTo,
	|			Minute,
	|			RegisterRecordsAndPeriodBoundaries,
	|			Hotel = &qHotel
	|				AND RoomType = &qRoomType
	|				AND RoomQuota IN HIERARCHY (&qRoomQuota)) AS RoomQuotaSalesBalanceAndTurnovers
	|
	|GROUP BY
	|	RoomQuotaSalesBalanceAndTurnovers.RoomQuota
	|
	|HAVING
	|	MIN(RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance) >= &qNumberOfRooms
	|
	|ORDER BY
	|	RoomQuotaSalesBalanceAndTurnovers.RoomQuota.SortCode,
	|	RoomQuotaSalesBalanceAndTurnovers.RoomQuota.Code";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qRoomType", pRoomType);
	vQry.SetParameter("qRoomQuota", pAllotmentsFolder);
	vQry.SetParameter("qPeriodFrom", cmMovePeriodFromToReferenceHour(pCheckInDate, pHotel.RoomRate));
	vQry.SetParameter("qPeriodTo", cmMovePeriodToToReferenceHour(pCheckOutDate, pHotel.RoomRate));
	vQry.SetParameter("qNumberOfRooms", pNumberOfRooms);
	vAllotments = vQry.Execute().Unload();
	For Each vRow In vAllotments Do
		If ValueIsFilled(vRow.RoomQuota) Then
			Return vRow.RoomQuota;
		EndIf;
	EndDo;
	Return Undefined;
EndFunction // GetSuitableAllotment

// -----------------------------------------------------------------------------
//  This API is used to write reservation confirmation print form to the guest group attachments information register
//
// Parameters:
//  vDocObj				- DocumentObject	- Document reservation
//  pUseCustomerEMail	- Boolean			- Use customer EMail
//  pEMail				- String			- E-Mail to send confirmation to. Use Undefined for autoselect
//	pTemplateType       - Number            - Reservation confirmation template type: 
//                                            0 - Confirmation for guest; 
//                                            1 - Confirmation fo agent;
//                                            2 - Confirmation for reservation department
//                                            Use Undefined for autoselect
//
Procedure cmWriteReservationConfirmationGuestGroupAttachment(vDocObj, pUseCustomerEMail = False, pEMail = Undefined, pTemplateType = Undefined) Export
	vHotel = vDocObj.Hotel;
	vLanguage = vHotel.Language;
	If ValueIsFilled(vDocObj.GuestGroup.Client.Language) Then
		vLanguage = vDocObj.GuestGroup.Client.Language;
	EndIf;
	vTemplateType = 0;
	If pTemplateType <> Undefined Then
		vTemplateType = pTemplateType;
	Else
		If pUseCustomerEMail And Not ValueIsFilled(pEMail) Then
			vTemplateType = 1;
		EndIf;
	EndIf;

	// Room type to print
	vRoomTypeToPrint = vDocObj.RoomType;
	If ValueIsFilled(vRoomTypeToPrint) And ValueIsFilled(vDocObj.RoomTypeUpgrade) And vDocObj.RoomTypeUpgrade.BaseRoomType = vRoomTypeToPrint Then
		vRoomTypeToPrint = vDocObj.RoomTypeUpgrade;
	EndIf;	
	
	vHotelPrintName = ""; 
	vHotelPostAddress = "";   
	vDriveToTheHotel = "";
	If ValueIsFilled(vHotel) Then
		vHotelPrintName = Catalogs.Hotels.pmGetHotelPrintName(vHotel, vLanguage); 
		vHotelPostAddress = Catalogs.Hotels.pmGetHotelPostAddressPresentation(vHotel, vLanguage); 
		vDriveToTheHotel = Catalogs.Hotels.pmGetHotelHowToDriveToTheHotelDescription(vHotel, vLanguage);
	EndIf;   
	vReservationStatusDescription = Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vDocObj.ReservationStatus, vLanguage);    
	vGuestGroupCode = Format(vDocObj.GuestGroup.Code, "ND=12; NFD=0; NG=");
	vClientName = "";
	If ValueIsFilled(vDocObj.Guest) Then
		vClientName = cmNStr("en='Client name: ';ru='Клиент: ';de='Kunde Name: '", vLanguage) + TrimAll(vDocObj.Guest.FullName) + Chars.LF;	
	EndIf;
	vPeriod = "";
	If ValueIsFilled(vDocObj.CheckInDate) And ValueIsFilled(vDocObj.CheckOutDate) Then
		vPeriod = StrTemplate(cmNStr("en = 'Period of stay: %1 - %2'; 
									 |de = 'Unterbringungszeitraum: %1 - %2'; 
									 |ru = 'Период проживания: %1 - %2'", vLanguage), Format(vDocObj.CheckInDate, "DF='dd.MM.yyyy HH:mm'"), Format(vDocObj.CheckOutDate, "DF='dd.MM.yyyy HH:mm'")) + Chars.LF; 
	EndIf;
	
	vMessageSubject = vHotelPrintName 
						+ StrTemplate(cmNStr("en = ' Reservation N%1, status %2'; 
											 |de = ' Reservierung Nr.%1, Status %2'; 
											 |ru = ' Бронь №%1, статус %2'", vLanguage), vGuestGroupCode, vReservationStatusDescription);
						
	vMessageText = StrTemplate(cmNStr("en='Reservation number %1 was created and successfully processed!'; 
	                                  |de='Reservation number %1 was created and successfully processed!'; 
	                                  |ru='Бронь номер %1 создана и успешно обработана!'", vLanguage), vGuestGroupCode) + Chars.LF + Chars.LF 
						   + vClientName
			               + vPeriod  
			               + cmNStr("en='Room type: ';ru='Тип номера: ';de='Zimmertyp: '", vLanguage) + vRoomTypeToPrint.GetObject().pmGetRoomTypeDescription(vLanguage) + Chars.LF + Chars.LF 
			               + StrTemplate(cmNStr("en='Reservation status was set to %1';ru='Статус брони установлен на %1';de='Status der Reservierung wurde festgesetzt mit %1'", vLanguage), vReservationStatusDescription) + Chars.LF + Chars.LF 
			               + TrimAll(cmGetReservationConditions(vDocObj, vLanguage)) + Chars.LF + Chars.LF 
						   + vHotelPostAddress + Chars.LF + Chars.LF 
						   + vDriveToTheHotel + Chars.LF + Chars.LF 
						   + cmNStr("en='Best regards,'; 
			                        |de='Best regards,'; 
			                        |ru='С уважением,'", vLanguage) + Chars.LF 
						   + vHotelPrintName + Chars.LF 
						   + cmNStr(SessionParameters.ConfigurationName, vLanguage);

	// Print reservation confirmation
	vObjectPrintForm = Catalogs.ObjectPrintingForms.EmptyRef();
	If vLanguage = Catalogs.Languages.RU Then
		If vTemplateType = 1 Then
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentReservationConfirmationPrintingFormRu) Then
				vObjectPrintForm = vHotel.AgentReservationConfirmationPrintingFormRu;
			EndIf;
		Else
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.GuestReservationConfirmationPrintingFormRu) Then
				vObjectPrintForm = vHotel.GuestReservationConfirmationPrintingFormRu;
			EndIf;
		EndIf;
	ElsIf vLanguage = Catalogs.Languages.EN Then
		If vTemplateType = 1 Then
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentReservationConfirmationPrintingFormEn) Then
				vObjectPrintForm = vHotel.AgentReservationConfirmationPrintingFormEn;
			EndIf;
		Else
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.GuestReservationConfirmationPrintingFormEn) Then
				vObjectPrintForm = vHotel.GuestReservationConfirmationPrintingFormEn;
			EndIf;
		EndIf;
	ElsIf vLanguage = Catalogs.Languages.DE Then
		If vTemplateType = 1 Then
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentReservationConfirmationPrintingFormDe) Then
				vObjectPrintForm = vHotel.AgentReservationConfirmationPrintingFormDe;
			EndIf;
		Else
			If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.GuestReservationConfirmationPrintingFormDe) Then
				vObjectPrintForm = vHotel.GuestReservationConfirmationPrintingFormDe;
			EndIf;
		EndIf;
	EndIf; 
	vMessageTemplate = Undefined;
	If ValueIsFilled(vHotel) Then
		If vTemplateType = 0 And ValueIsFilled(vHotel.TemplateSendReservationConfirmationByEMail) Then
			vMessageTemplate = vHotel.TemplateSendReservationConfirmationByEMail;
		ElsIf vTemplateType = 1 And ValueIsFilled(vHotel.TemplateSendAgentReservationConfirmationByEMail) Then
			vMessageTemplate = vHotel.TemplateSendAgentReservationConfirmationByEMail;
		ElsIf vTemplateType = 2 And ValueIsFilled(vHotel.TemplateSendReservationDepartmentReservationConfirmationByEMail) Then
			vMessageTemplate = vHotel.TemplateSendReservationDepartmentReservationConfirmationByEMail;
		EndIf;
		If ValueIsFilled(vMessageTemplate) Then
			vMessageSubject = cmNStr(TrimAll(vMessageTemplate.Description), vLanguage);
			If ValueIsFilled(vMessageTemplate.HTMLTextRu) Or ValueIsFilled(vMessageTemplate.HTMLTextEn) Or ValueIsFilled(vMessageTemplate.HTMLTextDe) Then
				vMessageText = SMS.GetHTMLTextByLanguage(vMessageTemplate, vLanguage);
			EndIf;
			If IsBlankString(vMessageText) Then
				vMessageText = SMS.GetSMSTextByLanguage(vMessageTemplate, vLanguage);
			EndIf;
			If vMessageTemplate.AttachDocumentPrintFormToEMail Then
				If ValueIsFilled(vMessageTemplate.ObjectPrintingFormRu) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormRu;
				EndIf;
				If vLanguage = Catalogs.Languages.EN And ValueIsFilled(vMessageTemplate.ObjectPrintingFormEn) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormEn;
				ElsIf vLanguage = Catalogs.Languages.DE And ValueIsFilled(vMessageTemplate.ObjectPrintingFormDe) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormDe;
				EndIf;
			EndIf;
		EndIf;
	EndIf; 
	vConfirmationFileName = ""; 
	vConfirmationFilePath = "";
	If ValueIsFilled(vObjectPrintForm) Then 
		vConfirmationSpreadsheet = New SpreadsheetDocument();
		If pUseCustomerEMail And Find(vObjectPrintForm.Parameter, "DO_NOT_SEND_RESERVATION_CONFIRMATION_TO_AGENT") > 0 Then
			Return;
		EndIf;
		If Not pUseCustomerEMail And Find(vObjectPrintForm.Parameter, "DO_NOT_SEND_RESERVATION_CONFIRMATION_TO_CLIENT") > 0 Then
			Return;
		EndIf;
		If ValueIsFilled(vObjectPrintForm.ExternalProcessing) Then
			vExtDataProcessor = cmGetExternalDataProcessorObject(vObjectPrintForm.ExternalProcessing);
			vExtDataProcessor.pmPrintConfirmation(vConfirmationSpreadsheet, vDocObj.Ref, Undefined, 0, Catalogs.ServiceGroups.EmptyRef(), False, vLanguage, vObjectPrintForm);
		Else
			vDocObj.pmPrintConfirmation(vConfirmationSpreadsheet, vDocObj.Ref, Undefined, 0, Catalogs.ServiceGroups.EmptyRef(), False, vLanguage, vObjectPrintForm);
		EndIf;
		// Save reservation confirmation to the temp PDF file
		vResFileNumber = "";
		If Find(vObjectPrintForm.Parameter, "USE_INDIVIDUAL_RESERVATION_NUMBER_FOR_FILE") > 0 Then
			vResFileNumber = vDocObj.Number;
		Else
			vResFileNumber = vGuestGroupCode;
		Endif;
		vConfirmationFileName = StrReplace(vDocObj.Ref.Metadata().Presentation() + " " + vResFileNumber, " ", "_") + ".pdf";
		vConfirmationFilePath = cmGetFullFileName(vConfirmationFileName, TempFilesDir());
		vConfirmationSpreadsheet.Write(vConfirmationFilePath, SpreadsheetDocumentFileType.PDF);
	EndIf;
	
	// Call user exit procedure to give possibility to override message subject and message text
	vUserExitProc = Catalogs.ExternalDataProcessors.WriteExternalReservationConfirmation;
	If ValueIsFilled(vUserExitProc) Then
		If vUserExitProc.ExternalProcessingType = Enums.ExternalProcessingTypes.Algorithm Then
			If Not IsBlankString(vUserExitProc.Algorithm) Then
				SetSafeMode(True);
				Execute(TrimAll(vUserExitProc.Algorithm));
				SetSafeMode(False);
			EndIf;
		EndIf;
	EndIf;
	
	// Write attachment
	If (Not IsBlankString(vMessageSubject) And Not IsBlankString(vMessageText)) Or ValueIsFilled(vMessageTemplate) Then     
		InformationRegisters.GuestGroupAttachments.WriteData(, vDocObj.GuestGroup, , , , , , ?(Not IsBlankString(pEMail), pEMail, Undefined), , Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, 
		                                                     vMessageText, vMessageTemplate, vDocObj.Ref, , , vConfirmationFilePath, vConfirmationFileName, True, vMessageSubject);
	EndIf;
EndProcedure // cmWriteReservationConfirmationGuestGroupAttachment

// -----------------------------------------------------------------------------
//  This API is used to write reservation confirmation print form to the guest group attachments information register
//
// Parameters:
//  vDocObj	 - DocumentObject	 - Document reservation 
// 
// Returns:
//  String - Base64Text
//
Function cmWriteReservationInvoiceGuestGroupAttachment(vDocObj) Export
	// Get hotel and language
	vHotel = vDocObj.Hotel;
	vLanguage = vHotel.Language;
	If ValueIsFilled(vDocObj.Customer.Language) Then
		vLanguage = vDocObj.Customer.Language;
	EndIf;
	
	// Create and write guest group invoice object
	vInvoiceObj = Documents.ProformaInvoice.CreateDocument();
	vInvoiceObj.Fill(vDocObj.Ref);
	vInvoiceObj.ParentDoc = Undefined;
	vInvoiceObj.Fill(vDocObj.GuestGroup);
	vBase64Text = "";
	If vInvoiceObj.Services.Count() = 0 Then
		Return vBase64Text;
	EndIf;
	vInvoiceObj.PrintWithCompanyStamp = True;
	vInvoiceObj.Write(DocumentWriteMode.Posting);
	
	vHotelPrintName = "";
	If ValueIsFilled(vHotel) Then
		vHotelPrintName = Catalogs.Hotels.pmGetHotelPrintName(vHotel, vLanguage);
	EndIf;
	vGuestGroupCode = Format(vDocObj.GuestGroup.Code, "ND=12; NFD=0; NG=");
	vClientName = "";
	If ValueIsFilled(vDocObj.Guest) Then
		vClientName = cmNStr("en='Client name: ';ru='Клиент: ';de='Kunde: '", vLanguage) + TrimAll(vDocObj.Guest.FullName) + Chars.LF;	
	EndIf;
	vPeriod = "";
	If ValueIsFilled(vDocObj.CheckInDate) And ValueIsFilled(vDocObj.CheckOutDate) Then
		vPeriod = StrTemplate(cmNStr("en = 'Period of stay: %1 - %2'; 
									 |de = 'Unterbringungszeitraum: %1 - %2'; 
									 |ru = 'Период проживания: %1 - %2'", vLanguage), Format(vDocObj.CheckInDate, "DF='dd.MM.yyyy HH:mm'"), Format(vDocObj.CheckOutDate, "DF='dd.MM.yyyy HH:mm'")) + Chars.LF; 
	EndIf;           
	vAccountingCustomer = "";    
	If ValueIsFilled(vInvoiceObj.AccountingCustomer) Then
		vAccountingCustomer = cmNStr("en='Customer name: ';ru='Организация: ';de='Firma: '", vLanguage) + TrimAll(vInvoiceObj.AccountingCustomer.LegacyName) + Chars.LF;
	EndIf;
	
    vDocumentNumberPresentation = cmGetDocumentNumberPresentation(vInvoiceObj.Number);   
	vDocDatePres = Format(vInvoiceObj.Date, "DF=dd.MM.yyyy");
	// Print guest group invoice
	vMessageSubject = vHotelPrintName
					+ StrTemplate(cmNStr("en=' Proforma invoice N %1 for reservation N %2'; 
				                         |de=' Proforma-Rechnung Nr. %1 für Reservierung Nr. %2'; 
				                         |ru=' Счет на оплату № %1 по брони № %2'", vLanguage), vDocumentNumberPresentation, vGuestGroupCode);
	vMessageText = StrTemplate(cmNStr("en='Proforma invoice N %1 (%2) was generated for reservation number %3'; 
									  |de='Proforma-Rechnung Nr. %1 (%2) wurde für die Reservierungsnummer %3  generiert'; 
									  |ru='Счет на оплату № %1 от %2 создан по брони № %3'", vLanguage), vDocumentNumberPresentation, vDocDatePres, vGuestGroupCode) + Chars.LF + Chars.LF 
	               + vAccountingCustomer 
	               + vClientName 
	               + vPeriod
	               + cmNStr("en='Best regards,';de='Best regards,'; ru='С уважением,'", vLanguage) + Chars.LF  
	               + vHotelPrintName + Chars.LF 
				   + cmNStr(SessionParameters.ConfigurationName, vLanguage);

	vRefillGroupBy = False;
	vInvoiceSpreadsheet = New SpreadsheetDocument();
	vSelGroupBy = "ByService";
	vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintShortInvoiceGroupByServiceRu;
	If vLanguage = Catalogs.Languages.RU Then
		If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentInvoicePrintingFormRu) Then
			vObjectPrintForm = vHotel.AgentInvoicePrintingFormRu;
			vRefillGroupBy = True;
		EndIf;
	ElsIf vLanguage = Catalogs.Languages.EN Then
		vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintShortInvoiceGroupByServiceEn;
		If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentInvoicePrintingFormEn) Then
			vObjectPrintForm = vHotel.AgentInvoicePrintingFormEn;
			vRefillGroupBy = True;
		EndIf;
	ElsIf vLanguage = Catalogs.Languages.DE Then
		vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintShortInvoiceGroupByServiceDe;
		If ValueIsFilled(vHotel) And ValueIsFilled(vHotel.AgentInvoicePrintingFormDe) Then
			vObjectPrintForm = vHotel.AgentInvoicePrintingFormDe;
			vRefillGroupBy = True;
		EndIf;
	EndIf;  
	vMessageTemplate = Undefined; 
	vMessageParameters = Undefined;
	If ValueIsFilled(vDocObj.Hotel) Then
		vMessageTemplate = vDocObj.Hotel.TemplateSendInvoiceByEMail;
		If ValueIsFilled(vMessageTemplate) Then
			vMessageSubject = cmNStr(TrimAll(vMessageTemplate.Description), vLanguage);
			If ValueIsFilled(vMessageTemplate.HTMLTextRu) Or ValueIsFilled(vMessageTemplate.HTMLTextEn) Or ValueIsFilled(vMessageTemplate.HTMLTextDe) Then
				vMessageText = SMS.GetHTMLTextByLanguage(vMessageTemplate, vLanguage);
			EndIf;
			If IsBlankString(vMessageText) Then
				vMessageText = SMS.GetSMSTextByLanguage(vMessageTemplate, vLanguage);
			EndIf;
			If vMessageTemplate.AttachDocumentPrintFormToEMail Then
				If ValueIsFilled(vMessageTemplate.ObjectPrintingFormRu) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormRu;
				EndIf;
				If vLanguage = Catalogs.Languages.EN And ValueIsFilled(vMessageTemplate.ObjectPrintingFormEn) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormEn;
				ElsIf vLanguage = Catalogs.Languages.DE And ValueIsFilled(vMessageTemplate.ObjectPrintingFormDe) Then
					vObjectPrintForm = vMessageTemplate.ObjectPrintingFormDe;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	If Find(vObjectPrintForm.Parameter, "DO_NOT_SEND_INVOICE_TO_AGENT") > 0 Then
		Return "";
	EndIf;
	If vRefillGroupBy Then
		vSelGroupBy = "";
		If vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientPerDayRu Or
		   vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientPerDayEn Or
		   vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientPerDayDe Then
			vSelGroupBy = "InPricePerClientPerDay";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerDayRu Or
		      vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerDayEn Or
		      vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerDayDe Then
			vSelGroupBy = "InPricePerDay";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupPerClientRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupPerClientEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupPerClientDe Then
			vSelGroupBy = "PerClient";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupByServiceRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupByServiceEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupByServiceDe Then
			vSelGroupBy = "ByService";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientPerDayRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientPerDayEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientPerDayDe Then
			vSelGroupBy = "AllPerClientPerDay";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerDayRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerDayEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerDayDe Then
			vSelGroupBy = "AllPerDay";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPricePerClientDe Then
			vSelGroupBy = "InPricePerClient";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPriceRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPriceEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupInPriceDe Then
			vSelGroupBy = "InPrice";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllPerClientDe Then
			vSelGroupBy = "AllPerClient";
		ElsIf vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllRu Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllEn Or
			  vObjectPrintForm = Catalogs.ObjectPrintingForms.InvoicePrintInvoiceGroupAllDe Then
			vSelGroupBy = "All";
		EndIf;
	EndIf;
	mInvoiceNumber = "";
	If ValueIsFilled(vObjectPrintForm.ExternalProcessing) Then
		vExtDataProcessor = cmGetExternalDataProcessorObject(vObjectPrintForm.ExternalProcessing);
		vExtDataProcessor.pmPrintInvoice(vInvoiceSpreadsheet, vInvoiceObj.Ref, vLanguage, vSelGroupBy, vObjectPrintForm, mInvoiceNumber);
	Else
		vInvoiceObj.pmPrintInvoiceShort(vInvoiceSpreadsheet, vLanguage, vSelGroupBy, vObjectPrintForm, mInvoiceNumber);
	EndIf;
	
	// Save invoice form to the temp PDF file
	vInvoiceFileName = StrReplace(StrReplace(StrReplace(vInvoiceObj.Ref.Metadata().Presentation() + " " + vDocumentNumberPresentation, " ", "_"), "/", "-"), "\", "-") + ".pdf";
	vInvoiceFilePath = cmGetFullFileName(vInvoiceFileName, TempFilesDir());
	vInvoiceSpreadsheet.Write(vInvoiceFilePath, SpreadsheetDocumentFileType.PDF);
	vBD = New BinaryData(vInvoiceFilePath);
	vBase64Text = Base64String(vBD);
	
	// Call user exit procedure to give possibility to override message subject and message text
	vUserExitProc = Catalogs.ExternalDataProcessors.WriteGuestGroupInvoice;
	If ValueIsFilled(vUserExitProc) Then
		If vUserExitProc.ExternalProcessingType = Enums.ExternalProcessingTypes.Algorithm Then
			If Not IsBlankString(vUserExitProc.Algorithm) Then
				SetSafeMode(True);
				Execute(TrimAll(vUserExitProc.Algorithm));
				SetSafeMode(False);
			EndIf;
		EndIf;
	EndIf;
	
	InformationRegisters.GuestGroupAttachments.WriteData(, vInvoiceObj.GuestGroup,,,,,, vInvoiceObj.AccountingCustomer.EMail, vInvoiceObj.AccountingCustomer.Fax, Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, vMessageText, vMessageTemplate, vDocObj.Ref,,, vInvoiceFilePath, vInvoiceFileName, True, vMessageSubject);
	
	Return vBase64Text;
EndFunction // cmWriteReservationInvoiceGuestGroupAttachment

// -----------------------------------------------------------------------------
// Description: This API is used to create/update reservation from the external system.
//              Reservation will not be posted by default. This function could be 
//              called in simple cases when there is only one reservation in the group.
//              This function is wrapper and is using cmWriteExternalReservationRow
//              to create/update reservation
// Parameters: External reservation data, External system code, Whether to post 
//             new reservation or write only, Language code, Type of return value:
//             XDTO object or Colon Separated Values string
// Return value: XDTO ExternalReservationStatus object or CSV string
// -----------------------------------------------------------------------------
Function cmWriteExternalReservation(pExtReservationCode, pExtGroupCode, pExtGroupDescription, pGroupCustomerName,  
                                    pReservationStatusCode, pPeriodFrom, pPeriodTo, pHotelCode, pRoomTypeCode, 
                                    pAccommodationTypeCode, pClientTypeCode, pRoomQuotaCode, pRoomRateCode,
                                    pCustomerName, pContractName, pAgentName, pContactPerson, 
                                    pNumberOfRooms, pNumberOfPersons, 
                                    pExtClientCode, pClientLastName, pClientFirstName, pClientSecondName, 
                                    pClientSexCode, pClientCitizenshipCode, pClientBirthDate, 
                                    pClientPhone, pClientFax, pClientEMail, pClientRemarks, pClientSendSMS = Undefined, pRemarks, pCar, 
                                    pPlannedPaymentMethodCode, pExternalSystemCode, pDoPosting = False, pPromoCode = "", 
                                    pLanguageCode = "RU", pOutputType = "CSV") Export
	WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='External reservation code: ';ru='Код брони во внешней системе: ';de='Reservierungscode im externen System: '") + pExtReservationCode + Chars.LF + 
	              NStr("en='External group code: ';ru='Код группы во внешней системе: ';de='Gruppencode im externen System: '") + pExtGroupCode + Chars.LF + 
	              NStr("en='External group description: ';ru='Описание группы во внешней системе: ';de='Gruppenbeschreibung im externen System: '") + pExtGroupDescription + Chars.LF + 
	              NStr("en='Group customer name: ';ru='Наименование контрагента группы: ';de='Bezeichnung des GruppenPartners: '") + pGroupCustomerName + Chars.LF + 
	              NStr("en='Reservation status code: ';ru='Код статуса брони: ';de='Reservierungsstatuscode: '") + pReservationStatusCode + Chars.LF + 
	              NStr("en='Period from: ';ru='Период с: ';de='Zeitraum ab: '") + Format(pPeriodFrom, "DF='dd.MM.yyyy HH:mm'") + Chars.LF + 
	              NStr("en='Period to: ';ru='Период по: ';de='Zeitraum bis: '") + Format(pPeriodTo, "DF='dd.MM.yyyy HH:mm'") + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
	              NStr("en='Accommodation type code: ';ru='Код вида размещения: ';de='Code des Unterbringungstyps: '") + pAccommodationTypeCode + Chars.LF + 
	              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты номеров: ';de='Zimmerquotencode: '") + pRoomQuotaCode + Chars.LF + 
	              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode + Chars.LF + 
	              NStr("en='Customer name: ';ru='Наименование контрагента в брони: ';de='Bezeichnung des Partners in der Reservierung: '") + pCustomerName + Chars.LF + 
	              NStr("en='Contract name: ';ru='Наименование договора в брони: ';de='Bezeichnung für die Reservierung: '") + pContractName + Chars.LF + 
	              NStr("en='Agent name: ';ru='Наименование агента в брони: ';de='Bezeichnung des Vertreters in der Reservierung: '") + pAgentName + Chars.LF + 
	              NStr("en='Contact person: ';ru='Контактное лицо: ';de='Kontaktperson: '") + pContactPerson + Chars.LF + 
	              NStr("en='Number of rooms: ';ru='Количество номеров: ';de='Zimmeranzahl: '") + pNumberOfRooms + Chars.LF + 
	              NStr("en='Number of persons: '; ru='Количество гостей: '") + pNumberOfPersons + Chars.LF + 
	              NStr("en='External client code: ';ru='Код клиента во внешней системы: ';de='Kundecode im externen System: '") + pExtClientCode + Chars.LF + 
	              NStr("en='Client last name: ';ru='Фамилия гостя: ';de='Familienname des Gastes: '") + pClientLastName + Chars.LF + 
	              NStr("en='Client first name: ';ru='Имя гостя: ';de='Name des Gastes: '") + pClientFirstName + Chars.LF + 
	              NStr("en='Client second name: ';ru='Отчество гостя: ';de='Vatersname des Gastes: '") + pClientSecondName + Chars.LF + 
	              NStr("en='Client sex code: ';ru='Код пола гостя: ';de='Code des Geschlechts des Gastes: '") + pClientSexCode + Chars.LF + 
	              NStr("en='Client citizenship code: ';ru='Код гражданства гостя: ';de='Code der Stadtbürgerschaft des Gastes: '") + pClientCitizenshipCode + Chars.LF + 
	              NStr("en='Client birth date: ';ru='Дата рождения гостя: ';de='Geburtsdatum des Gastes: '") + Format(pClientBirthDate, "DF='dd.MM.yyyy'") + Chars.LF + 
	              NStr("en='Client phone: ';ru='Телефон гостя: ';de='Telefon des Gastes: '") + pClientPhone + Chars.LF + 
	              NStr("en='Client fax: ';ru='Факс гостя: ';de='Fax des Gastes: '") + pClientFax + Chars.LF + 
	              NStr("en='Client E-Mail: ';ru='E-Mail гостя: ';de='E-Mail-Adresse des Gastes: '") + pClientEMail + Chars.LF + 
	              NStr("en='Client remarks: ';ru='Примечания гостя: ';de='Anmerkungen des Gastes: '") + pClientRemarks + Chars.LF + 
	              NStr("en='SMS delivery: ';ru='СМС рассылка: ';de='SMS Versand: '") + pClientSendSMS + Chars.LF + 
	              NStr("en='Reservation remarks: ';ru='Примечания к брони: ';de='Anmerkungen zur Buchung: '") + pRemarks + Chars.LF + 
	              NStr("en='Car: ';ru='Автомобиль: ';de='Fahrzeug: '") + pCar + Chars.LF + 
	              NStr("en='Planned payment method code: ';ru='Код планируемого способа оплаты: ';de='Code der geplanten Zahlungsmethode: '") + pPlannedPaymentMethodCode + Chars.LF + 
				  NStr("en='Promotion code: ';ru='Промокод: ';de='Promo Code: '") + pPromoCode + Chars.LF + 
	              NStr("en='Do posting: ';ru='Проводить бронь: ';de='Buchung ausführen: '") + pDoPosting);
	rErrorDescription = "";
	Try
		// Get language
		vLanguage = cmGetLanguageByCode(pLanguageCode);
		// Write new reservation object
		vDocObj = cmWriteExternalReservationRow(pExtReservationCode, pExtGroupCode, pExtGroupDescription, pGroupCustomerName,  
                                                pReservationStatusCode, pPeriodFrom, pPeriodTo, pHotelCode, pRoomTypeCode, 
                                                pAccommodationTypeCode, pClientTypeCode, pRoomQuotaCode, pRoomRateCode,
                                                pCustomerName, pContractName, pAgentName, pContactPerson, 
                                                pNumberOfRooms, pNumberOfPersons, 
                                                pExtClientCode, pClientLastName, pClientFirstName, pClientSecondName, 
                                                pClientSexCode, pClientCitizenshipCode, pClientBirthDate, 
                                                pClientPhone, pClientFax, pClientEMail, pClientRemarks, pClientSendSMS, pRemarks, pCar, 
                                                pPlannedPaymentMethodCode, , pExternalSystemCode, pDoPosting, pPromoCode, 
									            rErrorDescription, , , , , vLanguage);
		If vDocObj <> Undefined And IsBlankString(rErrorDescription) Then
			// Fill reservation totals assuming that all sums are in one currency.
			vExtReservationStatusCode = "";
			vExtReservationStatusCode = cmGetObjectExternalSystemCodeByRef(vDocObj.Hotel, pExternalSystemCode, "ReservationStatuses", vDocObj.ReservationStatus);
			If IsBlankString(vExtReservationStatusCode) Then
				vExtReservationStatusCode = TrimAll(vDocObj.ReservationStatus.Description);
			EndIf;
			vReservationStatusDescription = Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vDocObj.ReservationStatus, vLanguage);
			vReservationCurrency = Catalogs.Currencies.EmptyRef();
			vReservationExtCurrencyCode = "";
			vReservationSum = 0;
			vReservationSumPresentation = "";
			If vDocObj.Services.Count() > 0 Then
				vReservationCurrency = vDocObj.Services.Get(0).FolioCurrency;
				vReservationExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocObj.Hotel, pExternalSystemCode, "Currencies", vReservationCurrency);
				If IsBlankString(vReservationExtCurrencyCode) Then
					vReservationExtCurrencyCode = TrimAll(vReservationCurrency.Description);
				EndIf;
				vReservationSum = vDocObj.Services.Total("Sum") - vDocObj.Services.Total("DiscountSum");
				vReservationSumPresentation = cmFormatSum(vReservationSum, vReservationCurrency, "NZ=");
			EndIf;
			// Get base currency code
			vBaseCurrency = vDocObj.Hotel.BaseCurrency;
			vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vDocObj.Hotel, pExternalSystemCode, "Currencies", vBaseCurrency);
			If IsBlankString(vExtBaseCurrencyCode) Then
				vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
			EndIf;
			// Get currency rate
			vReservationCurrencyRate = 1;
			If ValueIsFilled(vReservationCurrency) Then
				vReservationCurrencyRate = cmGetCurrencyExchangeRate(vDocObj.Hotel, vReservationCurrency, CurrentSessionDate());
			EndIf;
			// Fill reservation first day price
			vFirstDaySumCurrency = Undefined;
			vFirstDaySum = 0;
			vFirstDaySumPresentation = "";
			vPrices = vDocObj.pmGetPrices(True);
			vFirstAccDate = Undefined;
			For Each vPricesRow In vPrices Do
				If Not ValueIsFilled(vFirstAccDate) Then
					vFirstAccDate = vPricesRow.AccountingDate;
					vFirstDaySumCurrency = vPricesRow.FolioCurrency;
				EndIf;
				If vPricesRow.AccountingDate = vFirstAccDate Then
					vFirstDaySum = vFirstDaySum + vPricesRow.Price;
				Else
					Break;
				EndIf;
			EndDo;
			If vFirstDaySumCurrency <> vReservationCurrency Then
				vFirstDaySum = Round(cmConvertCurrencies(vFirstDaySum, vFirstDaySumCurrency, , vReservationCurrency, , CurrentSessionDate(), vDocObj.Hotel), 2);
			EndIf;
			If vFirstDaySum <> 0 Then
				vFirstDaySumPresentation = cmFormatSum(vFirstDaySum, vReservationCurrency, "NZ=");
			EndIf;
			// Build return string
			vRetStr = """" + """" + "," + """" + TrimAll(vDocObj.Number) + """" + "," + """" + TrimAll(vDocObj.ExternalCode) + """" + "," + 
			          """" + TrimAll(vExtReservationStatusCode) + """" + "," + """" + cmRemoveComma(vDocObj.ConfirmationReply) + """" + "," + 
			          """" + TrimAll(vDocObj.Posted) + """" + "," + """" + Format(vDocObj.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=") + """" + "," + 
			          """" + TrimAll(vDocObj.ReservationStatus.Code) + """" + "," + """" + cmRemoveComma(vReservationStatusDescription) + """" + "," + 
			          """" + TrimAll(vReservationExtCurrencyCode) + """" + "," + """" + TrimAll(vReservationCurrency.Code) + """" + "," + """" + cmRemoveComma(vReservationCurrency.Description) + """" + "," + 
			          Format(vReservationSum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
					  """" + StrReplace(vReservationSumPresentation, ",", ".") + """" + "," + 
			          Format(vFirstDaySum, "ND=17; NFD=2; NDS=.; NZ=; NG=; NN=") + "," + 
			          """" + StrReplace(vFirstDaySumPresentation, ",", ".") + """";
					  
			// Log success		
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
						  NStr("en='Reservation was saved - OK!';ru='Бронь записана в БД!';de='Die Reservierung wurde in die Datenbank geschrieben!'") + Chars.LF + vRetStr);
			// Write message to the reservation department that new reservation was created
			If ValueIsFilled(vDocObj.Hotel) And ValueIsFilled(vDocObj.Hotel.ReservationDepartment) Then
				vPeriodStr = ", " + Format(vDocObj.CheckInDate, "DF='dd.MM.yyyy HH:mm'") + " - " + Format(vDocObj.CheckOutDate, "DF='dd.MM.yyyy HH:mm'");
				vMsgText = NStr("en='New external reservation was created! Reservation data: Group code " + TrimAll(vDocObj.GuestGroup) + vPeriodStr + ", room type " + TrimAll(vDocObj.RoomType) + ", accommodation type " + TrimAll(vDocObj.AccommodationType) + ", number of rooms " + Format(vDocObj.RoomQuantity, "ND=8; NFD=0; NZ=; NG=") + ", guest " + TrimAll(vDocObj.Guest) + "'; 
				                |de='New external reservation was created! Reservation data: Group code " + TrimAll(vDocObj.GuestGroup) + vPeriodStr + ", room type " + TrimAll(vDocObj.RoomType) + ", accommodation type " + TrimAll(vDocObj.AccommodationType) + ", number of rooms " + Format(vDocObj.RoomQuantity, "ND=8; NFD=0; NZ=; NG=") + ", guest " + TrimAll(vDocObj.Guest) + "'; 
				                |ru='Создана новая внешняя бронь! Данные брони: Код группы " + TrimAll(vDocObj.GuestGroup) + vPeriodStr + ", тип номера " + TrimAll(vDocObj.RoomType) + ", вид размещения " + TrimAll(vDocObj.AccommodationType) + ", кол-во номеров " + Format(vDocObj.RoomQuantity, "ND=8; NFD=0; NZ=; NG=") + ", ФИО гостя " + TrimAll(vDocObj.Guest) + "'");
				// Call API
				cmSendMessageToDepartment(vDocObj.Hotel.ReservationDepartment, vMsgText, Undefined, True, vDocObj.Ref);
			EndIf;
			// Return based on output type
			If pOutputType = "CSV" Then
				Return vRetStr;
			Else
				vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatus"));
				vRetXDTO.ErrorDescription = "";
				vStatusRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatusRow"));
				vStatusRow.IsPosted = vDocObj.Posted;
				vStatusRow.ReservationNumber = TrimAll(vDocObj.Number);
				vStatusRow.ReservationStatus = vExtReservationStatusCode;
				vStatusRow.ReservationStatusCode = TrimAll(vDocObj.ReservationStatus.Code);
				vStatusRow.ReservationStatusDescription = vReservationStatusDescription;
				vStatusRow.ConfirmationReply = Left(TrimAll(vDocObj.ConfirmationReply), 4096);
				vStatusRow.GuestGroup = Format(vDocObj.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=; NN=");
				If ValueIsFilled(vDocObj.Guest) Then
					vStatusRow.GuestFullName = TrimR(vDocObj.Guest.FullName);
					vStatusRow.GuestBirthDate = vDocObj.Guest.DateOfBirth;
					vStatusRow.GuestPassport = TrimR(TrimR(vDocObj.Guest.IdentityDocumentSeries) + " " + TrimR(vDocObj.Guest.IdentityDocumentNumber));
					vStatusRow.GuestPhone = TrimR(vDocObj.Guest.Phone);
					vStatusRow.GuestFax = TrimR(vDocObj.Guest.Fax);
					vStatusRow.GuestEMail = TrimR(vDocObj.Guest.EMail);
					vStatusRow.GuestIdentityDocumentType = TrimAll(vDocObj.Guest.IdentityDocumentType.Code); 
					vStatusRow.GuestIdentityDocumentSeries = TrimAll(vDocObj.Guest.IdentityDocumentSeries);
					vStatusRow.GuestIdentityDocumentNumber = TrimAll(vDocObj.Guest.IdentityDocumentNumber);
					vStatusRow.GuestIdentityDocumentIssuedBy = TrimAll(vDocObj.Guest.IdentityDocumentIssuedBy);
					vStatusRow.GuestIdentityDocumentValidToDate = vDocObj.Guest.IdentityDocumentValidToDate;
					vStatusRow.GuestIdentityDocumentIssueDate = vDocObj.Guest.IdentityDocumentIssueDate;
					vStatusRow.GuestCitizenship = TrimAll(vDocObj.Guest.Citizenship.ISOCode);
					vStatusRow.GuestSendSMS = Not vDocObj.Guest.NoSMSDelivery;
					vStatusRow.GuestSex = Left(TrimAll(String(vDocObj.Guest.Sex)), 1);
					vStatusRow.GuestLastName = TrimAll(vDocObj.Guest.LastName);
					vStatusRow.GuestFirstName = TrimAll(vDocObj.Guest.FirstName);
					vStatusRow.GuestSecondName = TrimAll(vDocObj.Guest.SecondName);
					vStatusRow.GuestAddress = TrimAll(vDocObj.Guest.Address);
				Else
					vStatusRow.GuestFullName = "";
					vStatusRow.GuestBirthDate = Undefined;
					vStatusRow.GuestPassport = "";
					vStatusRow.GuestPhone = "";
					vStatusRow.GuestFax = "";
					vStatusRow.GuestEMail = "";
					vStatusRow.GuestIdentityDocumentType = ""; 
					vStatusRow.GuestIdentityDocumentSeries = ""; 
					vStatusRow.GuestIdentityDocumentNumber = ""; 
					vStatusRow.GuestIdentityDocumentIssuedBy = ""; 
					vStatusRow.GuestIdentityDocumentValidToDate = Undefined;
					vStatusRow.GuestIdentityDocumentIssueDate = Undefined;
					vStatusRow.GuestCitizenship = ""; 
					vStatusRow.GuestSendSMS = Undefined;
					vStatusRow.GuestSex = ""; 
					vStatusRow.GuestLastName = ""; 
					vStatusRow.GuestFirstName = ""; 
					vStatusRow.GuestSecondName = ""; 
					vStatusRow.GuestAddress = "";
				EndIf;
				vStatusRow.Currency = vReservationExtCurrencyCode;
				vStatusRow.CurrencyCode = TrimAll(vReservationCurrency.Code);
				vStatusRow.CurrencyDescription = TrimAll(vReservationCurrency.Description);
				vStatusRow.BaseCurrency = vExtBaseCurrencyCode;                
				vStatusRow.CurrencyRate = vReservationCurrencyRate;
				vStatusRow.Sum = vReservationSum;
				vStatusRow.SumPresentation = vReservationSumPresentation;
				vStatusRow.FirstDaySum = vFirstDaySum;
				vStatusRow.FirstDaySumPresentation = vFirstDaySumPresentation;
				vStatusRow.PaymentMethodCodesAllowedOnline = vDocObj.RoomRate.PaymentMethodCodesAllowedOnline;
				vStatusRow.ExtReservationCode = TrimAll(vDocObj.ExternalCode);
				vStatusRow.RoomQuotaCode = TrimAll(vDocObj.RoomQuota.Code);
				If ValueIsFilled(vDocObj.RoomRate) Then
					vStatusRow.RoomRateCode = TrimAll(vDocObj.RoomRate.Code);
					vStatusRow.RoomRateDescription = vDocObj.RoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
				EndIf;
				vStatusRow.Room = TrimAll(vDocObj.Room);
				// Fill board place
				vBoardPlaceType = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "BoardPlace"));
				vDoorLockAuthType = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "DoorLockAuth"));
				
				vBoardPlace = vDocObj.Ref.BoardPlace;
				If ValueIsFilled(vBoardPlace) Then
					vBoardPlaceType.Code = TrimAll(vBoardPlace.Code);
					vBoardPlaceType.Description = TrimAll(vBoardPlace.Description);
					vDoorLockAuth = vBoardPlace.DoorLockSystemAuthorization;
					If ValueIsFilled(vDoorLockAuth) Then
						FillPropertyValues(vDoorLockAuthType,vDoorLockAuth,"Code,Description,KeyCardType,UserGroup,AssignedAuthorizations,DeniedAuthorizations");
						vDoorLockAuthType.Room = TrimAll(vDoorLockAuth.Room);
					EndIf;	
				EndIf;	
				vBoardPlaceType.DoorLockAuth = vDoorLockAuthType;
				vStatusRow.BoardPlace = vBoardPlaceType;

				vRetXDTO.ExternalReservationStatusRow = vStatusRow;
				Return vRetXDTO;
			EndIf;
		Else
			Raise rErrorDescription;
		EndIf;
	Except
		vErrorDescription = ErrorDescription();
		// Write log event
		WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Error, , , 
					  NStr("en='Error description: ';ru='Описание ошибки: ';de='Fehlerbeschreibung: '") + vErrorDescription);
		// Build return string
		vRetStr = """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalReservationStatus"));
			vRetXDTO.ErrorDescription = Left(vErrorDescription, 4096);
			Return vRetXDTO;
		EndIf;
	EndTry;
EndFunction // cmWriteExternalReservation

// -----------------------------------------------------------------------------
// Description: This API is used to create/update group of reservations from the external system.
//              Reservation will not be posted by default. This function could be 
//              called in simple cases when there is only one reservation in the group.
//              This function is wrapper and is using cmWriteExternalReservationRow
//              to create/update reservations. Only web-service call type (XDTO) is supported
// Parameters: External reservation data, External system code, Whether to post 
//             new reservation or write only, Language code
// Return value: XDTO ExternalReservationStatus object
// -----------------------------------------------------------------------------
Function cmWriteExternalGroupReservation(pWriteExternalGroupReservation, pLanguageCode = "RU", pBlockChangesForCheckedIn = True) Export
	vWriteDebug = False;
	vHotel = Undefined;
	vExtCode = "";
	For Each vRow In pWriteExternalGroupReservation.WriteExternalGroupReservationRow Do
		vExtCode = vRow.ExternalSystemCode;	
		// Try to find hotel by name or code
		vHotel = cmGetHotelByCode(vRow.Hotel, vExtCode);
		Break;
	EndDo;
	ExtSystemCode = vExtCode;
	vInteraction = Undefined;
	If Not IsBlankString(vExtCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(vExtCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
			If ValueIsFilled(vInteraction.Hotel) Then
				vHotel = vInteraction.Hotel;
			EndIf;
			If vInteraction.IntegrationType = Enums.Integrations.HotelOnlineBooking Then
				ExtSystemCode = "1CBITRIX";
			EndIf;
		EndIf;	
	EndIf;
	If vWriteDebug Then
		vExtraXML = cmGetXMLStringFromXDTO(pWriteExternalGroupReservation);
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, "cmWriteExternalGroupReservation", Enums.ExternalSystemEventTypes.Info, vExtraXML, , vMsg, vInteraction.MaxLogLenght);
	EndIf;  
	rErrorDescription = "";
	vDocObj = Undefined;
	// Do in one transaction
	BeginTransaction(DataLockControlMode.Managed);
	Try
		vCheckedInReservations = Undefined;
		If pBlockChangesForCheckedIn = True Then
			// Get list of existing reservations with status IsCheckedIn
			vReservationsCodesArray = New Array;
			For Each vRow In pWriteExternalGroupReservation.WriteExternalGroupReservationRow Do
				vReservationsCodesArray.Add(vRow.ReservationCode);	
			EndDo;
			vCheckedInReservations = CheckExternalReservationsStatus(vReservationsCodesArray);
		EndIf;
		
		vExtSystemCode = "";
		vCurrency = Catalogs.Currencies.EmptyRef();
		vCurrencyExtCode = "";
		vBaseCurrency = "";
		vExtBaseCurrencyCode = "";
		vCurrencyRate = 0;
		vMainGuest = Undefined;
		vMainCustomer = Undefined;
		vMainContract = Undefined;
		vMainAgent = Undefined;
		vRoomUUIDs = New ValueTable();
		vRoomUUIDs.Columns.Add("UUID", cmGetStringTypeDescription());
		vRoomUUIDs.Columns.Add("ReservationNumber", cmGetStringTypeDescription());
		vRoomUUIDs.Columns.Add("ReservationDate", cmGetDateTimeTypeDescription());
		vRoomUUIDs.Columns.Add("RoomCode", cmGetStringTypeDescription());
		vRoomUUIDs.Columns.Add("PriceCalculationDate", cmGetDateTimeTypeDescription());
		// Stop SMS delivery for this transaction
		SessionParameters.SMSDeliveryIsStopped = True;
		// Get language
		vLanguage = cmGetLanguageByCode(pLanguageCode);
		// Initialize guest group
		vGuestGroup = Catalogs.GuestGroups.EmptyRef();
		// Initialize totals
		vTotalSum = 0;
		vTotalSumPresentation = "";
		vTotalSumBeforeDiscount = 0;
		// Initialize guest group total first day price
		vTotalFirstDaySum = 0;
		vTotalFirstDaySumPresentation = "";
		vTotalFirstDaySumBeforeDiscount = 0;
		// Build return object
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
		vRetXDTO.ErrorDescription = "";
		// Login
		vLogin = "";
		Try
			vLogin = TrimR(pWriteExternalGroupReservation.Login);
		Except
			vErrorDescription = ErrorDescription();
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
						  NStr("en='Login data error: ';ru='Ошибка в блоке Login: ';de='Fehlerbeschreibung: '") + vErrorDescription);
		EndTry;
		// Transfer rules
		vNeedTransfer = "";
		vMainTransferData = New Structure("Need, Date, Place, Remarks");
		vMainTransferData.Need = False;
		Try 
			If pWriteExternalGroupReservation.TransferBooked <> Undefined And pWriteExternalGroupReservation.TransferBooked Then
				vNeedTransfer = vNeedTransfer + Format(pWriteExternalGroupReservation.TransferTime, "DF='dd.MM.yyyy HH:mm'") + ", " + TrimAll(pWriteExternalGroupReservation.TransferPlace) + Chars.LF + 
				                TrimAll(pWriteExternalGroupReservation.TransferRemarks);
				vMainTransferData.Need = True;
				vMainTransferData.Date    = pWriteExternalGroupReservation.TransferTime;
				vMainTransferData.Place   = pWriteExternalGroupReservation.TransferPlace;
				vMainTransferData.Remarks = pWriteExternalGroupReservation.TransferRemarks;
			EndIf;
		Except
			vErrorDescription = ErrorDescription();
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
						  NStr("en='Transfer data error: ';ru='Ошибка в блоке Transfer: ';de='Fehlerbeschreibung: '") + vErrorDescription);
		EndTry;
		// Extra services
		vMainExtraServices = New ValueList();
		Try
			If pWriteExternalGroupReservation.ChargeExtraServices <> Undefined Then
				For Each vExtraChargeSevice In pWriteExternalGroupReservation.ChargeExtraServices.ChargeExtraServiceRow Do
					vExtraServicesItem = New Structure("Service, Price, Quantity, Remarks, Currency, ChargeDate", vExtraChargeSevice.Service, vExtraChargeSevice.Price, vExtraChargeSevice.Quantity, vExtraChargeSevice.Remarks, vExtraChargeSevice.Currency, vExtraChargeSevice.ChargeDate);
					vMainExtraServices.Add(vExtraServicesItem);
				EndDo;
			EndIf;
		Except
			vErrorDescription = ErrorDescription();
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
						  NStr("en='ChargeExtraServices data error: ';ru='Ошибка в блоке ChargeExtraServices: ';de='Fehlerbeschreibung: '") + vErrorDescription);
		EndTry;
		// Credit card
		vMainCreditCardData = New Structure("CardNumber, CardHolder, CardValidTillDate, CardSecurityCode", "", "", '00010101', "");
		Try
			If pWriteExternalGroupReservation.CreditCardData <> Undefined Then
				vMainCreditCardData.CardNumber = TrimAll(pWriteExternalGroupReservation.CreditCardData.CardNumber);
				vMainCreditCardData.CardHolder = TrimAll(pWriteExternalGroupReservation.CreditCardData.CardHolder);
				vMainCreditCardData.CardValidTillDate = BegOfMonth(pWriteExternalGroupReservation.CreditCardData.CardValidTillDate);
				vMainCreditCardData.CardSecurityCode = TrimAll(pWriteExternalGroupReservation.CreditCardData.CardSecurityCode);
			EndIf;
		Except
			vErrorDescription = ErrorDescription();
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Note, , , 
						  NStr("en='CreditCard data error: ';ru='Ошибка в блоке CreditCard: ';de='Fehlerbeschreibung: '") + vErrorDescription);
		EndTry;
		// UTM data
		vUTM_Source = "";
		vUTM_Campaign = "";
		vUTM_Medium = "";
		vUTM_Content = "";
		If pWriteExternalGroupReservation.RequestAttributes <> Undefined Then
			If pWriteExternalGroupReservation.RequestAttributes.utm_source <> Undefined Then
				vUTM_Source = TrimAll(pWriteExternalGroupReservation.RequestAttributes.utm_source);
			EndIf;
			If pWriteExternalGroupReservation.RequestAttributes.utm_source <> Undefined Then
				vUTM_Campaign = TrimAll(pWriteExternalGroupReservation.RequestAttributes.utm_campaign);
			EndIf;
			If pWriteExternalGroupReservation.RequestAttributes.utm_medium <> Undefined Then
				vUTM_Medium = TrimAll(pWriteExternalGroupReservation.RequestAttributes.utm_medium);
			EndIf;
			If pWriteExternalGroupReservation.RequestAttributes.utm_content <> Undefined Then
				vUTM_Content = TrimAll(pWriteExternalGroupReservation.RequestAttributes.utm_content);
			EndIf;
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
						  NStr("en='UTM data: ';ru='Блок UTM меток: ';de='UTM data: '") + "UTM_Source: " + vUTM_Source + ", UTM_Campaign: " + vUTM_Campaign + ", UTM_Medium: " + vUTM_Medium + ", UTM_Content: " + vUTM_Content);
		Else
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
						  NStr("en='No request attributes';ru='Доп. атрибуты запроса не переданы';de='No request attributes'"));
		EndIf;
		// Iterate thru reservation rows
		vUUID = New UUID();
		vUUIDStr = String(vUUID);
		vTemplateLineNumber = 0;
		vRowRoom = "";
		vReservationNumber = "";
		vReservationDate = Undefined;
		vPriceCalculationDate = '00010101';
		vRoomCode = "";
		vReservationServices = New ValueTable();
		vAllotmentFolder = Undefined;
		vAllotment = Undefined;
		vAccommodationTemplate = Undefined;
		vOverrides = New ValueTable();
		vClientType = Undefined;
		vClientTypeConfirmationText = "";
		i = 0;
		For Each vRow In pWriteExternalGroupReservation.WriteExternalGroupReservationRow Do
			i = i + 1;
			WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
			              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + vRow.ExternalSystemCode + Chars.LF + 
			              NStr("en='External reservation code: ';ru='Код брони во внешней системе: ';de='Reservierungscode im externen System: '") + vRow.ReservationCode + Chars.LF + 
			              NStr("en='External group code: ';ru='Код группы во внешней системе: ';de='Gruppencode im externen System: '") + vRow.GroupCode + Chars.LF + 
			              NStr("en='External group description: ';ru='Описание группы во внешней системе: ';de='Gruppenbeschreibung im externen System: '") + vRow.GroupDescription + Chars.LF + 
			              NStr("en='Group customer name: ';ru='Наименование контрагента группы: ';de='Bezeichnung des GruppenPartners: '") + vRow.GroupCustomer + Chars.LF + 
			              NStr("en='Reservation status code: ';ru='Код статуса брони: ';de='Reservierungsstatuscode: '") + vRow.ReservationStatus + Chars.LF + 
			              NStr("en='Period from: ';ru='Период с: ';de='Zeitraum ab: '") + Format(vRow.PeriodFrom, "DF='dd.MM.yyyy HH:mm'") + Chars.LF + 
			              NStr("en='Period to: ';ru='Период по: ';de='Zeitraum bis: '") + Format(vRow.PeriodTo, "DF='dd.MM.yyyy HH:mm'") + Chars.LF + 
			              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + vRow.Hotel + Chars.LF + 
			              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + vRow.RoomType + Chars.LF + 
						  NStr("en='Room class: ';ru='Класс типа номера: ';de='Zimmerklasse: '") + vRow.RoomClass + Chars.LF + 
			              NStr("en='Room code: ';ru='Код номера: ';de='Zimmercode: '") + vRow.Room + Chars.LF + 
			              NStr("en='Accommodation type code: ';ru='Код вида размещения: ';de='Code des Unterbringungstyps: '") + vRow.AccommodationType + Chars.LF + 
			              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + vRow.ClientType + Chars.LF + 
			              NStr("en='Allotment code: ';ru='Код квоты номеров: ';de='Zimmerquotencode: '") + vRow.RoomQuota + Chars.LF + 
			              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + vRow.RoomRate + Chars.LF + 
			              NStr("en='Customer name: ';ru='Наименование контрагента в брони: ';de='Bezeichnung des Partners in der Reservierung: '") + vRow.Customer + Chars.LF + 
			              NStr("en='Contract name: ';ru='Наименование договора в брони: ';de='Bezeichnung für die Reservierung: '") + vRow.Contract + Chars.LF + 
			              NStr("en='Login: ';ru='Логин: ';de='Login: '") + vLogin + Chars.LF + 
			              NStr("en='Agent name: ';ru='Наименование агента в брони: ';de='Bezeichnung des Vertreters in der Reservierung: '") + vRow.Agent + Chars.LF + 
			              NStr("en='Contact person: ';ru='Контактное лицо: ';de='Kontaktperson: '") + vRow.ContactPerson + Chars.LF + 
			              NStr("en='Number of rooms: ';ru='Количество номеров: ';de='Zimmeranzahl: '") + vRow.NumberOfRooms + Chars.LF + 
			              NStr("en='Number of persons: '; ru='Количество гостей: '") + vRow.NumberOfPersons + Chars.LF + 
			              NStr("en='External client code: ';ru='Код клиента во внешней системы: ';de='Kundecode im externen System: '") + vRow.Client.ClientCode + Chars.LF + 
			              NStr("en='Client last name: ';ru='Фамилия гостя: ';de='Familienname des Gastes: '") + vRow.Client.ClientLastName + Chars.LF + 
			              NStr("en='Client first name: ';ru='Имя гостя: ';de='Name des Gastes: '") + vRow.Client.ClientFirstName + Chars.LF + 
			              NStr("en='Client second name: ';ru='Отчество гостя: ';de='Vatersname des Gastes: '") + vRow.Client.ClientSecondName + Chars.LF + 
			              NStr("en='Client sex code: ';ru='Код пола гостя: ';de='Code des Geschlechts des Gastes: '") + vRow.Client.ClientSex + Chars.LF + 
			              NStr("en='Client citizenship code: ';ru='Код гражданства гостя: ';de='Code der Stadtbürgerschaft des Gastes: '") + vRow.Client.ClientCitizenship + Chars.LF + 
			              NStr("en='Client birth date: ';ru='Дата рождения гостя: ';de='Geburtsdatum des Gastes: '") + Format(vRow.Client.ClientBirthDate, "DF='dd.MM.yyyy'") + Chars.LF + 
			              NStr("en='Client phone: ';ru='Телефон гостя: ';de='Telefon des Gastes: '") + vRow.Client.ClientPhone + Chars.LF + 
			              NStr("en='Client fax: ';ru='Факс гостя: ';de='Fax des Gastes: '") + vRow.Client.ClientFax + Chars.LF + 
			              NStr("en='Client E-Mail: ';ru='E-Mail гостя: ';de='E-Mail-Adresse des Gastes: '") + vRow.Client.ClientEMail + Chars.LF + 
			              NStr("en='Client remarks: ';ru='Примечания гостя: ';de='Anmerkungen des Gastes: '") + vRow.Client.ClientRemarks + Chars.LF + 
			              NStr("en='Send SMS: ';ru='СМС рассылка: ';de='SMS Versand: '") + vRow.Client.Get("ClientSendSMS") + Chars.LF + 
			              NStr("en='Reservation remarks: ';ru='Примечания к брони: ';de='Anmerkungen zur Buchung: '") + vRow.ReservationRemarks + Chars.LF + 
			              NStr("en='Car: ';ru='Автомобиль: ';de='Fahrzeug: '") + vRow.Car + Chars.LF + 
			              NStr("en='Planned payment method code: ';ru='Код планируемого способа оплаты: ';de='Code der geplanten Zahlungsmethode: '") + vRow.PlannedPaymentMethod + Chars.LF + 
						  NStr("en='Discount type: '; ru='Тип скидки: '; de='Discount-Typ'") + vRow.DiscountType + Chars.LF + 
			              NStr("en='Discount sum: '; ru='Сумма скидки: '; de='Discount Summe'") + vRow.DiscountSum + Chars.LF + 
			              NStr("en='Do posting: ';ru='Проводить бронь: ';de='Buchung ausführen: '") + vRow.DoPosting + Chars.LF + 
			              NStr("en='Is upgrade: ';ru='Это апгрейд: ';de='Ist Upgrade: '") + vRow.IsUpgrade + Chars.LF +
			              NStr("en='ID: ';ru='ID: ';de='ID: '") + vRow.ID);
						  
			// Try to find hotel by name or code
			vHotel = cmGetHotelByCode(vRow.Hotel, vExtSystemCode);
						  
			If pBlockChangesForCheckedIn = True And vCheckedInReservations <> Undefined And Not IsBlankString(vRow.ReservationCode) Then
				// Check if reservation created and alredy checked in
				vCheckedInRows = vCheckedInReservations.FindRows(New Structure("ExternalCode", vRow.ReservationCode));			  
				If vCheckedInRows.Count() > 0 Then
					vFoundRowsString = "";
					For Each vFoundRow In vCheckedInRows Do
						vFoundRowsString = String(vFoundRow.Ref) + Chars.LF; 
					EndDo;		
					WriteLogEvent(NStr("en='Write external reservation';ru='Записать внешнюю бронь';de='Eine externe Reservierung einschreiben'"), EventLogLevel.Information, , , 
					              NStr("en='There is existing checked-in reservation with given external code: ';ru='Уже есть документ брони со статусом заезда для указанного внешнего кода брони: ';de='Für den angegebenen Fremdcode existiert bereits ein Buchungsbeleg mit Check-in-Status: '") + vRow.ReservationCode + Chars.LF + vFoundRowsString);
					// Skip existing reservation
					Continue;
				EndIf;
			EndIf;
			
			// Initialize external system code
			If IsBlankString(vExtSystemCode) Then
				vExtSystemCode = vRow.ExternalSystemCode;
			EndIf;
			vExtGuestGroupCode = TrimR(vRow.GroupCode);
			If IsBlankString(vExtGuestGroupCode) Then
				vExtGuestGroupCode = vUUIDStr;
			EndIf;
			If Not IsBlankString(vLogin) Then
				// Get customer and contract by login
				vCustomerStruct = cmGetCustomerByLogin(vHotel, vExtSystemCode, vLogin);
				// Get active reservations and group by them by guest group
				If vCustomerStruct <> Undefined Then
					If ValueIsFilled(vCustomerStruct.Customer) Then
						vRow.Customer = TrimAll(vCustomerStruct.Customer.Code);
					EndIf;
					If ValueIsFilled(vCustomerStruct.Contract) Then
						vRow.Contract = TrimAll(vCustomerStruct.Contract.Code);
					EndIf;
				EndIf;
			EndIf;
			
			// Try to fill reservation number
			vRoomUUID = "";
			vRoomUUIDsRow = Undefined;
			vAccommodationTemplate = Undefined;
			vAccommodationTypeOverrides = New ValueTable();
			vRowAccommodationType = vRow.AccommodationType;
			vAccommodationType = Undefined;
			If Not IsBlankString(vRow.Room) And StrLen(TrimAll(vRow.Room)) = 36 Then
				If TrimAll(vRow.Room) <> vRowRoom Then
					vTemplateLineNumber = 1;
					vRowRoom = TrimAll(vRow.Room);
				Else
					vTemplateLineNumber = vTemplateLineNumber + 1;
				EndIf;
				vRoomUUID = TrimAll(vRow.Room);
				vRoomUUIDsRow = vRoomUUIDs.Find(vRoomUUID, "UUID");
				If vRoomUUIDsRow <> Undefined And Not IsBlankString(vRoomUUIDsRow.ReservationNumber) Then
					vReservationNumber = vRoomUUIDsRow.ReservationNumber;
					vReservationDate = vRoomUUIDsRow.ReservationDate + 1;
					vPriceCalculationDate = vRoomUUIDsRow.PriceCalculationDate;
					vRoomCode = vRoomUUIDsRow.RoomCode;
				Else
					vReservationNumber = "";
					vReservationDate = Undefined;
					vPriceCalculationDate = '00010101';
					vRoomCode = "";
					If Not IsBlankString(vRowAccommodationType) Then
						vAccommodationType = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "AccommodationTypes", vRowAccommodationType, , vInteraction);
						If ValueIsFilled(vAccommodationType) Then
							If vAccommodationType.Type = Enums.AccomodationTypes.Room Or vAccommodationType.Type = Enums.AccomodationTypes.Beds Then
								vAccommodationTemplate = cmGetAccommodationTemplateForRoomCode(vRoomUUID, vHotel, pWriteExternalGroupReservation);
								If ValueIsFilled(vAccommodationTemplate) Then
									vRoomRateRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomRates", vRow.RoomRate, , vInteraction);
									vRoomTypeRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomTypes", vRow.RoomType, , vInteraction);
									vOverrides = cmGetRoomRateOverrides(vRoomRateRef, vHotel, vAccommodationTemplate, vRoomTypeRef);
								Else
									vOverrides.Clear();
								EndIf;
							EndIf;
						EndIf;
					EndIf;
					vReservationServices.Clear();
					vClientType = Undefined;
					vClientTypeConfirmationText = "";
					// Check for allotments folder
					If vRow.NumberOfRooms > 0 And Not IsBlankString(vRow.RoomQuota) Then
						vAllotmentFolder = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomQuotas", vRow.RoomQuota, , vInteraction);
						If Not ValueIsFilled(vAllotmentFolder) Then
							vAllotmentFolder = Undefined;
							vAllotment = Undefined;
						ElsIf Not vAllotmentFolder.IsFolder Then
							vAllotmentFolder = Undefined;
							vAllotment = Undefined;
						Else // Try to find suitable allotment from the given allotment folder
							vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomTypes", vRow.RoomType, , vInteraction);
							vAllotment = GetSuitableAllotment(vHotel, vAllotmentFolder, vRoomType, vRow.NumberOfRooms, vRow.PeriodFrom, vRow.PeriodTo);
							If Not ValueIsFilled(vAllotment) Then
								vAllotment = Undefined;
							EndIf;
						EndIf;
					Else
						vAllotmentFolder = Undefined;
						vAllotment = Undefined;
					EndIf;
				EndIf;
			Else
				vTemplateLineNumber = vTemplateLineNumber + 1;
				// Reset room
				If IsBlankString(vRow.Room) Then
					If Not IsBlankString(vRowAccommodationType) Then
						vAccommodationType = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "AccommodationTypes", vRowAccommodationType, , vInteraction);
						If ValueIsFilled(vAccommodationType) Then
							If vAccommodationType.Type = Enums.AccomodationTypes.Room Or vAccommodationType.Type = Enums.AccomodationTypes.Beds Then
								vReservationNumber = "";
								vReservationDate = Undefined;
								vPriceCalculationDate = '00010101';
								vRoomCode = "";
								vAccommodationTemplate = cmGetAccommodationTemplateForRoomCode(vRoomCode, vHotel, pWriteExternalGroupReservation);
								If ValueIsFilled(vAccommodationTemplate) Then
									vRoomRateRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomRates", vRow.RoomRate, , vInteraction);
									vRoomTypeRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomTypes", vRow.RoomType, , vInteraction);
									vOverrides = cmGetRoomRateOverrides(vRoomRateRef, vHotel, vAccommodationTemplate, vRoomTypeRef);
								Else
									vOverrides.Clear();
								EndIf;
								vReservationServices.Clear();
								vClientType = Undefined;
								vClientTypeConfirmationText = "";
							EndIf;
						Else
							vReservationNumber = "";
							vReservationDate = Undefined;
							vPriceCalculationDate = '00010101';
							vRoomCode = "";
							vReservationServices.Clear();
							vClientType = Undefined;
							vClientTypeConfirmationText = "";
						EndIf;
					Else
						vReservationNumber = "";
						vReservationDate = Undefined;
						vPriceCalculationDate = '00010101';
						vRoomCode = "";
						vReservationServices.Clear();
						vClientType = Undefined;
						vClientTypeConfirmationText = "";
					EndIf;
				Else
					If TrimAll(vRow.Room) <> vRowRoom Then
						vTemplateLineNumber = 1;
						vRowRoom = TrimAll(vRow.Room);
					Else
						vTemplateLineNumber = vTemplateLineNumber + 1;
					EndIf;
					vReservationNumber = "";
					vReservationDate = Undefined;
					vPriceCalculationDate = '00010101';
					vRoomCode = vRow.Room;
					If Not IsBlankString(vRowAccommodationType) Then
						vAccommodationType = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "AccommodationTypes", vRowAccommodationType, , vInteraction);
						If ValueIsFilled(vAccommodationType) Then
							If vAccommodationType.Type = Enums.AccomodationTypes.Room Or vAccommodationType.Type = Enums.AccomodationTypes.Beds Then
								vAccommodationTemplate = cmGetAccommodationTemplateForRoomCode(vRoomCode, vHotel, pWriteExternalGroupReservation);
								If ValueIsFilled(vAccommodationTemplate) Then
									vRoomRateRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomRates", vRow.RoomRate, , vInteraction);
									vRoomTypeRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomTypes", vRow.RoomType, , vInteraction);
									vOverrides = cmGetRoomRateOverrides(vRoomRateRef, vHotel, vAccommodationTemplate, vRoomTypeRef);
								Else
									vOverrides.Clear();
								EndIf;
							EndIf;
						EndIf;
					EndIf;
					vReservationServices.Clear();
					vClientType = Undefined;
					vClientTypeConfirmationText = "";
				EndIf;
				vAllotmentFolder = Undefined;
				vAllotment = Undefined;
			EndIf;
			If Not IsBlankString(vRow.AccommodationTemplate) Then
				vWrkAccommodationTemplate = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "AccommodationTemplates", vRow.AccommodationTemplate, , vInteraction);
				If ValueIsFilled(vWrkAccommodationTemplate) Then
					vAccommodationTemplate = vWrkAccommodationTemplate;
					If ValueIsFilled(vAccommodationTemplate) Then
						vRoomRateRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomRates", vRow.RoomRate, , vInteraction);
						vRoomTypeRef = cmGetObjectRefByExternalSystemCode(vHotel, vRow.ExternalSystemCode, "RoomTypes", vRow.RoomType, , vInteraction);
						vOverrides = cmGetRoomRateOverrides(vRoomRateRef, vHotel, vAccommodationTemplate, vRoomTypeRef);
					Else
						vOverrides.Clear();
					EndIf;
				EndIf;
			EndIf;
			// Room rate accommodation type overrides
			If vOverrides.Count() > 0 Then
