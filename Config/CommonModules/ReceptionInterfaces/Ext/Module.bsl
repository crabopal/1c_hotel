Procedure FillProformaInvoiceExternalGroupReservationStatus(Val pProformaInvoice, vRetXDTO,pExternalSystemCode = "")
	If ValueIsFilled(pProformaInvoice) Then
		vProformaInvoiceXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "Invoice"));
		vProformaInvoiceXDTO.InvoiceNumber = TrimAll(pProformaInvoice.Number); 
		vProformaInvoiceXDTO.InvoiceSum = pProformaInvoice.Sum;
		vProformaInvoiceXDTO.InvoiceBalance = pProformaInvoice.GetObject().pmGetInvoiceBalance();
		vProformaInvoiceXDTO.FolioNumber = ?(ValueIsFilled(pProformaInvoice.Folio), TrimAll(pProformaInvoice.Folio.Number), ""); 
		vProformaInvoiceXDTO.InvoiceDescription =  pProformaInvoice.Remarks;
		For Each vRow In pProformaInvoice.Services Do
			vRowServicesXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "InvoiceItem"));
			
			vRowServicesXDTO.InvoiceItemName = ?(ValueIsFilled(vRow.Service), vRow.Service.GetObject().pmGetServiceDescription(SessionParameters.CurrentLanguage), "");
			vRowServicesXDTO.InvoiceItemDescription = TrimAll(vRow.Remarks);
			vRowServicesXDTO.InvoiceItemSum = vRow.Sum;
			vRowServicesXDTO.InvoiceItemQuantity = ?(vRow.Quantity = 0, 1, vRow.Quantity);
			vRowServicesXDTO.InvoiceItemPrice = Round(vRowServicesXDTO.InvoiceItemSum / vRowServicesXDTO.InvoiceItemQuantity, 2);
			vRowServicesXDTO.InvoiceItemUnit = TrimAll(vRow.Unit);
			
			// Add VAT data for the row
			vRowServicesXDTO.VATRate = vRow.VATRate.TaxRate; 
			vRowServicesXDTO.VATRateName = cmGetObjectExternalSystemCodeByRef(pProformaInvoice.Hotel,pExternalSystemCode, "VATRates", vRow.VATRate, False, False);
			vRowServicesXDTO.VATAmount = vRow.VATSum;
			vRowServicesXDTO.NETAmount =  vRow.Sum - vRow.VATSum;
			
			vProformaInvoiceXDTO.InvoiceItems.Add(vRowServicesXDTO);
		EndDo;	 
		
		// Fill vat rates totals
		vServices = pProformaInvoice.Services.Unload( , "Sum, VATRate, VATSum, DiscountSum, CommissionSum");
		vServices.GroupBy("VATRate", "Sum, VATSum, DiscountSum, CommissionSum");
		For Each vRow In vServices Do
			vRowVatRateXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "VatRateRow"));   
			If Not ValueIsFilled(vRow.VATRate) Then
				vRowVatRateXDTO.VATRate = ""; 
				vRowVatRateXDTO.VATRateName = "";
				vRowVatRateXDTO.VATAmount = vRow.VATSum;
				vRowVatRateXDTO.NETAmount =  vRow.Sum - vRow.VATSum;
				vRowVatRateXDTO.GrossAmount = vRow.Sum;
			Else 
				vRowVatRateXDTO.VATRate = vRow.VATRate.TaxRate; 
				vRowVatRateXDTO.VATRateName = cmGetObjectExternalSystemCodeByRef(pProformaInvoice.Hotel,pExternalSystemCode, "VATRates", vRow.VATRate, False, False);
				vRowVatRateXDTO.VATAmount = vRow.VATSum;
				vRowVatRateXDTO.NETAmount =  vRow.Sum - vRow.VATSum;
				vRowVatRateXDTO.GrossAmount = vRow.Sum;
			EndIf; 
			vProformaInvoiceXDTO.VatRates.Add(vRowVatRateXDTO);
		EndDo;
		vRetXDTO.Invoice = vProformaInvoiceXDTO; 
	EndIf;
EndProcedure // FillProformaInvoiceExternalGroupReservationStatus

