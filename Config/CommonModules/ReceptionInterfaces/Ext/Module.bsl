										vPSRow.ChequeServiceQuantity = invoicePS.ChequeServiceQuantity;
										vPSRow.ChequeServicePrice = Round(vPSRow.Sum / vPSRow.ChequeServiceQuantity, 2);
									Else
										vPSRow.ChequeServiceQuantity = 1;
										vPSRow.ChequeServicePrice = vPSRow.Sum;
