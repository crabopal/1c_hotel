					EndIf; 
					vLanguage = vHotel.Language;
					If ValueIsFilled(vPaymentObj.Payer) And ValueIsFilled(vPaymentObj.Payer.Language) Then
						vLanguage = vPaymentObj.Payer.Language;
					EndIf; 
					vHotelPrintName = Catalogs.Hotels.pmGetHotelPrintName(vHotel, vLanguage);
					vRemarks = vHotelPrintName + StrTemplate(cmNStr("en = '. Payment N%1 at %2'; de = '. Payment N%1 at %2'; ru = '. Платеж №%1 от %2'", vLanguage), TrimAll(vPaymentObj.Number), Format(vPaymentObj.Date, "DF=dd.MM.yy"));
					vDocumentText = "";	
					vTemplate = Undefined;
					If ValueIsFilled(vHotel) Then
						vTemplate = vHotel.TemplateSendWriteGuestGroupPaymentConfirmation;
						If ValueIsFilled(vTemplate) Then
							vRemarks = cmNStr(TrimAll(vTemplate.Description), vLanguage);
							If ValueIsFilled(vTemplate.HTMLTextRu) Or ValueIsFilled(vTemplate.HTMLTextEn) Or ValueIsFilled(vTemplate.HTMLTextDe) Then
								vDocumentText = SMS.GetHTMLTextByLanguage(vTemplate, vLanguage);
							EndIf;
							If IsBlankString(vDocumentText) Then
								vDocumentText = SMS.GetSMSTextByLanguage(vTemplate, vLanguage);
							EndIf; 
							If ValueIsFilled(vClientDoc) And TypeOf(vClientDoc) = Type("DocumentRef.Reservation") Then
								If ValueIsFilled(vTemplate.ObjectPrintingFormRu) Then
									vObjectPrintingForm = vTemplate.ObjectPrintingFormRu;
								EndIf;
								If vLanguage = Catalogs.Languages.EN And ValueIsFilled(vTemplate.ObjectPrintingFormEn) Then
									vObjectPrintingForm = vTemplate.ObjectPrintingFormEn;
								ElsIf vLanguage = Catalogs.Languages.DE And ValueIsFilled(vTemplate.ObjectPrintingFormDe) Then
									vObjectPrintingForm = vTemplate.ObjectPrintingFormDe;
								EndIf;  
								If ValueIsFilled(vObjectPrintingForm) Then
									vSpreadsheet = New SpreadsheetDocument();
									vReservationObj = vClientDoc.GetObject();
									If ValueIsFilled(vObjectPrintingForm.ExternalProcessing) Then 
										vExtProc = vObjectPrintingForm.ExternalProcessing;
										vExtProcData = vExtProc.ExternalProcessingStorage.Get();
										vExtProcPath = GetTempFileName(".efd");
										vExtProcData.Write(vExtProcPath);
										vExtProcObject = ExternalDataProcessors.Create(vExtProcPath, False);
										vStruct = New Structure("InputParameter, ObjectPrintingForm", vReservationObj, vObjectPrintingForm);
										FillPropertyValues(vExtProcObject, vStruct);
										vExtProcObject.pmPrintConfirmation(vSpreadsheet, vClientDoc, Undefined, 0, Undefined, False, vLanguage, vObjectPrintingForm);  
										DeleteFiles(vExtProcPath);
									Else
										// Check predefined forms
										If vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationRu Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationEn Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationDe Then
											vReservationObj.pmPrintConfirmation(vSpreadsheet, vClientDoc, Undefined, 0, Undefined, False, vLanguage, vObjectPrintingForm);
										ElsIf vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationRu Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationEn Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationDe Then
											vReservationObj.pmPrintConfirmation(vSpreadsheet, vClientDoc, Undefined, 0, Undefined, True, vLanguage, vObjectPrintingForm);
										ElsIf vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationWithServicesRu Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationWithServicesEn Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintConfirmationWithServicesDe Then
											vReservationObj.pmPrintConfirmationWithServices(vSpreadsheet, vClientDoc, Undefined, 0, Undefined, True, vLanguage, vObjectPrintingForm);
										ElsIf vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationWithServicesRu Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationWithServicesEn Or
											vObjectPrintingForm = Catalogs.ObjectPrintingForms.ReservationPrintCurrentDocConfirmationWithServicesDe Then
											vReservationObj.pmPrintConfirmationWithServices(vSpreadsheet, vClientDoc, Undefined, 0, Undefined, True, vLanguage, vObjectPrintingForm);
										EndIf;
									EndIf;
									// Save reservation confirmation to the temp PDF file
									vConfirmationFileName = StrReplace(cmNStr("en='Booking confirmation'; ru='Подтверждение брони'; de='Reservierungsbestätigung'", vLanguage) + " " + Format(vReservationObj.GuestGroup.Code, "ND=12; NFD=0; NG="), " ", "_") + ".pdf";
									vConfirmationFileName = cmGetFullFileName(vConfirmationFileName, TempFilesDir());
									vSpreadsheet.Write(vConfirmationFileName, SpreadsheetDocumentFileType.PDF);
								EndIf;	
							EndIf;	
						EndIf;	
					EndIf;	
					If IsBlankString(vDocumentText) Then
						vGuaranteedReservationStatusPres = Chars.LF;
						If ValueIsFilled(vGuaranteedReservationStatus) Then
							vGuaranteedReservationStatusPres = Chars.LF + cmNStr("en = 'Reservation status was changed to '; 
																				 |de = 'Status der Reservierung wurde verändert zu '; 
																				 |ru = 'Статус брони был изменен на '", vLanguage) 
															  + Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vGuaranteedReservationStatus, vLanguage) 
															  + Chars.LF;	
														  EndIf;	 
						vClientFullName = "";
						If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.Client) Then
							vClientFullName = cmNStr("en='Client name: ';ru='Клиент: ';de='Kunde: '", vLanguage) + TrimAll(vGuestGroup.Client.FullName) + Chars.LF;
						EndIf;	    
						vPeriod = "";
						If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.CheckInDate) And ValueIsFilled(vGuestGroup.CheckOutDate) Then
							vPeriod = StrTemplate(cmNStr("en='Period of stay: %1 - %2';ru='Период проживания: %1 - %2';de='Unterbringungszeitraum: %1 - %2'", vLanguage), Format(vGuestGroup.CheckInDate, "DF='dd.MM.yyyy HH:mm'"), Format(vGuestGroup.CheckOutDate, "DF='dd.MM.yyyy HH:mm'")) + Chars.LF;
						EndIf;
						vDocumentText = vClientFullName 
										+ vPeriod          
										+ Chars.LF 
					                    + StrTemplate(cmNStr("en='Payment with amount %1 for reservation number %2 was received and successfully processed!'; 
										         |de='Payment with amount %1 for reservation number %2 was received and successfully processed!'; 
					                           	 |ru='Платеж на сумму %1 по брони номер %2 был получен и успешно обработан!'", vLanguage), cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), Format(vGuestGroup.Code, "ND=12; NFD=0; NG=")) + Chars.LF  
					                    + vGuaranteedReservationStatusPres + Chars.LF 
										+ cmNStr("en='Payment details are ';ru='Детали платежа ';de='Zahlungsdetails '", vLanguage) + Chars.LF 
					                    + TrimAll(vPaymentObj.SlipText) + Chars.LF + Chars.LF 
					                    + cmNStr("en='Best regards,'; 
										         |de='Best regards,'; 
					                             |ru='С уважением,'", vLanguage) + Chars.LF 
					                    + vHotelPrintName + Chars.LF 
							            + cmNStr(SessionParameters.ConfigurationName, vLanguage);
					EndIf;					   
					// Call user exit procedure to give possibility to override message subject ans message text
					vUserExitProc = Catalogs.ExternalDataProcessors.WriteGuestGroupPaymentConfirmation;
					If ValueIsFilled(vUserExitProc) Then
						If vUserExitProc.ExternalProcessingType = Enums.ExternalProcessingTypes.Algorithm Then
							If Not IsBlankString(vUserExitProc.Algorithm) Then
								SetSafeMode(True);
								Execute(TrimAll(vUserExitProc.Algorithm));
								SetSafeMode(False);
							EndIf;
						EndIf;
					EndIf;      
					// Replace parameters    
					vDocumentText = SMS.ReplaceSMSParameters(vDocumentText, vClientDoc, , cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), ?(ValueIsFilled(vClientDoc), vClientDoc.DiscountCard, Undefined));
					// Write attachment
					InformationRegisters.GuestGroupAttachments.WriteData(, vGuestGroup, , vGuestGroup.Client, , , , , , Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, vDocumentText, vTemplate, vClientDoc, , cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), vConfirmationFileName, , , vRemarks); 
				EndIf;
				// Update folio payment method
				If ValueIsFilled(vPaymentObj.PaymentMethod) And ValueIsFilled(vPaymentObj.Folio)
				   And ValueIsFilled(vPaymentObj.Folio.PaymentMethod) Then
					If vPaymentObj.Folio.PaymentMethod <> vPaymentObj.PaymentMethod And 
					   Not vPaymentObj.Folio.PaymentMethod.IsByBankTransfer And 
					   Not vPaymentObj.PaymentMethod.IsByBonuses Then
						vFolioObj = vPaymentObj.Folio.GetObject();
						vFolioObj.PaymentMethod = vPaymentObj.PaymentMethod;
						vFolioObj.Write(DocumentWriteMode.Write);
					EndIf;
				EndIf;
			EndIf;
		EndIf;
		If vUseCustomerPayment Then
			If Not ValueIsFilled(vCustomer) Then
				vCustomer = vHotel.IndividualsCustomer;
			EndIf;
			If ValueIsFilled(vCustomer) Then
				WriteLogEvent(vFuncLogName, EventLogLevel.Information, vCustomer.Metadata(), vCustomer, 
							  NStr("en='Customer is ';ru='Контрагент ';de='Partner '") + TrimAll(vCustomer));
				// Create payment for the folio being found
				If vPaymentObj = Undefined Then
					vPaymentObj = Documents.CustomerPayment.CreateDocument();
					vPaymentObj.Hotel = vHotel; 
					vPaymentObj.pmFillAttributesWithDefaultValues();
					If pPaymentDate <> Undefined Then
						vPaymentObj.Date = pPaymentDate;
					ElsIf pExternalPaymentData <> Undefined And pExternalPaymentData.Date <> Undefined Then
						vPaymentObj.Date = pExternalPaymentData.Date;
					EndIf;
				EndIf;
				If ValueIsFilled(vCustomer.Contract) Then
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, vCustomer.Contract.Metadata(), vCustomer.Contract, 
							      NStr("en='Fill by contract ';ru='Заполнить по договору ';de='Ausfüllen nach Vertrag '") + TrimAll(vCustomer.Contract));
					vPaymentObj.Fill(vCustomer.Contract);
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, vCustomer.Contract.Metadata(), vCustomer.Contract, 
							      NStr("en='Payment contract is ';ru='Договор в платеже установлен на ';de='Vertrag in der Zahlung ist gesetzt auf '") + TrimAll(vPaymentObj.AccountingContract));
				Else
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, vCustomer.Contract.Metadata(), vCustomer.Contract, 
							      NStr("en='Fill by customer ';ru='Заполнить по контрагенту ';de='Ausfüllen nach Partner '") + TrimAll(vCustomer));
					vPaymentObj.Fill(vCustomer);
					WriteLogEvent(vFuncLogName, EventLogLevel.Information, vPaymentObj.AccountingContract.Metadata(), vPaymentObj.AccountingContract, 
							      NStr("en='Payment contract is ';ru='Договор в платеже установлен на ';de='Vertrag in der Zahlung ist gesetzt auf '") + TrimAll(vPaymentObj.AccountingContract));
				EndIf;
				If ValueIsFilled(vCompany) Then
					vPaymentObj.Company = vCompany;
				EndIf;
				vPaymentObj.PaymentCurrency = vCurrency;
				vPaymentObj.PaymentMethod = vPaymentMethod;
				vPaymentObj.PaymentSection = vPaymentSection;
				vPaymentObj.Sum = pSum;
				vPaymentObj.SumInAccountingCurrency = Round(cmConvertCurrencies(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.AccountingCurrency, vPaymentObj.AccountingCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
				vPaymentObj.GuestGroup = vGuestGroup;
				vPaymentObj.Invoice = vInvoiceRef;
				vPaymentObj.Contracts.Clear();
				vPaymentObj.Invoices.Clear();
				vPaymentObj.pmCalculateSums();
				// Reference and authorization codes
				vPaymentObj.ReferenceNumber = TrimAll(pReferenceNumber);
				vPaymentObj.AuthorizationCode = TrimAll(pAuthorizationCode);
				// Payment remarks
				vPaymentObj.SlipText = TrimR(pRemarks);
				// External system payment code
				vPaymentObj.ExternalCode = TrimR(vPaymentExternalCode);
				// Cash register
				vCashRegister = Undefined;
				If ValueIsFilled(vPaymentMethod) And vPaymentMethod.BookByCashRegister Then
					If Not ValueIsFilled(vCashRegister) And pPaymentMethod <> Undefined And Not IsBlankString(pPaymentMethod) Then
						vCashRegister = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "CashRegisters", pPaymentMethod, , vInteraction);
					EndIf;
					If Not ValueIsFilled(vCashRegister) Then
						vCashRegister = GetPaymentCashRegister(vPaymentObj.Company, vPaymentMethod, vPaymentObj.Hotel);
					EndIf;
					If ValueIsFilled(vCashRegister) Then
						vPaymentObj.CashRegister = vCashRegister;
					EndIf;
				EndIf;
				vPaymentObj.pmFillContactsToOFD();
				// Post payment
				vPaymentObj.Write(DocumentWriteMode.Posting);
				// Update guest group reservation status
				If ValueIsFilled(vGuaranteedReservationStatus) And ValueIsFilled(vGuestGroup) Then
					vOperationParameters = New Array();
					vOperationParameters.Add(vGuestGroup);
					vOperationParameters.Add(vGuaranteedReservationStatus);
					vOperationParameters.Add(vFuncLogName);
					// Submit background update group status process
					AsyncCalls.StartBackgroundJob("ProlongedOperations.GuestGroups_SetReservationsStatus", vOperationParameters, String(vGuestGroup.UUID()), NStr("en='Update status of guest group reservations'; ru='Изменение статуса брони по группе'; de='Änderung des Gruppereservierungsstatus'"));
				EndIf;
				// Write guest group attachment that payment was received
				If Not vHotel.DoNotSendPaymentConfirmationEMailsForExternalSystemPayments Then
					vLanguage = vHotel.Language;
					vHotelPrintName = Catalogs.Hotels.pmGetHotelPrintName(vHotel, vLanguage);
					vRemarks = vHotelPrintName + StrTemplate(cmNStr("en = '. Payment N%1 at %2'; de = '. Payment N%1 at %2'; ru = '. Платеж №%1 от %2'", vLanguage), TrimAll(vPaymentObj.Number), Format(vPaymentObj.Date, "DF=dd.MM.yy"));
					vDocumentText = "";	
					vTemplate = Undefined;
					If ValueIsFilled(vHotel) Then
						vTemplate = vHotel.TemplateSendWriteGuestGroupPaymentConfirmation;
						If ValueIsFilled(vTemplate) Then
							vRemarks = cmNStr(TrimAll(vTemplate.Description), vLanguage);
							If ValueIsFilled(vTemplate.HTMLTextRu) Or ValueIsFilled(vTemplate.HTMLTextEn) Or ValueIsFilled(vTemplate.HTMLTextDe) Then
								vDocumentText = SMS.GetHTMLTextByLanguage(vTemplate, vLanguage);
							EndIf;
							If IsBlankString(vDocumentText) Then
								vDocumentText = SMS.GetSMSTextByLanguage(vTemplate, vLanguage);
							EndIf; 
						EndIf;
					EndIf;	
					If IsBlankString(vDocumentText) Then
						vGuaranteedReservationStatusPres = Chars.LF;
						If ValueIsFilled(vGuaranteedReservationStatus) Then
							vGuaranteedReservationStatusPres = Chars.LF + cmNStr("en = 'Reservation status was changed to '; 
																				 |de = 'Status der Reservierung wurde verändert zu '; 
																				 |ru = 'Статус брони был изменен на '", vLanguage) 
															  + Catalogs.ReservationStatuses.pmGetReservationStatusDescription(vGuaranteedReservationStatus, vLanguage) 
															  + Chars.LF;	
														  EndIf;	 
						vClientFullName = "";
						If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.Client) Then
							vClientFullName = cmNStr("en='Client name: ';ru='Клиент: ';de='Kunde: '", vLanguage) + TrimAll(vGuestGroup.Client.FullName) + Chars.LF;
						EndIf;	    
						vPeriod = "";
						If ValueIsFilled(vGuestGroup) And ValueIsFilled(vGuestGroup.CheckInDate) And ValueIsFilled(vGuestGroup.CheckOutDate) Then
							vPeriod = StrTemplate(cmNStr("en='Period of stay: %1 - %2';ru='Период проживания: %1 - %2';de='Unterbringungszeitraum: %1 - %2'", vLanguage), Format(vGuestGroup.CheckInDate, "DF='dd.MM.yyyy HH:mm'"), Format(vGuestGroup.CheckOutDate, "DF='dd.MM.yyyy HH:mm'")) + Chars.LF;
						EndIf;
						vDocumentText = vClientFullName 
										+ vPeriod          
										+ Chars.LF 
					                    + StrTemplate(cmNStr("en='Payment with amount %1 for reservation number %2 was received and successfully processed!'; 
										         |de='Payment with amount %1 for reservation number %2 was received and successfully processed!'; 
					                           	 |ru='Платеж на сумму %1 по брони номер %2 был получен и успешно обработан!'", vLanguage), cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), Format(vGuestGroup.Code, "ND=12; NFD=0; NG=")) + Chars.LF  
					                    + vGuaranteedReservationStatusPres + Chars.LF 
										+ cmNStr("en='Payment details are ';ru='Детали платежа ';de='Zahlungsdetails '", vLanguage) + Chars.LF 
					                    + TrimAll(vPaymentObj.SlipText) + Chars.LF + Chars.LF 
					                    + cmNStr("en='Best regards,'; 
										         |de='Best regards,'; 
					                             |ru='С уважением,'", vLanguage) + Chars.LF 
					                    + vHotelPrintName + Chars.LF 
							            + cmNStr(SessionParameters.ConfigurationName, vLanguage);
					EndIf;					   
					// Call user exit procedure to give possibility to override message subject ans message text
					vUserExitProc = Catalogs.ExternalDataProcessors.WriteGuestGroupPaymentConfirmation;
					If ValueIsFilled(vUserExitProc) Then
						If vUserExitProc.ExternalProcessingType = Enums.ExternalProcessingTypes.Algorithm Then
							If Not IsBlankString(vUserExitProc.Algorithm) Then
								SetSafeMode(True);
								Execute(TrimAll(vUserExitProc.Algorithm));
								SetSafeMode(False);
							EndIf;
						EndIf;
					EndIf;
					If Not ValueIsFilled(vClientDoc) And ValueIsFilled(vGuestGroup) Then
						vClientDoc = vGuestGroup.ClientDoc;
					EndIf;	
					// Replace parameters   
					vDocumentText = SMS.ReplaceSMSParameters(vDocumentText, vClientDoc, , cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), ?(ValueIsFilled(vClientDoc), vClientDoc.DiscountCard, Undefined));
					// Write attachment
					InformationRegisters.GuestGroupAttachments.WriteData(, vGuestGroup, , vGuestGroup.Client, , , , , , Enums.AttachmentTypes.EMail, Enums.AttachmentStatuses.Ready, vDocumentText, vTemplate, vClientDoc, , cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, "NZ="), , , , vRemarks); 
				EndIf;
			Else
				Raise NStr("en='Failed to get customer!';ru='Не удалось определить контрагента!';de='Der Partner konnte nicht bestimmt werden!'");
			EndIf;
		EndIf;   
		
		vSalesTotals = New ValueTable;  
		vPaymentTotals = New ValueTable;

		If ValueIsFilled(vGuestGroup) Then
			vGroupObj = vGuestGroup.GetObject();
			vSalesTotals = vGroupObj.pmGetSalesTotals();
			vPaymentTotals = vGroupObj.pmGetPaymentsTotals();  
		EndIf;		
		
		// Get total group amount
		vSum = 0;
		vCurrency = vHotel.BaseCurrency;
		vExtCurrencyCode = "";
		vSumPresentation = "";
		If vSalesTotals.Count() > 0 Then
			vCurrency = vSalesTotals.Get(0).Currency;
			For Each vSalesTotalsRow In vSalesTotals Do
				If vSalesTotalsRow.Currency = vCurrency Then
					vSum = vSum + vSalesTotalsRow.Sales + vSalesTotalsRow.SalesForecast;
				Else
					vSum = vSum + cmConvertCurrencies(vSalesTotalsRow.Sales + vSalesTotalsRow.SalesForecast, vSalesTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
				EndIf;
			EndDo;
			vSum = Round(vSum, 2);
		EndIf;
		vSumPresentation = cmFormatSum(vSum, vCurrency, "NZ=");
		vExtCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGuestGroup.Owner, pExternalSystemCode, "Currencies", vCurrency);
		If IsBlankString(vExtCurrencyCode) Then
			vExtCurrencyCode = TrimAll(vCurrency.Description);
		EndIf;
		// Get base currency code
		vBaseCurrency = vHotel.BaseCurrency;
		vExtBaseCurrencyCode = cmGetObjectExternalSystemCodeByRef(vGuestGroup.Owner, pExternalSystemCode, "Currencies", vBaseCurrency);
		If IsBlankString(vExtBaseCurrencyCode) Then
			vExtBaseCurrencyCode = TrimAll(vBaseCurrency.Description);
		EndIf;
		// Get currency rate
		vCurrencyRate = cmGetCurrencyExchangeRate(vHotel, vCurrency, CurrentSessionDate());
		// Get group balance
		vPaymentSum = 0;
		For Each vPaymentTotalsRow In vPaymentTotals Do
			If vPaymentTotalsRow.Currency = vCurrency Then
				vPaymentSum = vPaymentSum + vPaymentTotalsRow.Sum;
			Else
				vPaymentSum = vPaymentSum + cmConvertCurrencies(vPaymentTotalsRow.Sum, vPaymentTotalsRow.Currency, , vCurrency, , CurrentSessionDate(), vHotel);
			EndIf;
			vPaymentSum = Round(vPaymentSum, 2);
		EndDo;
		vBalanceAmount = vSum - vPaymentSum;
		vBalanceAmountPresentation = cmFormatSum(vBalanceAmount, vCurrency, "NZ=");
		CommitTransaction();  
		
		// Create online cheque
		If vPaymentObj <> Undefined And vPaymentObj.Posted Then    
			vReservationDepartment = vPaymentObj.Hotel.ReservationDepartment;
			If ValueIsFilled(vPaymentObj.CashRegister) And ValueIsFilled(vPaymentObj.PaymentMethod) And 
			   vPaymentObj.PaymentMethod.BookByCashRegister And vPaymentObj.PaymentMethod.PrintCheque Then
			   If tcCashRegisters.GetChequeAttributes(vPaymentObj.Ref) = Undefined Then  
				   vPaymentFuncParams = New Array;
				   vPaymentFuncParams.Add(vPaymentObj.Ref);
				   vPaymentFuncParams.Add(vReservationDepartment);
				   
				    AsyncCalls.StartBackgroundJob("tcCashRegisters.CreateAndSendOnlineCheque", vPaymentFuncParams);
				EndIf;
			EndIf;
			// Check if payment folio is closed and rise warning if so
			If TypeOf(vPaymentObj) = Type("DocumentObject.Payment") And ValueIsFilled(vPaymentObj.Folio) Then
				If vPaymentObj.Folio.IsClosed And ValueIsFilled(vPaymentObj.Hotel) And ValueIsFilled(vReservationDepartment) Then   
					vMsg = NStr("en = 'Payment received for cancelled reservation! Guest group: %1, amount: %2'; 
								|de = 'Die Zahlung für die storniert Reservierung erhaltet! Gaste Gruppe: %1, summe: %2'; 
								|ru = 'Получен платеж по отмененной брони! Группа гостей: %1, сумма: %2'"); 
					
					vAmount = cmFormatSum(vPaymentObj.Sum, vPaymentObj.PaymentCurrency);
					
					cmSendMessageToDepartment(vReservationDepartment, 
											  StrTemplate(vMsg, TrimAll(vPaymentObj.GuestGroup), vAmount), 
											  Undefined, 
											  True, 
											  ?(ValueIsFilled(vPaymentObj.GuestGroup), vPaymentObj.GuestGroup, vPaymentObj.Payer));
				EndIf;
			EndIf;
		EndIf;
		// Build return string
		vRetStr = """" + TrimAll(vPaymentObj.Number) + """" + "," + """" + """";
		// Log success		
		WriteLogEvent(vFuncLogName, EventLogLevel.Information, vPaymentObj.Metadata(), vPaymentObj.Ref, 
					  NStr("en = 'Payment is written - OK!'; de = 'Die Zahlung wurde in die Datenbank geschrieben!'; ru = 'Платеж записан в БД!'") + Chars.LF + vRetStr);
		// Return based on output type
		If pOutputType = "CSV" Then
			// Debug
			If vWriteDebug Then
				vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLogName, Enums.ExternalSystemEventTypes.Info, , vRetStr , vMsg, vInteraction.MaxLogLenght);
			EndIf;

			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPaymentStatus"));
			vRetXDTO.PaymentNumber = TrimAll(vPaymentObj.Number);
			vRetXDTO.ErrorDescription = "";
			vRetXDTO.TotalSum = vSum;
			vRetXDTO.TotalSumPresentation = vSumPresentation;
			vRetXDTO.Balance = vBalanceAmount;
			vRetXDTO.BalancePresentation = vBalanceAmountPresentation;
			vRetXDTO.UUID = String(vGuestGroup.UUID());
			// Debug
			If vWriteDebug Then
				vExtraXML = "";
				vXMLWriter = New XMLWriter; 
				vXMLWriter.SetString();
				XDTOFactory.WriteXML(vXMLWriter, vRetXDTO);
				vExtraXML = vXMLWriter.Close();
				
				vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
				InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLogName, Enums.ExternalSystemEventTypes.Info, , vExtraXML , vMsg, vInteraction.MaxLogLenght);
			EndIf;

			Return vRetXDTO;
		EndIf;
	Except        
		RollbackTransaction();
		vErrorDescription = cmGetRootErrorDescription(ErrorInfo());
		If vWriteDebug Then
			vMsg =  NStr("en='End of processing';ru='Конец выполнения';de='Ende des Ausführung'");
			InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLogName, Enums.ExternalSystemEventTypes.Error, , , ErrorDescription(), vInteraction.MaxLogLenght);
		Else
			// Write log event
			WriteLogEvent(vFuncLogName, EventLogLevel.Error, , , NStr("en='Error description: ';ru='Описание ошибки: ';de='Fehlerbeschreibung: '") + ErrorDescription());
		EndIf;	
					  
		// Send error notifications
		If ValueIsFilled(SessionParameters.CurrentUser) And Not IsBlankString(SessionParameters.CurrentUser.BccEMail) Then
			WriteLogEvent(vFuncLogName, EventLogLevel.Error, , , 
						  NStr("en='Send notification e-mail: ';ru='Отправка e-mail уведомления об ошибке: ';de='Versenden einer Fehlermeldung per E-Mail: '") + NStr("en='Failed to write external payment! ';ru='Ошибка при сохранении внешнего платежа! ';de='Fehler beim Speichern der externen Zahlung! '") + pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " + pCurrency + " -> " + TrimAll(SessionParameters.CurrentUser.BccEMail));
			vEMailErrorMessage = "";
			JobsScheduled.cmSendTextByEMail(NStr("en = 'Failed to write external payment! '; 
												 |de = 'Fehler beim Speichern der externen Zahlung! '; 
												 |ru = 'Ошибка при сохранении внешнего платежа! '") + pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " 
												 + pCurrency, pExtGroupCode + ", " + pExtPayerCode + " = " + pSum + " " + pCurrency + Chars.LF + Chars.LF 
												 + vErrorDescription, SessionParameters.CurrentUser.BccEMail, False, vEMailErrorMessage);
			If Not IsBlankString(vEMailErrorMessage) Then
				WriteLogEvent(vFuncLogName, EventLogLevel.Error, , , NStr("en = 'Error sending notification e-mail: '; 
																		  |de = 'Es konnte keine E-Mail-Fehlerbenachrichtigung verschickt werden: '; 
																		  |ru = 'Не удалось отправить e-mail уведомление об ошибке: '") + vEMailErrorMessage);
			EndIf;
		EndIf;
		// Build return string
		vRetStr = """" + """" + "," + """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupPaymentStatus"));
			vRetXDTO.PaymentNumber = "";
			vRetXDTO.ErrorDescription = Left(vErrorDescription, 4096);
			vRetXDTO.TotalSum = 0;
			vRetXDTO.TotalSumPresentation = "";
			vRetXDTO.Balance = 0;
			vRetXDTO.BalancePresentation = "";
			vRetXDTO.UUID = "";
			Return vRetXDTO;
		EndIf;
	EndTry;
EndFunction // cmWriteExternalPayment

// -----------------------------------------------------------------------------
// Get folio multiple advance amounts
// -----------------------------------------------------------------------------
Function cmGetMultipleAdvanceAmountsForTheFolio(pFolio, pPaymentCurrency, pCallIsByGuestGroup = False) Export
	vServices = New ValueTable();
	
	// Do basic checks
	If Not ValueIsFilled(pFolio) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pFolio.Hotel) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pFolio.FolioCurrency) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pPaymentCurrency) Then
		Return vServices;
	EndIf;
	vHotelAccountingDate = BegOfDay(CurrentSessionDate());
	If ValueIsFilled(pFolio.Hotel.AccountingDate) Then
		vHotelAccountingDate = pFolio.Hotel.AccountingDate;
	EndIf;
	
	// Get forecast data
	vQry = New Query();
	vQry.Text = 
	"SELECT DISTINCT
	|	OperationFolios.Folio AS Folio
	|INTO Folios
	|FROM
	|	(SELECT
	|		Folios.Ref AS Folio,
	|		Folios.GuestGroup AS GuestGroup
	|	FROM
	|		Document.Folio AS Folios
	|	WHERE
	|		Folios.Ref = &qFolio
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		Folios.Ref,
	|		Folios.GuestGroup
	|	FROM
	|		Document.Folio AS Folios
	|	WHERE
	|		Folios.GuestGroup = &qFolioGuestGroup
	|		AND Folios.GuestGroup <> VALUE(Catalog.GuestGroups.EmptyRef)
	|		AND NOT Folios.DeletionMark
	|		AND NOT Folios.IsClosed
	|		AND &qCallIsByGuestGroup) AS OperationFolios
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PaymentSectionsByDates.AccountingDate AS AccountingDate,
	|	PaymentSectionsByDates.ResNumber AS ResNumber,
	|	PaymentSectionsByDates.PaymentSection AS PaymentSection,
	|	PaymentSectionsByDates.Service AS Service,
	|	PaymentSectionsByDates.VATRate AS VATRate,
	|	SUM(PaymentSectionsByDates.Sum) AS Sum
	|FROM
	|	(SELECT
	|		CASE
	|			WHEN Transactions.Recorder REFS Document.Storno
	|				THEN ISNULL(Transactions.Recorder.ParentCharge.ParentDoc.Number, """")
	|			WHEN Transactions.Recorder REFS Document.Charge
	|					AND NOT Transactions.Recorder.CorrectedCharge.Number IS NULL
	|				THEN ISNULL(Transactions.Recorder.CorrectedCharge.ParentDoc.Number, """")
	|			ELSE ISNULL(Transactions.Recorder.ParentDoc.Number, """")
	|		END AS ResNumber,
	|		CASE
	|			WHEN Transactions.Recorder REFS Document.Storno
	|				THEN BEGINOFPERIOD(Transactions.Recorder.ParentCharge.Date, DAY)
	|			WHEN Transactions.Recorder REFS Document.Charge
	|					AND NOT Transactions.Recorder.CorrectedCharge.Number IS NULL
	|				THEN BEGINOFPERIOD(Transactions.Recorder.CorrectedCharge.Date, DAY)
	|			ELSE BEGINOFPERIOD(Transactions.Recorder.Date, DAY)
	|		END AS AccountingDate,
	|		Transactions.Service AS Service,
	|		AdvanceSections.Ref AS PaymentSection,
	|		Transactions.Sum AS Sum,
	|		Transactions.VATRate AS VATRate
	|	FROM
	|		AccumulationRegister.Accounts AS Transactions
	|			INNER JOIN Folios AS Folios
	|			ON Transactions.Folio = Folios.Folio
	|			INNER JOIN Catalog.PaymentSections AS AdvanceSections
	|			ON (AdvanceSections.ChequeItemType = VALUE(Enum.ChequeItemTypes.Payment))
	|				AND (AdvanceSections.VATRate = Transactions.VATRate)
	|				AND (NOT AdvanceSections.DeletionMark)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ForecastTransactions.Recorder.Number,
	|		ForecastTransactions.AccountingDate,
	|		ForecastTransactions.Service,
	|		AdvanceSections.Ref,
	|		ForecastTransactions.Sales,
	|		ForecastTransactions.VATRate
	|	FROM
	|		AccumulationRegister.AccountsReceivableForecast AS ForecastTransactions
	|			INNER JOIN Folios AS Folios
	|			ON ForecastTransactions.Folio = Folios.Folio
	|			INNER JOIN Catalog.PaymentSections AS AdvanceSections
	|			ON (AdvanceSections.ChequeItemType = VALUE(Enum.ChequeItemTypes.Payment))
	|				AND (AdvanceSections.VATRate = ForecastTransactions.VATRate)
	|				AND (NOT AdvanceSections.DeletionMark)
	|	WHERE
	|		ForecastTransactions.AccountingDate >= &qHotelDate) AS PaymentSectionsByDates
	|
	|GROUP BY
	|	PaymentSectionsByDates.AccountingDate,
	|	PaymentSectionsByDates.ResNumber,
	|	PaymentSectionsByDates.Service,
	|	PaymentSectionsByDates.PaymentSection,
	|	PaymentSectionsByDates.VATRate
	|
	|HAVING
	|	SUM(PaymentSectionsByDates.Sum) > 0
	|
	|ORDER BY
	|	AccountingDate,
	|	ResNumber,
	|	PaymentSectionsByDates.PaymentSection.Code,
	|	PaymentSectionsByDates.Service.SortCode,
	|	PaymentSectionsByDates.Service.Code";
	vQry.SetParameter("qFolio", pFolio);
	vQry.SetParameter("qFolioGuestGroup", pFolio.GuestGroup);
	vQry.SetParameter("qCallIsByGuestGroup", pCallIsByGuestGroup);
	vQry.SetParameter("qHotelDate", vHotelAccountingDate);
	vServices = vQry.Execute().Unload();
	
	vBegOfCheckInDate = BegOfDay(pFolio.DateTimeFrom);
	vBegOfCheckOutDate = BegOfDay(pFolio.DateTimeTo);
	
	// Recalculate amounts in the table received
	For Each vServicesRow In vServices Do
		If ValueIsFilled(vServicesRow.AccountingDate) And 
		   ValueIsFilled(vServicesRow.Service) And ValueIsFilled(vServicesRow.Service.QuantityCalculationRule) Then
			vAccountingDateMove = cmGetAccountingDateMove(vServicesRow.Service.QuantityCalculationRule, False, ?(ValueIsFilled(pFolio.ParentDoc), pFolio.ParentDoc, pFolio));
			If vAccountingDateMove < 0 Then
				vServicesRow.AccountingDate = vServicesRow.AccountingDate - (24*3600);
			EndIf;
		EndIf;
				
		vServicesRow.Sum = Round(cmConvertCurrencies(vServicesRow.Sum, pFolio.FolioCurrency, , pPaymentCurrency, , vHotelAccountingDate, pFolio.Hotel), 2);
	EndDo;
	
	Return vServices;
EndFunction // cmGetMultipleAdvanceAmountsForTheFolio

// -----------------------------------------------------------------------------
// Get folio multiple advance amounts
// -----------------------------------------------------------------------------
Function cmGetMultipleAdvanceAmountsForTheInvoice(pInvoice, pPaymentCurrency) Export
	vServices = New ValueTable();
	
	// Do basic checks
	If Not ValueIsFilled(pInvoice) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pInvoice.Hotel) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pInvoice.AccountingCurrency) Then
		Return vServices;
	EndIf;
	If Not ValueIsFilled(pPaymentCurrency) Then
		Return vServices;
	EndIf;
	vHotelAccountingDate = BegOfDay(CurrentSessionDate());
	If ValueIsFilled(pInvoice.Hotel.AccountingDate) Then
		vHotelAccountingDate = pInvoice.Hotel.AccountingDate;
	EndIf;
	
	// Get forecast data
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	PaymentSectionsByDates.AccountingDate AS AccountingDate,
	|	PaymentSectionsByDates.PaymentSection AS PaymentSection,
	|	PaymentSectionsByDates.Service AS Service,
	|	PaymentSectionsByDates.VATRate AS VATRate,
	|	SUM(PaymentSectionsByDates.Sum) AS Sum
	|FROM
	|	(SELECT
	|		Transactions.AccountingDate AS AccountingDate,
	|		Transactions.Service AS Service,
	|		AdvanceSections.Ref AS PaymentSection,
	|		Transactions.Sum AS Sum,
	|		Transactions.VATRate AS VATRate
	|	FROM
	|		Document." + ?(TypeOf(pInvoice) = Type("DocumentRef.ProformaInvoice"), "ProformaInvoice", "Settlement") + ".Services AS Transactions
	|			INNER JOIN Catalog.PaymentSections AS AdvanceSections
	|			ON (AdvanceSections.ChequeItemType = VALUE(Enum.ChequeItemTypes.Payment))
	|				AND (AdvanceSections.VATRate = Transactions.VATRate)
	|				AND (NOT AdvanceSections.DeletionMark)
	|	WHERE
	|		Transactions.Ref = &qInvoice) AS PaymentSectionsByDates
	|
	|GROUP BY
	|	PaymentSectionsByDates.AccountingDate,
	|	PaymentSectionsByDates.Service,
	|	PaymentSectionsByDates.PaymentSection,
	|	PaymentSectionsByDates.VATRate
	|
	|HAVING
	|	SUM(PaymentSectionsByDates.Sum) > 0
	|
	|ORDER BY
	|	PaymentSectionsByDates.AccountingDate,
	|	PaymentSectionsByDates.PaymentSection.Code,
	|	PaymentSectionsByDates.Service.SortCode,
	|	PaymentSectionsByDates.Service.Code";
	vQry.SetParameter("qInvoice", pInvoice);
	vServices = vQry.Execute().Unload();
	
	vBegOfCheckInDate = '00010101';
	vBegOfCheckOutDate = '00010101';
	vGuestGroup = pInvoice.GuestGroup;
	vParentDoc = pInvoice.ParentDoc;
	If ValueIsFilled(vParentDoc) And (TypeOf(vParentDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vParentDoc) = Type("DocumentRef.Reservation")) Then
		vBegOfCheckInDate = BegOfDay(vGuestGroup.CheckInDate);
		vBegOfCheckOutDate = BegOfDay(vGuestGroup.CheckOutDate);
	ElsIf ValueIsFilled(vParentDoc) And (TypeOf(vParentDoc) = Type("DocumentRef.ResourceReservation") Or TypeOf(vParentDoc) = Type("DocumentRef.Folio")) Then
		vBegOfCheckInDate = BegOfDay(vParentDoc.DateTimeFrom);
		vBegOfCheckOutDate = BegOfDay(vParentDoc.DateTimeTo);
	ElsIf ValueIsFilled(vGuestGroup) Then
		vBegOfCheckInDate = BegOfDay(vGuestGroup.CheckInDate);
		vBegOfCheckOutDate = BegOfDay(vGuestGroup.CheckOutDate);
	EndIf;
	
	// Recalculate amounts in the table received
	For Each vServicesRow In vServices Do
		If ValueIsFilled(vServicesRow.AccountingDate) And 
		   ValueIsFilled(vServicesRow.Service) And ValueIsFilled(vServicesRow.Service.QuantityCalculationRule) Then
			If TypeOf(vParentDoc) = Type("DocumentRef.Accommodation") Or TypeOf(vParentDoc) = Type("DocumentRef.Reservation") Then
				vAccountingDateMove = cmGetAccountingDateMove(vServicesRow.Service.QuantityCalculationRule, False, vParentDoc);
				If vAccountingDateMove < 0 Then
					vServicesRow.AccountingDate = vServicesRow.AccountingDate - (24*3600);
				EndIf;
			EndIf;
		EndIf;
				
		vServicesRow.Sum = Round(cmConvertCurrencies(vServicesRow.Sum, pInvoice.AccountingCurrency, , pPaymentCurrency, , vHotelAccountingDate, pInvoice.Hotel), 2);
	EndDo;
	
	Return vServices;
EndFunction // cmGetMultipleAdvanceAmountsForTheInvoice

// -----------------------------------------------------------------------------
Function cmGetPaymentByExternalSystemCode(pHotel, pPaymentExternalCode) Export
	vPaymentRef = Undefined;
	If Not ValueIsFilled(pPaymentExternalCode) Then
		Return vPaymentRef;
	EndIf;
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Payments.Ref AS Ref
	|FROM
	|	Document.Payment AS Payments
	|WHERE
	|	Payments.ExternalCode = &qExternalCode
	|	AND Payments.Hotel = &qHotel
	|	AND Payments.Posted
	|
	|ORDER BY
	|	Payments.PointInTime";
	vQry.SetParameter("qExternalCode", TrimR(pPaymentExternalCode));
	vQry.SetParameter("qHotel", pHotel);
	vPayments = vQry.Execute().Unload();
	If vPayments.Count() = 1 Then
		vPaymentRef = vPayments.Get(0).Ref;
	EndIf;
	Return vPaymentRef;
EndFunction // cmGetPaymentByExternalSystemCode

