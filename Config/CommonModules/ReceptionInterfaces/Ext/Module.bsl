					  ?(ValueIsFilled(vRow.Beds8), Format(vRow.Beds7Price, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Beds8), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.Beds8PriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Baby), Format(vRow.BabyPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Baby), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.BabyPriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Child), Format(vRow.ChildPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Child), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.ChildPriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.Teen), Format(vRow.TeenPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.Teen), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.TeenPriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.ExtraBaby), Format(vRow.ExtraBabyPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.ExtraBaby), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.ExtraBabyPriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.ExtraChild), Format(vRow.ExtraChildPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.ExtraChild), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.ExtraChildPriceCurrency) + """", """" + """") + "," + 
					  ?(ValueIsFilled(vRow.ExtraTeen), Format(vRow.ExtraTeenPrice, "ND=17; NFD=2; NDS=.; NG="), "") + "," + 
					  ?(ValueIsFilled(vRow.ExtraTeen), """" + GetObjectExternalSystemCodeByRef(vCodesCash, vRow.Hotel, pExternalSystemCode, "Currencies", vRow.ExtraTeenPriceCurrency) + """", """" + """") + "," + 
