Function GetUpgrade(pDocRef)
	// Check that this is main room document
	vUpgradeAvailable = Undefined;
	If Not ValueIsFilled(pDocRef) Or Not ValueIsFilled(pDocRef.AccommodationTemplate) Then
		Return vUpgradeAvailable;
	EndIf;
	vRoomTypeFrom = pDocRef.RoomType;
	vRoomTypeTo = Undefined;
	
	// Check if there is special offer of room type upgrade for the reservation customer or reservation guest
	vPriceMarkup = 0;
	vPriceDifferenceDiscount = 0;
	
	vOffers = cmGetPendingSpecialOffersForReservation(pDocRef, True);
	If vOffers.Count() = 0 Then
		If Not ValueIsFilled(pDocRef.RoomRate) Or Not pDocRef.RoomRate.ShowUpgrades Then
    	    Return vUpgradeAvailable;
		Else
			vPriceDifferenceDiscount = pDocRef.RoomRate.UpgradeDiscount;
			// Get next room type
			vQry = New Query();
			vQry.Text = 
			"SELECT TOP 1
			|	RoomTypes.Ref AS Ref,
			|	RoomTypes.Code AS Code,
			|	RoomTypes.Description AS Description
			|FROM
			|	Catalog.RoomTypes AS RoomTypes
			|WHERE
			|	NOT RoomTypes.DeletionMark
			|	AND NOT RoomTypes.IsFolder
			|	AND RoomTypes.SortCode > &qSortCode
			|
			|ORDER BY
			|	RoomTypes.SortCode";
			vQry.SetParameter("qSortCode", vRoomTypeFrom.SortCode);
			vNextRoomTypes = vQry.Execute().Unload();
			For Each vNextRoomTypesRow In vNextRoomTypes Do
				vRoomTypeTo = vNextRoomTypesRow.Ref;
				Break;
			EndDo;
		EndIf;
	Else
		// Try to find room type that will be used to upgrade to
		For Each vOffersRow In vOffers Do
			vRowMatched = False;
			vOffer = vOffersRow.SpecialOffer;
			For Each vRoomTypeUpgradesRow In vOffer.RoomTypeUpgrades Do
				If Not ValueIsFilled(vRoomTypeUpgradesRow.RoomTypeFrom) Then
					vRowMatched = True;
				ElsIf vRoomTypeUpgradesRow.RoomTypeFrom.IsFolder And vRoomTypeFrom.BelongsToItem(vRoomTypeUpgradesRow.RoomTypeFrom) Then
					vRowMatched = True;
				ElsIf vRoomTypeUpgradesRow.RoomTypeFrom = vRoomTypeFrom Then
					vRowMatched = True;
				EndIf;
				If vRowMatched Then
					vRoomTypeTo = vRoomTypeUpgradesRow.RoomTypeTo;
					
					vPriceMarkup = vRoomTypeUpgradesRow.PriceMarkup;
					vPriceDifferenceDiscount = vRoomTypeUpgradesRow.PriceDifferenceDiscount;
					
					Break;
				EndIf;
			EndDo;
			If vRowMatched Then
				Break;
			EndIf;
		EndDo;
	EndIf;
	
	If Not ValueIsFilled(vRoomTypeTo) Or (vPriceMarkup = 0 And vPriceDifferenceDiscount = 0) Then
		// Nothing to upgrade to
		Return vUpgradeAvailable;
	EndIf;
    
	// Get number of persons
	vNumberOfAdults = pDocRef.AccommodationTemplate.NumberOfAdults;
	vNumberOfTeenagers = pDocRef.AccommodationTemplate.NumberOfTeenagers;
	vNumberOfChildren = pDocRef.AccommodationTemplate.NumberOfChildren;
	vNumberOfInfants = pDocRef.AccommodationTemplate.NumberOfInfants;
	
	vDuration = pDocRef.Duration;
	If vDuration = 0 Then
		vDuration = 1;
	EndIf;
	vRoomQuantity = pDocRef.RoomQuantity;
	If vRoomQuantity = 0 Then
		vRoomQuantity = 1;
	EndIf;
	
	// Get one room guests
	vOneRoomDocs = cmGetOneRoomReservations(pDocRef.Number, pDocRef.GuestGroup, pDocRef.CheckInDate, pDocRef.CheckOutDate, False);
	
	// Calculate old amount
	vOldAmount = 0;
	vNewAmount = 0;
	vNewAmountWithoutDiscount = 0;
	For Each vOneRoomDocsRow In vOneRoomDocs Do
		vProbeRef = vOneRoomDocsRow.Ref;
		vOldAmount = vOldAmount + vProbeRef.Services.Total("Sum") - vProbeRef.Services.Total("DiscountSum");
	EndDo;

	vNewAccTemplate = cmGetAccommodationTemplate(vRoomTypeTo, vNumberOfAdults, vNumberOfTeenagers, vNumberOfChildren, vNumberOfInfants);
	If Not ValueIsFilled(vNewAccTemplate) Then
		// Nothing to upgrade to
		Return vUpgradeAvailable;
	Else
		If vNewAccTemplate.AccommodationTypes.Count() <> vOneRoomDocs.Count() Then
			// Nothing to upgrade to
			Return vUpgradeAvailable;
		EndIf;
	EndIf;
	
	// Recalculate prices
	For Each vOneRoomDocsRow In vOneRoomDocs Do
		vProbeObj = vOneRoomDocsRow.Ref.GetObject();
		vProbeObj.RoomType = vRoomTypeTo;
		vProbeObj.RoomTypeUpgrade = Undefined;
		vProbeObj.Room = Catalogs.Rooms.EmptyRef();
		vProbeObj.AccommodationType = vNewAccTemplate.AccommodationTypes.Get(vOneRoomDocs.IndexOf(vOneRoomDocsRow)).AccommodationType;
		vProbeObj.pmCalculateResources();
		vProbeObj.PriceCalculationDate = '00010101';
		vProbeObj.RoomRates.Clear();
		vProbeObj.Services.Clear();
		vMessage = "";
		vAttributeInErr = "";
		If vOneRoomDocs.IndexOf(vOneRoomDocsRow) = 0 And 
		   vProbeObj.pmCheckDocumentAttributes(vProbeObj, False, vMessage, vAttributeInErr, False, True, True) Then
			Break;
		EndIf;
		vProbeObj.pmCalculateServices();
		vNewAmount = vNewAmount + vProbeObj.Services.Total("Sum") - vProbeObj.Services.Total("DiscountSum");
	EndDo;
	
	If vNewAmount <= vOldAmount Then
		// Nothing to upgrade to
		Return vUpgradeAvailable;
	EndIf;
		
	vNewAmountWithoutDiscount = vNewAmount;
	vNewAmount = vOldAmount;

	If vPriceDifferenceDiscount <> 0 Then
		vPriceDifference = Round((vNewAmount - vOldAmount) / vDuration, 2);
		vPriceDifference = Round(vPriceDifference * vPriceDifferenceDiscount / 100, 2);
		
		vNewAmount = vNewAmount + vPriceDifference * vDuration;
	EndIf;
	
	If vPriceMarkup <> 0 Then
		vNewAmount = vNewAmount + vPriceMarkup * vDuration * vRoomQuantity;
	EndIf;
	
	// Compare amounts
	If vNewAmount <> 0 And vNewAmount > vOldAmount Then
		vUpgradeAvailable = New Structure("UpgradeAmount, UpgradeAmountWithoutDiscount, UpgradeRoomType, UpgradeRoomTypeDescription, UpgradeRoomRateCode, UpgradeAccommodationTemplate");
		vUpgradeAvailable.UpgradeAmount = vNewAmount - vOldAmount;
		vUpgradeAvailable.UpgradeAmountWithoutDiscount = vNewAmountWithoutDiscount - vOldAmount;
		vUpgradeAvailable.UpgradeRoomType = vRoomTypeTo.Code;
		vUpgradeAvailable.UpgradeRoomTypeDescription = vRoomTypeTo.Description;
		vUpgradeAvailable.UpgradeRoomRateCode = pDocRef.RoomRate.Code;
		vUpgradeAvailable.UpgradeAccommodationTemplate = vNewAccTemplate;
		Return vUpgradeAvailable;
	EndIf;
	
	Return vUpgradeAvailable;
EndFunction // GetUpgrade

// -----------------------------------------------------------------------------
Function GetDailyPricesForReservation(pReservationRef)
	vResult = New ValueTable;
	vResult.Columns.Add("Date");
	vResult.Columns.Add("Price");
	vResult.Columns.Add("PriceBeforeDiscount");
	vResult.Columns.Add("Currency");

	vQuery = New Query;
	vQuery.Text = 
		"SELECT
		|	ReservationServices.Ref AS Ref,
		|	ReservationServices.Sum AS Sum,
		|	ReservationServices.DiscountSum AS DiscountSum,
		|	ReservationServices.Service AS Service,
		|	ReservationServices.IsManual AS IsManual,
		|	ReservationServices.AccountingDate AS AccountingDate,
		|	ReservationServices.Folio.FolioCurrency AS FolioCurrency
		|FROM
		|	Document.Reservation.Services AS ReservationServices
		|WHERE
		|	ReservationServices.Ref.Number = &qResNumber
		|	AND NOT ReservationServices.Ref.DeletionMark
		|	AND ReservationServices.IsInPrice
		|	AND ReservationServices.Ref.GuestGroup = &qGuestGroup
		|
		|ORDER BY
		|	AccountingDate";
	
	vQuery.SetParameter("qResNumber", pReservationRef.Number);
	vQuery.SetParameter("qGuestGroup", pReservationRef.GuestGroup);
	
	vQueryResult = vQuery.Execute().Unload();
	
	For Each vRow In vQueryResult Do
		If ValueIsFilled(vRow.Service.QuantityCalculationRule) Then
			vAccountingDateMove = cmGetAccountingDateMove(vRow.Service.QuantityCalculationRule, vRow.IsManual, pReservationRef);
			If vAccountingDateMove < 0 Then
				vRow.AccountingDate = BegOfDay(vRow.AccountingDate) - tcCommonFunctionOnClientServer.cmOneDay();	
			EndIf;
		EndIf;
		
		vResultRow = vResult.Find(BegOfDay(vRow.AccountingDate), "Date");
		If vResultRow = Undefined Then
			vResultRow 			= vResult.Add();
			vResultRow.Date 	= BegOfDay(vRow.AccountingDate);
			vResultRow.Price 	= vRow.Sum - vRow.DiscountSum;
			vResultRow.PriceBeforeDiscount = vRow.Sum;
			If ValueIsFilled(vRow.FolioCurrency) Then
				vResultRow.Currency = vRow.FolioCurrency.Code;
			ElsIf ValueIsFilled(pReservationRef.Hotel.BaseCurrency) Then
				vResultRow.Currency = pReservationRef.Hotel.BaseCurrency.Code;	
			EndIf;
		Else
			vResultRow.Price 	= vResultRow.Price + (vRow.Sum - vRow.DiscountSum);	
			vResultRow.PriceBeforeDiscount = vResultRow.PriceBeforeDiscount + vRow.Sum;	
		EndIf;
	EndDo;
	
	Return vResult;
EndFunction

// -----------------------------------------------------------------------------
Function CheckTemplate(pTemplate, pAccommodationType, rAccommodationTypeCount = 1)
	vReturn = False;
	rAccommodationTypeCount = 1;
	vAccTypeRows = pTemplate.AccommodationTypes.FindRows(New Structure("AccommodationType", pAccommodationType));
	If vAccTypeRows.Count() > 0 Then
		rAccommodationTypeCount = vAccTypeRows.Count();
		vReturn = True;
	EndIf;
	Return vReturn;
EndFunction // CheckTemplate

// -----------------------------------------------------------------------------
Function GetOrderTypeByService(pService, pHotel)
	vOrderType = Undefined;
	vQry = New Query();
	vQry.Text = 
	"SELECT DISTINCT
	|	OrderTypesServicesAllowed.Ref AS OrderType
	|FROM
	|	Catalog.OrderTypes.ServicesAllowed AS OrderTypesServicesAllowed
	|WHERE
	|	OrderTypesServicesAllowed.Service = &qService
	|	AND NOT OrderTypesServicesAllowed.Ref.DeletionMark";
	vQry.SetParameter("qService", pService);
	vTypes = vQry.Execute().Unload();
	For Each vTypesRow In vTypes Do
		If ValueIsFilled(vTypesRow.OrderType) Then
			vOrderType = vTypesRow.OrderType;
			Break;
		EndIf;
	EndDo;
	Return vOrderType;
EndFunction // GetOrderTypeByService

// -----------------------------------------------------------------------------
Function cmGetAccommodationTemplateForRoomCode(pRoomCode, pHotel, pWriteExternalGroupReservation)
	vAccommodationTemplate = Undefined;
	
	If Not IsBlankString(pRoomCode) Then
		vAccTypes = New ValueTable();
		vAccTypes.Columns.Add("AccommodationType");
		vAccTypes.Columns.Add("Code", cmGetStringTypeDescription(5));
		vAccTypes.Columns.Add("SortCode", cmGetNumberTypeDescription(4, 0));
		
		vTemplateAccTypes = New ValueTable();
		vTemplateAccTypes.Columns.Add("AccommodationType");
		vTemplateAccTypes.Columns.Add("Code", cmGetStringTypeDescription(5));
		vTemplateAccTypes.Columns.Add("SortCode", cmGetNumberTypeDescription(4, 0));
		
		For Each vRow In pWriteExternalGroupReservation.WriteExternalGroupReservationRow Do
			If TrimAll(vRow.Room) = pRoomCode Then
				If Not IsBlankString(vRow.AccommodationType) Then
					vAccommodationType = cmGetObjectRefByExternalSystemCode(pHotel, vRow.ExternalSystemCode, "AccommodationTypes", vRow.AccommodationType);
					If ValueIsFilled(vAccommodationType) Then
						vAccTypesRow = vAccTypes.Add();
						vAccTypesRow.AccommodationType = vAccommodationType;
						vAccTypesRow.Code = TrimAll(vAccommodationType.Code);
						vAccTypesRow.SortCode = vAccommodationType.SortCode;
					EndIf;
				EndIf;
			EndIf;
		EndDo;
		vAccTypes.Sort("SortCode");
		
		If vAccTypes.Count() > 0 Then
			vCurAccTemplateHash = "";
			For Each vAccTypesRow In vAccTypes Do
				vCurAccTemplateHash = vCurAccTemplateHash + ?(IsBlankString(vCurAccTemplateHash), "", ",") + TrimAll(vAccTypesRow.Code);
			EndDo;
			
			vAllAccTemplates = cmGetAllAccommodationTemplates(pHotel);
			For Each vAllAccTemplatesRow In vAllAccTemplates Do
				vAccTemplate = vAllAccTemplatesRow.AccommodationTemplate;
				If vAccTemplate.AccommodationTypes.Count() = vAccTypes.Count() Then
					vTemplateAccTypes.Clear();
					For Each vAccTemplateAccommodationTypesRow In vAccTemplate.AccommodationTypes Do
						vTemplAccType = vAccTemplateAccommodationTypesRow.AccommodationType;
						
						vTemplateAccTypesRow = vTemplateAccTypes.Add();
						vTemplateAccTypesRow.AccommodationType = vTemplAccType;
						vTemplateAccTypesRow.Code = TrimAll(vTemplAccType.Code);
						vTemplateAccTypesRow.SortCode = vTemplAccType.SortCode;
					EndDo;
					vTemplateAccTypes.Sort("SortCode");
				
					vAccTemplateHash = "";
					For Each vTemplateAccTypesRow In vTemplateAccTypes Do
						vAccTemplateHash = vAccTemplateHash + ?(IsBlankString(vAccTemplateHash), "", ",") + TrimAll(vTemplateAccTypesRow.Code);
					EndDo;
					
					If vAccTemplateHash = vCurAccTemplateHash Then
						vAccommodationTemplate = vAllAccTemplatesRow.AccommodationTemplate;
						Break;
					EndIf;
				EndIf;
			EndDo;
		EndIf;
	EndIf;
	
	Return vAccommodationTemplate;
EndFunction // cmGetAccommodationTemplateForRoomCode

// -----------------------------------------------------------------------------
Function GetObjectExternalSystemCodeByRef(pCodesCash, pHotel, pExtSystemCode, pCatalogName, pItemRef)
	vCashRows = pCodesCash.FindRows(New Structure("Hotel, ItemRef", pHotel, pItemRef));
	If vCashRows.Count() = 1 Then
		// Take code from the cash
		vExtItemCode = vCashRows.Get(0).ExtItemCode;
	Else
		// Take code from the settings information register
		vExtItemCode = cmGetObjectExternalSystemCodeByRef(pHotel, pExtSystemCode, pCatalogName, pItemRef);
		// Save code to the cash
		vCashRow = pCodesCash.Add();
		vCashRow.Hotel = pHotel;
		vCashRow.ItemRef = pItemRef;
		vCashRow.ExtItemCode = vExtItemCode;
	EndIf;
	Return vExtItemCode;
EndFunction // GetObjectExternalSystemCodeByRef

