// -----------------------------------------------------------------------------
Function cmGetEffectivePriceTags(pHotel, pRoomRate, pRoomType, pPeriodFrom, pPeriodTo, rPriceTagsList, pDuration = 0, pPriceCalculationDate = Undefined) Export
	vPriceCalculationDate = pPriceCalculationDate;
	If pPriceCalculationDate = Undefined Then
		vPriceCalculationDate = CurrentSessionDate();
	EndIf;
	vRoomTypesList = New ValueList();
	If TypeOf(pRoomType) = Type("ValueList") Then
		vRoomTypesList = pRoomType;
	Else
		If ValueIsFilled(pRoomType) Then
			If Not pRoomType.IsFolder Then
				vRoomTypesList.Add(pRoomType);
			Else
				vRoomTypes = cmGetAllRoomTypes(pHotel, pRoomType);
				vRoomTypesList.LoadValues(vRoomTypes.UnloadColumn("RoomType"));
			EndIf;
		Else
			vRoomTypes = cmGetAllRoomTypes(pHotel);
			vRoomTypesList.LoadValues(vRoomTypes.UnloadColumn("RoomType"));
		EndIf;
	EndIf;
	vRoomRatesList = New ValueList();
	If TypeOf(pRoomRate) = Type("ValueList") Then
		vRoomRatesList = pRoomRate;
	ElsIf ValueIsFilled(pRoomRate) Then
		vRoomRatesList.Add(pRoomRate);
	EndIf;
	rPriceTagsList = New ValueList();
	vOccupationPercents = New ValueTable();
	vTable = New ValueTable();
	vTable.Columns.Add("Period", cmGetDateTypeDescription());
	vTable.Columns.Add("RoomRate", cmGetCatalogTypeDescription("RoomRates"));
	vTable.Columns.Add("RoomRateInCache", cmGetCatalogTypeDescription("RoomRates"));
	vTable.Columns.Add("RoomType", cmGetCatalogTypeDescription("RoomTypes"));
	vTable.Columns.Add("PriceTag", cmGetCatalogTypeDescription("PriceTags"));
	For Each vRoomRatesListItem In vRoomRatesList Do
		vRoomRate = vRoomRatesListItem.Value;
		vPriceTagRanges = New ValueTable();
		If ValueIsFilled(vRoomRate.PriceTagType) Then
			vPriceTagRanges = cmGetPriceTagRanges(pHotel, vRoomRate.PriceTagType, vPriceCalculationDate, True);
		EndIf;
		vOccupationPercents = New ValueTable();
		If vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercent Then
			vOccupationPercents = cmFillOccupationPercents(pHotel, pPeriodFrom, pPeriodTo, True);
		ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomType Then
			vOccupationPercents = cmFillOccupationPercentsPerRoomType(pHotel, vRoomTypesList, pPeriodFrom, pPeriodTo);
		ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomClass Then
			vOccupationPercents = cmFillOccupationPercentsPerRoomClass(pHotel, vRoomTypesList, pPeriodFrom, pPeriodTo);
		ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomTypePerDayType Then
			vOccupationPercents = cmFillOccupationPercentsPerRoomTypePerDayType(pHotel, vRoomTypesList, pPeriodFrom, pPeriodTo, vRoomRate);
		EndIf;
		For Each vRoomTypesListItem In vRoomTypesList Do
			vRoomType = vRoomTypesListItem.Value;
			If vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercent Or
			   vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomType Or
			   vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomClass Or
			   vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomTypePerDayType Then
				If ValueIsFilled(vRoomType) And ValueIsFilled(vRoomType.BaseRoomType) Then
					vRoomType = vRoomType.BaseRoomType;
				EndIf;
			EndIf;
			vCurDate = BegOfDay(pPeriodFrom);
			While vCurDate <= BegOfDay(pPeriodTo) Do
				// Check if there is manual override of day price tag
				vDayPriceTag = Undefined;
				vDayTypes = cmGetCalendarDayType(vRoomRate, vCurDate, pPeriodFrom, pPeriodTo, vDayPriceTag, vRoomType);
				If ValueIsFilled(vDayPriceTag) And (ValueIsFilled(vRoomRate.PriceTagType) Or ValueIsFilled(vRoomRate.BasedOnPriceTag)) Then
					vTableRow = vTable.Add();
					vTableRow.Period = vCurDate;
					vTableRow.RoomRate = vRoomRate;
					If ValueIsFilled(vRoomRate) Then
						vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
					Else
						vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
					EndIf;
					vTableRow.RoomType = vRoomType;
					vTableRow.PriceTag = vDayPriceTag;
					If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
						rPriceTagsList.Add(vTableRow.PriceTag);
					EndIf;
				Else
					If ValueIsFilled(vRoomRate) And ValueIsFilled(vRoomRate.PriceTagType) Then
						vCurPriceTag = Catalogs.PriceTags.EmptyRef();
						If vRoomRate.PriceTagType = Enums.PriceTagTypes.ByDurationOfStayByDays Then
							vCurDurationInDays = (vCurDate - BegOfDay(pPeriodFrom))/(24*3600) + 1;
							vCurDurationInDays = ?(vCurDurationInDays < 0, 0, vCurDurationInDays);
							vCurDurationInDays = Max(vCurDurationInDays, pDuration);
							For Each vPriceTagRangesRow In vPriceTagRanges Do
								If vPriceTagRangesRow.EndValueNotIncluded Then
									If vCurDurationInDays >= vPriceTagRangesRow.StartValue And vCurDurationInDays < vPriceTagRangesRow.EndValue Then
										vCurPriceTag = vPriceTagRangesRow.PriceTag;
										Break;
									EndIf;
								Else
									If vCurDurationInDays >= vPriceTagRangesRow.StartValue And vCurDurationInDays <= vPriceTagRangesRow.EndValue Then
										vCurPriceTag = vPriceTagRangesRow.PriceTag;
										Break;
									EndIf;
								EndIf;
							EndDo;
							vTableRow = vTable.Add();
							vTableRow.Period = vCurDate;
							vTableRow.RoomRate = vRoomRate;
							If ValueIsFilled(vRoomRate) Then
								vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
							Else
								vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
							EndIf;
							vTableRow.RoomType = vRoomType;
							vTableRow.PriceTag = vCurPriceTag;
							If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
								rPriceTagsList.Add(vTableRow.PriceTag);
							EndIf;
						ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByDurationOfStayByPeriod Then
							vCurDurationInDays = 1;
							If pDuration > 0 Then
								vCurDurationInDays = pDuration;
							Else
								vCurDurationInDays = (BegOfDay(pPeriodTo) - BegOfDay(pPeriodFrom))/(tcCommonFunctionOnClientServer.cmOneDay());
								vCurDurationInDays = ?(vCurDurationInDays <= 0, 1, vCurDurationInDays);
							EndIf;
							For Each vPriceTagRangesRow In vPriceTagRanges Do
								If vPriceTagRangesRow.EndValueNotIncluded Then
									If vCurDurationInDays >= vPriceTagRangesRow.StartValue And vCurDurationInDays < vPriceTagRangesRow.EndValue Then
										vCurPriceTag = vPriceTagRangesRow.PriceTag;
										Break;
									EndIf;
								Else
									If vCurDurationInDays >= vPriceTagRangesRow.StartValue And vCurDurationInDays <= vPriceTagRangesRow.EndValue Then
										vCurPriceTag = vPriceTagRangesRow.PriceTag;
										Break;
									EndIf;
								EndIf;
							EndDo;
							vTableRow = vTable.Add();
							vTableRow.Period = vCurDate;
							vTableRow.RoomRate = vRoomRate;
							If ValueIsFilled(vRoomRate) Then
								vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
							Else
								vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
							EndIf;
							vTableRow.RoomType = vRoomType;
							vTableRow.PriceTag = vCurPriceTag;
							If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
								rPriceTagsList.Add(vTableRow.PriceTag);
							EndIf;
						ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercent Then
							vCurOccupancyPercentRow = vOccupationPercents.Find(vCurDate, "AccountingDate");
							If vCurOccupancyPercentRow <> Undefined Then
								vCurOccupancyPercent = vCurOccupancyPercentRow.OccupationPercent;
								For Each vPriceTagRangesRow In vPriceTagRanges Do
									If vPriceTagRangesRow.EndValueNotIncluded Then
										If vCurOccupancyPercent >= vPriceTagRangesRow.StartValue And vCurOccupancyPercent < vPriceTagRangesRow.EndValue Then
											vCurPriceTag = vPriceTagRangesRow.PriceTag;
											Break;
										EndIf;
									Else
										If vCurOccupancyPercent >= vPriceTagRangesRow.StartValue And vCurOccupancyPercent <= vPriceTagRangesRow.EndValue Then
											vCurPriceTag = vPriceTagRangesRow.PriceTag;
											Break;
										EndIf;
									EndIf;
								EndDo;
							EndIf;
							vTableRow = vTable.Add();
							vTableRow.Period = vCurDate;
							vTableRow.RoomRate = vRoomRate;
							If ValueIsFilled(vRoomRate) Then
								vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
							Else
								vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
							EndIf;
							vTableRow.RoomType = vRoomType;
							vTableRow.PriceTag = vCurPriceTag;
							If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
								rPriceTagsList.Add(vTableRow.PriceTag);
							EndIf;
						ElsIf vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomType Or 
						      vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomClass Or 
						      vRoomRate.PriceTagType = Enums.PriceTagTypes.ByOccupancyPercentPerRoomTypePerDayType Then
							vCurOccupancyPercentRows = vOccupationPercents.FindRows(New Structure("AccountingDate, RoomType", vCurDate, vRoomType));
							If vCurOccupancyPercentRows.Count() > 0 Then
								For Each vCurOccupancyPercentRow In vCurOccupancyPercentRows Do
									vCurOccupancyPercent = vCurOccupancyPercentRow.OccupationPercent;
									For Each vPriceTagRangesRow In vPriceTagRanges Do
										If vPriceTagRangesRow.EndValueNotIncluded Then
											If vCurOccupancyPercent >= vPriceTagRangesRow.StartValue And vCurOccupancyPercent < vPriceTagRangesRow.EndValue Then
												vCurPriceTag = vPriceTagRangesRow.PriceTag;
												Break;
											EndIf;
										Else
											If vCurOccupancyPercent >= vPriceTagRangesRow.StartValue And vCurOccupancyPercent <= vPriceTagRangesRow.EndValue Then
												vCurPriceTag = vPriceTagRangesRow.PriceTag;
												Break;
											EndIf;
										EndIf;
									EndDo;
									vTableRow = vTable.Add();
									vTableRow.Period = vCurDate;
									vTableRow.RoomRate = vRoomRate;
									If ValueIsFilled(vRoomRate) Then
										vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
									Else
										vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
									EndIf;
									vTableRow.RoomType = vRoomType;
									vTableRow.PriceTag = vCurPriceTag;
									If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
										rPriceTagsList.Add(vTableRow.PriceTag);
									EndIf;
								EndDo;
							EndIf;
						EndIf;
					Else
						vTableRow = vTable.Add();
						vTableRow.Period = vCurDate;
						vTableRow.RoomRate = vRoomRate;
						If ValueIsFilled(vRoomRate) Then
							vTableRow.RoomRateInCache = ?(ValueIsFilled(vRoomRate.BasedOnRoomRate), vRoomRate.BasedOnRoomRate, vRoomRate);
						Else
							vTableRow.RoomRateInCache = Catalogs.RoomRates.EmptyRef();
						EndIf;
						vTableRow.RoomType = vRoomType;
						vTableRow.PriceTag = vRoomRate.BasedOnPriceTag;
						If rPriceTagsList.FindByValue(vTableRow.PriceTag) = Undefined Then
							rPriceTagsList.Add(vTableRow.PriceTag);
						EndIf;
					EndIf;
				EndIf;
				vCurDate = vCurDate + 24*3600;
			EndDo; // By dates
		EndDo; // By room types
	EndDo; // By room rates
	vTable.GroupBy("Period, RoomRate, RoomRateInCache, RoomType, PriceTag", );
	Return vTable;
EndFunction // cmGetEffectivePriceTags

// -----------------------------------------------------------------------------
Procedure cmRemovePriceTags(pPrices, pPriceTagsList, pPriceTags) Export
	i = 0;
	While i < pPrices.Count() Do
		vRow = pPrices.Get(i);
		vPriceTagsList = pPriceTagsList;
		vPriceTagsPerRoomType = pPriceTags.FindRows(New Structure("RoomType", vRow.RoomType));
		If vPriceTagsPerRoomType.Count() > 0 Then
			vPriceTagsList = New ValueList();
			For Each vPriceTagsPerRoomTypeRow In vPriceTagsPerRoomType Do
				vPriceTagsList.Add(vPriceTagsPerRoomTypeRow.PriceTag);
			EndDo;
		EndIf;
		If vPriceTagsList.FindByValue(vRow.PriceTag) = Undefined Then
			pPrices.Delete(vRow);
			Continue;
		EndIf;
		i = i + 1;
	EndDo;
EndProcedure // cmRemovePriceTags

// -----------------------------------------------------------------------------
Procedure GetDayPrices(pPeriod, pPrices, pPriceTags, pRoomRate, pRoomType, 
	                   pSingle, pSingleTemplate, pDouble, pDoubleTemplate, 
					   pTriple, pTripleTemplate, pQuadle, pQuadleTemplate,
					   pBeds5, pBeds5Template, pBeds6, pBeds6Template,
					   pBeds7, pBeds7Template, pBeds8, pBeds8Template,
					   pExtraBed, pBaby, pChild, pTeen, pExtraBaby, pExtraChild, pExtraTeen,
	                   pSinglePrice, pSinglePriceCurrency, pDoublePrice, pDoublePriceCurrency, 
					   pTriplePrice, pTriplePriceCurrency, pQuadlePrice, pQuadlePriceCurrency, 
					   pBeds5Price, pBeds5PriceCurrency, pBeds6Price, pBeds6PriceCurrency, 
					   pBeds7Price, pBeds7PriceCurrency, pBeds8Price, pBeds8PriceCurrency, 
					   pExtraBedPrice, pExtraBedPriceCurrency, 
					   pBabyPrice, pBabyPriceCurrency, pChildPrice, pChildPriceCurrency, pTeenPrice, pTeenPriceCurrency, 
					   pExtraBabyPrice, pExtraBabyPriceCurrency, pExtraChildPrice, pExtraChildPriceCurrency, pExtraTeenPrice, pExtraTeenPriceCurrency, 
					   pAllAccommodationTypes, pAccommodationTypePrices)
	vAccountingDate = BegOfDay(pPeriod);
	vPriceTag = Catalogs.PriceTags.EmptyRef();
	vPriceTagsRows = pPriceTags.FindRows(New Structure("Period, RoomType", vAccountingDate, pRoomType));
	If vPriceTagsRows.Count() = 0 Then
		vPriceTagsRows = pPriceTags.FindRows(New Structure("Period", vAccountingDate));
	EndIf;
	If vPriceTagsRows.Count() > 0 Then
		vPriceTagsRow = vPriceTagsRows.Get(0);
		vPriceTag = vPriceTagsRow.PriceTag;
	EndIf;
	vPrices = pPrices.FindRows(New Structure("PriceTag, IsInPrice", vPriceTag, True));

	// Get calendar day type
	vCalendarDayType = cmGetCalendarDayType(pRoomRate, vAccountingDate, Undefined, Undefined, , pRoomType);
	
	// Process all accommodation types
	GetDayAccommodationTypePrice(pPeriod, vPrices, vCalendarDayType, pRoomType, 
	                             pSingle, pSingleTemplate, pSinglePrice, pSinglePriceCurrency, 
								 pDouble, pDoubleTemplate, pDoublePrice, pDoublePriceCurrency, 
								 pTriple, pTripleTemplate, pTriplePrice, pTriplePriceCurrency, 
								 pQuadle, pQuadleTemplate, pQuadlePrice, pQuadlePriceCurrency, 
								 pBeds5, pBeds5Template, pBeds5Price, pBeds5PriceCurrency, 
								 pBeds6, pBeds6Template, pBeds6Price, pBeds6PriceCurrency, 
								 pBeds7, pBeds7Template, pBeds7Price, pBeds7PriceCurrency, 
								 pBeds8, pBeds8Template, pBeds8Price, pBeds8PriceCurrency, 
								 pExtraBed, pExtraBedPrice, pExtraBedPriceCurrency,
								 pBaby, pBabyPrice, pBabyPriceCurrency, 
								 pChild, pChildPrice, pChildPriceCurrency, 
								 pTeen, pTeenPrice, pTeenPriceCurrency, 
								 pExtraBaby, pExtraBabyPrice, pExtraBabyPriceCurrency, 
								 pExtraChild, pExtraChildPrice, pExtraChildPriceCurrency, 
								 pExtraTeen, pExtraTeenPrice, pExtraTeenPriceCurrency);
	
	// Fill value table with accommodation prices
	If vPrices.Count() > 0 Then
		For Each vAllAccommodationTypesRow In pAllAccommodationTypes Do
			vAccommodationType = vAllAccommodationTypesRow.AccommodationType;
			vAccommodationTypePrice = 0;
			vAccommodationTypePriceCurrency = Undefined;
			// Get suitable prices
			For Each vPricesRow In vPrices Do
				vPrAccDate = vPricesRow.AccountingDate;
				vPrCalDayType = vPricesRow.CalendarDayType;
				vPrRoomType = vPricesRow.RoomType;
				vPrAccType = vPricesRow.AccommodationType;
				If (Not ValueIsFilled(vPrAccDate) Or ValueIsFilled(vPrAccDate) And vPrAccDate = vAccountingDate) And 
				   (Not ValueIsFilled(vPrCalDayType) Or ValueIsFilled(vPrCalDayType) And vPrCalDayType = vCalendarDayType) And 
				   (Not ValueIsFilled(vPrRoomType) Or ValueIsFilled(vPrRoomType) And vPrRoomType = pRoomType) And 
				   (Not ValueIsFilled(vPrAccType) Or ValueIsFilled(vPrAccType) And vPrAccType = vAccommodationType) Then
					If vPricesRow.IsRoomRevenue And Not ValueIsFilled(vAccommodationTypePriceCurrency) Then
						vAccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If vPricesRow.IsPricePerPerson Then
							vAccommodationTypePrice = vAccommodationTypePrice + ?(vPricesRow.NumberOfPersons = 0, 1, vPricesRow.NumberOfPersons) * ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price;
						Else
							vAccommodationTypePrice = vAccommodationTypePrice + ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price;
						EndIf;
					EndIf;
				EndIf;
			EndDo;
			// Add accommodation type data to the value table
			If ValueIsFilled(vAccommodationTypePriceCurrency) Then
				vATPRow = pAccommodationTypePrices.Add();
				vATPRow.AccommodationType = vAccommodationType;
				vATPRow.Price = vAccommodationTypePrice;
				vATPRow.PriceCurrency = vAccommodationTypePriceCurrency;
			EndIf;
		EndDo;
	EndIf;
EndProcedure // GetDayPrices

// -----------------------------------------------------------------------------
// Description: This API is used to retrieve daily vacant room balances for the 
//              given room quota or room inventory in total and join this data with
//              room rate prices. Prices are returned for 1 guest, 2 guests in one room,
//              3 guests in one room and for additional bed
// Parameters: Hotel, Room type, Customer, Contract, Agent, Room quota, Period from,
//             Period to, Room rate code, Client type code, Flags what data to return, 
//             External system code, Language code, Output type: CSV, XDTO or XML, 
//             XML Writer to use in case of XML output
// Return value: CSV strings or XML or XDO RoomInventoryBalance object with vacant room 
//               balances grouped by hotel, room type and day joined with prices for the 
//               given room rate
// -----------------------------------------------------------------------------
Function cmGetRoomInventoryBalance(pHotelCode, pRoomTypeCode, pCustomerName, pContractName, pAgentName, 
                                   pRoomQuotaCode, pPeriodFrom, pPeriodTo, pRoomRateCode =  "", pClientTypeCode = "", 
								   pOutputRoomsVacant = True, pOutputBedsVacant = False, pOutputRoomsRemains = False, pOutputBedsRemains = False, 
								   pOutputRoomsInQuota = False, pOutputBedsInQuota = False, pOutputRoomsChargedInQuota = False, pOutputBedsChargedInQuota = False, 
								   pOutputRoomsReserved = False, pOutputBedsReserved = False, pOutputInHouseRooms = False, pOutputInHouseBeds = False, 
								   pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV", pXMLWriter = Undefined) Export
	vInputParameters =  NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты номеров: ';de='Zimmerquotencode: '") + pRoomQuotaCode + Chars.LF + 
	              NStr("en='Customer name: ';ru='Название контрагента: ';de='Bezeichnung des Partners: '") + pCustomerName + Chars.LF + 
	              NStr("en='Contract name: ';ru='Название договора: ';de='Bezeichnung des Vertrags: '") + pContractName + Chars.LF + 
	              NStr("en='Agent name: ';ru='Название агента: ';de='Bezeichnung des Vertreters: '") + pAgentName + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo + Chars.LF +  
	              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode + Chars.LF + 
	              NStr("en='Client type code: ';ru='Код типа клиента: ';de='Kundentypcode: '") + pClientTypeCode + Chars.LF + 
	              NStr("en='Output rooms vacant for the hotel: ';ru='Возвращать число свободных номеров по всей гостинице: ';de='Die Anzahl von freien Zimmern im gesamten Hotel zurückgeben: '") + pOutputRoomsVacant + Chars.LF + 
	              NStr("en='Output beds vacant for the hotel: ';ru='Возвращать число свободных мест по всей гостинице: ';de='Die Anzahl von freien Plätzen im gesamten Hotel zurückgeben: '") + pOutputBedsVacant + Chars.LF + 
	              NStr("en='Output rooms vacant for the allotment: ';ru='Возвращать число свободных номеров по квоте: ';de='Anzahl von freien Zimmern nach der Quote zurückgeben:'") + pOutputRoomsRemains + Chars.LF + 
	              NStr("en='Output beds vacant for the allotment: ';ru='Возвращать число свободных мест по квоте: ';de='Anzahl von freien Plätzen nach der Quote zurückgeben: '") + pOutputBedsRemains + Chars.LF + 
	              NStr("en='Output rooms in the allotment: ';ru='Возвращать число номеров в квоте: ';de='Die Anzahl von Zimmern in der Quote zurückgeben: '") + pOutputRoomsInQuota + Chars.LF + 
	              NStr("en='Output beds in the allotment: ';ru='Возвращать число мест в квоте: ';de='Die Anzahl von Plätzen in der Quote zurückgeben: '") + pOutputBedsInQuota + Chars.LF + 
	              NStr("en='Output charged rooms in the allotment: ';ru='Возвращать число номеров в оплаченной жесткой квоте: ';de='Die Anzahl von Zimmern in der bezahlten festen Quote zurückgeben: '") + pOutputRoomsChargedInQuota + Chars.LF + 
	              NStr("en='Output charged beds in the allotment: ';ru='Возвращать число мест в оплаченной жесткой квоте: ';de='Die Anzahl von Plätzen in der bezahlten festen Quote zurückgeben: '") + pOutputBedsChargedInQuota + Chars.LF + 
	              NStr("en='Output rooms reserved: ';ru='Возвращать число забронированных номеров: ';de='Die Anzahl von reservierten Zimmern zurückgeben: '") + pOutputRoomsReserved + Chars.LF + 
	              NStr("en='Output beds reserved: ';ru='Возвращать число забронированных мест: ';de='Die Anzahl von reservierten Plätzen zurückgeben: '") + pOutputBedsReserved + Chars.LF + 
	              NStr("en='Output inhouse rooms: ';ru='Возвращать число занятых номеров: ';de='Die Anzahl von belegten Zimmern zurückgeben: '") + pOutputInHouseRooms + Chars.LF + 
	              NStr("en='Output inhouse beds: ';ru='Возвращать число занятых мест: ';de='Die Anzahl von belegten Plätzen zurückgeben: '") + pOutputInHouseBeds;
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);   
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode, vHotel);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;  
	vFuncName = "cmGetRoomInventoryBalance";
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncName, Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg);
	Else
		WriteLogEvent(NStr("en='Get external group reservation status';ru='Получить статус внешней группы';de='Satus der externen Gruppe erhalten'"), EventLogLevel.Information, , , vInputParameters);
	EndIf;	
	
	vCalcMinPrice = False;
	vMinPriceRate = Catalogs.RoomRates.EmptyRef();
	vMinPriceRoomType = Catalogs.RoomTypes.EmptyRef();
	vMinPriceAccType = Catalogs.AccommodationTypes.EmptyRef();
	If ValueIsFilled(vInteraction) Then
		vMinPriceRate = vInteraction.MinPriceRate;
		vMinPriceRoomType = vInteraction.MinPriceRoomType;
		vMinPriceAccType = vInteraction.MinPriceAccType;
		If vInteraction.CalcMinPrice And ValueIsFilled(vMinPriceRate) And ValueIsFilled(vMinPriceRoomType) And ValueIsFilled(vMinPriceAccType) Then
			vCalcMinPrice = True;	
		EndIf;
	EndIf;
		
	vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode, , vInteraction); 
	If ValueIsFilled(vRoomType) Then
		vMinPriceRoomType = vRoomType;
	EndIf;	
	vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode, , vInteraction);
	vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode, , vInteraction);
	vClientType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "ClientTypes", pClientTypeCode, , vInteraction);
	vCustomer = cmGetCustomerByName(pCustomerName,,,,,,,vHotel);
	vContract = cmGetContractByName(vCustomer, pContractName);
	vAgent = cmGetCustomerByName(pAgentName,,,,,,,vHotel);
	// Create cash of external system codes
	vCodesCash = New ValueTable();
	vCodesCash.Columns.Add("Hotel", cmGetCatalogTypeDescription("Hotels"));
	vCodesCash.Columns.Add("ItemRef");
	vCodesCash.Columns.Add("ExtItemCode", cmGetStringTypeDescription());
	// Call API to get value table with balances
	vBalances = cmGetRoomQuotaBalances(vHotel, vRoomType, vCustomer, vContract, vAgent, vRoomQuota, pPeriodFrom, pPeriodTo);
	// Check for stop internet sales
	For Each vRow In vBalances Do
		If vRow.Period = Null Then
			Continue;
		EndIf;
		vCurRoomType = vRow.RoomType;
		If vCurRoomType.StopSale Then
			vRemarks = "";
			If cmIsStopInternetSalePeriod(vCurRoomType, EndOfDay(vRow.Period), EndOfDay(vRow.Period), vRemarks) Then
				vRow.RoomsVacant = 0;
				vRow.BedsVacant = 0;
				vRow.RoomsRemains = 0;
				vRow.BedsRemains = 0;
			EndIf;
		EndIf;
	EndDo;
	// Price calculation date
	vPriceCalculationDate = CurrentSessionDate();
	// Initialize accommodation types to get prices for
	vSingle = Catalogs.AccommodationTypes.EmptyRef();
	vDouble = Catalogs.AccommodationTypes.EmptyRef();
	vTriple = Catalogs.AccommodationTypes.EmptyRef();
	vQuadle = Catalogs.AccommodationTypes.EmptyRef();
	vBeds5 = Catalogs.AccommodationTypes.EmptyRef();
	vBeds6 = Catalogs.AccommodationTypes.EmptyRef();
	vBeds7 = Catalogs.AccommodationTypes.EmptyRef();
	vBeds8 = Catalogs.AccommodationTypes.EmptyRef();
	vExtraBed = Catalogs.AccommodationTypes.EmptyRef();
	vBaby = Catalogs.AccommodationTypes.EmptyRef();
	vChild = Catalogs.AccommodationTypes.EmptyRef();
	vTeen = Catalogs.AccommodationTypes.EmptyRef();
	vExtraBaby = Catalogs.AccommodationTypes.EmptyRef();
	vExtraChild = Catalogs.AccommodationTypes.EmptyRef();
	vExtraTeen = Catalogs.AccommodationTypes.EmptyRef();
	vAccTypes = New ValueTable();
	vAccommodationTypePrices = New ValueTable();
	vAccommodationTypePrices.Columns.Add("AccommodationType", cmGetCatalogTypeDescription("AccommodationTypes"));
	vAccommodationTypePrices.Columns.Add("Price", cmGetSumTypeDescription());
	vAccommodationTypePrices.Columns.Add("PriceCurrency", cmGetCatalogTypeDescription("Currencies"));
	// Get room rate prices if room rate is specified
	If ValueIsFilled(vRoomRate) And vCalcMinPrice = False Then
		vRoomRateObj = vRoomRate.GetObject();
		vServicePackagesList = vRoomRateObj.pmGetRoomRateServicePackagesList(, True);
		vPrices = vRoomRateObj.pmGetRoomRatePrices(pPeriodFrom, vPriceCalculationDate, vClientType, vRoomType, , vServicePackagesList, , pPeriodFrom, pPeriodTo, True);
		If ValueIsFilled(vClientType) And (vPrices.Count() = 0 Or vPrices.FindRows(New Structure("IsRoomRevenue", True)).Count() = 0) Then
			vPrices = vRoomRateObj.pmGetRoomRatePrices(pPeriodFrom, vPriceCalculationDate, Catalogs.ClientTypes.EmptyRef(), vRoomType, , vServicePackagesList, , pPeriodFrom, pPeriodTo, True);
		EndIf;
		vPriceTagsList = New ValueList();
		vPriceTags = cmGetEffectivePriceTags(vHotel, vRoomRate, vRoomType, pPeriodFrom, pPeriodTo, vPriceTagsList, , vPriceCalculationDate);
		cmRemovePriceTags(vPrices, vPriceTagsList, vPriceTags);
		
		// Get accommodation types to return prices for
		vAccTypes = cmGetAllAccommodationTypes(, vHotel);
		For Each vAccTypesRow In vAccTypes Do
			If vAccTypesRow.AccommodationType.Type = Enums.AccomodationTypes.Room Then
				If Not ValueIsFilled(vSingle) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 1) Then
					vSingle = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vDouble) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 2) Then
					vDouble = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vTriple) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 3) Then
					vTriple = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vQuadle) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 4) Then
					vQuadle = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vBeds5) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 5) Then
					vBeds5 = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vBeds6) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 6) Then
					vBeds6 = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vBeds7) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 7) Then
					vBeds7 = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vBeds8) And (vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 0 Or vAccTypesRow.AccommodationType.NumberOfPersons4Reservation = 8) Then
					vBeds8 = vAccTypesRow.AccommodationType;
				EndIf;
			ElsIf vAccTypesRow.AccommodationType.Type = Enums.AccomodationTypes.Together Then
				If Not ValueIsFilled(vBaby) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.InfantsMaxAge) Then
					vBaby = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vChild) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.ChildrenMaxAge) Then
					vChild = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vTeen) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.TeenagersMaxAge) Then
					vTeen = vAccTypesRow.AccommodationType;
				EndIf;
			ElsIf vAccTypesRow.AccommodationType.Type = Enums.AccomodationTypes.AdditionalBed Then
				If Not ValueIsFilled(vExtraBaby) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.InfantsMaxAge) Then
					vExtraBaby = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vExtraChild) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.ChildrenMaxAge) Then
					vExtraChild = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vExtraTeen) And (vAccTypesRow.AccommodationType.AllowedClientAgeTo > 0 And (vAccTypesRow.AccommodationType.AllowedClientAgeTo - 1) = vHotel.TeenagersMaxAge) Then
					vExtraTeen = vAccTypesRow.AccommodationType;
				ElsIf Not ValueIsFilled(vExtraBed) Then
					vExtraBed = vAccTypesRow.AccommodationType;
				EndIf;
			EndIf;
		EndDo;
	ElsIf vCalcMinPrice Then
		vPriceTagsList = New ValueList();
		cmGetEffectivePriceTags(vHotel, vMinPriceRate, vMinPriceRoomType, pPeriodFrom, pPeriodTo, vPriceTagsList, , vPriceCalculationDate);
		
		vQuery = New Query;
		vQuery.Text = 
		"SELECT
		|	RoomRatesSliceLast.SetRoomRateFormulas AS Recorder,
		|	RoomRatesSliceLast.RoomRate AS RoomRate
		|INTO ActiveSetRoomRateFormulas
		|FROM
		|	InformationRegister.RoomRates.SliceLast(
		|			&qPriceCalculationDate,
		|			RoomRate = &qRoomRate
		|				AND Hotel = &qHotel
		|				AND IsFormula) AS RoomRatesSliceLast
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateFormulas.RoomRate.BasedOnRoomRate AS BasedOnRoomRate,
		|	RoomRateFormulas.RoomRate.BasedOnPriceTag AS BasedOnPriceTag,
		|	RoomRateFormulas.RoomRate AS RoomRate,
		|	RoomRateFormulas.Hotel AS Hotel,
		|	RoomRateFormulas.IsFormula AS IsFormula,
		|	RoomRateFormulas.Service AS Service,
		|	RoomRateFormulas.RoomType AS RoomType,
		|	RoomRateFormulas.AccommodationType AS AccommodationType,
		|	RoomRateFormulas.ClientType AS ClientType,
		|	RoomRateFormulas.CalendarDayType AS CalendarDayType,
		|	RoomRateFormulas.Recorder AS Recorder,
		|	RoomRateFormulas.Period AS Period,
		|	RoomRateFormulas.BracketsConstant AS BracketsConstant,
		|	RoomRateFormulas.Constant AS Constant,
		|	RoomRateFormulas.Multiplier AS Multiplier,
		|	RoomRateFormulas.ReplaceWithService AS ReplaceWithService
		|INTO RoomRateFormulas
		|FROM
		|	InformationRegister.RoomRateFormulas AS RoomRateFormulas
		|		INNER JOIN ActiveSetRoomRateFormulas AS ActiveSetRoomRateFormulas
		|		ON RoomRateFormulas.Recorder = ActiveSetRoomRateFormulas.Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RoomRateDailyPrices.Period AS Period,
		|	RoomRateDailyPrices.CalendarDayType AS CalendarDayType,
		|	RoomRateDailyPrices.PriceTag AS PriceTag,
		|	RoomRateDailyPrices.Currency AS Currency,
		|	(RoomRateDailyPrices.Price + ISNULL(RoomRateFormulas.BracketsConstant, 0)) * ISNULL(RoomRateFormulas.Multiplier, 1) + ISNULL(RoomRateFormulas.Constant, 0) AS Price
		|FROM
		|	InformationRegister.RoomRateDailyPrices AS RoomRateDailyPrices
		|		LEFT JOIN InformationRegister.CalendarDays.SliceLast(&qPriceCalculationDate, ) AS CalendarDays
		|		ON RoomRateDailyPrices.RoomRate.Calendar = CalendarDays.Calendar
		|			AND RoomRateDailyPrices.Period = CalendarDays.AccountingDate
		|		LEFT JOIN InformationRegister.CalendarDaysByRoomTypes.SliceLast(&qPriceCalculationDate, ) AS CalendarDaysByRoomTypes
		|		ON RoomRateDailyPrices.RoomRate.Calendar = CalendarDaysByRoomTypes.Calendar
		|			AND RoomRateDailyPrices.Period = CalendarDaysByRoomTypes.AccountingDate
		|			AND RoomRateDailyPrices.RoomType = CalendarDaysByRoomTypes.RoomType
		|		LEFT JOIN RoomRateFormulas AS RoomRateFormulas
		|		ON RoomRateFormulas.RoomRate = &qRoomRate
		|			AND RoomRateDailyPrices.Hotel = RoomRateFormulas.Hotel
		|			AND (NOT RoomRateFormulas.IsFormula
		|				OR RoomRateFormulas.IsFormula
		|					AND RoomRateDailyPrices.RoomType = RoomRateFormulas.RoomType
		|					AND RoomRateDailyPrices.ClientType = &qClientType
		|					AND RoomRateDailyPrices.AccommodationType = RoomRateFormulas.AccommodationType
		|					AND (CalendarDaysByRoomTypes.CalendarDayType = RoomRateFormulas.CalendarDayType
		|							AND NOT CalendarDaysByRoomTypes.CalendarDayType IS NULL
		|							AND CalendarDaysByRoomTypes.CalendarDayType <> VALUE(Catalog.CalendarDayTypes.EmptyRef)
		|						OR CalendarDays.CalendarDayType = RoomRateFormulas.CalendarDayType
		|							AND NOT CalendarDays.CalendarDayType IS NULL
		|							AND (CalendarDaysByRoomTypes.CalendarDayType IS NULL OR CalendarDaysByRoomTypes.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef))
		|						OR RoomRateFormulas.CalendarDayType = VALUE(Catalog.CalendarDayTypes.EmptyRef)))
		|			AND (RoomRateFormulas.BasedOnPriceTag = VALUE(Catalog.PriceTags.EmptyRef)
		|				OR RoomRateDailyPrices.PriceTag = RoomRateFormulas.BasedOnPriceTag
		|					AND RoomRateFormulas.BasedOnPriceTag <> VALUE(Catalog.PriceTags.EmptyRef))
		|WHERE
		|	RoomRateDailyPrices.Hotel = &qHotel
		|	AND RoomRateDailyPrices.RoomRate = &qRoomRateInCache
		|	AND RoomRateDailyPrices.ClientType = &qClientType
		|	AND RoomRateDailyPrices.PriceTag IN(&qPriceTagList)
		|	AND RoomRateDailyPrices.RoomType = &qRoomType
		|	AND RoomRateDailyPrices.AccommodationType = &qAccommodationType
		|	AND RoomRateDailyPrices.Period >= &qPeriodFrom
		|	AND RoomRateDailyPrices.Period <= &qPeriodTo
		|
		|ORDER BY
		|	Period";
		vQuery.SetParameter("qAccommodationType", vMinPriceAccType);
		vQuery.SetParameter("qClientType", Catalogs.ClientTypes.EmptyRef());
		vQuery.SetParameter("qHotel", vHotel);
		vQuery.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom));
		vQuery.SetParameter("qPeriodTo", EndOfDay(pPeriodTo));
		vQuery.SetParameter("qPriceTagList", vPriceTagsList);
		vQuery.SetParameter("qRoomRate", vMinPriceRate);
		If ValueIsFilled(vMinPriceRate) Then
			vQuery.SetParameter("qRoomRateInCache", ?(ValueIsFilled(vMinPriceRate.BasedOnRoomRate), vMinPriceRate.BasedOnRoomRate, vMinPriceRate));
		Else
			vQuery.SetParameter("qRoomRateInCache", Catalogs.RoomRates.EmptyRef());
		EndIf;
		vQuery.SetParameter("qRoomType", vMinPriceRoomType);
		vQuery.SetParameter("qPriceCalculationDate", CurrentSessionDate());
		
		vPrices = vQuery.Execute().Unload();
	EndIf;
	// Add columns with hotel and room type external codes
	vBalances.Columns.Add("ExtHotelCode", cmGetStringTypeDescription());
	vBalances.Columns.Add("ExtRoomTypeCode", cmGetStringTypeDescription());
