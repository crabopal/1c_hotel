EndFunction // cmGetReturnByExternalSystemCode

// -----------------------------------------------------------------------------
// Description: Writes external payment to the external reservation folio 
// Parameters: External reservation code, External guest group code, External client 
//             code, Payer name, Payment method, Payment amount (number), Payment 
//             currency, Payment section,  Hotel code, External system code, Credit \
//             card processing reference number, Credit card processing authorisation 
//             code, Remarks as string, Output type: XDTO ErrorDescription object 
//             or string in CSV format
// Return value: XDTO ErrorDescription, Type - String or object or CSV string
// -----------------------------------------------------------------------------
Function cmWritePaymentExternalFOSystem(pHotelCode="", pPayerName, pPaymentDate = Undefined, pExternalSystemCode, 
										pCard, pFolioNumber, pRoom, pPaymentMethod, pCurrencyCode, pSum, pRemarks, 
										pPaymentExternalCode = "",	pOutputType = "CSV", pPaymentSectionCode = "", 
										pPOSCode = "", pOrderNumber = "", pAccountingDate = Undefined, pOrderRef = Undefined) Export  
	vLogFuncName = NStr("en='Write external POS system payment'; de='Write external POS system payment'; ru='Записать внешний платеж из POS системы'");
	WriteLogEvent(vLogFuncName, EventLogLevel.Information, , , 
	              NStr("en='External system code: '; de='External system code: '; ru='Код внешней системы: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Folio number: '; de='Folio number: '; ru='Номер фолио: '") + pFolioNumber + Chars.LF +
				  NStr("en='Payer name: '; de='Payer name: '; ru='Плательщик: '") + pPayerName + Chars.LF +
				  NStr("en='Room number: '; de='Room number: '; ru='Номер комнаты: '") + pRoom + Chars.LF +
	              NStr("en='Hotel code: '; de='Hotel code: '; ru='Код гостиницы: '") + pHotelCode + Chars.LF + 
	              NStr("en='Card client code: '; de='Card client code: '; ru='Код карты клиента: '") + pCard + Chars.LF + 
	              NStr("en='Payment method code: '; de='Payment method code: '; ru='Код способа оплаты: '") + pPaymentMethod + Chars.LF + 
	              NStr("en='Remarks: '; de='Remarks: '; ru='Примечания: '") + pRemarks + Chars.LF + 
	              NStr("en='Currency code: '; de='Currency code: '; ru='Код валюты: '") + pCurrencyCode + Chars.LF + 
	              NStr("en='Payment date: '; de='Payment date: '; ru='Дата платежа: '") + pPaymentDate + Chars.LF + 
	              NStr("en='Accounting date: '; de='Accounting date: '; ru='Учетная дата: '") + pAccountingDate + Chars.LF + 
	              NStr("en='Payment external code: '; de='Payment external code: '; ru='Код платежа во внешней системе: '") + pPaymentExternalCode + Chars.LF + 
	              NStr("en='Payment POS code: '; de='Payment POS code: '; ru='Код POS системы: '") + pPOSCode + Chars.LF + 
	              NStr("en='Order number: '; de='Order number: '; ru='Номер заказа: '") + pOrderNumber + Chars.LF + 
	              NStr("en='Payment section: '; de='Payment section: '; ru='Код кассовой секции: '") + pPaymentSectionCode + Chars.LF + 
	              NStr("en='Payment amount: '; de='Payment amount: '; ru='Сумма платежа: '") + Format(pSum, "ND=17; NFD=2; NZ="));
	Try
		// Initialize error description
		vErrorDescription = "";
		// Try to find hotel by name or code
		vHotel = SessionParameters.CurrentHotel;
		If Not IsBlankString(pHotelCode) Then
			vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
		EndIf;
		
		// Get currency by code
		vCurrency = Catalogs.Currencies.EmptyRef();
		If Not IsBlankString(pCurrencyCode) Then
			vCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", pCurrencyCode);
		EndIf;
					
		// Try to find payment method
		vPaymentMethod = Catalogs.PaymentMethods.EmptyRef();
		If Not IsBlankString(pPaymentMethod) Then
			vPaymentMethod = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentMethods", pPaymentMethod);
		EndIf;
		
		// Try to find payment section
		vPaymentSection = Catalogs.PaymentSections.EmptyRef();
		If TrimAll(pPaymentSectionCode) <> "" Then
			vPaymentSection = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentSections", TrimAll(pPaymentSectionCode));
			If Not ValueIsFilled(vPaymentSection) And cmIsNumber(pPaymentSectionCode) And String(pPaymentSectionCode) <> "0" Then
				vPaymentSection = Catalogs.PaymentSections.FindByCode(Number(pPaymentSectionCode));
			EndIf;
		EndIf;
		If ValueIsFilled(vHotel) And Not ValueIsFilled(vPaymentSection) Then
			vPaymentSection = vHotel.PaymentSectionForAdvance;
		EndIf;
		vPaymentObj = Undefined;
		
		// Check parameters
		If pSum = 0 And IsBlankString(pPaymentExternalCode) Then
			Raise NStr("en='Payment sum should be filled!'; de='Payment sum should be filled!'; ru='Сумма платежа должна быть указана!'");
		ElsIf Not ValueIsFilled(vHotel) Then
			Raise NStr("en='Hotel should be specified!'; de='Hotel should be specified!'; ru='Гостиница должна быть указана!'");
		ElsIf Not ValueIsFilled(vCurrency) Then
			Raise NStr("en='Payment curency should be specified!'; de='Payment curency should be specified!'; ru='Валюта платежа должна быть указана!'");
		ElsIf Not ValueIsFilled(vPaymentMethod) Then
			Raise NStr("en='Payment method should be choosen!'; de='Payment method should be choosen!'; ru='Способ оплаты должен быть указан!'");
		EndIf;
		
		// If it's technicat pay mathod used - nothing has to be done
		If vPaymentMethod.IsCloseToTheRoom Or vPaymentMethod.IsCloseToTheFolio Then
			Return "";
		EndIf;
		// Find client card and write payment to folio
		If ValueIsFilled(pFolioNumber) Then // Write payment by folio
			// Get folio reference by folio number
			vFolioNumber = cmGetDocumentNumberFromPresentation(pFolioNumber, vHotel);
			vFolio = Documents.Folio.FindByNumber(vFolioNumber);
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Payment folio was not found!'; de='Payment folio was not found!'; ru='Не найден лицевой счет!'");
			EndIf;
			
			WriteLogEvent(vLogFuncName, EventLogLevel.Information, vFolio.Metadata(), vFolio, NStr("en='Folio is choosen...'; de='Folio is choosen...'; ru='Назначен лицевой счет...'"));
			
			If vFolio.DeletionMark Then      
				vErr = NStr("en='Attempt to write payment to the marked for deletion folio! Operation is canceled.'; 
							|de='Attempt to write payment to the marked for deletion folio! Operation is canceled.'; 
						 	|ru='Попытка выполнить начисление на помеченный на удаление счет! Операция прервана.'");
				WriteLogEvent(vLogFuncName, EventLogLevel.Warning, , , vErr); 
								
				Raise vErr;
			EndIf;
		ElsIf ValueIsFilled(pCard) Then
			// Get card reference by card identifier
			vCard = cmGetClientIdentificationCardById(pCard);
			If Not ValueIsFilled(vCard) Then  
				vErr = NStr("en='Client identification card was not found!'; de='Client identification card was not found!'; ru='Не найдена карта клиента!'");
				WriteLogEvent(vLogFuncName, EventLogLevel.Warning, , , vErr);
				Raise vErr;
			EndIf;
			
			// Run query to get folios to charge to
			vFolio = vCard.Folio;
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en = 'Payment folio was not found!'; de = 'Payment folio was not found!'; ru = 'Не найден лицевой счет!'");
			EndIf;
			If vFolio.DeletionMark Then    
				vErr = NStr("en = 'Attempt to write payment to the marked for deletion folio! Operation is canceled.'; 
							|de = 'Attempt to write payment to the folio marked for deletion! Operation is canceled.'; 
							|ru = 'Попытка выполнить платеж на помеченный на удаление счет! Операция прервана.'");;
				WriteLogEvent(vLogFuncName, EventLogLevel.Warning, , , vErr);
				Raise vErr;
			EndIf;
			
			WriteLogEvent(vLogFuncName, EventLogLevel.Information, vFolio.Metadata(), vFolio, NStr("en='Folio is choosen...'; de='Folio is choosen...'; ru='Назначен лицевой счет...'"));
		// Write payment by room
		ElsIf ValueIsFilled(pRoom) Then
			// Get room by room code
			vRoom = Catalogs.Rooms.EmptyRef();
			If Not IsBlankString(pRoom) Then
				vRoom = cmGetRoomByCode(pRoom, pHotelCode, pExternalSystemCode);
			EndIf;
			
			If Not ValueIsFilled(vRoom) Then
				Raise NStr("en='Room was not found!'; de='Room was not found!'; ru='Не верный номер комнаты'");
			EndIf;
			
			WriteLogEvent(vLogFuncName, EventLogLevel.Information, vRoom.Metadata(), vRoom, NStr("en='Room '; de='Zimmer '; ru='Комната '") + TrimAll(pRoom));
			
			// Run query to get folios to charge to			  
			vClient = Catalogs.Clients.EmptyRef();
			If Not IsBlankString(pPayerName) Then
				vClient = Catalogs.Clients.FindByCode(pPayerName, False);
			EndIf;
			
			WriteLogEvent(vLogFuncName, EventLogLevel.Information, vClient.Metadata(), vRoom, NStr("en='Client '; de='Kunde '; ru='Клиент '") + TrimAll(vClient));
			
			If pPaymentDate = Undefined Then
				vPaymentDate = CurrentSessionDate();
			Else
				vPaymentDate = pPaymentDate;
			EndIf;	
			vFolios = cmGetFoliosToChargeRoomService(vRoom, vPaymentDate, vClient, "");
			If vFolios.Count() > 0 Then
				vFolio = vFolios.Get(0).Folio;
			EndIf;
			
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Payment folio was not found!'; de='Payment folio was not found!'; ru='Не найден лицевой счет!'");
			EndIf;
			
			If vFolio.DeletionMark Then    
				vErr = NStr("en = 'Attempt to charge to the marked for deletion folio! Operation is canceled.'; 
							|de = 'Attempt to charge to the marked for deletion folio! Operation is canceled.'; 
							|ru = 'Попытка выполнить платеж на помеченный на удаление счет! Операция прервана.'");
				WriteLogEvent(vLogFuncName, EventLogLevel.Warning, , , vErr);
				Raise vErr;
			EndIf;
		EndIf;
		// Create payment for the folio being found
		If Not IsBlankString(pPaymentExternalCode) Then
			vPaymentRef = cmGetPaymentByExternalSystemCode(vHotel, pPaymentExternalCode);
			If ValueIsFilled(vPaymentRef) Then
				vPaymentObj = vPaymentRef.GetObject();
			EndIf;
		EndIf;
		If vPaymentObj = Undefined Then
			vPaymentObj = Documents.Payment.CreateDocument();
			vPaymentObj.AdditionalProperties.Insert("AdvanceMode", False);
			vPaymentObj.Hotel = vHotel;
			vPaymentObj.Fill(vFolio);
			If pPaymentDate <> Undefined Then
				vPaymentObj.Date = pPaymentDate;
			EndIf;
			If pAccountingDate <> Undefined Then
				vPaymentObj.AccountingDate = pAccountingDate;
			EndIf;
		EndIf;
		If Not IsBlankString(pPaymentExternalCode) Then
			vPaymentObj.Remarks = pPaymentExternalCode;
		ElsIf Not IsBlankString(pPayerName) Then
			vPaymentObj.Remarks = pPayerName;
		EndIf;
		vPaymentObj.PaymentCurrency = vCurrency;
		vPaymentObj.PaymentMethod = vPaymentMethod;
		// Invoice
		If ValueIsFilled(vFolio.GuestGroup) Then
			vInvoices = vFolio.GuestGroup.GetObject().pmGetInvoices(vFolio.Customer, vFolio.Contract);
			For Each vInvoicesRow In vInvoices Do
				If pSum > 0 And vInvoicesRow.Balance > 0 Then
					vPaymentObj.Invoice = vInvoices.Get(0).Invoice;
					Break;
				ElsIf pSum < 0 And vInvoicesRow.Balance = 0 Then
					vPaymentObj.Invoice = vInvoices.Get(0).Invoice;
					Break;
				EndIf;
			EndDo;
		EndIf;
		// Payment sections
		If ValueIsFilled(vPaymentObj.Hotel) And vPaymentObj.Hotel.SplitFolioBalanceByPaymentSections Then
			vPaymentObj.PaymentSections.Clear();
			vPSRow = vPaymentObj.PaymentSections.Add();
			vPSRow.PaymentSection = vPaymentSection;
			vPSRow.Sum = pSum;
			vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
			If ValueIsFilled(vPaymentSection) And ValueIsFilled(vPaymentSection.VATRate) Then
				vPSRow.VATRate = vPaymentSection.VATRate;
			Else
				vPSRow.VATRate = vPaymentObj.VATRate;
			EndIf;
			vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vPaymentObj.Date);
			vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
			vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vPaymentObj.Date);
			vPaymentObj.pmCalculateTotalsByPaymentSections();
		ElsIf ValueIsFilled(vPaymentObj.Hotel) And vPaymentObj.Hotel.SplitFolioBalanceByServicesAndPrices Then
			vRestOfSum = pSum;
			For Each vPSRow In vPaymentObj.PaymentSections Do
				If vRestOfSum > 0 Then
					If vRestOfSum >= vPSRow.Sum Then
						vRestOfSum = vRestOfSum - vPSRow.Sum;
					Else
						vPSRow.Sum = vRestOfSum;
						vRestOfSum = 0;
					EndIf;
					vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
					vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vPaymentObj.Date);
					vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
					vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vPaymentObj.Date);
				Else
					vPSRow.Sum = 0;
					vPSRow.VATSum = 0;
					vPSRow.SumInFolioCurrency = 0;
					vPSRow.VATSumInFolioCurrency = 0;
				EndIf;
			EndDo;
			If vRestOfSum > 0 Then
				vPSRow = vPaymentObj.PaymentSections.Add();
				vPSRow.PaymentSection = vPaymentSection;
				vPSRow.ChequeService = Catalogs.Services.EmptyRef();
				vPSRow.ChequeServicePrice = vRestOfSum;
				vPSRow.ChequeServiceQuantity = 1;
				vPSRow.Sum = vRestOfSum;
				vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
				If ValueIsFilled(vPaymentSection) And ValueIsFilled(vPaymentSection.VATRate) Then
					vPSRow.VATRate = vPaymentSection.VATRate;
				Else
					vPSRow.VATRate = vPaymentObj.VATRate;
				EndIf;
				vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vPaymentObj.Date);
				vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.FolioCurrency, vPaymentObj.FolioCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
				vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vPaymentObj.Date);
			EndIf;
			vPaymentObj.pmCalculateTotalsByPaymentSections();
		Else
			vPaymentObj.PaymentSection = vPaymentSection;
			vPaymentObj.Sum = pSum;
			If TypeOf(vPaymentObj) = Type("DocumentObject.Payment") Then
				vPaymentObj.pmRecalculateSums();
			ElsIf TypeOf(vPaymentObj) = Type("DocumentObject.CustomerPayment") Then
				vPaymentObj.SumInAccountingCurrency = Round(cmConvertCurrencies(vPaymentObj.Sum, vPaymentObj.PaymentCurrency, vPaymentObj.PaymentCurrencyExchangeRate, vPaymentObj.AccountingCurrency, vPaymentObj.AccountingCurrencyExchangeRate, vPaymentObj.ExchangeRateDate, vPaymentObj.Hotel), 2);
			EndIf;
		EndIf;
		// Reference and authorization codes
		vPaymentObj.ReferenceNumber = "";
		vPaymentObj.AuthorizationCode = "";
		// Payment slip text
		vPaymentObj.SlipText = "";
		// External system payment code
		vPaymentObj.ExternalCode = TrimR(pPaymentExternalCode);
		vPaymentObj.OrderNumber = TrimR(pOrderNumber);
		vPaymentObj.Order = pOrderRef;
		// Set customer as payer
		If ValueIsFilled(vPaymentObj.AccountingCustomer) And ValueIsFilled(vPaymentObj.PaymentMethod) And vPaymentObj.PaymentMethod.IsByBankTransfer Then
			If ValueIsFilled(vPaymentObj.Hotel) And vPaymentObj.AccountingCustomer <> vPaymentObj.Hotel.IndividualsCustomer Then
				vPaymentObj.Payer = vPaymentObj.AccountingCustomer;
			EndIf;
		EndIf;
		
		// Certificates OR Bunuses requiere DiscountCard
		If ValueIsFilled(vPaymentObj.PaymentMethod) And (vPaymentObj.PaymentMethod.IsByGiftCertificate Or vPaymentObj.PaymentMethod.IsByBonuses) Then
			vPaymentObj.DiscountCard = cmGetDiscountCardById(pCard);
		EndIf;
		
		// Cash register
		vCashRegister = Undefined;
		If ValueIsFilled(vPaymentObj.PaymentMethod) And vPaymentObj.PaymentMethod.BookByCashRegister Then
			If Not ValueIsFilled(vCashRegister) And pPOSCode <> Undefined And Not IsBlankString(pPOSCode) Then
				vCashRegister = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "CashRegisters", pPOSCode);
			EndIf;
			If Not ValueIsFilled(vCashRegister) And pPaymentMethod <> Undefined And Not IsBlankString(pPaymentMethod) Then
				vCashRegister = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "CashRegisters", pPaymentMethod);
			EndIf;
			If Not ValueIsFilled(vCashRegister) Then
				vCashRegister = GetPaymentCashRegister(vPaymentObj.Company, vPaymentMethod, vPaymentObj.Hotel);
			EndIf;
			If ValueIsFilled(vCashRegister) Then
				vPaymentObj.CashRegister = vCashRegister;
			EndIf;
		EndIf;
		vPaymentObj.pmFillContactsToOFD();
		vPaymentObj.Write();
		// Post payment
		vPaymentObj.Write(DocumentWriteMode.Posting);
		// Create online cheque
		If vPaymentObj <> Undefined And vPaymentObj.Posted And ValueIsFilled(vPaymentObj.CashRegister) Then
			If tcCashRegisters.GetChequeAttributes(vPaymentObj.Ref) = Undefined Then   
				vPaymentFuncParams = New Array;
				vPaymentFuncParams.Add(vPaymentObj.Ref);
				vPaymentFuncParams.Add(vPaymentObj.Hotel.ReservationDepartment);
				
				AsyncCalls.StartBackgroundJob("tcCashRegisters.CreateAndSendOnlineCheque", vPaymentFuncParams);
			EndIf;
		EndIf;
		
		// Build return string
		vRetStr = """" + TrimAll(vPaymentObj.Number) + """" + "," + """" + """";

		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			Return "";
		EndIf;
	Except
		vErrorDescription = ErrorDescription();
		// Write log event
		WriteLogEvent(vLogFuncName, EventLogLevel.Error, , , NStr("en='Error description: '; de='Error description: '; ru='Описание ошибки: '") + vErrorDescription);
					  
		// Build return string
		vRetStr = """" + """" + "," + """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			Return Left(vErrorDescription, 4096);
		EndIf;
	EndTry;
EndFunction // cmWriteExternalPaymentFOSystem

// -----------------------------------------------------------------------------
// Description: Writes external return to the external reservation folio 
// Parameters: External reservation code, External guest group code, External client 
//             code, Payer name, Payment method, Payment amount (number), Payment 
//             currency, Payment section,  Hotel code, External system code, Credit \
//             card processing reference number, Credit card processing authorisation 
//             code, Remarks as string, Output type: XDTO ErrorDescription object 
//             or string in CSV format
// Return value: XDTO ErrorDescription, Type - String or object or CSV string
// -----------------------------------------------------------------------------
Function cmWriteReturnExternalFOSystem(pHotelCode="", pPayerName, pPaymentDate = Undefined, pExternalSystemCode, 
										pCard, pFolioNumber, pRoom, pPaymentMethod, pCurrencyCode, pSum, pRemarks, 
										pPaymentExternalCode = "",	pOutputType = "CSV", pPaymentSectionCode = "", 
										pPOSCode = "", pOrderNumber = "", pAccountingDate = Undefined, pOrderRef = Undefined) Export
	WriteLogEvent(NStr("en='Write external POS system return'; de='Write external POS system return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: '; de='External system code: '; ru='Код внешней системы: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Folio number: '; de='Folio number: '; ru='Номер фолио: '") + pFolioNumber + Chars.LF +
				  NStr("en='Payer name: '; de='Payer name: '; ru='Плательщик: '") + pPayerName + Chars.LF +
				  NStr("en='Room number: '; de='Room number: '; ru='Номер комнаты: '") + pRoom + Chars.LF +
	              NStr("en='Hotel code: '; de='Hotel code: '; ru='Код гостиницы: '") + pHotelCode + Chars.LF + 
	              NStr("en='Card client code: '; de='Card client code: '; ru='Код карты клиента: '") + pCard + Chars.LF + 
	              NStr("en='Payment method code: '; de='Payment method code: '; ru='Код способа оплаты: '") + pPaymentMethod + Chars.LF + 
	              NStr("en='Remarks: '; de='Remarks: '; ru='Примечания: '") + pRemarks + Chars.LF + 
	              NStr("en='Currency code: '; de='Currency code: '; ru='Код валюты: '") + pCurrencyCode + Chars.LF + 
	              NStr("en='Payment date: '; de='Payment date: '; ru='Дата платежа: '") + pPaymentDate + Chars.LF + 
	              NStr("en='Accounting date: '; de='Accounting date: '; ru='Учетная дата: '") + pAccountingDate + Chars.LF + 
	              NStr("en='Payment external code: '; de='Payment external code: '; ru='Код платежа во внешней системе: '") + pPaymentExternalCode + Chars.LF + 
	              NStr("en='Payment POS code: '; de='Payment POS code: '; ru='Код POS системы: '") + pPOSCode + Chars.LF + 
	              NStr("en='Order number: '; de='Order number: '; ru='Номер заказа: '") + pOrderNumber + Chars.LF + 
	              NStr("en='Payment section: '; de='Payment section: '; ru='Код кассовой секции: '") + pPaymentSectionCode + Chars.LF + 
	              NStr("en='Payment amount: '; de='Payment amount: '; ru='Сумма платежа: '") + Format(pSum, "ND=17; NFD=2; NZ="));
	Try
		// Initialize error description
		vErrorDescription = "";
		// Try to find hotel by name or code
		vHotel = SessionParameters.CurrentHotel;
		If Not IsBlankString(pHotelCode) Then
			vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
		EndIf;
		// Get currency by code
		vCurrency = Catalogs.Currencies.EmptyRef();
		If Not IsBlankString(pCurrencyCode) Then
			vCurrency = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Currencies", pCurrencyCode);
		EndIf;
					
		// Try to find payment method
		vPaymentMethod = Catalogs.PaymentMethods.EmptyRef();
		If Not IsBlankString(pPaymentMethod) Then
			vPaymentMethod = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentMethods", pPaymentMethod);
		EndIf;
		
		// Try to find payment section
		vPaymentSection = Catalogs.PaymentSections.EmptyRef();
		If TrimAll(pPaymentSectionCode) <> "" Then
			vPaymentSection = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "PaymentSections", TrimAll(pPaymentSectionCode));
			If Not ValueIsFilled(vPaymentSection) And cmIsNumber(pPaymentSectionCode) And String(pPaymentSectionCode) <> "0" Then
				vPaymentSection = Catalogs.PaymentSections.FindByCode(Number(pPaymentSectionCode));
			EndIf;
		EndIf;
		If ValueIsFilled(vHotel) And Not ValueIsFilled(vPaymentSection) Then
			vPaymentSection = vHotel.PaymentSectionForAdvance;
		EndIf;
		vReturnObj = Undefined;
		
		// Check parameters
		If pSum = 0 And IsBlankString(pPaymentExternalCode) Then
			Raise NStr("en='Return sum should be filled!'; de='Return sum should be filled!'; ru='Сумма возврата должна быть указана!'");
		ElsIf Not ValueIsFilled(vHotel) Then
			Raise NStr("en='Hotel should be specified!'; de='Hotel should be specified!'; ru='Гостиница должна быть указана!'");
		ElsIf Not ValueIsFilled(vCurrency) Then
			Raise NStr("en='Return curency should be specified!'; de='Return curency should be specified!'; ru='Валюта возврата должна быть указана!'");
		ElsIf Not ValueIsFilled(vPaymentMethod) Then
			Raise NStr("en='Payment method should be choosen!'; de='Payment method should be choosen!'; ru='Способ оплаты должен быть указан!'");
		EndIf;
		
		// If it's technicat pay mathod used - nothing has to be done
		If vPaymentMethod.IsCloseToTheRoom Or vPaymentMethod.IsCloseToTheFolio Then
			Return "";
		EndIf;
		// Find client card and write payment to folio
		If ValueIsFilled(pFolioNumber) Then // Write payment by folio
			// Get folio reference by folio number
			vFolioNumber = cmGetDocumentNumberFromPresentation(pFolioNumber, vHotel);
			vFolio = Documents.Folio.FindByNumber(vFolioNumber);
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Payment folio was not found!'; de='Payment folio was not found!'; ru='Не найден лицевой счет!'");
			EndIf;
			WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Information, vFolio.Metadata(), vFolio, 
			NStr("en='Folio is choosen...'; de='Folio is choosen...'; ru='Назначен лицевой счет...'"));
			
			If vFolio.DeletionMark Then
				WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Warning, , , 
				NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; ru='Попытка выполнить возврат на помеченный на удаление счет! Операция прервана.'"));
				Raise NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; ru='Попытка выполнить возврат на помеченный на удаление счет! Операция прервана.'");
			EndIf;
		ElsIf ValueIsFilled(pCard) Then
			// Get card reference by card identifier
			vCard = cmGetClientIdentificationCardById(pCard);
			If Not ValueIsFilled(vCard) Then
				WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Warning, , , 
				NStr("en='Client identification card was not found!'; de='Client identification card was not found!'; ru='Не найдена карта клиента!'"));
				Raise NStr("en='Client identification card is not found!'; de='Client identification card is not found!'; ru='Не найдена карта клиента!'");
			EndIf;
			
			// Run query to get folios to charge to
			vFolio = vCard.Folio;
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Return folio is not found!'; de='Return folio is not found!'; ru='Не найден лицевой счет!'");
			EndIf;
			If vFolio.DeletionMark Then
				WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний Возврат из POS системы'"), EventLogLevel.Warning, , , 
				NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; ru='Попытка выполнить Возврат на помеченный на удаление счет! Операция прервана.'"));
				Raise NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the folio marked for deletion! Operation is canceled.'; ru='Попытка выполнить возврат на помеченный на удаление счет! Операция прервана.'");
			EndIf;
			
			WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Information, vFolio.Metadata(), vFolio, 
			NStr("en='Folio is choosen...'; de='Folio is choosen...'; ru='Назначен лицевой счет...'"));
		// Write payment by room
		ElsIf ValueIsFilled(pRoom) Then
			// Get room by room code
			vRoom = Catalogs.Rooms.EmptyRef();
			If Not IsBlankString(pRoom) Then
				vRoom = cmGetRoomByCode(pRoom, pHotelCode, pExternalSystemCode);
			EndIf;
			
			If Not ValueIsFilled(vRoom) Then
				Raise NStr("en='Room was not found!'; de='Room was not found!'; ru='Не верный номер комнаты'");
			EndIf;
			
			WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Information, vRoom.Metadata(), vRoom, NStr("en='Room '; de='Zimmer '; ru='Комната '") + TrimAll(pRoom));
			
			// Run query to get folios to charge to			  
			vClient = Catalogs.Clients.EmptyRef();
			If Not IsBlankString(pPayerName) Then
				vClient = Catalogs.Clients.FindByCode(pPayerName, False);
			EndIf;
			WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний Возврат из POS системы'"), EventLogLevel.Information, vClient.Metadata(), vRoom, NStr("en='Client '; de='Kunde '; ru='Клиент '") + TrimAll(vClient));
			
			vFolios = cmGetFoliosToChargeRoomService(vRoom, ?(pPaymentDate = Undefined, CurrentSessionDate(), pPaymentDate), vClient, "");
			If vFolios.Count() > 0 Then
				vFolio = vFolios.Get(0).Folio;
			EndIf;
			
			If Not ValueIsFilled(vFolio) Then
				Raise NStr("en='Return folio was not found!'; de='Return folio was not found!'; ru='Не найден лицевой счет!'");
			EndIf;
			
			If vFolio.DeletionMark Then
				WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Warning, , , 
				NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; ru='Попытка выполнить возврат на помеченный на удаление счет! Операция прервана.'"));
				Raise NStr("en='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; de='Attempt to write Return to the marked for deletion folio! Operation is canceled.'; ru='Попытка выполнить возврат на помеченный на удаление счет! Операция прервана.'");
			EndIf;
		EndIf;
		// Create payment for the folio being found
		If Not IsBlankString(pPaymentExternalCode) Then
			vReturnRef = cmGetReturnByExternalSystemCode(vHotel, pPaymentExternalCode);
			If ValueIsFilled(vReturnRef) Then
				vReturnObj = vReturnRef.GetObject();
			EndIf;
		EndIf;
		If vReturnObj = Undefined Then
			vReturnObj = Documents.Return.CreateDocument();
			vReturnObj.AdditionalProperties.Insert("AdvanceMode", False);
			vReturnObj.Hotel = vHotel;
			vReturnObj.Fill(vFolio);
			If pPaymentDate <> Undefined Then
				vReturnObj.Date = pPaymentDate;
			EndIf;
			If pAccountingDate <> Undefined Then
				vReturnObj.AccountingDate = pAccountingDate;
			EndIf;
		EndIf;

		// Remarks
		vReturnObj.Remarks = pRemarks;
		If IsBlankString(vReturnObj.Remarks) Then
			If Not IsBlankString(pPaymentExternalCode) Then
				vReturnObj.Remarks = pPaymentExternalCode;
			ElsIf Not IsBlankString(pPayerName) Then
				vReturnObj.Remarks = pPayerName;
			EndIf;
		EndIf;
		
		// Currency and payment method
		vReturnObj.PaymentCurrency = vCurrency;
		vReturnObj.PaymentMethod = vPaymentMethod;
		
		// Invoice
		If ValueIsFilled(vFolio.GuestGroup) Then
			vInvoices = vFolio.GuestGroup.GetObject().pmGetInvoices(vFolio.Customer, vFolio.Contract);
			For Each vInvoicesRow In vInvoices Do
				If pSum > 0 And vInvoicesRow.Balance > 0 Then
					vReturnObj.Invoice = vInvoices.Get(0).Invoice;
					Break;
				ElsIf pSum < 0 And vInvoicesRow.Balance = 0 Then
					vReturnObj.Invoice = vInvoices.Get(0).Invoice;
					Break;
				EndIf;
			EndDo;
		EndIf;
		
		// Payment sections
		If ValueIsFilled(vReturnObj.Hotel) And vReturnObj.Hotel.SplitFolioBalanceByPaymentSections Then
			vReturnObj.PaymentSections.Clear();
			vPSRow = vReturnObj.PaymentSections.Add();
			vPSRow.PaymentSection = vPaymentSection;
			vPSRow.Sum = pSum;
			vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
			If ValueIsFilled(vPaymentSection) And ValueIsFilled(vPaymentSection.VATRate) Then
				vPSRow.VATRate = vPaymentSection.VATRate;
			Else
				vPSRow.VATRate = vReturnObj.VATRate;
			EndIf;
			vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vReturnObj.Date);
			vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
			vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vReturnObj.Date);
			vReturnObj.pmCalculateTotalsByPaymentSections();
		ElsIf ValueIsFilled(vReturnObj.Hotel) And vReturnObj.Hotel.SplitFolioBalanceByServicesAndPrices Then
			vRestOfSum = pSum;
			For Each vPSRow In vReturnObj.PaymentSections Do
				If vRestOfSum > 0 Then
					If vRestOfSum >= vPSRow.Sum Then
						vRestOfSum = vRestOfSum - vPSRow.Sum;
					Else
						vPSRow.Sum = vRestOfSum;
						vRestOfSum = 0;
					EndIf;
					vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
					vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vReturnObj.Date);
					vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
					vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vReturnObj.Date);
				Else
					vPSRow.Sum = 0;
					vPSRow.VATSum = 0;
					vPSRow.SumInFolioCurrency = 0;
					vPSRow.VATSumInFolioCurrency = 0;
				EndIf;
			EndDo;
			If vRestOfSum > 0 Then
				vPSRow = vReturnObj.PaymentSections.Add();
				vPSRow.PaymentSection = vPaymentSection;
				vPSRow.ChequeService = Catalogs.Services.EmptyRef();
				vPSRow.ChequeServicePrice = vRestOfSum;
				vPSRow.ChequeServiceQuantity = 1;
				vPSRow.Sum = vRestOfSum;
				vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
				If ValueIsFilled(vPaymentSection) And ValueIsFilled(vPaymentSection.VATRate) Then
					vPSRow.VATRate = vPaymentSection.VATRate;
				Else
					vPSRow.VATRate = vReturnObj.VATRate;
				EndIf;
				vPSRow.VATSum = cmCalculateVATSum(vPSRow.VATRate, vPSRow.Sum, vReturnObj.Date);
				vPSRow.SumInFolioCurrency = Round(cmConvertCurrencies(vPSRow.Sum, vReturnObj.PaymentCurrency, vReturnObj.PaymentCurrencyExchangeRate, vReturnObj.FolioCurrency, vReturnObj.FolioCurrencyExchangeRate, vReturnObj.ExchangeRateDate, vReturnObj.Hotel), 2);
				vPSRow.VATSumInFolioCurrency = cmCalculateVATSum(vPSRow.VATRate, vPSRow.SumInFolioCurrency, vReturnObj.Date);
			EndIf;
			vReturnObj.pmCalculateTotalsByPaymentSections();
		Else
			vReturnObj.PaymentSection = vPaymentSection;
			vReturnObj.Sum = pSum;
			If TypeOf(vReturnObj) = Type("DocumentObject.Return") Then
				vReturnObj.pmRecalculateSums();
			EndIf;
		EndIf;
		
		// Reference and authorization codes
		vReturnObj.ReferenceNumber = "";
		vReturnObj.AuthorizationCode = "";
		
		// Payment slip text
		vReturnObj.SlipText = "";

		// External system payment code
		vReturnObj.ExternalCode = TrimR(pPaymentExternalCode);
		vReturnObj.OrderNumber = TrimR(pOrderNumber);
		vReturnObj.Order = pOrderRef;
		
		// Set customer as payer
		If ValueIsFilled(vReturnObj.AccountingCustomer) And ValueIsFilled(vReturnObj.PaymentMethod) And vReturnObj.PaymentMethod.IsByBankTransfer Then
			If ValueIsFilled(vReturnObj.Hotel) And vReturnObj.AccountingCustomer <> vReturnObj.Hotel.IndividualsCustomer Then
				vReturnObj.Payer = vReturnObj.AccountingCustomer;
			EndIf;
		EndIf;
		
		// Certificates OR Bunuses requiere DiscountCard
		If ValueIsFilled(vReturnObj.PaymentMethod) And (vReturnObj.PaymentMethod.IsByGiftCertificate Or vReturnObj.PaymentMethod.IsByBonuses) Then
			vReturnObj.DiscountCard = cmGetDiscountCardById(pCard);
		EndIf;
		
		// Cash register
		vCashRegister = Undefined;
		If ValueIsFilled(vReturnObj.PaymentMethod) And vReturnObj.PaymentMethod.BookByCashRegister Then
			If Not ValueIsFilled(vCashRegister) And pPOSCode <> Undefined And Not IsBlankString(pPOSCode) Then
				vCashRegister = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "CashRegisters", pPOSCode);
			EndIf;
			If Not ValueIsFilled(vCashRegister) And pPaymentMethod <> Undefined And Not IsBlankString(pPaymentMethod) Then
				vCashRegister = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "CashRegisters", pPaymentMethod);
			EndIf;
			If Not ValueIsFilled(vCashRegister) Then
				vCashRegister = GetPaymentCashRegister(vReturnObj.Company, vPaymentMethod, vReturnObj.Hotel);
			EndIf;
			If ValueIsFilled(vCashRegister) Then
				vReturnObj.CashRegister = vCashRegister;
			EndIf;
		EndIf;
		vReturnObj.pmFillContactsToOFD();
		// Post return
		vReturnObj.Write(DocumentWriteMode.Posting);
		
		// Create online cheque
		If vReturnObj <> Undefined And vReturnObj.Posted And ValueIsFilled(vReturnObj.CashRegister) Then
			If tcCashRegisters.GetChequeAttributes(vReturnObj.Ref) = Undefined Then
				cmCreateAndSendOnlineCheque(vReturnObj.Ref, vReturnObj.Hotel.ReservationDepartment);
			EndIf;
		EndIf;
		
		// Build return string
		vRetStr = """" + TrimAll(vReturnObj.Number) + """" + "," + """" + """";

		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			Return "";
		EndIf;
	Except
		vErrorDescription = ErrorDescription();
		// Write log event
		WriteLogEvent(NStr("en='Write external POS system Return'; de='Write external POS system Return'; ru='Записать внешний возврат из POS системы'"), EventLogLevel.Error, , , 
					  NStr("en='Error description: '; de='Error description: '; ru='Описание ошибки: '") + ErrorDescription());
					  
		// Build return string
		vRetStr = """" + """" + "," + """" + vErrorDescription + """";
		// Return based on output type
		If pOutputType = "CSV" Then
			Return vRetStr;
		Else
			Return Left(vErrorDescription, 4096);
		EndIf;
	EndTry;
EndFunction // cmWriteExternalReturnOSystem

// -----------------------------------------------------------------------------
// Description: This procedure marks external payments for deletion for the given period
// Parameters: Period from, Period to, External system code, Hotel code, Company code
// Return value: None
// -----------------------------------------------------------------------------
Procedure cmClearExternalPayments(pPeriodFrom, pPeriodTo, pExternalSystemCode = "", pHotelCode = "", pCompanyCode = "") Export
	WriteLogEvent(NStr("en='Clear external payments';ru='Очистить платежи внешней системы';de='Zahlungen des externen Systems löschen'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Company code: ';ru='Код фирмы: ';de='Firmencode: '") + pCompanyCode + Chars.LF + 
	              NStr("en='Period from: ';ru='Дата и время начала периода: ';de='Datum und Zeit des Zeitraumbeginns: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Дата и время окончания периода: ';de='Datum und Zeit des Zeitraumendes: '") + pPeriodTo);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Try to find company
	vCompany = Catalogs.Companies.EmptyRef();
	If Not IsBlankString(pCompanyCode) Then
		vCompany = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "Companies", pCompanyCode);
	EndIf;
	// Do in one transaction
	BeginTransaction();
	// Run query to get payments
	vPaymentsQry = New Query();
	vPaymentsQry.Text = 
	"SELECT
	|	ExternalPayments.Ref AS Ref,
	|	ExternalPayments.Date AS Date
	|FROM
	|	(SELECT
	|		Payments.Ref AS Ref,
	|		Payments.Date AS Date
	|	FROM
	|		Document.Payment AS Payments
	|	WHERE
	|		Payments.Posted
	|		AND Payments.Date >= &qPeriodFrom
	|		AND Payments.Date <= &qPeriodTo
	|		AND Payments.Hotel = &qHotel
	|		AND (Payments.Company = &qCompany
	|				OR &qCompanyIsEmpty)
	|		AND Payments.ExternalCode > &qEmptyString
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		CustomerPayments.Ref,
	|		CustomerPayments.Date
	|	FROM
	|		Document.CustomerPayment AS CustomerPayments
	|	WHERE
	|		CustomerPayments.Posted
	|		AND CustomerPayments.Date >= &qPeriodFrom
	|		AND CustomerPayments.Date <= &qPeriodTo
	|		AND CustomerPayments.Hotel = &qHotel
	|		AND (CustomerPayments.Company = &qCompany
	|				OR &qCompanyIsEmpty)
	|		AND CustomerPayments.ExternalCode > &qEmptyString) AS ExternalPayments
	|
	|ORDER BY
	|	ExternalPayments.Date";
	vPaymentsQry.SetParameter("qPeriodFrom", pPeriodFrom);
	vPaymentsQry.SetParameter("qPeriodTo", pPeriodTo);
	vPaymentsQry.SetParameter("qHotel", vHotel);
	vPaymentsQry.SetParameter("qCompany", vCompany);
	vPaymentsQry.SetParameter("qCompanyIsEmpty", Not ValueIsFilled(vCompany));
	vPaymentsQry.SetParameter("qEmptyString", "");
	vPayments = vPaymentsQry.Execute().Unload();
	For Each vPaymentsRow In vPayments Do
		vPaymentObj = vPaymentsRow.Ref.GetObject();
		vPaymentObj.SetDeletionMark(True);
	EndDo;		
	// Commit transaction
	CommitTransaction();
	// Log success		
	WriteLogEvent(NStr("en='Clear external payments';ru='Очистить платежи внешней системы';de='Zahlungen des externen Systems löschen'"), EventLogLevel.Information, , , 
				  NStr("en='Cleared payments - ';ru='Помечено платежей - ';de='Zahlungen markiert - '") + vPayments.Count());
EndProcedure // cmClearExternalPayments

// -----------------------------------------------------------------------------
// Description: Returns value table with vacant hotel products active for the period
//              given
// Parameters: Hotel code, Room type code, Customer name, Contract name, Agent name, 
//             Room quota (allotment) code, Period from date, Period to date, Flags 
//             to defined what type of resources to return, External system code, 
//             Language code, Output type: XDTO oject, CSV string or XML, XML Writer to
//             write XML data to
// Return value: XDTO VacantHotelProducts object or CSV string or XML data
// -----------------------------------------------------------------------------
Function cmGetVacantCheckInPeriods(pHotelCode, pRoomRateCode, pRoomTypeCode, pCustomerName, pContractName, pAgentName, 
                                   pRoomQuotaCode, pPeriodFrom, pPeriodTo, 
                                   pExternalSystemCode, pLanguageCode = "RU", pOutputType = "CSV", pXMLWriter = Undefined) Export
	WriteLogEvent(NStr("en='Get vacant allowed check-in periods';ru='Получить остатки по периодам заездов';de='Restbestände nach Anreisezeiträumen erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Room rate code: ';ru='Код тарифа: ';de='Tarifcode: '") + pRoomRateCode + Chars.LF + 
	              NStr("en='Room type code: ';ru='Код типа номера: ';de='Zimmertypcode: '") + pRoomTypeCode + Chars.LF + 
	              NStr("en='Customer name: ';ru='Название контрагента: ';de='Bezeichnung des Partners: '") + pCustomerName + Chars.LF + 
	              NStr("en='Contract name: ';ru='Название договора: ';de='Bezeichnung des Vertrags: '") + pContractName + Chars.LF + 
	              NStr("en='Agent name: ';ru='Название агента: ';de='Bezeichnung des Vertreters: '") + pAgentName + Chars.LF + 
	              NStr("en='Allotment code: ';ru='Код квоты номеров: ';de='Zimmerquotencode: '") + pRoomQuotaCode + Chars.LF + 
	              NStr("en='Period from: ';ru='Начало периода: ';de='Zeitraumbeginn: '") + pPeriodFrom + Chars.LF + 
	              NStr("en='Period to: ';ru='Конец периода: ';de='Zeitraumende: '") + pPeriodTo);  
	// Retrieve language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Retrieve parameter references based on codes
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	vRoomRate = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomRates", pRoomRateCode);
	vRoomType = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomTypes", pRoomTypeCode);
	vCustomer = cmGetCustomerByName(pCustomerName,,,,,,,vHotel);
	vContract = cmGetContractByName(vCustomer, pContractName);
	vAgent = cmGetCustomerByName(pAgentName,,,,,,,vHotel);
	vRoomQuota = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "RoomQuotas", pRoomQuotaCode);
	// Call API to get value table with balances
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	CheckInPeriods.Hotel AS Hotel,
	|	CheckInPeriods.RoomQuota.RoomRate AS RoomRate,
	|	CheckInPeriods.CheckInDate AS CheckInDate,
	|	CheckInPeriods.Duration AS Duration,
	|	CheckInPeriods.CheckOutDate AS CheckOutDate,
	|	CheckInPeriods.RoomQuota AS Allotment,
	|	SUM(CheckInPeriods.RoomsVacant) AS RoomsVacant,
	|	SUM(CheckInPeriods.BedsVacant) AS BedsVacant,
	|	SUM(CheckInPeriods.RoomsRemains) AS RoomsRemains,
	|	SUM(CheckInPeriods.BedsRemains) AS BedsRemains
	|FROM
	|	(SELECT
	|		CheckInPeriods1.Hotel AS Hotel,
	|		CheckInPeriods1.CheckInDate AS CheckInDate,
	|		CheckInPeriods1.Duration AS Duration,
	|		CheckInPeriods1.CheckOutDate AS CheckOutDate,
	|		&qEmptyRoomQuota AS RoomQuota,
	|		MIN(ISNULL(RoomInventory.RoomsVacant, 0)) AS RoomsVacant,
	|		MIN(ISNULL(RoomInventory.BedsVacant, 0)) AS BedsVacant,
	|		0 AS RoomsRemains,
	|		0 AS BedsRemains
	|	FROM
	|		InformationRegister.RoomQuotaCheckInPeriods AS CheckInPeriods1
	|			LEFT JOIN (SELECT
	|				RoomInventoryBalanceAndTurnovers.Hotel AS RoomInventoryBalanceHotel,
	|				RoomInventoryBalanceAndTurnovers.Period AS RoomInventoryBalancePeriod,
	|				RoomInventoryBalanceAndTurnovers.CounterClosingBalance AS CounterClosingBalance,
	|				RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance AS RoomsVacant,
	|				RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance AS BedsVacant
	|			FROM
	|				AccumulationRegister.RoomInventory.BalanceAndTurnovers(
	|						&qPeriodFrom,
	|						&qInventoryPeriodTo,
	|						Second,
	|						RegisterRecordsAndPeriodBoundaries,
	|						(Hotel IN HIERARCHY (&qHotel)
	|							OR &qHotelIsEmpty)
	|							AND (RoomType IN HIERARCHY (&qRoomType)
	|								OR &qRoomTypeIsEmpty)) AS RoomInventoryBalanceAndTurnovers) AS RoomInventory
	|			ON (RoomInventory.RoomInventoryBalanceHotel = CheckInPeriods1.Hotel)
	|				AND (CheckInPeriods1.RoomQuota = &qEmptyRoomQuota)
	|				AND (RoomInventory.RoomInventoryBalancePeriod >= CheckInPeriods1.CheckInDate)
	|				AND (RoomInventory.RoomInventoryBalancePeriod < CheckInPeriods1.CheckOutDate)
	|	WHERE
	|		NOT CheckInPeriods1.IsNotActive
	|		AND CheckInPeriods1.Duration > 1
	|		AND CheckInPeriods1.RoomQuota = &qEmptyRoomQuota
	|		AND (CheckInPeriods1.Hotel IN HIERARCHY (&qHotel)
	|				OR &qHotelIsEmpty)
	|		AND CheckInPeriods1.CheckInDate >= &qPeriodFrom
	|		AND CheckInPeriods1.CheckInDate <= &qPeriodTo
	|	
	|	GROUP BY
	|		CheckInPeriods1.Hotel,
	|		CheckInPeriods1.CheckInDate,
	|		CheckInPeriods1.Duration,
	|		CheckInPeriods1.CheckOutDate
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		CheckInPeriods2.Hotel,
	|		CheckInPeriods2.CheckInDate,
	|		CheckInPeriods2.Duration,
	|		CheckInPeriods2.CheckOutDate,
	|		CheckInPeriods2.RoomQuota,
	|		0,
	|		0,
	|		MIN(ISNULL(RoomQuotaBalances.RoomsRemains, 0)),
	|		MIN(ISNULL(RoomQuotaBalances.BedsRemains, 0))
	|	FROM
	|		InformationRegister.RoomQuotaCheckInPeriods AS CheckInPeriods2
	|			LEFT JOIN (SELECT
	|				RoomQuotaSalesBalanceAndTurnovers.Hotel AS RoomQuotaSalesBalanceHotel,
	|				RoomQuotaSalesBalanceAndTurnovers.RoomQuota AS RoomQuotaSalesBalanceRoomQuota,
	|				RoomQuotaSalesBalanceAndTurnovers.Period AS RoomQuotaSalesBalancePeriod,
	|				RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance AS CounterClosingBalance,
	|				RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance AS RoomsRemains,
	|				RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance AS BedsRemains
	|			FROM
	|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
	|						&qPeriodFrom,
	|						&qInventoryPeriodTo,
	|						Minute,
	|						RegisterRecordsAndPeriodBoundaries,
	|						(Hotel IN HIERARCHY (&qHotel)
	|							OR &qHotelIsEmpty)
	|							AND (RoomType IN HIERARCHY (&qRoomType)
	|								OR &qRoomTypeIsEmpty)
	|							AND (RoomQuota IN HIERARCHY (&qRoomQuota)
	|								OR &qRoomQuotaIsEmpty)
	|							AND (RoomQuota.Agent IN HIERARCHY (&qAgent)
	|								OR &qAgentIsEmpty)
	|							AND (RoomQuota.Customer IN HIERARCHY (&qCustomer)
	|								OR &qCustomerIsEmpty)
	|							AND (RoomQuota.Contract = &qContract
	|								OR &qContractIsEmpty)) AS RoomQuotaSalesBalanceAndTurnovers) AS RoomQuotaBalances
	|			ON (RoomQuotaBalances.RoomQuotaSalesBalanceHotel = CheckInPeriods2.Hotel)
	|				AND (RoomQuotaBalances.RoomQuotaSalesBalanceRoomQuota = CheckInPeriods2.RoomQuota)
	|				AND (RoomQuotaBalances.RoomQuotaSalesBalancePeriod >= CheckInPeriods2.CheckInDate)
	|				AND (RoomQuotaBalances.RoomQuotaSalesBalancePeriod < CheckInPeriods2.CheckOutDate)
	|	WHERE
	|		NOT CheckInPeriods2.IsNotActive
	|		AND CheckInPeriods2.Duration > 1
	|		AND CheckInPeriods2.RoomQuota <> &qEmptyRoomQuota
	|		AND (CheckInPeriods2.Hotel IN HIERARCHY (&qHotel)
	|				OR &qHotelIsEmpty)
	|		AND CheckInPeriods2.CheckInDate >= &qPeriodFrom
	|		AND CheckInPeriods2.CheckInDate <= &qPeriodTo
	|	
	|	GROUP BY
	|		CheckInPeriods2.Hotel,
	|		CheckInPeriods2.CheckInDate,
	|		CheckInPeriods2.Duration,
	|		CheckInPeriods2.CheckOutDate,
	|		CheckInPeriods2.RoomQuota) AS CheckInPeriods
	|WHERE
	|	(CheckInPeriods.RoomQuota.RoomRate IN HIERARCHY (&qRoomRate)
	|			OR &qRoomRateIsEmpty)
	|
	|GROUP BY
	|	CheckInPeriods.Hotel,
	|	CheckInPeriods.RoomQuota.RoomRate,
	|	CheckInPeriods.CheckInDate,
	|	CheckInPeriods.Duration,
	|	CheckInPeriods.CheckOutDate,
	|	CheckInPeriods.RoomQuota
	|
	|HAVING
	|	(NOT &qRoomQuotaIsEmpty
	|			AND SUM(CheckInPeriods.BedsRemains) > 0
	|		OR &qRoomQuotaIsEmpty
	|			AND SUM(CheckInPeriods.BedsVacant) > 0)
	|
	|ORDER BY
	|	CheckInPeriods.Hotel.SortCode,
	|	CheckInDate,
	|	Duration,
	|	CheckOutDate";
	vQry.SetParameter("qHotel", vHotel);
	vQry.SetParameter("qHotelIsEmpty", Not ValueIsFilled(vHotel));
	vQry.SetParameter("qRoomRate", vRoomRate);
	vQry.SetParameter("qRoomRateIsEmpty", Not ValueIsFilled(vRoomRate));
	vQry.SetParameter("qRoomType", vRoomType);
	vQry.SetParameter("qRoomTypeIsEmpty", Not ValueIsFilled(vRoomType));
	vQry.SetParameter("qCustomer", vCustomer);
	vQry.SetParameter("qCustomerIsEmpty", Not ValueIsFilled(vCustomer));
	vQry.SetParameter("qContract", vContract);
	vQry.SetParameter("qContractIsEmpty", Not ValueIsFilled(vContract));
	vQry.SetParameter("qAgent", vAgent);
	vQry.SetParameter("qAgentIsEmpty", Not ValueIsFilled(vAgent));
	vQry.SetParameter("qRoomQuota", vRoomQuota);
	vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(vRoomQuota));
	vQry.SetParameter("qEmptyRoomQuota", Catalogs.RoomQuotas.EmptyRef());
	vQry.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom));
	vQry.SetParameter("qPeriodTo", EndOfDay(pPeriodTo));
	vQry.SetParameter("qInventoryPeriodTo", EndOfDay(pPeriodTo) + 90*24*3600);
	vVacantPeriods = vQry.Execute().Unload();
	vVacantPeriods.Columns.Add("ExtHotelCode", cmGetStringTypeDescription());
	vVacantPeriods.Columns.Add("ExtRoomRateCode", cmGetStringTypeDescription());
	vVacantPeriods.Columns.Add("RoomRateDescription", cmGetStringTypeDescription());
	vVacantPeriods.Columns.Add("ExtAllotmentCode", cmGetStringTypeDescription());
	vVacantPeriods.Columns.Add("AllotmentDescription", cmGetStringTypeDescription());
	// Build return string
	vRetStr = "";
	For Each vRow In vVacantPeriods Do
		// Reset hotel balances if room quota is specified
		If ValueIsFilled(vRoomQuota) Then
			vRow.RoomsVacant = 0;
			vRow.BedsVacant = 0;
		EndIf;
		// Fill output attributes		
		vRow.ExtHotelCode = "";
		If ValueIsFilled(vRow.Hotel) Then
			vRow.ExtHotelCode = cmGetObjectExternalSystemCodeByRef(Catalogs.Hotels.EmptyRef(), pExternalSystemCode, "Hotels", vRow.Hotel);
		EndIf;
		vRow.ExtRoomRateCode = "";
		vRow.RoomRateDescription = "";
		If ValueIsFilled(vRow.RoomRate) Then
			vRow.ExtRoomRateCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "RoomRates", vRow.RoomRate);
			vRow.RoomRateDescription = vRow.RoomRate.GetObject().pmGetRoomRateDescription(vLanguage);
		EndIf;
		vRow.ExtAllotmentCode = "";
		vRow.AllotmentDescription = "";
		If ValueIsFilled(vRow.Allotment) Then
			vRow.ExtAllotmentCode = cmGetObjectExternalSystemCodeByRef(vRow.Hotel, pExternalSystemCode, "RoomQuotas", vRow.Allotment);
			vRow.AllotmentDescription = cmNStr(TrimAll(vRow.Allotment.Description), vLanguage);
		EndIf;
		// Build return string
		vRetStr = vRetStr + 
		          """" + TrimAll(vRow.ExtHotelCode) + """" + "," + 
		          """" + TrimAll(vRow.ExtRoomRateCode) + """" + "," + 
		          """" + cmRemoveComma(vRow.RoomRateDescription) + """" + "," + 
		          """" + TrimAll(vRow.ExtAllotmentCode) + """" + "," + 
		          """" + cmRemoveComma(vRow.AllotmentDescription) + """" + "," + 
		          """" + Format(vRow.CheckInDate, "DF='yyyy-MM-dd HH:mm'") + """" + "," + 
		          Format(vRow.Duration, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
		          """" + Format(vRow.CheckOutDate, "DF='yyyy-MM-dd HH:mm'") + """" + "," + 
		          Format(vRow.RoomsVacant, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
		          Format(vRow.BedsVacant, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
		          Format(vRow.RoomsRemains, "ND=10; NFD=0; NZ=; NG=; NN=") + "," + 
				  Format(vRow.BedsRemains, "ND=10; NFD=0; NZ=; NG=; NN=") + 
				  Chars.LF;
	EndDo;
	WriteLogEvent(NStr("en='Get vacant allowed check-in periods';ru='Получить остатки по периодам заездов';de='Restbestände nach Anreisezeiträumen erhalten'"), EventLogLevel.Information, , , NStr("en='Return string: ';ru='Строка возврата: ';de='Zeilenrücklauf: '") + vRetStr);
	// Return based on output type
	If pOutputType = "CSV" Then
		Return vRetStr;
	Else
		// Write XML
		If pOutputType = "XML" Then
			pXMLWriter.WriteStartElement("VacantCheckInPeriods");
		EndIf;
		vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "VacantCheckInPeriods"));
		vRetRowType = XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "VacantCheckInPeriodsRow");
		For Each vRow In vVacantPeriods Do
			vRetRow = XDTOFactory.Create(vRetRowType);
			vRetRow.Hotel = TrimAll(vRow.ExtHotelCode);
			vRetRow.RoomRate = TrimAll(vRow.ExtRoomRateCode);
			vRetRow.RoomRateDescription = TrimAll(vRow.RoomRateDescription);
			vRetRow.Allotment = TrimAll(vRow.ExtAllotmentCode);
			vRetRow.AllotmentDescription = TrimAll(vRow.AllotmentDescription);
			vRetRow.CheckInDate = vRow.CheckInDate;
			vRetRow.Duration = vRow.Duration;
			vRetRow.CheckOutDate = vRow.CheckOutDate;
			vRetRow.RoomsVacant = vRow.RoomsVacant;
			vRetRow.BedsVacant = vRow.BedsVacant;
			vRetRow.RoomsRemains = vRow.RoomsRemains;
			vRetRow.BedsRemains = vRow.BedsRemains;
			vRetXDTO.VacantCheckInPeriodsRow.Add(vRetRow);
			// Write XML
			If pOutputType = "XML" Then
				pXMLWriter.WriteStartElement("VacantCheckInPeriodsRow");
				
				pXMLWriter.WriteStartElement("Hotel");
				pXMLWriter.WriteText(TrimAll(vRow.ExtHotelCode));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("RoomRate");
				pXMLWriter.WriteAttribute("Description", TrimAll(vRow.RoomRateDescription));
				pXMLWriter.WriteText(TrimAll(vRow.ExtRoomRateCode));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("Allotment");
				pXMLWriter.WriteAttribute("Description", TrimAll(vRow.AllotmentDescription));
				pXMLWriter.WriteText(TrimAll(vRow.ExtAllotmentCode));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("CheckInDate");
				pXMLWriter.WriteText(Format(vRow.CheckInDate, "DF='yyyy-MM-dd HH:mm'"));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("Duration");
				pXMLWriter.WriteText(Format(vRow.Duration, "ND=10; NFD=0; NZ=; NG=; NN="));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("CheckOutDate");
				pXMLWriter.WriteText(Format(vRow.CheckOutDate, "DF='yyyy-MM-dd HH:mm'"));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("RoomsVacant");
				pXMLWriter.WriteText(Format(vRow.RoomsVacant, "ND=10; NFD=0; NZ=; NG="));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("BedsVacant");
				pXMLWriter.WriteText(Format(vRow.BedsVacant, "ND=10; NFD=0; NZ=; NG="));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("RoomsRemains");
				pXMLWriter.WriteText(Format(vRow.RoomsRemains, "ND=10; NFD=0; NZ=; NG="));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteStartElement("BedsRemains");
				pXMLWriter.WriteText(Format(vRow.BedsRemains, "ND=10; NFD=0; NZ=; NG="));
				pXMLWriter.WriteEndElement();
				
				pXMLWriter.WriteEndElement();
			EndIf;
		EndDo;
		// Write XML
		If pOutputType = "XML" Then
			pXMLWriter.WriteEndElement();
		EndIf;
		Return vRetXDTO;
	EndIf;
EndFunction // cmGetVacantCheckInPeriods

// -----------------------------------------------------------------------------
//  Description: Returns guest group reservation data checking user identity according to the
//  user e-mail or phone number
//
// Parameters:
//  pEMail				 - 	 - 
//  pPhone				 - 	 - 
//  pLogin				 - 	 - 
//  pGuestGroupCode		 - 	 - 
//  pHotelCode			 - 	 - 
//  pExternalSystemCode	 - 	 - 
//  pLanguageCode		 - 	 - 
//  pOutputType			 - 	 - 
// 
// Returns:
//  XDTO - XDTO ExternalGroupReservationStatus object or CSV string
//
Function cmGetGroupReservationDetails(pEMail, pPhone, pLogin, Val pGuestGroupCode, pHotelCode, pExternalSystemCode, pLanguageCode = "RU", pOutputType = "XDTO") Export
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get result from old API
	vGroupStatusObj = cmGetExternalGroupReservationStatus(pGuestGroupCode, pHotelCode, pExternalSystemCode, pLanguageCode, pOutputType, pLogin);
	// Check if authentication data are present in the returned data
	If Not IsBlankString(pGuestGroupCode) Then
		If pOutputType = "XDTO" Then
			If IsBlankString(vGroupStatusObj.ErrorDescription) Then
				If StrLen(pGuestGroupCode) <> 36 Then
					If Not IsBlankString(pEMail) Then
						If cmCheckEMailIsValid(TrimAll(pEMail)) And Find(Lower(vGroupStatusObj.GuestEMail), Lower(TrimAll(pEMail))) > 0 Then
							Return vGroupStatusObj;
						EndIf;
					EndIf;
					If Not IsBlankString(pPhone) Then
						If StrLen(TrimAll(pPhone)) >= 7 And Find(SMS.GetValidPhoneNumber(TrimAll(vGroupStatusObj.GuestPhone)), SMS.GetValidPhoneNumber(TrimAll(pPhone))) > 0 Then
							Return vGroupStatusObj;
						EndIf;
					EndIf;
					If Not IsBlankString(pLogin) Then
						vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
						If vCustomerStruct <> Undefined Then
							If ValueIsFilled(vCustomerStruct.Customer) Then
								If Find(Lower(vGroupStatusObj.Customer), Lower(TrimAll(vCustomerStruct.Customer.Description))) > 0 Then
									Return vGroupStatusObj;
								EndIf;
							EndIf;
						Else
							If Left(Lower(TrimAll(vGroupStatusObj.GuestFullName)), StrLen(Lower(TrimAll(pLogin)))) = Lower(TrimAll(pLogin)) Then
								Return vGroupStatusObj;
							EndIf;
						EndIf;
					EndIf;
				Else
					Return vGroupStatusObj;
				EndIf;
			Else
				Return vGroupStatusObj;
			EndIf;
		ElsIf pOutputType = "CSV" Then
			If Not IsBlankString(pEMail) Then
				If Find(Lower(vGroupStatusObj), Lower(TrimAll(pEMail))) > 0 Then
					Return vGroupStatusObj;
				EndIf;
			EndIf;
			If Not IsBlankString(pPhone) Then
				If Find(vGroupStatusObj, TrimAll(pPhone)) > 0 Then
					Return vGroupStatusObj;
				EndIf;
			EndIf;
			If Not IsBlankString(pLogin) Then
				vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
				If vCustomerStruct <> Undefined Then
					If ValueIsFilled(vCustomerStruct.Customer) Then
						If Find(Lower(vGroupStatusObj), Lower(TrimAll(vCustomerStruct.Customer.Description))) > 0 Then
							Return vGroupStatusObj;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	// Error message
	vErrorMessage = cmNStr("en='Not authenticated!';ru='Пользователь не авторизован!';de='Der Nutzer ist nicht autorisiert!'", vLanguage);
	If pOutputType = "XDTO" Then
		vGroupStatusObj = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ExternalGroupReservationStatus"));
		vGroupStatusObj.ErrorDescription = vErrorMessage;
	Else
		vGroupStatusObj = vErrorMessage;
	EndIf;
	Return vGroupStatusObj;
EndFunction // cmGetGroupReservationDetails

// -----------------------------------------------------------------------------
// Description: Returns customer and contract by login
// Parameters: Login
// Return value: Structure with customer and contract elements
// -----------------------------------------------------------------------------
Function cmGetCustomerByLogin(pHotel, pExternalSystemCode, pLogin) Export
	vCustomerStruct = Undefined;
	If Not IsBlankString(pLogin) Then
		vCustomerStruct = New Structure("Customer, Contract", Undefined, Undefined);
		vLoginContract = cmGetObjectRefByExternalSystemCode(pHotel, pExternalSystemCode, "Contracts", TrimAll(pLogin));
		If ValueIsFilled(vLoginContract) And Not vLoginContract.DeletionMark Then
			vLoginCustomer = vLoginContract.Owner;
			If ValueIsFilled(vLoginCustomer) And Not vLoginCustomer.DeletionMark Then
				vCustomerStruct.Customer = vLoginCustomer;
				vCustomerStruct.Contract = vLoginContract;
			EndIf;
		Else
			vLoginCustomer = cmGetObjectRefByExternalSystemCode(pHotel, pExternalSystemCode, "Customers", TrimAll(pLogin));
			If ValueIsFilled(vLoginCustomer) And Not vLoginCustomer.DeletionMark Then
				vCustomerStruct.Customer = vLoginCustomer;
				vCustomerStruct.Contract = Catalogs.Contracts.EmptyRef();
			EndIf;
		EndIf;
	EndIf;
	Return vCustomerStruct;
EndFunction // cmGetCustomerByLogin

// -----------------------------------------------------------------------------
// Description: Cancels group reservation
// Parameters: Group code, Hotel code, External system code, Language code
// Return value: Error description as string
// -----------------------------------------------------------------------------
Function cmCancelGroupReservation(pGuestGroupCode, pHotelCode, pExternalSystemCode, pLanguageCode = "RU", pReason = "", pExtReservationCode = "", pAnnulationStatus = Undefined, rAnnulatedPeriod = Undefined, rGuestGroupCode = "") Export
	WriteLogEvent(NStr("en='Cancel group reservation';ru='Отмена групповой брони';de='Abbruch der Gruppenreservierung'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Guest group code: ';ru='Номер группы гостей: ';de='Nummer der Gästegruppe: '") + pGuestGroupCode + Chars.LF + 
	              NStr("en='Reservation code: ';ru='Код брони гостя: ';de='Reservierungscode des Gastes: '") + pExtReservationCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF + 
	              NStr("en='Annulation reason: ';ru='Причина отмены: ';de='Grund des Abbruchs: '") + pReason);
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get guest group by code
	vGuestGroup = cmGetGuestGroupByExternalCode(vHotel, pGuestGroupCode, "", "", False);
	// Check if group was found
	If Not ValueIsFilled(vGuestGroup) Then
		Return cmNStr("en='Guest group was not found!';ru='Группа не найдена!';de='Gruppe nicht gefunden!'", vLanguage);
	EndIf;
	
	// Return structure with annulated period
	rAnnulatedPeriod = New Structure("PeriodFrom, PeriodTo", Undefined, Undefined);
	
	vReservations = vGuestGroup.GetObject().pmGetReservations(True, True);
	Try
		BeginTransaction(DataLockControlMode.Managed);
		For Each vReservationsRow In vReservations Do
			vReservationRef = vReservationsRow.Reservation;
			If Not IsBlankString(pExtReservationCode) Then
				If TrimAll(vReservationRef.Number) <> TrimAll(pExtReservationCode) And 
				   TrimAll(vReservationRef.ExternalCode) <> TrimAll(pExtReservationCode) Then
					Continue;
				EndIf;
			EndIf;
			If vReservationRef.ReservationStatus.IsCheckIn Then
				WriteLogEvent(NStr("en='Cancel group reservation';ru='Отмена групповой брони';de='Abbruch der Gruppenreservierung'"), EventLogLevel.Information, , , 
	              NStr("en = 'Can''t cancel checked in reservation:'; ru = 'Нельзя отменить бронь со статусом заезда:'; de = 'Sie können die Reservierung nicht mit dem Status der Ankunft stornieren:'") + String(vReservationRef));
				Continue;
			EndIf;		
			vAnnulationStatus = Catalogs.ReservationStatuses.EmptyRef();
			If ValueIsFilled(pAnnulationStatus) Then
				vAnnulationStatus = pAnnulationStatus;
			EndIf;
			If Not ValueIsFilled(vAnnulationStatus) Then
				vAnnulationStatus = cmGetReservationAnnulationStatus(vReservationRef);
			EndIf;
			If Not ValueIsFilled(vAnnulationStatus) Then
				Return cmNStr("en='Failed to get reservation annulation status!';ru='Не удалось получить статус аннуляции брони!';de='Der Status der Reservierungslöschung konnte nicht eingeholt werden!'", vLanguage);
			EndIf;
			If vReservationRef.ReservationStatus <> vAnnulationStatus Then
				vReservationObj = vReservationRef.GetObject();
				vReservationObj.ReservationStatus = vAnnulationStatus;
				vReservationObj.pmSetDoCharging();
				vReservationObj.AuthorOfAnnulation = SessionParameters.CurrentUser;
				vReservationObj.DateOfAnnulation = CurrentSessionDate();
				vReservationObj.AnnulationReason = cmGetObjectRefByExternalSystemCode(vHotel, pExternalSystemCode, "UsualActionReasons", TrimR(pReason));
				vReservationObj.pmCalculateServices();
				vReservationObj.Write(DocumentWriteMode.Posting);
				vReservationObj.pmWriteToReservationChangeHistory(CurrentSessionDate(), SessionParameters.CurrentUser);
				
				// Add dates to annulated period
				If rAnnulatedPeriod.PeriodFrom = Undefined Or rAnnulatedPeriod.PeriodFrom > vReservationObj.CheckInDate Then
					rAnnulatedPeriod.PeriodFrom = vReservationObj.CheckInDate;
				EndIf;
				
				If rAnnulatedPeriod.PeriodTo = Undefined Or rAnnulatedPeriod.PeriodTo < vReservationObj.CheckOutDate Then
					rAnnulatedPeriod.PeriodTo = vReservationObj.CheckInDate;
				EndIf;

			EndIf;
		EndDo;
		CommitTransaction();
		rGuestGroupCode = vGuestGroup.Code;
	Except
		vErrorDescription = ErrorDescription();
		If TransactionActive() Then
			RollbackTransaction();
		EndIf;
		Return Left(vErrorDescription, 4096);
	EndTry;
	Return "";
EndFunction // cmCancelGroupReservation

// -----------------------------------------------------------------------------
// Description: Returns the list of active groups for the given login associated with contract
// Parameters: Login, Hotel code, External system code, Language code
// Return value: List of groups and error description as string
// -----------------------------------------------------------------------------
Function cmGetActiveGroupsList(pLogin, pHotelCode, pExternalSystemCode, pLanguageCode = "RU") Export
	WriteLogEvent(NStr("en='Get active groups list';ru='Получить список действующих групп';de='Liste der aktiven Gruppen erhalten'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Login: ';ru='Логин: ';de='Login: '") + pLogin + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode);
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get customer and contract by login
	vCustomerStruct = cmGetCustomerByLogin(vHotel, pExternalSystemCode, pLogin);
	// Marketing code filter
	vSourceOfBusiness = Undefined;
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GroupsList"));
	// Get active reservations and group by them by guest group
	If vCustomerStruct <> Undefined And ValueIsFilled(vCustomerStruct.Customer) Then
		// Get customer and contract references
		vCustomer = vCustomerStruct.Customer;
		vContract = vCustomerStruct.Contract;
		// Run query
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	GuestGroups.GuestGroup AS GuestGroup,
		|	GuestGroups.GuestGroupCode AS GuestGroupCode,
		|	GuestGroups.GuestGroupExternalCode AS GuestGroupExternalCode,
		|	GuestGroups.Status AS Status,
		|	GuestGroups.CheckInDate AS CheckInDate,
		|	GuestGroups.Duration AS Duration,
		|	GuestGroups.CheckOutDate AS CheckOutDate,
		|	GuestGroups.NumberOfPersons AS NumberOfPersons,
		|	GuestGroups.GuestFullName AS GuestFullName,
		|	GuestGroups.Phone AS Phone,
		|	GuestGroups.Email AS Email,
		|	GuestGroups.Remarks AS Remarks,
		|	GuestGroups.Agent AS Agent,
		|	GuestGroups.Contract AS Contract,
		|	ISNULL(GuestGroupTotalSales.TotalSales, 0) AS TotalSales,
		|	ISNULL(GuestGroupTotalSales.Sales, 0) AS Sales,
		|	GuestGroupTotalSales.Currency AS Currency,
		|	GuestGroupTotalSales.Currency.Code AS CurrencyCode,
		|	GuestGroupTotalSales.Currency.Description AS CurrencyDescription,
		|	ISNULL(GuestGroupPayments.PaymentAmount, 0) AS PaymentAmount,
		|	GuestGroupPayments.PaymentCurrency AS PaymentCurrency,
		|	GuestGroups.GuestGroup.Owner.Code AS HotelCode,
		|	GuestGroups.GuestGroup.Owner.Description AS HotelDescription
		|FROM
		|	(SELECT
		|		Reservation.GuestGroup AS GuestGroup,
		|		Reservation.GuestGroup.Code AS GuestGroupCode,
		|		Reservation.GuestGroup.ExternalCode AS GuestGroupExternalCode,
		|		Reservation.GuestGroup.Status AS Status,
		|		Reservation.GuestGroup.CheckInDate AS CheckInDate,
		|		Reservation.GuestGroup.Duration AS Duration,
		|		Reservation.GuestGroup.CheckOutDate AS CheckOutDate,
		|		Reservation.GuestGroup.GuestsCheckedIn AS NumberOfPersons,
		|		Reservation.GuestGroup.Client.FullName AS GuestFullName,
		|		MAX(Reservation.Phone) AS Phone,
		|		MAX(Reservation.EMail) AS Email,
		|		Reservation.GuestGroup.Description AS Remarks,
		|		Reservation.Agent.Description AS Agent,
		|		Reservation.Contract.Description AS Contract
		|	FROM
		|		Document.Reservation AS Reservation
		|	WHERE
		|		Reservation.Posted
		|		AND Reservation.Hotel = &qHotel
		|		AND Reservation.Customer = &qCustomer
		|		AND (Reservation.Contract = &qContract
		|				OR &qContractIsEmpty)
		|		AND (Reservation.ReservationStatus.IsActive
		|				OR Reservation.ReservationStatus.IsPreliminary)
		|		AND (&qSourceOfBusinessIsEmpty
		|				OR NOT &qSourceOfBusinessIsEmpty
		|					AND Reservation.SourceOfBusiness = &qSourceOfBusiness)
		|	
		|	GROUP BY
		|		Reservation.GuestGroup,
		|		Reservation.GuestGroup.Code,
		|		Reservation.GuestGroup.ExternalCode,
		|		Reservation.GuestGroup.Status,
		|		Reservation.GuestGroup.CheckInDate,
		|		Reservation.GuestGroup.Duration,
		|		Reservation.GuestGroup.CheckOutDate,
		|		Reservation.GuestGroup.GuestsCheckedIn,
		|		Reservation.GuestGroup.Client.FullName,
		|		Reservation.GuestGroup.Description,
		|		Reservation.Agent.Description,
		|		Reservation.Contract.Description) AS GuestGroups
		|		LEFT JOIN (SELECT
		|			GuestGroupSales.GuestGroup AS GuestGroup,
		|			GuestGroupSales.Currency AS Currency,
		|			SUM(GuestGroupSales.TotalSalesTurnover) + SUM(GuestGroupSales.TotalSalesForecastTurnover) AS TotalSales,
		|			SUM(GuestGroupSales.SalesTurnover) + SUM(GuestGroupSales.SalesForecastTurnover) AS Sales
		|		FROM
		|			(SELECT
		|				CurrentAccountsReceivableTurnovers.GuestGroup AS GuestGroup,
		|				CurrentAccountsReceivableTurnovers.FolioCurrency AS Currency,
		|				0 AS TotalSalesTurnover,
		|				0 AS TotalSalesForecastTurnover,
		|				CurrentAccountsReceivableTurnovers.SumReceipt - CurrentAccountsReceivableTurnovers.CommissionSumReceipt AS SalesTurnover,
		|				0 AS SalesForecastTurnover
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(
		|						,
		|						,
		|						Period,
		|						Customer = &qCustomer
		|							AND (Contract = &qContract
		|								OR &qContractIsEmpty)
		|							AND Hotel = &qHotel) AS CurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				TotalCurrentAccountsReceivableTurnovers.GuestGroup,
		|				TotalCurrentAccountsReceivableTurnovers.FolioCurrency,
		|				TotalCurrentAccountsReceivableTurnovers.SumReceipt - TotalCurrentAccountsReceivableTurnovers.CommissionSumReceipt,
		|				0,
		|				0,
		|				0
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(, , Period, Hotel = &qHotel) AS TotalCurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				AccountsReceivableForecastTurnovers.GuestGroup,
		|				AccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				0,
		|				0,
		|				AccountsReceivableForecastTurnovers.SalesTurnover - AccountsReceivableForecastTurnovers.CommissionSumTurnover
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(
		|						&qForecastPeriodFrom,
		|						&qForecastPeriodTo,
		|						Period,
		|						Customer = &qCustomer
		|							AND (Contract = &qContract
		|								OR &qContractIsEmpty)
		|							AND Hotel = &qHotel) AS AccountsReceivableForecastTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				TotalAccountsReceivableForecastTurnovers.GuestGroup,
		|				TotalAccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				TotalAccountsReceivableForecastTurnovers.SalesTurnover - TotalAccountsReceivableForecastTurnovers.CommissionSumTurnover,
		|				0,
		|				0
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(&qForecastPeriodFrom, &qForecastPeriodTo, Period, Hotel = &qHotel) AS TotalAccountsReceivableForecastTurnovers) AS GuestGroupSales
		|		
		|		GROUP BY
		|			GuestGroupSales.GuestGroup,
		|			GuestGroupSales.Currency) AS GuestGroupTotalSales
		|		ON GuestGroups.GuestGroup = GuestGroupTotalSales.GuestGroup
		|		LEFT JOIN (SELECT
		|			Payments.GuestGroup AS GuestGroup,
		|			Payments.AccountingCurrency AS PaymentCurrency,
		|			SUM(Payments.SumExpense) AS PaymentAmount
		|		FROM
		|			AccumulationRegister.CustomerAccounts.BalanceAndTurnovers(
		|					,
		|					,
		|					Period,
		|					RegisterRecordsAndPeriodBoundaries,
		|					AccountingCustomer = &qCustomer
		|						AND (AccountingContract = &qContract
		|							OR &qContractIsEmpty)
		|						AND Hotel = &qHotel) AS Payments
		|		
		|		GROUP BY
		|			Payments.GuestGroup,
		|			Payments.AccountingCurrency) AS GuestGroupPayments
		|		ON GuestGroups.GuestGroup = GuestGroupPayments.GuestGroup
		|
		|ORDER BY
		|	GuestGroups.CheckInDate,
		|	GuestGroups.GuestGroupCode";
		vQry.SetParameter("qHotel", vHotel);
		vQry.SetParameter("qCustomer", vCustomerStruct.Customer);
		vQry.SetParameter("qContract", vCustomerStruct.Contract);
		vQry.SetParameter("qContractIsEmpty", Not ValueIsFilled(vCustomerStruct.Contract));
		vQry.SetParameter("qSourceOfBusiness", vSourceOfBusiness);
		vQry.SetParameter("qSourceOfBusinessIsEmpty", Not ValueIsFilled(vSourceOfBusiness));
		vForecastStartDate = tcOnServer.GetForecastStartDate(vHotel);
		vQry.SetParameter("qForecastPeriodFrom", vForecastStartDate);
		vQry.SetParameter("qForecastPeriodTo", '39991231235959');
		vGuestGroups = vQry.Execute().Unload();
		For Each vGuestGroupsRow In vGuestGroups Do
			// Build return object
			vGuestGroupDetails = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupDetails"));
			// Fill XDTO object attributes
			vGuestGroupDetails.GuestGroup = Format(vGuestGroupsRow.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=");
			vGuestGroupDetails.Customer = TrimAll(vCustomer.Description);
			vGuestGroupDetails.Contract = TrimAll(vGuestGroupsRow.Contract);
			vGuestGroupDetails.Agent = TrimAll(vGuestGroupsRow.Agent);
			If ValueIsFilled(vGuestGroupsRow.Status) Then
				vGuestGroupDetails.Status = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "ReservationStatuses", vGuestGroupsRow.Status);
				vGuestGroupDetails.StatusCode = TrimAll(vGuestGroupsRow.Status.Code);
				vGuestGroupDetails.StatusDescription = TrimAll(vGuestGroupsRow.Status.Description);
			Else
				vGuestGroupDetails.Status = "";
				vGuestGroupDetails.StatusCode = "";
				vGuestGroupDetails.StatusDescription = "";
			EndIf;
			vGuestGroupDetails.CheckInDate = vGuestGroupsRow.CheckInDate;
			vGuestGroupDetails.Duration = vGuestGroupsRow.Duration;
			vGuestGroupDetails.CheckOutDate = vGuestGroupsRow.CheckOutDate;
			vGuestGroupDetails.NumberOfPersons = vGuestGroupsRow.NumberOfPersons;
			vGuestGroupDetails.GuestFullName = TrimAll(vGuestGroupsRow.GuestFullName);
			vGuestGroupDetails.Phone = TrimAll(vGuestGroupsRow.Phone);
			vGuestGroupDetails.Email = TrimAll(vGuestGroupsRow.Email);
			vGuestGroupDetails.Remarks = Left(vGuestGroupsRow.Remarks, 4096);
			vGuestGroupDetails.Amount = vGuestGroupsRow.TotalSales;
			vGuestGroupDetails.Balance = vGuestGroupsRow.Sales - vGuestGroupsRow.PaymentAmount;
			If vGuestGroupsRow.Sales <> 0 And ValueIsFilled(vGuestGroupsRow.Currency) Then
				vGuestGroupDetails.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vGuestGroupsRow.Currency);
				vGuestGroupDetails.CurrencyCode = TrimAll(vGuestGroupsRow.CurrencyCode);
				vGuestGroupDetails.CurrencyDescription = TrimAll(vGuestGroupsRow.CurrencyDescription);
				vGuestGroupDetails.PaymentPercent = Round(vGuestGroupsRow.PaymentAmount/vGuestGroupsRow.Sales*100, 0);
			Else
				vGuestGroupDetails.Currency = "";
				vGuestGroupDetails.CurrencyCode = "";
				vGuestGroupDetails.CurrencyDescription = "";
				vGuestGroupDetails.PaymentPercent = 0;
			EndIf;
			// Hotel
			vGuestGroupDetails.Hotel =  TrimAll(vGuestGroupsRow.HotelCode);
			vGuestGroupDetails.HotelCode =  TrimAll(vGuestGroupsRow.HotelDescription); 
			// Add guest group to the return object
			vRetXDTO.GuestGroupDetails.Add(vGuestGroupDetails);
		EndDo;
	EndIf;	
	Return vRetXDTO;
EndFunction // cmGetActiveGroupsList 

// -----------------------------------------------------------------------------
// Description: Returns the list of groups for the given login associated with contract
// Parameters: Login, Hotel code, External system code, Language code
// Return value: List of groups and error description as string
// -----------------------------------------------------------------------------
Function cmGetCientGuestGroupsList(pClientCode, pHotelCode, pExternalSystemCode, pPeriodFrom, pPeriodTo, pLanguageCode, pStatusFilter) Export
	
	vStatusXML 	= cmGetXMLStringFromXDTO(pStatusFilter);
	vInputParameters = NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Client code: ';ru='Код клиента: ';de='Kundekod: '") + pClientCode + Chars.LF + 
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode + Chars.LF +
				  "Status:"+vStatusXML; 
	
	vWriteDebug = False;
	vInteraction = Undefined;
	If Not IsBlankString(pExternalSystemCode) Then
		vInteraction = Catalogs.ExternalSystemInteractions.GetExternalSystemInteractionsByInteractionID(pExternalSystemCode);
		If ValueIsFilled(vInteraction) Then
			vWriteDebug = vInteraction.DebugMode;
		EndIf;	
	EndIf;
	vFuncLog = "GetCientGuestGroupsList";
	If vWriteDebug Then
		vMsg = NStr("en='Start of processing';ru='Начало выполнения';de='Anfang der Ausführung'");
		InformationRegisters.ExternalSystemIntegrationLogs.WriteLog(vInteraction, vFuncLog, Enums.ExternalSystemEventTypes.Info, vInputParameters, , vMsg, vInteraction.MaxLogLenght);
	Else
		WriteLogEvent(vFuncLog, EventLogLevel.Information, , , vInputParameters);
	EndIf;
			  
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Get client by code
	vClientRef = Catalogs.Clients.FindByCode(pClientCode);
	
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GroupsList"));
	// Get reservations 
	If ValueIsFilled(vClientRef) Then
		// Run query
		vQry = New Query();
		vQry.Text = 
		"SELECT
		|	ClientReservations.GuestGroup AS GuestGroup
		|INTO ClientGroups
		|FROM
		|	Document.Reservation AS ClientReservations
		|WHERE
		|	ClientReservations.Posted
		|	AND (ClientReservations.Hotel = &qHotel
		|			OR &qHotelIsEmpty)
		|	AND (ClientReservations.Guest = &qClient
		|			OR ClientReservations.GuestGroup.Client = &qClient)
		|	AND (ClientReservations.ReservationStatus.IsActive = &qIsActive
		|			OR &qIsAllStatuses
		|			OR &qIsCheckIn
		|				AND ClientReservations.ReservationStatus.IsCheckIn = &qIsCheckIn)
		|
		|GROUP BY
		|	ClientReservations.GuestGroup
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GuestGroups.GuestGroup AS GuestGroup,
		|	GuestGroups.GuestGroupCode AS GuestGroupCode,
		|	GuestGroups.GuestGroupExternalCode AS GuestGroupExternalCode,
		|	GuestGroups.Status AS Status,
		|	GuestGroups.CheckInDate AS CheckInDate,
		|	GuestGroups.Duration AS Duration,
		|	GuestGroups.CheckOutDate AS CheckOutDate,
		|	GuestGroups.NumberOfPersons AS NumberOfPersons,
		|	GuestGroups.GuestFullName AS GuestFullName,
		|	GuestGroups.Phone AS Phone,
		|	GuestGroups.Email AS Email,
		|	GuestGroups.Remarks AS Remarks,
		|	GuestGroups.Agent AS Agent,
		|	GuestGroups.Contract AS Contract,
		|	GuestGroups.Customer AS Customer,
		|	ISNULL(GuestGroupTotalSales.TotalSales, 0) AS TotalSales,
		|	ISNULL(GuestGroupTotalSales.Sales, 0) AS Sales,
		|	GuestGroupTotalSales.Currency AS Currency,
		|	GuestGroupTotalSales.Currency.Code AS CurrencyCode,
		|	GuestGroupTotalSales.Currency.Description AS CurrencyDescription,
		|	ISNULL(GuestGroupPayments.PaymentAmount, 0) AS PaymentAmount,
		|	GuestGroupPayments.PaymentCurrency AS PaymentCurrency,
		|	GuestGroups.GuestGroup.Owner.Code AS HotelCode,
		|	GuestGroups.GuestGroup.Owner.Description AS HotelDescription,
		|	GuestGroups.ReservationCreateDate AS ReservationCreateDate
		|FROM
		|	(SELECT
		|		Reservation.GuestGroup AS GuestGroup,
		|		Reservation.GuestGroup.Code AS GuestGroupCode,
		|		Reservation.GuestGroup.ExternalCode AS GuestGroupExternalCode,
		|		Reservation.GuestGroup.Status AS Status,
		|		Reservation.GuestGroup.CheckInDate AS CheckInDate,
		|		Reservation.GuestGroup.Duration AS Duration,
		|		Reservation.GuestGroup.CheckOutDate AS CheckOutDate,
		|		Reservation.GuestGroup.GuestsCheckedIn AS NumberOfPersons,
		|		Reservation.GuestGroup.Client.FullName AS GuestFullName,
		|		MAX(Reservation.Phone) AS Phone,
		|		MAX(Reservation.EMail) AS Email,
		|		Reservation.GuestGroup.Description AS Remarks,
		|		Reservation.Agent.Description AS Agent,
		|		Reservation.Contract.Description AS Contract,
		|		Reservation.Customer.Description AS Customer,
		|		Reservation.Date AS ReservationCreateDate
		|	FROM
		|		Document.Reservation AS Reservation
		|	WHERE
		|		Reservation.Posted
		|		AND (Reservation.Hotel = &qHotel
		|				OR &qHotelIsEmpty)
		|		AND (Reservation.Guest = &qClient
		|				OR Reservation.GuestGroup.Client = &qClient)
		|		AND (Reservation.ReservationStatus.IsActive = &qIsActive
		|				OR &qIsAllStatuses
		|				OR &qIsCheckIn
		|					AND Reservation.ReservationStatus.IsCheckIn = &qIsCheckIn)
		|	
		|	GROUP BY
		|		Reservation.GuestGroup,
		|		Reservation.GuestGroup.Code,
		|		Reservation.GuestGroup.ExternalCode,
		|		Reservation.GuestGroup.Status,
		|		Reservation.GuestGroup.CheckInDate,
		|		Reservation.GuestGroup.Duration,
		|		Reservation.GuestGroup.CheckOutDate,
		|		Reservation.GuestGroup.GuestsCheckedIn,
		|		Reservation.GuestGroup.Client.FullName,
		|		Reservation.GuestGroup.Description,
		|		Reservation.Agent.Description,
		|		Reservation.Contract.Description,
		|		Reservation.Customer.Description,
		|		Reservation.Date) AS GuestGroups
		|		LEFT JOIN (SELECT
		|			GuestGroupSales.GuestGroup AS GuestGroup,
		|			GuestGroupSales.Currency AS Currency,
		|			SUM(GuestGroupSales.TotalSalesTurnover) + SUM(GuestGroupSales.TotalSalesForecastTurnover) AS TotalSales,
		|			SUM(GuestGroupSales.SalesTurnover) + SUM(GuestGroupSales.SalesForecastTurnover) AS Sales
		|		FROM
		|			(SELECT
		|				CurrentAccountsReceivableTurnovers.GuestGroup AS GuestGroup,
		|				CurrentAccountsReceivableTurnovers.FolioCurrency AS Currency,
		|				0 AS TotalSalesTurnover,
		|				0 AS TotalSalesForecastTurnover,
		|				CurrentAccountsReceivableTurnovers.SumReceipt - CurrentAccountsReceivableTurnovers.CommissionSumReceipt AS SalesTurnover,
		|				0 AS SalesForecastTurnover
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(
		|						,
		|						,
		|						Period,
		|						GuestGroup IN
		|							(SELECT
		|								ClientGroups.GuestGroup
		|							FROM
		|								ClientGroups AS ClientGroups)) AS CurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				TotalCurrentAccountsReceivableTurnovers.GuestGroup,
		|				TotalCurrentAccountsReceivableTurnovers.FolioCurrency,
		|				TotalCurrentAccountsReceivableTurnovers.SumReceipt - TotalCurrentAccountsReceivableTurnovers.CommissionSumReceipt,
		|				0,
		|				0,
		|				0
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(
		|						,
		|						,
		|						Period,
		|						GuestGroup IN
		|							(SELECT
		|								ClientGroups.GuestGroup
		|							FROM
		|								ClientGroups AS ClientGroups)) AS TotalCurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				AccountsReceivableForecastTurnovers.GuestGroup,
		|				AccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				0,
		|				0,
		|				AccountsReceivableForecastTurnovers.SalesTurnover - AccountsReceivableForecastTurnovers.CommissionSumTurnover
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(
		|						&qForecastPeriodFrom,
		|						&qForecastPeriodTo,
		|						Period,
		|						GuestGroup IN
		|							(SELECT
		|								ClientGroups.GuestGroup
		|							FROM
		|								ClientGroups AS ClientGroups)) AS AccountsReceivableForecastTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				TotalAccountsReceivableForecastTurnovers.GuestGroup,
		|				TotalAccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				TotalAccountsReceivableForecastTurnovers.SalesTurnover - TotalAccountsReceivableForecastTurnovers.CommissionSumTurnover,
		|				0,
		|				0
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(
		|						&qForecastPeriodFrom,
		|						&qForecastPeriodTo,
		|						Period,
		|						GuestGroup IN
		|							(SELECT
		|								ClientGroups.GuestGroup
		|							FROM
		|								ClientGroups AS ClientGroups)) AS TotalAccountsReceivableForecastTurnovers) AS GuestGroupSales
		|		
		|		GROUP BY
		|			GuestGroupSales.GuestGroup,
		|			GuestGroupSales.Currency) AS GuestGroupTotalSales
		|		ON GuestGroups.GuestGroup = GuestGroupTotalSales.GuestGroup
		|		LEFT JOIN (SELECT
		|			Payments.GuestGroup AS GuestGroup,
		|			Payments.AccountingCurrency AS PaymentCurrency,
		|			SUM(Payments.SumExpense) AS PaymentAmount
		|		FROM
		|			AccumulationRegister.CustomerAccounts.BalanceAndTurnovers(
		|					,
		|					,
		|					Period,
		|					RegisterRecordsAndPeriodBoundaries,
		|					GuestGroup IN
		|						(SELECT
		|							ClientGroups.GuestGroup
		|						FROM
		|							ClientGroups AS ClientGroups)) AS Payments
		|		
		|		GROUP BY
		|			Payments.GuestGroup,
		|			Payments.AccountingCurrency) AS GuestGroupPayments
		|		ON GuestGroups.GuestGroup = GuestGroupPayments.GuestGroup
		|
		|ORDER BY
		|	GuestGroups.CheckInDate,
		|	GuestGroups.GuestGroupCode";
		vQry.SetParameter("qHotel", vHotel);
		vQry.SetParameter("qHotelIsEmpty", Not ValueIsFilled(vHotel));
		vQry.SetParameter("qClient", vClientRef);
		
		vIsAllStatuses =  True;
		vIsActive = True;
		vIsCheckIn = True;
		
		If pStatusFilter <> Undefined Then
			vIsActive = pStatusFilter.IsActive;
			vIsCancelled = pStatusFilter.IsCancelled;
			
			If vIsActive And vIsCancelled Then
				vIsAllStatuses =  True;
			Else
				vIsAllStatuses =  False;
			EndIf;
			
			vIsCheckIn = pStatusFilter.IsCheckedIn;
		EndIf;
		vQry.SetParameter("qIsAllStatuses", vIsAllStatuses); 
		vQry.SetParameter("qIsActive", vIsActive);
		vQry.SetParameter("qIsCheckIn", vIsCheckIn);
		
		vForecastStartDate = tcOnServer.GetForecastStartDate(vHotel);
		vQry.SetParameter("qForecastPeriodFrom", vForecastStartDate);
		vQry.SetParameter("qForecastPeriodTo", '39991231235959');
		
		vGuestGroups = vQry.Execute().Unload();
		
		For Each vGuestGroupsRow In vGuestGroups Do
			// Build return object
			vGuestGroupDetails = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "GuestGroupDetails"));
			// Fill XDTO object attributes
			vGuestGroupDetails.GuestGroup = Format(vGuestGroupsRow.GuestGroup.Code, "ND=12; NFD=0; NZ=; NG=");
			vGuestGroupDetails.Customer = TrimAll(vGuestGroupsRow.Customer);
			vGuestGroupDetails.Contract = TrimAll(vGuestGroupsRow.Contract);
			vGuestGroupDetails.Agent = TrimAll(vGuestGroupsRow.Agent);
			If ValueIsFilled(vGuestGroupsRow.Status) Then
				vGuestGroupDetails.Status = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "ReservationStatuses", vGuestGroupsRow.Status);
				vGuestGroupDetails.StatusCode = TrimAll(vGuestGroupsRow.Status.Code);
				vGuestGroupDetails.StatusDescription = TrimAll(vGuestGroupsRow.Status.Description);
			Else
				vGuestGroupDetails.Status = "";
				vGuestGroupDetails.StatusCode = "";
				vGuestGroupDetails.StatusDescription = "";
			EndIf;
			vGuestGroupDetails.CheckInDate = vGuestGroupsRow.CheckInDate;
			vGuestGroupDetails.Duration = vGuestGroupsRow.Duration;
			vGuestGroupDetails.CheckOutDate = vGuestGroupsRow.CheckOutDate;
			vGuestGroupDetails.NumberOfPersons = vGuestGroupsRow.NumberOfPersons;
			vGuestGroupDetails.GuestFullName = TrimAll(vGuestGroupsRow.GuestFullName);
			vGuestGroupDetails.Phone = TrimAll(vGuestGroupsRow.Phone);
			vGuestGroupDetails.Email = TrimAll(vGuestGroupsRow.Email);
			vGuestGroupDetails.Remarks = Left(vGuestGroupsRow.Remarks, 4096);
			vGuestGroupDetails.Amount = vGuestGroupsRow.TotalSales;
			vGuestGroupDetails.Balance = vGuestGroupsRow.Sales - vGuestGroupsRow.PaymentAmount;
			If vGuestGroupsRow.Sales <> 0 And ValueIsFilled(vGuestGroupsRow.Currency) Then
				vGuestGroupDetails.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vGuestGroupsRow.Currency);
				vGuestGroupDetails.CurrencyCode = TrimAll(vGuestGroupsRow.CurrencyCode);
				vGuestGroupDetails.CurrencyDescription = TrimAll(vGuestGroupsRow.CurrencyDescription);
				vGuestGroupDetails.PaymentPercent = Round(vGuestGroupsRow.PaymentAmount/vGuestGroupsRow.Sales*100, 0);
			Else
				vGuestGroupDetails.Currency = "";
				vGuestGroupDetails.CurrencyCode = "";
				vGuestGroupDetails.CurrencyDescription = "";
				vGuestGroupDetails.PaymentPercent = 0;
			EndIf;   
			vGuestGroupDetails.CreateDate = vGuestGroupsRow.ReservationCreateDate;
			// Hotel
			vGuestGroupDetails.Hotel =  TrimAll(vGuestGroupsRow.HotelCode);
			vGuestGroupDetails.HotelCode =  TrimAll(vGuestGroupsRow.HotelDescription);
			// Add guest group to the return object
			vRetXDTO.GuestGroupDetails.Add(vGuestGroupDetails);
		EndDo;
	EndIf;
	
	Return vRetXDTO;
EndFunction // cmGetCientGuestGroupsList 

// -----------------------------------------------------------------------------
// Description: Cancels group reservation
// Parameters: Group code, Hotel code, External system code, Language code
// Return value: Error description as string
// -----------------------------------------------------------------------------
Function cmGetActiveReservations(pHotelCode, pGuestName = Undefined, pGuestGroup = Undefined, pExternalSystemCode, pLanguageCode = "RU") Export
	WriteLogEvent(NStr("en='Get active reservations';ru='Получить список действующих броней';de='Liste der aktiven Reservierungen'"), EventLogLevel.Information, , , 
	              NStr("en='External system code: ';ru='Код внешней системы: ';de='Code des externen Systems: '") + pExternalSystemCode + Chars.LF + 
	              NStr("en='Hotel code: ';ru='Код гостиницы: ';de='Code des Hotels: '") + pHotelCode + Chars.LF + 
	              NStr("en='Guest Name: ';ru='Имя гостя: ';de='Gastname: '") + pGuestName + Chars.LF +
				  NStr("en='Guest Group: ';ru='Группа гостей: ';de='Gastgruppe: '") + pGuestGroup + Chars.LF +
	              NStr("en='Language code: ';ru='Код языка: ';de='Sprachencode: '") + pLanguageCode);
	// Get language
	vLanguage = cmGetLanguageByCode(pLanguageCode);
	// Try to find hotel by name or code
	vHotel = cmGetHotelByCode(pHotelCode, pExternalSystemCode);
	// Create return object
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "Reservations"));
	// Get active reservations and group by them by guest group
	If vHotel <> Undefined And (ValueIsFilled(pGuestName) Or ValueIsFilled(pGuestGroup)) Then
		// Run query
		vQry = New Query();
		vQry.Text = 
		"SELECT DISTINCT
		|	Reservations.Ref AS Ref,
		|	Reservations.GuestGroup AS GuestGroup,
		|	Reservations.GuestGroup.Code AS GuestGroupCode,
		|	Reservations.Room AS Room,
		|	Reservations.Number AS Number,
		|	Reservations.ReservationStatus AS Status,
		|	Reservations.Guest AS Guest,
		|	Reservations.GuestFullName AS GuestFullName,
		|	Reservations.Phone AS Phone,
		|	Reservations.EMail AS Email,
		|	Reservations.CheckInDate AS CheckInDate,
		|	Reservations.Duration AS Duration,
		|	Reservations.CheckOutDate AS CheckOutDate,
		|	Reservations.NumberOfPersons AS NumberOfPersons,
		|	Reservations.RoomType AS RoomType,
		|	Reservations.AccommodationType AS AccommodationType,
		|	Reservations.RoomRate AS RoomRate,
		|	Reservations.ServicePackage AS ServicePackage,
		|	Reservations.RoomQuota AS RoomQuota,
		|	CAST(Reservations.Remarks AS STRING(1024)) AS Remarks,
		|	Reservations.Customer AS Customer,
		|	Reservations.Contract AS Contract,
		|	Reservations.Agent AS Agent,
		|	Reservations.AgentCommission AS AgentCommission,
		|	ISNULL(GuestGroupTotalSales.Sales, 0) AS Sales,
		|	GuestGroupTotalSales.Currency AS Currency,
		|	GuestGroupTotalSales.Currency.Code AS CurrencyCode,
		|	GuestGroupTotalSales.Currency.Description AS CurrencyDescription,
		|	ISNULL(GuestGroupPayments.PaymentAmount, 0) AS PaymentAmount,
		|	GuestGroupPayments.PaymentCurrency AS PaymentCurrency,
		|	GuestGroupPayments.PaymentCurrency.Code AS PaymentCurrencyCode
		|FROM
		|	Document.Reservation AS Reservations
		|		INNER JOIN (SELECT DISTINCT
		|			GuestReservations.GuestGroup AS GuestGroup,
		|			GuestReservations.Number AS Number,
		|			GuestReservations.Room AS Room
		|		FROM
		|			Document.Reservation AS GuestReservations
		|		WHERE
		|			GuestReservations.Posted
		|			AND GuestReservations.Hotel = &qHotel
		|			AND (GuestReservations.ReservationStatus.IsActive
		|					OR GuestReservations.ReservationStatus.IsPreliminary)
		|			AND (&qByGuestGroup
		|						AND GuestReservations.GuestGroup.Code = &qGuestGroup
		|					OR NOT &qByGuestGroup)
		|			AND (&qByGuestName
		|						AND GuestReservations.Guest.FullName LIKE &qFullName
		|					OR NOT &qByGuestName)) AS RoomReservations
		|		ON Reservations.GuestGroup = RoomReservations.GuestGroup
		|			AND Reservations.Room = RoomReservations.Room
		|			AND Reservations.Number = RoomReservations.Number
		|		LEFT JOIN (SELECT
		|			GuestGroupSales.GuestGroup AS GuestGroup,
		|			GuestGroupSales.Currency AS Currency,
		|			SUM(GuestGroupSales.SalesTurnover) + SUM(GuestGroupSales.SalesForecastTurnover) AS Sales
		|		FROM
		|			(SELECT
		|				CurrentAccountsReceivableTurnovers.GuestGroup AS GuestGroup,
		|				CurrentAccountsReceivableTurnovers.FolioCurrency AS Currency,
		|				CurrentAccountsReceivableTurnovers.SumReceipt - CurrentAccountsReceivableTurnovers.CommissionSumReceipt AS SalesTurnover,
		|				0 AS SalesForecastTurnover
		|			FROM
		|				AccumulationRegister.CurrentAccountsReceivable.Turnovers(, , Period, Hotel = &qHotel) AS CurrentAccountsReceivableTurnovers
		|			
		|			UNION ALL
		|			
		|			SELECT
		|				AccountsReceivableForecastTurnovers.GuestGroup,
		|				AccountsReceivableForecastTurnovers.FolioCurrency,
		|				0,
		|				AccountsReceivableForecastTurnovers.SalesTurnover - AccountsReceivableForecastTurnovers.CommissionSumTurnover
		|			FROM
		|				AccumulationRegister.AccountsReceivableForecast.Turnovers(&qForecastPeriodFrom, &qForecastPeriodTo, Period, Hotel = &qHotel) AS AccountsReceivableForecastTurnovers) AS GuestGroupSales
		|		
		|		GROUP BY
		|			GuestGroupSales.GuestGroup,
		|			GuestGroupSales.Currency) AS GuestGroupTotalSales
		|		ON Reservations.GuestGroup = GuestGroupTotalSales.GuestGroup
		|		LEFT JOIN (SELECT
		|			Payments.GuestGroup AS GuestGroup,
		|			Payments.AccountingCurrency AS PaymentCurrency,
		|			SUM(Payments.SumExpense) AS PaymentAmount
		|		FROM
		|			AccumulationRegister.CustomerAccounts.BalanceAndTurnovers(, , Period, RegisterRecordsAndPeriodBoundaries, Hotel = &qHotel) AS Payments
		|		
		|		GROUP BY
		|			Payments.GuestGroup,
		|			Payments.AccountingCurrency) AS GuestGroupPayments
		|		ON Reservations.GuestGroup = GuestGroupPayments.GuestGroup
		|WHERE
		|	Reservations.Posted
		|	AND Reservations.Hotel = &qHotel
		|	AND (Reservations.ReservationStatus.IsActive
		|			OR Reservations.ReservationStatus.IsPreliminary)
		|
		|ORDER BY
		|	Reservations.GuestGroup.Code,
		|	Reservations.CheckInDate,
		|	ISNULL(Reservations.Room.SortCode, 0),
		|	Reservations.Number,
		|	Reservations.AccommodationType.SortCode";
		vQry.SetParameter("qHotel", vHotel);
		vQry.SetParameter("qByGuestGroup", ValueIsFilled(pGuestGroup));
		vQry.SetParameter("qByGuestName", ValueIsFilled(pGuestName));
		vQry.SetParameter("qFullName", "%" + pGuestName + "%");
		vQry.SetParameter("qGuestGroup", ?(IsBlankString(pGuestGroup), 0, Number(pGuestGroup)));
		vForecastStartDate = tcOnServer.GetForecastStartDate(vHotel);
		vQry.SetParameter("qForecastPeriodFrom", vForecastStartDate);
		vQry.SetParameter("qForecastPeriodTo", '39991231235959');
		vReservations = vQry.Execute().Unload();
		For Each vReservationRow In vReservations Do
			// Build return object
			vXDTOReservationRow = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ReservationRow"));
			// Fill XDTO object attributes
			vXDTOReservationRow.URL 					= GetURL(vReservationRow.Ref);         
			vXDTOReservationRow.UUID 					= String(vReservationRow.Ref.UUID());
			vXDTOReservationRow.AgentCommission 		= vReservationRow.AgentCommission;
			vXDTOReservationRow.GroupSales 					= vReservationRow.Sales;
			vXDTOReservationRow.PaymentAmount 			= vReservationRow.PaymentAmount;
			
			If ValueIsFilled(vReservationRow.GuestGroupCode) Then
				vXDTOReservationRow.GuestGroup 				= Format(vReservationRow.GuestGroupCode, "ND=12; NFD=0; NZ=; NG=");
			EndIf;
			If ValueIsFilled(vReservationRow.Room) Then
				vXDTOReservationRow.Room 					= vReservationRow.Room.Description;
			EndIf;
			If ValueIsFilled(vReservationRow.Number) Then
				vXDTOReservationRow.Number 					= String(vReservationRow.Number);
			EndIf;
			If ValueIsFilled(vReservationRow.GuestFullName) Then
				vXDTOReservationRow.GuestFullName 			= vReservationRow.GuestFullName;
			EndIf;
			If ValueIsFilled(vReservationRow.Phone) Then
				vXDTOReservationRow.Phone 					= TrimAll(vReservationRow.Phone);
			EndIf;
			If ValueIsFilled(vReservationRow.Email) Then
				vXDTOReservationRow.Email 					= TrimAll(vReservationRow.Email);
			EndIf;
			If ValueIsFilled(vReservationRow.CheckInDate) Then
				vXDTOReservationRow.CheckInDate 			= vReservationRow.CheckInDate;
			EndIf;
			If ValueIsFilled(vReservationRow.CheckOutDate) Then
				vXDTOReservationRow.CheckOutDate 			= vReservationRow.CheckOutDate;
			EndIf;
			If ValueIsFilled(vReservationRow.Duration) Then
				vXDTOReservationRow.Duration 				= vReservationRow.Duration;
			EndIf;
			If ValueIsFilled(vReservationRow.NumberOfPersons) Then
				vXDTOReservationRow.NumberOfPersons 		= vReservationRow.NumberOfPersons;
			EndIf;
			If ValueIsFilled(vReservationRow.Remarks) Then
				vXDTOReservationRow.Remarks 				= Left(vReservationRow.Remarks, 4096);
			EndIf;
			If ValueIsFilled(vReservationRow.CurrencyDescription) Then
				vXDTOReservationRow.Currency 				= vReservationRow.CurrencyDescription;
			EndIf;
			If ValueIsFilled(vReservationRow.CurrencyCode) Then
				vXDTOReservationRow.CurrencyCode 			= vReservationRow.CurrencyCode;
			EndIf;	
			If ValueIsFilled(vReservationRow.PaymentCurrencyCode) Then
				vXDTOReservationRow.PaymentCurrencyCode 	= vReservationRow.PaymentCurrencyCode;
			EndIf;
			If ValueIsFilled(vReservationRow.Status) Then
				If ValueIsFilled(cmNStr(vReservationRow.Status.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.Status 			= vReservationRow.Status.DescriptionTranslations;
				Else
					vXDTOReservationRow.Status 			= vReservationRow.Status.Description;
				EndIf;
				vXDTOReservationRow.StatusCode 			= String(vReservationRow.Status.Code);
			EndIf;
			
			If ValueIsFilled(vReservationRow.RoomType) Then
				If ValueIsFilled(cmNStr(vReservationRow.RoomType.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.RoomType 		= cmNStr(vReservationRow.RoomType.DescriptionTranslations, pLanguageCode);
				Else
					vXDTOReservationRow.RoomType 		= vReservationRow.Status.Description;
				EndIf;
				vXDTOReservationRow.RoomTypeCode 		= vReservationRow.RoomType.Code;
			EndIf;
			
			If ValueIsFilled(vReservationRow.AccommodationType) Then
				If ValueIsFilled(cmNStr(vReservationRow.AccommodationType.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.AccommodationType 	= cmNStr(vReservationRow.AccommodationType.DescriptionTranslations, pLanguageCode);
				Else
					vXDTOReservationRow.AccommodationType 	= vReservationRow.AccommodationType.Description;
				EndIf;
				vXDTOReservationRow.AccommodationTypeCode 	= String(vReservationRow.AccommodationType.Code);
			EndIf;
			
			If ValueIsFilled(vReservationRow.RoomRate) Then
				If ValueIsFilled(cmNStr(vReservationRow.RoomRate.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.RoomRate 			= cmNStr(vReservationRow.RoomRate.DescriptionTranslations, pLanguageCode);
				Else
					vXDTOReservationRow.RoomRate 			= vReservationRow.RoomRate.Description;
				EndIf;
				vXDTOReservationRow.RoomRateCode 			= String(vReservationRow.RoomRate.Code);
			EndIf;
			
			If ValueIsFilled(vReservationRow.ServicePackage) Then
				If ValueIsFilled(cmNStr(vReservationRow.ServicePackage.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.ServicePackage 			= cmNStr(vReservationRow.ServicePackage.DescriptionTranslations, pLanguageCode);
				Else
					vXDTOReservationRow.ServicePackage 			= vReservationRow.ServicePackage.Description;
				EndIf;
				vXDTOReservationRow.ServicePackageCode 			= String(vReservationRow.ServicePackage.Code);
			EndIf;
			
			If ValueIsFilled(vReservationRow.RoomQuota) Then
				vXDTOReservationRow.RoomQuota		 			= vReservationRow.RoomQuota.Description;
				vXDTOReservationRow.RoomQuotaCode 				= String(vReservationRow.RoomQuota.Code);
			EndIf;
			
			If ValueIsFilled(vReservationRow.Customer) Then
				If ValueIsFilled(vReservationRow.Customer.LegacyName) Then
					vXDTOReservationRow.Customer 			= vReservationRow.Customer.LegacyName;
				Else
					vXDTOReservationRow.Customer 			= vReservationRow.Customer.Description;
				EndIf;
			EndIf;
			
			If ValueIsFilled(vReservationRow.Contract) Then
				vXDTOReservationRow.Contract 				= vReservationRow.Contract.Description;
			EndIf;
			
			If ValueIsFilled(vReservationRow.Agent) Then
				If ValueIsFilled(vReservationRow.Agent.LegacyName) Then
					vXDTOReservationRow.Agent 					= vReservationRow.Agent.LegacyName;
				EndIf;
			EndIf;			
			
			If ValueIsFilled(vReservationRow.PaymentCurrency) Then
				If ValueIsFilled(cmNStr(vReservationRow.PaymentCurrency.DescriptionTranslations, pLanguageCode)) Then
					vXDTOReservationRow.PaymentCurrency 			= cmNStr(vReservationRow.PaymentCurrency.DescriptionTranslations, pLanguageCode);
				Else
					vXDTOReservationRow.PaymentCurrency 			= vReservationRow.PaymentCurrency.Description;
				EndIf;
				vXDTOReservationRow.PaymentCurrencyCode 			= String(vReservationRow.PaymentCurrency.Code);
			EndIf;
			
			vRetXDTO.ReservationRow.Add(vXDTOReservationRow);
		EndDo;
	EndIf;	
	Return vRetXDTO;
EndFunction // cmGetActiveGroupsList 

// -----------------------------------------------------------------------------
// Description: Returns list of hotels available in database
// Parameters: External system code, Language code
// Return value: Hotel list XDTO object
// -----------------------------------------------------------------------------
Function cmGetHotelsList(pExternalSystemCode, pLanguageCode) Export
	// Run query to get hotels
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	Hotels.Ref AS Ref,
	|	Hotels.Code AS Code,
	|	Hotels.Description AS Description,
	|	Hotels.Language.Code AS LanguageCode
	|FROM
	|	Catalog.Hotels AS Hotels
	|WHERE
	|	NOT Hotels.IsFolder
	|	AND NOT Hotels.DeletionMark";
	vHotels = vQry.Execute().Unload();
	vRetXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "Hotels"));
	For Each vHotel In vHotels Do
		vRetXDTO.HotelParameters.Add(cmGetHotelParameters(vHotel.Code, pExternalSystemCode, pLanguageCode, "XDTO"));
	EndDo;
	Return vRetXDTO;
EndFunction // cmGetHotelsList

// -----------------------------------------------------------------------------
// Description: Returns list of room rates available for online booking
// Parameters: Hotel, period, boolean flag indicating that hidden room rates should be added
// Return value: Value list with room rate items value list
// -----------------------------------------------------------------------------
Function cmGetOnlineRoomRates(pHotel, pCheckInDate, pCheckOutDate, pClientIsAuthorized = False, pDoNotCheckLimits = False) Export
	// Build and run query
	vQry = New Query;
	vQry.Text = 
	"SELECT
	|	RoomRates.Ref AS RoomRate
	|FROM
	|	Catalog.RoomRates AS RoomRates
	|WHERE
	|	(RoomRates.Hotel = &qHotel
	|			OR RoomRates.Hotel = &qEmptyHotel)
	|	AND NOT RoomRates.IsFolder
	|	AND NOT RoomRates.DeletionMark
	|	AND (RoomRates.IsOnlineRate OR RoomRates.IsHiddenRateForAuthorizedClients AND &qClientIsAuthorized)
	|
	|ORDER BY
	|	RoomRates.SortCode";
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qEmptyHotel", Catalogs.Hotels.EmptyRef());
	vQry.SetParameter("qClientIsAuthorized", pClientIsAuthorized);
	vRoomRates = vQry.Execute().Unload();
	vRoomRatesArray = vRoomRates.UnloadColumn("RoomRate");
	vRoomRatesList = New ValueList();
	If vRoomRatesArray.Count() > 0 Then
		vRoomRatesList.LoadValues(vRoomRatesArray);
	EndIf;
	If Not pDoNotCheckLimits Then
		If pCheckInDate <> Undefined And pCheckOutDate <> Undefined And BegOfDay(pCheckOutDate) > BegOfDay(pCheckInDate) Then
			vRRItemsToDeleteArray = New Array();
			For Each vRRItem In vRoomRatesList Do
				vRoomRate = vRRItem.Value;
				If ValueIsFilled(vRoomRate.DateValidFrom) Or ValueIsFilled(vRoomRate.DateValidTo) And vRoomRate.DateValidTo > vRoomRate.DateValidFrom Then
					If BegOfDay(pCheckInDate) < BegOfDay(vRoomRate.DateValidFrom) Or (BegOfDay(pCheckOutDate) > BegOfDay(vRoomRate.DateValidTo) And ValueIsFilled(vRoomRate.DateValidTo)) Then
						vRRItemsToDeleteArray.Add(vRRItem);
					EndIf;
				EndIf;
			EndDo;
			For Each vRRItemToDelete In vRRItemsToDeleteArray Do
				vRoomRatesList.Delete(vRRItemToDelete);
			EndDo;
		EndIf;
	EndIf;
	Return vRoomRatesList;
EndFunction // cmGetOnlineRoomRates

