Function cmGetReturnByExternalSystemCode(pHotel, pPaymentExternalCode) Export
	vPaymentRef = Undefined;
	If Not ValueIsFilled(pPaymentExternalCode) Then
		Return vPaymentRef;
	EndIf;
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Returns.Ref AS Ref
	|FROM
	|	Document.Return AS Returns
	|WHERE
	|	Returns.ExternalCode = &qExternalCode
	|	AND Returns.Hotel = &qHotel
	|	AND Returns.Posted
	|
	|ORDER BY
