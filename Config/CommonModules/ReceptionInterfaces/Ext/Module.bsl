Function cmGetReservationExtraCharges(pReservationRef) Export
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Charges.Service,
	|	Charges.Price,
	|	Charges.Quantity,
	|	Charges.Sum,
	|	Charges.Date,
	|	Charges.Remarks,
	|	Charges.Discount,
	|	Charges.DiscountSum,
	|	Charges.FolioCurrency AS Currency,
	|	Orders.Ref AS Order,
	|	Storno.Ref
	|FROM
	|	Document.Charge AS Charges
	|		LEFT JOIN Document.Storno AS Storno
	|		ON (Storno.ParentCharge = Charges.Ref)
	|			AND (Storno.Posted)
	|		LEFT JOIN Document.Order AS Orders
