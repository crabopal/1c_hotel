											If ValueIsFilled(vServicesRow.PaymentSection) Then
												vPSRow = vPaymentObj.PaymentSections.Find(vServicesRow.PaymentSection, "PaymentSection");
												If vPSRow <> Undefined Then
													vRowSum = Min(vServicesRow.Sum, vCurSum);
													
													vPSRow.Sum = vPSRow.Sum + vRowSum;

													vCurSum = vCurSum - vRowSum;
												EndIf;
											EndIf;
