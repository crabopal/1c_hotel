EndFunction // cmGetReservationExtraCharges

// -----------------------------------------------------------------------------
// Description: This API is used to retrieve daily vacant room balances for the 
//              given room quota or room inventory in total
// Parameters: Hotel, Room type, Customer, Contract, Agent, Room quota, Period from,
//             Period to
// Return value: Value table with vacant room balances grouped by hotel, room type and day
// -----------------------------------------------------------------------------
Function cmGetRoomQuotaBalances(pHotel, pRoomType, pCustomer, pContract, pAgent, pRoomQuota, pPeriodFrom, pPeriodTo, pGetVacantRoomsAtMidnight = False) Export
	vQry = New Query();
	If Not pGetVacantRoomsAtMidnight Then
		vQry.Text = 
		"SELECT
		|	RoomQuotas.Hotel AS Hotel,
		|	RoomQuotas.RoomType AS RoomType,
		|	RoomQuotas.RoomQuota AS RoomQuota,
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) AS Period,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv
		|	END AS RoomsVacant,
		|	SUM(RoomQuotas.RoomsVacant) AS VacantRooms,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|	END AS BedsVacant,
		|	SUM(RoomQuotas.BedsVacant) AS VacantBeds,
		|	SUM(RoomQuotas.RoomsInQuota) AS RoomsInQuota,
		|	SUM(RoomQuotas.BedsInQuota) AS BedsInQuota,
		|	SUM(RoomQuotas.RoomsChargedInQuota) AS RoomsChargedInQuota,
		|	SUM(RoomQuotas.BedsChargedInQuota) AS BedsChargedInQuota,
		|	SUM(RoomQuotas.RoomsReserved) AS RoomsReserved,
		|	SUM(RoomQuotas.BedsReserved) AS BedsReserved,
		|	SUM(RoomQuotas.InHouseRooms) AS InHouseRooms,
		|	SUM(RoomQuotas.InHouseBeds) AS InHouseBeds,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv
		|	END AS RoomsRemains,
		|	SUM(RoomQuotas.RoomsRemains) AS RemainsRooms,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|	END AS BedsRemains,
		|	SUM(RoomQuotas.BedsRemains) AS RemainsBeds,
		|	MAX(RoomQuotas.CounterClosingBalance) AS CounterClosingBalance,
		|	MAX(RoomQuotas.AllotmentCounterClosingBalance) AS AllotmentCounterClosingBalance
		|FROM
		|	(SELECT
		|		RoomTypes.Owner AS Hotel,
		|		RoomTypes.Ref AS RoomType,
		|		&qEmptyRoomQuota AS RoomQuota,
		|		RoomInventory.Period AS Period,
		|		RoomInventory.RoomsVacant AS RoomsVacant,
		|		RoomInventory.BedsVacant AS BedsVacant,
		|		RoomInventory.CounterClosingBalance AS CounterClosingBalance,
		|		NULL AS RoomsInQuota,
		|		NULL AS BedsInQuota,
		|		NULL AS RoomsChargedInQuota,
		|		NULL AS BedsChargedInQuota,
		|		NULL AS RoomsReserved,
		|		NULL AS BedsReserved,
		|		NULL AS InHouseRooms,
		|		NULL AS InHouseBeds,
		|		NULL AS RoomsRemains,
		|		NULL AS BedsRemains,
		|		NULL AS AllotmentCounterClosingBalance
		|	FROM
		|		Catalog.RoomTypes AS RoomTypes
		|			LEFT JOIN (SELECT
		|				RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|				BEGINOFPERIOD(DATEADD(RoomInventoryBalanceAndTurnovers.Period, SECOND, &qShiftInSeconds), DAY) AS Period,
		|				MAX(RoomInventoryBalanceAndTurnovers.CounterClosingBalance) AS CounterClosingBalance,
		|				MIN(RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance) AS RoomsVacant,
		|				MIN(RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance) AS BedsVacant
		|			FROM
		|				AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|						&qPeriodFrom,
		|						&qPeriodTo,
		|						MINUTE,
		|						RegisterRecordsAndPeriodBoundaries,
		|						(Hotel IN HIERARCHY (&qHotel)
		|							OR &qHotelIsEmpty)
		|							AND (RoomType IN HIERARCHY (&qRoomType)
		|								OR &qRoomTypeIsEmpty)) AS RoomInventoryBalanceAndTurnovers
		|			
		|			GROUP BY
		|				RoomInventoryBalanceAndTurnovers.RoomType,
		|				BEGINOFPERIOD(DATEADD(RoomInventoryBalanceAndTurnovers.Period, SECOND, &qShiftInSeconds), DAY)) AS RoomInventory
		|			ON (RoomInventory.RoomType = RoomTypes.Ref)
		|	WHERE
		|		&qRoomQuotaIsEmpty
		|		AND NOT RoomTypes.DeletionMark
		|		AND NOT RoomTypes.IsFolder
		|		AND NOT RoomTypes.IsVirtual
		|		AND (RoomTypes.Owner IN HIERARCHY (&qHotel)
		|				OR &qHotelIsEmpty)
		|		AND (RoomTypes.Ref IN HIERARCHY (&qRoomType)
		|				OR &qRoomTypeIsEmpty)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		RoomTypes.Owner,
		|		RoomTypes.Ref,
		|		RoomQuotaSales.RoomQuota,
		|		RoomQuotaSales.Period,
		|		NULL,
		|		NULL,
		|		NULL,
		|		RoomQuotaSales.RoomsInQuota,
		|		RoomQuotaSales.BedsInQuota,
		|		RoomQuotaSales.RoomsChargedInQuota,
		|		RoomQuotaSales.BedsChargedInQuota,
		|		RoomQuotaSales.RoomsReserved,
		|		RoomQuotaSales.BedsReserved,
		|		RoomQuotaSales.InHouseRooms,
		|		RoomQuotaSales.InHouseBeds,
		|		RoomQuotaSales.RoomsRemains,
		|		RoomQuotaSales.BedsRemains,
		|		RoomQuotaSales.AllotmentCounterClosingBalance
		|	FROM
		|		Catalog.RoomTypes AS RoomTypes
		|			LEFT JOIN (SELECT
		|				RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomQuota AS RoomQuota,
		|				RoomQuotaSalesBalanceAndTurnovers.Period AS Period,
		|				RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance AS AllotmentCounterClosingBalance,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance AS RoomsInQuota,
		|				RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance AS BedsInQuota,
		|				CASE
		|					WHEN ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomQuota.DoCharge, FALSE)
		|						THEN RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance
		|					ELSE 0
		|				END AS RoomsChargedInQuota,
		|				CASE
		|					WHEN ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomQuota.DoCharge, FALSE)
		|						THEN RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance
		|					ELSE 0
		|				END AS BedsChargedInQuota,
		|				-RoomQuotaSalesBalanceAndTurnovers.RoomsReservedClosingBalance AS RoomsReserved,
		|				-RoomQuotaSalesBalanceAndTurnovers.BedsReservedClosingBalance AS BedsReserved,
		|				-RoomQuotaSalesBalanceAndTurnovers.InHouseRoomsClosingBalance AS InHouseRooms,
		|				-RoomQuotaSalesBalanceAndTurnovers.InHouseBedsClosingBalance AS InHouseBeds,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance AS RoomsRemains,
		|				RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance AS BedsRemains
		|			FROM
		|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|						&qPeriodFrom,
		|						&qPeriodTo,
		|						Day,
		|						,
		|						(Hotel IN HIERARCHY (&qHotel)
		|							OR &qHotelIsEmpty)
		|							AND (RoomType IN HIERARCHY (&qRoomType)
		|								OR &qRoomTypeIsEmpty)
		|							AND RoomQuota IN HIERARCHY (&qRoomQuota)
		|							AND (RoomQuota.Agent IN HIERARCHY (&qAgent)
		|								OR &qAgentIsEmpty)
		|							AND (RoomQuota.Customer IN HIERARCHY (&qCustomer)
		|								OR &qCustomerIsEmpty)
		|							AND (RoomQuota.Contract = &qContract
		|								OR &qContractIsEmpty)) AS RoomQuotaSalesBalanceAndTurnovers) AS RoomQuotaSales
		|			ON (RoomQuotaSales.RoomType = RoomTypes.Ref)
		|	WHERE
		|		NOT &qRoomQuotaIsEmpty
		|		AND NOT RoomTypes.DeletionMark
		|		AND NOT RoomTypes.IsFolder
		|		AND NOT RoomTypes.IsVirtual
		|		AND (RoomTypes.Owner IN HIERARCHY (&qHotel)
		|				OR &qHotelIsEmpty)
		|		AND (RoomTypes.Ref IN HIERARCHY (&qRoomType)
		|				OR &qRoomTypeIsEmpty)) AS RoomQuotas
		|WHERE
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) >= &qDateFrom
		|	AND BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) <= &qDateTo
		|
		|GROUP BY
		|	RoomQuotas.Hotel,
		|	RoomQuotas.RoomType,
		|	RoomQuotas.RoomQuota,
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY),
		|	RoomQuotas.RoomType.RoomsReserv,
		|	RoomQuotas.RoomType.MaxRoomsForChannels,
		|	RoomQuotas.RoomType.NumberOfBedsPerRoom
		|
		|ORDER BY
		|	RoomQuotas.Hotel.SortCode,
		|	RoomQuotas.RoomType.SortCode,
		|	RoomQuotas.RoomQuota.Code,
		|	Period";
	Else
		vQry.Text = 
		"SELECT                                   
		|	RoomQuotas.Hotel AS Hotel,
		|	RoomQuotas.RoomType AS RoomType,
		|	RoomQuotas.RoomQuota AS RoomQuota,
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) AS Period,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.RoomsVacant) - RoomQuotas.RoomType.RoomsReserv
		|	END AS RoomsVacant,
		|	SUM(RoomQuotas.RoomsVacant) AS VacantRooms,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.BedsVacant) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|	END AS BedsVacant,
		|	SUM(RoomQuotas.BedsVacant) AS VacantBeds,
		|	SUM(RoomQuotas.RoomsInQuota) AS RoomsInQuota,
		|	SUM(RoomQuotas.BedsInQuota) AS BedsInQuota,
		|	SUM(RoomQuotas.RoomsChargedInQuota) AS RoomsChargedInQuota,
		|	SUM(RoomQuotas.BedsChargedInQuota) AS BedsChargedInQuota,
		|	SUM(RoomQuotas.RoomsReserved) AS RoomsReserved,
		|	SUM(RoomQuotas.BedsReserved) AS BedsReserved,
		|	SUM(RoomQuotas.InHouseRooms) AS InHouseRooms,
		|	SUM(RoomQuotas.InHouseBeds) AS InHouseBeds,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.RoomsRemains) - RoomQuotas.RoomType.RoomsReserv
		|	END AS RoomsRemains,
		|	SUM(RoomQuotas.RoomsRemains) AS RemainsRooms,
		|	CASE
		|		WHEN RoomQuotas.RoomType.MaxRoomsForChannels <> 0
		|			THEN CASE
		|					WHEN SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv > RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|						THEN RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.MaxRoomsForChannels
		|					ELSE SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|				END
		|		ELSE SUM(RoomQuotas.BedsRemains) - RoomQuotas.RoomType.NumberOfBedsPerRoom * RoomQuotas.RoomType.RoomsReserv
		|	END AS BedsRemains,
		|	SUM(RoomQuotas.BedsRemains) AS RemainsBeds,
		|	MAX(RoomQuotas.CounterClosingBalance) AS CounterClosingBalance,
		|	MAX(RoomQuotas.AllotmentCounterClosingBalance) AS AllotmentCounterClosingBalance
		|FROM
		|	(SELECT
		|		RoomTypes.Owner AS Hotel,
		|		RoomTypes.Ref AS RoomType,
		|		&qEmptyRoomQuota AS RoomQuota,
		|		RoomInventory.Period AS Period,
		|		RoomInventory.RoomsVacant AS RoomsVacant,
		|		RoomInventory.BedsVacant AS BedsVacant,
		|		RoomInventory.CounterClosingBalance AS CounterClosingBalance,
		|		NULL AS RoomsInQuota,
		|		NULL AS BedsInQuota,
		|		NULL AS RoomsChargedInQuota,
		|		NULL AS BedsChargedInQuota,
		|		NULL AS RoomsReserved,
		|		NULL AS BedsReserved,
		|		NULL AS InHouseRooms,
		|		NULL AS InHouseBeds,
		|		NULL AS RoomsRemains,
		|		NULL AS BedsRemains,
		|		NULL AS AllotmentCounterClosingBalance
		|	FROM
		|		Catalog.RoomTypes AS RoomTypes
		|			LEFT JOIN (SELECT
		|				RoomInventoryBalanceAndTurnovers.RoomType AS RoomType,
		|				RoomInventoryBalanceAndTurnovers.Period AS Period,
		|				RoomInventoryBalanceAndTurnovers.CounterClosingBalance AS CounterClosingBalance,
		|				RoomInventoryBalanceAndTurnovers.RoomsVacantClosingBalance AS RoomsVacant,
		|				RoomInventoryBalanceAndTurnovers.BedsVacantClosingBalance AS BedsVacant
		|			FROM
		|				AccumulationRegister.RoomInventory.BalanceAndTurnovers(
		|						&qPeriodFrom,
		|						&qPeriodTo,
		|						DAY,
		|						,
		|						(Hotel IN HIERARCHY (&qHotel)
		|							OR &qHotelIsEmpty)
		|							AND (RoomType IN HIERARCHY (&qRoomType)
		|								OR &qRoomTypeIsEmpty)) AS RoomInventoryBalanceAndTurnovers) AS RoomInventory
		|			ON (RoomInventory.RoomType = RoomTypes.Ref)
		|	WHERE
		|		&qRoomQuotaIsEmpty
		|		AND NOT RoomTypes.DeletionMark
		|		AND NOT RoomTypes.IsFolder
		|		AND NOT RoomTypes.IsVirtual
		|		AND (RoomTypes.Owner IN HIERARCHY (&qHotel)
		|				OR &qHotelIsEmpty)
		|		AND (RoomTypes.Ref IN HIERARCHY (&qRoomType)
		|				OR &qRoomTypeIsEmpty)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		RoomTypes.Owner,
		|		RoomTypes.Ref,
		|		RoomQuotaSales.RoomQuota,
		|		RoomQuotaSales.Period,
		|		NULL,
		|		NULL,
		|		NULL,
		|		RoomQuotaSales.RoomsInQuota,
		|		RoomQuotaSales.BedsInQuota,
		|		RoomQuotaSales.RoomsChargedInQuota,
		|		RoomQuotaSales.BedsChargedInQuota,
		|		RoomQuotaSales.RoomsReserved,
		|		RoomQuotaSales.BedsReserved,
		|		RoomQuotaSales.InHouseRooms,
		|		RoomQuotaSales.InHouseBeds,
		|		RoomQuotaSales.RoomsRemains,
		|		RoomQuotaSales.BedsRemains,
		|		RoomQuotaSales.AllotmentCounterClosingBalance
		|	FROM
		|		Catalog.RoomTypes AS RoomTypes
		|			LEFT JOIN (SELECT
		|				RoomQuotaSalesBalanceAndTurnovers.RoomType AS RoomType,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomQuota AS RoomQuota,
		|				RoomQuotaSalesBalanceAndTurnovers.Period AS Period,
		|				RoomQuotaSalesBalanceAndTurnovers.CounterClosingBalance AS AllotmentCounterClosingBalance,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance AS RoomsInQuota,
		|				RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance AS BedsInQuota,
		|				CASE
		|					WHEN ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomQuota.DoCharge, FALSE)
		|						THEN RoomQuotaSalesBalanceAndTurnovers.RoomsInQuotaClosingBalance
		|					ELSE 0
		|				END AS RoomsChargedInQuota,
		|				CASE
		|					WHEN ISNULL(RoomQuotaSalesBalanceAndTurnovers.RoomQuota.DoCharge, FALSE)
		|						THEN RoomQuotaSalesBalanceAndTurnovers.BedsInQuotaClosingBalance
		|					ELSE 0
		|				END AS BedsChargedInQuota,
		|				-RoomQuotaSalesBalanceAndTurnovers.RoomsReservedClosingBalance AS RoomsReserved,
		|				-RoomQuotaSalesBalanceAndTurnovers.BedsReservedClosingBalance AS BedsReserved,
		|				-RoomQuotaSalesBalanceAndTurnovers.InHouseRoomsClosingBalance AS InHouseRooms,
		|				-RoomQuotaSalesBalanceAndTurnovers.InHouseBedsClosingBalance AS InHouseBeds,
		|				RoomQuotaSalesBalanceAndTurnovers.RoomsRemainsClosingBalance AS RoomsRemains,
		|				RoomQuotaSalesBalanceAndTurnovers.BedsRemainsClosingBalance AS BedsRemains
		|			FROM
		|				AccumulationRegister.RoomQuotaSales.BalanceAndTurnovers(
		|						&qPeriodFrom,
		|						&qPeriodTo,
		|						DAY,
		|						,
		|						(Hotel IN HIERARCHY (&qHotel)
		|							OR &qHotelIsEmpty)
		|							AND (RoomType IN HIERARCHY (&qRoomType)
		|								OR &qRoomTypeIsEmpty)
		|							AND RoomQuota IN HIERARCHY (&qRoomQuota)
		|							AND (RoomQuota.Agent IN HIERARCHY (&qAgent)
		|								OR &qAgentIsEmpty)
		|							AND (RoomQuota.Customer IN HIERARCHY (&qCustomer)
		|								OR &qCustomerIsEmpty)
		|							AND (RoomQuota.Contract = &qContract
		|								OR &qContractIsEmpty)) AS RoomQuotaSalesBalanceAndTurnovers) AS RoomQuotaSales
		|			ON (RoomQuotaSales.RoomType = RoomTypes.Ref)
		|	WHERE
		|		NOT &qRoomQuotaIsEmpty
		|		AND NOT RoomTypes.DeletionMark
		|		AND NOT RoomTypes.IsFolder
		|		AND NOT RoomTypes.IsVirtual
		|		AND (RoomTypes.Owner IN HIERARCHY (&qHotel)
		|				OR &qHotelIsEmpty)
		|		AND (RoomTypes.Ref IN HIERARCHY (&qRoomType)
		|				OR &qRoomTypeIsEmpty)) AS RoomQuotas
		|WHERE
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) >= &qDateFrom
		|	AND BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY) <= &qDateTo
		|
		|GROUP BY
		|	RoomQuotas.Hotel,
		|	RoomQuotas.RoomType,
		|	RoomQuotas.RoomQuota,
		|	BEGINOFPERIOD(ISNULL(RoomQuotas.Period, &qEmptyDate), DAY),
		|	RoomQuotas.RoomType.RoomsReserv,
		|	RoomQuotas.RoomType.MaxRoomsForChannels,
		|	RoomQuotas.RoomType.NumberOfBedsPerRoom
		|
		|ORDER BY
		|	RoomQuotas.Hotel.SortCode,
		|	RoomQuotas.RoomType.SortCode,
		|	RoomQuotas.RoomQuota.Code,
		|	Period";
	EndIf;
	vQry.SetParameter("qHotel", pHotel);
	vQry.SetParameter("qHotelIsEmpty", Not ValueIsFilled(pHotel));
	vQry.SetParameter("qRoomType", pRoomType);
	vQry.SetParameter("qRoomTypeIsEmpty", Not ValueIsFilled(pRoomType));
	vQry.SetParameter("qCustomer", pCustomer);
	vQry.SetParameter("qCustomerIsEmpty", Not ValueIsFilled(pCustomer));
	vQry.SetParameter("qContract", pContract);
	vQry.SetParameter("qContractIsEmpty", Not ValueIsFilled(pContract));
	vQry.SetParameter("qAgent", pAgent);
	vQry.SetParameter("qAgentIsEmpty", Not ValueIsFilled(pAgent));
	vQry.SetParameter("qRoomQuota", pRoomQuota);
	vQry.SetParameter("qRoomQuotaIsEmpty", Not ValueIsFilled(pRoomQuota));
	vQry.SetParameter("qEmptyRoomQuota", Catalogs.RoomQuotas.EmptyRef());
	vQry.SetParameter("qEmptyDate", '00010101');
	vRoomRate = Undefined;
	If ValueIsFilled(pRoomQuota) And Not pRoomQuota.IsFolder And ValueIsFilled(pRoomQuota.RoomRate) Then
		vRoomRate = pRoomQuota.RoomRate;
	Else
		If ValueIsFilled(pHotel) And ValueIsFilled(pHotel.RoomRate) Then
			vRoomRate = pHotel.RoomRate;
		EndIf;
	EndIf;
	vShiftInSeconds = 0;
	If ValueIsFilled(vRoomRate) And ValueIsFilled(vRoomRate.ReferenceHour) Then
		vShiftInSeconds = -(vRoomRate.ReferenceHour - BegOfDay(vRoomRate.ReferenceHour));
	Else			
		vShiftInSeconds = -43200;
	EndIf;
	vQry.SetParameter("qShiftInSeconds", vShiftInSeconds);
	vQry.SetParameter("qPeriodFrom", BegOfDay(pPeriodFrom) - vShiftInSeconds);
	vQry.SetParameter("qPeriodTo", EndOfDay(pPeriodTo) - vShiftInSeconds);
	vQry.SetParameter("qDateFrom", BegOfDay(pPeriodFrom));
	vQry.SetParameter("qDateTo", BegOfDay(pPeriodTo));
	vQryRes = vQry.Execute().Unload();
	vQryRes.GroupBy("Hotel, RoomType, Period", "RoomsVacant, VacantRooms, BedsVacant, VacantBeds, RoomsInQuota, BedsInQuota, " + 
	                                           "RoomsChargedInQuota, BedsChargedInQuota, RoomsReserved, BedsReserved, " + 
	                                           "InHouseRooms, InHouseBeds, RoomsRemains, RemainsRooms, BedsRemains, RemainsBeds");
	Return vQryRes;
EndFunction // cmGetRoomQuotaBalances

// -----------------------------------------------------------------------------
Procedure GetDayAccommodationTypePrice(pPeriod, pPrices, pCalendarDayType, pRoomType, 
                                       pSingleAccommodationType, pSingleAccommodationTemplate, rSingleAccommodationTypePrice, rSingleAccommodationTypePriceCurrency,
                                       pDoubleAccommodationType, pDoubleAccommodationTemplate, rDoubleAccommodationTypePrice, rDoubleAccommodationTypePriceCurrency, 
                                       pTripleAccommodationType, pTripleAccommodationTemplate, rTripleAccommodationTypePrice, rTripleAccommodationTypePriceCurrency, 
                                       pQuadleAccommodationType, pQuadleAccommodationTemplate, rQuadleAccommodationTypePrice, rQuadleAccommodationTypePriceCurrency, 
                                       pBeds5AccommodationType, pBeds5AccommodationTemplate, rBeds5AccommodationTypePrice, rBeds5AccommodationTypePriceCurrency, 
                                       pBeds6AccommodationType, pBeds6AccommodationTemplate, rBeds6AccommodationTypePrice, rBeds6AccommodationTypePriceCurrency, 
                                       pBeds7AccommodationType, pBeds7AccommodationTemplate, rBeds7AccommodationTypePrice, rBeds7AccommodationTypePriceCurrency, 
                                       pBeds8AccommodationType, pBeds8AccommodationTemplate, rBeds8AccommodationTypePrice, rBeds8AccommodationTypePriceCurrency, 
                                       pExtraBedAccommodationType, rExtraBedAccommodationTypePrice, rExtraBedAccommodationTypePriceCurrency,
                                       pBabyAccommodationType, rBabyAccommodationTypePrice, rBabyAccommodationTypePriceCurrency, 
                                       pChildAccommodationType, rChildAccommodationTypePrice, rChildAccommodationTypePriceCurrency, 
                                       pTeenAccommodationType, rTeenAccommodationTypePrice, rTeenAccommodationTypePriceCurrency, 
                                       pExtraBabyAccommodationType, rExtraBabyAccommodationTypePrice, rExtraBabyAccommodationTypePriceCurrency, 
                                       pExtraChildAccommodationType, rExtraChildAccommodationTypePrice, rExtraChildAccommodationTypePriceCurrency, 
                                       pExtraTeenAccommodationType, rExtraTeenAccommodationTypePrice, rExtraTeenAccommodationTypePriceCurrency)
	// Process single accommodation type
	vAccountingDate = BegOfDay(pPeriod);
	vUseTemplates = False;
	If pSingleAccommodationTemplate <> Undefined Or pDoubleAccommodationTemplate <> Undefined Or 
	   pTripleAccommodationTemplate <> Undefined Or pQuadleAccommodationTemplate <> Undefined Or
	   pBeds5AccommodationTemplate <> Undefined Or pBeds6AccommodationTemplate <> Undefined Or
	   pBeds7AccommodationTemplate <> Undefined Or pBeds8AccommodationTemplate <> Undefined Then
		vUseTemplates = True;
	EndIf;
	vAccTypeCount = 1;
	rAccommodationTypePrice = 0;
	rAccommodationTypePriceCurrency = Catalogs.Currencies.EmptyRef();
	If pPrices.Count() > 0 And 
	  (ValueIsFilled(pSingleAccommodationType) Or pSingleAccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pDoubleAccommodationType) Or pDoubleAccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pTripleAccommodationType) Or pTripleAccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pQuadleAccommodationType) Or pQuadleAccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pBeds5AccommodationType) Or pBeds6AccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pBeds7AccommodationType) Or pBeds8AccommodationTemplate <> Undefined Or 
	   ValueIsFilled(pExtraBedAccommodationType) Or 
	   ValueIsFilled(pBabyAccommodationType) Or ValueIsFilled(pChildAccommodationType) Or ValueIsFilled(pTeenAccommodationType) Or 
	   ValueIsFilled(pExtraBabyAccommodationType) Or ValueIsFilled(pExtraChildAccommodationType) Or ValueIsFilled(pExtraTeenAccommodationType)) Then
		// Get suitable prices
		For Each vPricesRow In pPrices Do
			If (Not ValueIsFilled(vPricesRow.AccountingDate) Or ValueIsFilled(vPricesRow.AccountingDate) And vPricesRow.AccountingDate = vAccountingDate) And 
			   (Not ValueIsFilled(vPricesRow.CalendarDayType) Or ValueIsFilled(vPricesRow.CalendarDayType) And vPricesRow.CalendarDayType = pCalendarDayType) And 
			   (Not ValueIsFilled(vPricesRow.RoomType) Or ValueIsFilled(vPricesRow.RoomType) And vPricesRow.RoomType = pRoomType) Then
				If Not ValueIsFilled(vPricesRow.AccommodationType) Or 
				   ValueIsFilled(vPricesRow.AccommodationType) And vPricesRow.AccommodationType = pSingleAccommodationType And pSingleAccommodationTemplate = Undefined And Not vUseTemplates Or
				   ValueIsFilled(vPricesRow.AccommodationType) And pSingleAccommodationTemplate <> Undefined And 
				   CheckTemplate(pSingleAccommodationTemplate, vPricesRow.AccommodationType, vAccTypeCount) Then
				   	If vPricesRow.IsRoomRevenue And Not ValueIsFilled(rSingleAccommodationTypePriceCurrency) Then
						rSingleAccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If ValueIsFilled(vPricesRow.ServicePackage) And 
						  (pPeriod < vPricesRow.ServicePackageDateValidFrom Or pPeriod > vPricesRow.ServicePackageDateValidTo And ValueIsFilled(vPricesRow.ServicePackageDateValidTo)) Then
							Continue;
						EndIf;
						vMultiplier = 1;
						If vPricesRow.IsPricePerPerson Then
							rSingleAccommodationTypePrice = rSingleAccommodationTypePrice + ?(vPricesRow.NumberOfPersons = 0, 1, vPricesRow.NumberOfPersons) * ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						Else
							rSingleAccommodationTypePrice = rSingleAccommodationTypePrice + ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						EndIf;
					EndIf;
				EndIf;
				If Not ValueIsFilled(vPricesRow.AccommodationType) Or 
				   ValueIsFilled(vPricesRow.AccommodationType) And vPricesRow.AccommodationType = pDoubleAccommodationType And pDoubleAccommodationTemplate = Undefined And Not vUseTemplates Or
				   ValueIsFilled(vPricesRow.AccommodationType) And pDoubleAccommodationTemplate <> Undefined And 
				   CheckTemplate(pDoubleAccommodationTemplate, vPricesRow.AccommodationType, vAccTypeCount) Then
					If vPricesRow.IsRoomRevenue And Not ValueIsFilled(rDoubleAccommodationTypePriceCurrency) Then
						rDoubleAccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If ValueIsFilled(vPricesRow.ServicePackage) And 
						  (pPeriod < vPricesRow.ServicePackageDateValidFrom Or pPeriod > vPricesRow.ServicePackageDateValidTo And ValueIsFilled(vPricesRow.ServicePackageDateValidTo)) Then
							Continue;
						EndIf;
						vMultiplier = 1;
						If Not ValueIsFilled(vPricesRow.AccommodationType) And pDoubleAccommodationTemplate <> Undefined Then
							vMultiplier = 2;
						EndIf;
						If vPricesRow.IsPricePerPerson Then
							rDoubleAccommodationTypePrice = rDoubleAccommodationTypePrice + ?(vPricesRow.NumberOfPersons = 0, 1, vPricesRow.NumberOfPersons) * ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						Else
							rDoubleAccommodationTypePrice = rDoubleAccommodationTypePrice + ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						EndIf;
					EndIf;
				EndIf;
				If Not ValueIsFilled(vPricesRow.AccommodationType) Or 
				   ValueIsFilled(vPricesRow.AccommodationType) And vPricesRow.AccommodationType = pTripleAccommodationType And pTripleAccommodationTemplate = Undefined And Not vUseTemplates Or
				   ValueIsFilled(vPricesRow.AccommodationType) And pTripleAccommodationTemplate <> Undefined And 
				   CheckTemplate(pTripleAccommodationTemplate, vPricesRow.AccommodationType, vAccTypeCount) Then
					If vPricesRow.IsRoomRevenue And Not ValueIsFilled(rTripleAccommodationTypePriceCurrency) Then
						rTripleAccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If ValueIsFilled(vPricesRow.ServicePackage) And 
						  (pPeriod < vPricesRow.ServicePackageDateValidFrom Or pPeriod > vPricesRow.ServicePackageDateValidTo And ValueIsFilled(vPricesRow.ServicePackageDateValidTo)) Then
							Continue;
						EndIf;
						vMultiplier = 1;
						If Not ValueIsFilled(vPricesRow.AccommodationType) And pTripleAccommodationTemplate <> Undefined Then
							vMultiplier = 3;
						EndIf;
						If vPricesRow.IsPricePerPerson Then
							rTripleAccommodationTypePrice = rTripleAccommodationTypePrice + ?(vPricesRow.NumberOfPersons = 0, 1, vPricesRow.NumberOfPersons) * ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						Else
							rTripleAccommodationTypePrice = rTripleAccommodationTypePrice + ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount; 
						EndIf;
					EndIf;
				EndIf;
				If Not ValueIsFilled(vPricesRow.AccommodationType) Or 
				   ValueIsFilled(vPricesRow.AccommodationType) And vPricesRow.AccommodationType = pQuadleAccommodationType And pQuadleAccommodationTemplate = Undefined And Not vUseTemplates Or
				   ValueIsFilled(vPricesRow.AccommodationType) And pQuadleAccommodationTemplate <> Undefined And 
				   CheckTemplate(pQuadleAccommodationTemplate, vPricesRow.AccommodationType, vAccTypeCount) Then
					If vPricesRow.IsRoomRevenue And Not ValueIsFilled(rQuadleAccommodationTypePriceCurrency) Then
						rQuadleAccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If ValueIsFilled(vPricesRow.ServicePackage) And 
						  (pPeriod < vPricesRow.ServicePackageDateValidFrom Or pPeriod > vPricesRow.ServicePackageDateValidTo And ValueIsFilled(vPricesRow.ServicePackageDateValidTo)) Then
							Continue;
						EndIf;
						vMultiplier = 1;
						If Not ValueIsFilled(vPricesRow.AccommodationType) And pQuadleAccommodationTemplate <> Undefined Then
							vMultiplier = 4;
						EndIf;
						If vPricesRow.IsPricePerPerson Then
							rQuadleAccommodationTypePrice = rQuadleAccommodationTypePrice + ?(vPricesRow.NumberOfPersons = 0, 1, vPricesRow.NumberOfPersons) * ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						Else
							rQuadleAccommodationTypePrice = rQuadleAccommodationTypePrice + ?(vPricesRow.Quantity = 0, 1, vPricesRow.Quantity) * vPricesRow.Price * vMultiplier * vAccTypeCount;
						EndIf;
					EndIf;
				EndIf;
				If Not ValueIsFilled(vPricesRow.AccommodationType) Or 
				   ValueIsFilled(vPricesRow.AccommodationType) And vPricesRow.AccommodationType = pBeds5AccommodationType And pBeds5AccommodationTemplate = Undefined And Not vUseTemplates Or
				   ValueIsFilled(vPricesRow.AccommodationType) And pBeds5AccommodationTemplate <> Undefined And 
				   CheckTemplate(pBeds5AccommodationTemplate, vPricesRow.AccommodationType, vAccTypeCount) Then
					If vPricesRow.IsRoomRevenue And Not ValueIsFilled(rBeds5AccommodationTypePriceCurrency) Then
						rBeds5AccommodationTypePriceCurrency = vPricesRow.Currency;
					EndIf;
					If vPricesRow.IsInPrice Then
						If ValueIsFilled(vPricesRow.ServicePackage) And 
