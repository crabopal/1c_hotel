	Return vClient;
EndFunction // cmGetClientByFullnameAndEmail

// -----------------------------------------------------------------------------
// Description: Finds client by phone and e-mail
// Parameters: Client phone and e-mail
// Return value: Client reference
// -----------------------------------------------------------------------------
Function cmGetClientByPhoneAndEMail(pPhone, pEMail) Export
	vClient = Catalogs.Clients.EmptyRef();
	// Try to find client by e-mail
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	Clients.Ref AS Ref,
	|	Clients.DiscountType.SortCode AS DiscountTypeSortCode
	|FROM
	|	Catalog.Clients AS Clients
	|WHERE
	|	NOT Clients.IsFolder
	|	" + ?(ValueIsFilled(pEMail), " AND Clients.EMail = &qEMail ", " ")+
	"	" + ?(ValueIsFilled(pPhone), " AND Clients.Phone = &qPhone ", " ")+
	"	AND NOT Clients.DeletionMark
	|
	|ORDER BY
	|	Clients.DiscountType.SortCode DESC,
	|	Clients.Code DESC";
	If ValueIsFilled(pEMail) Then
		vQry.SetParameter("qEMail", TrimAll(pEMail));
	EndIf;
	If ValueIsFilled(pPhone) Then
		vQry.SetParameter("qPhone", TrimAll(SMS.GetValidPhoneNumber(pPhone)));
	EndIf;
	vClients = vQry.Execute().Unload();
	If vClients.Count() > 0 Then
		vClient = vClients.Get(0).Ref;
	EndIf;
	Return vClient;	
EndFunction // cmGetClientByPhoneAndEMail

// -----------------------------------------------------------------------------
// Description: Finds client by discound card id
// Parameters: Discount card identifier
// Return value: Client reference
// -----------------------------------------------------------------------------
Function cmGetClientByPromoCode(pPromoCode) Export
	vClient = Catalogs.Clients.EmptyRef();
	// Try to find client by e-mail
	vQry = New Query();
	vQry.Text = 
	"SELECT
	|	DiscountCards.Client AS Client
	|FROM
	|	Catalog.DiscountCards AS DiscountCards
	|WHERE
	|	DiscountCards.Identifier = &qPromoCode
	|	AND DiscountCards.Client <> &qEmptyClient
	|	AND NOT DiscountCards.Client.DeletionMark
	|
	|ORDER BY
	|	DiscountCards.Client.FullName DESC,
	|	DiscountCards.Client.DateOfBirth DESC,
	|	DiscountCards.Client.IdentityDocumentNumber DESC,
	|	DiscountCards.Client.CreateDate";
	vQry.SetParameter("qPromoCode", TrimAll(pPromoCode));
	vQry.SetParameter("qEmptyClient", Catalogs.Clients.EmptyRef());
	vClients = vQry.Execute().Unload();
	If vClients.Count() = 1 Then
		vClient = vClients.Get(0).Client;
	EndIf;
	Return vClient;
EndFunction // cmGetClientByPromoCode

