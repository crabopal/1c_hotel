Procedure FillExtraChargesExternalGroupReservationStatusRow(Val pExternalSystemCode, Val vDocRef, Val vHotel, Val vLanguage, vStatusRow)
	
	vExtraCharges = cmGetReservationExtraCharges(vDocRef);
	
	vExtraChargesXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ChargeExtraServices"));
	For Each vExtraChargesRow In vExtraCharges Do
		vExtraChargeXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ChargeExtraServiceRow"));
		
		vExtraChargeXDTO.Service = ?(ValueIsFilled(vExtraChargesRow.Service),vExtraChargesRow.Service.GetObject().pmGetServiceDescription(vLanguage),"Extra");
		vExtraChargeXDTO.Remarks = TrimAll(vExtraChargesRow.Remarks);
		vExtraChargeXDTO.Sum = vExtraChargesRow.Sum - vExtraChargesRow.DiscountSum;
		vExtraChargeXDTO.DiscountSum = vExtraChargesRow.DiscountSum;
		vExtraChargeXDTO.DiscountPercent = vExtraChargesRow.Discount;
		vExtraChargeXDTO.Quantity = ?(vExtraChargesRow.Quantity = 0, 1, vExtraChargesRow.Quantity);
		vExtraChargeXDTO.Price = Round(vExtraChargeXDTO.Sum / vExtraChargeXDTO.Quantity, 2);
		vExtraChargeXDTO.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vExtraChargesRow.Currency, False);
		vExtraChargeXDTO.ChargeDate = vExtraChargesRow.Date;
		vExtraChargeXDTO.Department = "";
		
		vOrder = vExtraChargesRow.Order;
		If ValueIsFilled(vOrder) Then
			vExtraChargeXDTO.OrderType = TrimAll(vOrder.Type);
			vExtraChargeXDTO.OrderDate = vOrder.Date;
			vExtraChargeXDTO.Destination = TrimAll(vOrder.Destination);
			vExtraChargeXDTO.TransferType = TrimAll(vOrder.TransferType);
			vExtraChargeXDTO.TransferRemarks = TrimAll(vOrder.Remarks);
			vExtraChargeXDTO.TransferChildSeats = vOrder.ChildSeatsNumber;
			vExtraChargeXDTO.PassengersNumber = vOrder.GuestsQuantity;
		Else
			vExtraChargeXDTO.OrderType = "";
			vExtraChargeXDTO.OrderDate = '00010101';
			vExtraChargeXDTO.Destination = "";
			vExtraChargeXDTO.TransferType = "";
			vExtraChargeXDTO.TransferRemarks = "";
			vExtraChargeXDTO.TransferChildSeats = 0;
			vExtraChargeXDTO.PassengersNumber = 0;
		EndIf;
		
		vExtraChargesXDTO.ChargeExtraServiceRow.Add(vExtraChargeXDTO);
	EndDo;
	
	vQ = New Query;
	vDocObj = Documents.Reservation.CreateDocument();
	vQ.Text = "SELECT
	          |	ReservationServices.Ref AS Ref,
	          |	ReservationServices.AccountingDate AS AccountingDate,
	          |	ReservationServices.Service.Code AS ServiceCode,
	          |	ReservationServices.Service AS Service,
	          |	ReservationServices.Quantity AS Quantity,
	          |	ReservationServices.Sum AS Sum,
	          |	ReservationServices.DiscountSum AS DiscountSum,
	          |	ReservationServices.Discount AS Discount,
	          |	ReservationServices.FolioCurrency AS Currency,
	          |	ReservationServices.FolioCurrency.Code AS CurrencyCode,
	          |	ReservationServices.Remarks AS Remarks
	          |FROM
	          |	Document.Reservation.Services AS ReservationServices
	          |WHERE
	          |	ReservationServices.Ref = &Ref
	          |	AND NOT ReservationServices.Ref.DoCharging
	          |	AND ReservationServices.IsManual";
	vQ.SetParameter("Ref",vDocRef);
	vExtraSrvQuery = vQ.Execute().Select();
	While vExtraSrvQuery.Next() Do
		vExtraChargeXDTO = XDTOFactory.Create(XDTOFactory.Type("http://www.1chotel.ru/interfaces/reservation/", "ChargeExtraServiceRow"));
		
		vExtraChargeXDTO.Service = ?(ValueIsFilled(vExtraSrvQuery.Service),vExtraSrvQuery.Service.GetObject().pmGetServiceDescription(vLanguage),"Extra");
		vExtraChargeXDTO.Remarks = TrimAll(vExtraSrvQuery.Remarks);
		vExtraChargeXDTO.Sum = vExtraSrvQuery.Sum - vExtraSrvQuery.DiscountSum;
		vExtraChargeXDTO.DiscountSum = vExtraSrvQuery.DiscountSum;
		vExtraChargeXDTO.DiscountPercent = vExtraSrvQuery.Discount;
		vExtraChargeXDTO.Quantity = ?(vExtraSrvQuery.Quantity = 0, 1, vExtraSrvQuery.Quantity);
		vExtraChargeXDTO.Price = Round(vExtraChargeXDTO.Sum / vExtraChargeXDTO.Quantity, 2);
		vExtraChargeXDTO.Currency = cmGetObjectExternalSystemCodeByRef(vHotel, pExternalSystemCode, "Currencies", vExtraSrvQuery.Currency, False);
		vExtraChargeXDTO.ChargeDate = vExtraSrvQuery.AccountingDate;
		vExtraChargeXDTO.Department = "";
		
		vExtraChargeXDTO.OrderType = "";
		vExtraChargeXDTO.OrderDate = '00010101';
		vExtraChargeXDTO.Destination = "";
		vExtraChargeXDTO.TransferType = "";
		vExtraChargeXDTO.TransferRemarks = "";
		vExtraChargeXDTO.TransferChildSeats = 0;
		vExtraChargeXDTO.PassengersNumber = 0;
		
		vExtraChargesXDTO.ChargeExtraServiceRow.Add(vExtraChargeXDTO);
	EndDo;
	
	vStatusRow.ExtraCharges = vExtraChargesXDTO;
EndProcedure

