&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - Entries in the register of foreigners&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - &lt;bgcolor #ffffff&gt;Room rates&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - Clients&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - Customers&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - Contracts&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 8&gt;&lt;bgcolor #ffffff&gt;&lt;color #333333&gt;  - Room statuses&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;</v8:content>
							</v8:item>
							<v8:item>
