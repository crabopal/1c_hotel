		<htl:ReportObject htl:isFolder="Нет" htl:predefined="Да" htl:code="605" htl:description="EN='Lost profits'; RU='Упущенная прибыль'" htl:Report="LostProfits" htl:isExternal="Нет" htl:staticParameters="ValueStorage" htl:dynamicParameters="REP.PeriodFrom = BegOfDay(CurrentDate());
REP.PeriodTo = EndOfDay(CurrentDate());" htl:isPackage="Нет" htl:key="" htl:sortCode="605" htl:reportHeaderText="" htl:externalTemplate="ValueStorage" htl:externalTemplateFileName="" htl:externalTemplateFileLoadTime="01.01.0001 0:00:00" htl:externalTemplateFileLastChangeTime="01.01.0001 0:00:00" htl:defaultSettings="ValueStorage" htl:remarks="Отчет позволяет оценить сумму недополученной выручки по отмененной брони. Отчет работает по не действующей брони, но не учитывает:

а) аннулированную бронь, т.е. бронь со статусами с включенным флажком &quot;Это аннуляция&quot;. Предполагается, что аннулированная бронь -- это бронь созданная по ошибке персонала гостиницы. У брони от которой отказались обычно устанавливают статус &quot;Отказ&quot; или &quot;Незаезд&quot;;

б) бронь по которой был заезд;

в) бронь со статусом &quot;Незаезд со штрафом&quot;, т.е. бронь со статусами с включенным флажком &quot;Начислять штраф за незаезд&quot;. В этом случае предполагается, что по брони применены штрафные санкции и гостиница получила компенсацию за отмену брони." htl:doNotGenerateOnOpen="Нет" htl:lockSettings="Нет" htl:isSystem="Нет">
			<CatalogObject.Reports xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="CatalogObject.Reports">
				<Ref>0ba45142-2c3b-4885-af80-045def7ac0ef</Ref>
				<IsFolder>false</IsFolder>
				<DeletionMark>false</DeletionMark>
				<Parent>ab0d03c4-f48e-11dc-a070-000e9bddf1c4</Parent>
				<Code>605</Code>
				<Description>EN='Lost profits'; RU='Упущенная прибыль'</Description>
				<PredefinedDataName>LostProfits</PredefinedDataName>
				<IsExternal>false</IsExternal>
				<Report xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:string">LostProfits</Report>
				<StaticParameters></StaticParameters>
				<DynamicParameters>REP.PeriodFrom = BegOfDay(CurrentDate());
REP.PeriodTo = EndOfDay(CurrentDate());</DynamicParameters>
				<IsPackage>false</IsPackage>
				<PermissionGroup>00000000-0000-0000-0000-000000000000</PermissionGroup>
				<Key/>
				<SortCode>605</SortCode>
				<ReportHeaderText/>
				<ExternalTemplate>AQEIAAAAAAAAAO+7v3siVSJ9</ExternalTemplate>
				<ExternalTemplateFileName/>
				<ExternalTemplateFileLoadTime>0001-01-01T00:00:00</ExternalTemplateFileLoadTime>
				<ExternalTemplateFileLastChangeTime>0001-01-01T00:00:00</ExternalTemplateFileLastChangeTime>
				<DefaultSettings>AQEIAAAAAAAAAO+7v3siVSJ9</DefaultSettings>
				<Hotel>00000000-0000-0000-0000-000000000000</Hotel>
				<Remarks>Отчет позволяет оценить сумму недополученной выручки по отмененной брони. Отчет работает по не действующей брони, но не учитывает:

а) аннулированную бронь, т.е. бронь со статусами с включенным флажком "Это аннуляция". Предполагается, что аннулированная бронь -- это бронь созданная по ошибке персонала гостиницы. У брони от которой отказались обычно устанавливают статус "Отказ" или "Незаезд";

б) бронь по которой был заезд;

в) бронь со статусом "Незаезд со штрафом", т.е. бронь со статусами с включенным флажком "Начислять штраф за незаезд". В этом случае предполагается, что по брони применены штрафные санкции и гостиница получила компенсацию за отмену брони.
</Remarks>
				<DoNotGenerateOnOpen>false</DoNotGenerateOnOpen>
				<LockSettings>false</LockSettings>
				<IsSystem>false</IsSystem>
				<Package/>
				<PermissionGroups/>
			</CatalogObject.Reports>
		</htl:ReportObject>
