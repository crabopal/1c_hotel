		<Attribute name="TotalList" id="2">
			<Title>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Total list</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	CashRegisterDailyReceiptsTurnovers.Company,
	CashRegisterDailyReceiptsTurnovers.CashRegister,
	CashRegisterDailyReceiptsTurnovers.Currency AS Currency,
	SUM(CashRegisterDailyReceiptsTurnovers.SumReceipt) AS Sum,
	SUM(CashRegisterDailyReceiptsTurnovers.VATSumReceipt) AS VATSum
FROM
	AccumulationRegister.CashRegisterDailyReceipts.Turnovers(
			&amp;qDateFrom,
			&amp;qDateTo,
			Period,
			Company = &amp;qCompany
				AND CashRegister = &amp;qCashRegister) AS CashRegisterDailyReceiptsTurnovers

GROUP BY
	CashRegisterDailyReceiptsTurnovers.Company,
	CashRegisterDailyReceiptsTurnovers.CashRegister,
	CashRegisterDailyReceiptsTurnovers.Currency</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Currency.SortCode</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
				</ListSettings>
			</Settings>
		</Attribute>
