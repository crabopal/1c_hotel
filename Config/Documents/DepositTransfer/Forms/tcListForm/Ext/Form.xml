	DepositTransfers.AccountingDate AS AccountingDate,
	DepositTransfers.PaymentMethod AS PaymentMethod,
	DepositTransfers.DeletionMark AS DeletionMark,
	DepositTransfers.Number AS Number,
	DepositTransfers.Posted AS Posted
FROM
	Document.DepositTransfer AS DepositTransfers
