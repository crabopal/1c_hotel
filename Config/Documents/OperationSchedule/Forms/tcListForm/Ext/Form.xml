		OtherOperationsCount AS OtherOperationsCount,
		EmployeeSortCode AS EmployeeSortCode
	) AS Employees,
	DocumentOperationSchedule.PointInTime AS PointInTime
FROM
	Document.OperationSchedule AS DocumentOperationSchedule
WHERE
