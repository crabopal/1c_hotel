			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>SELECT
	DocumentPayment.Ref AS Ref,
	DocumentPayment.DeletionMark AS DeletionMark,
	DocumentPayment.Number AS Number,
	DocumentPayment.Date AS Date,
	DocumentPayment.Posted AS Posted,
	DocumentPayment.AccountingDate AS AccountingDate,
	DocumentPayment.ParentDoc AS ParentDoc,
	DocumentPayment.Folio AS Folio,
	DocumentPayment.Hotel AS Hotel,
	DocumentPayment.Company AS Company,
	DocumentPayment.Payer AS Payer,
	DocumentPayment.AccountingCustomer AS AccountingCustomer,
	DocumentPayment.AccountingContract AS AccountingContract,
	DocumentPayment.GuestGroup AS GuestGroup,
	DocumentPayment.PaymentSection AS PaymentSection,
	DocumentPayment.PaymentMethod AS PaymentMethod,
	DocumentPayment.Sum AS Sum,
	DocumentPayment.VATRate AS VATRate,
	DocumentPayment.VATSum AS VATSum,
	DocumentPayment.SumInFolioCurrency AS SumInFolioCurrency,
	DocumentPayment.VATSumInFolioCurrency AS VATSumInFolioCurrency,
	DocumentPayment.ExchangeRateDate AS ExchangeRateDate,
	DocumentPayment.PaymentCurrency AS PaymentCurrency,
	DocumentPayment.PaymentCurrencyExchangeRate AS PaymentCurrencyExchangeRate,
	DocumentPayment.FolioCurrency AS FolioCurrency,
	DocumentPayment.FolioCurrencyExchangeRate AS FolioCurrencyExchangeRate,
	DocumentPayment.CashRegister AS CashRegister,
	DocumentPayment.CreditCard AS CreditCard,
	DocumentPayment.ReferenceNumber AS ReferenceNumber,
	DocumentPayment.AuthorizationCode AS AuthorizationCode,
	DocumentPayment.TerminalNumber AS TerminalNumber,
	DocumentPayment.Remarks AS Remarks,
	DocumentPayment.SlipText AS SlipText,
	DocumentPayment.AnnulationSlipText AS AnnulationSlipText,
	DocumentPayment.TypeOfAnnulation AS TypeOfAnnulation,
	DocumentPayment.AuthorOfAnnulation AS AuthorOfAnnulation,
	DocumentPayment.DateOfAnnulation AS DateOfAnnulation,
	DocumentPayment.Invoice AS Invoice,
	DocumentPayment.Preauthorisation AS Preauthorisation,
	DocumentPayment.CardType AS CardType,
	DocumentPayment.ExternalCode AS ExternalCode,
	DocumentPayment.GiftCertificate AS GiftCertificate,
	DocumentPayment.Author AS Author,
	DocumentPayment.CardOperationDate AS CardOperationDate,
	DocumentPayment.OrderNumber AS OrderNumber,
	DocumentPayment.PaymentSections.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		PaymentSection AS PaymentSection,
		ChequeService AS ChequeService,
		ChequeServicePrice AS ChequeServicePrice,
		ChequeServiceQuantity AS ChequeServiceQuantity,
		Sum AS Sum,
		VATRate AS VATRate,
		VATSum AS VATSum,
		SumInFolioCurrency AS SumInFolioCurrency,
		VATSumInFolioCurrency AS VATSumInFolioCurrency
	) AS PaymentSections,
	DocumentPayment.PointInTime AS PointInTime
FROM
	Document.Payment AS DocumentPayment
WHERE
	CASE
			WHEN &amp;qPaymentMethod = VALUE(Catalog.PaymentMethods.EmptyRef)
				THEN TRUE
			ELSE DocumentPayment.PaymentMethod = &amp;qPaymentMethod
		END
	AND CASE
			WHEN &amp;qCashRegister = VALUE(Catalog.CashRegisters.EmptyRef)
				THEN TRUE
			ELSE DocumentPayment.CashRegister = &amp;qCashRegister
