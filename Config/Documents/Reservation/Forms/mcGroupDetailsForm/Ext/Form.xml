	<Attributes>
		<Attribute name="GroupProformaInvoices" id="1">
			<Title>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Group proforma invoices</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>GroupProformaInvoices.AccountingContract</Field>
				<Field>GroupProformaInvoices.AccountingCurrency</Field>
				<Field>GroupProformaInvoices.AccountingCustomer</Field>
				<Field>GroupProformaInvoices.Author</Field>
				<Field>GroupProformaInvoices.Company</Field>
				<Field>GroupProformaInvoices.Date</Field>
				<Field>GroupProformaInvoices.PaidSum</Field>
				<Field>GroupProformaInvoices.Ref</Field>
				<Field>GroupProformaInvoices.Remarks</Field>
				<Field>GroupProformaInvoices.Sum</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	DocumentProformaInvoice.Ref AS Ref,
	DocumentProformaInvoice.DeletionMark AS DeletionMark,
	DocumentProformaInvoice.Number AS Number,
	DocumentProformaInvoice.Date AS Date,
	DocumentProformaInvoice.Posted AS Posted,
	DocumentProformaInvoice.ParentDoc AS ParentDoc,
	DocumentProformaInvoice.Hotel AS Hotel,
	DocumentProformaInvoice.Company AS Company,
	DocumentProformaInvoice.BankAccount AS BankAccount,
	DocumentProformaInvoice.AccountingCustomer AS AccountingCustomer,
	DocumentProformaInvoice.AccountingContract AS AccountingContract,
	DocumentProformaInvoice.GuestGroup AS GuestGroup,
	DocumentProformaInvoice.ContactPerson AS ContactPerson,
	DocumentProformaInvoice.Phone AS Phone,
	DocumentProformaInvoice.Fax AS Fax,
	DocumentProformaInvoice.EMail AS EMail,
	DocumentProformaInvoice.Sum AS Sum,
	DocumentProformaInvoice.VATSum AS VATSum,
	DocumentProformaInvoice.ExchangeRateDate AS ExchangeRateDate,
	DocumentProformaInvoice.AccountingCurrency AS AccountingCurrency,
	DocumentProformaInvoice.AccountingCurrencyExchangeRate AS AccountingCurrencyExchangeRate,
	DocumentProformaInvoice.Remarks AS Remarks,
	DocumentProformaInvoice.PrintWithCompanyStamp AS PrintWithCompanyStamp,
	DocumentProformaInvoice.ExternalCode AS ExternalCode,
	DocumentProformaInvoice.ExtraInvoice AS ExtraInvoice,
	DocumentProformaInvoice.CheckDate AS CheckDate,
	DocumentProformaInvoice.Author AS Author,
	DocumentProformaInvoice.ChangeDate AS ChangeDate,
	DocumentProformaInvoice.ChangeAuthor AS ChangeAuthor,
	DocumentProformaInvoice.PointInTime AS PointInTime,
	ISNULL(InvoiceAccounts.SumExpense, 0) AS PaidSum,
	CASE
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) &lt;= 0
				AND DocumentProformaInvoice.Hotel.AccountingDate &gt; DocumentProformaInvoice.CheckDate
				AND DocumentProformaInvoice.CheckDate &gt; DATETIME(1, 1, 1)
			THEN 6
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) &lt;= 0
			THEN 1
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) &gt;= DocumentProformaInvoice.Sum
			THEN 5
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) &lt; DocumentProformaInvoice.Sum / 2
			THEN 2
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) = DocumentProformaInvoice.Sum / 2
			THEN 3
		WHEN ISNULL(InvoiceAccounts.SumExpense, 0) &gt; DocumentProformaInvoice.Sum / 2
			THEN 4
		ELSE 0
	END AS InvoicePayedStateIcon
FROM
	Document.ProformaInvoice AS DocumentProformaInvoice
		LEFT JOIN (SELECT
			InvoiceAccountsTurnovers.Invoice AS Invoice,
			InvoiceAccountsTurnovers.SumExpense AS SumExpense
		FROM
			AccumulationRegister.InvoiceAccounts.Turnovers(, , PERIOD, GuestGroup = &amp;qGuestGroup) AS InvoiceAccountsTurnovers) AS InvoiceAccounts
		ON (InvoiceAccounts.Invoice = DocumentProformaInvoice.Ref)
WHERE
	DocumentProformaInvoice.Posted
	AND DocumentProformaInvoice.GuestGroup = &amp;qGuestGroup
	AND DocumentProformaInvoice.GuestGroup &lt;&gt; VALUE(Catalog.GuestGroups.EmptyRef)</QueryText>
				<MainTable>Document.ProformaInvoice</MainTable>
				<ListSettings>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Date</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Number</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
					</dcsset:order>
				</ListSettings>
			</Settings>
