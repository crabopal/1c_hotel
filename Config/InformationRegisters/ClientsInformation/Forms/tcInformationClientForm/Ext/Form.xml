				<Field>ClientInformationTree.RemarksAuthor</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>SELECT
	ClientInformationTypes.Ref AS Ref,
	ClientsInformation.Remarks,
	ClientsInformation.RemarksAuthor,
	ClientsInformation.Period,
	ClientsInformation.ActionTaken,
	ClientsInformation.ActionAuthor,
	ClientsInformation.ActionDate,
	ClientsInformation.Hotel
FROM
	Catalog.ClientInformationTypes AS ClientInformationTypes
		LEFT JOIN InformationRegister.ClientsInformation.SliceLast(, ) AS ClientsInformation
		ON ClientInformationTypes.Ref = ClientsInformation.InformationType
			AND (NOT ClientInformationTypes.DeletionMark)
			AND (NOT ClientInformationTypes.IsFolder)
			AND (ClientsInformation.Client = &amp;qClient)
</QueryText>
				<MainTable>Catalog.ClientInformationTypes</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">InformationType.DeletionMark</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
