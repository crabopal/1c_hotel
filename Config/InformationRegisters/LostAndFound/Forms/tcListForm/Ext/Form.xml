	<Attributes>
		<Attribute name="List" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>List.DateWhenFoundDays</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>SELECT
	InformationRegisterLostAndFound.Code AS Code,
	InformationRegisterLostAndFound.DateWhenFound AS DateWhenFound,
	CASE
		WHEN InformationRegisterLostAndFound.DateWhenFound &lt;&gt; DATETIME(1, 1, 1, 0, 0, 0)
			THEN DATEDIFF(BEGINOFPERIOD(InformationRegisterLostAndFound.DateWhenFound, DAY), &amp;qCurrentDate, DAY)
		ELSE 999999999
	END AS DateWhenFoundDays,
	InformationRegisterLostAndFound.Room AS Room,
	InformationRegisterLostAndFound.Guest AS Guest,
	InformationRegisterLostAndFound.Author AS Author,
	InformationRegisterLostAndFound.CreateDate AS CreateDate,
	InformationRegisterLostAndFound.Hotel AS Hotel,
	InformationRegisterLostAndFound.GuestGroup AS GuestGroup,
	InformationRegisterLostAndFound.FoundBy AS FoundBy,
	InformationRegisterLostAndFound.Remarks AS Remarks,
	InformationRegisterLostAndFound.StorePlace AS StorePlace,
	InformationRegisterLostAndFound.IsReturned AS IsReturned,
	InformationRegisterLostAndFound.DateWhenReturned AS DateWhenReturned,
	InformationRegisterLostAndFound.ReturnedBy AS ReturnedBy,
	InformationRegisterLostAndFound.DeliveredTo AS DeliveredTo,
	InformationRegisterLostAndFound.DeliveredByPowerOfAttorney AS DeliveredByPowerOfAttorney,
	InformationRegisterLostAndFound.DeliveryRemarks AS DeliveryRemarks,
	InformationRegisterLostAndFound.HasMessage AS HasMessage,
	InformationRegisterLostAndFound.IsDisposaled AS IsDisposaled,
	InformationRegisterLostAndFound.DisposedDate AS DisposedDate,
	InformationRegisterLostAndFound.DisposedBy AS DisposedBy
FROM
	InformationRegister.LostAndFound AS InformationRegisterLostAndFound
WHERE
	CASE
			WHEN &amp;qByDateWhenFound
					AND (InformationRegisterLostAndFound.DateWhenFound BETWEEN &amp;qPeriodFrom AND &amp;qPeriodTo)
				THEN TRUE
			WHEN NOT &amp;qByDateWhenFound
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN &amp;qByDateWhenReturned
					AND (InformationRegisterLostAndFound.DateWhenReturned BETWEEN &amp;qPeriodFrom AND &amp;qPeriodTo)
				THEN TRUE
			WHEN NOT &amp;qByDateWhenReturned
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN &amp;qByDateWhenDisposed
					AND (InformationRegisterLostAndFound.DisposedDate BETWEEN &amp;qPeriodFrom AND &amp;qPeriodTo)
				THEN TRUE
			WHEN NOT &amp;qByDateWhenDisposed
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN InformationRegisterLostAndFound.Hotel = &amp;qHotel
				THEN TRUE
			WHEN InformationRegisterLostAndFound.Hotel = VALUE(Catalog.Hotels.EmptyRef)
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN &amp;qAll
				THEN TRUE
			WHEN &amp;qActiveOnly
					AND NOT InformationRegisterLostAndFound.IsReturned
					AND NOT InformationRegisterLostAndFound.IsDisposaled
				THEN TRUE
			WHEN &amp;qReturnedOnly
					AND InformationRegisterLostAndFound.IsReturned
					AND NOT InformationRegisterLostAndFound.IsDisposaled
				THEN TRUE
			WHEN &amp;qDisposedOnly
					AND InformationRegisterLostAndFound.IsDisposaled
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN &amp;qDaysPassed &lt;&gt; 0
					AND CASE
						WHEN InformationRegisterLostAndFound.DateWhenFound &lt;&gt; DATETIME(1, 1, 1, 0, 0, 0)
							THEN DATEDIFF(BEGINOFPERIOD(InformationRegisterLostAndFound.DateWhenFound, DAY), &amp;qCurrentDate, DAY)
						ELSE 999999999
					END &gt; &amp;qDaysPassed
				THEN TRUE
			WHEN &amp;qDaysPassed = 0
				THEN TRUE
			ELSE FALSE
		END</QueryText>
