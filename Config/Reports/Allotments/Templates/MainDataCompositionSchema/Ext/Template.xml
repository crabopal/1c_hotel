		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RoomQuotasRoomTypes.Ref AS Allotment,
	RoomTypes.Ref AS RoomTypeFolder,
	RoomQuotasRoomTypes.Ref.Customer AS Customer,
	RoomQuotasRoomTypes.Ref.Contract AS Contract,
	RoomQuotasRoomTypes.Hotel AS Hotel,
	RoomQuotasRoomTypes.RoomType AS RoomType,
	RoomQuotasRoomTypes.PeriodFrom AS PeriodFrom,
	RoomQuotasRoomTypes.PeriodTo AS PeriodTo,
	RoomQuotasRoomTypes.RoomQuantity AS RoomQuantity,
	RoomQuotasRoomTypes.ReleaseTime AS ReleaseTime
FROM
	Catalog.RoomQuotas.RoomTypes AS RoomQuotasRoomTypes
		LEFT JOIN Catalog.RoomTypes AS RoomTypes
		ON RoomQuotasRoomTypes.RoomType.Parent = RoomTypes.Ref
WHERE
	NOT RoomQuotasRoomTypes.Ref.DeletionMark
	AND NOT RoomQuotasRoomTypes.RoomType.DeletionMark
	AND RoomQuotasRoomTypes.Ref.Customer &lt;&gt; VALUE(Catalog.Customers.EmptyRef)
	AND RoomQuotasRoomTypes.Ref.Contract &lt;&gt; VALUE(Catalog.Contracts.EmptyRef)</query>
