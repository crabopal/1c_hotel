		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ContractsRoomRates.Ref.Owner AS Customer,
	ContractsRoomRates.Ref AS Contract,
	ContractsRoomRates.RoomRate AS RoomRate,
	ContractsRoomRates.DiscountType AS DiscountType,
	ContractsRoomRates.CheckInDateFrom AS CheckInDateFrom,
	ContractsRoomRates.CheckInDateTo AS CheckInDateTo,
	ContractsRoomRates.ReservationDateFrom AS ReservationDateFrom,
	ContractsRoomRates.ReservationDateTo AS ReservationDateTo,
	DiscountsSliceLast.Discount AS Discount,
	ContractsRoomRates.Ref.Remarks AS Remarks
FROM
	Catalog.Contracts.RoomRates AS ContractsRoomRates
		LEFT JOIN InformationRegister.Discounts.SliceLast(&amp;Period, ) AS DiscountsSliceLast
		ON ContractsRoomRates.DiscountType = DiscountsSliceLast.DiscountType

ORDER BY
	Customer,
	CheckInDateFrom,
	Contract,
	Discount</query>
