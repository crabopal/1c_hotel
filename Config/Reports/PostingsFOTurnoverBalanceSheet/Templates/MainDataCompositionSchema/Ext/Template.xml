		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PostingsFOBalanceAndTurnovers.Account AS Account,
	PostingsFOBalanceAndTurnovers.ExtDimension1 AS Dimension,
	PostingsFOBalanceAndTurnovers.Hotel AS Hotel,
	PostingsFOBalanceAndTurnovers.Company AS Company,
	PostingsFOBalanceAndTurnovers.Currency AS Currency,
	SUM(PostingsFOBalanceAndTurnovers.AmountOpeningBalanceDr) AS AmountOpeningBalanceDr,
	SUM(PostingsFOBalanceAndTurnovers.AmountOpeningBalanceCr) AS AmountOpeningBalanceCr,
	SUM(PostingsFOBalanceAndTurnovers.AmountClosingBalanceDr) AS AmountClosingBalanceDr,
	SUM(PostingsFOBalanceAndTurnovers.AmountClosingBalanceCr) AS AmountClosingBalanceCr,
	SUM(PostingsFOBalanceAndTurnovers.AmountTurnoverDr) AS AmountTurnoverDr,
	SUM(PostingsFOBalanceAndTurnovers.AmountTurnoverCr) AS AmountTurnoverCr,
	SUM(PostingsFOBalanceAndTurnovers.AmountOpeningBalance) AS AmountOpeningBalance,
	SUM(PostingsFOBalanceAndTurnovers.AmountClosingBalance) AS AmountClosingBalance
FROM
	AccountingRegister.PostingsFO.BalanceAndTurnovers({(&amp;qPeriodFrom)}, {(&amp;qPeriodTo)}, Auto, , {(Account IN HIERARCHY (&amp;qAccount))}, , {(Hotel = &amp;qHotel), (Company = &amp;qCompany), (Currency = &amp;qCurrency), (ExtDimension1 = &amp;qDimension)}) AS PostingsFOBalanceAndTurnovers

GROUP BY
	PostingsFOBalanceAndTurnovers.Hotel,
	PostingsFOBalanceAndTurnovers.Currency,
	PostingsFOBalanceAndTurnovers.Account,
	PostingsFOBalanceAndTurnovers.ExtDimension1,
	PostingsFOBalanceAndTurnovers.Company</query>
