<?xml version="1.0" encoding="UTF-8"?>
<Hotel xmlns:htl="http://1chotel.ru">
	<htl:ReportSettings htl:report="RoomQuotaSales">
		<htl:Dynamic>
			<string xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xs:string">REP.PeriodFrom = BegOfDay(CurrentDate()) + 12 * 3600;
REP.PeriodTo = REP.PeriodFrom + 120 * 24 * 3600;</string>
		</htl:Dynamic>
		<htl:Static>
			<ValueStorage xmlns="http://v8.1c.ru/data" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="ValueStorage"></ValueStorage>
		</htl:Static>
	</htl:ReportSettings>
</Hotel>