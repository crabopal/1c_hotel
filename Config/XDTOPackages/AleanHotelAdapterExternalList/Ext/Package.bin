<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="urn:schemas-som-ru:tma-HotelAdapterExternalList">
	<valueType name="ExternalID" base="xs:string"/>
	<valueType name="ExternalName" base="xs:string"/>
	<objectType name="ExternalList">
		<property xmlns:d3p1="urn:schemas-som-ru:tma-HotelAdapterExternalList" name="ExternalItem" type="d3p1:ExternalItem" upperBound="-1"/>
	</objectType>
	<objectType name="ExternalItem">
		<property xmlns:d3p1="urn:schemas-som-ru:tma-HotelAdapterExternalList" name="ExternalID" type="d3p1:ExternalID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="urn:schemas-som-ru:tma-HotelAdapterExternalList" name="ExternalName" type="d3p1:ExternalName" lowerBound="1" nillable="true" form="Attribute"/>
	</objectType>
	<objectType name="GetExternalList">
		<property xmlns:d3p1="urn:schemas-som-ru:tma-HotelAdapterExternalList" name="ExternalList" type="d3p1:ExternalList"/>
	</objectType>
</package>