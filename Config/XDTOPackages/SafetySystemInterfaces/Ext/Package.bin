<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.1chotel.ru/interfaces/safety/">
	<valueType name="Room" base="xs:string"/>
	<valueType name="Period" base="xs:dateTime"/>
	<valueType name="EventType" base="xs:string" maxLength="50"/>
	<valueType name="CardType" base="xs:string" maxLength="50"/>
	<valueType name="CardCode" base="xs:string" maxLength="36"/>
	<valueType name="EventDescription" base="xs:string" maxLength="4096"/>
	<valueType name="ErrorDescription" base="xs:string" maxLength="4096"/>
	<valueType name="ExtSystemCode" base="xs:string" maxLength="36"/>
	<valueType name="Hotel" base="xs:string" maxLength="36"/>
</package>